# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore deprecated partial files
app/views/pages/_monuments_et_sites_card.html.erb
app/views/pages/_prime_amiante_card.html.erb
app/views/pages/_primes_communales_card.html.erb

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore SQLite database files
*.sqlite3
*.sqlite3-*
/db/*.sqlite3
/db/*.sqlite3-*

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key
.env*
node_modules/

# Ignore build outputs
/app/assets/builds/*

# Ignore BCE data files (too large for deployment)
/db/bce_data/
/db/bce_data/*
!/app/assets/builds/.keep

# Ignore temporary files and debug outputs
server.log
nohup.out
t
add_*.rb
*_temp.rb
*_script.rb
debug_*.rb
extract_*.rb
test_*.html
cookies.txt

# Ignore archived scripts and temporary files
scripts/archive/
*_test.html
*.tmp
!/app/assets/builds/application.css

/node_modules

# Exclure les gros fichiers de données BCE
db/bce_data/*.zip
db/bce_data/*.csv
db/bce_data/KboOpenData_*

# Ignore environment-specific credential keys
/config/credentials/*.key

# Ignore key files for decrypting credentials and more.
/config/credentials/*.key

