#!/bin/bash

# Script pour voir les emails générés en développement
MAIL_DIR="/home/obinduarc/code/Architecht25/ren0vate/tmp/mails"

echo "📧 Emails générés en développement:"
echo "=================================="

if [ -d "$MAIL_DIR" ] && [ "$(ls -A $MAIL_DIR 2>/dev/null)" ]; then
  for file in "$MAIL_DIR"/*; do
    if [ -f "$file" ]; then
      echo ""
      echo "📄 Fichier: $(basename "$file")"
      echo "⏰ Date: $(stat -c %y "$file")"
      echo "📏 Taille: $(stat -c %s "$file") bytes"
      echo "---"
      echo "📋 Contenu (premiers 500 caractères):"
      head -c 500 "$file"
      echo ""
      echo "=================================="
    fi
  done
else
  echo "❌ Aucun email trouvé dans $MAIL_DIR"
fi
