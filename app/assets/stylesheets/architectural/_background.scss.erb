// === Background architectural simple et efficace ===

.architectural-hero {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

// Image de fond direct - centrée et plus petite
.architectural-bg-image {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: auto;
  min-height: 80vh;
  object-fit: cover;
  z-index: 1;
  opacity: 0.4;

  @media (min-width: 768px) {
    width: 85%;
    min-height: 85vh;
    opacity: 0.35;
  }

  @media (min-width: 1200px) {
    width: 90%;
    min-height: 90vh;
    opacity: 0.3;
  }
}

// Overlay léger pour la lisibilité
.architectural-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(248, 249, 250, 0.6) 0%, rgba(248, 249, 250, 0.3) 50%, rgba(248, 249, 250, 0.6) 100%);
  z-index: 2;
}

// Overlay simple qui fonctionne
.sketch-overlay {
  pointer-events: none;
  z-index: 3;
  background:
    linear-gradient(45deg, transparent 49%, rgba(107, 107, 107, 0.02) 50%, transparent 51%);
  background-size: 40px 40px;
  opacity: 0.3;
}

// Contenu SANS cadre ni bordure
.architectural-content {
  position: relative;
  z-index: 4;
  // Suppression de tous les éléments de cadre
  background: transparent;
  border: none;
  box-shadow: none;
  border-radius: 0;
  padding: 2rem;

  @media (min-width: 768px) {
    padding: 2.5rem;
  }
}
