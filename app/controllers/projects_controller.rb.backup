class ProjectsController < ApplicationController
  before_action :authenticate_user!
  before_action :set_property, only: [:index, :new, :create]
  before_action :set_project, only: [:show, :edit, :update, :destroy]

  def index
    if @property
      # Projets pour une propriété spécifique
      @projects = @property.projects.includes(:property, :works)
    else
      # Tous les projets de l'utilisateur
      @projects = current_user.projects.includes(:property, :works)
    end
  end

  def show
  end

  def new
    if @property
      @project = @property.projects.build(user: current_user)
    else
      @project = current_user.projects.build
    end
  end

  def create
    @project = if @property
                 @property.projects.build(project_params)
               else
                 current_user.projects.build(project_params)
               end
    
    # Assigner explicitement l'utilisateur
    @project.user = current_user
    
    Rails.logger.info "[PROJECT CREATE] 🔨 Tentative de création de chantier pour utilisateur: #{current_user.id}"
    Rails.logger.info "[PROJECT CREATE] 📊 Paramètres reçus: #{project_params.inspect}"
    Rails.logger.info "[PROJECT CREATE] 🏠 Propriété associée: #{@property&.id}"
    Rails.logger.info "[PROJECT CREATE] 👤 Utilisateur assigné: #{@project.user_id}"
    
    if @project.save
      Rails.logger.info "[PROJECT CREATE] ✅ Chantier créé avec succès: ID #{@project.id}"
      redirect_to @project, notice: "Le chantier a été créé avec succès."
    else
      Rails.logger.error "[PROJECT CREATE] ❌ Échec de la création: #{@project.errors.full_messages.join(', ')}"
      flash.now[:alert] = "Erreur lors de la création : #{@project.errors.full_messages.join(', ')}"
      render :new, status: :unprocessable_entity
    end
  end

  def edit
  end

  def update
    if @project.update(project_params)
      redirect_to @project, notice: "Le chantier a été mis à jour avec succès."
    else
      flash.now[:alert] = "Erreur lors de la mise à jour : #{@project.errors.full_messages.join(', ')}"
      render :edit, status: :unprocessable_entity
    end
  end

  def destroy
    project_name = @project.nom
    
    if @project.destroy
      redirect_to global_projects_path, notice: "Le chantier \"#{project_name}\" a été supprimé avec succès."
    else
      redirect_to @project, alert: "Impossible de supprimer ce chantier. Veuillez réessayer."
    end
  end

  private

  def set_property
    @property = current_user.properties.find(params[:property_id]) if params[:property_id]
  rescue ActiveRecord::RecordNotFound
    redirect_to properties_path, alert: "Propriété non trouvée."
  end

  def set_project
    @project = current_user.projects.find(params[:id])
  rescue ActiveRecord::RecordNotFound
    redirect_to projects_path, alert: "Chantier non trouvé."
  end

  def project_params
    params.require(:project).permit(:nom, :description, :date_début, :date_fin, :statut, :intervenant_entrepreneur, :intervenant_architecte, :property_id)
  end
end
