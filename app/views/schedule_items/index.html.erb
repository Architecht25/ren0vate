<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: "Planning", subtitle: @project.nom } do %>
    <%= link_to new_project_schedule_item_path(@project), class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter une tâche
    <% end %>
  <% end %>

  <% if @schedule_items.any? %>
    <div class="list-group">
      <% @schedule_items.each do |item| %>
        <div class="list-group-item">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
              <div class="fw-bold">
                <%= item.label %>
                <% if item.lot %><span class="badge bg-secondary ms-1"><%= item.lot.name %></span><% end %>
                <% if item.blocked? %><span class="badge bg-warning text-dark ms-1"><i class="bi bi-lock-fill me-1"></i>Bloquée par « <%= item.depends_on.label %> »</span><% end %>
              </div>
              <div class="text-muted small">
                <% if item.start_date || item.end_date %>
                  <%= item.start_date&.strftime("%d/%m/%Y") %> → <%= item.end_date&.strftime("%d/%m/%Y") %>
                <% end %>
              </div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <% if policy(item).update? %>
                <%= form_with url: schedule_item_path(item), method: :patch, local: true, html: { class: "d-inline" } do %>
                  <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <% ScheduleItem.statuses.keys.each do |status| %>
                      <option value="<%= status %>" <%= "selected" if item.status == status %>><%= status.humanize %></option>
                    <% end %>
                  </select>
                <% end %>
              <% else %>
                <span class="badge bg-<%= item.termine? ? 'success' : (item.en_cours? ? 'warning' : 'secondary') %>"><%= item.status.humanize %></span>
              <% end %>
              <% if policy(item).destroy? %>
                <%= button_to "Supprimer", schedule_item_path(item), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Supprimer cette tâche ?" } %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center text-muted py-5">Aucune tâche planifiée pour l'instant.</div>
  <% end %>
</div>
