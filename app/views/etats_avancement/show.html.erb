<%# Vue détail d'un état d'avancement %>

<div class="container-fluid px-3 px-md-4 py-4" style="max-width:960px;">
  <!-- En-tête -->
  <div class="d-flex align-items-start justify-content-between gap-2 mb-4 flex-wrap">
    <div>
      <%= link_to project_etats_avancement_index_path(@project), class: "text-muted text-decoration-none small d-flex align-items-center gap-1 mb-1" do %>
        <i class="bi bi-arrow-left"></i> États d'avancement
      <% end %>
      <h4 class="mb-1 fw-semibold" style="color:var(--ren0vate-navy);">
        <i class="bi bi-receipt-cutoff me-2" style="color:var(--ren0vate-accent);"></i>
        État d'avancement n°<%= @etat.numero %>
      </h4>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge rounded-pill bg-<%= @etat.statut_color %>">
          <i class="bi <%= @etat.statut_icon %> me-1"></i><%= @etat.statut_label %>
        </span>
        <% if @etat.genere_par_ia %>
          <span class="badge rounded-pill" style="background:rgba(79,70,229,0.12);color:#4f46e5;">
            <i class="bi bi-stars me-1"></i>Généré par IA
          </span>
        <% end %>
        <span class="text-muted small"><%= @etat.source_label %></span>
        <% if @etat.date_emission %>
          <span class="text-muted small">· <%= @etat.date_emission.strftime("%d/%m/%Y") %></span>
        <% end %>
      </div>
    </div>

    <!-- Actions principales -->
    <div class="d-flex gap-2 flex-wrap">
      <% if @etat.brouillon? || @etat.rejete? %>
        <%= link_to edit_project_etats_avancement_path(@project, @etat),
                    class: "btn btn-sm btn-outline-warning rounded-3" do %>
          <i class="bi bi-pencil me-1"></i>Modifier les %
        <% end %>
        <%= button_to soumettre_project_etats_avancement_path(@project, @etat),
                       method: :post, class: "btn btn-sm btn-primary rounded-3",
                       data: { confirm: "Soumettre cet état pour validation ?" } do %>
          <i class="bi bi-send me-1"></i>Soumettre
        <% end %>
      <% end %>
      <% if @etat.soumis? && (current_user.id == @project.user_id || @project.project_members.find_by(user: current_user)&.role == 'architect') %>
        <!-- Approuver -->
        <button type="button" class="btn btn-sm btn-success rounded-3" data-bs-toggle="modal" data-bs-target="#modal-approuver">
          <i class="bi bi-check2-circle me-1"></i>Approuver
        </button>
        <!-- Rejeter -->
        <button type="button" class="btn btn-sm btn-outline-danger rounded-3" data-bs-toggle="modal" data-bs-target="#modal-rejeter">
          <i class="bi bi-x-circle me-1"></i>Rejeter
        </button>
      <% end %>
    </div>
  </div>

  <!-- KPIs -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 rounded-4 text-center py-3 px-2" style="background:rgba(15,23,42,0.04);">
        <div class="fw-bold" style="font-size:1.3rem;color:var(--ren0vate-navy);"><%= @avancement_pct %>%</div>
        <div class="text-muted" style="font-size:0.75rem;">Avancement global</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 rounded-4 text-center py-3 px-2" style="background:rgba(217,119,6,0.07);">
        <div class="fw-bold" style="font-size:1.1rem;color:var(--ren0vate-accent);">
          <%= number_to_currency(@etat.montant_reclame_periode, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %>
        </div>
        <div class="text-muted" style="font-size:0.75rem;">Réclamé (période)</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 rounded-4 text-center py-3 px-2" style="background:rgba(25,135,84,0.07);">
        <div class="fw-bold" style="font-size:1.1rem;color:#198754;">
          <%= number_to_currency(@etat.montant_cumule_actuel, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %>
        </div>
        <div class="text-muted" style="font-size:0.75rem;">Cumul actuel</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 rounded-4 text-center py-3 px-2" style="background:rgba(0,0,0,0.03);">
        <div class="fw-bold" style="font-size:1.1rem;color:#555;">
          <%= number_to_currency(@etat.montant_total_marche, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %>
        </div>
        <div class="text-muted" style="font-size:0.75rem;">Total marché</div>
      </div>
    </div>
  </div>

  <!-- Barre globale -->
  <div class="mb-4 px-1">
    <div style="height:8px;background:#e9ecef;border-radius:8px;overflow:hidden;">
      <div style="height:100%;width:<%= @avancement_pct %>%;background:var(--ren0vate-accent);border-radius:8px;transition:width .5s;"></div>
    </div>
  </div>

  <!-- Résumé IA -->
  <% if @etat.resume_ia.present? %>
    <div class="alert border-0 rounded-3 mb-4"
         style="background:rgba(79,70,229,0.07);border-left:3px solid #4f46e5 !important;">
      <i class="bi bi-stars me-2" style="color:#4f46e5;"></i>
      <span class="small"><%= @etat.resume_ia %></span>
    </div>
  <% end %>

  <!-- Commentaires -->
  <% if @etat.commentaire_entrepreneur.present? || @etat.commentaire_architecte.present? %>
    <div class="row g-3 mb-4">
      <% if @etat.commentaire_entrepreneur.present? %>
        <div class="col-md-6">
          <div class="card border rounded-3 h-100">
            <div class="card-body p-3">
              <div class="small fw-semibold text-muted mb-1"><i class="bi bi-tools me-1"></i>Commentaire entrepreneur</div>
              <p class="small mb-0"><%= @etat.commentaire_entrepreneur %></p>
            </div>
          </div>
        </div>
      <% end %>
      <% if @etat.commentaire_architecte.present? %>
        <div class="col-md-6">
          <div class="card border rounded-3 h-100">
            <div class="card-body p-3">
              <div class="small fw-semibold text-muted mb-1">
                <i class="bi bi-<%= @etat.approuve? ? 'check-circle-fill text-success' : 'x-circle-fill text-danger' %> me-1"></i>
                Commentaire architecte
              </div>
              <p class="small mb-0"><%= @etat.commentaire_architecte %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Postes par thématique -->
  <% if @lignes_par_thematique.any? %>
    <% @lignes_par_thematique.each do |code, lignes| %>
      <% thematique_label = lignes.first.thematique_label %>
      <% sous_secteurs = lignes.map(&:sous_secteur).compact.uniq %>
      <% montant_them = lignes.sum { |l| l.montant_marche.to_f } %>
      <% montant_reclame = lignes.sum { |l| l.montant_reclame.to_f } %>

      <div class="card border rounded-4 mb-3">
        <!-- En-tête thématique -->
        <div class="card-header border-0 py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2"
             style="background:rgba(15,23,42,0.04); border-radius: 1rem 1rem 0 0 !important;">
          <div>
            <span class="fw-semibold small"><%= thematique_label %></span>
            <% if sous_secteurs.any? %>
              <span class="text-muted ms-2" style="font-size:0.72rem;"><%= sous_secteurs.first(3).join(' · ') %></span>
            <% end %>
          </div>
          <div class="d-flex align-items-center gap-3">
            <span class="text-muted" style="font-size:0.75rem;"><%= lignes.count %> postes</span>
            <span class="fw-bold small" style="color:var(--ren0vate-accent);">
              <%= number_to_currency(montant_reclame, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %>
              <span class="text-muted fw-normal">/ <%= number_to_currency(montant_them, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %></span>
            </span>
          </div>
        </div>

        <!-- Tableau des lignes -->
        <div class="table-responsive">
          <table class="table table-sm mb-0" style="font-size:0.82rem;">
            <thead style="background:#f8f9fa;">
              <tr>
                <th class="ps-3" style="width:55px;">Réf.</th>
                <th>Désignation</th>
                <th style="width:90px;" class="text-end">Marché</th>
                <th style="width:80px;" class="text-center">% préc.</th>
                <th style="width:80px;" class="text-center">% actuel</th>
                <th style="width:100px;" class="text-end pe-3">Réclamé</th>
              </tr>
            </thead>
            <tbody>
              <% lignes.sort_by(&:position).each do |ligne| %>
                <tr>
                  <td class="ps-3 text-muted" style="font-size:0.75rem;"><%= ligne.reference || '—' %></td>
                  <td>
                    <div><%= ligne.designation %></div>
                    <% if ligne.sous_secteur.present? %>
                      <small class="text-muted"><%= ligne.sous_secteur %></small>
                    <% end %>
                    <% if ligne.ia_suggere? %>
                      <%
                        conf_color = case ligne.ia_confiance
                          when 'haute'   then '#198754'
                          when 'moyenne' then '#fd7e14'
                          else '#dc3545'
                        end
                      %>
                      <span class="badge ms-1" style="font-size:0.62rem;background:<%= conf_color %>20;color:<%= conf_color %>;">
                        IA · <%= ligne.ia_confiance %>
                      </span>
                    <% end %>
                  </td>
                  <td class="text-end" style="color:#555;font-size:0.78rem;">
                    <%= ligne.montant_marche ? number_to_currency(ligne.montant_marche, unit: '€', format: '%n %u', separator: ',', delimiter: '.') : '—' %>
                  </td>
                  <td class="text-center">
                    <span class="badge rounded-pill" style="background:#f0f0f0;color:#555;font-size:0.72rem;">
                      <%= ligne.pct_cumule_precedent %>%
                    </span>
                  </td>
                  <td class="text-center">
                    <span class="badge rounded-pill fw-bold" style="background:rgba(217,119,6,0.12);color:var(--ren0vate-accent);font-size:0.72rem;">
                      <%= ligne.pct_cumule_actuel %>%
                    </span>
                  </td>
                  <td class="text-end pe-3 fw-semibold" style="color:var(--ren0vate-navy);font-size:0.82rem;">
                    <%= ligne.montant_reclame ? number_to_currency(ligne.montant_reclame, unit: '€', format: '%n %u', separator: ',', delimiter: '.') : '—' %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-4 text-muted">
      <i class="bi bi-list-ul fs-3 d-block mb-2"></i>
      <p class="small">Aucun poste dans cet état d'avancement.</p>
    </div>
  <% end %>
</div>

<!-- Modal Approuver -->
<% if @etat.soumis? %>
  <div class="modal fade" id="modal-approuver" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0">
        <div class="modal-header border-0 pb-0">
          <h6 class="modal-title fw-semibold"><i class="bi bi-check2-circle text-success me-2"></i>Approuver l'état n°<%= @etat.numero %></h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_tag approuver_project_etats_avancement_path(@project, @etat), method: :post do %>
          <div class="modal-body">
            <label class="form-label small fw-medium">Commentaire (optionnel)</label>
            <textarea name="commentaire" class="form-control rounded-3" rows="3"
                      placeholder="Travaux conformes au devis, approbation accordée…"></textarea>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-outline-secondary rounded-3 btn-sm" data-bs-dismiss="modal">Annuler</button>
            <button type="submit" class="btn btn-success rounded-3 btn-sm">
              <i class="bi bi-check2 me-1"></i>Confirmer l'approbation
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Modal Rejeter -->
  <div class="modal fade" id="modal-rejeter" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content rounded-4 border-0">
        <div class="modal-header border-0 pb-0">
          <h6 class="modal-title fw-semibold"><i class="bi bi-x-circle text-danger me-2"></i>Rejeter l'état n°<%= @etat.numero %></h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <%= form_tag rejeter_project_etats_avancement_path(@project, @etat), method: :post do %>
          <div class="modal-body">
            <label class="form-label small fw-medium">Motif du rejet <span class="text-danger">*</span></label>
            <textarea name="commentaire" class="form-control rounded-3" rows="3" required
                      placeholder="Les pourcentages déclarés ne correspondent pas aux photos…"></textarea>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-outline-secondary rounded-3 btn-sm" data-bs-dismiss="modal">Annuler</button>
            <button type="submit" class="btn btn-danger rounded-3 btn-sm">
              <i class="bi bi-x me-1"></i>Confirmer le rejet
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
