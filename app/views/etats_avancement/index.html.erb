<%# Vue liste des états d'avancement d'un projet %>

<div class="container-fluid px-3 px-md-4 py-4">
  <!-- En-tête -->
  <div class="d-flex align-items-center justify-content-between mb-4 gap-2">
    <div>
      <%= link_to project_path(@project), class: "text-muted text-decoration-none small d-flex align-items-center gap-1 mb-1" do %>
        <i class="bi bi-arrow-left"></i> <%= @project.nom %>
      <% end %>
      <h4 class="mb-0 fw-semibold" style="color:var(--ren0vate-navy);">
        <i class="bi bi-receipt-cutoff me-2" style="color:var(--ren0vate-accent);"></i>
        États d'avancement
      </h4>
      <small class="text-muted">Bordereaux de paiement par période</small>
    </div>
    <%= link_to new_project_etats_avancement_path(@project), class: "btn btn-sm rounded-3 d-flex align-items-center gap-2",
                style: "background:var(--ren0vate-accent);color:#fff;border:none;white-space:nowrap;" do %>
      <i class="bi bi-plus-circle"></i>
      <span class="d-none d-sm-inline">Nouvel état</span>
    <% end %>
  </div>

  <%# Bandeau dernier approuvé %>
  <% if @dernier_approuve %>
    <div class="alert border-0 rounded-4 mb-4 d-flex align-items-center gap-3"
         style="background:rgba(25,135,84,0.08); border-left:4px solid #198754 !important; border-left-width:4px !important;">
      <i class="bi bi-patch-check-fill text-success fs-5 flex-shrink-0"></i>
      <div>
        <strong class="small">Dernier approuvé : État n°<%= @dernier_approuve.numero %></strong>
        <span class="text-muted small ms-2"><%= @dernier_approuve.approuve_at&.strftime("%d/%m/%Y") %></span>
        <br>
        <span class="small text-success fw-semibold"><%= number_to_currency(@dernier_approuve.montant_cumule_actuel, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %></span>
        <span class="text-muted small"> cumulé approuvé</span>
      </div>
    </div>
  <% end %>

  <% if @etats.empty? %>
    <!-- État vide -->
    <div class="text-center py-5">
      <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
           style="width:72px;height:72px;">
        <i class="bi bi-receipt-cutoff fs-2 text-muted"></i>
      </div>
      <h5 class="fw-semibold text-muted mb-2">Aucun état d'avancement</h5>
      <p class="text-muted small mb-4">
        Créez le premier bordereau depuis le devis de l'entrepreneur ou le métré de l'architecte.
        <br>L'IA analyse automatiquement le document et propose une architecture par thématique.
      </p>
      <%= link_to new_project_etats_avancement_path(@project), class: "btn rounded-3 px-4",
                  style: "background:var(--ren0vate-accent);color:#fff;" do %>
        <i class="bi bi-stars me-2"></i>Créer avec l'IA
      <% end %>
    </div>
  <% else %>
    <div class="d-flex flex-column gap-3">
      <% @etats.each do |etat| %>
        <div class="card border rounded-4 shadow-sm hover-lift">
          <div class="card-body p-3">
            <div class="d-flex align-items-start justify-content-between gap-2">
              <div class="d-flex align-items-center gap-3">
                <!-- Numéro -->
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                     style="width:40px;height:40px;background:var(--ren0vate-navy);font-size:0.9rem;">
                  <%= etat.numero %>
                </div>
                <div>
                  <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-semibold" style="font-size:0.9rem;">État n°<%= etat.numero %></span>
                    <span class="badge rounded-pill bg-<%= etat.statut_color %>" style="font-size:0.7rem;">
                      <i class="bi <%= etat.statut_icon %> me-1"></i><%= etat.statut_label %>
                    </span>
                    <% if etat.genere_par_ia %>
                      <span class="badge rounded-pill" style="background:rgba(79,70,229,0.12);color:#4f46e5;font-size:0.7rem;">
                        <i class="bi bi-stars me-1"></i>IA
                      </span>
                    <% end %>
                  </div>
                  <div class="text-muted" style="font-size:0.78rem;">
                    <%= etat.source_label %>
                    <% if etat.date_emission %>
                      · <i class="bi bi-calendar3 me-1"></i><%= etat.date_emission.strftime("%d/%m/%Y") %>
                    <% end %>
                    <% if etat.periode_debut && etat.periode_fin %>
                      · Période : <%= etat.periode_debut.strftime("%d/%m") %> → <%= etat.periode_fin.strftime("%d/%m/%Y") %>
                    <% end %>
                  </div>
                </div>
              </div>
              <!-- Montant -->
              <div class="text-end flex-shrink-0">
                <div class="fw-bold" style="font-size:1rem;color:var(--ren0vate-navy);">
                  <%= number_to_currency(etat.montant_reclame_periode, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %>
                </div>
                <div class="text-muted" style="font-size:0.72rem;"><%= etat.lignes.count %> postes · <%= etat.avancement_global_pct %>%</div>
              </div>
            </div>

            <!-- Barre d'avancement globale -->
            <% pct = etat.avancement_global_pct %>
            <div class="mt-2 px-1">
              <div style="height:4px;background:#e9ecef;border-radius:4px;overflow:hidden;">
                <div style="height:100%;width:<%= pct %>%;background:var(--ren0vate-accent);border-radius:4px;transition:width .4s;"></div>
              </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2 mt-3 flex-wrap">
              <%= link_to project_etats_avancement_path(@project, etat), class: "btn btn-sm btn-outline-secondary rounded-3" do %>
                <i class="bi bi-eye me-1"></i>Voir
              <% end %>
              <% if etat.brouillon? || etat.rejete? %>
                <%= link_to edit_project_etats_avancement_path(@project, etat), class: "btn btn-sm btn-outline-warning rounded-3" do %>
                  <i class="bi bi-pencil me-1"></i>Modifier
                <% end %>
                <%= button_to soumettre_project_etats_avancement_path(@project, etat),
                               method: :post, class: "btn btn-sm btn-outline-primary rounded-3",
                               data: { confirm: "Soumettre l'état n°#{etat.numero} pour validation ?" } do %>
                  <i class="bi bi-send me-1"></i>Soumettre
                <% end %>
              <% end %>
              <% if etat.soumis? && (current_user.id == @project.user_id || @project.project_members.find_by(user: current_user)&.role == 'architect') %>
                <%= button_to approuver_project_etats_avancement_path(@project, etat),
                               method: :post, class: "btn btn-sm btn-success rounded-3" do %>
                  <i class="bi bi-check2 me-1"></i>Approuver
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
