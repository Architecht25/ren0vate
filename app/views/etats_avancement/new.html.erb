<%# Création d'un état d'avancement — choix de source + analyse IA %>
<%= content_for :title, "Nouvel état d'avancement — #{@project.nom}" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-store">
<% end %>

<div class="container-fluid px-3 px-md-4 py-4" style="max-width:900px;">
  <!-- En-tête -->
  <div class="mb-4">
    <%= link_to project_etats_avancement_index_path(@project), class: "text-muted text-decoration-none small d-flex align-items-center gap-1 mb-2" do %>
      <i class="bi bi-arrow-left"></i> États d'avancement
    <% end %>
    <h4 class="mb-0 fw-semibold" style="color:var(--ren0vate-navy);">
      <i class="bi bi-stars me-2" style="color:var(--ren0vate-accent);"></i>
      Nouvel état d'avancement
    </h4>
    <small class="text-muted">L'IA analyse le devis et propose une architecture de bordereau par thématique</small>
  </div>

  <!-- Étape 1 — Choisir la source -->
  <div class="card border-0 rounded-4 shadow-sm mb-4">
    <div class="card-header bg-white border-0 py-3 px-4">
      <h6 class="mb-0 fw-semibold d-flex align-items-center gap-2">
        <span class="badge rounded-circle d-flex align-items-center justify-content-center"
              style="width:24px;height:24px;background:var(--ren0vate-accent);color:#fff;font-size:0.75rem;">1</span>
        Choisir la source du bordereau
      </h6>
    </div>
    <div class="card-body px-4 pb-4">
      <!-- Sources disponibles : devis OCR -->
      <% has_sources = @devis_disponibles[:entrepreneur].any? || @devis_disponibles[:architecte].any? %>

      <% if has_sources %>
        <p class="text-muted small mb-3">
          Sélectionnez un devis déjà scanné pour que l'IA génère automatiquement les postes du bordereau.
        </p>

        <!-- Tabs source -->
        <ul class="nav nav-pills gap-2 mb-3" id="sourceTab" role="tablist" style="flex-wrap:wrap;">
          <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-3 px-3 py-2 small fw-medium" id="tab-entrepreneur"
                    data-bs-toggle="pill" data-bs-target="#pane-entrepreneur" type="button" role="tab">
              <i class="bi bi-tools me-1"></i>Devis entrepreneur
              <span class="badge rounded-pill ms-1" style="background:rgba(0,0,0,0.1);color:inherit;">
                <%= @devis_disponibles[:entrepreneur].count %>
              </span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 px-3 py-2 small fw-medium" id="tab-architecte"
                    data-bs-toggle="pill" data-bs-target="#pane-architecte" type="button" role="tab">
              <i class="bi bi-rulers me-1"></i>Métré architecte
              <span class="badge rounded-pill ms-1" style="background:rgba(0,0,0,0.1);color:inherit;">
                <%= @devis_disponibles[:architecte].count %>
              </span>
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 px-3 py-2 small fw-medium" id="tab-libre"
                    data-bs-toggle="pill" data-bs-target="#pane-libre" type="button" role="tab">
              <i class="bi bi-keyboard me-1"></i>Texte libre
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 px-3 py-2 small fw-medium" id="tab-manuel"
                    data-bs-toggle="pill" data-bs-target="#pane-manuel" type="button" role="tab">
              <i class="bi bi-list-ul me-1"></i>Saisie manuelle
            </button>
          </li>
        </ul>

        <div class="tab-content">
          <!-- Pane entrepreneur -->
          <div class="tab-pane fade show active" id="pane-entrepreneur" role="tabpanel">
            <% if @devis_disponibles[:entrepreneur].any? %>
              <div class="d-flex flex-column gap-2">
                <% @devis_disponibles[:entrepreneur].each do |devis| %>
                  <label class="devis-card d-flex align-items-center gap-3 p-3 rounded-3 border cursor-pointer"
                         style="cursor:pointer;" data-devis-id="<%= devis.id %>"
                         data-source-type="devis_entrepreneur">
                    <input type="radio" name="selected_devis" value="<%= devis.id %>"
                           data-source-type="devis_entrepreneur" class="devis-radio flex-shrink-0">
                    <div class="flex-grow-1 overflow-hidden">
                      <div class="fw-semibold text-truncate" style="font-size:0.85rem;">
                        <%= devis.nom_entreprise || devis.document&.file_name || "Devis ##{devis.id}" %>
                      </div>
                      <div class="text-muted" style="font-size:0.75rem;">
                        <%= devis.date_devis&.strftime("%d/%m/%Y") || "Date inconnue" %>
                        <% if devis.montant_total_htva %>
                          · <strong><%= number_to_currency(devis.montant_total_htva, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %> HTVA</strong>
                        <% end %>
                        <% if devis.types_travaux_libelles.any? %>
                          · <%= devis.types_travaux_libelles.first(3).join(', ') %>
                        <% end %>
                      </div>
                    </div>
                    <span class="badge rounded-pill flex-shrink-0" style="background:rgba(25,135,84,0.1);color:#198754;font-size:0.7rem;">
                      <i class="bi bi-check-circle me-1"></i>OCR
                    </span>
                  </label>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted small fst-italic">Aucun devis entrepreneur scanné pour ce projet.</p>
            <% end %>
          </div>

          <!-- Pane architecte -->
          <div class="tab-pane fade" id="pane-architecte" role="tabpanel">
            <% if @devis_disponibles[:architecte].any? %>
              <div class="d-flex flex-column gap-2">
                <% @devis_disponibles[:architecte].each do |devis| %>
                  <label class="devis-card d-flex align-items-center gap-3 p-3 rounded-3 border"
                         style="cursor:pointer;" data-devis-id="<%= devis.id %>"
                         data-source-type="metre_architecte">
                    <input type="radio" name="selected_devis" value="<%= devis.id %>"
                           data-source-type="metre_architecte" class="devis-radio flex-shrink-0">
                    <div class="flex-grow-1 overflow-hidden">
                      <div class="fw-semibold text-truncate" style="font-size:0.85rem;">
                        <%= devis.nom_entreprise || devis.document&.file_name || "Métré ##{devis.id}" %>
                      </div>
                      <div class="text-muted" style="font-size:0.75rem;">
                        <%= devis.date_devis&.strftime("%d/%m/%Y") || "Date inconnue" %>
                        <% if devis.montant_total_htva %>
                          · <strong><%= number_to_currency(devis.montant_total_htva, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %> HTVA</strong>
                        <% end %>
                      </div>
                    </div>
                  </label>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted small fst-italic">Aucun métré d'architecte scanné pour ce projet.</p>
            <% end %>
          </div>

          <!-- Pane texte libre -->
          <div class="tab-pane fade" id="pane-libre" role="tabpanel">
            <p class="text-muted small mb-2">Collez le texte brut du devis (copié depuis un PDF, email…).</p>
            <textarea id="texte_libre" class="form-control rounded-3" rows="8"
                      placeholder="1. Toiture&#10;1.1 Isolation toiture en laine de verre 200mm — 120m² — 35 €/m² HTVA = 4.200 €&#10;1.2 Couverture ardoises — 120m² — 65 €/m² = 7.800 €&#10;&#10;2. Châssis&#10;..."
                      style="font-size:0.82rem;font-family:monospace;resize:vertical;"></textarea>
          </div>

          <!-- Pane manuel -->
          <div class="tab-pane fade" id="pane-manuel" role="tabpanel">
            <p class="text-muted small mb-3">
              Créez un état vide et ajoutez les postes manuellement après création.
            </p>
            <div class="alert border-0 rounded-3" style="background:rgba(217,119,6,0.07);">
              <i class="bi bi-info-circle me-2" style="color:var(--ren0vate-accent);"></i>
              <span class="small">Vous pourrez ajouter les postes un par un depuis la vue de l'état.</span>
            </div>
          </div>
        </div>

        <!-- Bouton analyse IA — en bas du tab, s'active dès qu'un devis est sélectionné -->
        <div class="mt-3 pt-3 border-top">
          <button type="button" id="btn-analyze"
                  class="btn rounded-3 d-flex align-items-center gap-2"
                  style="background:var(--ren0vate-accent);color:#fff;border:none;opacity:0.4;pointer-events:none;"
                  disabled>
            <i class="bi bi-stars"></i>
            <span id="btn-analyze-label">Sélectionnez un devis pour analyser</span>
          </button>
        </div>

      <% else %>
        <div class="alert border-0 rounded-3 mb-3" style="background:rgba(217,119,6,0.07);">
          <i class="bi bi-info-circle me-2" style="color:var(--ren0vate-accent);"></i>
          <span class="small">
            Aucun devis scanné disponible.
            <%= link_to "Scannez d'abord un devis", ocr_scan_devis_path(project_id: @project.id), class: "text-decoration-none fw-semibold", style: "color:var(--ren0vate-accent);" %>
            ou utilisez la saisie libre ci-dessous.
          </span>
        </div>
        <nav class="nav nav-pills gap-2 mb-3">
          <button class="nav-link active rounded-3 px-3 py-2 small" data-bs-toggle="pill" data-bs-target="#pane-libre">
            <i class="bi bi-keyboard me-1"></i>Texte libre
          </button>
          <button class="nav-link rounded-3 px-3 py-2 small" data-bs-toggle="pill" data-bs-target="#pane-manuel">
            <i class="bi bi-list-ul me-1"></i>Saisie manuelle
          </button>
        </nav>
        <div class="tab-content">
          <div class="tab-pane fade show active" id="pane-libre">
            <textarea id="texte_libre" class="form-control rounded-3" rows="8"
                      placeholder="Collez le texte du devis ici…" style="font-size:0.82rem;font-family:monospace;"></textarea>
            <div class="mt-3">
              <button type="button" id="btn-analyze"
                      class="btn rounded-3 d-flex align-items-center gap-2"
                      style="background:var(--ren0vate-accent);color:#fff;border:none;opacity:0.4;pointer-events:none;"
                      disabled>
                <i class="bi bi-stars"></i>
                <span id="btn-analyze-label">Collez du texte pour analyser</span>
              </button>
            </div>
          </div>
          <div class="tab-pane fade" id="pane-manuel">
            <div class="alert border-0 rounded-3" style="background:rgba(217,119,6,0.07);">
              <i class="bi bi-info-circle me-2" style="color:var(--ren0vate-accent);"></i>
              <span class="small">Vous pourrez ajouter les postes manuellement après création.</span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Étape 3 — Résultat IA -->
  <div id="analysis-result" style="display:none;">
    <div class="card border-0 rounded-4 shadow-sm mb-4">
      <div class="card-header bg-white border-0 py-3 px-4">
        <h6 class="mb-0 fw-semibold d-flex align-items-center gap-2">
          <span class="badge rounded-circle d-flex align-items-center justify-content-center"
                style="width:24px;height:24px;background:#4f46e5;color:#fff;font-size:0.75rem;">3</span>
          Architecture proposée par l'IA
        </h6>
      </div>
      <div class="card-body px-4 pb-4">
        <!-- Résumé -->
        <div id="ia-resume" class="alert border-0 rounded-3 mb-4"
             style="background:rgba(79,70,229,0.07);border-left:3px solid #4f46e5 !important;"></div>

        <!-- Stats rapides -->
        <div class="row g-3 mb-4" id="ia-stats"></div>

        <!-- Boutons d'action -->
        <div class="d-flex gap-2 flex-wrap mb-4">
          <button type="button" id="btn-create" class="btn rounded-3 px-4 fw-semibold"
                  style="background:#1e3a5f;color:#fff;border:none;">
            <i class="bi bi-check2-circle me-2"></i>Créer ce bordereau
          </button>
          <button type="button" id="btn-retry" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-clockwise me-1"></i>Ré-analyser
          </button>
        </div>

        <!-- Formulaire caché pour création (soumis par JS) -->
        <form action="<%= create_from_analysis_project_etats_avancement_index_path(@project) %>"
              method="post" id="form-create" style="display:none;">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <input type="hidden" name="analysis_json" id="hidden-analysis-json">
          <input type="hidden" name="devis_donnee_id" id="hidden-devis-donnee-id">
          <input type="hidden" name="source_type" id="hidden-source-type">
        </form>

        <!-- Thématiques -->
        <div id="ia-thematiques"></div>

      </div>
    </div>
  </div>

  <!-- Formulaire saisie manuelle directe (sans IA) -->
  <div id="manual-form-section" style="display:none;">
    <%= form_with url: project_etats_avancement_index_path(@project), method: :post, local: true,
                  html: { class: "card border-0 rounded-4 shadow-sm" } do |f| %>
      <div class="card-header bg-white border-0 py-3 px-4">
        <h6 class="mb-0 fw-semibold d-flex align-items-center gap-2">
          <span class="badge rounded-circle d-flex align-items-center justify-content-center"
                style="width:24px;height:24px;background:var(--ren0vate-accent);color:#fff;font-size:0.75rem;">2</span>
          Informations générales
        </h6>
      </div>
      <div class="card-body px-4 pb-4">
        <%= f.hidden_field :source_type, value: 'manuel' %>
        <div class="row g-3">
          <div class="col-md-4">
            <%= f.label :date_emission, "Date d'émission", class: "form-label small fw-medium" %>
            <%= f.date_field :date_emission, value: Date.current, class: "form-control rounded-3" %>
          </div>
          <div class="col-md-4">
            <%= f.label :periode_debut, "Période du", class: "form-label small fw-medium" %>
            <%= f.date_field :periode_debut, class: "form-control rounded-3" %>
          </div>
          <div class="col-md-4">
            <%= f.label :periode_fin, "au", class: "form-label small fw-medium" %>
            <%= f.date_field :periode_fin, class: "form-control rounded-3" %>
          </div>
          <div class="col-12">
            <%= f.label :commentaire_entrepreneur, "Commentaire", class: "form-label small fw-medium" %>
            <%= f.text_area :commentaire_entrepreneur, class: "form-control rounded-3", rows: 3,
                            placeholder: "Travaux réalisés durant cette période…" %>
          </div>
        </div>
        <div class="mt-3">
          <%= f.submit "Créer l'état vide", class: "btn rounded-3 px-4",
                       style: "background:var(--ren0vate-navy);color:#fff;border:none;" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
  // Réinitialiser avant que Turbo ne snapshote la page (évite l'affichage du résultat au retour)
  document.addEventListener('turbo:before-cache', function () {
    var r = document.getElementById('analysis-result');
    var m = document.getElementById('manual-form-section');
    if (r) r.style.display = 'none';
    if (m) m.style.display = 'none';
    var btn = document.getElementById('btn-analyze');
    if (btn) { btn.disabled = true; btn.style.opacity = '0.4'; btn.style.pointerEvents = 'none'; }
    var lbl = document.getElementById('btn-analyze-label');
    if (lbl) lbl.textContent = 'Sélectionnez un devis pour analyser';
    document.querySelectorAll('.devis-radio').forEach(function(r) { r.checked = false; });
    document.querySelectorAll('.devis-card').forEach(function(c) { c.style.borderColor = ''; c.style.background = ''; });
  });

document.addEventListener('turbo:load', function () {
  const resultSection   = document.getElementById('analysis-result');
  const manualSection   = document.getElementById('manual-form-section');
  const btnAnalyze      = document.getElementById('btn-analyze');
  const btnRetry        = document.getElementById('btn-retry');
  const btnLabel        = document.getElementById('btn-analyze-label');
  const radios          = document.querySelectorAll('.devis-radio');
  const texteLibre      = document.getElementById('texte_libre');

  let selectedDevisId    = null;
  let selectedSourceType = null;

  function enableButton(label) {
    if (!btnAnalyze) return;
    btnAnalyze.disabled = false;
    btnAnalyze.style.opacity = '1';
    btnAnalyze.style.pointerEvents = 'auto';
    if (label && btnLabel) btnLabel.textContent = label;
  }

  function resetButton() {
    if (!btnAnalyze) return;
    btnAnalyze.disabled = true;
    btnAnalyze.style.opacity = '0.4';
    btnAnalyze.style.pointerEvents = 'none';
    if (btnLabel) btnLabel.textContent = 'Analyser le devis avec l\'IA';
  }

  // Sélection d'un devis radio — écoute click ET change pour fiabilité
  radios.forEach(function(radio) {
    ['change', 'click'].forEach(function(evt) {
      radio.addEventListener(evt, function() {
        selectedDevisId    = this.value;
        selectedSourceType = this.dataset.sourceType;
        // Highlight card sélectionnée
        document.querySelectorAll('.devis-card').forEach(function(c) {
          c.style.borderColor = '';
          c.style.background  = '';
        });
        var card = this.closest('.devis-card');
        if (card) {
          card.style.borderColor = 'var(--ren0vate-accent)';
          card.style.background  = 'rgba(217,119,6,0.04)';
        }
        if (resultSection) resultSection.style.display = 'none';
        enableButton('Analyser avec l\'IA');
      });
    });
  });

  // Clic sur la label card elle-même (redondant mais très fiable)
  document.querySelectorAll('.devis-card').forEach(function(card) {
    card.addEventListener('click', function() {
      var radio = this.querySelector('.devis-radio');
      if (radio && !radio.checked) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change'));
      }
    });
  });

  // Texte libre
  if (texteLibre) {
    texteLibre.addEventListener('input', function() {
      selectedDevisId    = null;
      selectedSourceType = 'manuel';
      if (this.value.trim().length > 50) {
        enableButton('Analyser le texte avec l\'IA');
      } else {
        resetButton();
        if (btnLabel) btnLabel.textContent = 'Collez du texte pour analyser';
      }
    });
  }

  function doAnalyze() {
    if (!btnAnalyze || !btnLabel) return;
    btnLabel.textContent = 'Analyse en cours\u2026';
    btnAnalyze.disabled  = true;
    btnAnalyze.style.opacity = '0.7';

    const body = new URLSearchParams({
      authenticity_token: document.querySelector('meta[name="csrf-token"]')?.content || ''
    });
    if (selectedDevisId) {
      body.append('devis_donnee_id', selectedDevisId);
    } else if (texteLibre && texteLibre.value.trim()) {
      body.append('texte_libre', texteLibre.value.trim());
    }

    fetch('<%= analyze_devis_project_etats_avancement_index_path(@project) %>', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded',
                 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
      body: body.toString()
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      enableButton('Analyser de nouveau');
      if (!data.success) {
        alert('Erreur IA : ' + (data.error || 'Inconnue'));
        return;
      }
      renderResult(data);
    })
    .catch(function(err) {
      enableButton('Analyser avec l\'IA');
      alert('Erreur r\u00e9seau : ' + err.message);
    });
  }

  if (btnAnalyze) btnAnalyze.addEventListener('click', doAnalyze);

  var btnCreate = document.getElementById('btn-create');
  if (btnCreate) btnCreate.addEventListener('click', function() {
    var form = document.getElementById('form-create');
    if (form) form.submit();
  });

  if (btnRetry) btnRetry.addEventListener('click', function() {
    if (resultSection) resultSection.style.display = 'none';
    enableButton('Analyser de nouveau');
  });

  // Rendu du résultat IA
  function renderResult(data) {
    // Résumé
    const resumeEl = document.getElementById('ia-resume');
    resumeEl.innerHTML = '<i class="bi bi-stars me-2" style="color:#4f46e5;"></i><span class="small">' +
      escHtml(data.resume || '') + '</span>';

    // Stats
    const statsEl = document.getElementById('ia-stats');
    statsEl.innerHTML = [
      stat('bi-layers',  data.nb_thematiques + ' thématiques', '#4f46e5'),
      stat('bi-list-ul', data.nb_postes + ' postes',          'var(--ren0vate-accent)'),
      stat('bi-currency-euro', data.montant_total_htva ? fmtMoney(data.montant_total_htva) + ' HTVA' : '—', '#198754')
    ].map(function(s) { return '<div class="col-auto">' + s + '</div>'; }).join('');

    // Thématiques
    const themEl = document.getElementById('ia-thematiques');
    themEl.innerHTML = '';
    (data.thematiques || []).forEach(function(them) {
      themEl.insertAdjacentHTML('beforeend', renderThematique(them));
    });

    // Préparer le formulaire caché
    document.getElementById('hidden-analysis-json').value  = JSON.stringify(data);
    document.getElementById('hidden-devis-donnee-id').value = selectedDevisId || '';
    document.getElementById('hidden-source-type').value    = selectedSourceType || 'devis_entrepreneur';

    resultSection.style.display = 'block';
    resultSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderThematique(them) {
    const poids = them.poids_estime_pct || 0;
    const lignesHtml = (them.lignes || []).map(function(l) {
      const confColor = { haute: '#198754', moyenne: '#fd7e14', faible: '#dc3545' }[l.ia_confiance] || '#6c757d';
      return '<tr>' +
        '<td style="font-size:0.78rem;color:#555;">' + escHtml(l.reference || '—') + '</td>' +
        '<td style="font-size:0.8rem;">' + escHtml(l.designation) + '<br><small class="text-muted">' + escHtml(l.sous_secteur || '') + '</small></td>' +
        '<td class="text-nowrap" style="font-size:0.78rem;color:#555;">' + escHtml(l.quantite ? l.quantite + ' ' + l.unite : l.unite || '—') + '</td>' +
        '<td class="text-end text-nowrap" style="font-size:0.78rem;font-weight:600;">' +
          (l.montant_marche ? fmtMoney(l.montant_marche) + ' €' : '—') + '</td>' +
        '<td class="text-center"><span class="badge rounded-pill" style="background:' + confColor + '20;color:' + confColor + ';font-size:0.65rem;">' + escHtml(l.ia_confiance || '?') + '</span></td>' +
        '</tr>';
    }).join('');

    return '<div class="card border rounded-3 mb-3">' +
      '<div class="card-header border-0 py-2 px-3 d-flex align-items-center justify-content-between" style="background:rgba(15,23,42,0.04);">' +
        '<span class="fw-semibold small">' + escHtml(them.label) + '</span>' +
        '<div class="d-flex align-items-center gap-2">' +
          '<span class="text-muted" style="font-size:0.72rem;">' + (them.lignes || []).length + ' postes</span>' +
          '<div style="width:60px;height:6px;background:#e9ecef;border-radius:4px;overflow:hidden;">' +
            '<div style="height:100%;width:' + poids + '%;background:var(--ren0vate-accent);border-radius:4px;"></div>' +
          '</div>' +
          '<span class="fw-bold" style="font-size:0.78rem;color:var(--ren0vate-accent);">' + poids + '%</span>' +
        '</div>' +
      '</div>' +
      '<div class="card-body p-0">' +
        '<div class="table-responsive">' +
          '<table class="table table-sm mb-0" style="font-size:0.82rem;">' +
            '<thead style="background:#f8f9fa;"><tr>' +
              '<th style="width:60px;" class="ps-3">Réf.</th>' +
              '<th>Désignation</th>' +
              '<th style="width:90px;">Qté/Unit.</th>' +
              '<th class="text-end" style="width:110px;">Montant</th>' +
              '<th class="text-center" style="width:80px;">Confiance</th>' +
            '</tr></thead>' +
            '<tbody>' + lignesHtml + '</tbody>' +
          '</table>' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  function stat(icon, label, color) {
    return '<div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3" style="background:rgba(0,0,0,0.04);">' +
      '<i class="bi ' + icon + '" style="color:' + color + ';font-size:1.1rem;"></i>' +
      '<span class="fw-semibold small">' + escHtml(label) + '</span>' +
      '</div>';
  }

  function escHtml(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function fmtMoney(n) {
    return parseFloat(n).toLocaleString('fr-BE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
});
</script>
