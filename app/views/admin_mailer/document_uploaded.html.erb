<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
      .container { max-width: 600px; margin: 0 auto; padding: 20px; }
      .header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; border-radius: 8px 8px 0 0; }
      .content { background: #f9f9f9; padding: 20px; border: 1px solid #ddd; border-top: none; }
      .document-list { background: white; padding: 15px; border-radius: 8px; margin: 15px 0; }
      .document-item { padding: 10px; border-bottom: 1px solid #eee; }
      .document-item:last-child { border-bottom: none; }
      .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
      .badge-type { background-color: #e3f2fd; color: #1976d2; }
      .info-box { background: #fff3cd; border-left: 4px solid #ffc107; padding: 15px; margin: 15px 0; }
      .footer { text-align: center; padding: 15px; color: #666; font-size: 12px; }
      .btn { display: inline-block; padding: 12px 24px; background: #667eea; color: white; text-decoration: none; border-radius: 6px; margin: 10px 0; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h2>📄 Nouveaux documents déposés</h2>
      </div>

      <div class="content">
        <p><strong>Utilisateur :</strong> <%= @user.email %></p>
        <p><strong>Date :</strong> <%= Time.current.strftime("%d/%m/%Y à %H:%M") %></p>

        <% if @property %>
          <p><strong>Propriété :</strong> <%= @property.address %></p>
        <% end %>

        <% if @project %>
          <p><strong>Projet :</strong> <%= @project.title %></p>
        <% end %>

        <% if @request %>
          <p><strong>Demande :</strong> <%= @request.title %></p>
        <% end %>

        <div class="info-box">
          <strong>📊 Total :</strong> <%= @documents.count %> document(s) déposé(s)
        </div>

        <div class="document-list">
          <h3>Documents déposés :</h3>
          <% @documents_by_type.each do |type, docs| %>
            <div style="margin: 15px 0;">
              <strong><%= type&.humanize || 'Sans catégorie' %></strong>
              <span class="badge badge-type"><%= docs.count %></span>
              <ul style="margin: 10px 0; padding-left: 20px;">
                <% docs.each do |doc| %>
                  <li class="document-item">
                    <% if doc.file.attached? %>
                      <%= doc.file.filename %>
                      (<%= number_to_human_size(doc.file.byte_size) %>)
                    <% else %>
                      Document sans fichier
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>

        <div style="text-align: center; margin-top: 20px;">
          <a href="<%= ENV.fetch('APP_URL', 'https://ren0vate.be') %>/admin/documents" class="btn">
            Voir tous les documents
          </a>
        </div>
      </div>

      <div class="footer">
        <p>Cette notification a été envoyée automatiquement par ren0vate.</p>
      </div>
    </div>
  </body>
</html>
