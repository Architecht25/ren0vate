<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: "Ajouter un document", subtitle: @project.nom } do %><% end %>

  <div class="row">
    <div class="col-12 col-lg-8">
      <%= simple_form_for [@project, @project_document] do |f| %>
        <%= f.error_notification %>

        <%= f.input :title, label: "Titre" %>
        <%= f.input :document_type, collection: ProjectDocument::DOCUMENT_TYPES.map { |t| [t.humanize, t] }, label: "Type de document", include_blank: false %>
        <%= f.input :lot_id, collection: @project.lots.ordered, label_method: :name, value_method: :id, label: "Lot", include_blank: "Tous les lots" %>
        <%= f.input :phase_id, collection: @project.phases.ordered, label_method: :name, value_method: :id, label: "Phase", include_blank: "Aucune phase" %>
        <%= f.input :visibility, collection: ProjectDocument::VISIBILITY_LABELS.invert, label: "Visibilité", include_blank: false %>

        <%= f.simple_fields_for :versions do |v| %>
          <%= v.input :file, as: :file, label: "Fichier" %>
        <% end %>

        <%= f.button :submit, "Ajouter le document", class: "btn btn-primary-custom" %>
      <% end %>
    </div>
  </div>
</div>
