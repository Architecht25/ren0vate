<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: "Documents", subtitle: @project.nom } do %>
    <%# V2 — Lot 5 : l'assistant lit le contenu de ces documents (RAG), sa
        place naturelle est donc ici plutôt qu'un onglet séparé — décidé
        avec Robin le 12/10/2026. %>
    <%= link_to project_assistant_path(@project), class: "btn btn-outline-secondary px-4" do %>
      <i class="bi bi-stars me-2"></i>Assistant sur ces documents
    <% end %>
    <%= link_to new_project_project_document_path(@project), class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter un document
    <% end %>
  <% end %>

  <% if @project_documents.any? %>
    <div class="row g-3">
      <% @project_documents.each do |document| %>
        <div class="col-12 col-md-6 col-lg-4">
          <%= link_to project_document_path(document), class: "text-decoration-none text-reset" do %>
            <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <span class="badge bg-secondary"><%= document.document_type_label %></span>
                  <span class="badge bg-<%= document.valide? ? 'success' : (document.refuse? ? 'danger' : 'warning') %>">
                    <%= document.status.humanize %>
                  </span>
                </div>
                <h3 class="h6 mb-1"><%= document.title %></h3>
                <div class="text-muted small">
                  <% if document.lot %><i class="bi bi-diagram-3 me-1"></i><%= document.lot.name %><% end %>
                  <% if document.phase %><span class="ms-2"><i class="bi bi-flag me-1"></i><%= document.phase.name %></span><% end %>
                </div>
                <div class="text-muted small mt-2">
                  Déposé par <%= document.uploaded_by.full_name.presence || document.uploaded_by.email %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center text-muted py-5">
      <i class="bi bi-folder2-open fs-1 d-block mb-3"></i>
      Aucun document pour l'instant.
    </div>
  <% end %>
</div>
