<% content_for :title, "Ajouter une obligation" %>

<div class="container py-4" style="max-width: 700px;">
  <div class="d-flex align-items-center mb-4">
    <%= link_to project_compliance_items_path(@project), class: "btn btn-outline-secondary btn-sm me-3" do %>
      <i class="bi bi-arrow-left"></i>
    <% end %>
    <div style="min-width: 0;">
      <h3 class="mb-0 text-truncate">Ajouter une obligation</h3>
      <p class="text-muted small mb-0 text-truncate"><%= @project.nom %></p>
    </div>
  </div>

  <%= simple_form_for [@project, @item] do |f| %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-shield-check me-2"></i>Détails</h6>
      </div>
      <div class="card-body p-4">
        <%= f.error_notification %>
        <div class="row g-3">
          <div class="col-12">
            <%= f.input :label, label: "Intitulé", input_html: { class: "form-control" } %>
          </div>
          <div class="col-md-6">
            <%= f.input :region, label: "Région", as: :select, collection: ComplianceItem::REGIONS.map { |r| [r.capitalize, r] }, include_blank: false, input_html: { class: "form-select" } %>
          </div>
          <div class="col-md-6">
            <%= f.input :category, label: "Catégorie", as: :select, collection: ComplianceItem::CATEGORIES.map { |c| [c.humanize, c] }, include_blank: false, input_html: { class: "form-select" } %>
          </div>
          <div class="col-md-6">
            <%= f.input :due_date, label: "Échéance (optionnel)", input_html: { class: "form-control" } %>
          </div>
        </div>
      </div>
      <div class="card-footer bg-transparent d-flex flex-wrap gap-2 justify-content-end">
        <%= link_to "Annuler", project_compliance_items_path(@project), class: "btn btn-outline-secondary" %>
        <%= f.submit "Ajouter", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
