<%= form_with model: @request, local: true, class: "needs-validation", novalidate: true do |form| %>
  <div class="mb-3">
    <%= form.label :title, "Titre de la demande*", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "Ex: Demande de prime pour isolation toiture", required: true %>
    <div class="invalid-feedback">
      Veuillez entrer un titre pour votre demande.
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Description de la demande*", class: "form-label" %>
    <%= form.text_area :description, rows: 3, class: "form-control", placeholder: "Décrivez brièvement votre demande de prime...", required: true %>
    <div class="invalid-feedback">
      Veuillez entrer une description pour votre demande.
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :region, "Région*", class: "form-label" %>
    <%= form.select :region,
        [
          ["Flandre", "flandre"],
          ["Bruxelles", "bruxelles"],
          ["Wallonie", "wallonie"]
        ],
        { include_blank: "-- Sélectionnez votre région --" },
        { class: "form-select", required: true, id: "region-select" } %>
    <div class="invalid-feedback">
      Veuillez sélectionner votre région.
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :property_id, "Propriété associée", class: "form-label" %>
    <%= form.select :property_id,
        options_from_collection_for_select(current_user.properties, :id, :address, @request.property_id),
        { include_blank: "-- Sélectionnez une propriété --" },
        { class: "form-select" } %>
    <small class="form-text text-muted">
      Sélectionnez la propriété concernée par cette demande de prime.
    </small>
  </div>

  <!-- Sélection du type de formulaire (affiché après sélection de région) -->
  <div id="form-type-section" class="mb-3" style="display: none;">
    <%= form.label :form_type, "Type de formulaire*", class: "form-label" %>
    <%= form.select :form_type,
        [],
        { include_blank: "-- Sélectionnez le type de formulaire --" },
        { class: "form-select", required: true, id: "form-type-select" } %>
    <div class="invalid-feedback">
      Veuillez sélectionner le type de formulaire.
    </div>
    <small class="form-text text-muted" id="form-type-description">
      Choisissez le type de formulaire adapté à votre situation.
    </small>
  </div>

  <!-- Section Flandre -->
  <div id="flandre-section" class="region-section" style="display: none;">
    <%= render 'requests/region_forms/flandre', form: form %>
  </div>

  <!-- Section Monuments & Sites Flandre -->
  <div id="flandre-monuments-section" class="region-section" style="display: none;">
    <div class="alert alert-info">
      <i class="bi bi-info-circle me-2"></i>
      <strong>Formulaire spécialisé Monuments & Sites - Flandre</strong>
      <p class="mb-0 small">Pour les biens classés ou situés dans des zones protégées en Flandre</p>
    </div>
    <%= render 'requests/formulaires/monuments_sites_flandre' %>
  </div>

  <!-- Section Formulaires Communaux Flandre -->
  <div id="flandre-communal-section" class="region-section" style="display: none;">
    <div class="alert alert-primary">
      <i class="bi bi-info-circle me-2"></i>
      <strong>Formulaires Communaux - Flandre</strong>
      <p class="mb-0 small">Primes complémentaires proposées par votre commune</p>
    </div>
    <%= render 'requests/formulaires/communaux_flandre' %>
  </div>

  <!-- Section Bruxelles -->
  <div id="bruxelles-section" class="region-section" style="display: none;">
    <%= render 'requests/region_forms/bruxelles', form: form %>
  </div>

  <!-- Section Monuments & Sites Bruxelles -->
  <div id="bruxelles-monuments-section" class="region-section" style="display: none;">
    <div class="alert alert-info">
      <i class="bi bi-info-circle me-2"></i>
      <strong>Formulaire spécialisé Monuments & Sites - Bruxelles</strong>
      <p class="mb-0 small">Pour les subventions de travaux de conservation aux biens classés en Région de Bruxelles-Capitale</p>
    </div>
    <%= render 'requests/formulaires/monuments_sites_bruxelles' %>
  </div>

  <!-- Section Petit Patrimoine Bruxelles -->
  <div id="bruxelles-petit_patrimoine-section" class="region-section" style="display: none;">
    <div class="alert alert-success">
      <i class="bi bi-info-circle me-2"></i>
      <strong>Formulaire spécialisé Petit Patrimoine - Bruxelles</strong>
      <p class="mb-0 small">Pour les subventions de conservation relatives au petit patrimoine non protégé en Région de Bruxelles-Capitale</p>
    </div>
    <%= render 'requests/formulaires/petit_patrimoine_bruxelles' %>
  </div>

  <!-- Section Primes Communales Bruxelles -->
  <div id="bruxelles-communal-section" class="region-section" style="display: none;">
    <div class="alert alert-warning">
      <i class="bi bi-info-circle me-2"></i>
      <strong>Primes Communales - Bruxelles</strong>
      <p class="mb-0 small">Primes complémentaires proposées par les 19 communes de la Région de Bruxelles-Capitale</p>
    </div>
    <%= render 'requests/formulaires/communales_bruxelles' %>
  </div>

  <!-- Section Wallonie -->
  <div id="wallonie-section" class="region-section" style="display: none;">
    <%= render 'requests/region_forms/wallonie', form: form %>
  </div>

  <!-- Section Monuments & Sites Wallonie -->
  <div id="wallonie-monuments-section" class="region-section" style="display: none;">
    <div class="alert alert-info">
      <i class="bi bi-info-circle me-2"></i>
      <strong>Formulaire spécialisé Monuments & Sites - Wallonie</strong>
      <p class="mb-0 small">Pour les biens classés ou situés dans des zones protégées en Wallonie</p>
    </div>
    <%= render 'requests/formulaires/monuments_sites_wallonie' %>
  </div>

  <!-- Section Primes Communales Wallonie -->
  <div id="wallonie-communal-section" class="region-section" style="display: none;">
    <div class="alert alert-success">
      <i class="bi bi-info-circle me-2"></i>
      <strong>Primes Communales - Wallonie</strong>
      <p class="mb-0 small">Primes complémentaires proposées par les communes wallonnes</p>
    </div>
    <%= render 'requests/formulaires/communales_wallonie' %>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex gap-2 mt-4">
    <% if @request.persisted? %>
      <%= form.submit "Mettre à jour", class: "btn btn-primary-custom px-4" %>
      <%= link_to @request, class: "btn btn-outline-secondary" do %>
        Annuler
      <% end %>
    <% else %>
      <%= form.submit "Créer la demande", class: "btn btn-primary-custom px-4" %>
      <%= form.submit "Sauvegarder en brouillon",
          name: "commit",
          value: "Sauvegarder en brouillon",
          class: "btn btn-outline-primary-custom px-4",
          formnovalidate: true %>

      <!-- Bouton spécifique pour la Flandre -->
      <a href="https://www.vlaanderen.be/premies-pour-renovation/mijn-verbouwpremie"
         target="_blank"
         rel="noopener noreferrer"
         class="btn btn-info px-4"
         id="flandre-continue-btn"
         style="display: none;">
        <i class="bi bi-box-arrow-up-right me-2"></i>
        Continuer sur le site Vlaanderen
      </a>

      <!-- Bouton spécifique pour la Wallonie -->
      <a href="https://energie.wallonie.be/fr/aides-et-primes.html?IDC=10717"
         target="_blank"
         rel="noopener noreferrer"
         class="btn btn-info px-4"
         id="wallonie-continue-btn"
         style="display: none;">
        <i class="bi bi-box-arrow-up-right me-2"></i>
        Continuer sur le site Wallonie
      </a>

      <!-- Bouton spécifique pour Bruxelles -->
      <a href="https://www.brussels.be/logement-et-energie/renovation-de-mon-logement/primes"
         target="_blank"
         rel="noopener noreferrer"
         class="btn btn-info px-4"
         id="bruxelles-continue-btn"
         style="display: none;">
        <i class="bi bi-box-arrow-up-right me-2"></i>
        Continuer sur le site Bruxelles
      </a>

      <%= link_to requests_path, class: "btn btn-outline-secondary" do %>
        Annuler
      <% end %>
    <% end %>
  </div>
<% end %>

<script>
  // Fonction pour initialiser les formulaires régionaux
  function initializeRegionalForms() {
    const regionSelect = document.getElementById('region-select');
    const sections = document.querySelectorAll('.region-section');

    console.log('Found sections:', sections.length);
    sections.forEach((section, index) => {
      console.log(`Section ${index}:`, section.id, section);
    });

    if (!regionSelect) {
      console.log('Region select not found');
      return;
    }

  function showRegionalSection() {
    const selectedRegion = regionSelect.value;
    console.log('Selected region:', selectedRegion);

    // Masquer toutes les sections régionales
    sections.forEach(section => {
      section.style.display = 'none';
    });

    // Afficher/masquer la section de sélection de type de formulaire
    const formTypeSection = document.getElementById('form-type-section');
    const formTypeSelect = document.getElementById('form-type-select');
    const formTypeDescription = document.getElementById('form-type-description');

    if (selectedRegion) {
      // Afficher la section de type de formulaire
      formTypeSection.style.display = 'block';

      // Mettre à jour les options selon la région
      updateFormTypeOptions(selectedRegion, formTypeSelect, formTypeDescription);
    } else {
      // Masquer la section de type de formulaire
      formTypeSection.style.display = 'none';
      formTypeSelect.innerHTML = '<option value="">-- Sélectionnez le type de formulaire --</option>';
    }
  }

  function updateFormTypeOptions(region, selectElement, descriptionElement) {
    // Vider les options existantes
    selectElement.innerHTML = '<option value="">-- Sélectionnez le type de formulaire --</option>';

    // Définir les options selon la région
    const formTypes = {
      'flandre': [
        { value: 'regional', text: 'Formulaire régional', description: 'Prime régionale flamande standard' },
        { value: 'communal', text: 'Formulaires communaux', description: 'Primes complémentaires de votre commune' },
        { value: 'monuments', text: 'Monuments & Sites', description: 'Prime spéciale pour biens classés' }
      ],
      'bruxelles': [
        { value: 'regional', text: 'Formulaire régional', description: 'Prime régionale bruxelloise standard' },
        { value: 'monuments', text: 'Monuments & Sites', description: 'Prime spéciale pour biens classés' },
        { value: 'petit_patrimoine', text: 'Petit patrimoine', description: 'Prime pour éléments du petit patrimoine non protégé' },
        { value: 'communal', text: 'Primes communales', description: 'Primes complémentaires proposées par votre commune' }
      ],
      'wallonie': [
        { value: 'audit', text: 'Prime Audit Énergétique', description: 'Remboursement partiel de l\'audit énergétique' },
        { value: 'regionale', text: 'Prime Régionale', description: 'Primes habitation + énergie' },
        { value: 'communale', text: 'Primes Communales', description: 'Primes spécifiques de votre commune' },
        { value: 'monument', text: 'Prime Monument & Site', description: 'Primes pour biens classés ou en zone protégée' }
      ]
    };

    // Ajouter les options pour la région sélectionnée
    if (formTypes[region]) {
      formTypes[region].forEach(option => {
        const optionElement = document.createElement('option');
        optionElement.value = option.value;
        optionElement.textContent = option.text;
        optionElement.dataset.description = option.description;
        selectElement.appendChild(optionElement);
      });
    }

    // Mettre à jour la description
    descriptionElement.textContent = 'Choisissez le type de formulaire adapté à votre situation.';
  }

  function showFormTypeSection() {
    const selectedFormType = document.getElementById('form-type-select').value;
    const selectedRegion = regionSelect.value;

    console.log('Selected form type:', selectedFormType, 'for region:', selectedRegion);

    // Masquer toutes les sections régionales
    sections.forEach(section => {
      section.style.display = 'none';
    });

    // Masquer toutes les sections wallonnes spécifiquement
    const wallonieSections = document.querySelectorAll('.wallonie-prime-section');
    wallonieSections.forEach(section => {
      section.style.display = 'none';
    });

    // Afficher la section appropriée selon le type et la région
    if (selectedFormType && selectedRegion) {
      let targetSectionId = '';

      // Logique spéciale pour la Wallonie
      if (selectedRegion === 'wallonie') {
        // Pour la Wallonie, on affiche directement la section spécifique
        if (selectedFormType === 'communale') {
          targetSectionId = 'wallonie-communal-section';
        } else if (selectedFormType === 'monument') {
          targetSectionId = 'wallonie-monuments-section';
        } else {
          // Pour audit et regionale, on affiche la section wallonie principale
          const wallonieMasterSection = document.getElementById('wallonie-section');
          if (wallonieMasterSection) {
            wallonieMasterSection.style.display = 'block';
            console.log('Showing wallonie master section');
          }

          // Puis afficher la sous-section spécifique selon le type
          if (selectedFormType === 'audit' || selectedFormType === 'regionale') {
            const targetSection = document.getElementById(selectedFormType + '-section');
            if (targetSection) {
              targetSection.style.display = 'block';
              console.log('Showing wallonie subsection:', selectedFormType + '-section');
            }
          }
        }

        // Afficher la section spécifique si targetSectionId est défini pour la Wallonie
        if (targetSectionId) {
          const targetSection = document.getElementById(targetSectionId);
          if (targetSection) {
            targetSection.style.display = 'block';
            console.log('Showing wallonie specific section:', targetSectionId);
          }
        }
      } else {
        // Pour les autres régions, logique normale
        if (selectedFormType === 'regional') {
          targetSectionId = selectedRegion + '-section';
        } else if (selectedFormType === 'communal') {
          targetSectionId = selectedRegion + '-communal-section';
        } else if (selectedFormType === 'monuments') {
          targetSectionId = selectedRegion + '-monuments-section';
        } else if (selectedFormType === 'petit_patrimoine') {
          targetSectionId = selectedRegion + '-petit_patrimoine-section';
        }

        const targetSection = document.getElementById(targetSectionId);
        if (targetSection) {
          targetSection.style.display = 'block';
          console.log('Showing section:', targetSectionId);
        } else {
          // Fallback vers la section régionale principale
          const fallbackSection = document.getElementById(selectedRegion + '-section');
          if (fallbackSection) {
            fallbackSection.style.display = 'block';
            console.log('Fallback to regional section:', selectedRegion + '-section');
          }
        }
      }
    }

    // Mettre à jour la description selon l'option sélectionnée
    const formTypeSelect = document.getElementById('form-type-select');
    const selectedOption = formTypeSelect.querySelector(`option[value="${selectedFormType}"]`);
    const descriptionElement = document.getElementById('form-type-description');

    if (selectedOption && selectedOption.dataset.description) {
      descriptionElement.textContent = selectedOption.dataset.description;
    }

    // Gérer l'affichage des boutons spécifiques aux régions
    updateRegionalButtons(selectedRegion, selectedFormType);
  }

  function updateRegionalButtons(region, formType) {
    // Masquer tous les boutons régionaux
    const buttons = ['flandre-continue-btn', 'wallonie-continue-btn', 'bruxelles-continue-btn'];
    buttons.forEach(btnId => {
      const btn = document.getElementById(btnId);
      if (btn) btn.style.display = 'none';
    });

    // Afficher le bouton approprié pour le formulaire régional
    if (formType === 'regional' && region) {
      const targetBtn = document.getElementById(region + '-continue-btn');
      if (targetBtn) {
        targetBtn.style.display = 'inline-block';
      }
    }
  }    // Initialiser immédiatement
    console.log('Initial region value:', regionSelect.value);
    showRegionalSection();

    // Écouter les changements sur le sélecteur de région
    regionSelect.addEventListener('change', showRegionalSection);

    // Écouter les changements sur le sélecteur de type de formulaire
    const formTypeSelect = document.getElementById('form-type-select');
    if (formTypeSelect) {
      formTypeSelect.addEventListener('change', showFormTypeSection);
    }

    // Réessayer après un court délai pour s'assurer que tout est chargé
    setTimeout(function() {
      console.log('Delayed initialization - region value:', regionSelect.value);
      showRegionalSection();
    }, 100);
  }

  // Initialiser au chargement de la page
  document.addEventListener('DOMContentLoaded', initializeRegionalForms);

  // Réessayer avec Turbo (Rails 7+)
  document.addEventListener('turbo:load', initializeRegionalForms);

  // Fallback pour les anciennes versions de Rails
  document.addEventListener('page:load', initializeRegionalForms);
</script>
