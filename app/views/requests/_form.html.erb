<%= form_with model: @request, local: true, class: "needs-validation", novalidate: true, data: {
  controller: "request-form request-autosave",
  request_autosave_target: "form",
  request_id: @request.persisted? ? @request.id : 'new'
} do |form| %>

  <!-- Indicateur de progression -->
  <%= render 'requests/progress_indicator' if @request.persisted? %>

  <!-- Rangée 1 : Titre et Description -->
  <% if @property.blank? %>
    <div class="row mb-3">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :title, "Titre de la demande*", class: "form-label" %>
          <%= form.text_field :title, class: "form-control", placeholder: "Ex: Demande de prime pour isolation toiture", required: true %>
          <div class="invalid-feedback">
            Veuillez entrer un titre pour votre demande.
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :description, "Description de la demande*", class: "form-label" %>
          <%= form.text_area :description, rows: 2, class: "form-control", placeholder: "Décrivez brièvement votre demande de prime...", required: true %>
          <div class="invalid-feedback">
            Veuillez entrer une description pour votre demande.
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Champs région et propriété -->
  <div class="row mb-3">
    <% if @property.blank? %>
      <div class="col-md-4">
        <div class="mb-3">
          <%= form.label :region, "Région*", class: "form-label" %>
          <%= form.select :region,
              [
                ["Flandre", "flandre"],
                ["Bruxelles", "bruxelles"],
                ["Wallonie", "wallonie"]
              ],
              { include_blank: "-- Sélectionnez votre région --" },
              {
                class: "form-select",
                required: true,
                id: "region-select",
                data: { request_form_target: "regionSelect", action: "change->request-form#regionChanged" }
              } %>
          <div class="invalid-feedback">
            Veuillez sélectionner votre région.
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="mb-3">
          <%= form.label :property_id, "Propriété associée", class: "form-label" %>
          <%= form.select :property_id,
              options_from_collection_for_select(current_user.properties, :id, :address, @request.property_id),
              { include_blank: "-- Sélectionnez une propriété --" },
              { class: "form-select" } %>
          <small class="form-text text-muted">
            Sélectionnez la propriété concernée par cette demande de prime.
          </small>
        </div>
      </div>

      <div class="col-md-4">
        <!-- Sélection du type de formulaire sera gérée par la version avec propriété pré-sélectionnée -->
      </div>
    <% else %>
      <!-- Champs cachés pour propriété pré-sélectionnée -->
      <%= form.hidden_field :region, value: @property.region %>
      <%= form.hidden_field :property_id, value: @property.id %>

      <!-- Sélecteur caché pour que le JavaScript fonctionne -->
      <%= form.select :region,
          [[@property.region.capitalize, @property.region]],
          { selected: @property.region },
          {
            class: "form-select d-none",
            id: "region-select",
            data: { request_form_target: "regionSelect", action: "change->request-form#regionChanged" }
          } %>

      <div class="col-md-12">
        <% if @request.persisted? %>
          <div class="alert alert-info mb-3">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Modification du brouillon</strong> - Région: <%= @request.region.capitalize %>
          </div>
        <% end %>

        <!-- Sélection des formulaires toujours visible (création et édition) -->
        <div id="form-type-section" class="mb-3" style="display: block; background-color: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #dee2e6; opacity: 0.8;" data-request-form-target="formTypeSection">
          <%= form.label :form_type, "Type de formulaire*", class: "form-label mb-3", style: "color: #6c757d;" %>

          <!-- Champ caché pour stocker la valeur sélectionnée -->
          <%= form.hidden_field :form_type, id: "form-type-select", data: { request_form_target: "formTypeSelect" } %>

          <!-- Boutons de sélection de formulaire -->
          <div class="row g-3" data-request-form-target="formTypeButtons" style="filter: grayscale(20%);">
            <!-- Les boutons seront ajoutés dynamiquement par JavaScript -->
          </div>

          <div class="invalid-feedback d-block" id="form-type-error" style="display: none;">
            Veuillez sélectionner le type de formulaire.
          </div>
          <small class="form-text text-muted" id="form-type-description" data-request-form-target="formTypeDescription" style="color: #6c757d;">
            Choisissez le type de formulaire adapté à votre situation.
          </small>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Section Flandre -->
  <div id="flandre-section" class="region-section"
       style="display: none;">
    <%= render 'requests/region_forms/flandre', form: form, form_data: @form_data %>
  </div>

  <!-- Section Monuments & Sites Flandre -->
  <div id="flandre-monuments-section" class="region-section"
       style="display: none;">
    <%= render 'requests/formulaires/monuments_sites_flandre' %>
  </div>

  <!-- Section Formulaires Communaux Flandre -->
  <div id="flandre-communal-section" class="region-section"
       style="display: none;">
    <%= render 'requests/formulaires/communaux_flandre' %>
  </div>

  <!-- Section Bruxelles -->
  <div id="bruxelles-section" class="region-section"
       style="display: none;">
    <%= render 'requests/region_forms/bruxelles', form: form, form_data: @form_data %>
  </div>

  <!-- Section Monuments & Sites Bruxelles -->
  <div id="bruxelles-monuments-section" class="region-section"
       style="display: none;">
    <%= render 'requests/formulaires/monuments_sites_bruxelles' %>
  </div>

  <!-- Section Petit Patrimoine Bruxelles -->
  <div id="bruxelles-petit_patrimoine-section" class="region-section"
       style="display: none;">

    <%= render 'requests/formulaires/petit_patrimoine_bruxelles' %>
  </div>

  <!-- Section Primes Communales Bruxelles -->
  <div id="bruxelles-communal-section" class="region-section"
       style="display: none;">
    <%= render 'requests/formulaires/communales_bruxelles' %>
  </div>

  <!-- Section Wallonie Regional -->
  <div id="wallonie-section" class="region-section"
       style="display: none;">
    <%= render 'requests/region_forms/wallonie', form: form, form_data: @form_data %>
  </div>

  <!-- Section Audit Énergétique Wallonie -->
  <div id="wallonie-audit-section" class="region-section"
       style="display: none;">
    <%= render 'requests/region_forms/audit_energetique_wallonie', form: form %>
  </div>

  <!-- Section Monuments & Sites Wallonie -->
  <div id="wallonie-monuments-section" class="region-section"
       style="display: none;">
    <%= render 'requests/formulaires/monuments_sites_wallonie', form: form %>
  </div>

  <!-- Section Primes Communales Wallonie -->
  <div id="wallonie-communal-section" class="region-section"
       style="display: none;">
    <%= render 'requests/formulaires/communales_wallonie', form: form %>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex gap-2 mt-4" id="submission-buttons" style="display: flex;">
    <% if @request.persisted? %>
      <% if @request.draft? %>
        <!-- Brouillon existant - permet encore de sauvegarder ou de soumettre -->
        <%= form.submit "Créer la demande", class: "btn btn-primary-custom px-4" %>
        <%= form.submit "Sauvegarder en brouillon",
            name: "commit",
            value: "Sauvegarder en brouillon",
            class: "btn btn-outline-primary-custom px-4",
            formnovalidate: true %>
      <% else %>
        <!-- Demande déjà soumise - mise à jour simple -->
        <%= form.submit "Mettre à jour", class: "btn btn-primary-custom px-4" %>
      <% end %>
      <%= link_to @request, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-eye me-2"></i>Voir
      <% end %>
    <% else %>
      <!-- Nouvelles demandes - boutons de soumission -->
      <%= form.submit "Créer la demande", class: "btn btn-primary-custom px-4" %>
      <%= form.submit "Sauvegarder en brouillon",
          name: "commit",
          value: "Sauvegarder en brouillon",
          class: "btn btn-outline-primary-custom px-4",
          formnovalidate: true %>

      <!-- Bouton de sauvegarde locale pour test -->
      <button type="button"
              onclick="document.querySelector('[data-controller*=request-autosave]').requestAutosaveController.performAutoSave()"
              class="btn btn-outline-success px-4">
        <i class="bi bi-floppy me-2"></i>Sauvegarder (Local)
      </button>

      <!-- Bouton spécifique pour la Flandre -->
      <a href="https://www.vlaanderen.be/premies-pour-renovation/mijn-verbouwpremie"
         target="_blank"
         rel="noopener noreferrer"
         class="btn btn-info px-4"
         id="flandre-continue-btn"
         style="display: none;">
        <i class="bi bi-box-arrow-up-right me-2"></i>
        Continuer sur le site Vlaanderen
      </a>

      <!-- Bouton spécifique pour la Wallonie -->
      <a href="https://energie.wallonie.be/fr/aides-et-primes.html?IDC=10717"
         target="_blank"
         rel="noopener noreferrer"
         class="btn btn-info px-4"
         id="wallonie-continue-btn"
         style="display: none;">
        <i class="bi bi-box-arrow-up-right me-2"></i>
        Continuer sur le site Wallonie
      </a>

      <!-- Bouton spécifique pour Bruxelles -->
      <a href="https://www.brussels.be/logement-et-energie/renovation-de-mon-logement/primes"
         target="_blank"
         rel="noopener noreferrer"
         class="btn btn-info px-4"
         id="bruxelles-continue-btn"
         style="display: none;">
        <i class="bi bi-box-arrow-up-right me-2"></i>
        Continuer sur le site Bruxelles
      </a>

    <% end %>
  </div>
<% end %>

<!-- Indicateur d'auto-save -->
<%= render 'shared/auto_save_status' %>

<% if @property.present? %>
  <!-- Script pour initialiser automatiquement le formulaire avec bien pré-sélectionné -->
  <script nonce="<%= content_security_policy_nonce %>">
    document.addEventListener('DOMContentLoaded', function() {
      console.log('🏠 Initialisation avec bien pré-sélectionné: <%= @property.region %>');

      // Attendre que tout soit chargé puis déclencher l'initialisation
      setTimeout(() => {
        const event = new CustomEvent('propertyPreselected', {
          detail: { region: '<%= @property.region %>' }
        });
        document.querySelector('[data-controller="request-form"]')?.dispatchEvent(event);
      }, 500);
    });
  </script>
<% end %>
