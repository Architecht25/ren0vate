  <!-- FIN SECTION FORMULAIRES ENTREPRISES -->

  <!-- Script pour gérer l'affichage des formulaires d'entreprise -->
  <script>
    function selectFormType(formType) {
      console.log('🏢 Sélection du formulaire:', formType);

      // Cacher tous les formulaires d'entreprise
      const allFormSections = document.querySelectorAll('[id$="-form-section"]');
      allFormSections.forEach(section => {
        section.style.display = 'none';
      });

      // Enlever la classe active de toutes les cartes
      const allCards = document.querySelectorAll('.form-selector-card');
      allCards.forEach(card => {
        card.classList.remove('border-primary');
        card.classList.add('border-secondary');
        card.style.borderWidth = '1px';
      });

      // Afficher le formulaire sélectionné
      const selectedSection = document.getElementById(formType + '-form-section');
      if (selectedSection) {
        selectedSection.style.display = 'block';
        console.log('✅ Formulaire affiché:', formType);
      } else {
        console.error('❌ Section non trouvée:', formType + '-form-section');
      }

      // Activer visuellement la carte sélectionnée
      const selectedCard = document.querySelector(`[data-form-type="${formType}"]`);
      if (selectedCard) {
        selectedCard.classList.remove('border-secondary');
        selectedCard.classList.add('border-primary');
        selectedCard.style.borderWidth = '2px';
        console.log('✅ Carte activée:', formType);
      }

      // Mettre à jour le champ form_type
      const formTypeSelect = document.querySelector('select[name="request[form_type]"]');
      if (formTypeSelect) {
        formTypeSelect.value = formType;
        console.log('✅ Form type mis à jour:', formType);
      }

      // Faire défiler vers le formulaire
      if (selectedSection) {
        selectedSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      return false;
    }

    // Fonction pour compatibilité avec l'ancien code
    function selectConsultanceForm() {
      return selectFormType('consultance');
    }
  </script>

  <!-- Boutons d'action - Version simplifiée -->
  <div class="row mt-5 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h5 class="mb-1 text-dark">
                <i class="bi bi-check-circle me-2 text-success"></i>
                Finaliser votre demande
              </h5>
              <p class="text-muted mb-0 small">
                Choisissez l'action que vous souhaitez effectuer avec ce formulaire
              </p>
            </div>
            <div class="d-flex gap-3">
              <% if @request.persisted? %>
                <% if @request.draft? %>
                  <!-- Brouillon existant -->
                  <input type="submit"
                         name="commit"
                         value="Sauvegarder en brouillon"
                         class="btn btn-outline-primary btn-lg px-4 py-2"
                         formnovalidate="formnovalidate">
                  <!-- Le bouton de soumission spécifique sera dans le formulaire régional -->
                <% else %>
                  <!-- Demande déjà soumise -->
                  <input type="submit"
                         value="Mettre à jour"
                         class="btn btn-primary btn-lg px-4 py-2">
                <% end %>
              <% else %>
                <!-- Nouvelles demandes - seulement le brouillon ici -->
                <button type="button"
                        onclick="document.getElementById('request-form-main').submit();"
                        class="btn btn-outline-primary btn-lg px-4 py-2 me-2">
                  <i class="bi bi-file-earmark me-2"></i>Sauvegarder en brouillon
                </button>
                <!-- Le bouton de soumission spécifique sera dans le formulaire régional -->
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<!-- Indicateur d'auto-save -->
<%= render 'shared/auto_save_status' %>

<% if @property.present? %>
  <!-- Script pour initialiser automatiquement le formulaire avec bien pré-sélectionné -->
  <script nonce="<%= content_security_policy_nonce %>">
    document.addEventListener('DOMContentLoaded', function() {
      console.log('🏠 Initialisation avec bien pré-sélectionné: <%= @property.region %>');

      // Attendre que tout soit chargé puis déclencher l'initialisation
      setTimeout(() => {
        const event = new CustomEvent('propertyPreselected', {
          detail: { region: '<%= @property.region %>' }
        });
        document.querySelector('[data-controller="request-form"]')?.dispatchEvent(event);
      }, 500);
    });
  </script>
<% end %>

<% if @request.form_type.present? %>
  <script>
    // Exécution immédiate sans attendre DOMContentLoaded
    (function() {
      console.log('=== EXECUTION IMMEDIATE ===');
      console.log('Form type:', '<%= @request.form_type %>');

      // Mapper les form_types avec leurs sections correspondantes
      const formTypeToSectionMap = {
        // Wallonie
        'regional_wallonie': 'wallonie-section',
        'audit_wallonie': 'wallonie-audit-section',
        'monuments_wallonie': 'wallonie-monuments-section',
        'communal_wallonie': 'wallonie-communal-section',

        // Bruxelles
        'regional_bruxelles': 'bruxelles-section',
        'monuments_bruxelles': 'bruxelles-monuments-section',
        'patrimoine_bruxelles': 'bruxelles-petit_patrimoine-section',
        'communal_bruxelles': 'bruxelles-communal-section',

        // Flandre
        'regional_flandre': 'flandre-section',
        'monuments_flandre': 'flandre-monuments-section',
        'communal_flandre': 'flandre-communal-section'
      };

      const currentFormType = '<%= @request.form_type %>';
      const sectionId = formTypeToSectionMap[currentFormType];

      console.log('Mapping result:', sectionId);

      // Fonction pour afficher la section avec retry
      function showSection() {
        if (sectionId) {
          // Cacher toutes les sections
          const allSections = document.querySelectorAll('.region-section');
          console.log('Available sections:', allSections.length);

          allSections.forEach(section => {
            section.style.display = 'none';
            console.log('Hidden section:', section.id);
          });

          // Afficher la section correspondante
          const targetSection = document.getElementById(sectionId);
          console.log('Target section found:', !!targetSection);

          if (targetSection) {
            targetSection.style.display = 'block';
            console.log(`✅ Affichage de la section: ${sectionId} pour form_type: ${currentFormType}`);
            return true;
          } else {
            console.error(`❌ Section non trouvée: ${sectionId}`);
            return false;
          }
        } else {
          console.error(`❌ Aucun mapping trouvé pour form_type: ${currentFormType}`);
          return false;
        }
      }

      // Essayer immédiatement
      if (!showSection()) {
        // Si ça échoue, réessayer après un petit délai
        setTimeout(() => {
          console.log('=== RETRY AFTER DELAY ===');
          showSection();
        }, 100);
      }
    })();
  </script>
<% else %>
  <script>
    console.log('❌ @request.form_type est vide ou non défini');
  </script>
<% end %>
