<div class="attestation-entrepreneur border rounded p-4 mb-4">
  <h3 class="mb-3">Attestation de l'entrepreneur – Travaux réalisés</h3>

  <div class="mb-3">
    <label for="entrepreneur_nom">Nom de l'entreprise</label>
    <input type="text" class="form-control" id="entrepreneur_nom" name="attestation[entrepreneur_nom]">
  </div>

  <div class="mb-3">
    <label for="entrepreneur_bce">Numéro BCE</label>
    <input type="text" class="form-control" id="entrepreneur_bce" name="attestation[entrepreneur_bce]" placeholder="0xxx.xxx.xxx">
  </div>

  <div class="mb-3">
    <label for="travaux_type">Nature des travaux</label>
    <select class="form-select" id="travaux_type" name="attestation[travaux_type]">
      <option value="">Sélectionnez</option>
      <option value="isolation_toiture">Isolation de la toiture</option>
      <option value="isolation_murs">Isolation des murs</option>
      <option value="chassis">Remplacement des châssis</option>
      <option value="chauffage">Installation d’un système de chauffage</option>
    </select>
  </div>

  <div class="mb-3">
    <label for="description">Description des matériaux utilisés / méthodes</label>
    <textarea class="form-control" id="description" name="attestation[description]" rows="3"></textarea>
  </div>

  <div class="mb-3">
    <label for="surface">Surface concernée (m²)</label>
    <input type="number" step="0.1" class="form-control" id="surface" name="attestation[surface]">
  </div>

  <div class="mb-3">
    <label for="date_travaux">Date de fin des travaux</label>
    <input type="date" class="form-control" id="date_travaux" name="attestation[date_travaux]">
  </div>

  <div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="conforme" name="attestation[conforme]">
    <label class="form-check-label" for="conforme">
      Je confirme que les travaux ont été réalisés conformément aux règles de l'art et aux normes en vigueur.
    </label>
  </div>

  <div class="mb-3">
    <label for="signature_nom">Nom du signataire (gérant ou représentant)</label>
    <input type="text" class="form-control" id="signature_nom" name="attestation[signature_nom]">
  </div>

  <div class="mb-3">
    <label for="signature_fichier">Signature scannée (PDF ou image)</label>
    <input type="file" class="form-control" id="signature_fichier" name="attestation[signature_fichier]">
  </div>
</div>
