<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-file-earmark-plus"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouvelle Demande</h1>
    </div>
    <%= link_to requests_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à la liste
    <% end %>
  </div>

  <!-- Formulaire dans une card épurée -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-info-circle me-2"></i>Informations de la demande
          </h5>

          <%= form_with model: @request, local: true, class: "needs-validation", novalidate: true do |form| %>
            <div class="mb-3">
              <%= form.label :title, "Titre de la demande*", class: "form-label" %>
              <%= form.text_field :title, class: "form-control", placeholder: "Ex: Demande de prime pour isolation toiture", required: true %>
              <div class="invalid-feedback">
                Veuillez entrer un titre pour votre demande.
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :description, "Description*", class: "form-label" %>
              <%= form.text_area :description, rows: 4, class: "form-control", placeholder: "Décrivez votre demande en détail...", required: true %>
              <div class="invalid-feedback">
                Veuillez entrer une description pour votre demande.
              </div>
            </div>

            <div class="mb-4">
              <%= form.label :status, "Statut", class: "form-label" %>
              <%= form.select :status,
                    options_for_select([
                      ['Brouillon', 'draft'],
                      ['En attente', 'pending'],
                      ['En cours', 'in_progress'],
                      ['Terminée', 'completed']
                    ], @request.status || 'draft'),
                    {},
                    { class: "form-select" } %>
            </div>

            <div class="d-flex gap-2">
              <%= form.submit "Créer la demande", class: "btn btn-primary-custom px-4" %>
              <%= link_to "Annuler", requests_path, class: "btn btn-outline-secondary px-4" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 bg-light-custom">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-lightbulb me-2"></i>Conseils
          </h6>
          <ul class="list-unstyled text-muted-custom small">
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Choisissez un titre descriptif
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Détaillez votre demande
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Sélectionnez le bon statut
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Validation Bootstrap
(function() {
  'use strict';
  var forms = document.querySelectorAll('.needs-validation');
  Array.prototype.slice.call(forms)
    .forEach(function(form) {
      form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
})();
</script>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
