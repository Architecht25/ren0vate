<div class="container-fluid px-4 py-4">
  <!-- Initialisation des données globales pour JavaScript -->
  <%= content_for :head do %>
    <script nonce="<%= content_security_policy_nonce %>">
      window.primes = <%= raw(@primes.to_json(only: [:id, :nom, :slug, :placeholder, :montant_max, :region])) if @primes.present? %> || [];
      window.categorieId = "1"; // Catégorie par défaut
    </script>
  <% end %>

  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-file-earmark-plus"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouvelle Demande</h1>
    </div>
    <%= link_to requests_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à la liste
    <% end %>
  </div>

  <!-- Sélection de bien pour pré-remplissage -->
  <% if current_user.properties.any? && params[:property_id].blank? %>
    <div class="card border-warning mb-4">
      <div class="card-header bg-warning text-dark">
        <h6 class="mb-0">
          <i class="bi bi-lightbulb me-2"></i>
          Pré-remplissage automatique
        </h6>
      </div>
      <div class="card-body">
        <p class="mb-3">Pour pré-remplir automatiquement les champs avec vos données, sélectionnez d'abord un bien :</p>
        <div class="row g-2">
          <% current_user.properties.each do |property| %>
            <div class="col-md-4">
              <%= link_to new_request_path(property_id: property.id), class: "btn btn-outline-success btn-sm d-block" do %>
                <i class="bi bi-house-door me-2"></i>
                <%= property.name %>
                <br><small class="text-muted"><%= property.full_address %></small>
              <% end %>
            </div>
          <% end %>
        </div>
        <hr>
        <small class="text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Ou continuez sans sélection (vous devrez remplir manuellement)
        </small>
      </div>
    </div>
  <% elsif @property.present? %>
    <div class="alert alert-success">
      <i class="bi bi-check-circle me-2"></i>
      <strong>Bien sélectionné :</strong> <%= @property.name %> - <%= @property.full_address %>
      <small class="d-block mt-1">Les champs seront automatiquement pré-remplis avec vos données.</small>
    </div>
  <% end %>

  <!-- Formulaire complet -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-form-check me-2"></i>Formulaire de demande de prime
          </h5>

          <%= render 'form' %>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
// Validation Bootstrap
(function() {
  'use strict';
  var forms = document.querySelectorAll('.needs-validation');
  Array.prototype.slice.call(forms)
    .forEach(function(form) {
      form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
})();
</script>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
