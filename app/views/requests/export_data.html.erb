    </div>
    <div class="toast-body">
      Données copiées dans le presse-papiers
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
// Fonction pour copier un champ individuel
function copyToClipboard(elementId) {
  const element = document.getElementById(elementId);
  const text = element.value || element.textContent;

  navigator.clipboard.writeText(text).then(() => {
    showToast();
  }).catch(() => {
    // Fallback pour navigateurs plus anciens
    element.select();
    document.execCommand('copy');
    showToast();
  });
}

// Fonction pour copier toutes les données personnelles
function copyPersonalData() {
  const data = [
    `Nom: ${document.getElementById('nom').value}`,
    `Prénom: ${document.getElementById('prenom').value}`,
    `Registre national: ${document.getElementById('registre_national').value}`,
    `Email: ${document.getElementById('email').value}`,
    `Téléphone: ${document.getElementById('telephone').value}`,
    `Type de demandeur: ${document.getElementById('type_demandeur').value}`
  ].join('\n');

  navigator.clipboard.writeText(data).then(() => showToast());
}

// Fonction pour copier les données d'adresse
function copyAddressData() {
  let data = [
    `Adresse: ${document.getElementById('adresse').value}`,
    `Code postal: ${document.getElementById('code_postal').value}`,
    `Commune: ${document.getElementById('commune').value}`
  ];

  if (document.getElementById('parcelle')) {
    data.push(`Parcelle: ${document.getElementById('parcelle').value}`);
  }
  if (document.getElementById('ean')) {
    data.push(`EAN: ${document.getElementById('ean').value}`);
  }

  navigator.clipboard.writeText(data.join('\n')).then(() => showToast());
}

// Fonction pour copier les caractéristiques du bien
function copyPropertyData() {
  let data = [
    `Type de bien: ${document.getElementById('type_bien').value}`,
    `Usage: ${document.getElementById('usage').value}`
  ];

  if (document.getElementById('chauffage_post_renovation')) {
    data.push(`Chauffage post-rénovation: ${document.getElementById('chauffage_post_renovation').value}`);
  }

  navigator.clipboard.writeText(data.join('\n')).then(() => showToast());
}

// Fonction pour copier les données financières
function copyFinancialData() {
  let data = [];

  if (document.getElementById('revenus_annuels')) {
    data.push(`Revenus annuels: ${document.getElementById('revenus_annuels').value} €`);
  }
  if (document.getElementById('personnes_charge')) {
    data.push(`Personnes à charge: ${document.getElementById('personnes_charge').value}`);
  }
  if (document.getElementById('compte_bancaire')) {
    data.push(`Compte bancaire: ${document.getElementById('compte_bancaire').value}`);
  }

  if (data.length > 0) {
    navigator.clipboard.writeText(data.join('\n')).then(() => showToast());
  }
}

