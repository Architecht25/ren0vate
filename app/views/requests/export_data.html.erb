<% content_for :title, "Export des données - Mijn Verbouwpremie" %>

<div class="container-fluid py-4">
  <div class="row justify-content-center">
    <div class="col-lg-10">

      <!-- Header -->
      <div class="card shadow-sm mb-4">
        <div class="card-body text-center bg-primary text-white rounded-top">
          <h1 class="h3 mb-2">
            <i class="bi bi-clipboard-data me-2"></i>
            Export de vos données
          </h1>
          <p class="mb-0">Copiez facilement vos informations vers le site officiel Mijn Verbouwpremie</p>
        </div>
      </div>

      <!-- Instructions -->
      <div class="alert alert-info d-flex align-items-start mb-4">
        <i class="bi bi-info-circle-fill fs-4 me-3 mt-1"></i>
        <div>
          <h6 class="alert-heading mb-2">Comment utiliser cet export :</h6>
          <ol class="mb-0">
            <li>Cliquez sur les boutons <strong>"Copier"</strong> ci-dessous pour copier chaque section</li>
            <li>Ouvrez le site <strong>Mijn Verbouwpremie</strong> dans un nouvel onglet</li>
            <li>Connectez-vous avec <strong>itsme</strong></li>
            <li>Collez les informations dans les champs correspondants du formulaire officiel</li>
          </ol>
        </div>
      </div>

      <!-- Section 1: Données personnelles -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-person-circle me-2"></i>
            Données personnelles
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Nom de famille</label>
              <div class="input-group">
                <input type="text" class="form-control" id="nom" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :nom, current_user.last_name) : (current_user.last_name || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('nom')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Prénom</label>
              <div class="input-group">
                <input type="text" class="form-control" id="prenom" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :prenom, current_user.first_name) : (current_user.first_name || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('prenom')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Numéro de registre national</label>
              <div class="input-group">
                <input type="text" class="form-control" id="registre_national" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :registre_national, current_user.national_number) : (current_user.national_number || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('registre_national')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Email</label>
              <div class="input-group">
                <input type="text" class="form-control" id="email" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :email, current_user.email) : (current_user.email || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('email')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Téléphone</label>
              <div class="input-group">
                <input type="text" class="form-control" id="telephone" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :telephone, current_user.phone) : (current_user.phone || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('telephone')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Type de demandeur</label>
              <div class="input-group">
                <input type="text" class="form-control" id="type_demandeur" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :type_demandeur, @property&.profil_demandeur) : (@property&.profil_demandeur || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('type_demandeur')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Bouton copier toute la section -->
          <div class="mt-3">
            <button class="btn btn-primary" onclick="copyPersonalData()">
              <i class="bi bi-clipboard-data me-2"></i>
              Copier toutes les données personnelles
            </button>
          </div>
        </div>
      </div>

      <!-- Section 2: Adresse du bien -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-house-door me-2"></i>
            Adresse du bien à rénover
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Adresse du logement</label>
              <div class="input-group">
                <input type="text" class="form-control" id="adresse" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :adresse, @property&.full_address) : (@property&.full_address || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('adresse')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Code postal</label>
              <div class="input-group">
                <input type="text" class="form-control" id="code_postal" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :code_postal, @property&.code_postal) : (@property&.code_postal || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('code_postal')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Commune</label>
              <div class="input-group">
                <input type="text" class="form-control" id="commune" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :commune, @property&.commune) : (@property&.commune || '') %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('commune')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <% parcelle_value = @request&.form_data ? preremplir_champ(@request.form_data, :parcelle, @property&.numero_cadastre) : (@property&.numero_cadastre || '') %>
            <% if parcelle_value.present? %>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Numéro de parcelle</label>
              <div class="input-group">
                <input type="text" class="form-control" id="parcelle" value="<%= parcelle_value %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('parcelle')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <% end %>
            <% ean_value = @request&.form_data ? preremplir_champ(@request.form_data, :ean, @property&.numero_ean) : (@property&.numero_ean || '') %>
            <% if ean_value.present? %>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Code EAN</label>
              <div class="input-group">
                <input type="text" class="form-control" id="ean" value="<%= ean_value %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('ean')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <% end %>
          </div>

          <div class="mt-3">
            <button class="btn btn-primary" onclick="copyAddressData()">
              <i class="bi bi-geo-alt me-2"></i>
              Copier toutes les données d'adresse
            </button>
          </div>
        </div>
      </div>

      <!-- Section 3: Caractéristiques du bien -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-building me-2"></i>
            Caractéristiques du bien
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Type de bien</label>
              <div class="input-group">
                <input type="text" class="form-control" id="type_bien" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :type_bien, nil) : '' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('type_bien')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Usage du bien</label>
              <div class="input-group">
                <input type="text" class="form-control" id="usage" value="<%= @request&.form_data ? preremplir_champ(@request.form_data, :usage, nil) : '' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('usage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <% chauffage_value = @request&.form_data ? preremplir_champ(@request.form_data, :chauffage_post_renovation, nil) : '' %>
            <% if chauffage_value.present? %>
            <div class="col-12">
              <label class="form-label fw-semibold">Système de chauffage après rénovation</label>
              <div class="input-group">
                <input type="text" class="form-control" id="chauffage_post_renovation" value="<%= chauffage_value %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('chauffage_post_renovation')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <% end %>
          </div>

          <div class="mt-3">
            <button class="btn btn-primary" onclick="copyPropertyData()">
              <i class="bi bi-building me-2"></i>
              Copier caractéristiques du bien
            </button>
          </div>
        </div>
      </div>

      <!-- Section 4: Données financières -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-calculator me-2"></i>
            Données financières
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <% revenus_value = @request&.form_data ? preremplir_champ(@request.form_data, :revenus_annuels, current_user.household_income) : (current_user.household_income || '') %>
            <% if revenus_value.present? %>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Revenus annuels (€)</label>
              <div class="input-group">
                <input type="text" class="form-control" id="revenus_annuels" value="<%= number_with_delimiter(revenus_value) %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('revenus_annuels')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <% end %>
            <% personnes_charge_value = @request&.form_data ? preremplir_champ(@request.form_data, :personnes_charge, current_user.nombre_enfants) : (current_user.nombre_enfants || '') %>
            <% if personnes_charge_value.present? %>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Personnes à charge</label>
              <div class="input-group">
                <input type="text" class="form-control" id="personnes_charge" value="<%= personnes_charge_value %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('personnes_charge')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <% end %>
            <% compte_bancaire_value = @request&.form_data ? preremplir_champ(@request.form_data, :compte_bancaire, current_user.iban) : (current_user.iban || '') %>
            <% if compte_bancaire_value.present? %>
            <div class="col-12">
              <label class="form-label fw-semibold">Compte bancaire</label>
              <div class="input-group">
                <input type="text" class="form-control" id="compte_bancaire" value="<%= compte_bancaire_value %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('compte_bancaire')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <% end %>
          </div>

          <div class="mt-3">
            <button class="btn btn-primary" onclick="copyFinancialData()">
              <i class="bi bi-cash-stack me-2"></i>
              Copier données financières
            </button>
          </div>
        </div>
      </div>

      <!-- Section 5: Détails techniques des travaux -->
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-tools me-2"></i>
            Détails techniques des travaux
          </h5>
          <small class="text-muted">Informations détaillées requises par Mijn Verbouwpremie</small>
        </div>
        <div class="card-body">

          <!-- Avertissement -->
          <div class="alert alert-info mb-4">
            <h6 class="alert-heading">
              <i class="bi bi-info-circle me-2"></i>
              Informations importantes
            </h6>
            <p class="mb-2">Le formulaire officiel demande des détails techniques spécifiques :</p>
            <ul class="mb-0">
              <li><strong>Surfaces en m²</strong> pour chaque type d'isolation</li>
              <li><strong>Méthodes d'isolation</strong> (sélection dans des listes déroulantes)</li>
              <li><strong>Types de systèmes</strong> de chauffage et ventilation</li>
              <li><strong>Attestations de l'entrepreneur</strong> pour valider les travaux</li>
            </ul>
          </div>

          <!-- Travaux d'isolation -->
          <% if @request&.form_data&.dig(:travaux_toiture) == "true" || @request&.form_data&.dig(:travaux_murs) == "true" || @request&.form_data&.dig(:travaux_sol) == "true" %>
          <div class="row g-3 mb-4">
            <div class="col-12">
              <h6 class="text-primary border-bottom pb-2">
                <i class="bi bi-house-gear me-2"></i>Travaux d'isolation
              </h6>
            </div>

            <% if @request&.form_data&.dig(:travaux_toiture) == "true" %>
            <div class="col-12">
              <div class="border rounded p-3 bg-light">
                <label class="form-label fw-semibold text-success">✓ Isolation de la toiture</label>
                <div class="row g-2">
                  <div class="col-md-3">
                    <label class="form-label small">Surface (m²)</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="surface_toiture" value="<%= @request&.form_data&.dig(:surface_toiture) || '[À compléter]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('surface_toiture')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Méthode d'isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="methode_toiture" value="<%= @request&.form_data&.dig(:methode_toiture) || '[Sélectionner dans la liste déroulante]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('methode_toiture')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Date de placement</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="date_placement_toiture" value="<%= @request&.form_data&.dig(:date_placement_toiture) || '[DD/MM/YYYY]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_toiture')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Matériau d'isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="materiau_toiture" value="<%= @request&.form_data&.dig(:materiau_toiture) || '[À sélectionner]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('materiau_toiture')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label small">Marque isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="marque_toiture" value="<%= @request&.form_data&.dig(:marque_toiture) || '[Nom de marque]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('marque_toiture')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% end %>

            <% if @request&.form_data&.dig(:travaux_murs) == "true" %>
            <div class="col-12">
              <div class="border rounded p-3 bg-light">
                <label class="form-label fw-semibold text-success">✓ Isolation des murs extérieurs</label>
                <div class="row g-2">
                  <div class="col-md-3">
                    <label class="form-label small">Surface (m²)</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="surface_murs" value="<%= @request&.form_data&.dig(:surface_murs) || '[À compléter]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('surface_murs')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Méthode d'isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="methode_murs" value="<%= @request&.form_data&.dig(:methode_murs) || '[Sélectionner dans la liste déroulante]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('methode_murs')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Date de placement</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="date_placement_murs" value="<%= @request&.form_data&.dig(:date_placement_murs) || '[DD/MM/YYYY]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_murs')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Matériau d'isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="materiau_murs" value="<%= @request&.form_data&.dig(:materiau_murs) || '[À sélectionner]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('materiau_murs')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label small">Marque isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="marque_murs" value="<%= @request&.form_data&.dig(:marque_murs) || '[Nom de marque]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('marque_murs')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% end %>

            <% if @request&.form_data&.dig(:travaux_sol) == "true" %>
            <div class="col-12">
              <div class="border rounded p-3 bg-light">
                <label class="form-label fw-semibold text-success">✓ Isolation du sol ou des caves</label>
                <div class="row g-2">
                  <div class="col-md-3">
                    <label class="form-label small">Surface (m²)</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="surface_sol" value="<%= @request&.form_data&.dig(:surface_sol) || '[À compléter]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('surface_sol')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Méthode d'isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="methode_sol" value="<%= @request&.form_data&.dig(:methode_sol) || '[À sélectionner]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('methode_sol')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Date de placement</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="date_placement_sol" value="<%= @request&.form_data&.dig(:date_placement_sol) || '[DD/MM/YYYY]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_sol')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <label class="form-label small">Matériau d'isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="materiau_sol" value="<%= @request&.form_data&.dig(:materiau_sol) || '[À sélectionner]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('materiau_sol')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label small">Marque isolation</label>
                    <div class="input-group input-group-sm">
                      <input type="text" class="form-control" id="marque_sol" value="<%= @request&.form_data&.dig(:marque_sol) || '[Nom de marque]' %>" readonly>
                      <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('marque_sol')">
                        <i class="bi bi-clipboard"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <% end %>
