<% content_for :title, "Debug Export Data" %>

<div class="container mt-4">
  <h1>Debug Export Data - Request #<%= @request.id %></h1>

  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h5>Debug: Form Data Raw</h5>
    </div>
    <div class="card-body">
      <pre><%= @request.form_data.inspect %></pre>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-warning">
      <h5>Debug: Travaux Keys Check</h5>
    </div>
    <div class="card-body">
      <% %w[travaux_toiture travaux_murs travaux_sol travaux_vitrage travaux_chauffage travaux_ventilation travaux_complementaires].each do |key| %>
        <div class="row mb-2">
          <div class="col-4"><strong><%= key %>:</strong></div>
          <div class="col-4">Value: <code><%= @request&.form_data&.dig(key).inspect %></code></div>
          <div class="col-4">
            Test:
            <% test_result = (@request&.form_data&.dig(key) == 'true') || (@request&.form_data&.dig(key) == true) %>
            <span class="badge bg-<%= test_result ? 'success' : 'danger' %>"><%= test_result %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5>Debug: Has Travaux Condition</h5>
    </div>
    <div class="card-body">
      <%
      has_travaux = %w[travaux_toiture travaux_murs travaux_sol travaux_vitrage travaux_chauffage travaux_ventilation travaux_complementaires].any? do |key|
        @request&.form_data&.dig(key) == 'true' || @request&.form_data&.dig(key) == true
      end
      %>
      <p><strong>has_travaux result:</strong> <span class="badge bg-<%= has_travaux ? 'success' : 'danger' %>"><%= has_travaux %></span></p>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5>Debug: Travaux Toiture Details</h5>
    </div>
    <div class="card-body">
      <% if (@request&.form_data&.dig('travaux_toiture') == 'true') || (@request&.form_data&.dig('travaux_toiture') == true) %>
        <div class="alert alert-success">✅ Travaux toiture détectés</div>
        <div class="row">
          <div class="col-md-6">
            <ul class="list-group">
              <li class="list-group-item">
                <strong>Surface:</strong> <%= @request&.form_data&.dig('surface_toiture') || '[non défini]' %>
              </li>
              <li class="list-group-item">
                <strong>Méthode:</strong> <%= @request&.form_data&.dig('methode_toiture') || '[non défini]' %>
              </li>
              <li class="list-group-item">
                <strong>Date:</strong> <%= @request&.form_data&.dig('date_placement_toiture') || '[non défini]' %>
              </li>
              <li class="list-group-item">
                <strong>Matériau:</strong> <%= @request&.form_data&.dig('materiau_toiture') || '[non défini]' %>
              </li>
              <li class="list-group-item">
                <strong>Marque:</strong> <%= @request&.form_data&.dig('marque_toiture') || '[non défini]' %>
              </li>
            </ul>
          </div>
        </div>
      <% else %>
        <div class="alert alert-warning">❌ Travaux toiture non détectés</div>
      <% end %>
    </div>
  </div>

  <div class="mt-4">
    <a href="<%= request_path(@request) %>" class="btn btn-secondary">← Retour à la demande</a>
    <a href="<%= export_data_request_path(@request) %>" class="btn btn-primary">Voir Export Data</a>
  </div>
</div>
