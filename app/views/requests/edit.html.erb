<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-pencil-square"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Modifier la Demande</h1>
    </div>
    <%= link_to @request, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour aux détails
    <% end %>
  </div>

  <!-- Formulaire complet -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-form-check me-2"></i>Formulaire complet de demande
          </h5>

          <% if @request.persisted? && !@request.can_be_edited? %>
            <div class="alert alert-warning mb-4" role="alert">
              <i class="bi bi-exclamation-triangle me-2"></i>
              <strong>Attention :</strong> Cette demande a été soumise et ne peut plus être modifiée de manière substantielle.
              Seules des corrections mineures sont possibles.
            </div>
          <% end %>

          <%= render 'form' %>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
// Validation Bootstrap
(function() {
  'use strict';
  var forms = document.querySelectorAll('.needs-validation');
  Array.prototype.slice.call(forms)
    .forEach(function(form) {
      form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
})();

// Initialisation spécifique pour l'édition
document.addEventListener('DOMContentLoaded', function() {
  console.log('🔧 Initialisation page d\'édition');
  console.log('   Région du brouillon: <%= @request.region %>');

  // Fonction d'initialisation pour affichage direct du formulaire
  function initializeEditForm() {
    const region = '<%= @request.region %>';
    if (!region) return;

    console.log('   Affichage direct du formulaire pour région:', region);

    // Masquer toutes les sections régionales d'abord
    const sections = document.querySelectorAll('.region-section');
    sections.forEach(section => {
      section.style.display = 'none';
    });

    // Afficher directement la section appropriée
    if (region === 'wallonie') {
      // Pour Wallonie, afficher la section principale et la sous-section régionale
      const wallonieSection = document.getElementById('wallonie-section');
      if (wallonieSection) {
        wallonieSection.style.display = 'block';
        console.log('   ✅ Section Wallonie affichée');

        // Afficher aussi la sous-section régionale par défaut
        setTimeout(() => {
          const regionaleSection = document.getElementById('regionale-section');
          if (regionaleSection) {
            regionaleSection.style.display = 'block';
            console.log('   ✅ Sous-section régionale affichée');
          }
        }, 100);
      }
    } else if (region === 'flandre') {
      const flandreSection = document.getElementById('flandre-section');
      if (flandreSection) {
        flandreSection.style.display = 'block';
        console.log('   ✅ Section Flandre affichée');
      }
    } else if (region === 'bruxelles') {
      const bruxellesSection = document.getElementById('bruxelles-section');
      if (bruxellesSection) {
        bruxellesSection.style.display = 'block';
        console.log('   ✅ Section Bruxelles affichée');
      }
    }

    // Afficher les boutons de soumission
    const buttonSection = document.getElementById('submission-buttons');
    if (buttonSection) {
      buttonSection.style.display = 'flex';
      console.log('   ✅ Boutons de soumission affichés');
    }

    return true;
  }

  // Lancer l'initialisation immédiatement
  if (!initializeEditForm()) {
    // Si ça échoue, réessayer avec un délai
    setTimeout(() => {
      initializeEditForm();
    }, 200);
  }
});
</script>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
