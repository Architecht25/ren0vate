<!-- Formulaire de demande d'aide pour la consultance - Bruxelles Entreprises -->
<div class="formulaire-consultance-bruxelles" data-controller="bruxelles-enterprise-form">

  <!-- En-tête informatif -->
  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-primary bg-opacity-10">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h4 class="card-title mb-1">
            <i class="bi bi-file-earmark-text text-primary me-2"></i>
            Demande d'aide pour la consultance
          </h4>
          <p class="text-muted small mb-0">Hors consultance relative aux sites internet et aux plateformes e-commerce</p>
        </div>
        <div class="col-md-4 text-end">
          <div class="badge bg-secondary">Code Subvention : 622</div>
        </div>
      </div>
    </div>

    <div class="card-body p-4">
      <!-- Informations importantes -->
      <div class="alert alert-info mb-4">
        <div class="row">
          <div class="col-md-6">
            <h6 class="alert-heading">
              <i class="bi bi-info-circle me-1"></i>
              Informations importantes
            </h6>
            <ul class="small mb-0">
              <li>Mission avec caractère <strong>exceptionnel</strong></li>
              <li>Ne peut débuter qu'après <strong>accusé de réception</strong></li>
              <li>Durée maximum : <strong>6 mois</strong></li>
              <li>Montant max : <strong>10.000€/an</strong></li>
              <li>Limite : <strong>5 missions/an</strong></li>
            </ul>
          </div>
          <div class="col-md-6">
            <h6 class="alert-heading">
              <i class="bi bi-telephone me-1"></i>
              Support
            </h6>
            <p class="small mb-1">
              <strong>Contenu :</strong> consult.eco@sprb.brussels<br>
              Tel : 02/800.34.41 - 02/800.34.66
            </p>
            <p class="small mb-0">
              <strong>Technique :</strong> monbee@sprb.brussels<br>
              Tel : 02/204.11.14
            </p>
          </div>
        </div>
      </div>

        <!-- Champs cachés pour la consultance -->
        <%= form.hidden_field :type_aide, value: "consultance" %>
        <%= form.hidden_field :region, value: "bruxelles" %>
        <%= form.hidden_field :categorie_entreprise, value: "entreprise" %>        <!-- PARTIE I : VOTRE ENTREPRISE -->
        <div class="section-form mb-5">
          <h5 class="section-title">
            <span class="badge bg-primary me-2">I</span>
            Votre entreprise
          </h5>

          <!-- 1.1 Renseignements généraux -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">1.1 - Renseignements généraux</h6>
            </div>
            <div class="card-body">

              <div class="row g-3">
                <!-- Type d'entreprise -->
                <div class="col-md-6">
                  <label class="form-label">Type d'entreprise <span class="text-danger">*</span></label>
                  <div class="d-flex gap-3">
                    <%= form.radio_button :type_entreprise, "personne_physique",
                        class: "form-check-input",
                        data: { action: "change->bruxelles-enterprise-form#updateTypeEntreprise" } %>
                    <label class="form-check-label" for="request_type_entreprise_personne_physique">
                      Personne physique
                    </label>

                    <%= form.radio_button :type_entreprise, "personne_morale",
                        class: "form-check-input ms-3",
                        data: { action: "change->bruxelles-enterprise-form#updateTypeEntreprise" } %>
                    <label class="form-check-label" for="request_type_entreprise_personne_morale">
                      Personne morale (société)
                    </label>
                  </div>
                </div>

                <!-- Nom/raison sociale -->
                <div class="col-md-6">
                  <label class="form-label">Nom ou raison sociale <span class="text-danger">*</span></label>
                  <%= form.text_field :nom_entreprise,
                      class: "form-control",
                      placeholder: "Nom de l'entreprise",
                      required: true %>
                  <div class="invalid-feedback">Veuillez saisir le nom de l'entreprise.</div>
                </div>

                <!-- Forme juridique -->
                <div class="col-md-6" data-bruxelles-enterprise-form-target="formeJuridique" style="display: none;">
                  <label class="form-label">Forme juridique</label>
                  <%= form.select :forme_juridique,
                      options_for_select([
                        ['SRL - Société à Responsabilité Limitée', 'srl'],
                        ['SA - Société Anonyme', 'sa'],
                        ['SPRL - Société Privée à Responsabilité Limitée', 'sprl'],
                        ['SC - Société Coopérative', 'sc'],
                        ['Autre', 'autre']
                      ]),
                      { prompt: 'Sélectionnez...' },
                      { class: "form-select" } %>
                </div>

                <!-- Dénomination commerciale -->
                <div class="col-md-6">
                  <label class="form-label">Dénomination commerciale éventuelle</label>
                  <%= form.text_field :denomination_commerciale,
                      class: "form-control",
                      placeholder: "Si différente du nom" %>
                </div>

                <!-- Numéro d'entreprise -->
                <div class="col-md-6">
                  <label class="form-label">Numéro d'entreprise <span class="text-danger">*</span></label>
                  <%= form.text_field :numero_entreprise,
                      class: "form-control",
                      placeholder: "BE 0XXX.XXX.XXX",
                      pattern: "BE\\s?[0-9]{4}\\.[0-9]{3}\\.[0-9]{3}",
                      required: true,
                      data: {
                        action: "input->bruxelles-enterprise-form#validateNumeroEntreprise"
                      } %>
                  <div class="invalid-feedback">Format requis : BE 0XXX.XXX.XXX</div>
                </div>

                <!-- Date de constitution -->
                <div class="col-md-3">
                  <label class="form-label">Date de constitution</label>
                  <%= form.date_field :date_constitution,
                      class: "form-control" %>
                </div>

                <!-- Date d'inscription BCE -->
                <div class="col-md-3">
                  <label class="form-label">Date d'inscription à la BCE</label>
                  <%= form.date_field :date_inscription_bce,
                      class: "form-control" %>
                </div>

                <!-- Email -->
                <div class="col-md-6">
                  <label class="form-label">E-mail <span class="text-danger">*</span></label>
                  <%= form.email_field :email_entreprise,
                      class: "form-control",
                      placeholder: "contact@entreprise.be",
                      required: true %>
                  <div class="invalid-feedback">Veuillez saisir un email valide.</div>
                </div>

                <!-- Site internet -->
                <div class="col-md-6">
                  <label class="form-label">Site internet</label>
                  <%= form.url_field :site_internet,
                      class: "form-control",
                      placeholder: "https://www.entreprise.be" %>
                </div>

                <!-- IBAN -->
                <div class="col-md-6">
                  <label class="form-label">IBAN <span class="text-danger">*</span></label>
                  <%= form.text_field :iban,
                      class: "form-control",
                      placeholder: "BE26 0689 4636 1329",
                      pattern: "BE[0-9]{2}\\s?[0-9]{4}\\s?[0-9]{4}\\s?[0-9]{4}",
                      required: true,
                      data: {
                        action: "input->bruxelles-enterprise-form#validateIban"
                      } %>
                  <div class="invalid-feedback">Format IBAN belge requis.</div>
                </div>
              </div>
            </div>
          </div>

          <!-- 1.2 Siège social et siège(s) d'exploitation -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">1.2 - Siège social et siège(s) d'exploitation</h6>
            </div>
            <div class="card-body">

              <!-- Siège social -->
              <h6 class="text-primary mb-3">Siège social</h6>
              <div class="row g-3 mb-4">
                <div class="col-md-6">
                  <label class="form-label">Rue <span class="text-danger">*</span></label>
                  <%= form.text_field :rue_siege_social,
                      class: "form-control",
                      placeholder: "Avenue de la Reine des Prés",
                      required: true %>
                </div>
                <div class="col-md-2">
                  <label class="form-label">N° <span class="text-danger">*</span></label>
                  <%= form.text_field :numero_siege_social,
                      class: "form-control",
                      placeholder: "7",
                      required: true %>
                </div>
                <div class="col-md-2">
                  <label class="form-label">Boîte</label>
                  <%= form.text_field :boite_siege_social,
                      class: "form-control",
                      placeholder: "A" %>
                </div>
                <div class="col-md-2">
                  <label class="form-label">Code postal <span class="text-danger">*</span></label>
                  <%= form.text_field :code_postal_siege_social,
                      class: "form-control",
                      placeholder: "1020",
                      pattern: "[0-9]{4}",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Commune <span class="text-danger">*</span></label>
                  <%= form.text_field :commune_siege_social,
                      class: "form-control",
                      placeholder: "Bruxelles",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Pays</label>
                  <%= form.text_field :pays_siege_social,
                      class: "form-control",
                      value: "Belgique" %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Téléphone <span class="text-danger">*</span></label>
                  <%= form.telephone_field :telephone_siege_social,
                      class: "form-control",
                      placeholder: "+32 (0) 471 65 29 92",
                      required: true %>
                </div>
              </div>

              <!-- Siège d'exploitation -->
              <h6 class="text-primary mb-3">Siège d'exploitation (unité d'établissement) relatif à la demande</h6>
              <div class="form-check mb-3">
                <%= form.check_box :siege_exploitation_identique,
                    class: "form-check-input",
                    data: { action: "change->bruxelles-enterprise-form#toggleSiegeExploitation" } %>
                <label class="form-check-label">
                  Identique au siège social
                </label>
              </div>

              <div data-bruxelles-enterprise-form-target="siegeExploitation">
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label">Rue <span class="text-danger">*</span></label>
                    <%= form.text_field :rue_siege_exploitation,
                        class: "form-control",
                        placeholder: "Avenue de la Reine des Prés" %>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label">N° <span class="text-danger">*</span></label>
                    <%= form.text_field :numero_siege_exploitation,
                        class: "form-control",
                        placeholder: "7" %>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label">Boîte</label>
                    <%= form.text_field :boite_siege_exploitation,
                        class: "form-control",
                        placeholder: "A" %>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label">Code postal <span class="text-danger">*</span></label>
                    <%= form.text_field :code_postal_siege_exploitation,
                        class: "form-control",
                        placeholder: "1020",
                        pattern: "[0-9]{4}" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Commune <span class="text-danger">*</span></label>
                    <%= form.text_field :commune_siege_exploitation,
                        class: "form-control",
                        placeholder: "Laeken" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">Téléphone <span class="text-danger">*</span></label>
                    <%= form.telephone_field :telephone_siege_exploitation,
                        class: "form-control",
                        placeholder: "+32 (0) 471 65 29 92" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label">N° de l'unité d'établissement</label>
                    <%= form.text_field :numero_unite_etablissement,
                        class: "form-control",
                        placeholder: "2.337.026.146" %>
                  </div>
                </div>

                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Avez-vous d'autre(s) siège(s) d'exploitation ? <span class="text-danger">*</span></label>
                    <div class="d-flex gap-3">
                      <%= form.radio_button :autres_sieges_exploitation, "oui", class: "form-check-input" %>
                      <label class="form-check-label">Oui</label>
                      <%= form.radio_button :autres_sieges_exploitation, "non", class: "form-check-input ms-3" %>
                      <label class="form-check-label">Non</label>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Certains sont-ils situés hors Région de Bruxelles-Capitale ?</label>
                    <div class="d-flex gap-3">
                      <%= form.radio_button :sieges_hors_bruxelles, "oui", class: "form-check-input" %>
                      <label class="form-check-label">Oui</label>
                      <%= form.radio_button :sieges_hors_bruxelles, "non", class: "form-check-input ms-3" %>
                      <label class="form-check-label">Non</label>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 1.3 Coordonnées de contact -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">1.3 - Coordonnées de contact</h6>
            </div>
            <div class="card-body">

              <!-- Personne de contact pour le suivi du dossier -->
              <h6 class="text-primary mb-3">Personne de contact pour le suivi du dossier</h6>
              <div class="row g-3 mb-4">
                <div class="col-md-2">
                  <label class="form-label">Titre <span class="text-danger">*</span></label>
                  <%= form.select :titre_contact,
                      options_for_select([
                        ['Madame', 'madame'],
                        ['Monsieur', 'monsieur']
                      ]),
                      { prompt: 'Titre...' },
                      { class: "form-select", required: true } %>
                </div>
                <div class="col-md-5">
                  <label class="form-label">Nom <span class="text-danger">*</span></label>
                  <%= form.text_field :nom_contact,
                      class: "form-control",
                      placeholder: "Burtin",
                      required: true %>
                </div>
                <div class="col-md-5">
                  <label class="form-label">Prénom <span class="text-danger">*</span></label>
                  <%= form.text_field :prenom_contact,
                      class: "form-control",
                      placeholder: "Clémence",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Fonction <span class="text-danger">*</span></label>
                  <%= form.text_field :fonction_contact,
                      class: "form-control",
                      placeholder: "Consultante externe",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">GSM <span class="text-danger">*</span></label>
                  <%= form.telephone_field :gsm_contact,
                      class: "form-control",
                      placeholder: "0474040712",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">E-mail <span class="text-danger">*</span></label>
                  <%= form.email_field :email_contact,
                      class: "form-control",
                      placeholder: "clemence@primes-services.be",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Ligne directe</label>
                  <%= form.telephone_field :ligne_directe_contact,
                      class: "form-control",
                      placeholder: "02/123.45.67" %>
                </div>
              </div>

              <!-- Personne légalement autorisée -->
              <h6 class="text-primary mb-3">Personne légalement autorisée à engager l'entreprise</h6>
              <div class="row g-3 mb-4">
                <div class="col-md-2">
                  <label class="form-label">Titre <span class="text-danger">*</span></label>
                  <%= form.select :titre_autorise,
                      options_for_select([
                        ['Madame', 'madame'],
                        ['Monsieur', 'monsieur']
                      ]),
                      { prompt: 'Titre...' },
                      { class: "form-select", required: true } %>
                </div>
                <div class="col-md-5">
                  <label class="form-label">Nom <span class="text-danger">*</span></label>
                  <%= form.text_field :nom_autorise,
                      class: "form-control",
                      placeholder: "ONDERET",
                      required: true %>
                </div>
                <div class="col-md-5">
                  <label class="form-label">Prénom <span class="text-danger">*</span></label>
                  <%= form.text_field :prenom_autorise,
                      class: "form-control",
                      placeholder: "Vicky",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Fonction <span class="text-danger">*</span></label>
                  <%= form.text_field :fonction_autorise,
                      class: "form-control",
                      placeholder: "Administratrice",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">GSM <span class="text-danger">*</span></label>
                  <%= form.telephone_field :gsm_autorise,
                      class: "form-control",
                      placeholder: "+32 (0) 471 65 29 92",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">E-mail <span class="text-danger">*</span></label>
                  <%= form.email_field :email_autorise,
                      class: "form-control",
                      placeholder: "info@vo-line.be",
                      required: true %>
                </div>
                <div class="col-md-4">
                  <label class="form-label">Ligne directe</label>
                  <%= form.telephone_field :ligne_directe_autorise,
                      class: "form-control",
                      placeholder: "02/123.45.67" %>
                </div>
              </div>

              <!-- Adresse postale -->
              <h6 class="text-primary mb-3">Adresse postale où BEE enverra les courriers</h6>
              <div class="row g-3">
                <div class="col-12">
                  <div class="d-flex gap-3">
                    <%= form.radio_button :adresse_courrier, "siege_social",
                        class: "form-check-input",
                        checked: true %>
                    <label class="form-check-label">Identique au siège social</label>

                    <%= form.radio_button :adresse_courrier, "siege_exploitation",
                        class: "form-check-input ms-3" %>
                    <label class="form-check-label">Identique au siège d'exploitation</label>

                    <%= form.radio_button :adresse_courrier, "autre",
                        class: "form-check-input ms-3" %>
                    <label class="form-check-label">Autre</label>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 1.4 Activités de l'entreprise -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">1.4 - Activités de l'entreprise pour laquelle le subside est demandé</h6>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Code NACE principal <span class="text-danger">*</span></label>
                  <%= form.text_field :code_nace_principal,
                      class: "form-control",
                      placeholder: "74104",
                      required: true %>
                  <small class="form-text text-muted">5 chiffres sans point</small>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Description activité principale</label>
                  <%= form.text_field :description_nace_principal,
                      class: "form-control",
                      placeholder: "Décoration d'intérieur" %>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Code NACE secondaire</label>
                  <%= form.text_field :code_nace_secondaire,
                      class: "form-control",
                      placeholder: "43320" %>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Description activité secondaire</label>
                  <%= form.text_field :description_nace_secondaire,
                      class: "form-control",
                      placeholder: "Travaux de menuiserie" %>
                </div>
                <div class="col-12">
                  <label class="form-label">Description des activités principales <span class="text-danger">*</span></label>
                  <%= form.text_area :description_activites,
                      class: "form-control",
                      rows: 3,
                      placeholder: "Décoration d'intérieur, petits travaux",
                      required: true %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PARTIE II : LA MISSION DE CONSULTANCE -->
        <div class="section-form mb-5">
          <h5 class="section-title">
            <span class="badge bg-primary me-2">II</span>
            La mission de consultance
          </h5>

          <!-- 2.1 Objet de la mission -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">2.1 - Objet de la mission</h6>
            </div>
            <div class="card-body">

              <!-- Rappel important -->
              <div class="alert alert-warning mb-4">
                <h6 class="alert-heading">
                  <i class="bi bi-exclamation-triangle me-1"></i>
                  Rappel important
                </h6>
                <p class="mb-2">Pour pouvoir être subventionnée, la mission de consultance doit avoir un <strong>caractère exceptionnel</strong> et viser la résolution d'un problème ponctuel.</p>
                <p class="small mb-0">
                  <strong>Cette mission ne peut pas :</strong><br>
                  • Débuter avant la date de l'accusé de réception<br>
                  • Débuter plus de trois mois après la notification de la décision par BEE<br>
                  • Durer plus de six mois<br>
                  • Constituer une activité permanente ou récurrente du bénéficiaire<br>
                  • Être en rapport avec les dépenses de fonctionnement normales<br>
                  • Être prestée de manière régulière en sous-traitance<br>
                  • Porter sur un problème pour lequel l'entreprise dispose des compétences suffisantes
                </p>
              </div>

              <!-- Types de missions éligibles -->
              <div class="mb-4">
                <label class="form-label">Type de mission <span class="text-danger">*</span></label>
                <div class="row g-2">
                  <% [
                    ["1. Consultance relative à des changements dans la production de produits ou de services", "changements_production"],
                    ["2. Étude de marché relative au lancement de nouveaux produits ou services ou à l'entrée dans de nouveaux marchés", "etude_marche"],
                    ["3. Étude juridique", "etude_juridique"],
                    ["4. Étude de faisabilité technique (prototypage ou étude de sols)", "etude_faisabilite"],
                    ["5. Conseil à la digitalisation, à la sécurisation informatique et aux services IT (hors plateforme e-commerce et sites internet)", "digitalisation"],
                    ["6. Aide à la gouvernance par l'appui d'un administrateur externe", "gouvernance"],
                    ["7. Élaboration ou consolidation d'un plan de diversité", "plan_diversite"],
                    ["8. Gouvernance participative via l'implication des travailleurs dans la prise de décision", "gouvernance_participative"],
                    ["9. Prévention de l'épuisement professionnel, aussi appelé syndrome de burnout", "prevention_burnout"],
                    ["10. Diagnostic dans le cadre de la reprise d'une entreprise", "diagnostic_reprise"],
                    ["11. Transition vers l'économie circulaire", "economie_circulaire"],
                    ["12. Établissement ou accompagnement à la mise en œuvre d'un plan de relance", "plan_relance"]
                  ].each do |label, value| %>
                    <div class="col-12">
                      <div class="form-check">
                        <%= form.radio_button :type_mission, value,
                            class: "form-check-input",
                            required: true %>
                        <label class="form-check-label small">
                          <%= label %>
                        </label>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Description de la mission -->
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label">Description de votre mission <span class="text-danger">*</span></label>
                  <%= form.text_area :description_mission,
                      class: "form-control",
                      rows: 4,
                      placeholder: "Digitalisation de l'entreprise, via un ERP. Veuillez joindre une offre détaillée et ventilée poste par poste.",
                      required: true %>
                  <small class="form-text text-muted">Veuillez joindre une offre détaillée et ventilée poste par poste</small>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Date de début prévue <span class="text-danger">*</span></label>
                  <%= form.date_field :date_debut_mission,
                      class: "form-control",
                      required: true %>
                  <small class="form-text text-muted">Ne peut débuter qu'après accusé de réception</small>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Date de fin prévue <span class="text-danger">*</span></label>
                  <%= form.date_field :date_fin_mission,
                      class: "form-control",
                      required: true %>
                  <small class="form-text text-muted">Maximum 6 mois après le début</small>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Coût de la mission (HTVA) <span class="text-danger">*</span></label>
                  <div class="input-group">
                    <%= form.number_field :cout_mission_htva,
                        class: "form-control",
                        placeholder: "20000",
                        step: 0.01,
                        min: 0,
                        required: true %>
                    <span class="input-group-text">€</span>
                  </div>
                  <small class="form-text text-muted">Maximum 10.000€ d'aide par an</small>
                </div>
              </div>
            </div>
          </div>

          <!-- 2.2 Le consultant -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">2.2 - Le consultant</h6>
            </div>
            <div class="card-body">

              <!-- Rappel important consultant -->
              <div class="alert alert-info mb-4">
                <h6 class="alert-heading">
                  <i class="bi bi-info-circle me-1"></i>
                  Exigences pour le consultant
                </h6>
                <div class="row">
                  <div class="col-md-6">
                    <p class="small mb-1"><strong>Le consultant/chef de projet doit :</strong></p>
                    <ul class="small mb-0">
                      <li>Être spécialisé dans le domaine concerné</li>
                      <li>Exercer ses activités de consultance depuis deux ans au moins</li>
                      <li>Faire preuve d'une compétence suffisamment notoire</li>
                      <li>Être indépendant économiquement et familialement du bénéficiaire</li>
                    </ul>
                  </div>
                  <div class="col-md-6">
                    <p class="small mb-1"><strong>L'entreprise prestataire doit :</strong></p>
                    <ul class="small mb-0">
                      <li>Ne pas avoir effectué de mission similaire subventionnée depuis deux ans</li>
                      <li>Facturer directement au bénéficiaire</li>
                      <li>Avoir la prestation de services de conseil comme activité principale</li>
                    </ul>
                  </div>
                </div>
              </div>

              <!-- Informations consultant -->
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Nom de l'entreprise prestataire <span class="text-danger">*</span></label>
                  <%= form.text_field :nom_entreprise_consultant,
                      class: "form-control",
                      placeholder: "VR2invest",
                      required: true %>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Numéro d'entreprise prestataire</label>
                  <%= form.text_field :numero_entreprise_consultant,
                      class: "form-control",
                      placeholder: "BE 0502.263.525",
                      pattern: "BE\\s?[0-9]{4}\\.[0-9]{3}\\.[0-9]{3}" %>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Site web du prestataire</label>
                  <%= form.url_field :site_web_consultant,
                      class: "form-control",
                      placeholder: "https://www.consultant.be" %>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Nom du consultant/chef de projet <span class="text-danger">*</span></label>
                  <%= form.text_field :nom_consultant,
                      class: "form-control",
                      placeholder: "Stephane Pozzi",
                      required: true %>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Numéro de téléphone consultant <span class="text-danger">*</span></label>
                  <%= form.telephone_field :telephone_consultant,
                      class: "form-control",
                      placeholder: "0479/97.50.10",
                      required: true %>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Adresse e-mail consultant <span class="text-danger">*</span></label>
                  <%= form.email_field :email_consultant,
                      class: "form-control",
                      placeholder: "stephan.pozzi@worldeur.com",
                      required: true %>
                </div>

                <div class="col-12">
                  <label class="form-label">Êtes-vous indépendant de votre prestataire ? <span class="text-danger">*</span></label>
                  <div class="d-flex gap-3">
                    <%= form.radio_button :independant_prestataire, "oui",
                        class: "form-check-input",
                        required: true %>
                    <label class="form-check-label">Oui</label>

                    <%= form.radio_button :independant_prestataire, "non",
                        class: "form-check-input" %>
                    <label class="form-check-label">Non</label>
                  </div>
                  <small class="form-text text-muted">L'indépendance économique et familiale est obligatoire</small>
                </div>
              </div>
            </div>
          </div>

          <!-- 2.3 Critères de majoration -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">2.3 - Critères de majoration de l'intervention</h6>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-12">
                  <div class="form-check">
                    <%= form.check_box :entreprise_sociale, class: "form-check-input" %>
                    <label class="form-check-label">
                      Entreprise agréée en tant qu'entreprise sociale en vertu du chapitre 2 de l'ordonnance du 23 juillet 2018
                    </label>
                  </div>
                </div>

                <div class="col-12">
                  <div class="form-check">
                    <%= form.check_box :economie_circulaire, class: "form-check-input" %>
                    <label class="form-check-label">
                      Entreprise reconnue sur base de l'arrêté du Gouvernement de la Région de Bruxelles-Capitale du 31 janvier 2019 relatif à la reconnaissance des entreprises impliquées dans l'économie circulaire
                    </label>
                  </div>
                </div>

                <div class="col-12">
                  <div class="form-check">
                    <%= form.check_box :plan_diversite, class: "form-check-input" %>
                    <label class="form-check-label">
                      Entreprise disposant d'un plan de diversité ou d'un label de diversité approuvé tels que prévus à l'arrêté du Gouvernement de la Région de Bruxelles-capitale du 7 mai 2009
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PARTIE III : DOCUMENTS À JOINDRE -->
        <div class="section-form mb-5">
          <h5 class="section-title">
            <span class="badge bg-primary me-2">III</span>
            Documents à joindre
          </h5>

          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">

              <div class="alert alert-warning mb-4">
                <h6 class="alert-heading">
                  <i class="bi bi-exclamation-triangle me-1"></i>
                  Documents obligatoires
                </h6>
                <ul class="mb-0">
                  <li>Déclaration sur l'honneur relative aux aides de minimis</li>
                  <li>Extrait bancaire (IBAN)</li>
                  <li>Offre/devis détaillé et ventilé poste par poste</li>
                  <li>Curriculum vitae du consultant mentionnant des missions similaires</li>
                  <li>Procuration (si nécessaire)</li>
                </ul>
              </div>

              <!-- Upload de documents -->
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Déclaration de subsides de minimis <span class="text-danger">*</span></label>
                  <%= form.file_field :document_declaration_minimis,
                      class: "form-control",
                      accept: ".pdf,.doc,.docx",
                      required: true %>
                  <small class="form-text text-muted">PDF, DOC ou DOCX uniquement</small>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Extrait bancaire (IBAN) <span class="text-danger">*</span></label>
                  <%= form.file_field :document_extrait_bancaire,
                      class: "form-control",
                      accept: ".pdf,.jpg,.jpeg,.png",
                      required: true %>
                  <small class="form-text text-muted">PDF ou image</small>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Offre/devis détaillé <span class="text-danger">*</span></label>
                  <%= form.file_field :document_offre_devis,
                      class: "form-control",
                      accept: ".pdf,.doc,.docx",
                      required: true %>
                  <small class="form-text text-muted">Ventilé poste par poste</small>
                </div>

                <div class="col-md-6">
                  <label class="form-label">CV du consultant <span class="text-danger">*</span></label>
                  <%= form.file_field :document_cv_consultant,
                      class: "form-control",
                      accept: ".pdf,.doc,.docx",
                      required: true %>
                  <small class="form-text text-muted">Mentionnant des missions similaires</small>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Procuration (si nécessaire)</label>
                  <%= form.file_field :document_procuration,
                      class: "form-control",
                      accept: ".pdf,.doc,.docx" %>
                  <small class="form-text text-muted">Si quelqu'un d'autre signe</small>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Autres documents</label>
                  <%= form.file_field :document_autres,
                      class: "form-control",
                      accept: ".pdf,.doc,.docx,.jpg,.jpeg,.png",
                      multiple: true %>
                  <small class="form-text text-muted">Documents complémentaires</small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PARTIE IV : DÉCLARATION SUR L'HONNEUR -->
        <div class="section-form mb-5">
          <h5 class="section-title">
            <span class="badge bg-primary me-2">IV</span>
            Déclaration sur l'honneur et signature
          </h5>

          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">

              <div class="alert alert-secondary mb-4">
                <h6 class="alert-heading mb-3">Déclaration sur l'honneur</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :autorisation_enquetes,
                      class: "form-check-input",
                      required: true %>
                  <label class="form-check-label small">
                    Nous autorisons le Ministre de la Région de Bruxelles-Capitale compétent à faire procéder à toutes enquêtes et expertises nécessaires à l'examen de la présente demande.
                  </label>
                </div>

                <div class="form-check mb-2">
                  <%= form.check_box :certification_autres_aides,
                      class: "form-check-input",
                      required: true %>
                  <label class="form-check-label small">
                    Nous certifions sur l'honneur que les dépenses mentionnées dans le présent dossier n'ont pas fait et ne feront pas l'objet d'autres aides octroyées par la Région de Bruxelles-Capitale.
                  </label>
                </div>

                <div class="form-check mb-2">
                  <%= form.check_box :engagement_maintien_activite,
                      class: "form-check-input",
                      required: true %>
                  <label class="form-check-label small">
                    Nous nous engageons, sous peine de devoir rembourser les aides reçues, à maintenir une unité d'établissement et notre activité économique dans les limites du territoire de la Région de Bruxelles-Capitale et ce, dans les délais prescrits par l'article 36 de l'Ordonnance du 3 mai 2018.
                  </label>
                </div>

                <div class="form-check mb-2">
                  <%= form.check_box :engagement_notification,
                      class: "form-check-input",
                      required: true %>
                  <label class="form-check-label small">
                    En cas d'octroi de l'aide sollicitée, nous nous engageons à avertir immédiatement le Service Public de la Région de Bruxelles-Capitale si nous sommes amenés, pour une cause quelconque, à céder ou à cesser nos activités ou à quitter la Région.
                  </label>
                </div>

                <div class="form-check">
                  <%= form.check_box :certification_sincerite,
                      class: "form-check-input",
                      required: true %>
                  <label class="form-check-label small">
                    Nous certifions que tous les renseignements contenus dans la présente demande sont sincères, complets et véritables.
                  </label>
                </div>
              </div>

              <!-- Informations signature -->
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Fait à <span class="text-danger">*</span></label>
                  <%= form.text_field :lieu_signature,
                      class: "form-control",
                      placeholder: "Bruxelles",
                      required: true %>
                </div>

                <div class="col-md-6">
                  <label class="form-label">Date <span class="text-danger">*</span></label>
                  <%= form.date_field :date_signature,
                      class: "form-control",
                      value: Date.current,
                      required: true %>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Nom du signataire <span class="text-danger">*</span></label>
                  <%= form.text_field :nom_signataire,
                      class: "form-control",
                      placeholder: "Nom de la personne qui signe",
                      required: true %>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Qualité <span class="text-danger">*</span></label>
                  <%= form.text_field :qualite_signataire,
                      class: "form-control",
                      placeholder: "Administratrice",
                      required: true %>
                </div>

                <div class="col-md-4">
                  <label class="form-label">Signature numérique</label>
                  <%= form.file_field :signature_numerique,
                      class: "form-control",
                      accept: ".pdf,.jpg,.jpeg,.png" %>
                  <small class="form-text text-muted">Optionnel - Image de la signature</small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Newsletter -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body">
            <h6 class="text-primary mb-3">
              <i class="bi bi-envelope me-1"></i>
              Rester informé
            </h6>
            <div class="form-check mb-3">
              <%= form.check_box :accepte_newsletter, class: "form-check-input" %>
              <label class="form-check-label">
                J'accepte de recevoir de la part de Bruxelles Economie et Emploi des informations via sa newsletter dans le cadre de ses compétences et conformément à sa politique de confidentialité
              </label>
            </div>
            <div class="row g-3" data-bruxelles-enterprise-form-target="newsletterEmails" style="display: none;">
              <div class="col-md-6">
                <label class="form-label">E-mail 1</label>
                <%= form.email_field :email_newsletter_1,
                    class: "form-control",
                    placeholder: "contact@entreprise.be" %>
              </div>
              <div class="col-md-6">
                <label class="form-label">E-mail 2</label>
                <%= form.email_field :email_newsletter_2,
                    class: "form-control",
                    placeholder: "direction@entreprise.be" %>
              </div>
            </div>
          </div>
        </div>

    </div>
  </div>
</div>

<!-- Styles CSS spécifiques -->
<style>
.section-title {
  border-bottom: 2px solid #e9ecef;
  padding-bottom: 0.5rem;
  margin-bottom: 1.5rem;
}

.formulaire-consultance-bruxelles .card {
  transition: all 0.2s ease;
}

.formulaire-consultance-bruxelles .card:hover {
  transform: translateY(-1px);
}

.form-check-input:checked {
  background-color: #0d6efd;
  border-color: #0d6efd;
}

.alert {
  border-left: 4px solid;
}

.alert-info {
  border-left-color: #0dcaf0;
}

.alert-warning {
  border-left-color: #ffc107;
}

.alert-secondary {
  border-left-color: #6c757d;
}

@media (max-width: 768px) {
  .row.g-3 > .col-md-2 {
    flex: 0 0 100%;
    max-width: 100%;
  }
}
</style>
