<!-- Formulaire de demande d'aide pour la conformité aux normes - Bruxelles Entreprises -->
<div class="formulaire-conformite-normes-bruxelles" data-controller="bruxelles-enterprise-form">

  <!-- En-tête informatif -->
  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-primary bg-opacity-10">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h4 class="card-title mb-1">
            <i class="fas fa-certificate text-primary me-2"></i>
            Demande d'aide pour la mise en conformité aux normes
          </h4>
          <p class="text-muted small mb-0">Prime pour investissements de mise en conformité du mode de fabrication</p>
        </div>
        <div class="col-md-4 text-end">
          <div class="badge bg-secondary">Code Subvention : 661</div>
        </div>
      </div>
    </div>

    <div class="card-body p-4">
      <!-- Informations importantes -->
      <div class="alert alert-info mb-4">
        <div class="row">
          <div class="col-md-6">
            <h6 class="alert-heading">
              <i class="fas fa-info-circle me-1"></i>
              Conditions importantes
            </h6>
            <ul class="small mb-0">
              <li>Montant minimum : <strong>5.000€ HTVA</strong></li>
              <li>Aide : <strong>40%</strong> des investissements</li>
              <li>Maximum : <strong>40.000€/an</strong></li>
              <li>Fréquence : <strong>1 aide par UE tous les 4 ans</strong></li>
              <li>Rapport d'expert <strong>obligatoire</strong></li>
            </ul>
          </div>
          <div class="col-md-6">
            <h6 class="alert-heading">
              <i class="fas fa-phone me-1"></i>
              Support
            </h6>
            <p class="small mb-1">
              <strong>Informations :</strong> primespme@sprb.brussels
            </p>
            <p class="small mb-0">
              <strong>Technique :</strong> monbee@sprb.brussels
            </p>
          </div>
        </div>
      </div>

      <!-- Champs cachés -->
      <%= form.hidden_field :type_aide, value: "conformite_normes" %>
      <%= form.hidden_field :region, value: "bruxelles" %>
      <%= form.hidden_field :categorie_entreprise, value: "entreprise" %>

      <!-- PARTIE 1 : L'ENTREPRISE -->
      <div class="section-form mb-5">
        <h5 class="section-title">
          <span class="badge bg-primary me-2">1</span>
          L'entreprise pour laquelle la prime est demandée
        </h5>

        <!-- 1.1 Renseignements généraux -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-building text-primary me-2"></i>
              1.1 - Renseignements généraux
            </h6>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <!-- Type d'entreprise -->
              <div class="col-md-6">
                <label class="form-label fw-bold">
                  Type d'entreprise <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :type_entreprise, "personne_physique",
                      class: "form-check-input",
                      data: { action: "change->bruxelles-enterprise-form#updateTypeEntreprise" } %>
                  <label class="form-check-label" for="request_type_entreprise_personne_physique">
                    Personne physique
                  </label>

                  <%= form.radio_button :type_entreprise, "personne_morale",
                      class: "form-check-input ms-3",
                      data: { action: "change->bruxelles-enterprise-form#updateTypeEntreprise" } %>
                  <label class="form-check-label" for="request_type_entreprise_personne_morale">
                    Personne morale (société)
                  </label>
                </div>
              </div>

              <!-- Nom/raison sociale -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_nom_entreprise">
                  Nom ou raison sociale / Nom et prénom <span class="text-danger">*</span>
                </label>
                <%= form.text_field :nom_entreprise,
                    class: "form-control",
                    placeholder: "Nom de l'entreprise",
                    required: true %>
              </div>

              <!-- Forme juridique -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_forme_juridique">
                  Forme juridique
                </label>
                <%= form.select :forme_juridique,
                    options_for_select([
                      ['SRL', 'srl'],
                      ['SA', 'sa'],
                      ['SPRL', 'sprl'],
                      ['ASBL', 'asbl'],
                      ['Entreprise individuelle', 'entreprise_individuelle']
                    ]),
                    { prompt: "Sélectionner la forme juridique" },
                    { class: "form-select" } %>
              </div>

              <!-- Dénomination commerciale -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_denomination_commerciale">
                  Dénomination commerciale éventuelle
                </label>
                <%= form.text_field :denomination_commerciale,
                    class: "form-control",
                    placeholder: "Nom commercial" %>
              </div>

              <!-- Numéro d'entreprise -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_numero_entreprise">
                  Numéro d'entreprise <span class="text-danger">*</span>
                </label>
                <%= form.text_field :numero_entreprise,
                    class: "form-control",
                    placeholder: "BE 0XXX.XXX.XXX",
                    pattern: "BE\\s?[0-9]{4}\\.[0-9]{3}\\.[0-9]{3}",
                    required: true %>
              </div>

              <!-- Date de constitution -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_date_constitution">
                  Date de constitution
                </label>
                <%= form.date_field :date_constitution,
                    class: "form-control" %>
              </div>

              <!-- Date d'inscription BCE -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_date_inscription_bce">
                  Date d'inscription à la BCE
                </label>
                <%= form.date_field :date_inscription_bce,
                    class: "form-control" %>
              </div>

              <!-- Email -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_email_entreprise">
                  E-mail <span class="text-danger">*</span>
                </label>
                <%= form.email_field :email_entreprise,
                    class: "form-control",
                    placeholder: "email@entreprise.be",
                    required: true %>
              </div>

              <!-- Site internet -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_site_internet">
                  Site internet
                </label>
                <%= form.url_field :site_internet,
                    class: "form-control",
                    placeholder: "https://www.entreprise.be" %>
              </div>

              <!-- Coordonnées bancaires -->
              <div class="col-12">
                <h6 class="fw-bold mb-3">
                  <i class="fas fa-university text-primary me-2"></i>
                  Coordonnées bancaires
                </h6>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">
                      Voulez-vous introduire un compte bancaire étranger ? <span class="text-danger">*</span>
                    </label>
                    <div class="d-flex gap-3">
                      <%= form.radio_button :compte_etranger, "oui",
                          class: "form-check-input" %>
                      <label class="form-check-label" for="request_compte_etranger_oui">
                        Oui
                      </label>

                      <%= form.radio_button :compte_etranger, "non",
                          class: "form-check-input ms-3",
                          checked: true %>
                      <label class="form-check-label" for="request_compte_etranger_non">
                        Non
                      </label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold" for="request_iban">
                      IBAN <span class="text-danger">*</span>
                    </label>
                    <%= form.text_field :iban,
                        class: "form-control",
                        placeholder: "BE XX XXXX XXXX XXXX",
                        required: true %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 1.2 Siège social et siège(s) d'exploitation -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-map-marker-alt text-primary me-2"></i>
              1.2 - Siège social et siège(s) d'exploitation
            </h6>
          </div>
          <div class="card-body">
            <!-- Siège social -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-home text-secondary me-2"></i>
              Siège social
            </h6>
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_siege_rue">
                  Rue <span class="text-danger">*</span>
                </label>
                <%= form.text_field :siege_rue,
                    class: "form-control",
                    placeholder: "Nom de la rue",
                    required: true %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_siege_numero">
                  N° <span class="text-danger">*</span>
                </label>
                <%= form.text_field :siege_numero,
                    class: "form-control",
                    placeholder: "N°",
                    required: true %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_siege_boite">
                  Boîte
                </label>
                <%= form.text_field :siege_boite,
                    class: "form-control",
                    placeholder: "Boîte" %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_siege_code_postal">
                  Code postal <span class="text-danger">*</span>
                </label>
                <%= form.text_field :siege_code_postal,
                    class: "form-control",
                    placeholder: "1000",
                    pattern: "[0-9]{4}",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_siege_commune">
                  Commune <span class="text-danger">*</span>
                </label>
                <%= form.text_field :siege_commune,
                    class: "form-control",
                    placeholder: "Bruxelles",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_siege_pays">
                  Pays
                </label>
                <%= form.text_field :siege_pays,
                    class: "form-control",
                    value: "Belgique",
                    readonly: true %>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_siege_telephone">
                  Téléphone <span class="text-danger">*</span>
                </label>
                <%= form.tel_field :siege_telephone,
                    class: "form-control",
                    placeholder: "02/XXX.XX.XX",
                    required: true %>
              </div>
            </div>

            <!-- Unité d'établissement -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-building text-secondary me-2"></i>
              Unité d'établissement pour laquelle la prime est demandée
            </h6>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_ue_rue">
                  Rue <span class="text-danger">*</span>
                </label>
                <%= form.text_field :ue_rue,
                    class: "form-control",
                    placeholder: "Nom de la rue",
                    required: true %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_ue_numero">
                  N° <span class="text-danger">*</span>
                </label>
                <%= form.text_field :ue_numero,
                    class: "form-control",
                    placeholder: "N°",
                    required: true %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_ue_boite">
                  Boîte
                </label>
                <%= form.text_field :ue_boite,
                    class: "form-control",
                    placeholder: "Boîte" %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_ue_code_postal">
                  Code postal <span class="text-danger">*</span>
                </label>
                <%= form.text_field :ue_code_postal,
                    class: "form-control",
                    placeholder: "1000",
                    pattern: "[0-9]{4}",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_ue_commune">
                  Commune <span class="text-danger">*</span>
                </label>
                <%= form.text_field :ue_commune,
                    class: "form-control",
                    placeholder: "Bruxelles",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_ue_telephone">
                  Téléphone <span class="text-danger">*</span>
                </label>
                <%= form.tel_field :ue_telephone,
                    class: "form-control",
                    placeholder: "02/XXX.XX.XX",
                    required: true %>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_ue_numero_etablissement">
                  N° de l'unité d'établissement
                </label>
                <%= form.text_field :ue_numero_etablissement,
                    class: "form-control",
                    placeholder: "Numéro d'établissement" %>
              </div>
            </div>

            <!-- Autres unités d'établissement -->
            <div class="col-12">
              <label class="form-label fw-bold">
                Avez-vous encore d'autre(s) unité(s) d'établissement ? <span class="text-danger">*</span>
              </label>
              <div class="d-flex gap-3">
                <%= form.radio_button :autres_ue, "oui",
                    class: "form-check-input" %>
                <label class="form-check-label" for="request_autres_ue_oui">
                  Oui
                </label>

                <%= form.radio_button :autres_ue, "non",
                    class: "form-check-input ms-3" %>
                <label class="form-check-label" for="request_autres_ue_non">
                  Non
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- 1.3 Coordonnées de contact -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-address-book text-primary me-2"></i>
              1.3 - Coordonnées de contact
            </h6>
          </div>
          <div class="card-body">
            <!-- Personne de contact -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-user text-secondary me-2"></i>
              Personne de contact pour le suivi du dossier
            </h6>
            <div class="row g-3 mb-4">
              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_contact_titre">
                  Titre <span class="text-danger">*</span>
                </label>
                <%= form.select :contact_titre,
                    options_for_select([
                      ['Madame', 'madame'],
                      ['Monsieur', 'monsieur']
                    ]),
                    { prompt: "Sélectionner" },
                    { class: "form-select", required: true } %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_contact_nom">
                  Nom <span class="text-danger">*</span>
                </label>
                <%= form.text_field :contact_nom,
                    class: "form-control",
                    placeholder: "Nom",
                    required: true %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_contact_prenom">
                  Prénom <span class="text-danger">*</span>
                </label>
                <%= form.text_field :contact_prenom,
                    class: "form-control",
                    placeholder: "Prénom",
                    required: true %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_contact_fonction">
                  Fonction <span class="text-danger">*</span>
                </label>
                <%= form.text_field :contact_fonction,
                    class: "form-control",
                    placeholder: "Ex: Gérant",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_contact_gsm">
                  GSM <span class="text-danger">*</span>
                </label>
                <%= form.tel_field :contact_gsm,
                    class: "form-control",
                    placeholder: "04XX/XX.XX.XX",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_contact_ligne_directe">
                  Ligne directe
                </label>
                <%= form.tel_field :contact_ligne_directe,
                    class: "form-control",
                    placeholder: "02/XXX.XX.XX" %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_contact_email">
                  E-mail <span class="text-danger">*</span>
                </label>
                <%= form.email_field :contact_email,
                    class: "form-control",
                    placeholder: "contact@entreprise.be",
                    required: true %>
              </div>
            </div>

            <!-- Personne légalement autorisée -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-user-tie text-secondary me-2"></i>
              Personne légalement autorisée à engager l'entreprise
            </h6>
            <div class="row g-3">
              <div class="col-12 mb-3">
                <label class="form-label fw-bold">
                  Identique à la personne de contact ? <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :representant_identique, "oui",
                      class: "form-check-input",
                      data: { action: "change->bruxelles-enterprise-form#toggleRepresentant" } %>
                  <label class="form-check-label" for="request_representant_identique_oui">
                    Oui
                  </label>

                  <%= form.radio_button :representant_identique, "non",
                      class: "form-check-input ms-3",
                      data: { action: "change->bruxelles-enterprise-form#toggleRepresentant" } %>
                  <label class="form-check-label" for="request_representant_identique_non">
                    Non
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 1.4 Activités de l'entreprise -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-briefcase text-primary me-2"></i>
              1.4 - Activités de l'entreprise pour laquelle la prime est demandée
            </h6>
          </div>
          <div class="card-body">
            <!-- Type d'activité / Code NACE -->
            <div class="row g-3 mb-4">
              <div class="col-12">
                <label class="form-label fw-bold" for="request_activite_nace">
                  Type d'activité / Code NACE TVA <span class="text-danger">*</span>
                </label>
                <%= form.text_field :activite_nace,
                    class: "form-control",
                    placeholder: "Ex: 82990 - Autres activités de soutien aux entreprises n.c.a.",
                    required: true %>
              </div>

              <div class="col-12">
                <button type="button" class="btn btn-outline-primary btn-sm"
                        data-action="click->bruxelles-enterprise-form#ajouterActivite">
                  <i class="fas fa-plus me-1"></i>
                  Ajouter une ligne
                </button>
              </div>
            </div>

            <!-- Description des activités -->
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold" for="request_description_activites">
                  Description des activités <span class="text-danger">*</span>
                </label>
                <%= form.text_area :description_activites,
                    class: "form-control",
                    rows: 5,
                    placeholder: "Décrivez les activités principales de votre entreprise...",
                    required: true %>
              </div>
            </div>
          </div>
        </div>

        <!-- 1.5 Composition du capital et données comptables -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-chart-line text-primary me-2"></i>
              1.5 - Composition du capital et données comptables
            </h6>
          </div>
          <div class="card-body">
            <!-- Section similaire au formulaire de recrutement mais adaptée pour 3 exercices comptables -->
            <div class="alert alert-info mb-3">
              <small>
                <i class="fas fa-info-circle me-1"></i>
                Veuillez préciser les données pour les <strong>trois derniers exercices comptables clôturés</strong>. Introduisez les montants avec décimales, chiffre après chiffre sans point ni devise.
              </small>
            </div>
          </div>
        </div>
      </div>

      <!-- PARTIE 2 : LE PROGRAMME D'INVESTISSEMENT -->
      <div class="section-form mb-5">
        <h5 class="section-title">
          <span class="badge bg-success me-2">2</span>
          Le programme d'investissement
        </h5>

        <!-- 2.1 Description de l'investissement -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-tools text-primary me-2"></i>
              2.1 - Description de l'investissement
            </h6>
          </div>
          <div class="card-body">
            <!-- Les investissements admissibles -->
            <div class="alert alert-info mb-4">
              <h6 class="alert-heading">
                <i class="fas fa-check-circle me-2"></i>
                Les investissements admissibles
              </h6>
              <div class="small">
                <p class="mb-2">Seuls sont admissibles les investissements corporels ayant un lien de nécessité avec les activités du bénéficiaire, réalisés en vue d'une exploitation effective par le bénéficiaire dans la Région et effectués en conformité avec la législation et les règlements en vigueur notamment en matière d'urbanisme, d'aménagement du territoire et d'environnement.</p>

                <p class="mb-2"><strong>Les investissements admissibles sont :</strong></p>
                <ul class="mb-2">
                  <li>Les dépenses liées à des actifs consistant en des <strong>machines</strong>, des <strong>équipements</strong> et des <strong>aménagements portant sur un bien immobilier</strong>, à l'exclusion de l'acquisition ou de la construction d'un tel bien</li>
                  <li>Ils sont repris en immobilisations corporelles pour les personnes morales ou au tableau des amortissements pour les personnes physiques</li>
                </ul>

                <p class="mb-2"><strong>Conditions particulières :</strong></p>
                <ul class="mb-2">
                  <li>Pour les investissements corporels qui font l'objet d'un <strong>crédit-bail</strong>, les frais de transport, d'installation et de montage sont admis pour autant qu'ils soient repris en immobilisations corporelles</li>
                  <li>Les <strong>investissements d'occasion</strong> en mobilier ou en matériel sont admis pour autant qu'ils soient acquis auprès d'un professionnel dont l'activité porte sur la vente, la récupération, la valorisation, le réemploi ou le recyclage de tels biens et revêtus d'une garantie de minimum six mois</li>
                  <li>En cas d'<strong>usage mixte</strong> d'un bien immobilier, seuls les investissements pour la partie professionnelle utilisée par le bénéficiaire sont admis</li>
                </ul>
              </div>
            </div>

            <!-- Calendrier de l'investissement -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-calendar text-secondary me-2"></i>
              Calendrier de votre investissement
            </h6>
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_date_debut_prevue">
                  Date présumée de début <span class="text-danger">*</span>
                </label>
                <%= form.date_field :date_debut_prevue,
                    class: "form-control",
                    required: true %>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_date_fin_prevue">
                  Date présumée de fin <span class="text-danger">*</span>
                </label>
                <%= form.date_field :date_fin_prevue,
                    class: "form-control",
                    required: true %>
              </div>
            </div>

            <!-- Description de l'aide -->
            <div class="alert alert-success mb-4">
              <h6 class="alert-heading">
                <i class="fas fa-euro-sign me-2"></i>
                Description de l'aide
              </h6>
              <p class="mb-2">Une aide est octroyée aux micro, petites et moyennes entreprises qui réalisent un investissement en vue d'adapter le mode de fabrication de leurs produits à une norme environnementale, de qualité, de sécurité ou d'hygiène.</p>

              <p class="mb-0 small"><strong>Les normes visées sont :</strong> les normes découlant de réglementations fédérales ou régionales en matière d'environnement, de qualité, de sécurité et d'hygiène, en l'absence de normes européennes, ou de la transposition de directives européennes et de l'application directe de règlements européens en matière d'environnement, de qualité, de sécurité et d'hygiène dans le droit national.</p>
            </div>

            <!-- Description de votre investissement -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-edit text-secondary me-2"></i>
              Description de votre investissement
            </h6>
            <div class="alert alert-warning mb-4">
              <p class="mb-0 small">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Important :</strong> La mise aux normes qui intervient dans le cadre de la création d'une nouvelle unité d'établissement ou d'un changement d'unité d'établissement est exclue du bénéfice de l'aide pour une période de deux ans.
              </p>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-bold">
                  Procédez-vous à la création d'une nouvelle unité d'établissement ? <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :creation_nouvelle_ue, "oui",
                      class: "form-check-input" %>
                  <label class="form-check-label" for="request_creation_nouvelle_ue_oui">
                    Oui
                  </label>

                  <%= form.radio_button :creation_nouvelle_ue, "non",
                      class: "form-check-input ms-3" %>
                  <label class="form-check-label" for="request_creation_nouvelle_ue_non">
                    Non
                  </label>
                </div>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">
                  Procédez-vous au déménagement d'une unité d'établissement ? <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :demenagement_ue, "oui",
                      class: "form-check-input" %>
                  <label class="form-check-label" for="request_demenagement_ue_oui">
                    Oui
                  </label>

                  <%= form.radio_button :demenagement_ue, "non",
                      class: "form-check-input ms-3" %>
                  <label class="form-check-label" for="request_demenagement_ue_non">
                    Non
                  </label>
                </div>
              </div>

              <div class="col-12">
                <label class="form-label fw-bold" for="request_produits_concernes">
                  Quels produits de votre fabrication sont en particulier concernés par la présente demande ? <span class="text-danger">*</span>
                </label>
                <%= form.text_area :produits_concernes,
                    class: "form-control",
                    rows: 3,
                    placeholder: "Décrivez les produits concernés par la mise aux normes...",
                    required: true %>
              </div>

              <div class="col-12">
                <label class="form-label fw-bold">
                  De quelle nature sont les normes auxquelles vous souhaitez vous conformer ? <span class="text-danger">*</span>
                </label>
                <div class="row g-2 mt-2">
                  <div class="col-md-3">
                    <div class="form-check">
                      <%= form.check_box :normes_environnementales,
                          class: "form-check-input" %>
                      <label class="form-check-label" for="request_normes_environnementales">
                        Environnementales
                      </label>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-check">
                      <%= form.check_box :normes_qualite,
                          class: "form-check-input" %>
                      <label class="form-check-label" for="request_normes_qualite">
                        Qualité
                      </label>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-check">
                      <%= form.check_box :normes_securite,
                          class: "form-check-input" %>
                      <label class="form-check-label" for="request_normes_securite">
                        Sécurité
                      </label>
                    </div>
                  </div>
                  <div class="col-md-3">
                    <div class="form-check">
                      <%= form.check_box :normes_hygiene,
                          class: "form-check-input" %>
                      <label class="form-check-label" for="request_normes_hygiene">
                        Hygiène
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <label class="form-label fw-bold" for="request_intitule_source_normes">
                  Quels sont l'intitulé et la source réglementaire des normes visées ? <span class="text-danger">*</span>
                </label>
                <%= form.text_area :intitule_source_normes,
                    class: "form-control",
                    rows: 3,
                    placeholder: "Ex: Règlement (CE) n° 1935/2004 concernant les matériaux et objets destinés à entrer en contact avec des denrées alimentaires...",
                    required: true %>
              </div>

              <div class="col-12">
                <label class="form-label fw-bold" for="request_description_investissement">
                  Décrivez votre investissement en lien avec la fabrication de ces produits <span class="text-danger">*</span>
                </label>
                <%= form.text_area :description_investissement,
                    class: "form-control",
                    rows: 5,
                    placeholder: "Décrivez précisément les investissements prévus et leur lien avec la mise aux normes...",
                    required: true %>
              </div>

              <div class="col-12">
                <label class="form-label fw-bold" for="request_pourcentage_professionnel">
                  Quel est le pourcentage professionnel de votre investissement (usage exclusif du bénéficiaire) <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <%= form.number_field :pourcentage_professionnel,
                      class: "form-control",
                      min: 0,
                      max: 100,
                      placeholder: "100",
                      required: true %>
                  <span class="input-group-text">%</span>
                </div>
                <div class="form-text">
                  <i class="fas fa-info-circle me-1"></i>
                  Indiquez le pourcentage d'utilisation professionnelle de l'investissement
                </div>
              </div>
            </div>

            <!-- Le rapport d'expertise -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-file-alt text-secondary me-2"></i>
              Le rapport d'expertise
            </h6>
            <div class="alert alert-warning mb-4">
              <p class="mb-0 small">
                <strong>Important :</strong> Les investissements rendus nécessaires en vue de la mise en conformité aux normes du mode de fabrication des produits doivent être identifiés dans un rapport émanant d'un expert. Le bénéficiaire doit avoir obtenu ce rapport préalablement à l'introduction de sa demande d'aide.
              </p>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_date_visite_expert">
                  Date de visite du lieu d'investissement <span class="text-danger">*</span>
                </label>
                <%= form.date_field :date_visite_expert,
                    class: "form-control",
                    required: true %>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_date_rapport_expert">
                  Date du rapport <span class="text-danger">*</span>
                </label>
                <%= form.date_field :date_rapport_expert,
                    class: "form-control",
                    required: true %>
              </div>
            </div>

            <!-- L'expert -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-user-graduate text-secondary me-2"></i>
              L'expert
            </h6>
            <div class="alert alert-info mb-3">
              <p class="mb-0 small">
                L'expert est une personne physique. Il est indépendant de l'entreprise, spécialisé dans le domaine de compétence concerné et a une expérience pertinente de deux ans au moins au cours des cinq années qui précèdent la demande d'autorisation préalable. Il fait preuve d'une compétence suffisamment notoire, étayée par une liste de références et est intègre dans l'exercice de sa fonction d'expert.
              </p>
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_expert_nom">
                  Nom de l'expert <span class="text-danger">*</span>
                </label>
                <%= form.text_field :expert_nom,
                    class: "form-control",
                    placeholder: "Nom de l'expert",
                    required: true %>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_expert_prenom">
                  Prénom de l'expert <span class="text-danger">*</span>
                </label>
                <%= form.text_field :expert_prenom,
                    class: "form-control",
                    placeholder: "Prénom de l'expert",
                    required: true %>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_expert_email">
                  Adresse e-mail <span class="text-danger">*</span>
                </label>
                <%= form.email_field :expert_email,
                    class: "form-control",
                    placeholder: "expert@domaine.com",
                    required: true %>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_expert_telephone">
                  N° de téléphone <span class="text-danger">*</span>
                </label>
                <%= form.tel_field :expert_telephone,
                    class: "form-control",
                    placeholder: "02/XXX.XX.XX ou 04XX/XX.XX.XX",
                    required: true %>
              </div>
            </div>
          </div>
        </div>

        <!-- 2.2 Montant de l'investissement -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-calculator text-primary me-2"></i>
              2.2 - Montant de l'investissement
            </h6>
          </div>
          <div class="card-body">
            <div class="alert alert-info mb-4">
              <p class="small mb-2">Introduisez les montants - avec décimales - chiffre après chiffre sans points ni devise</p>
              <div class="row">
                <div class="col-md-6">
                  <ul class="small mb-0">
                    <li>L'investissement porte sur un montant <strong>minimum de 5.000 € HTVA</strong></li>
                    <li>L'aide consiste en un montant de <strong>40 % des investissements admis</strong></li>
                  </ul>
                </div>
                <div class="col-md-6">
                  <ul class="small mb-0">
                    <li>Son montant total est de <strong>maximum 40.000 € par bénéficiaire et par année civile</strong></li>
                    <li>Le bénéficiaire ne peut recevoir qu'<strong>une seule aide de ce type pour chaque unité d'établissement tous les quatre ans au maximum</strong></li>
                  </ul>
                </div>
              </div>
            </div>

            <h6 class="fw-bold mb-3">
              <i class="fas fa-shopping-cart text-secondary me-2"></i>
              Acquisition d'actifs
            </h6>

            <div class="table-responsive">
              <table class="table table-bordered">
                <thead class="table-light">
                  <tr>
                    <th>Type d'investissement</th>
                    <th>Montant € HTVA</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>
                      <label class="form-label fw-bold mb-0">
                        <i class="fas fa-cogs me-2"></i>
                        Machines
                      </label>
                    </td>
                    <td>
                      <%= form.number_field :montant_machines,
                          class: "form-control",
                          step: 0.01,
                          placeholder: "0,00" %>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <label class="form-label fw-bold mb-0">
                        <i class="fas fa-tools me-2"></i>
                        Équipements
                      </label>
                    </td>
                    <td>
                      <%= form.number_field :montant_equipements,
                          class: "form-control",
                          step: 0.01,
                          placeholder: "0,00" %>
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <label class="form-label fw-bold mb-0">
                        <i class="fas fa-hammer me-2"></i>
                        Aménagements portant sur un bien immobilier<br>
                        <small class="text-muted">(hors acquisition ou construction)</small>
                      </label>
                    </td>
                    <td>
                      <%= form.number_field :montant_amenagements,
                          class: "form-control",
                          step: 0.01,
                          placeholder: "0,00" %>
                    </td>
                  </tr>
                  <tr class="table-warning">
                    <td>
                      <strong>
                        <i class="fas fa-calculator me-2"></i>
                        Total
                      </strong>
                    </td>
                    <td>
                      <%= form.number_field :montant_total,
                          class: "form-control fw-bold",
                          step: 0.01,
                          placeholder: "0,00",
                          readonly: true,
                          data: {
                            bruxelles_enterprise_form_target: "totalInvestissement",
                            action: "input->bruxelles-enterprise-form#calculerTotal"
                          } %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="alert alert-warning mt-3">
              <h6 class="alert-heading">
                <i class="fas fa-paperclip me-2"></i>
                Documents requis
              </h6>
              <p class="mb-0 small">
                Veuillez joindre les <strong>devis ou offres détaillés</strong> relatifs à ces investissements.
              </p>
            </div>

            <!-- Résumé de l'aide calculée -->
            <div class="card border-success mt-4">
              <div class="card-header bg-success bg-opacity-10">
                <h6 class="card-title text-success mb-0">
                  <i class="fas fa-euro-sign me-2"></i>
                  Estimation de l'aide
                </h6>
              </div>
              <div class="card-body">
                <div class="row text-center">
                  <div class="col-md-4">
                    <div class="border-end">
                      <h6 class="text-muted small">Total investissement</h6>
                      <p class="h5 mb-0" data-bruxelles-enterprise-form-target="displayTotal">0,00 €</p>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="border-end">
                      <h6 class="text-muted small">Taux d'aide (40%)</h6>
                      <p class="h5 mb-0" data-bruxelles-enterprise-form-target="tauxAide">40%</p>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <h6 class="text-success small">Aide estimée</h6>
                    <p class="h4 mb-0 text-success" data-bruxelles-enterprise-form-target="aideEstimee">0,00 €</p>
                    <small class="text-muted">Maximum 40.000 €</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PARTIE 3 : DOSSIER DOCUMENTS -->
      <div class="col-12">
      <div class="card border-primary mb-5">
        <div class="card-header bg-primary text-white">
          <h5 class="card-title mb-0">
            <i class="fas fa-folder-open me-2"></i>
            Partie 3 : Dossier de pièces justificatives
          </h5>
        </div>
        <div class="card-body">
          <!-- Checklist des documents requis -->
          <div class="alert alert-warning mb-4">
            <h6 class="alert-heading">
              <i class="fas fa-file-upload me-2"></i>
              Pièces justificatives à fournir
            </h6>
            <div class="row">
              <div class="col-md-6">
                <ul class="list-unstyled mb-0">
                  <li>
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <strong>Formulaire de demande</strong> complété et signé
                  </li>
                  <li>
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <strong>Statuts coordonnés</strong> de l'entreprise
                  </li>
                  <li>
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <strong>Bilans des trois derniers exercices</strong> approuvés
                  </li>
                  <li>
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <strong>Attestations de paiement</strong> des cotisations sociales
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <ul class="list-unstyled mb-0">
                  <li>
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <strong>Devis détaillés</strong> ou offres pour les investissements
                  </li>
                  <li>
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <strong>Rapport d'expert</strong> attestant de la conformité
                  </li>
                  <li>
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <strong>Démonstration du respect</strong> de la norme applicable
                  </li>
                  <li>
                    <i class="fas fa-check-circle text-success me-2"></i>
                    <strong>Description détaillée</strong> du processus de fabrication
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <h6 class="fw-bold mb-3">
            <i class="fas fa-upload text-secondary me-2"></i>
            Téléchargement des documents
          </h6>

          <!-- Section d'upload groupée -->
          <div class="row g-4">
            <div class="col-md-6">
              <div class="card h-100 border-light">
                <div class="card-header bg-light">
                  <h6 class="card-title mb-0">
                    <i class="fas fa-building text-primary me-2"></i>
                    Documents administratifs
                  </h6>
                </div>
                <div class="card-body">
                  <div class="mb-3">
                    <label class="form-label fw-bold" for="request_statuts_entreprise">
                      <i class="fas fa-file-alt me-1"></i>
                      Statuts coordonnés de l'entreprise <span class="text-danger">*</span>
                    </label>
                    <%= form.file_field :statuts_entreprise,
                        class: "form-control",
                        accept: ".pdf,.doc,.docx",
                        data: {
                          bruxelles_enterprise_form_target: "statutsFile",
                          action: "change->bruxelles-enterprise-form#validateFile"
                        } %>
                    <div class="form-text">
                      <i class="fas fa-info-circle me-1"></i>
                      Formats acceptés : PDF, DOC, DOCX (max 10 MB)
                    </div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label fw-bold" for="request_bilans_exercices">
                      <i class="fas fa-chart-line me-1"></i>
                      Bilans des trois derniers exercices <span class="text-danger">*</span>
                    </label>
                    <%= form.file_field :bilans_exercices,
                        class: "form-control",
                        accept: ".pdf,.doc,.docx",
                        multiple: true,
                        data: {
                          bruxelles_enterprise_form_target: "bilansFiles",
                          action: "change->bruxelles-enterprise-form#validateFile"
                        } %>
                    <div class="form-text">
                      <i class="fas fa-info-circle me-1"></i>
                      Téléchargez les 3 bilans en sélectionnant plusieurs fichiers
                    </div>
                  </div>

                  <div class="mb-0">
                    <label class="form-label fw-bold" for="request_attestations_sociales">
                      <i class="fas fa-shield-alt me-1"></i>
                      Attestations de paiement des cotisations sociales <span class="text-danger">*</span>
                    </label>
                    <%= form.file_field :attestations_sociales,
                        class: "form-control",
                        accept: ".pdf,.doc,.docx",
                        data: {
                          bruxelles_enterprise_form_target: "attestationsFile",
                          action: "change->bruxelles-enterprise-form#validateFile"
                        } %>
                    <div class="form-text">
                      <i class="fas fa-info-circle me-1"></i>
                      Attestation récente de l'ONSS ou caisse d'assurances sociales
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card h-100 border-light">
                <div class="card-header bg-light">
                  <h6 class="card-title mb-0">
                    <i class="fas fa-cogs text-success me-2"></i>
                    Documents techniques
                  </h6>
                </div>
                <div class="card-body">
                  <div class="mb-3">
                    <label class="form-label fw-bold" for="request_devis_investissements">
                      <i class="fas fa-receipt me-1"></i>
                      Devis détaillés des investissements <span class="text-danger">*</span>
                    </label>
                    <%= form.file_field :devis_investissements,
                        class: "form-control",
                        accept: ".pdf,.doc,.docx",
                        multiple: true,
                        data: {
                          bruxelles_enterprise_form_target: "devisFiles",
                          action: "change->bruxelles-enterprise-form#validateFile"
                        } %>
                    <div class="form-text">
                      <i class="fas fa-info-circle me-1"></i>
                      Tous les devis détaillés pour machines, équipements et aménagements
                    </div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label fw-bold" for="request_rapport_expert">
                      <i class="fas fa-user-tie me-1"></i>
                      Rapport d'expert <span class="text-danger">*</span>
                    </label>
                    <%= form.file_field :rapport_expert,
                        class: "form-control",
                        accept: ".pdf,.doc,.docx",
                        data: {
                          bruxelles_enterprise_form_target: "rapportFile",
                          action: "change->bruxelles-enterprise-form#validateFile"
                        } %>
                    <div class="form-text">
                      <i class="fas fa-info-circle me-1"></i>
                      Attestation de conformité par l'expert agréé
                    </div>
                  </div>

                  <div class="mb-0">
                    <label class="form-label fw-bold" for="request_demonstration_norme">
                      <i class="fas fa-certificate me-1"></i>
                      Démonstration du respect de la norme <span class="text-danger">*</span>
                    </label>
                    <%= form.file_field :demonstration_norme,
                        class: "form-control",
                        accept: ".pdf,.doc,.docx",
                        data: {
                          bruxelles_enterprise_form_target: "normeFile",
                          action: "change->bruxelles-enterprise-form#validateFile"
                        } %>
                    <div class="form-text">
                      <i class="fas fa-info-circle me-1"></i>
                      Documentation prouvant le respect de la norme applicable
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Résumé des uploads -->
          <div class="card border-info mt-4" data-bruxelles-enterprise-form-target="uploadSummary" style="display: none;">
            <div class="card-header bg-info bg-opacity-10">
              <h6 class="card-title text-info mb-0">
                <i class="fas fa-list-check me-2"></i>
                Résumé des documents téléchargés
              </h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <ul class="list-unstyled mb-0" data-bruxelles-enterprise-form-target="uploadedList">
                    <!-- Les fichiers uploadés apparaîtront ici -->
                  </ul>
                </div>
                <div class="col-md-6">
                  <div class="alert alert-success mb-0" data-bruxelles-enterprise-form-target="uploadComplete" style="display: none;">
                    <i class="fas fa-check-circle me-2"></i>
                    <strong>Tous les documents requis ont été téléchargés !</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      </div>

      <!-- PARTIE 4 : COMMUNICATION ET SUIVI -->
      <div class="col-12">
      <div class="card border-warning mb-5">
        <div class="card-header bg-warning text-dark">
          <h5 class="card-title mb-0">
            <i class="fas fa-comments me-2"></i>
            Partie 4 : Communication et suivi
          </h5>
        </div>
        <div class="card-body">
          <!-- Préférences de communication -->
          <h6 class="fw-bold mb-3">
            <i class="fas fa-envelope text-secondary me-2"></i>
            Préférences de communication
          </h6>

          <div class="alert alert-info mb-4">
            <h6 class="alert-heading">
              <i class="fas fa-info-circle me-2"></i>
              Information importante
            </h6>
            <p class="mb-0">Toute la communication officielle concernant votre demande se fera via l'adresse email de contact renseignée. Assurez-vous que cette adresse est correcte et régulièrement consultée.</p>
          </div>

          <div class="row g-4">
            <div class="col-md-6">
              <div class="card border-light h-100">
                <div class="card-header bg-light">
                  <h6 class="card-title mb-0">
                    <i class="fas fa-bell text-primary me-2"></i>
                    Notifications par email
                  </h6>
                </div>
                <div class="card-body">
                  <div class="form-check mb-3">
                    <%= form.check_box :notification_accuse_reception,
                        class: "form-check-input",
                        checked: true,
                        data: {
                          bruxelles_enterprise_form_target: "notificationCheck"
                        } %>
                    <label class="form-check-label fw-bold" for="request_notification_accuse_reception">
                      <i class="fas fa-check-circle text-success me-2"></i>
                      Accusé de réception de la demande
                    </label>
                    <div class="form-text">
                      Confirmation que votre dossier a été reçu
                    </div>
                  </div>

                  <div class="form-check mb-3">
                    <%= form.check_box :notification_demande_complements,
                        class: "form-check-input",
                        checked: true %>
                    <label class="form-check-label fw-bold" for="request_notification_demande_complements">
                      <i class="fas fa-plus-circle text-warning me-2"></i>
                      Demandes de compléments
                    </label>
                    <div class="form-text">
                      Si des documents ou informations supplémentaires sont nécessaires
                    </div>
                  </div>

                  <div class="form-check mb-3">
                    <%= form.check_box :notification_decision_finale,
                        class: "form-check-input",
                        checked: true %>
                    <label class="form-check-label fw-bold" for="request_notification_decision_finale">
                      <i class="fas fa-gavel text-info me-2"></i>
                      Décision finale
                    </label>
                    <div class="form-text">
                      Notification d'acceptation ou de refus de la demande
                    </div>
                  </div>

                  <div class="form-check">
                    <%= form.check_box :notification_rappels_echeances,
                        class: "form-check-input",
                        checked: true %>
                    <label class="form-check-label fw-bold" for="request_notification_rappels_echeances">
                      <i class="fas fa-clock text-danger me-2"></i>
                      Rappels d'échéances
                    </label>
                    <div class="form-text">
                      Pour les justificatifs à fournir après réalisation
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="card border-light h-100">
                <div class="card-header bg-light">
                  <h6 class="card-title mb-0">
                    <i class="fas fa-calendar-alt text-success me-2"></i>
                    Suivi de dossier
                  </h6>
                </div>
                <div class="card-body">
                  <div class="mb-3">
                    <label class="form-label fw-bold" for="request_mode_suivi_prefere">
                      <i class="fas fa-user-cog me-1"></i>
                      Mode de suivi préféré <span class="text-danger">*</span>
                    </label>
                    <%= form.select :mode_suivi_prefere,
                        options_for_select([
                          ['Email uniquement', 'email'],
                          ['Email + téléphone si nécessaire', 'email_telephone'],
                          ['Téléphone de préférence', 'telephone']
                        ]),
                        { prompt: "Sélectionner un mode de suivi" },
                        { class: "form-select", required: true } %>
                  </div>

                  <div class="mb-3">
                    <label class="form-label fw-bold" for="request_disponibilite_contact">
                      <i class="fas fa-clock me-1"></i>
                      Disponibilité pour contact téléphonique
                    </label>
                    <%= form.text_area :disponibilite_contact,
                        class: "form-control",
                        rows: 3,
                        placeholder: "Ex: Lundi au vendredi, 9h-17h. Éviter les mardis après-midi." %>
                    <div class="form-text">
                      <i class="fas fa-info-circle me-1"></i>
                      Précisez vos créneaux de disponibilité (optionnel)
                    </div>
                  </div>

                  <div class="alert alert-success">
                    <h6 class="alert-heading">
                      <i class="fas fa-headset me-2"></i>
                      Contact service d'aide
                    </h6>
                    <p class="small mb-1">
                      <strong>Téléphone :</strong> 02/204.21.11
                    </p>
                    <p class="small mb-0">
                      <strong>Email :</strong> eco@sprb.brussels
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Commentaires additionnels -->
          <div class="mt-4">
            <h6 class="fw-bold mb-3">
              <i class="fas fa-comment-dots text-secondary me-2"></i>
              Commentaires ou informations complémentaires
            </h6>
            <div class="mb-3">
              <label class="form-label" for="request_commentaires_supplementaires">
                <i class="fas fa-pencil-alt me-1"></i>
                Informations que vous jugez utiles pour le traitement de votre dossier
              </label>
              <%= form.text_area :commentaires_supplementaires,
                  class: "form-control",
                  rows: 4,
                  placeholder: "Précisions sur votre projet, contraintes particulières, délais souhaités..." %>
              <div class="form-text">
                <i class="fas fa-info-circle me-1"></i>
                Cette section est optionnelle mais peut faciliter le traitement de votre demande
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PARTIE 5 : DÉCLARATIONS ET SIGNATURE -->
    <div class="col-12">
      <div class="card border-danger mb-5">
        <div class="card-header bg-danger text-white">
          <h5 class="card-title mb-0">
            <i class="fas fa-signature me-2"></i>
            Partie 5 : Déclarations et signature
          </h5>
        </div>
        <div class="card-body">
          <!-- 5.1 Déclarations de subsides de minimis -->
          <div class="card mb-4">
            <div class="card-header bg-light">
              <h6 class="card-title mb-0">
                <i class="fas fa-euro-sign text-primary me-2"></i>
                5.1 – Déclarations de subsides de minimis
              </h6>
            </div>
            <div class="card-body">
              <div class="alert alert-info mb-4">
                <h6 class="alert-heading">
                  <i class="fas fa-info-circle me-2"></i>
                  Information importante
                </h6>
                <p class="mb-2">En cas de décision d'octroi, veuillez noter que la prime sollicitée est accordée par référence au <strong>Règlement (UE) 2023/2831 de la Commission du 13 décembre 2023</strong> concernant l'application des articles 107 et 108 du traité sur le fonctionnement de l'Union européenne relatifs aux aides de minimis.</p>
                <p class="mb-0"><strong>Important :</strong> La somme totale des aides de minimis octroyées à une entreprise ainsi qu'à ses entreprises partenaires et liées ne peut excéder <strong>300.000 € au cours des trois dernières années civiles</strong>.</p>
              </div>

              <div class="alert alert-warning mb-4">
                <h6 class="alert-heading">
                  <i class="fas fa-exclamation-triangle me-2"></i>
                  Attention
                </h6>
                <p class="mb-0">Veuillez cocher et compléter <strong>une seule</strong> des propositions ci-dessous :</p>
              </div>

              <div class="row g-4">
                <div class="col-12">
                  <!-- Option 1 : Aucune aide de minimis -->
                  <div class="card border-success">
                    <div class="card-body">
                      <div class="form-check">
                        <%= form.radio_button :declaration_minimis_type, 'aucune',
                            class: "form-check-input",
                            data: {
                              bruxelles_enterprise_form_target: "minimisRadio",
                              action: "change->bruxelles-enterprise-form#toggleMinimisSection"
                            } %>
                        <label class="form-check-label fw-bold" for="request_declaration_minimis_type_aucune">
                          <i class="fas fa-check-circle text-success me-2"></i>
                          Aucune aide de minimis reçue
                        </label>
                        <div class="form-text mt-2">
                          L'entreprise concernée par cette demande de prime et ses éventuelles entreprises liées et partenaires <strong>ne se sont vues octroyer aucune aide de minimis au cours des trois dernières années</strong>.
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <!-- Option 2 : Aides de minimis reçues -->
                  <div class="card border-warning">
                    <div class="card-body">
                      <div class="form-check mb-3">
                        <%= form.radio_button :declaration_minimis_type, 'recues',
                            class: "form-check-input",
                            data: {
                              bruxelles_enterprise_form_target: "minimisRadio",
                              action: "change->bruxelles-enterprise-form#toggleMinimisSection"
                            } %>
                        <label class="form-check-label fw-bold" for="request_declaration_minimis_type_recues">
                          <i class="fas fa-list text-warning me-2"></i>
                          Aides de minimis reçues à déclarer
                        </label>
                        <div class="form-text mt-2">
                          L'entreprise concernée par cette demande de prime et ses éventuelles entreprises liées et partenaires <strong>se sont vues octroyer les aides de minimis suivantes au cours des trois dernières années</strong> :
                        </div>
                      </div>

                      <!-- Section détaillée des aides (masquée par défaut) -->
                      <div class="border-top pt-3" data-bruxelles-enterprise-form-target="minimisDetails" style="display: none;">
                        <h6 class="fw-bold mb-3">
                          <i class="fas fa-table text-secondary me-2"></i>
                          Détail des aides de minimis reçues
                        </h6>

                        <div class="table-responsive">
                          <table class="table table-bordered">
                            <thead class="table-light">
                              <tr>
                                <th>Date d'octroi</th>
                                <th>Organisme accordant l'aide</th>
                                <th>Type d'aide</th>
                                <th>Montant (€)</th>
                                <th>Action</th>
                              </tr>
                            </thead>
                            <tbody data-bruxelles-enterprise-form-target="minimisTableBody">
                              <!-- Les lignes d'aides seront ajoutées dynamiquement -->
                            </tbody>
                          </table>
                        </div>

                        <div class="d-flex gap-2 mb-3">
                          <button type="button"
                                  class="btn btn-outline-primary btn-sm"
                                  data-action="click->bruxelles-enterprise-form#addMinimisRow">
                            <i class="fas fa-plus me-1"></i>
                            Ajouter une aide
                          </button>
                        </div>

                        <div class="alert alert-success">
                          <div class="row">
                            <div class="col-md-6">
                              <strong>Total des aides déclarées :</strong>
                              <span class="h5 text-success" data-bruxelles-enterprise-form-target="minimisTotal">0,00 €</span>
                            </div>
                            <div class="col-md-6">
                              <strong>Reste disponible :</strong>
                              <span class="h5" data-bruxelles-enterprise-form-target="minimisRestant">300.000,00 €</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 5.2 Déclarations sur l'honneur -->
          <div class="card mb-4">
            <div class="card-header bg-light">
              <h6 class="card-title mb-0">
                <i class="fas fa-shield-alt text-primary me-2"></i>
                5.2 – Déclarations sur l'honneur
              </h6>
            </div>
            <div class="card-body">
              <div class="alert alert-warning mb-4">
                <h6 class="alert-heading">
                  <i class="fas fa-exclamation-triangle me-2"></i>
                  Déclarations obligatoires
                </h6>
                <p class="mb-0">Les déclarations suivantes sont <strong>obligatoires</strong> pour la validation de votre demande. En cochant ces cases, vous vous engagez juridiquement.</p>
              </div>

              <div class="row g-4">
                <!-- Autorisation d'enquête -->
                <div class="col-12">
                  <div class="form-check mb-3">
                    <%= form.check_box :declaration_autorisation_enquete,
                        class: "form-check-input",
                        required: true,
                        data: {
                          bruxelles_enterprise_form_target: "declarationCheck",
                          action: "change->bruxelles-enterprise-form#validateDeclarations"
                        } %>
                    <label class="form-check-label fw-bold" for="request_declaration_autorisation_enquete">
                      <i class="fas fa-search text-info me-2"></i>
                      Autorisation d'enquête <span class="text-danger">*</span>
                    </label>
                    <div class="form-text">
                      Nous autorisons le ministre de la Région de Bruxelles-Capitale compétent à faire procéder à toutes enquêtes et expertises nécessaires à l'examen de la présente demande.
                    </div>
                  </div>
                </div>

                <!-- Certification non-cumul -->
                <div class="col-12">
                  <div class="form-check mb-3">
                    <%= form.check_box :declaration_non_cumul_aides,
                        class: "form-check-input",
                        required: true,
                        data: {
                          bruxelles_enterprise_form_target: "declarationCheck",
                          action: "change->bruxelles-enterprise-form#validateDeclarations"
                        } %>
                    <label class="form-check-label fw-bold" for="request_declaration_non_cumul_aides">
                      <i class="fas fa-ban text-warning me-2"></i>
                      Certification de non-cumul des aides <span class="text-danger">*</span>
                    </label>
                    <div class="form-text">
                      Nous certifions sur l'honneur que les dépenses mentionnées dans le présent dossier n'ont pas fait et ne feront pas l'objet d'autres aides octroyées par la Région de Bruxelles-Capitale.
                    </div>
                  </div>
                </div>

                <!-- Engagement d'avertissement -->
                <div class="col-12">
                  <div class="form-check mb-3">
                    <%= form.check_box :declaration_engagement_avertissement,
                        class: "form-check-input",
                        required: true,
                        data: {
                          bruxelles_enterprise_form_target: "declarationCheck",
                          action: "change->bruxelles-enterprise-form#validateDeclarations"
                        } %>
                    <label class="form-check-label fw-bold" for="request_declaration_engagement_avertissement">
                      <i class="fas fa-bell text-danger me-2"></i>
                      Engagement d'avertissement <span class="text-danger">*</span>
                    </label>
                    <div class="form-text">
                      En cas d'octroi de l'aide sollicitée, nous nous engageons à avertir immédiatement le Service public régional de Bruxelles si nous sommes amenés, pour une cause quelconque, à céder ou à cesser nos activités ou à quitter la Région.
                    </div>
                  </div>
                </div>

                <!-- Engagement quinquennal -->
                <div class="col-12">
                  <div class="card border-primary">
                    <div class="card-header bg-primary bg-opacity-10">
                      <h6 class="card-title text-primary mb-0">
                        <i class="fas fa-calendar-check me-2"></i>
                        Engagement quinquennal
                      </h6>
                    </div>
                    <div class="card-body">
                      <div class="form-check mb-3">
                        <%= form.check_box :declaration_engagement_quinquennal,
                            class: "form-check-input",
                            required: true,
                            data: {
                              bruxelles_enterprise_form_target: "declarationCheck",
                              action: "change->bruxelles-enterprise-form#validateDeclarations"
                            } %>
                        <label class="form-check-label fw-bold" for="request_declaration_engagement_quinquennal">
                          <i class="fas fa-handshake text-success me-2"></i>
                          Engagement sur 5 ans <span class="text-danger">*</span>
                        </label>
                        <div class="form-text mb-3">
                          Sous peine de devoir rembourser les aides reçues et conformément à l'article 8, § 1er, de l'ordonnance du 13 octobre 2023 relative aux aides pour le développement et la transition économique des entreprises, nous nous engageons pour une <strong>période de cinq ans à compter de la date de fin de la réalisation des investissements</strong> ayant donné lieu à l'aide, à :
                        </div>
                      </div>

                      <div class="row g-3">
                        <div class="col-md-6">
                          <ul class="list-unstyled">
                            <li class="mb-2">
                              <i class="fas fa-map-marker-alt text-primary me-2"></i>
                              <strong>Maintenir</strong> une unité d'établissement et l'investissement sur le territoire de la Région
                            </li>
                            <li class="mb-2">
                              <i class="fas fa-lock text-success me-2"></i>
                              <strong>Conserver</strong> l'affectation des actifs faisant l'objet de l'aide
                            </li>
                          </ul>
                        </div>
                        <div class="col-md-6">
                          <ul class="list-unstyled">
                            <li class="mb-2">
                              <i class="fas fa-cogs text-info me-2"></i>
                              <strong>Utiliser</strong> les actifs aux fins prévues
                            </li>
                            <li class="mb-2">
                              <i class="fas fa-check-circle text-warning me-2"></i>
                              <strong>Respecter</strong> les conditions d'octroi prévues par l'ordonnance et ses arrêtés d'exécution
                            </li>
                          </ul>
                        </div>
                      </div>

                      <div class="alert alert-info mt-3 mb-0">
                        <p class="small mb-0">
                          <i class="fas fa-info-circle me-2"></i>
                          <strong>Exception :</strong> Pour l'aide ou la partie d'aide portant sur un investissement réalisé à travers un crédit-bail de moins de cinq ans, cette période est de <strong>quatre ans</strong>.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Certification finale -->
                <div class="col-12">
                  <div class="card border-success">
                    <div class="card-header bg-success bg-opacity-10">
                      <h6 class="card-title text-success mb-0">
                        <i class="fas fa-certificate me-2"></i>
                        Lu et approuvé
                      </h6>
                    </div>
                    <div class="card-body">
                      <div class="form-check mb-3">
                        <%= form.check_box :declaration_certification_finale,
                            class: "form-check-input",
                            required: true,
                            data: {
                              bruxelles_enterprise_form_target: "declarationCheck",
                              action: "change->bruxelles-enterprise-form#validateDeclarations"
                            } %>
                        <label class="form-check-label fw-bold" for="request_declaration_certification_finale">
                          <i class="fas fa-stamp text-success me-2"></i>
                          Certification de véracité <span class="text-danger">*</span>
                        </label>
                        <div class="form-text">
                          Nous certifions que tous les renseignements contenus dans la présente demande sont <strong>sincères, complets et véritables</strong>.
                        </div>
                      </div>

                      <div class="row g-3 mt-3">
                        <div class="col-md-6">
                          <label class="form-label fw-bold" for="request_nom_signataire_final">
                            <i class="fas fa-user me-1"></i>
                            Nom et prénom du signataire <span class="text-danger">*</span>
                          </label>
                          <%= form.text_field :nom_signataire_final,
                              class: "form-control",
                              placeholder: "Nom Prénom",
                              required: true %>
                        </div>

                        <div class="col-md-6">
                          <label class="form-label fw-bold" for="request_qualite_signataire_final">
                            <i class="fas fa-id-badge me-1"></i>
                            Qualité du signataire <span class="text-danger">*</span>
                          </label>
                          <%= form.select :qualite_signataire_final,
                              options_for_select([
                                ['Gérant', 'gerant'],
                                ['Administrateur délégué', 'admin_delegue'],
                                ['Directeur général', 'directeur_general'],
                                ['Président', 'president'],
                                ['Autre', 'autre']
                              ]),
                              { prompt: "Sélectionner la qualité" },
                              { class: "form-select", required: true } %>
                        </div>

                        <div class="col-md-6">
                          <label class="form-label fw-bold" for="request_lieu_signature_final">
                            <i class="fas fa-map-marker-alt me-1"></i>
                            Lieu <span class="text-danger">*</span>
                          </label>
                          <%= form.text_field :lieu_signature_final,
                              class: "form-control",
                              placeholder: "Bruxelles",
                              required: true %>
                        </div>

                        <div class="col-md-6">
                          <label class="form-label fw-bold" for="request_date_signature_finale">
                            <i class="fas fa-calendar me-1"></i>
                            Date <span class="text-danger">*</span>
                          </label>
                          <%= form.date_field :date_signature_finale,
                              class: "form-control",
                              value: Date.current,
                              required: true %>
                        </div>

                        <div class="col-12">
                          <div class="form-check">
                            <%= form.check_box :lu_et_approuve,
                                class: "form-check-input",
                                required: true,
                                data: {
                                  bruxelles_enterprise_form_target: "signatureFinale",
                                  action: "change->bruxelles-enterprise-form#validateFinalSignature"
                                } %>
                            <label class="form-check-label fw-bold" for="request_lu_et_approuve">
                              <i class="fas fa-signature text-success me-2"></i>
                              Lu et approuvé <span class="text-danger">*</span>
                            </label>
                            <div class="form-text">
                              En cochant cette case, je confirme avoir lu et approuvé l'ensemble du formulaire et certifie l'exactitude des informations fournies.
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Validation finale -->
          <div class="alert alert-success mt-4" data-bruxelles-enterprise-form-target="validationSummary" style="display: none;">
            <div class="d-flex align-items-center">
              <i class="fas fa-check-circle text-success me-3" style="font-size: 2rem;"></i>
              <div>
                <h6 class="alert-heading mb-1">Formulaire complété !</h6>
                <p class="mb-0">Toutes les sections obligatoires ont été renseignées. Vous pouvez maintenant soumettre votre demande d'aide aux investissements de conformité aux normes.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
