                  <!-- Date de début -->
                  <div class="col-md-6">
                    <label class="form-label">Date présumée de début <span class="text-danger">*</span></label>
                    <%= form.date_field :date_debut_investissement,
                        class: "form-control",
                        required: true %>
                    <div class="invalid-feedback">Date de début requise.</div>
                  </div>

                  <!-- Date de fin -->
                  <div class="col-md-6">
                    <label class="form-label">Date présumée de fin <span class="text-danger">*</span></label>
                    <%= form.date_field :date_fin_investissement,
                        class: "form-control",
                        required: true %>
                    <div class="invalid-feedback">Date de fin requise.</div>
                  </div>
                </div>
              </div>

              <!-- Description de l'investissement -->
              <div class="col-12">
                <label class="form-label">Description de l'investissement <span class="text-danger">*</span></label>
                <%= form.text_area :description_investissement,
                    class: "form-control",
                    rows: 5,
                    placeholder: "Décrivez précisément votre projet d'investissement, les objectifs visés, les équipements prévus...",
                    required: true %>
                <div class="invalid-feedback">Description de l'investissement requise.</div>
              </div>
            </div>
          </div>
        </div>

