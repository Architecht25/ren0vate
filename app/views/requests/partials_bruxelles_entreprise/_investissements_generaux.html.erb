          </div>
          <div class="form-check">
            <%= radio_button_tag 'connaissance_prime', 'site_web', false, class: 'form-check-input' %>
            <%= label_tag 'connaissance_prime_site_web', 'Site web', class: 'form-check-label' %>
          </div>
          <div class="form-check">
            <%= radio_button_tag 'connaissance_prime', 'bouche_oreille', false, class: 'form-check-input' %>
