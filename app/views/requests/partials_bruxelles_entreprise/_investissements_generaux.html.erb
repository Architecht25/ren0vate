          <div class="row">
            <div class="col-md-6">
              <div class="form-group">
                <label><strong>Nom</strong></label>
                <%= text_field_tag 'signature_nom', nil, class: 'form-control' %>
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-group">
                <label><strong>Qualité</strong></label>
                <%= text_field_tag 'signature_qualite', nil, class: 'form-control' %>
              </div>
            </div>
          </div>

          <div class="signature-area">
            <label><strong>Signature d'une personne habilitée à engager l'entreprise</strong></label>
            <div class="signature-box">
              <!-- Zone pour signature électronique ou scan -->
              <p class="text-muted">Zone de signature</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer avec informations de contact -->
