<!-- Formulaire de demande d'autorisation préalable pour une prime aux investissements généraux - Bruxelles Entreprises -->
<div class="formulaire-investissements-generaux-bruxelles" data-controller="bruxelles-enterprise-form">

  <!-- En-tête informatif -->
  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-primary bg-opacity-10">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h4 class="card-title mb-1">
            <i class="bi bi-building text-primary me-2"></i>
            Demande d'autorisation préalable pour une prime aux investissements généraux
          </h4>
          <p class="text-muted small mb-0">Formulaire de demande pour les investissements généraux d'entreprise</p>
        </div>
        <div class="col-md-4 text-end">
          <div class="badge bg-secondary">Code Subvention : 661</div>
        </div>
      </div>
    </div>

    <div class="card-body p-4">
      <!-- Informations importantes -->
      <div class="alert alert-info mb-4">
        <div class="row">
          <div class="col-md-6">
            <h6 class="alert-heading">
              <i class="bi bi-info-circle me-1"></i>
              Informations importantes
            </h6>
            <ul class="small mb-0">
              <li><strong>Autorisation préalable obligatoire</strong></li>
              <li>Délai de notification : <strong>1 mois</strong></li>
              <li>Aucune signature de devis avant autorisation</li>
              <li>Retombées positives requises pour la Région</li>
              <li>Dans la limite des crédits budgétaires</li>
            </ul>
          </div>
          <div class="col-md-6">
            <h6 class="alert-heading">
              <i class="bi bi-telephone me-1"></i>
              Support
            </h6>
            <p class="small mb-1">
              <strong>Informations :</strong> primespme@sprb.brussels
            </p>
            <p class="small mb-0">
              <strong>Technique :</strong> monbee@sprb.brussels<br>
              <strong>HELPDESK technique</strong>
            </p>
          </div>
        </div>
      </div>

      <!-- Avertissement important -->
      <div class="alert alert-warning mb-4">
        <h6 class="alert-heading">
          <i class="bi bi-exclamation-triangle me-1"></i>
          ATTENTION
        </h6>
        <p class="small mb-0">
          <strong>Toute demande d'autorisation préalable introduite après le début de la mise en œuvre du programme d'investissement sera irrecevable.</strong>
          L'entreprise ne peut donc avoir signé de devis ou de bons de commande ou avoir reçu une ou plusieurs factures avant que BEE ne lui ait envoyé une notification d'autorisation préalable.
          Un compromis de vente peut néanmoins déjà avoir été signé.
        </p>
      </div>

      <div class="alert alert-success mb-4">
        <p class="small mb-0">
          <i class="bi bi-save me-1"></i>
          Le formulaire est sauvegardé automatiquement. Vous pouvez le quitter à n'importe quelle étape et à tout moment sachant qu'il vous est possible d'y revenir pour le compléter ou le modifier.
        </p>
      </div>

        <!-- Champs cachés pour les investissements généraux -->
        <%= form.hidden_field :type_aide, value: "investissements_generaux" %>
        <%= form.hidden_field :region, value: "bruxelles" %>
        <%= form.hidden_field :categorie_entreprise, value: "entreprise" %>

        <!-- Section de sélection du type de prime -->
        <div class="section-form mb-5">
          <h5 class="section-title">
            <span class="badge bg-warning me-2">0</span>
            Sélection du type de prime
          </h5>

          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">Choisissez la prime que vous demandez</h6>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-12">
                  <label class="form-label">Type de prime <span class="text-danger">*</span></label>
                  <div class="d-flex flex-column gap-2">
                    <%= form.radio_button :type_prime, "terrains_batiments",
                        class: "form-check-input",
                        data: { action: "change->bruxelles-enterprise-form#updateTypePrime" } %>
                    <label class="form-check-label" for="request_type_prime_terrains_batiments">
                      <strong>1. Prime pour l'acquisition de terrains et de bâtiments</strong>
                    </label>

                    <%= form.radio_button :type_prime, "investissements_non_immobiliers",
                        class: "form-check-input",
                        data: { action: "change->bruxelles-enterprise-form#updateTypePrime" } %>
                    <label class="form-check-label" for="request_type_prime_investissements_non_immobiliers">
                      <strong>2. Prime pour des investissements non-immobiliers</strong>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PARTIE I : L'ENTREPRISE POUR LAQUELLE LA PRIME EST DEMANDÉE -->
        <div class="section-form mb-5">
          <h5 class="section-title">
            <span class="badge bg-primary me-2">I</span>
            L'entreprise pour laquelle la prime est demandée
          </h5>

          <!-- 1.1 Renseignements généraux -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">1.1 - Renseignements généraux</h6>
            </div>
            <div class="card-body">

              <div class="row g-3">
                <!-- Type d'entreprise -->
                <div class="col-md-6">
                  <label class="form-label">Type d'entreprise <span class="text-danger">*</span></label>
                  <div class="d-flex gap-3">
                    <%= form.radio_button :type_entreprise, "personne_physique",
                        class: "form-check-input",
                        data: { action: "change->bruxelles-enterprise-form#updateTypeEntreprise" } %>
                    <label class="form-check-label" for="request_type_entreprise_personne_physique">
                      Personne physique
                    </label>

                    <%= form.radio_button :type_entreprise, "personne_morale",
                        class: "form-check-input ms-3",
                        data: { action: "change->bruxelles-enterprise-form#updateTypeEntreprise" } %>
                    <label class="form-check-label" for="request_type_entreprise_personne_morale">
                      Personne morale (société)
                    </label>
                  </div>
                </div>

                <!-- Nom/raison sociale -->
                <div class="col-md-6">
                  <label class="form-label">Nom ou raison sociale / Nom et prénom <span class="text-danger">*</span></label>
                  <%= form.text_field :nom_entreprise,
                      class: "form-control",
                      placeholder: "Nom de l'entreprise ou nom et prénom",
                      required: true %>
                  <div class="invalid-feedback">Veuillez saisir le nom de l'entreprise.</div>
                </div>

                <!-- Forme juridique -->
                <div class="col-md-6" data-bruxelles-enterprise-form-target="formeJuridique" style="display: none;">
                  <label class="form-label">Forme juridique</label>
                  <%= form.select :forme_juridique,
                      options_for_select([
                        ['SRL - Société à Responsabilité Limitée', 'srl'],
                        ['SA - Société Anonyme', 'sa'],
                        ['SPRL - Société Privée à Responsabilité Limitée', 'sprl'],
                        ['SC - Société Coopérative', 'sc'],
                        ['Autre', 'autre']
                      ]),
                      { prompt: 'Sélectionnez...' },
                      { class: "form-select" } %>
                </div>

                <!-- Dénomination commerciale -->
                <div class="col-md-6">
                  <label class="form-label">Dénomination commerciale éventuelle</label>
                  <%= form.text_field :denomination_commerciale,
                      class: "form-control",
                      placeholder: "Si différente du nom" %>
                </div>

                <!-- Numéro d'entreprise -->
                <div class="col-md-6">
                  <label class="form-label">Numéro d'entreprise <span class="text-danger">*</span></label>
                  <%= form.text_field :numero_entreprise,
                      class: "form-control",
                      placeholder: "BE 0XXX.XXX.XXX",
                      pattern: "BE\\s?[0-9]{4}\\.[0-9]{3}\\.[0-9]{3}",
                      required: true,
                      data: {
                        action: "input->bruxelles-enterprise-form#validateNumeroEntreprise"
                      } %>
                  <div class="invalid-feedback">Format requis : BE 0XXX.XXX.XXX</div>
                </div>

                <!-- Date de constitution -->
                <div class="col-md-3">
                  <label class="form-label">Date de constitution</label>
                  <%= form.date_field :date_constitution,
                      class: "form-control" %>
                </div>

                <!-- Date d'inscription BCE -->
                <div class="col-md-3">
                  <label class="form-label">Date d'inscription à la BCE</label>
                  <%= form.date_field :date_inscription_bce,
                      class: "form-control" %>
                </div>

                <!-- Activité principale -->
                <div class="col-md-6">
                  <label class="form-label">Activité principale <span class="text-danger">*</span></label>
                  <%= form.text_field :activite_principale,
                      class: "form-control",
                      placeholder: "Décrivez votre activité principale",
                      required: true %>
                  <div class="invalid-feedback">Veuillez décrire votre activité principale.</div>
                </div>

                <!-- E-mail -->
                <div class="col-md-6">
                  <label class="form-label">E-mail <span class="text-danger">*</span></label>
                  <%= form.email_field :email,
                      class: "form-control",
                      placeholder: "contact@entreprise.com",
                      required: true %>
                  <div class="invalid-feedback">Veuillez saisir une adresse email valide.</div>
                </div>

                <!-- Site internet -->
                <div class="col-md-6">
                  <label class="form-label">Site internet</label>
                  <%= form.url_field :site_internet,
                      class: "form-control",
                      placeholder: "https://www.entreprise.com" %>
                </div>

                <!-- IBAN -->
                <div class="col-md-6">
                  <label class="form-label">IBAN <span class="text-danger">*</span></label>
                  <%= form.text_field :iban,
                      class: "form-control",
                      placeholder: "BE00 0000 0000 0000",
                      pattern: "BE[0-9]{2}\\s?[0-9]{4}\\s?[0-9]{4}\\s?[0-9]{4}",
                      required: true %>
                  <div class="invalid-feedback">Format requis : BE00 0000 0000 0000</div>
                </div>
              </div>
            </div>
          </div>

          <!-- 1.2 Siège social et siège(s) d'exploitation -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0">1.2 - Siège social et siège(s) d'exploitation</h6>
            </div>
            <div class="card-body">

              <!-- Siège social -->
              <div class="mb-4">
                <h6 class="text-primary mb-3">Siège social</h6>
                <div class="row g-3">
                  <!-- Rue -->
                  <div class="col-md-4">
                    <label class="form-label">Rue <span class="text-danger">*</span></label>
                    <%= form.text_field :siege_social_rue,
                        class: "form-control",
                        placeholder: "Rue...",
                        required: true %>
                    <div class="invalid-feedback">Veuillez saisir la rue.</div>
                  </div>

                  <!-- Numéro -->
                  <div class="col-md-2">
                    <label class="form-label">N° <span class="text-danger">*</span></label>
                    <%= form.text_field :siege_social_numero,
                        class: "form-control",
                        placeholder: "N°",
                        required: true %>
                    <div class="invalid-feedback">Numéro requis.</div>
                  </div>

                  <!-- Boîte -->
                  <div class="col-md-2">
                    <label class="form-label">Boîte</label>
                    <%= form.text_field :siege_social_boite,
                        class: "form-control",
                        placeholder: "Boîte" %>
                  </div>

                  <!-- Code postal -->
                  <div class="col-md-2">
                    <label class="form-label">Code postal <span class="text-danger">*</span></label>
                    <%= form.text_field :siege_social_code_postal,
                        class: "form-control",
                        placeholder: "0000",
                        pattern: "[0-9]{4}",
                        required: true %>
                    <div class="invalid-feedback">Code postal requis.</div>
                  </div>

                  <!-- Commune -->
                  <div class="col-md-3">
                    <label class="form-label">Commune <span class="text-danger">*</span></label>
                    <%= form.text_field :siege_social_commune,
                        class: "form-control",
                        placeholder: "Commune",
                        required: true %>
                    <div class="invalid-feedback">Commune requise.</div>
                  </div>

                  <!-- Pays -->
                  <div class="col-md-3">
                    <label class="form-label">Pays</label>
                    <%= form.text_field :siege_social_pays,
                        class: "form-control",
                        value: "Belgique" %>
                  </div>

                  <!-- Téléphone -->
                  <div class="col-md-4">
                    <label class="form-label">Téléphone <span class="text-danger">*</span></label>
                    <%= form.telephone_field :siege_social_telephone,
                        class: "form-control",
                        placeholder: "+32 2 000 00 00",
                        required: true %>
                    <div class="invalid-feedback">Numéro de téléphone requis.</div>
                  </div>
                </div>
              </div>

              <!-- Unité d'établissement -->
              <div class="mb-4">
                <h6 class="text-primary mb-3">Unité d'établissement pour laquelle la prime est demandée</h6>
                <div class="row g-3">
                  <!-- Rue -->
                  <div class="col-md-4">
                    <label class="form-label">Rue <span class="text-danger">*</span></label>
                    <%= form.text_field :unite_etablissement_rue,
                        class: "form-control",
                        placeholder: "Rue...",
                        required: true %>
                    <div class="invalid-feedback">Veuillez saisir la rue.</div>
                  </div>

                  <!-- Numéro -->
                  <div class="col-md-2">
                    <label class="form-label">N° <span class="text-danger">*</span></label>
                    <%= form.text_field :unite_etablissement_numero,
                        class: "form-control",
                        placeholder: "N°",
                        required: true %>
                    <div class="invalid-feedback">Numéro requis.</div>
                  </div>

                  <!-- Boîte -->
                  <div class="col-md-2">
                    <label class="form-label">Boîte</label>
                    <%= form.text_field :unite_etablissement_boite,
                        class: "form-control",
                        placeholder: "Boîte" %>
                  </div>

                  <!-- Code postal -->
                  <div class="col-md-2">
                    <label class="form-label">Code postal <span class="text-danger">*</span></label>
                    <%= form.text_field :unite_etablissement_code_postal,
                        class: "form-control",
                        placeholder: "0000",
                        pattern: "[0-9]{4}",
                        required: true %>
                    <div class="invalid-feedback">Code postal requis.</div>
                  </div>

                  <!-- Commune -->
                  <div class="col-md-3">
                    <label class="form-label">Commune <span class="text-danger">*</span></label>
                    <%= form.text_field :unite_etablissement_commune,
                        class: "form-control",
                        placeholder: "Commune",
                        required: true %>
                    <div class="invalid-feedback">Commune requise.</div>
                  </div>

                  <!-- Téléphone -->
                  <div class="col-md-3">
                    <label class="form-label">Téléphone <span class="text-danger">*</span></label>
                    <%= form.telephone_field :unite_etablissement_telephone,
                        class: "form-control",
                        placeholder: "+32 2 000 00 00",
                        required: true %>
                    <div class="invalid-feedback">Numéro de téléphone requis.</div>
                  </div>

                  <!-- N° de l'unité d'établissement -->
                  <div class="col-md-4">
                    <label class="form-label">N° de l'unité d'établissement <span class="text-danger">*</span></label>
                    <%= form.text_field :numero_unite_etablissement,
                        class: "form-control",
                        placeholder: "Numéro d'établissement",
                        required: true %>
                    <div class="invalid-feedback">Numéro d'établissement requis.</div>
                  </div>
                </div>
              </div>

              <!-- Questions sur autres unités -->
              <div class="mb-4">
                <h6 class="text-primary mb-3">Autres unités d'établissement</h6>
                <div class="row g-3">
                  <!-- Autres unités -->
                  <div class="col-12">
                    <label class="form-label">Avez-vous encore d'autre(s) unité(s) d'établissement ?</label>
                    <div class="d-flex gap-3">
                      <%= form.radio_button :autres_unites, "oui",
                          class: "form-check-input",
                          data: { action: "change->bruxelles-enterprise-form#toggleAutresUnites" } %>
                      <label class="form-check-label" for="request_autres_unites_oui">
                        Oui
                      </label>

                      <%= form.radio_button :autres_unites, "non",
                          class: "form-check-input ms-3",
                          data: { action: "change->bruxelles-enterprise-form#toggleAutresUnites" } %>
                      <label class="form-check-label" for="request_autres_unites_non">
                        Non
                      </label>
                    </div>
                  </div>

                  <!-- Unités hors Bruxelles -->
                  <div class="col-12" data-bruxelles-enterprise-form-target="unitesHorsBruxelles" style="display: none;">
                    <label class="form-label">Si oui, parmi celles-ci, certaines sont-elles situées hors du territoire de la Région de Bruxelles-Capitale ? <span class="text-danger">*</span></label>
                    <div class="d-flex gap-3">
                      <%= form.radio_button :unites_hors_bruxelles, "oui",
                          class: "form-check-input" %>
                      <label class="form-check-label" for="request_unites_hors_bruxelles_oui">
                        Oui
                      </label>

                      <%= form.radio_button :unites_hors_bruxelles, "non",
                          class: "form-check-input ms-3" %>
                      <label class="form-check-label" for="request_unites_hors_bruxelles_non">
                        Non
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Section I.3 - Coordonnées de contact -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h4 class="card-title mb-0">
              <i class="fas fa-address-card text-primary me-2"></i>
              I.3 - Coordonnées de contact
            </h4>
          </div>
          <div class="card-body">
            <div class="row g-4">
              <!-- Personne de contact -->
              <div class="col-12">
                <h6 class="text-primary mb-3">Personne de contact pour le suivi du dossier</h6>
                <div class="row g-3">
                  <!-- Titre -->
                  <div class="col-md-2">
                    <label class="form-label">Titre <span class="text-danger">*</span></label>
                    <%= form.select :contact_titre,
                        options_for_select([
                          ['', ''],
                          ['Madame', 'madame'],
                          ['Monsieur', 'monsieur']
                        ]),
                        { prompt: 'Sélectionnez...' },
                        { class: "form-select", required: true } %>
                    <div class="invalid-feedback">Titre requis.</div>
                  </div>

                  <!-- Nom -->
                  <div class="col-md-3">
                    <label class="form-label">Nom <span class="text-danger">*</span></label>
                    <%= form.text_field :contact_nom,
                        class: "form-control",
                        placeholder: "Nom de famille",
                        required: true %>
                    <div class="invalid-feedback">Nom requis.</div>
                  </div>

                  <!-- Prénom -->
                  <div class="col-md-3">
                    <label class="form-label">Prénom <span class="text-danger">*</span></label>
                    <%= form.text_field :contact_prenom,
                        class: "form-control",
                        placeholder: "Prénom",
                        required: true %>
                    <div class="invalid-feedback">Prénom requis.</div>
                  </div>

                  <!-- Fonction -->
                  <div class="col-md-4">
                    <label class="form-label">Fonction <span class="text-danger">*</span></label>
                    <%= form.text_field :contact_fonction,
                        class: "form-control",
                        placeholder: "Fonction dans l'entreprise",
                        required: true %>
                    <div class="invalid-feedback">Fonction requise.</div>
                  </div>
                </div>
              </div>

              <!-- Coordonnées -->
              <div class="col-12">
                <div class="row g-3">
                  <!-- GSM -->
                  <div class="col-md-3">
                    <label class="form-label">GSM <span class="text-danger">*</span></label>
                    <%= form.telephone_field :contact_gsm,
                        class: "form-control",
                        placeholder: "+32 4XX XX XX XX",
                        required: true %>
                    <div class="invalid-feedback">Numéro GSM requis.</div>
                  </div>

                  <!-- Ligne directe -->
                  <div class="col-md-3">
                    <label class="form-label">Ligne directe</label>
                    <%= form.telephone_field :contact_ligne_directe,
                        class: "form-control",
                        placeholder: "+32 2 XXX XX XX" %>
                  </div>

                  <!-- Email -->
                  <div class="col-md-6">
                    <label class="form-label">E-mail <span class="text-danger">*</span></label>
                    <%= form.email_field :contact_email,
                        class: "form-control",
                        placeholder: "contact@entreprise.be",
                        required: true %>
                    <div class="invalid-feedback">Adresse email requise.</div>
                  </div>
                </div>
              </div>

              <!-- Personne autorisée -->
              <div class="col-12">
                <h6 class="text-primary mb-3">Personne légalement autorisée à engager l'entreprise</h6>
                <div class="mb-3">
                  <label class="form-label">Identique à la personne de contact ? <span class="text-danger">*</span></label>
                  <div class="d-flex gap-3">
                    <%= form.radio_button :personne_identique, "oui",
                        class: "form-check-input",
                        data: { action: "change->bruxelles-enterprise-form#togglePersonneAutorisee" } %>
                    <label class="form-check-label" for="request_personne_identique_oui">
                      Oui
                    </label>

                    <%= form.radio_button :personne_identique, "non",
                        class: "form-check-input ms-3",
                        data: { action: "change->bruxelles-enterprise-form#togglePersonneAutorisee" } %>
                    <label class="form-check-label" for="request_personne_identique_non">
                      Non
                    </label>
                  </div>
                </div>

                <!-- Détails personne autorisée (affiché si non identique) -->
                <div data-bruxelles-enterprise-form-target="personneAutorisee" style="display: none;">
                  <div class="row g-3">
                    <!-- Titre -->
                    <div class="col-md-2">
                      <label class="form-label">Titre <span class="text-danger">*</span></label>
                      <%= form.select :autorise_titre,
                          options_for_select([
                            ['', ''],
                            ['Madame', 'madame'],
                            ['Monsieur', 'monsieur']
                          ]),
                          { prompt: 'Sélectionnez...' },
                          { class: "form-select" } %>
                    </div>

                    <!-- Nom -->
                    <div class="col-md-3">
                      <label class="form-label">Nom <span class="text-danger">*</span></label>
                      <%= form.text_field :autorise_nom,
                          class: "form-control",
                          placeholder: "Nom de famille" %>
                    </div>

                    <!-- Prénom -->
                    <div class="col-md-3">
                      <label class="form-label">Prénom <span class="text-danger">*</span></label>
                      <%= form.text_field :autorise_prenom,
                          class: "form-control",
                          placeholder: "Prénom" %>
                    </div>

                    <!-- Fonction -->
                    <div class="col-md-4">
                      <label class="form-label">Fonction <span class="text-danger">*</span></label>
                      <%= form.text_field :autorise_fonction,
                          class: "form-control",
                          placeholder: "Fonction dans l'entreprise" %>
                    </div>
                  </div>

                  <div class="row g-3 mt-2">
                    <!-- GSM -->
                    <div class="col-md-3">
                      <label class="form-label">GSM <span class="text-danger">*</span></label>
                      <%= form.telephone_field :autorise_gsm,
                          class: "form-control",
                          placeholder: "+32 4XX XX XX XX" %>
                    </div>

                    <!-- Ligne directe -->
                    <div class="col-md-3">
                      <label class="form-label">Ligne directe</label>
                      <%= form.telephone_field :autorise_ligne_directe,
                          class: "form-control",
                          placeholder: "+32 2 XXX XX XX" %>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
