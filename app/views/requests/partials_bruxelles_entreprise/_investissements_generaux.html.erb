                          placeholder: "0.00",
                          data: { action: "input->bruxelles-enterprise-form#calculateTotal" } %>
                    </td>
                  </tr>
                  <tr>
                    <th scope="row" class="align-middle">
                      <i class="fas fa-recycle text-secondary me-2"></i>
