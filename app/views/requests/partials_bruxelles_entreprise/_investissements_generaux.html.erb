<script>
document.addEventListener('DOMContentLoaded', function() {
  // Calcul automatique du total des investissements
  function calculateTotal() {
    const montantFields = [
      'travaux_construction_montant',
      'transformations_montant',
      'machines_neufs_montant',
      'machines_occasion_montant'
    ];

    let total = 0;
    montantFields.forEach(fieldName => {
      const field = document.querySelector(`input[name="${fieldName}"]`);
      if (field && field.value) {
        total += parseFloat(field.value) || 0;
      }
    });

    const totalElement = document.getElementById('total-investissement');
    if (totalElement) {
      totalElement.textContent = total.toLocaleString('fr-FR', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }
  }

  // Ajout d'événements pour le calcul du total
  const montantFields = document.querySelectorAll('input[name$="_montant"]');
  montantFields.forEach(field => {
    field.addEventListener('input', calculateTotal);
  });

  // Affichage conditionnel des détails d'exemplarité
  function toggleExemplarite(type) {
    const radio = document.querySelector(`input[name="exemplarite_${type}"]:checked`);
    const details = document.querySelector(`input[name="exemplarite_${type}"][value="oui"]`).closest('.form-group').querySelector('.exemplarite-details');

    if (details) {
      if (radio && radio.value === 'oui') {
        details.style.display = 'block';
      } else {
        details.style.display = 'none';
      }
    }
  }

  // Événements pour l'exemplarité sociale
  document.querySelectorAll('input[name="exemplarite_sociale"]').forEach(radio => {
    radio.addEventListener('change', () => toggleExemplarite('sociale'));
  });

  // Événements pour l'exemplarité environnementale
  document.querySelectorAll('input[name="exemplarite_environnementale"]').forEach(radio => {
    radio.addEventListener('change', () => toggleExemplarite('environnementale'));
  });

  // Affichage conditionnel du champ "Autre" pour la connaissance de la prime
  document.querySelectorAll('input[name="connaissance_prime"]').forEach(radio => {
    radio.addEventListener('change', function() {
      const autreField = document.getElementById('connaissance_autre_precision');
      if (autreField) {
        if (this.value === 'autres') {
          autreField.style.display = 'block';
        } else {
          autreField.style.display = 'none';
        }
      }
    });
  });

  // Affichage conditionnel du champ description "Autres" pour le cadre
  const cadreAutresCheckbox = document.querySelector('input[name="cadre_autres"]');
  const cadreAutresDescription = document.querySelector('input[name="cadre_autres_description"]');

  if (cadreAutresCheckbox && cadreAutresDescription) {
    cadreAutresCheckbox.addEventListener('change', function() {
      if (this.checked) {
        cadreAutresDescription.style.display = 'block';
      } else {
        cadreAutresDescription.style.display = 'none';
        cadreAutresDescription.value = '';
      }
    });
  }
});

