                  <label class="form-check-label" for="request_permis_environnement_non">
                    Non
                  </label>
                </div>
              </div>

              <!-- Permis d'urbanisme -->
              <div class="col-12">
                <label class="form-label">Un permis d'urbanisme est-il nécessaire pour réaliser les investissements prévus ?</label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :permis_urbanisme, "oui",
                      class: "form-check-input" %>
                  <label class="form-check-label" for="request_permis_urbanisme_oui">
