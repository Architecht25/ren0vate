    <h2>Partie 2 – La prime demandée</h2>

    <!-- 2.1 - Description de l'investissement -->
    <div class="section-2-1">
      <h3>2.1 - Description de l'investissement</h3>

      <div class="row">
        <div class="col-md-3">
          <div class="form-group">
            <label><strong>Date présumée de début (*)</strong></label>
            <%= date_field_tag 'date_debut_investissement', nil, class: 'form-control' %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="form-group">
            <label><strong>Date présumée de fin (*)</strong></label>
            <%= date_field_tag 'date_fin_investissement', nil, class: 'form-control' %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-12">
          <div class="form-group">
            <label><strong>Investissement (description) (*)</strong></label>
            <%= text_area_tag 'description_investissement', nil, class: 'form-control', rows: 4 %>
          </div>
        </div>
      </div>
    </div>

    <!-- Permis et enregistrement nécessaires -->
    <div class="section-permis">
      <h3>Permis et enregistrement nécessaires</h3>

      <div class="form-group">
        <label><strong>Un permis d'environnement est-il nécessaire pour réaliser les investissements prévus ?</strong></label>
        <div class="radio-inline-group">
          <%= radio_button_tag 'permis_environnement', 'oui', false, class: 'form-check-input' %>
          <%= label_tag 'permis_environnement_oui', 'Oui', class: 'form-check-label' %>
          <%= radio_button_tag 'permis_environnement', 'non', false, class: 'form-check-input' %>
          <%= label_tag 'permis_environnement_non', 'Non', class: 'form-check-label' %>
        </div>
      </div>

      <div class="form-group">
        <label><strong>Un permis d'urbanisme est-il nécessaire pour réaliser les investissements prévus ?</strong></label>
        <div class="radio-inline-group">
          <%= radio_button_tag 'permis_urbanisme', 'oui', false, class: 'form-check-input' %>
          <%= label_tag 'permis_urbanisme_oui', 'Oui', class: 'form-check-label' %>
          <%= radio_button_tag 'permis_urbanisme', 'non', false, class: 'form-check-input' %>
          <%= label_tag 'permis_urbanisme_non', 'Non', class: 'form-check-label' %>
        </div>
      </div>

      <div class="form-group">
        <label><strong>L'activité exercée dans l'unité d'établissement où sont réalisés les investissements nécessite-t-elle un enregistrement en tant qu'établissement d'hébergement touristique ?</strong></label>
        <div class="radio-inline-group">
          <%= radio_button_tag 'enregistrement_touristique', 'oui', false, class: 'form-check-input' %>
          <%= label_tag 'enregistrement_touristique_oui', 'Oui', class: 'form-check-label' %>
          <%= radio_button_tag 'enregistrement_touristique', 'non', false, class: 'form-check-input' %>
          <%= label_tag 'enregistrement_touristique_non', 'Non', class: 'form-check-label' %>
        </div>
      </div>
    </div>

    <!-- 2.2 - Coût de l'investissement -->
    <div class="section-2-2">
      <h3>2.2 - Coût de l'investissement</h3>
      <p><em>Introduisez les montants - avec décimales - chiffre après chiffre sans points ni devise</em></p>

      <div class="table-responsive">
        <table class="table table-bordered investissement-table">
          <thead>
            <tr>
              <th>Investissement</th>
              <th>Date de début prévue (1° facture)</th>
              <th>Date de fin prévue (dernière facture)</th>
              <th>Montant (€)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Travaux de construction (gros-oeuvre)</strong></td>
              <td><%= date_field_tag 'travaux_construction_debut', nil, class: 'form-control' %></td>
              <td><%= date_field_tag 'travaux_construction_fin', nil, class: 'form-control' %></td>
              <td><%= number_field_tag 'travaux_construction_montant', nil, class: 'form-control', step: 0.01 %></td>
            </tr>
            <tr>
              <td><strong>Transformations (aménagements et finitions)</strong></td>
              <td><%= date_field_tag 'transformations_debut', nil, class: 'form-control' %></td>
              <td><%= date_field_tag 'transformations_fin', nil, class: 'form-control' %></td>
              <td><%= number_field_tag 'transformations_montant', nil, class: 'form-control', step: 0.01 %></td>
            </tr>
            <tr>
              <td><strong>Machines et équipements neufs</strong></td>
              <td><%= date_field_tag 'machines_neufs_debut', nil, class: 'form-control' %></td>
              <td><%= date_field_tag 'machines_neufs_fin', nil, class: 'form-control' %></td>
              <td><%= number_field_tag 'machines_neufs_montant', nil, class: 'form-control', step: 0.01 %></td>
            </tr>
            <tr>
              <td><strong>Machines et équipements d'occasion</strong></td>
              <td><%= date_field_tag 'machines_occasion_debut', nil, class: 'form-control' %></td>
              <td><%= date_field_tag 'machines_occasion_fin', nil, class: 'form-control' %></td>
              <td><%= number_field_tag 'machines_occasion_montant', nil, class: 'form-control', step: 0.01 %></td>
            </tr>
          </tbody>
          <tfoot>
            <tr class="table-info">
              <td colspan="3"><strong>Total (€)</strong></td>
              <td><strong id="total-investissement">0</strong></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>

    <!-- 2.3 - Cadre de l'investissement -->
    <div class="section-2-3">
      <h3>2.3 - Cadre de l'investissement</h3>

      <div class="form-group">
        <div class="form-check">
          <%= check_box_tag 'cadre_creation_etablissement', '1', false, class: 'form-check-input' %>
