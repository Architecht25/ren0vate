<!-- Formulaire de demande d'aide pour le recrutement - Bruxelles Entreprises -->
<div class="formulaire-recrutement-bruxelles" data-controller="bruxelles-enterprise-form">

  <!-- En-tête informatif -->
  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-primary bg-opacity-10">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h4 class="card-title mb-1">
            <i class="fas fa-user-plus text-primary me-2"></i>
            Demande d'aide pour le recrutement
          </h4>
          <p class="text-muted small mb-0">Prime pour l'embauche d'un nouveau travailleur</p>
        </div>
        <div class="col-md-4 text-end">
          <div class="badge bg-secondary">Code Subvention : 641</div>
        </div>
      </div>
    </div>

    <div class="card-body p-4">
      <!-- Informations importantes -->
      <div class="alert alert-info mb-4">
        <div class="row">
          <div class="col-md-6">
            <h6 class="alert-heading">
              <i class="fas fa-info-circle me-1"></i>
              Conditions importantes
            </h6>
            <ul class="small mb-0">
              <li>Aide de base : <strong>5.000€</strong></li>
              <li>Maximum avec majorations : <strong>15.000€</strong></li>
              <li>CDI minimum à <strong>mi-temps</strong></li>
              <li>Entrée en fonction : <strong>3 mois avant</strong> au plus tôt</li>
              <li>Nouvelle prime possible après <strong>3 ans</strong></li>
            </ul>
          </div>
          <div class="col-md-6">
            <h6 class="alert-heading">
              <i class="fas fa-phone me-1"></i>
              Support
            </h6>
            <p class="small mb-1">
              <strong>Informations :</strong> primespme@sprb.brussels
            </p>
            <p class="small mb-0">
              <strong>Technique :</strong> monbee@sprb.brussels
            </p>
          </div>
        </div>
      </div>

      <!-- Champs cachés -->
      <%= form.hidden_field :type_aide, value: "recrutement" %>
      <%= form.hidden_field :region, value: "bruxelles" %>
      <%= form.hidden_field :categorie_entreprise, value: "entreprise" %>

      <!-- PARTIE 1 : L'ENTREPRISE -->
      <div class="section-form mb-5">
        <h5 class="section-title">
          <span class="badge bg-primary me-2">1</span>
          L'entreprise pour laquelle la prime est demandée
        </h5>

        <!-- 1.1 Renseignements généraux -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-building text-primary me-2"></i>
              1.1 - Renseignements généraux
            </h6>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <!-- Type d'entreprise -->
              <div class="col-md-6">
                <label class="form-label fw-bold">
                  Type d'entreprise <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :type_entreprise, "personne_physique",
                      class: "form-check-input",
                      data: { action: "change->bruxelles-enterprise-form#updateTypeEntreprise" } %>
                  <label class="form-check-label" for="request_type_entreprise_personne_physique">
                    Personne physique
                  </label>

                  <%= form.radio_button :type_entreprise, "personne_morale",
                      class: "form-check-input ms-3",
                      data: { action: "change->bruxelles-enterprise-form#updateTypeEntreprise" } %>
                  <label class="form-check-label" for="request_type_entreprise_personne_morale">
                    Personne morale (société)
                  </label>
                </div>
              </div>

              <!-- Nom/raison sociale -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_nom_entreprise">
                  Nom ou raison sociale / Nom et prénom <span class="text-danger">*</span>
                </label>
                <%= form.text_field :nom_entreprise,
                    class: "form-control",
                    placeholder: "Nom de l'entreprise",
                    required: true %>
              </div>

              <!-- Forme juridique -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_forme_juridique">
                  Forme juridique
                </label>
                <%= form.select :forme_juridique,
                    options_for_select([
                      ['SRL', 'srl'],
                      ['SA', 'sa'],
                      ['SPRL', 'sprl'],
                      ['ASBL', 'asbl'],
                      ['Entreprise individuelle', 'entreprise_individuelle']
                    ]),
                    { prompt: "Sélectionner la forme juridique" },
                    { class: "form-select" } %>
              </div>

              <!-- Dénomination commerciale -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_denomination_commerciale">
                  Dénomination commerciale éventuelle
                </label>
                <%= form.text_field :denomination_commerciale,
                    class: "form-control",
                    placeholder: "Nom commercial" %>
              </div>

              <!-- Numéro d'entreprise -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_numero_entreprise">
                  Numéro d'entreprise <span class="text-danger">*</span>
                </label>
                <%= form.text_field :numero_entreprise,
                    class: "form-control",
                    placeholder: "BE 0XXX.XXX.XXX",
                    pattern: "BE\\s?[0-9]{4}\\.[0-9]{3}\\.[0-9]{3}",
                    required: true %>
              </div>

              <!-- Date de constitution -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_date_constitution">
                  Date de constitution
                </label>
                <%= form.date_field :date_constitution,
                    class: "form-control" %>
              </div>

              <!-- Date d'inscription BCE -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_date_inscription_bce">
                  Date d'inscription à la BCE
                </label>
                <%= form.date_field :date_inscription_bce,
                    class: "form-control" %>
              </div>

              <!-- Email -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_email_entreprise">
                  E-mail <span class="text-danger">*</span>
                </label>
                <%= form.email_field :email_entreprise,
                    class: "form-control",
                    placeholder: "email@entreprise.be",
                    required: true %>
              </div>

              <!-- Site internet -->
              <div class="col-md-6">
                <label class="form-label fw-bold" for="request_site_internet">
                  Site internet
                </label>
                <%= form.url_field :site_internet,
                    class: "form-control",
                    placeholder: "https://www.entreprise.be" %>
              </div>

              <!-- Coordonnées bancaires -->
              <div class="col-12">
                <h6 class="fw-bold mb-3">
                  <i class="fas fa-university text-primary me-2"></i>
                  Coordonnées bancaires
                </h6>
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">
                      Voulez-vous introduire un compte bancaire étranger ? <span class="text-danger">*</span>
                    </label>
                    <div class="d-flex gap-3">
                      <%= form.radio_button :compte_etranger, "oui",
                          class: "form-check-input" %>
                      <label class="form-check-label" for="request_compte_etranger_oui">
                        Oui
                      </label>

                      <%= form.radio_button :compte_etranger, "non",
                          class: "form-check-input ms-3",
                          checked: true %>
                      <label class="form-check-label" for="request_compte_etranger_non">
                        Non
                      </label>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold" for="request_iban">
                      IBAN <span class="text-danger">*</span>
                    </label>
                    <%= form.text_field :iban,
                        class: "form-control",
                        placeholder: "BE XX XXXX XXXX XXXX",
                        required: true %>
            </div>
          </div>
        </div>

        <!-- 1.3 Coordonnées de contact -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-address-book text-primary me-2"></i>
              1.3 - Coordonnées de contact
            </h6>
          </div>
          <div class="card-body">
            <!-- Personne de contact -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-user text-secondary me-2"></i>
              Personne de contact pour le suivi du dossier
            </h6>
            <div class="row g-3 mb-4">
              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_contact_titre">
                  Titre <span class="text-danger">*</span>
                </label>
                <%= form.select :contact_titre,
                    options_for_select([
                      ['Madame', 'madame'],
                      ['Monsieur', 'monsieur']
                    ]),
                    { prompt: "Sélectionner" },
                    { class: "form-select", required: true } %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_contact_nom">
                  Nom <span class="text-danger">*</span>
                </label>
                <%= form.text_field :contact_nom,
                    class: "form-control",
                    placeholder: "Nom",
                    required: true %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_contact_prenom">
                  Prénom <span class="text-danger">*</span>
                </label>
                <%= form.text_field :contact_prenom,
                    class: "form-control",
                    placeholder: "Prénom",
                    required: true %>
              </div>

              <div class="col-md-3">
                <label class="form-label fw-bold" for="request_contact_fonction">
                  Fonction <span class="text-danger">*</span>
                </label>
                <%= form.text_field :contact_fonction,
                    class: "form-control",
                    placeholder: "Ex: Gérant",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_contact_gsm">
                  GSM <span class="text-danger">*</span>
                </label>
                <%= form.tel_field :contact_gsm,
                    class: "form-control",
                    placeholder: "04XX/XX.XX.XX",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_contact_ligne_directe">
                  Ligne directe
                </label>
                <%= form.tel_field :contact_ligne_directe,
                    class: "form-control",
                    placeholder: "02/XXX.XX.XX" %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_contact_email">
                  E-mail <span class="text-danger">*</span>
                </label>
                <%= form.email_field :contact_email,
                    class: "form-control",
                    placeholder: "contact@entreprise.be",
                    required: true %>
              </div>
            </div>

            <!-- Personne légalement autorisée -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-user-tie text-secondary me-2"></i>
              Personne légalement autorisée à engager l'entreprise
            </h6>
            <div class="row g-3">
              <div class="col-12 mb-3">
                <label class="form-label fw-bold">
                  Identique à la personne de contact ? <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :representant_identique, "oui",
                      class: "form-check-input",
                      data: { action: "change->bruxelles-enterprise-form#toggleRepresentant" } %>
                  <label class="form-check-label" for="request_representant_identique_oui">
                    Oui
                  </label>

                  <%= form.radio_button :representant_identique, "non",
                      class: "form-check-input ms-3",
                      data: { action: "change->bruxelles-enterprise-form#toggleRepresentant" } %>
                  <label class="form-check-label" for="request_representant_identique_non">
                    Non
                  </label>
                </div>
              </div>

              <!-- Champs représentant (masqués si identique) -->
              <div data-bruxelles-enterprise-form-target="representantFields" style="display: none;">
                <div class="row g-3">
                  <div class="col-md-3">
                    <label class="form-label fw-bold" for="request_representant_titre">
                      Titre
                    </label>
                    <%= form.select :representant_titre,
                        options_for_select([
                          ['Madame', 'madame'],
                          ['Monsieur', 'monsieur']
                        ]),
                        { prompt: "Sélectionner" },
                        { class: "form-select" } %>
                  </div>

                  <div class="col-md-3">
                    <label class="form-label fw-bold" for="request_representant_nom">
                      Nom
                    </label>
                    <%= form.text_field :representant_nom,
                        class: "form-control",
                        placeholder: "Nom" %>
                  </div>

                  <div class="col-md-3">
                    <label class="form-label fw-bold" for="request_representant_prenom">
                      Prénom
                    </label>
                    <%= form.text_field :representant_prenom,
                        class: "form-control",
                        placeholder: "Prénom" %>
                  </div>

                  <div class="col-md-3">
                    <label class="form-label fw-bold" for="request_representant_fonction">
                      Fonction
                    </label>
                    <%= form.text_field :representant_fonction,
                        class: "form-control",
                        placeholder: "Ex: Directeur" %>
                  </div>
                </div>
            </div>
          </div>
        </div>

        <!-- 1.4 Activités de l'entreprise -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-briefcase text-primary me-2"></i>
              1.4 - Activités de l'entreprise pour laquelle la prime est demandée
            </h6>
          </div>
          <div class="card-body">
            <!-- Type d'activité / Code NACE -->
            <div class="row g-3 mb-4">
              <div class="col-12">
                <label class="form-label fw-bold" for="request_activite_nace">
                  Type d'activité / Code NACE TVA <span class="text-danger">*</span>
                </label>
                <%= form.text_field :activite_nace,
                    class: "form-control",
                    placeholder: "Ex: 82990 - Autres activités de soutien aux entreprises n.c.a.",
                    required: true %>
                <div class="form-text">
                  <i class="fas fa-info-circle me-1"></i>
                  Indiquez le code NACE et la description de l'activité principale
                </div>
              </div>

              <!-- Bouton ajouter une ligne -->
              <div class="col-12">
                <button type="button" class="btn btn-outline-primary btn-sm"
                        data-action="click->bruxelles-enterprise-form#ajouterActivite">
                  <i class="fas fa-plus me-1"></i>
                  Ajouter une ligne
                </button>
              </div>

              <!-- Container pour activités supplémentaires -->
              <div class="col-12" data-bruxelles-enterprise-form-target="activitesSupplementaires">
                <!-- Les activités supplémentaires seront ajoutées ici dynamiquement -->
              </div>
            </div>

            <!-- Description des activités -->
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold" for="request_description_activites">
                  Description des activités <span class="text-danger">*</span>
                </label>
                <%= form.text_area :description_activites,
                    class: "form-control",
                    rows: 5,
                    placeholder: "Décrivez les activités principales de votre entreprise...",
                    required: true %>
                <div class="form-text">
                  <i class="fas fa-info-circle me-1"></i>
                  Décrivez précisément les activités de votre entreprise
                </div>
            </div>
          </div>
        </div>

        <!-- 1.5 Composition du capital et données comptables -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-chart-line text-primary me-2"></i>
              1.5 - Composition du capital et données comptables
            </h6>
          </div>
          <div class="card-body">
            <!-- Montant du capital -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-euro-sign text-secondary me-2"></i>
              Montant du capital
            </h6>
            <div class="alert alert-info mb-3">
              <small>
                <i class="fas fa-info-circle me-1"></i>
                Introduisez les montants - avec une virgule et 2 décimales - chiffre après chiffre sans point ni devise.
              </small>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_capital_souscrit">
                  Capital souscrit (€) <span class="text-danger">*</span>
                </label>
                <%= form.number_field :capital_souscrit,
                    class: "form-control",
                    step: 0.01,
                    placeholder: "0,00",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_capital_libere">
                  Capital libéré <span class="text-danger">*</span>
                </label>
                <%= form.number_field :capital_libere,
                    class: "form-control",
                    step: 0.01,
                    placeholder: "0,00",
                    required: true %>
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold" for="request_nombre_parts">
                  Nombre de parts sociales <span class="text-danger">*</span>
                </label>
                <%= form.number_field :nombre_parts,
                    class: "form-control",
                    placeholder: "100",
                    required: true %>
              </div>
            </div>

            <!-- Détenteurs de parts -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-users text-secondary me-2"></i>
              Détenteurs de parts
            </h6>
            <div class="table-responsive mb-4">
              <table class="table table-bordered">
                <thead class="table-light">
                  <tr>
                    <th>Nom du détenteur de parts <span class="text-danger">*</span></th>
                    <th>Nbr de part ou % <span class="text-danger">*</span></th>
                    <th>N° d'entreprise <span class="text-danger">*</span></th>
                    <th>Nationalité <span class="text-danger">*</span></th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody data-bruxelles-enterprise-form-target="detenteursTable">
                  <tr>
                    <td>
                      <%= form.text_field "detenteurs[0][nom]",
                          class: "form-control form-control-sm",
                          placeholder: "Nom du détenteur" %>
                    </td>
                    <td>
                      <%= form.text_field "detenteurs[0][parts]",
                          class: "form-control form-control-sm",
                          placeholder: "% ou nombre" %>
                    </td>
                    <td>
                      <%= form.text_field "detenteurs[0][numero_entreprise]",
                          class: "form-control form-control-sm",
                          placeholder: "BE 0XXX.XXX.XXX" %>
                    </td>
                    <td>
                      <%= form.text_field "detenteurs[0][nationalite]",
                          class: "form-control form-control-sm",
                          placeholder: "Belge" %>
                    </td>
                    <td>
                      <button type="button" class="btn btn-outline-danger btn-sm"
                              data-action="click->bruxelles-enterprise-form#supprimerDetenteur">
                        <i class="fas fa-trash"></i>
                      </button>
                    </td>
                  </tr>
                </tbody>
              </table>
              <button type="button" class="btn btn-outline-primary btn-sm"
                      data-action="click->bruxelles-enterprise-form#ajouterDetenteur">
                <i class="fas fa-plus me-1"></i>
                Ajouter une ligne
              </button>
            </div>

            <!-- Questions sur les détenteurs -->
            <div class="row g-3 mb-4">
              <div class="col-12">
                <label class="form-label fw-bold">
                  Parmi les détenteurs de parts, existe-t-il des sociétés publiques d'investissement ou des sociétés de capital à risque ? <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :societes_publiques, "oui",
                      class: "form-check-input" %>
                  <label class="form-check-label" for="request_societes_publiques_oui">
                    Oui
                  </label>

                  <%= form.radio_button :societes_publiques, "non",
                      class: "form-check-input ms-3" %>
                  <label class="form-check-label" for="request_societes_publiques_non">
                    Non
                  </label>
                </div>
              </div>

              <div class="col-12">
                <label class="form-label fw-bold">
                  Parmi les détenteurs de parts, existe-t-il des sociétés qui n'entrent pas dans la catégorie de PME ? <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :societes_non_pme, "oui",
                      class: "form-check-input" %>
                  <label class="form-check-label" for="request_societes_non_pme_oui">
                    Oui
                  </label>

                  <%= form.radio_button :societes_non_pme, "non",
                      class: "form-check-input ms-3" %>
                  <label class="form-check-label" for="request_societes_non_pme_non">
                    Non
                  </label>
                </div>
              </div>
            </div>

            <!-- Participations dans d'autres entreprises -->
            <h6 class="fw-bold mb-3">
              <i class="fas fa-sitemap text-secondary me-2"></i>
              Participations détenues dans d'autres entreprises
            </h6>
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold">
                  Votre entreprise détient-elle des parts dans d'autres entreprises en Belgique ou à l'étranger ? <span class="text-danger">*</span>
                </label>
                <div class="d-flex gap-3">
                  <%= form.radio_button :participations_autres, "oui",
                      class: "form-check-input" %>
                  <label class="form-check-label" for="request_participations_autres_oui">
                    Oui
                  </label>

                  <%= form.radio_button :participations_autres, "non",
                      class: "form-check-input ms-3" %>
                  <label class="form-check-label" for="request_participations_autres_non">
                    Non
                  </label>
                </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PARTIE 2 : LA PRIME DEMANDÉE -->
      <div class="section-form mb-5">
        <h5 class="section-title">
          <span class="badge bg-success me-2">2</span>
          La prime demandée
        </h5>

        <!-- 2.1 Rappels importants -->
        <div class="card mb-4">
          <div class="card-header bg-warning bg-opacity-10">
            <h6 class="card-title mb-0">
              <i class="fas fa-exclamation-triangle text-warning me-2"></i>
              2.1 - Rappels importants
            </h6>
          </div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-primary mb-3">Le bénéficiaire doit :</h6>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item border-0 px-0">
                    <i class="fas fa-check-circle text-success me-2"></i>
                    Occuper au moins un équivalent temps plein sous contrat de travail à durée indéterminée
                  </li>
                  <li class="list-group-item border-0 px-0">
                    <i class="fas fa-check-circle text-success me-2"></i>
                    Accroître le nombre de travailleurs engagés (12 mois de comparaison)
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-primary mb-3">Le travailleur recruté :</h6>
                <ul class="list-group list-group-flush">
                  <li class="list-group-item border-0 px-0">
                    <i class="fas fa-calendar text-info me-2"></i>
                    Entre en fonction 3 mois avant au plus tôt
                  </li>
                  <li class="list-group-item border-0 px-0">
                    <i class="fas fa-clock text-info me-2"></i>
                    CDI minimum à mi-temps
                  </li>
