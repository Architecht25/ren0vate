          <span class="badge bg-warning me-2">4</span>
          Communication
        </h5>

        <!-- 4.1 Communication -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-bullhorn text-primary me-2"></i>
              4.1 - Communication
            </h6>
          </div>
          <div class="card-body">
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label fw-bold" for="request_comment_connu_prime">
                  Comment avez-vous connu la prime ? <span class="text-danger">*</span>
                </label>
                <%= form.select :comment_connu_prime,
                    options_for_select([
                      ['Site internet de la Région', 'site_region'],
                      ['Réseaux sociaux', 'reseaux_sociaux'],
                      ['Presse écrite', 'presse_ecrite'],
                      ['Radio/TV', 'radio_tv'],
