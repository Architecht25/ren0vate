                    <div class="form-text">Format PDF - Maximum 2 Mo</div>
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="card border-secondary">
                  <div class="card-header bg-secondary bg-opacity-10">
                    <h6 class="card-title text-secondary mb-0">Autres documents</h6>
