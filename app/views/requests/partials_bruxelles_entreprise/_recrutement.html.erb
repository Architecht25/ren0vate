</div>        <!-- 3.2 Points d'attention -->
        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="card-title mb-0">
              <i class="fas fa-lightbulb text-primary me-2"></i>
              3.2 - Points d'attention
            </h6>
          </div>
          <div class="card-body">
            <div class="alert alert-info mb-3">
              <h6>Accusé de réception</h6>
              <p class="mb-0 small">Un avis de réception automatique vous indiquera que votre demande a été réceptionnée par BEE.</p>
            </div>

