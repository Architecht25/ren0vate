<div class="container-fluid px-4 py-4">
  <!-- Header avec actions -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-file-earmark-text"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal"><%= @request.title %></h1>
    </div>
    <div>
      <%= link_to edit_request_path(@request), class: "btn btn-outline-primary-custom me-2" do %>
        <i class="bi bi-pencil me-2"></i>Modifier
      <% end %>
      <%= link_to request_request_progresses_path(@request), class: "btn btn-outline-info me-2" do %>
        <i class="bi bi-clipboard-check me-2"></i>Suivis
      <% end %>
      <% if @request.can_be_deleted? %>
        <%= link_to request_path(@request), method: :delete,
                    data: {
                      confirm: "Êtes-vous sûr de vouloir supprimer cette demande ? Cette action est irréversible.",
                      turbo_method: :delete
                    },
                    class: "btn btn-outline-danger me-2" do %>
          <i class="bi bi-trash me-2"></i>Supprimer
        <% end %>
      <% end %>
      <%= link_to requests_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Colonne principale -->
    <div class="col-lg-8">
      <!-- Récapitulatif demande -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-info-circle me-2"></i>Détails de la demande
          </h5>

          <div class="row mb-3">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label text-muted-custom small">Titre</label>
                <p class="mb-0 fs-5"><%= @request.title %></p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label text-muted-custom small">Statut</label>
                <% status_class = case @request.status
                     when 'draft' then 'secondary'
                     when 'pending' then 'warning'
                     when 'in_progress' then 'info'
                     when 'completed' then 'success'
                     else 'secondary'
                   end %>
                <p class="mb-0">
                  <span class="badge bg-<%= status_class %> rounded-pill px-3 py-2">
                    <%= @request.status&.humanize || 'Brouillon' %>
                  </span>
                </p>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label text-muted-custom small">Description</label>
            <div class="bg-light-custom p-3 rounded">
              <%= simple_format(@request.description) %>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label text-muted-custom small">Créée le</label>
                <p class="mb-0">
                  <i class="bi bi-calendar-plus me-2"></i>
                  <%= @request.created_at.strftime("%d/%m/%Y à %H:%M") %>
                </p>
              </div>
            </div>
            <% if @request.updated_at != @request.created_at %>
              <div class="col-md-6">
                <div class="mb-3">
                  <label class="form-label text-muted-custom small">Modifiée le</label>
                  <p class="mb-0">
                    <i class="bi bi-pencil me-2"></i>
                    <%= @request.updated_at.strftime("%d/%m/%Y à %H:%M") %>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
      <!-- Signatures entrepreneurs -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="card-title text-primary-custom mb-0">
              <i class="bi bi-people me-2"></i>Signatures Entrepreneurs
            </h6>
            <%= link_to new_request_contractor_signature_path(@request), class: "btn btn-sm btn-outline-primary" do %>
              <i class="bi bi-plus"></i>
            <% end %>
          </div>

          <% if @request.contractor_signatures.any? %>
            <% pending_count = @request.pending_contractor_signatures.count %>
            <% completed_count = @request.completed_contractor_signatures.count %>

            <div class="mb-3">
              <div class="d-flex justify-content-between mb-1">
                <span class="small">Progression</span>
                <span class="small"><%= completed_count %>/<%= @request.contractor_signatures.count %></span>
              </div>
              <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-success" style="width: <%= @request.contractor_signatures_progress %>%"></div>
              </div>
            </div>

            <div class="mb-3">
              <% @request.contractor_signatures.limit(3).each do |signature| %>
                <div class="d-flex align-items-center justify-content-between mb-2 p-2 bg-light rounded">
                  <div class="d-flex align-items-center">
                    <% case signature.status %>
                    <% when 'signed' %>
                      <i class="bi bi-check-circle text-success me-2"></i>
                    <% when 'pending', 'sent' %>
                      <i class="bi bi-clock text-warning me-2"></i>
                    <% when 'rejected' %>
                      <i class="bi bi-x-circle text-danger me-2"></i>
                    <% else %>
                      <i class="bi bi-circle text-muted me-2"></i>
                    <% end %>
                    <div>
                      <div class="fw-medium"><%= signature.contractor_name %></div>
                      <small class="text-muted"><%= signature.work_type.humanize %></small>
                    </div>
                  </div>
                  <span class="badge bg-<%= signature.signed? ? 'success' : signature.rejected? ? 'danger' : 'warning' %> rounded-pill">
                    <%= signature.status.humanize %>
                  </span>
                </div>
              <% end %>
            </div>

            <div class="d-grid">
              <%= link_to request_contractor_signatures_path(@request), class: "btn btn-outline-primary btn-sm" do %>
                <i class="bi bi-eye me-2"></i>Voir tout (<%= @request.contractor_signatures.count %>)
              <% end %>
            </div>
          <% else %>
            <div class="text-center text-muted py-3">
              <i class="bi bi-people display-6 mb-2"></i>
              <p class="mb-2">Aucun entrepreneur</p>
              <p class="small mb-3">Ajoutez des entrepreneurs pour collecter leurs signatures</p>
              <%= link_to new_request_contractor_signature_path(@request), class: "btn btn-primary btn-sm" do %>
                <i class="bi bi-plus me-1"></i>Ajouter un entrepreneur
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Suivis de demandes -->
      <div class="mb-4">
        <%= render 'request_progresses/summary', request: @request %>
      </div>

      <div class="card border-0 bg-light-custom">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-gear me-2"></i>Actions
          </h6>
          <div class="d-grid gap-2">
            <%= link_to edit_request_path(@request), class: "btn btn-primary-custom" do %>
              <i class="bi bi-pencil-square me-2"></i>Modifier la demande
            <% end %>
            <%= link_to requests_path, class: "btn btn-outline-secondary" do %>
              <i class="bi bi-list-ul me-2"></i>Toutes les demandes
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
