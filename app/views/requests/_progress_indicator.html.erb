<!-- Indicateur de progression pour les demandes -->
<% if @request.persisted? %>
  <% steps_service = RequestStepsService.new(@request) %>

  <div class="card mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0">
          <i class="bi bi-list-check me-2"></i>
          Progression de votre demande
        </h6>
        <small class="text-muted">
          Étape <%= steps_service.current_step %> sur 7
        </small>
      </div>

      <!-- Barre de progression -->
      <div class="progress mb-3" style="height: 8px;">
        <div class="progress-bar bg-success"
             role="progressbar"
             style="width: <%= steps_service.step_completion_percentage %>%"
             aria-valuenow="<%= steps_service.step_completion_percentage %>"
             aria-valuemin="0"
             aria-valuemax="100">
        </div>
      </div>

      <!-- Étape actuelle -->
      <div class="d-flex align-items-center">
        <i class="bi bi-arrow-right-circle text-primary me-2"></i>
        <span class="fw-medium"><%= steps_service.step_name %></span>

        <% if steps_service.current_step == 7 %>
          <span class="badge bg-success ms-2">
            <i class="bi bi-check-circle me-1"></i>
            Prêt à soumettre
          </span>
        <% end %>
      </div>

      <!-- Champs manquants -->
      <% missing_fields = steps_service.missing_fields_for_completion %>
      <% if missing_fields.any? && steps_service.current_step < 7 %>
        <div class="mt-3">
          <small class="text-muted d-block mb-2">Champs à compléter :</small>
          <div class="d-flex flex-wrap gap-1">
            <% missing_fields.first(5).each do |field| %>
              <span class="badge bg-light text-dark border">
                <i class="bi bi-exclamation-circle me-1"></i>
                <%= field %>
              </span>
            <% end %>
            <% if missing_fields.length > 5 %>
              <span class="badge bg-light text-muted border">
                +<%= missing_fields.length - 5 %> autres
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
