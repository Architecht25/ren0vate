<script nonce="<%= content_security_policy_nonce %>">
function searchCommune() {
  const commune = document.getElementById('commune_search').value.toLowerCase().trim();
  const postalCode = document.getElementById('postal_code_search').value.trim();
  const resultsDiv = document.getElementById('commune_results');
  const listDiv = document.getElementById('commune_forms_list');

  if (!commune && !postalCode) {
    alert('Veuillez entrer le nom de votre commune ou votre code postal.');
    return;
  }

  // Base de données simplifiée des communes avec formulaires
  const communesWithForms = {
    'antwerpen': { url: 'https://www.antwerpen.be/nl/info/52da4497b56e38600d78c1b7/premies-en-leningen-voor-wonen', codes: ['2000', '2018', '2020', '2030'] },
    'gent': { url: 'https://stad.gent/nl/wonen-bouwen/subsidies-en-premies', codes: ['9000', '9030', '9031', '9032'] },
    'brugge': { url: 'https://www.brugge.be/wonen-en-bouwen/premies-en-subsidies', codes: ['8000', '8200'] },
    'leuven': { url: 'https://www.leuven.be/premies-en-subsidies', codes: ['3000'] },
    'hasselt': { url: 'https://www.hasselt.be/premies', codes: ['3500'] },
    'mechelen': { url: 'https://www.mechelen.be/premies', codes: ['2800'] },
    // Communes avec utilisateurs Ren0vate actifs
    'rhode-saint-genese': { url: 'https://www.rhode-saint-genese.be/fr/theme/2653/primes', codes: ['1640'] },
    'overijse': { url: 'https://www.overijse.be/', codes: ['3090'] },
    'beersel': { url: 'https://www.beersel.be/', codes: ['1650'] },
    'hoeilaart': { url: 'https://www.hoeilaart.be/', codes: ['1560'] },
    'linkebeek': { url: 'https://www.linkebeek.be/', codes: ['1630'] },
    'dilbeek': { url: 'https://www.dilbeek.be/', codes: ['1700'] },
    'kortenberg': { url: 'https://www.kortenberg.be/', codes: ['3070'] },
    'tervuren': { url: 'https://www.tervuren.be/', codes: ['3080'] },
    'wemmel': { url: 'https://www.wemmel.be/', codes: ['1780'] },
    'drogenbos': { url: 'https://www.drogenbos.be/', codes: ['1620'] }
  };

  let found = false;

  // Recherche par nom de commune
  if (commune) {
    for (const [name, data] of Object.entries(communesWithForms)) {
      if (name.includes(commune) || commune.includes(name)) {
        showResult(name.charAt(0).toUpperCase() + name.slice(1), data.url);
        found = true;
        break;
      }
    }
  }

  // Recherche par code postal
  if (!found && postalCode) {
    for (const [name, data] of Object.entries(communesWithForms)) {
      if (data.codes.includes(postalCode)) {
        showResult(name.charAt(0).toUpperCase() + name.slice(1), data.url);
        found = true;
        break;
      }
    }
  }

  if (!found) {
    listDiv.innerHTML = '<p class="text-muted mb-0">Aucun formulaire spécifique trouvé pour cette commune. Consultez le site officiel de votre commune pour vérifier la disponibilité de primes locales.</p>';
    resultsDiv.className = 'alert alert-warning';
    resultsDiv.querySelector('h6').innerHTML = '<i class="bi bi-info-circle me-2"></i>Commune non trouvée :';
  }

  resultsDiv.style.display = 'block';
}

function showResult(communeName, url) {
  const listDiv = document.getElementById('commune_forms_list');
  listDiv.innerHTML = `
    <div class="d-flex justify-content-between align-items-center">
      <span><strong>${communeName}</strong> - Formulaires disponibles</span>
      <a href="${url}" target="_blank" class="btn btn-sm btn-primary">
        <i class="bi bi-box-arrow-up-right me-1"></i>Consulter
      </a>
    </div>
  `;
}
</script>
