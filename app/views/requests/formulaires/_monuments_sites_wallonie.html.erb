<div class="container" style="max-width: 80%;">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="card shadow-lg">
        <div class="card-header bg-success text-white text-center">
          <h3 class="mb-0">
            <i class="fas fa-landmark me-2"></i>
            Prime Monuments et Sites - Wallonie
          </h3>
          <p class="mb-0 mt-2"><small>Demande de prime pour la conservation du patrimoine classé en Wallonie</small></p>
        </div>

        <div class="card-body">
          <!-- Informations importantes -->
          <div class="alert alert-info">
            <h5><i class="fas fa-info-circle"></i> À propos de cette prime</h5>
            <p class="mb-2">
              La Région wallonne octroie des subventions pour la conservation du patrimoine immobilier classé comme monument ou site, ou inscrit sur la liste de sauvegarde.
            </p>
            <ul class="mb-2">
              <li><strong>Biens concernés :</strong> Monuments classés, sites classés, biens inscrits sur la liste de sauvegarde</li>
              <li><strong>Travaux admissibles :</strong> Conservation, restauration, mise en valeur du patrimoine</li>
              <li><strong>Taux de subvention :</strong> Jusqu'à 80% du coût des travaux selon la catégorie</li>
              <li><strong>Procédure :</strong> Demande préalable obligatoire avant tout commencement des travaux</li>
            </ul>
            <p class="mb-0">
              <strong>Important :</strong> Cette demande doit être introduite avant le commencement des travaux. Les travaux entrepris sans autorisation préalable ne sont pas subsidiables.
            </p>
          </div>

          <%= form_with(model: @request, local: true, html: { class: "needs-validation", novalidate: true }) do |form| %>

            <!-- Section 1: Identification du demandeur -->
            <div class="section-divider">
              <h4 class="section-title">
                <span class="section-number">1</span>
                Identification du demandeur
                <% if @form_data.present? %>
                  <%= indicateur_section_complete(@form_data, champs_identite_utilisateur) %>
                <% end %>
              </h4>
            </div>

            <div class="card border-light bg-light p-3 mb-4">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">
                    <i class="fas fa-user me-1"></i>Type de demandeur*
                  </label>
                  <div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_demandeur_type" id="wallonie_particulier" value="particulier" required>
                      <label class="form-check-label" for="wallonie_particulier">
                        Particulier (personne physique)
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_demandeur_type" id="wallonie_personne_morale" value="personne_morale" required>
                      <label class="form-check-label" for="wallonie_personne_morale">
                        Personne morale (société, ASBL, etc.)
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_demandeur_type" id="wallonie_collectivite" value="collectivite" required>
                      <label class="form-check-label" for="wallonie_collectivite">
                        Collectivité publique
                      </label>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <%= form.label :wallonie_nom_prenom, class: "form-label fw-bold" do %>
                    <i class="fas fa-id-card me-1"></i>Nom et prénom / Dénomination*
                    <%= badge_prerempli(@form_data, :applicant_full_name) if @form_data.present? %>
                  <% end %>
                  <%= form.text_field :wallonie_nom_prenom,
                      value: preremplir_champ(@form_data, :applicant_full_name, "#{current_user.first_name} #{current_user.last_name}".strip),
                      class: "form-control",
                      required: true %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-8 mb-3">
                  <%= form.label :wallonie_adresse_demandeur, class: "form-label fw-bold" do %>
                    <i class="fas fa-home me-1"></i>Adresse complète*
                    <%= badge_prerempli(@form_data, :applicant_full_address) if @form_data.present? %>
                  <% end %>
                  <%= form.text_field :wallonie_adresse_demandeur,
                      value: preremplir_champ(@form_data, :applicant_full_address, "#{current_user.street} #{current_user.number}".strip),
                      placeholder: "Rue, numéro, boîte",
                      class: "form-control",
                      required: true %>
                </div>
                <div class="col-md-4 mb-3">
                  <%= form.label :wallonie_cp_ville_demandeur, class: "form-label fw-bold" do %>
                    Code postal et ville*
                    <%= badge_prerempli(@form_data, :applicant_postal_city) if @form_data.present? %>
                  <% end %>
                  <%= form.text_field :wallonie_cp_ville_demandeur,
                      value: preremplir_champ(@form_data, :applicant_postal_city, "#{current_user.postal_code} #{current_user.city}".strip),
                      placeholder: "ex: 5000 Namur",
                      class: "form-control",
                      required: true %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-4 mb-3">
                  <%= form.label :wallonie_telephone_demandeur, class: "form-label fw-bold" do %>
                    <i class="fas fa-phone me-1"></i>Téléphone*
                    <%= badge_prerempli(@form_data, :applicant_phone) if @form_data.present? %>
                  <% end %>
                  <%= form.telephone_field :wallonie_telephone_demandeur,
                      value: preremplir_champ(@form_data, :applicant_phone, current_user.phone),
                      class: "form-control",
                      required: true %>
                </div>
                <div class="col-md-4 mb-3">
                  <%= form.label :wallonie_email_demandeur, class: "form-label fw-bold" do %>
                    <i class="fas fa-envelope me-1"></i>Email*
                    <%= badge_prerempli(@form_data, :applicant_email) if @form_data.present? %>
                  <% end %>
                  <%= form.email_field :wallonie_email_demandeur,
                      value: preremplir_champ(@form_data, :applicant_email, current_user.email),
                      class: "form-control",
                      required: true %>
                </div>
                <div class="col-md-4 mb-3">
                  <%= form.label :wallonie_numero_national, class: "form-label fw-bold" do %>
                    Numéro national / BCE
                    <%= badge_prerempli(@form_data, :applicant_national_number) if @form_data.present? %>
                  <% end %>
                  <%= form.text_field :wallonie_numero_national,
                      value: preremplir_champ(@form_data, :applicant_national_number, current_user.national_number),
                      placeholder: "Pour personnes physiques/morales",
                      class: "form-control" %>
                </div>
              </div>
            </div>

            <!-- Section 2: Identification du bien -->
            <div class="section-divider">
              <h4 class="section-title">
                <span class="section-number">2</span>
                Identification du bien patrimonial
              </h4>
            </div>

            <div class="card border-primary bg-primary bg-opacity-10 p-3 mb-4">
              <div class="row">
                <div class="col-md-8 mb-3">
                  <label for="wallonie_adresse_bien" class="form-label fw-bold">
                    <i class="fas fa-landmark me-1"></i>Adresse du bien classé*
                  </label>
                  <input type="text" class="form-control" id="wallonie_adresse_bien" placeholder="Adresse complète du monument ou site" required>
                </div>
                <div class="col-md-4 mb-3">
                  <label for="wallonie_cp_ville_bien" class="form-label fw-bold">Code postal et commune*</label>
                  <input type="text" class="form-control" id="wallonie_cp_ville_bien" required>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">
                    <i class="fas fa-certificate me-1"></i>Statut patrimonial*
                  </label>
                  <div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_statut_patrimoine" id="wallonie_monument_classe" value="monument_classe" required>
                      <label class="form-check-label" for="wallonie_monument_classe">
                        Monument classé
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_statut_patrimoine" id="wallonie_site_classe" value="site_classe" required>
                      <label class="form-check-label" for="wallonie_site_classe">
                        Site classé
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_statut_patrimoine" id="wallonie_liste_sauvegarde" value="liste_sauvegarde" required>
                      <label class="form-check-label" for="wallonie_liste_sauvegarde">
                        Bien inscrit sur la liste de sauvegarde
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_statut_patrimoine" id="wallonie_zone_protection" value="zone_protection" required>
                      <label class="form-check-label" for="wallonie_zone_protection">
                        Bien situé en zone de protection
                      </label>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="wallonie_date_classement" class="form-label fw-bold">
                    <i class="fas fa-calendar me-1"></i>Date de classement/inscription
                  </label>
                  <input type="date" class="form-control" id="wallonie_date_classement">

                  <label for="wallonie_numero_classement" class="form-label fw-bold mt-2">
                    <i class="fas fa-hashtag me-1"></i>Numéro de classement/inscription
                  </label>
                  <input type="text" class="form-control" id="wallonie_numero_classement" placeholder="Référence officielle">
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-3">
                  <label for="wallonie_description_bien" class="form-label fw-bold">
                    <i class="fas fa-align-left me-1"></i>Description du bien*
                  </label>
                  <textarea class="form-control" id="wallonie_description_bien" rows="3"
                            placeholder="Description détaillée du monument, site ou élément patrimonial concerné" required></textarea>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">
                    <i class="fas fa-key me-1"></i>Qualité du demandeur*
                  </label>
                  <div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_qualite_demandeur" id="wallonie_proprietaire" value="proprietaire" required>
                      <label class="form-check-label" for="wallonie_proprietaire">
                        Propriétaire
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_qualite_demandeur" id="wallonie_usufruitier" value="usufruitier" required>
                      <label class="form-check-label" for="wallonie_usufruitier">
                        Usufruitier
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_qualite_demandeur" id="wallonie_emphyteote" value="emphyteote" required>
                      <label class="form-check-label" for="wallonie_emphyteote">
                        Emphytéote
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="radio" name="wallonie_qualite_demandeur" id="wallonie_autre_droit" value="autre_droit" required>
                      <label class="form-check-label" for="wallonie_autre_droit">
                        Autre droit réel
                      </label>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="wallonie_reference_cadastrale" class="form-label fw-bold">
                    <i class="fas fa-map me-1"></i>Référence cadastrale
                  </label>
                  <input type="text" class="form-control" id="wallonie_reference_cadastrale"
                         placeholder="Division, section, numéro">

                  <label for="wallonie_superficie" class="form-label fw-bold mt-2">
                    <i class="fas fa-ruler-combined me-1"></i>Superficie concernée
                  </label>
                  <input type="text" class="form-control" id="wallonie_superficie" placeholder="en m² ou hectares">
                </div>
              </div>
            </div>

            <!-- Section 3: Description des travaux -->
            <div class="section-divider">
              <h4 class="section-title">
                <span class="section-number">3</span>
                Description des travaux de conservation
              </h4>
            </div>

            <div class="card border-warning bg-warning bg-opacity-10 p-3 mb-4">
              <div class="row">
                <div class="col-md-12 mb-3">
                  <label for="wallonie_nature_travaux" class="form-label fw-bold">
                    <i class="fas fa-tools me-1"></i>Nature détaillée des travaux*
                  </label>
                  <textarea class="form-control" id="wallonie_nature_travaux" rows="4"
                            placeholder="Décrivez précisément les travaux de conservation, restauration ou mise en valeur envisagés" required></textarea>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">
                    <i class="fas fa-list-check me-1"></i>Catégorie de travaux*
                  </label>
                  <div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_conservation" value="conservation">
                      <label class="form-check-label" for="wallonie_conservation">
                        Travaux de conservation
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_restauration" value="restauration">
                      <label class="form-check-label" for="wallonie_restauration">
                        Travaux de restauration
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_mise_valeur" value="mise_valeur">
                      <label class="form-check-label" for="wallonie_mise_valeur">
                        Travaux de mise en valeur
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_securisation" value="securisation">
                      <label class="form-check-label" for="wallonie_securisation">
                        Travaux de sécurisation
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_etudes" value="etudes">
                      <label class="form-check-label" for="wallonie_etudes">
                        Études préparatoires
                      </label>
                    </div>
                  </div>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label fw-bold">
                    <i class="fas fa-hammer me-1"></i>Éléments concernés*
                  </label>
                  <div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_toiture" value="toiture">
                      <label class="form-check-label" for="wallonie_toiture">
                        Toiture et charpente
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_facades" value="facades">
                      <label class="form-check-label" for="wallonie_facades">
                        Façades et parements
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_menuiseries" value="menuiseries">
                      <label class="form-check-label" for="wallonie_menuiseries">
                        Menuiseries et fermetures
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_structure" value="structure">
                      <label class="form-check-label" for="wallonie_structure">
                        Structure et gros œuvre
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_decorations" value="decorations">
                      <label class="form-check-label" for="wallonie_decorations">
                        Éléments décoratifs
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_abords" value="abords">
                      <label class="form-check-label" for="wallonie_abords">
                        Abords et espaces extérieurs
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="wallonie_justification" class="form-label fw-bold">
                    <i class="fas fa-question-circle me-1"></i>Justification des travaux*
                  </label>
                  <textarea class="form-control" id="wallonie_justification" rows="3"
                            placeholder="Expliquez la nécessité et l'urgence des travaux" required></textarea>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="wallonie_methodologie" class="form-label fw-bold">
                    <i class="fas fa-cogs me-1"></i>Méthodologie envisagée
                  </label>
                  <textarea class="form-control" id="wallonie_methodologie" rows="3"
                            placeholder="Techniques et méthodes de conservation prévues"></textarea>
                </div>
              </div>
            </div>

            <!-- Section 4: Aspects financiers -->
            <div class="section-divider">
              <h4 class="section-title">
                <span class="section-number">4</span>
                Aspects financiers
              </h4>
            </div>

            <div class="card border-success bg-success bg-opacity-10 p-3 mb-4">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="wallonie_cout_total" class="form-label fw-bold">
                    <i class="fas fa-calculator me-1"></i>Coût total estimé (HTVA)*
                  </label>
                  <div class="input-group">
                    <input type="number" class="form-control" id="wallonie_cout_total" step="0.01" min="0" required>
                    <span class="input-group-text">€</span>
                  </div>
                  <small class="text-muted">Montant hors TVA basé sur les devis</small>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="wallonie_subvention_demandee" class="form-label fw-bold">
                    <i class="fas fa-hand-holding-euro me-1"></i>Subvention demandée*
                  </label>
                  <div class="input-group">
                    <input type="number" class="form-control" id="wallonie_subvention_demandee" step="0.01" min="0" required>
                    <span class="input-group-text">€</span>
                  </div>
                  <small class="text-muted">Montant de la subvention sollicitée</small>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="wallonie_pourcentage_demande" class="form-label fw-bold">
                    <i class="fas fa-percent me-1"></i>Pourcentage demandé
                  </label>
                  <div class="input-group">
                    <input type="number" class="form-control" id="wallonie_pourcentage_demande" step="0.1" min="0" max="100" readonly>
                    <span class="input-group-text">%</span>
                  </div>
                  <small class="text-muted">Calculé automatiquement</small>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="wallonie_financement_propre" class="form-label fw-bold">
                    <i class="fas fa-piggy-bank me-1"></i>Financement propre
                  </label>
                  <div class="input-group">
                    <input type="number" class="form-control" id="wallonie_financement_propre" step="0.01" min="0" readonly>
                    <span class="input-group-text">€</span>
                  </div>
                  <small class="text-muted">Calculé automatiquement</small>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-3">
                  <label class="form-label fw-bold">
                    <i class="fas fa-funding me-1"></i>Autres sources de financement
                  </label>
                  <div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_prime_energie" value="prime_energie">
                      <label class="form-check-label" for="wallonie_prime_energie">
                        Prime énergie régionale
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_prime_communale" value="prime_communale">
                      <label class="form-check-label" for="wallonie_prime_communale">
                        Prime communale
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_fondation" value="fondation">
                      <label class="form-check-label" for="wallonie_fondation">
                        Fondation Roi Baudouin ou autre fondation
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_feder" value="feder">
                      <label class="form-check-label" for="wallonie_feder">
                        Fonds européens (FEDER, etc.)
                      </label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="wallonie_autre_subvention" value="autre_subvention">
                      <label class="form-check-label" for="wallonie_autre_subvention">
                        Autre subvention
                      </label>
                    </div>
                  </div>
                </div>
              </div>

              <div class="row" id="wallonie_autre_subvention_details" style="display: none;">
                <div class="col-md-12 mb-3">
                  <label for="wallonie_detail_autres_financements" class="form-label fw-bold">
                    <i class="fas fa-info me-1"></i>Détails des autres financements
                  </label>
                  <textarea class="form-control" id="wallonie_detail_autres_financements" rows="2"
                            placeholder="Précisez les autres sources de financement"></textarea>
                </div>
              </div>
            </div>

            <!-- Section 5: Planning et échéances -->
            <div class="section-divider">
              <h4 class="section-title">
                <span class="section-number">5</span>
                Planning et échéances
              </h4>
            </div>

            <div class="card border-info bg-info bg-opacity-10 p-3 mb-4">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="wallonie_debut_travaux" class="form-label fw-bold">
                    <i class="fas fa-play-circle me-1"></i>Date prévue de début des travaux*
                  </label>
                  <input type="date" class="form-control" id="wallonie_debut_travaux" required>
                  <small class="text-muted">Les travaux ne peuvent commencer avant l'octroi de la subvention</small>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="wallonie_fin_travaux" class="form-label fw-bold">
                    <i class="fas fa-stop-circle me-1"></i>Date prévue de fin des travaux*
                  </label>
                  <input type="date" class="form-control" id="wallonie_fin_travaux" required>
                  <small class="text-muted">Les travaux doivent être terminés dans les délais impartis</small>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="wallonie_duree_travaux" class="form-label fw-bold">
                    <i class="fas fa-clock me-1"></i>Durée estimée des travaux
                  </label>
                  <select class="form-select" id="wallonie_duree_travaux">
                    <option value="">-- Sélectionnez --</option>
                    <option value="moins_3_mois">Moins de 3 mois</option>
                    <option value="3_6_mois">3 à 6 mois</option>
                    <option value="6_12_mois">6 mois à 1 an</option>
                    <option value="1_2_ans">1 à 2 ans</option>
                    <option value="plus_2_ans">Plus de 2 ans</option>
                  </select>
                </div>
