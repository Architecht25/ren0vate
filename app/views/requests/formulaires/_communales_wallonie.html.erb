function searchWallonieCommune(searchTerm) {
  if (searchTerm.length < 2) {
    document.getElementById('wallonie_commune_results').style.display = 'none';
    return;
  }

  const results = Object.keys(wallonieCommunesData).filter(commune =>
    commune.toLowerCase().includes(searchTerm.toLowerCase()) ||
    wallonieCommunesData[commune].cp.includes(searchTerm)
  );

  displayWallonieCommuneResults(results);
}

function searchByPostalCode(postalCode) {
  if (postalCode.length < 4) {
    document.getElementById('wallonie_commune_results').style.display = 'none';
    return;
  }

  const results = Object.keys(wallonieCommunesData).filter(commune =>
    wallonieCommunesData[commune].cp.includes(postalCode)
  );

  displayWallonieCommuneResults(results);
}

function filterByProvince(province) {
  if (!province) {
    document.getElementById('wallonie_commune_results').style.display = 'none';
    return;
  }

  const results = Object.keys(wallonieCommunesData).filter(commune =>
    wallonieCommunesData[commune].province === province
  );

  displayWallonieCommuneResults(results);
}

function displayWallonieCommuneResults(results) {
  const resultsDiv = document.getElementById('wallonie_commune_results');

  if (results.length === 0) {
    resultsDiv.style.display = 'none';
    return;
  }

  let html = '<div class="card border-success"><div class="card-header bg-success text-white">';
  html += `<h6 class="mb-0"><i class="fas fa-search"></i> ${results.length} commune(s) trouvée(s)</h6></div>`;
  html += '<div class="card-body"><div class="row">';

  results.forEach(commune => {
    const data = wallonieCommunesData[commune];
    const communeName = commune.charAt(0).toUpperCase() + commune.slice(1).replace(/-/g, '-');

    html += `<div class="col-md-6 mb-3">
      <div class="card border-light">
        <div class="card-body p-3">
          <h6 class="card-title">${communeName} (${data.cp})</h6>
          <p class="small mb-2"><strong>Province :</strong> ${data.province.replace('-', ' ')}</p>
          <p class="small mb-2"><strong>Primes :</strong> ${data.primes.join(', ')}</p>
          <p class="small mb-2"><strong>Tél :</strong> ${data.phone}</p>
          <button class="btn btn-success btn-sm" onclick="selectWallonieCommune('${commune}')">
            <i class="fas fa-check"></i> Sélectionner
          </button>
        </div>
      </div>
    </div>`;
  });

  html += '</div></div></div>';
  resultsDiv.innerHTML = html;
  resultsDiv.style.display = 'block';
}

function selectWallonieCommune(commune) {
  const data = wallonieCommunesData[commune];
  const communeName = commune.charAt(0).toUpperCase() + commune.slice(1).replace(/-/g, '-');

  localStorage.setItem('selectedWallonieCommune', commune);

  alert(`Commune sélectionnée : ${communeName}\n\nProchaines étapes :\n1. Contactez le service urbanisme : ${data.phone}\n2. Vérifiez les conditions spécifiques\n3. Préparez votre dossier de demande`);
}

function saveWallonieCommuneSelection() {
  const searchTerm = document.getElementById('wallonie_commune_search').value;
  const postalCode = document.getElementById('wallonie_postal_code').value;
  const province = document.getElementById('wallonie_province').value;

  if (!searchTerm && !postalCode && !province) {
    alert('Veuillez d\'abord rechercher ou sélectionner une commune.');
    return;
  }

  const selectionData = {
    commune: searchTerm,
    codePostal: postalCode,
    province: province,
    timestamp: new Date().toISOString()
  };

  localStorage.setItem('wallonieCommuneSelection', JSON.stringify(selectionData));

  alert('Sélection sauvegardée !\n\nVous pouvez maintenant contacter directement votre commune pour connaître les primes disponibles.');
}

function searchAllCommunesPrimes() {
  const searchUrl = 'https://www.google.com/search?q=prime+communale+renovation+wallonie+commune';
  window.open(searchUrl, '_blank');
}

function contactWallonieSupport() {
  const email = 'support@ren0vate.be';
  const subject = 'Accompagnement primes communales Wallonie';
  const body = 'Bonjour,\n\nJe souhaiterais être accompagné(e) dans mes démarches de primes communales en Wallonie.\n\nMa commune : \nMon projet : \n\nMerci de me recontacter.\n\nCordialement';

  const mailtoLink = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  window.location.href = mailtoLink;
}

function planWallonieConsultation() {
  alert('Service de consultation personnalisée :\n\n📞 Contactez-nous au 0800/XXX.XXX\n📧 consultation@ren0vate.be\n\nNous vous rappellerons sous 24h pour planifier votre consultation gratuite.');
}

// Initialisation
document.addEventListener('DOMContentLoaded', function() {
  // Restaurer la sélection précédente si elle existe
  const savedSelection = localStorage.getItem('wallonieCommuneSelection');
  if (savedSelection) {
    const data = JSON.parse(savedSelection);
    document.getElementById('wallonie_commune_search').value = data.commune || '';
    document.getElementById('wallonie_postal_code').value = data.codePostal || '';
    document.getElementById('wallonie_province').value = data.province || '';
  }
});
</script>

