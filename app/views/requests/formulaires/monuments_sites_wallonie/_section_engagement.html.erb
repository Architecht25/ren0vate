            <div class="section-divider">
              <h4 class="section-title">
                <span class="section-number">7</span>
                Engagement et déclaration
              </h4>
            </div>

            <div class="card border-warning bg-warning bg-opacity-10 p-3 mb-4">
              <div class="alert alert-info">
                <h6><i class="fas fa-info-circle"></i> Engagements du demandeur</h6>
                <p class="mb-2">En introduisant cette demande, je m'engage à :</p>
                <ul class="small mb-0">
                  <li>Respecter les prescriptions techniques et patrimoniales</li>
                  <li>Ne pas commencer les travaux avant l'octroi de la subvention</li>
                  <li>Réaliser les travaux conformément au projet approuvé</li>
                  <li>Permettre les contrôles et visites d'inspection</li>
                  <li>Maintenir l'affectation du bien pendant 15 ans minimum</li>
                  <li>Rembourser la subvention en cas de non-respect des conditions</li>
                </ul>
              </div>

              <div class="row">
                <div class="col-md-12 mb-3">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="wallonie_engagement_general" required/>
                    <label class="form-check-label fw-bold" for="wallonie_engagement_general">
                      <i class="fas fa-hand-paper me-1"></i>
                      Je déclare accepter toutes les conditions d'octroi de la subvention et m'engage à les respecter*
                    </label>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-3">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="wallonie_veracite_infos" required/>
                    <label class="form-check-label fw-bold" for="wallonie_veracite_infos">
                      <i class="fas fa-check-circle me-1"></i>
                      Je certifie que les informations fournies sont exactes et complètes*
                    </label>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-3">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="wallonie_autorisation_controle" required/>
                    <label class="form-check-label fw-bold" for="wallonie_autorisation_controle">
                      <i class="fas fa-search me-1"></i>
                      J'autorise les agents de la Région wallonne à effectuer toute vérification nécessaire*
                    </label>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label for="wallonie_lieu_signature" class="form-label fw-bold">
                    <i class="fas fa-map-marker-alt me-1"></i>Lieu*
                  </label>
                  <input type="text" class="form-control" id="wallonie_lieu_signature" required/>
                </div>
                <div class="col-md-6 mb-3">
                  <label for="wallonie_date_signature" class="form-label fw-bold">
                    <i class="fas fa-calendar me-1"></i>Date*
                  </label>
                  <input type="date" class="form-control" id="wallonie_date_signature" required/>
                </div>
              </div>

              <div class="row">
                <div class="col-md-12 mb-3">
                  <label for="wallonie_signature" class="form-label fw-bold">
                    <i class="fas fa-signature me-1"></i>Signature du demandeur*
                  </label>
                  <input type="text" class="form-control" id="wallonie_signature"
                         placeholder="Nom et prénom ou dénomination + qualité du signataire" required>
                  <small class="text-muted">Pour les personnes morales, préciser la qualité du signataire</small>
                </div>
              </div>
            </div>

            <!-- Informations de contact et aide -->
            <div class="alert alert-success">
              <h6><i class="fas fa-headset"></i> Besoin d'aide ?</h6>
              <div class="row">
                <div class="col-md-6">
                  <p class="mb-2"><strong>Service Patrimoine - SPW Territoire :</strong></p>
                  <ul class="small mb-2">
                    <li>📞 081/33.21.11</li>
                    <li>✉️ patrimoine.spw@wallonie.be</li>
                    <li>🌐 <a href="https://patrimoine.wallonie.be" target="_blank">patrimoine.wallonie.be</a></li>
                  </ul>
                </div>
                <div class="col-md-6">
                  <p class="mb-2"><strong>Direction extérieure de votre province :</strong></p>
                  <ul class="small mb-2">
                    <li>Consultez le site web pour les contacts locaux</li>
                    <li>Prise de rendez-vous conseillée</li>
                    <li>Accompagnement technique disponible</li>
                  </ul>
                </div>
              </div>
              <div class="d-flex gap-2 mt-2">
                <button type="button" class="btn btn-success btn-sm" onclick="contactWalloniePatrimoine()">
                  <i class="fas fa-envelope"></i> Contacter le service
                </button>
                <button type="button" class="btn btn-outline-success btn-sm" onclick="downloadWallonieGuide()">
                  <i class="fas fa-download"></i> Télécharger le guide
                </button>
              </div>
            </div>

            <!-- Boutons d'action -->
            <div class="text-center">
              <button type="submit" class="btn btn-success btn-lg me-3">
                <i class="fas fa-paper-plane"></i> Soumettre la demande
              </button>
              <button type="button" class="btn btn-outline-success btn-lg me-3" onclick="saveWallonieDraft()">
                <i class="fas fa-save"></i> Sauvegarder en brouillon
              </button>
              <%= link_to "Retour aux formulaires", requests_path, class: "btn btn-secondary btn-lg" %>
            </div>

        </div>
      </div>
    </div>
  </div>
</div>
