<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Demandes</h1>
    <div class="d-flex gap-2">
      <%= link_to new_request_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Nouvelle demande
      <% end %>
      <%= link_to properties_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Mes biens
      <% end %>
    </div>
  </div>

  <!-- Liste des demandes -->
  <% if @requests.any? %>
    <%
      # Grouper les demandes par région de leur propriété pour afficher les séparateurs
      grouped_requests = @requests.group_by { |r| r.property&.region&.downcase || 'autre' }
      region_order = ['flandre', 'bruxelles', 'wallonie', 'autre']
      region_names = {
        'flandre' => 'Flandre',
        'bruxelles' => 'Bruxelles',
        'wallonie' => 'Wallonie',
        'autre' => 'Autres régions'
      }
    %>

    <% region_order.each do |region_key| %>
      <% if grouped_requests[region_key]&.any? %>
        <!-- Séparateur de région -->
        <div class="row mb-3">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <h5 class="text-muted mb-0 me-3">
                <i class="bi bi-geo-alt me-2"></i><%= region_names[region_key] %>
              </h5>
              <hr class="flex-grow-1 my-0 text-muted">
              <span class="badge bg-light text-dark ms-3"><%= grouped_requests[region_key].count %> demande<%= 's' if grouped_requests[region_key].count > 1 %></span>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-5">
          <% grouped_requests[region_key].each do |request| %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card border-0 bg-light-custom h-100 property-card position-relative<%= ' property-card-entreprise' if request.property&.is_entreprise? %>">
            <!-- Menu actions trois points -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;">
              <div class="dropdown dropup">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index: 1050;">
                  <li>
                    <%= link_to request_path(request), class: "dropdown-item" do %>
                      <i class="bi bi-eye me-2"></i>Voir les détails
                    <% end %>
                  </li>
                  <li>
                    <%= link_to request_request_progresses_path(request), class: "dropdown-item" do %>
                      <i class="bi bi-clipboard-check me-2"></i>Suivis de demandes
                    <% end %>
                  </li>
                  <% if request.status != 'submitted' %>
                    <li>
                      <%= link_to edit_request_path(request), class: "dropdown-item" do %>
                        <i class="bi bi-pencil me-2"></i>Modifier
                      <% end %>
                    </li>
                  <% end %>
                  <% if request.status == 'submitted' %>
                    <li>
                      <% official_url = case request.region
                           when 'flandre' then 'https://www.vlaanderen.be/premies-pour-renovation/mijn-verbouwpremie'
                           when 'wallonie' then 'https://energie.wallonie.be/fr/aides-et-primes.html?IDC=10717'
                           when 'bruxelles' then 'https://www.brussels.be/logement-et-energie/renovation-de-mon-logement/primes'
                           else '#'
                         end %>
                      <%= link_to official_url, target: "_blank", rel: "noopener noreferrer", class: "dropdown-item" do %>
                        <i class="bi bi-box-arrow-up-right me-2"></i>Site officiel
                      <% end %>
                    </li>
                  <% end %>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to request_path(request), method: :delete,
                        data: {
                          confirm: "Supprimer cette demande ?",
                          turbo_method: :delete
                        },
                        class: "dropdown-item text-danger" do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

            <%= link_to request_path(request), class: "text-decoration-none" do %>
              <div class="row g-0 h-100">
                <!-- Image à gauche -->
                <div class="col-4 rounded-start"
                     style="min-height: 140px;
                            background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_300,h_140,q_auto,f_auto/module-documents_vjp60t');
                            background-size: cover;
                            background-position: center;
                            background-repeat: no-repeat;
                            opacity: 0.8;">
                </div>

                <!-- Contenu à droite -->
                <div class="col-8">
                  <div class="card-body p-3 h-100 d-flex flex-column">
                    <!-- En-tête avec statut -->
                    <div class="mb-2" style="margin-right: 35px;">
                      <% status_class = case request.status
                           when 'draft' then 'secondary'
                           when 'pending' then 'warning'
                           when 'submitted' then 'primary'
                           when 'in_progress' then 'info'
                           when 'completed' then 'success'
                           else 'secondary'
                         end %>
                      <span class="badge bg-<%= status_class %> rounded-pill px-2 py-1 small">
                        <% case request.status
                           when 'draft' then 'Brouillon'
                           when 'pending' then 'En attente'
                           when 'submitted' then 'Soumise'
                           when 'in_progress' then 'En cours'
                           when 'completed' then 'Terminée'
                           else 'Brouillon'
                         end %>
                      </span>
                    </div>

                    <!-- Nom du bien -->
                    <div class="mb-2">
                      <h6 class="card-title text-dark mb-1 fw-semibold">
                        <i class="bi bi-house me-1 text-primary"></i>
                        <%= request.property&.name || 'Bien non spécifié' %>
                      </h6>
                    </div>

                    <!-- Nom du chantier/projet -->
                    <div class="mb-2 flex-grow-1">
                      <p class="text-dark mb-1 fw-normal">
                        <i class="bi bi-tools me-1 text-secondary"></i>
                        <%= request.project&.nom || request.project&.name || request.title || 'Projet non défini' %>
                      </p>
                    </div>

                    <!-- Footer avec dates -->
                    <div class="mt-auto pt-2 border-top border-light">
                      <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted-custom d-flex align-items-center">
                          <i class="bi bi-clock me-1"></i>
                          Mis à jour <%= time_ago_in_words(request.updated_at) %>
                        </small>
                        <small class="text-muted-custom">
                          <i class="bi bi-calendar me-1"></i>
                          <%= request.created_at.strftime("%d/%m/%Y") %>
                        </small>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-file-earmark-text"></i>
      </div>
      <h3 class="text-muted-custom mb-3 fw-normal">Aucune demande</h3>
      <p class="text-muted-custom mb-4">Créez votre première demande pour commencer.</p>
      <%= link_to new_request_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Nouvelle demande
      <% end %>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
