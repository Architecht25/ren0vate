<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Demandes</h1>
    <div class="d-flex gap-2">
      <%= link_to new_request_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Nouvelle demande
      <% end %>
      <% if @property %>
        <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Dashboard bien
        <% end %>
      <% end %>
      <%= link_to properties_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Mes biens
      <% end %>
    </div>
  </div>

  <!-- Message d'information -->
  <div class="alert alert-info border-0 mb-4" style="background-color: #e8f4f8;">
    <div class="d-flex align-items-start">
      <i class="bi bi-info-circle me-3 mt-1" style="font-size: 1.2rem;"></i>
      <p class="mb-0">
        Les formulaires sont complétés automatiquement pour vous aider à comprendre et vous faire gagner un temps important dans vos démarches.
      </p>
    </div>
  </div>

  <!-- Liste des demandes -->
  <% if @requests.any? %>
    <%
      # Grouper les demandes par région de leur propriété pour afficher les séparateurs
      grouped_requests = @requests.group_by { |r| r.property&.region&.downcase || 'autre' }
      region_order = ['flandre', 'bruxelles', 'wallonie', 'autre']
      region_names = {
        'flandre' => 'Flandre',
        'bruxelles' => 'Bruxelles',
        'wallonie' => 'Wallonie',
        'autre' => 'Autres régions'
      }
    %>

    <% region_order.each do |region_key| %>
      <% if grouped_requests[region_key]&.any? %>
        <!-- Séparateur de région -->
        <div class="row mb-3">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <h5 class="text-muted mb-0 me-3">
                <i class="bi bi-geo-alt me-2"></i><%= region_names[region_key] %>
              </h5>
              <hr class="flex-grow-1 my-0 text-muted">
              <span class="badge bg-light text-dark ms-3"><%= grouped_requests[region_key].count %> demande<%= 's' if grouped_requests[region_key].count > 1 %></span>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-5">
          <% grouped_requests[region_key].each do |request| %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card border-0 h-100 property-card position-relative overflow-hidden<%= ' property-card-entreprise' if request.property&.is_entreprise? %>" style="min-height: 200px;">

            <!-- Image de fond sur toute la carte -->
            <div class="position-absolute w-100 h-100"
                 style="background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_200,q_auto,f_auto/module-documents_vjp60t');
                        background-size: cover;
                        background-position: center;
                        background-repeat: no-repeat;
                        opacity: 0.8;
                        top: 0;
                        left: 0;
                        z-index: 1;">
            </div>

            <!-- Overlay sombre pour la lisibilité -->
            <div class="position-absolute w-100 h-100" style="background: rgba(0,0,0,0.1); top: 0; left: 0; z-index: 2;"></div>

            <!-- Badge statut en haut à gauche -->
            <div class="position-absolute top-0 start-0 m-2" style="z-index: 4;">
              <% status_class = case request.status
                   when 'draft' then 'secondary'
                   when 'pending' then 'warning'
                   when 'submitted' then 'primary'
                   when 'in_progress' then 'info'
                   when 'completed' then 'success'
                   else 'secondary'
                 end %>
              <span class="badge bg-<%= status_class %>" style="font-size: 0.7rem;">
                <%= case request.status
                     when 'draft' then 'Brouillon'
                     when 'pending' then 'En attente'
                     when 'submitted' then 'Soumise'
                     when 'in_progress' then 'En cours'
                     when 'completed' then 'Terminée'
                     else 'Brouillon'
                   end %>
              </span>
            </div>

            <!-- Menu actions trois points en haut à droite -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index: 4;">
              <div class="dropdown" onclick="event.stopPropagation()">
                <button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="opacity: 0.9;">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                  <li>
                    <%= link_to request_path(request), class: "dropdown-item" do %>
                      <i class="bi bi-eye me-2"></i>Voir les détails
                    <% end %>
                  </li>

                  <% if request.status != 'submitted' %>
                    <li>
                      <%= link_to edit_request_path(request), class: "dropdown-item" do %>
                        <i class="bi bi-pencil me-2"></i>Modifier
                      <% end %>
                    </li>
                  <% end %>
                  <% if request.status == 'submitted' %>
                    <li>
                      <% official_url = case request.region
                           when 'flandre' then 'https://www.vlaanderen.be/premies-pour-renovation/mijn-verbouwpremie'
                           when 'wallonie' then 'https://energie.wallonie.be/fr/aides-et-primes.html?IDC=10717'
                           when 'bruxelles' then 'https://www.brussels.be/logement-et-energie/renovation-de-mon-logement/primes'
                           else '#'
                         end %>
                      <%= link_to official_url, target: "_blank", rel: "noopener noreferrer", class: "dropdown-item" do %>
                        <i class="bi bi-box-arrow-up-right me-2"></i>Site officiel
                      <% end %>
                    </li>
                  <% end %>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to request_path(request),
                        method: :delete,
                        class: "dropdown-item text-danger border-0 bg-transparent w-100 text-start",
                        form: {
                          data: {
                            turbo_confirm: "Êtes-vous sûr de vouloir supprimer cette demande ? Cette action est irréversible."
                          }
                        } do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Contenu centré avec les informations de la demande -->
            <%= link_to edit_request_path(request), class: "text-decoration-none position-absolute w-100 h-100 d-flex align-items-center justify-content-center", style: "z-index: 3;" do %>
              <div class="text-center text-white">
                <!-- Nom du bien -->
                <h5 class="fw-bold mb-2" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.7);">
                  <i class="bi bi-house me-2"></i>
                  <%= request.property&.name || 'Bien non spécifié' %>
                </h5>

                <!-- Nom du chantier/projet -->
                <div class="text-white mb-3" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.8);">
                  <div style="font-size: 0.95rem; font-weight: 400;">
                    <i class="bi bi-tools me-2"></i>
                    <%= request.project&.nom || request.project&.name || request.title || 'Projet non défini' %>
                  </div>
                </div>

                <!-- Informations supplémentaires en bas -->
                <div class="d-flex justify-content-center align-items-center gap-3">
                  <span class="text-white" style="font-size: 0.75rem; opacity: 0.8;">
                    <i class="bi bi-clock me-1"></i>
                    Mis à jour <%= time_ago_in_words(request.updated_at) %>
                  </span>
                  <span class="text-white" style="font-size: 0.75rem; opacity: 0.8;">
                    <i class="bi bi-calendar me-1"></i>
                    <%= request.created_at.strftime("%d/%m/%Y") %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-file-earmark-text"></i>
      </div>
      <h3 class="text-muted-custom mb-3 fw-normal">Aucune demande</h3>
      <p class="text-muted-custom mb-4">Créez votre première demande pour commencer.</p>
      <%= link_to new_request_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Nouvelle demande
      <% end %>
    </div>
  <% end %>
</div>
