    <!-- Travaux complémentaires -->
    <div class="row g-3 mb-4">
      <div class="col-12">
        <h6 class="text-primary border-bottom pb-2">
          <i class="bi bi-plus-circle me-2"></i>Travaux complémentaires
        </h6>
      </div>

      <div class="col-12">
        <div class="border rounded p-3 bg-light">
          <label class="form-label fw-semibold text-success mb-3">✓ Travaux complémentaires</label>
          <div class="row g-2">
            <div class="col-12">
              <label class="form-label small">Description des travaux</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="description_complementaires" value="<%= @demande_request&.form_data&.dig('description_complementaires') || '[Description des travaux complémentaires]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('description_complementaires')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Désamiantage -->
    <div class="row g-3 mb-4">
      <div class="col-12">
        <h6 class="text-primary border-bottom pb-2">
          <i class="bi bi-shield-exclamation me-2"></i>Désamiantage
        </h6>
      </div>

      <div class="col-12">
        <div class="border rounded p-3 bg-light">
          <label class="form-label fw-semibold text-success mb-3">✓ Désamiantage</label>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label small">Localisation</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="localisation_desamiantage" value="<%=
                  case @demande_request&.form_data&.dig('localisation_desamiantage')
                  when 'toiture' then 'Toiture'
                  when 'murs' then 'Murs'
                  when 'sol' then 'Sol'
                  when 'canalisations' then 'Canalisations'
                  else (@demande_request&.form_data&.dig('localisation_desamiantage') || '[Localisation]').to_s.humanize
                  end
                %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('localisation_desamiantage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label small">Date des travaux</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="date_desamiantage" value="<%= @demande_request&.form_data&.dig('date_desamiantage') ? Date.parse(@demande_request.form_data['date_desamiantage']).strftime('%d/%m/%Y') : '[DD/MM/YYYY]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_desamiantage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bouton pour copier tous les détails techniques -->
    <div class="mt-3">
      <button class="btn btn-primary" onclick="copyTechnicalDetails()">
        <i class="bi bi-clipboard-data me-2"></i>
        Copier tous les détails techniques
      </button>
    </div>
  </div>
</div>
