              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small">Date d'installation</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="date_placement_ventilation" value="<%= @demande_request&.form_data&.dig('date_placement_ventilation') ? Date.parse(@demande_request.form_data['date_placement_ventilation']).strftime('%d/%m/%Y') : '[DD/MM/YYYY]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_ventilation')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
