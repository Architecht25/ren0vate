<%
  # Récupération directe de la request si pas disponible
  @demande_request = Request.find(params[:id]) unless @demande_request.present?
%>

<!-- Section 5: Détails techniques des travaux -->
<div class="card shadow-sm mb-4">
  <div class="card-header bg-light">
    <h5 class="mb-0">
      <i class="bi bi-tools me-2"></i>
      Détails techniques des travaux
    </h5>
    <small class="text-muted">Informations détaillées requises par Mijn Verbouwpremie</small>
  </div>
  <div class="card-body">

    <!-- Travaux d'isolation -->
    <div class="row g-3 mb-4">
      <div class="col-12">
        <h6 class="text-primary border-bottom pb-2">
          <i class="bi bi-house-gear me-2"></i>Travaux d'isolation
        </h6>
      </div>

      <!-- TOITURE -->
      <div class="col-12">
        <div class="border rounded p-3 bg-light">
          <label class="form-label fw-semibold text-success mb-3">✓ Isolation de la toiture</label>
          <div class="row g-2">
            <div class="col-md-2">
              <label class="form-label small">Surface (m²)</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="surface_toiture" value="<%= @demande_request&.form_data&.dig('surface_toiture') || '[À compléter]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('surface_toiture')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-2">
              <label class="form-label small">Méthode</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="methode_toiture" value="<%= @demande_request&.form_data&.dig('methode_toiture') == 'interieur' ? 'Par l\'intérieur' : (@demande_request&.form_data&.dig('methode_toiture') == 'exterieur' ? 'Par l\'extérieur' : (@demande_request&.form_data&.dig('methode_toiture') || '[Méthode]')) %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('methode_toiture')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-2">
              <label class="form-label small">Date</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="date_placement_toiture" value="<%= @demande_request&.form_data&.dig('date_placement_toiture') ? Date.parse(@demande_request.form_data['date_placement_toiture']).strftime('%d/%m/%Y') : '[DD/MM/YYYY]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_toiture')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Matériau</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="materiau_toiture" value="<%=
                  case @demande_request&.form_data&.dig('materiau_toiture')
                  when 'bio_ecologique' then 'Bio-écologique'
                  when 'polyurethane' then 'Polyuréthane'
                  when 'laine_verre' then 'Laine de verre'
                  when 'laine_roche' then 'Laine de roche'
                  when 'polystyrene' then 'Polystyrène'
                  else (@demande_request&.form_data&.dig('materiau_toiture') || '[Matériau]').to_s.humanize
                  end
                %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('materiau_toiture')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Marque</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="marque_toiture" value="<%= (@demande_request&.form_data&.dig('marque_toiture') || '[Marque]').to_s.humanize %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('marque_toiture')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- MURS -->
      <div class="col-12">
        <div class="border rounded p-3 bg-light">
          <label class="form-label fw-semibold text-success mb-3">✓ Isolation des murs extérieurs</label>
          <div class="row g-2">
            <div class="col-md-2">
              <label class="form-label small">Surface (m²)</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="surface_murs" value="<%= @demande_request&.form_data&.dig('surface_murs') || '[À compléter]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('surface_murs')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-2">
              <label class="form-label small">Méthode</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="methode_murs" value="<%= @demande_request&.form_data&.dig('methode_murs') == 'interieur' ? 'Par l\'intérieur' : (@demande_request&.form_data&.dig('methode_murs') == 'exterieur' ? 'Par l\'extérieur' : (@demande_request&.form_data&.dig('methode_murs') || '[Méthode]')) %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('methode_murs')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-2">
              <label class="form-label small">Date</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="date_placement_murs" value="<%= @demande_request&.form_data&.dig('date_placement_murs') ? Date.parse(@demande_request.form_data['date_placement_murs']).strftime('%d/%m/%Y') : '[DD/MM/YYYY]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_murs')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Matériau</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="materiau_murs" value="<%=
                  case @demande_request&.form_data&.dig('materiau_murs')
                  when 'bio_ecologique' then 'Bio-écologique'
                  when 'polyurethane' then 'Polyuréthane'
                  when 'laine_verre' then 'Laine de verre'
                  when 'laine_roche' then 'Laine de roche'
                  when 'polystyrene' then 'Polystyrène'
                  else (@demande_request&.form_data&.dig('materiau_murs') || '[Matériau]').to_s.humanize
                  end
                %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('materiau_murs')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Marque</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="marque_murs" value="<%= (@demande_request&.form_data&.dig('marque_murs') || '[Marque]').to_s.humanize %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('marque_murs')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SOL -->
      <div class="col-12">
        <div class="border rounded p-3 bg-light">
          <label class="form-label fw-semibold text-success mb-3">✓ Isolation du sol</label>
          <div class="row g-2">
            <div class="col-md-2">
              <label class="form-label small">Surface (m²)</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="surface_sol" value="<%= @demande_request&.form_data&.dig('surface_sol') || '[À compléter]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('surface_sol')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-2">
              <label class="form-label small">Méthode</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="methode_sol" value="<%= @demande_request&.form_data&.dig('methode_sol') == 'dessous' ? 'Par le dessous' : (@demande_request&.form_data&.dig('methode_sol') == 'dessus' ? 'Par le dessus' : (@demande_request&.form_data&.dig('methode_sol') || '[Méthode]')) %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('methode_sol')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-2">
              <label class="form-label small">Date</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="date_placement_sol" value="<%= @demande_request&.form_data&.dig('date_placement_sol') ? Date.parse(@demande_request.form_data['date_placement_sol']).strftime('%d/%m/%Y') : '[DD/MM/YYYY]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_sol')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Matériau</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="materiau_sol" value="<%=
                  case @demande_request&.form_data&.dig('materiau_sol')
                  when 'bio_ecologique' then 'Bio-écologique'
                  when 'polyurethane' then 'Polyuréthane'
                  when 'laine_verre' then 'Laine de verre'
                  when 'polystyrene_expanse' then 'Polystyrène expansé'
                  when 'polystyrene_extrude' then 'Polystyrène extrudé'
                  when 'minerale_wol' then 'Laine minérale'
                  else (@demande_request&.form_data&.dig('materiau_sol') || '[Matériau]').to_s.humanize
                  end
                %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('materiau_sol')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Marque</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="marque_sol" value="<%= (@demande_request&.form_data&.dig('marque_sol') || '[Marque]').to_s.humanize %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('marque_sol')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Remplacement vitrage -->
    <div class="row g-3 mb-4">
      <div class="col-12">
        <h6 class="text-primary border-bottom pb-2">
          <i class="bi bi-window me-2"></i>Remplacement du vitrage
        </h6>
      </div>

      <div class="col-12">
        <div class="border rounded p-3 bg-light">
          <label class="form-label fw-semibold text-success mb-3">✓ Remplacement du vitrage</label>
          <div class="row g-2">
            <div class="col-md-3">
              <label class="form-label small">Surface (m²)</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="surface_vitrage" value="<%= @demande_request&.form_data&.dig('surface_vitrage') || '[À compléter]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('surface_vitrage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Type de vitrage</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="type_vitrage" value="<%=
                  case @demande_request&.form_data&.dig('type_vitrage')
                  when 'double' then 'Double vitrage'
                  when 'triple' then 'Triple vitrage'
                  when 'vitrage_haute_performance' then 'Vitrage haute performance'
                  else (@demande_request&.form_data&.dig('type_vitrage') || '[Type de vitrage]').to_s.humanize
                  end
                %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('type_vitrage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Date</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="date_placement_vitrage" value="<%= @demande_request&.form_data&.dig('date_placement_vitrage') ? Date.parse(@demande_request.form_data['date_placement_vitrage']).strftime('%d/%m/%Y') : '[DD/MM/YYYY]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_vitrage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-3">
              <label class="form-label small">Marque</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="marque_vitrage" value="<%= (@demande_request&.form_data&.dig('marque_vitrage') || '[Marque]').to_s.humanize %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('marque_vitrage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Systèmes énergétiques -->
    <div class="row g-3 mb-4">
      <div class="col-12">
        <h6 class="text-primary border-bottom pb-2">
          <i class="bi bi-thermometer-half me-2"></i>Systèmes énergétiques
        </h6>
      </div>

      <!-- CHAUFFAGE -->
      <div class="col-12">
        <div class="border rounded p-3 bg-light">
          <label class="form-label fw-semibold text-success mb-3">✓ Système de chauffage</label>
          <div class="row g-2">
            <div class="col-md-4">
              <label class="form-label small">Type de système</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="type_systeme_chauffage" value="<%=
                  case @demande_request&.form_data&.dig('type_chauffage')
                  when 'pompe_chaleur_air_eau' then 'Pompe à chaleur air/eau'
                  when 'pompe_chaleur_air_air' then 'Pompe à chaleur air/air'
                  when 'pompe_chaleur_geothermique' then 'Pompe à chaleur géothermique'
                  when 'chaudiere_gaz_condensation' then 'Chaudière gaz à condensation'
                  when 'chaudiere_biomasse' then 'Chaudière biomasse'
                  else (@demande_request&.form_data&.dig('type_chauffage') || '[Type de système]').to_s.humanize
                  end
                %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('type_systeme_chauffage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small">Date d'installation</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="date_placement_chauffage" value="<%= @demande_request&.form_data&.dig('date_placement_chauffage') ? Date.parse(@demande_request.form_data['date_placement_chauffage']).strftime('%d/%m/%Y') : '[DD/MM/YYYY]' %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('date_placement_chauffage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
            <div class="col-md-4">
              <label class="form-label small">Marque</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="marque_chauffage" value="<%= (@demande_request&.form_data&.dig('marque_chauffage') || '[Marque]').to_s.humanize %>" readonly>
                <button class="btn btn-outline-primary" type="button" onclick="copyToClipboard('marque_chauffage')">
                  <i class="bi bi-clipboard"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- VENTILATION -->
      <div class="col-12">
        <div class="border rounded p-3 bg-light">
          <label class="form-label fw-semibold text-success mb-3">✓ Système de ventilation</label>
          <div class="row g-2">
            <div class="col-md-4">
              <label class="form-label small">Type de système</label>
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="type_systeme_ventilation" value="<%=
                  case @demande_request&.form_data&.dig('type_ventilation')
                  when 'simple-flux' then 'VMC simple flux'
                  when 'double-flux' then 'VMC double flux'
                  when 'double_flux_thermodynamique' then 'VMC double flux thermodynamique'
                  when 'ventilation_naturelle' then 'Ventilation naturelle contrôlée'
