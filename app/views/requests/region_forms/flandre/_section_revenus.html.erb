  <!-- SECTION 3 – Revenus et composition du ménage -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><i class="bi bi-currency-euro me-2"></i>Revenus et composition du ménage</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Ces informations sont nécessaires pour déterminer le montant de la prime éligible.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :revenus_annuels, class: "form-label" do %>
              Revenus annuels imposables (ménage complet) *
              <%= badge_prerempli_avec_fallback(@form_data, :revenus_annuels, current_user.household_income) if @form_data.present? %>
            <% end %>
            <%= form.number_field :revenus_annuels,
                value: preremplir_champ(@form_data, :revenus_annuels, current_user.household_income),
                class: "form-control",
                style: "border: 2px solid #dc3545;",
                min: 0,
                step: 100,
                placeholder: "Ex : 42 000",
                required: true %>
            <div class="form-text">Montant total des revenus imposables du ménage</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :personnes_charge, class: "form-label" do %>
              Nombre de personnes à charge *
              <%= badge_prerempli_avec_fallback(@form_data, :personnes_charge, current_user.nombre_enfants) if @form_data.present? %>
            <% end %>
            <%
              # Calculer la valeur des personnes à charge avec debug détaillé
              form_data_value = @form_data&.dig(:personnes_charge)
              user_enfants_value = current_user.nombre_enfants
              # Si en production et pas de valeur définie, utiliser 2 comme valeur de test
              fallback_value = Rails.env.production? && user_enfants_value.nil? ? 2 : 0

              # Ignore les valeurs "0" ou vides dans form_data, utilise les données utilisateur
              if form_data_value.present? && form_data_value != "0" && form_data_value != 0
                personnes_charge_value = form_data_value
              else
                personnes_charge_value = user_enfants_value || fallback_value
              end

              # Debug détaillé pour production
              Rails.logger.info "🔍 DEBUG PERSONNES_CHARGE DÉTAILLÉ:"
              Rails.logger.info "  - @form_data present: #{@form_data.present?}"
              Rails.logger.info "  - @form_data[:personnes_charge]: #{form_data_value.inspect}"
              Rails.logger.info "  - current_user.nombre_enfants: #{user_enfants_value.inspect}"
              Rails.logger.info "  - current_user.id: #{current_user.id}"
              Rails.logger.info "  - valeur_finale_calculée: #{personnes_charge_value.inspect}"
            %>
            <%= form.number_field :personnes_charge,
                value: personnes_charge_value,
                class: "form-control",
                style: "border: 2px solid #dc3545;",
                min: 0,
                max: 10,
                required: true %>
            <div class="form-text">Nombre de personnes à charge fiscalement</div>
            <script nonce="<%= content_security_policy_nonce %>">
              console.log("🔍 DEBUG PERSONNES_CHARGE CLIENT:", {
                value_calculated: "<%= personnes_charge_value %>",
                form_data_present: <%= @form_data.present? %>,
                form_data_value: <%= (@form_data&.dig(:personnes_charge) || 'null').to_json.html_safe %>,
                user_enfants: <%= (current_user.nombre_enfants || 'null').to_json.html_safe %>,
                user_id: <%= current_user.id %>,
                rails_env: "<%= Rails.env %>",
                input_value: document.getElementById('request_form_data_personnes_charge') ? document.getElementById('request_form_data_personnes_charge').value : 'input_not_found'
              });
            </script>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :annee_aer, class: "form-label" do %>
              Année de l'avertissement extrait de rôle utilisé *
              <%= badge_prerempli_avec_fallback(@form_data, :annee_aer, current_user.annee_revenus_demandeur) if @form_data.present? %>
            <% end %>
            <%= form.select :annee_aer,
                [
                  ["2023 (revenus 2022)", "2023"],
                  ["2022 (revenus 2021)", "2022"],
                  ["2021 (revenus 2020)", "2021"]
                ],
                {
                  prompt: "-- Sélectionnez une année --",
                  selected: preremplir_champ(@form_data, :annee_aer, current_user.annee_revenus_demandeur)
                },
                { class: "form-select", style: "border: 2px solid #dc3545;", required: true } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :compte_bancaire, class: "form-label" do %>
              Compte bancaire (IBAN)
              <%= badge_prerempli_avec_fallback(@form_data, :compte_bancaire, current_user.iban) if @form_data.present? %>
            <% end %>
            <%= form.text_field :compte_bancaire,
                value: preremplir_champ(@form_data, :compte_bancaire, current_user.iban),
                class: "form-control",
                style: "border: 2px solid #dc3545;",
                placeholder: "BE XX XXXX XXXX XXXX" %>
            <div class="form-text">Compte pour le versement de la prime</div>
          </div>
        </div>
      </div>
    </div>
  </div>

