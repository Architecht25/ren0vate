  <!-- SECTION 3 – Composition du ménage et revenus -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><i class="bi bi-people me-2"></i>Composition du ménage (usage interne Ren0vate)</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Information Ren0vate :</strong> En Flandre, le revenu est contrôlé automatiquement par Mijn Verbouwpremie via le Registre national sur base des membres de la famille déclarés à l'étape 1. Vous n'avez pas à saisir vos revenus sur le formulaire officiel.<br>
        Les champs ci-dessous sont utilisés par Ren0vate pour estimer le montant de prime auquel vous pourriez avoir droit.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :revenus_annuels, "Revenus annuels imposables estimés (ménage) *", class: "form-label" %>
            <%= form.number_field :revenus_annuels,
                value: preremplir_champ(@form_data, :revenus_annuels, current_user.household_income),
                class: "form-control",
                min: 0,
                step: 100,
                placeholder: "Ex : 42 000",
                required: true %>
            <div class="form-text">Pour l'estimation Ren0vate uniquement — non transmis à MVP</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :personnes_charge, "Nombre de personnes à charge *", class: "form-label" %>
            <%
              form_data_value = @form_data&.dig(:personnes_charge)
              user_enfants_value = current_user.nombre_enfants
              if form_data_value.present? && form_data_value != "0" && form_data_value != 0
                personnes_charge_value = form_data_value
              else
                personnes_charge_value = user_enfants_value || 0
              end
            %>
            <%= form.number_field :personnes_charge,
                value: personnes_charge_value,
                class: "form-control",
                min: 0,
                max: 10,
                required: true %>
            <div class="form-text">Personnes fiscalement à charge — pour l'estimation uniquement</div>
          </div>
        </div>
      </div>
    </div>
  </div>
