<!-- Formulaire spécifique pour Bruxelles -->
<div class="alert alert-info">
  <i class="bi bi-info-circle me-2"></i>
  <strong>Formulaire pour la Région de Bruxelles-Capitale</strong>
  <p class="mb-0 small">Primes disponibles : Prime Habitation, Prime Énergie, Prime Rénovation</p>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="mb-3">
      <%= form.label :revenus_menage, "Revenus du ménage (€)*", class: "form-label" %>
      <%= form.number_field :revenus_menage, class: "form-control", placeholder: "Ex: 45000", required: true %>
      <div class="invalid-feedback">
        Veuillez entrer le revenu du ménage.
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="mb-3">
      <%= form.label :nombre_personnes, "Nombre de personnes dans le ménage*", class: "form-label" %>
      <%= form.number_field :nombre_personnes, class: "form-control", placeholder: "Ex: 3", required: true %>
      <div class="invalid-feedback">
        Veuillez entrer le nombre de personnes.
      </div>
    </div>
  </div>
</div>

<div class="mb-3">
  <%= form.label :type_travaux, "Type de travaux*", class: "form-label" %>
  <%= form.select :type_travaux,
        options_for_select([
          ['Isolation toiture', 'isolation_toiture'],
          ['Isolation murs', 'isolation_murs'],
          ['Isolation sol', 'isolation_sol'],
          ['Châssis', 'chassis'],
          ['Chaudière', 'chaudiere'],
          ['Ventilation', 'ventilation'],
          ['Audit énergétique', 'audit_energetique']
        ]),
        { include_blank: "-- Sélectionnez le type de travaux --" },
        { class: "form-select", required: true } %>
  <div class="invalid-feedback">
    Veuillez sélectionner le type de travaux.
  </div>
</div>

<div class="mb-3">
  <%= form.label :surface_travaux, "Surface des travaux (m²)", class: "form-label" %>
  <%= form.number_field :surface_travaux, class: "form-control", placeholder: "Ex: 120", step: 0.01 %>
</div>

<div class="mb-3">
  <%= form.label :cout_estime, "Coût estimé des travaux (€)*", class: "form-label" %>
  <%= form.number_field :cout_estime, class: "form-control", placeholder: "Ex: 15000", required: true %>
  <div class="invalid-feedback">
    Veuillez entrer le coût estimé.
  </div>
</div>
