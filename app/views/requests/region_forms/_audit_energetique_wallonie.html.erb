<%= simple_form_for @request, local: true, html: { multipart: true, class: "needs-validation", novalidate: true } do |f| %>
  <!-- Champ caché pour la région -->
  <%= f.hidden_field :region, value: "wallonie" %>

  <div class="container" style="max-width: 80%;">
    <!-- En-tête du formulaire -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4 bg-gradient-primary text-white">
        <div class="d-flex align-items-center">
          <div class="icon-circle bg-white bg-opacity-20 me-3">
            <i class="bi bi-clipboard-data text-white"></i>
          </div>
          <div>
            <h2 class="mb-1 fw-semibold">Demande de prime – Audit énergétique</h2>
            <p class="mb-0 opacity-90">Région Wallonne</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 0: Nom du formulaire -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="text-primary mb-4 fw-semibold">
          <i class="bi bi-file-earmark-text me-2"></i>
          0. Nom du formulaire
        </h5>
        <div class="mb-3">
          <%= f.label :title, "Nom du formulaire *", class: "form-label" %>
          <% current_title = @request.title.present? ? @request.title : "Audit énergétique Wallonie - #{Date.current.strftime('%d/%m/%Y')}" %>
          <%= f.text_field :title,
              value: current_title,
              class: "form-control",
              placeholder: "Ex: Audit énergétique pour ma maison",
              required: true %>
          <div class="form-text">Ce nom vous aidera à identifier facilement votre demande dans la liste.</div>
        </div>
      </div>
    </div>

    <!-- Section 1: Informations sur le demandeur -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="text-primary mb-4 fw-semibold">
          <i class="bi bi-person-circle me-2"></i>
          1. Informations sur le demandeur
        </h5>


       <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :nom, class: "form-label" do %>
              Nom complet
              <%= badge_prerempli_intelligent(@form_data, :applicant_lastname, current_user.last_name) if @form_data.present? %>
            <% end %>
            <%= f.text_field :nom,
                value: preremplir_champ(@form_data, :applicant_lastname, current_user.last_name),
                placeholder: "Nom complet",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= f.label :prenom, class: "form-label" do %>
              Prénom
              <%= badge_prerempli_intelligent(@form_data, :applicant_firstname, current_user.first_name) if @form_data.present? %>
            <% end %>
            <%= f.text_field :prenom,
                value: preremplir_champ(@form_data, :applicant_firstname, current_user.first_name),
                placeholder: "Prénom",
                class: "form-control" %>
          </div>
        </div>
        </div>
        <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :numero_registre_national, class: "form-label" do %>
              Numéro de registre national
              <%= badge_prerempli_intelligent(@form_data, :applicant_national_number, current_user.national_number) if @form_data.present? %>
            <% end %>
            <%= form.text_field :numero_registre_national,
                value: preremplir_champ(@form_data, :applicant_national_number, current_user.national_number),
                placeholder: "Numéro de registre national",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :compte_bancaire, class: "form-label" do %>
              Compte bancaire du demandeur
              <%= badge_prerempli_intelligent(@form_data, :iban, current_user.iban) if @form_data.present? %>
            <% end %>
            <%= form.text_field :compte_bancaire,
                value: preremplir_champ(@form_data, :iban, current_user.iban),
                placeholder: "IBAN BE...",
                class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :email, class: "form-label" do %>
              Adresse e-mail
              <%= badge_prerempli_intelligent(@form_data, :applicant_email, current_user.email) if @form_data.present? %>
            <% end %>
            <%= form.email_field :email,
                value: preremplir_champ(@form_data, :applicant_email, current_user.email),
                placeholder: "Adresse e-mail",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :phone, class: "form-label" do %>
              Numéro de téléphone
              <%= badge_prerempli_intelligent(@form_data, :applicant_phone, current_user.phone) if @form_data.present? %>
            <% end %>
            <%= form.phone_field :phone,
                value: preremplir_champ(@form_data, :applicant_phone, current_user.phone),
                placeholder: "Numéro de téléphone",
                class: "form-control" %>
          </div>
        </div>
      </div>

      <h6 class="text-muted mb-3">Adresse du demandeur</h6>
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :adresse_demandeur, class: "form-label" do %>
              Adresse
              <%= badge_prerempli_intelligent(@form_data, :applicant_address, current_user.street) if @form_data.present? %>
            <% end %>
            <%= form.text_field :adresse_demandeur,
                value: preremplir_champ(@form_data, :applicant_address, current_user.street),
                placeholder: "Adresse",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :code_postal_demandeur, class: "form-label" do %>
              Code postal
              <%= badge_prerempli_intelligent(@form_data, :applicant_postal_code, current_user.postal_code) if @form_data.present? %>
            <% end %>
            <%= form.text_field :code_postal_demandeur,
                value: preremplir_champ(@form_data, :applicant_postal_code, current_user.postal_code),
                placeholder: "Code postal",
                class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :city, class: "form-label" do %>
              Commune
              <%= badge_prerempli_intelligent(@form_data, :applicant_city, current_user.city) if @form_data.present? %>
            <% end %>
            <%= form.text_field :city,
                value: preremplir_champ(@form_data, :applicant_city, current_user.city),
                placeholder: "Commune",
                class: "form-control" %>
          </div>
        </div>
         <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label">Région</label>
            <%= form.text_field :region, value: "Wallonie", class: "form-control", disabled: true %>
          </div>
        </div>
      </div>
    </div>
  </div>

    <!-- Section 2: Informations sur le bien à auditer -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="text-success mb-4 fw-semibold">
          <i class="bi bi-house-door me-2"></i>
          2. Informations sur le bien à auditer
        </h5>

        <div class="row g-3">
          <div class="col-12">
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Note :</strong> Si le bien à auditer est différent de votre adresse personnelle, veuillez le préciser dans la description.
            </div>
          </div>
          <div class="col-md-4">
            <%= f.input :type_bien,
                as: :select,
                collection: ["Maison unifamiliale", "Appartement", "Immeuble à appartements", "Autre"],
                label: "Type de bien*",
                prompt: "-- Sélectionnez le type de bien --",
                wrapper_html: { class: "mb-3" },
                input_html: { class: "form-select", required: true } %>
          </div>
          <div class="col-md-4">
            <%= f.input :usage,
                as: :select,
                collection: ["Résidence principale", "Logement locatif", "Autre"],
                label: "Affectation du logement*",
                prompt: "-- Sélectionnez l'affectation --",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-select", required: true } %>
          </div>
          <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :annee_construction, class: "form-label" do %>
              Année de construction
              <%= badge_prerempli_intelligent(@form_data, :property_year_built, @property&.annee_construction) %>
            <% end %>
            <%= form.text_field :annee_construction,
                value: preremplir_champ(@form_data, :property_year_built, @property&.annee_construction),
                placeholder: "Année de construction",
                class: "form-control" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 3: Informations relatives à l'audit -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="text-info mb-4 fw-semibold">
          <i class="bi bi-clipboard-check me-2"></i>
          3. Informations relatives à l'audit
        </h5>

        <div class="row g-3">
          <div class="col-12">
            <div class="alert alert-warning">
              <i class="bi bi-exclamation-triangle me-2"></i>
              <strong>Information importante :</strong> Veuillez renseigner les détails de l'audit dans la description ci-dessous.
            </div>
          </div>

          <div class="col-md-3">
            <div class="mb-3">
              <%= form.label :numero_audit, class: "form-label" do %>
                Numéro d'audit
                <%= badge_prerempli_intelligent(@form_data, :audit_number, @property&.projects&.first&.numero_audit) %>
              <% end %>
              <%= form.text_field :numero_audit,
                  value: preremplir_champ(@form_data, :audit_number, @property&.projects&.first&.numero_audit),
                  placeholder: "A20....",
                  class: "form-control" %>
              <div class="form-text">Numéro d'audit obligatoire</div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="mb-3">
              <%= form.label :date_audit, class: "form-label" do %>
                Date de l'audit
                <%= badge_prerempli_intelligent(@form_data, :audit_date, @property&.projects&.first&.date_audit) %>
              <% end %>
              <%= form.date_field :date_audit,
                  value: preremplir_champ(@form_data, :audit_date, @property&.projects&.first&.date_audit),
                  class: "form-control" %>
              <div class="form-text">Date de réalisation</div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="mb-3">
              <%= form.label :numero_agrement_auditeur, class: "form-label" do %>
                Numéro d'agrément
                <%= badge_prerempli_intelligent(@form_data, :auditor_license_number, @property&.projects&.first&.numero_agrement_auditeur) %>
              <% end %>
              <%= form.text_field :numero_agrement_auditeur,
                  value: preremplir_champ(@form_data, :auditor_license_number, @property&.projects&.first&.numero_agrement_auditeur),
                  placeholder: "PAE2 - PX-XXXXX",
                  class: "form-control" %>
              <div class="form-text">Agrément auditeur</div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="mb-3">
              <%= form.label :prix_audit, class: "form-label" do %>
                Prix de l'audit
                <%= badge_prerempli_intelligent(@form_data, :audit_price, @property&.projects&.first&.prix_audit) %>
              <% end %>
              <%= form.text_field :prix_audit,
                  value: preremplir_champ(@form_data, :audit_price, @property&.projects&.first&.prix_audit),
                  placeholder: "0.00",
                  class: "form-control" %>
              <div class="form-text">Prix de l'audit en euros</div>
            </div>
          </div>

          <div class="col-12">
            <div class="alert alert-info small">
              <i class="bi bi-info-circle me-2"></i>
              Ces informations sont automatiquement récupérées depuis les données du projet si elles ont été saisies précédemment.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 4: Documents à préparer -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="text-warning mb-4 fw-semibold">
          <i class="bi bi-file-earmark-text me-2"></i>
          4. Documents à préparer
        </h5>

        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i>
          Les documents suivants seront demandés après validation de votre demande :
        </div>

        <div class="row">
          <div class="col-12">
            <h6 class="text-primary mb-3">Pour tous les demandeurs :</h6>
            <div class="form-check mb-3">
              <input type="checkbox"
                     class="form-check-input"
                     id="document_factures_prepared"
                     name="documents_prepared[]"
                     value="factures_audit">
              <label class="form-check-label" for="document_factures_prepared">
                Une copie de toutes les factures relatives à la réalisation de l'audit
              </label>
            </div>
            <div class="form-check mb-3">
              <input type="checkbox"
                     class="form-check-input"
                     id="document_rib_prepared"
                     name="documents_prepared[]"
                     value="rib_carte_bancaire">
              <label class="form-check-label" for="document_rib_prepared">
                Une photo de votre carte bancaire mentionnant votre nom et le numéro de compte (veillez à cacher l'éventuel code de sécurité CVC) ou le Relevé d'Identité Bancaire (RIB) délivré avec une signature de la banque
              </label>
            </div>
          </div>
        </div>

        <div class="alert alert-success mt-4">
          <i class="bi bi-check-circle me-2"></i>
          <strong>Important :</strong> Ces documents seront à fournir lors de la validation finale de votre demande de prime.
        </div>
      </div>
    </div>

    <!-- Section 5: Déclaration sur l'honneur -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="text-danger mb-4 fw-semibold">
          <i class="bi bi-shield-check me-2"></i>
          5. Déclaration sur l'honneur
        </h5>

        <div class="form-check">
          <%= f.check_box :confirmation_veracite,
              class: "form-check-input",
              required: true %>
          <%= f.label :confirmation_veracite,
              "Je certifie que les informations ci-dessus sont exactes et complètes.*",
              class: "form-check-label" %>
        </div>
        <div class="form-check mt-2">
          <%= f.check_box :acceptation_conditions,
              class: "form-check-input",
              required: true %>
          <%= f.label :acceptation_conditions,
              "J'accepte les conditions générales de la demande de prime audit énergétique.*",
              class: "form-check-label" %>
        </div>
      </div>
    </div>

    <!-- Boutons d'action -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4 text-center">
        <div class="d-flex flex-column gap-3 align-items-center">
          <!-- Bouton principal de sauvegarde -->
          <button type="submit" name="commit" value="Sauvegarder en brouillon"
                 class="btn btn-primary btn-lg px-4 py-2"
                 style="max-width: 300px; width: 100%;">
            <i class="bi bi-save me-2"></i>Sauvegarder en brouillon
          </button>

          <!-- Bouton vers la plateforme officielle -->
          <% if @request.persisted? %>
            <%= link_to "https://monespace.wallonie.be/",
                       class: "btn btn-outline-primary btn-lg px-4 py-2 w-100 mt-2",
                       style: "max-width: 400px;",
                       target: "_blank",
                       rel: "noopener noreferrer" do %>
              <i class="bi bi-box-arrow-up-right me-2"></i>Introduisez votre demande sur la plateforme officielle
            <% end %>
          <% end %>

          <!-- Zone d'explication du processus -->
          <% if @request.persisted? %>
            <div class="alert alert-info mt-4 mb-3" style="max-width: 800px;">
              <div class="row align-items-center">
                <div class="col-auto">
                  <i class="bi bi-info-circle fs-4 text-info"></i>
                </div>
                <div class="col">
                  <h6 class="mb-2 fw-semibold">Comment procéder ?</h6>
                  <div class="row g-2 small">
                    <div class="col-md-4">
                      <div class="d-flex align-items-start">
                        <span class="badge bg-primary rounded-pill me-2 mt-1">1</span>
                        <div>
                          <strong>Sauvegardez</strong><br>
                          <span class="text-muted">Conservez vos données</span>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="d-flex align-items-start">
                        <span class="badge bg-success rounded-pill me-2 mt-1">2</span>
                        <div>
                          <strong>Soumettez</strong><br>
                          <span class="text-muted">Sur la plateforme officielle</span>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="d-flex align-items-start">
                        <span class="badge bg-warning rounded-pill me-2 mt-1">3</span>
                        <div>
                          <strong>Créez le suivi</strong><br>
                          <%= link_to "Suivi de primes", new_request_progress_path(request_id: @request.id),
                                     class: "text-decoration-none small" %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <%= link_to "Annuler", requests_path, class: "btn btn-outline-secondary px-4 mt-3" %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<!-- Script de validation -->
<script nonce="<%= content_security_policy_nonce %>">
(function() {
  'use strict';
  var forms = document.querySelectorAll('.needs-validation');
  Array.prototype.slice.call(forms)
    .forEach(function(form) {
      form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
})();
</script>

<!-- Styles CSS personnalisés -->
<style>
.icon-circle {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
}

.bg-gradient-primary {
  background: linear-gradient(135deg, var(--bs-primary) 0%, #0056b3 100%);
}

.form-control-lg {
  font-size: 1.1rem;
  padding: 0.75rem 1rem;
}

.card {
  transition: transform 0.2s ease-in-out;
}

.card:hover {
  transform: translateY(-2px);
}

.form-text {
  font-size: 0.85rem;
  margin-top: 0.25rem;
}

.btn-lg {
  padding: 0.75rem 2rem;
  font-size: 1.1rem;
}
</style>

  </div> <!-- Fermeture du container-fluid -->
