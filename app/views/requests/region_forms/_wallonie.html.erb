<!-- Formulaire spécifique pour la Wallonie - Prime Régionale -->
<div class="request-form-container">
<div class="wallonie-specific-fields">

  <!-- SECTION 0 – Informations AUDIT -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Informations sur l'Audit</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Cette demande de prime doit nécessairement faire suite à un audit logement.
      </div>
      <div class="row">
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :numero_audit, class: "form-label" do %>
              Numéro d'audit
              <%= badge_prerempli_intelligent(@form_data, :numero_audit, @property&.projects&.last&.numero_audit) %>
            <% end %>
            <%= form.text_field :numero_audit,
                value: preremplir_champ(@form_data, :numero_audit, @property&.projects&.last&.numero_audit),
                placeholder: "A20....",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :date_audit, class: "form-label" do %>
              Date de l'audit
              <%= badge_prerempli_intelligent(@form_data, :date_audit, @property&.projects&.last&.date_audit) %>
            <% end %>
            <%= form.date_field :date_audit,
                value: preremplir_champ(@form_data, :date_audit, @property&.projects&.last&.date_audit),
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :numero_agrement_auditeur, class: "form-label" do %>
              Numéro d'agrément de l'auditeur
              <%= badge_prerempli_intelligent(@form_data, :numero_agrement_auditeur, @property&.projects&.last&.numero_agrement_auditeur) %>
            <% end %>
            <%= form.text_field :numero_agrement_auditeur,
                value: preremplir_champ(@form_data, :numero_agrement_auditeur, @property&.projects&.last&.numero_agrement_auditeur),
                placeholder: "PAE2 - PX-XXXXX",
                class: "form-control" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 1 – Identification -->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0">
        <i class="bi bi-person-circle me-2"></i>Identification du demandeur
        <%= indicateur_section_complete(@form_data, champs_identite_utilisateur) if @form_data.present? %>
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label">Type de demandeur</label>
            <%= form.select :type_demandeur, options_for_select([['Sélectionnez', ''], ['Particulier', 'Particulier'], ['Copropriété', 'Copropriété']]), {}, { class: "form-control" } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label">Qualité du demandeur</label>
            <%= form.select :qualite_demandeur, options_for_select([["Sélectionnez", ""], ["Unique propriétaire", "Unique propriétaire"], ["Copropriétaire avec mon conjoint", "Copropriétaire avec mon conjoint"], ["Copropriétaire avec d'autres", "Copropriétaire avec d'autres"], ["Usufruitier", "Usufruitier"], ["Nu-propriétaire", "Nu-propriétaire"], ["Représentant d'une association de copropriétaires", "Représentant d'une association de copropriétaires"], ["Autres", "Autres"]]), {}, { class: "form-control" } %>
          </div>
        </div>
      </div>

      <% if @property.present? %>
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :profil_demandeur, "Profil du demandeur *", class: "form-label" %>
            <div class="form-control-plaintext fw-bold text-primary">
              <%= @property&.profil_demandeur&.humanize || "Non défini" %>
            </div>
            <%= form.hidden_field :profil_demandeur, value: @property&.profil_demandeur %>
          </div>
        </div>
        <div class="col-md-6">
          <!-- Espace pour équilibrer la mise en page -->
        </div>
      </div>
      <% end %>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :nom, class: "form-label" do %>
              Nom complet
              <%= badge_prerempli(@form_data, :applicant_lastname) if @form_data.present? %>
            <% end %>
            <%= form.text_field :nom,
                value: preremplir_champ(@form_data, :applicant_lastname, current_user.last_name),
                placeholder: "Nom complet",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :prenom, class: "form-label" do %>
              Prénom
              <%= badge_prerempli(@form_data, :applicant_firstname) if @form_data.present? %>
            <% end %>
            <%= form.text_field :prenom,
                value: preremplir_champ(@form_data, :applicant_firstname, current_user.first_name),
                placeholder: "Prénom",
                class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :numero_registre_national, class: "form-label" do %>
              Numéro de registre national
              <%= badge_prerempli(@form_data, :applicant_national_number) if @form_data.present? %>
            <% end %>
            <%= form.text_field :numero_registre_national,
                value: preremplir_champ(@form_data, :applicant_national_number, current_user.national_number),
                placeholder: "Numéro de registre national",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :compte_bancaire, class: "form-label" do %>
              Compte bancaire du demandeur
              <%= badge_prerempli_intelligent(@form_data, :iban, current_user.iban) if @form_data.present? %>
            <% end %>
            <%= form.text_field :compte_bancaire,
                value: preremplir_champ(@form_data, :iban, current_user.iban),
                placeholder: "IBAN BE...",
                class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :email, class: "form-label" do %>
              Adresse e-mail
              <%= badge_prerempli(@form_data, :applicant_email) if @form_data.present? %>
            <% end %>
            <%= form.email_field :email,
                value: preremplir_champ(@form_data, :applicant_email, current_user.email),
                placeholder: "Adresse e-mail",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :phone, class: "form-label" do %>
              Numéro de téléphone
              <%= badge_prerempli(@form_data, :applicant_phone) if @form_data.present? %>
            <% end %>
            <%= form.phone_field :phone,
                value: preremplir_champ(@form_data, :applicant_phone, current_user.phone),
                placeholder: "Numéro de téléphone",
                class: "form-control" %>
          </div>
        </div>
      </div>

      <h6 class="text-muted mb-3">Adresse du demandeur</h6>
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :adresse_demandeur, class: "form-label" do %>
              Adresse
              <%= badge_prerempli(@form_data, :applicant_address) if @form_data.present? %>
            <% end %>
            <%= form.text_field :adresse_demandeur,
                value: preremplir_champ(@form_data, :applicant_address, current_user.street),
                placeholder: "Adresse",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :code_postal_demandeur, class: "form-label" do %>
              Code postal
              <%= badge_prerempli(@form_data, :applicant_postal_code) if @form_data.present? %>
            <% end %>
            <%= form.text_field :code_postal_demandeur,
                value: preremplir_champ(@form_data, :applicant_postal_code, current_user.postal_code),
                placeholder: "Code postal",
                class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :city, class: "form-label" do %>
              Commune
              <%= badge_prerempli(@form_data, :applicant_city) if @form_data.present? %>
            <% end %>
            <%= form.text_field :city,
                value: preremplir_champ(@form_data, :applicant_city, current_user.city),
                placeholder: "Commune",
                class: "form-control" %>
          </div>
        </div>
         <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label">Région</label>
            <%= form.text_field :region, value: "Wallonie", class: "form-control", disabled: true %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 2 – Adresse du logement -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0">
        <i class="bi bi-house-door me-2"></i>Adresse du logement concerné
        <%= indicateur_section_complete(@form_data, champs_adresse_propriete) if @form_data.present? %>
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :adresse_logement, class: "form-label" do %>
              Adresse
              <%= badge_prerempli_intelligent(@form_data, :property_street, @property&.address) %>
            <% end %>
            <%= form.text_field :adresse_logement,
                value: preremplir_champ(@form_data, :property_street, @property&.address),
                placeholder: "Adresse",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :code_postal_logement, class: "form-label" do %>
              Code postal
              <%= badge_prerempli_intelligent(@form_data, :property_postal_code, @property&.code_postal) %>
            <% end %>
            <%= form.text_field :code_postal_logement,
                value: preremplir_champ(@form_data, :property_postal_code, @property&.code_postal),
                placeholder: "Code postal",
                class: "form-control" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :commune_logement, class: "form-label" do %>
              Commune
              <%= badge_prerempli_intelligent(@form_data, :property_city, @property&.commune) %>
            <% end %>
            <%= form.text_field :commune_logement,
                value: preremplir_champ(@form_data, :property_city, @property&.commune),
                placeholder: "Commune",
                class: "form-control" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label">Région</label>
            <%= form.text_field :region_logement, value: "Wallonie", class: "form-control", disabled: true %>
          </div>
        </div>

        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label">Type de bâtiment après travaux</label>
            <%= form.select :type_batiment, options_for_select([['Sélectionnez', ''], ['Maison unifamiliale', 'Maison unifamiliale'], ['Appartement/studio', 'Appartement/studio'], ['immeuble avec plusieurs unités de logement', 'immeuble avec plusieurs unités de logement'], ['autres', 'autres']]), {}, { class: "form-control" } %>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- SECTION 3 – Type de prime demandée -->
  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0"><i class="bi bi-award me-2"></i>Type de prime demandée</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <div class="mb-3">
            <label class="form-label">Des personnes handicapées font-elles partie de votre ménage ?</label>
            <%= form.select :handicape, options_for_select([['Sélectionnez', ''], ['Oui', 'Oui'], ['Non', 'Non']]), {}, { class: "form-control" } %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <label class="form-label">Des enfants font-ils partie de votre ménage ?</label>
            <%= form.select :enfants, options_for_select([['Sélectionnez', ''], ['Oui', 'Oui'], ['Non', 'Non']]), {}, { class: "form-control" } %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <label class="form-label">Des personnes de plus de 60 ans font-elles partie de votre ménage ?</label>
            <%= form.select :plus_de_60_ans, options_for_select([['Sélectionnez', ''], ['Oui', 'Oui'], ['Non', 'Non']]), {}, { class: "form-control" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 4 – Information relative au ménage-->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0"><i class="bi bi-award me-2"></i>Information relative au ménage</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <label class="form-label">Type de prime</label>
            <%= form.select :type_prime, options_for_select([['Sélectionnez', ''], ['Audit énergétique', 'Audit énergétique'], ['Travaux après audit', 'Travaux après audit'], ['Travaux sans audit', 'Travaux sans audit']]), {}, { class: "form-control" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 5 – Travaux envisagés ou réalisés -->
  <div class="card mb-4">
    <div class="card-header bg-dark text-white">
      <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Travaux envisagés ou réalisés</h5>
    </div>
    <div class="card-body">
      <div class="row">
                <div class="col-md-12">
          <div class="mb-3">
            <label class="form-label">Type de travaux</label>
            <div class="row">
              <!-- Audit énergétique -->
              <div class="col-md-6">
                <h6 class="text-primary">Audit énergétique</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_audit_energetique, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_audit_energetique) %>">
                    Audit énergétique
                  </label>
                </div>

                <h6 class="text-primary mt-3">Travaux Toiture</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_remplacement_couverture_toiture, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_remplacement_couverture_toiture) %>">
                    Remplacement de la couverture de toiture
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_reparation_charpente, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_reparation_charpente) %>">
                    Réparation ou renforcement de la charpente
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_gouttieres_descentes, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_gouttieres_descentes) %>">
                    Remplacement ou installation des gouttières et descentes d'eau
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_isolation_toiture, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_isolation_toiture) %>">
                    Isolation de la toiture
                  </label>
                </div>

                <h6 class="text-primary mt-3">Travaux Murs</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_assechement_infiltrations, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_assechement_infiltrations) %>">
                    Assèchement des murs par traitement contre les infiltrations
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_assechement_humidite, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_assechement_humidite) %>">
                    Assèchement des murs par traitement contre l'humidité ascensionnelle
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_renforcement_murs, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_renforcement_murs) %>">
                    Renforcement ou reconstruction de murs instables
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_isolation_murs, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_isolation_murs) %>">
                    Isolation des murs
                  </label>
                </div>

                <h6 class="text-primary mt-3">Travaux Sols</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_refection_supports, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_refection_supports) %>">
                    Réfection ou remplacement des supports de circulation (escaliers, planchers, etc.)
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_isolation_sols, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_isolation_sols) %>">
                    Isolation thermique des sols
                  </label>
                </div>

                <h6 class="text-primary mt-3">Installation électrique</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_conformite_electrique, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_conformite_electrique) %>">
                    Mise en conformité de l'installation électrique
                  </label>
                </div>

                <h6 class="text-primary mt-3">Installation Gaz</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_conformite_gaz, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_conformite_gaz) %>">
                    Mise en conformité de l'installation de gaz
                  </label>
                </div>

                <h6 class="text-primary mt-3">Autres travaux</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_elimination_merule, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_elimination_merule) %>">
                    Élimination de la mérule ou autres champignons lignivores
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_elimination_radon, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_elimination_radon) %>">
                    Élimination du radon
                  </label>
                </div>

                <h6 class="text-primary">Menuiseries</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_remplacement_chassis, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_remplacement_chassis) %>">
                    Remplacement des châssis et vitrages
                  </label>
                </div>
              </div>

              <div class="col-md-6">
                <h6 class="text-primary mt-3">Systèmes Chauffage</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_pompe_chaleur_chauffage, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_pompe_chaleur_chauffage) %>">
                    Installation de pompe à chaleur pour chauffage
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_chaudiere_biomasse, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_chaudiere_biomasse) %>">
                    Installation de chaudière biomasse
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_poele_biomasse, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_poele_biomasse) %>">
                    Installation de poêle biomasse
                  </label>
                </div>

                <h6 class="text-primary mt-3">Eau Chaude Sanitaire</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_pompe_chaleur_ecs, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_pompe_chaleur_ecs) %>">
                    Installation de pompe à chaleur pour production d'eau chaude sanitaire
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_chauffe_eau_solaire, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_chauffe_eau_solaire) %>">
                    Installation d'un chauffe-eau solaire
                  </label>
                </div>

                <h6 class="text-primary mt-3">Ventilation</h6>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_ventilation_simple_flux, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_ventilation_simple_flux) %>">
                    Installation ou remplacement d'un système de ventilation simple flux
                  </label>
                </div>
                <div class="form-check mb-2">
                  <%= form.check_box :travaux_ventilation_double_flux, { class: "form-check-input" }, "1", "0" %>
                  <label class="form-check-label" for="<%= form.field_id(:travaux_ventilation_double_flux) %>">
                    Installation ou remplacement d'un système de ventilation double flux avec récupération de chaleur
                  </label>
