<!-- Script minimal pour Wallonie -->
<script>
// Forcer l'affichage de la section Wallonie si on est sur ce formulaire
(function() {
  const wallonieSection = document.getElementById('wallonie-section');
  const formTypeInput = document.querySelector('input[name*="form_type"]');

  if (wallonieSection && formTypeInput && formTypeInput.value === 'regional_wallonie') {
    console.log('🏠 Affichage forcé de la section Wallonie');
    wallonieSection.style.display = 'block';
  }
})();

// Fonction simple pour sauvegarder le formulaire Wallonie en brouillon
window.saveWallonieFormData = function(event) {
  // Empêcher la propagation d'événements
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }

  console.log('💾 Sauvegarde formulaire Wallonie en brouillon');

  const form = document.querySelector('#request-form-main');
  if (!form) {
    console.error('❌ Formulaire non trouvé');
    alert('Erreur: formulaire non trouvé');
    return false;
  }

  // Ajouter le champ commit pour indiquer qu'on sauvegarde en brouillon
  let commitField = form.querySelector('input[name="commit"]');
  if (!commitField) {
    commitField = document.createElement('input');
    commitField.type = 'hidden';
    commitField.name = 'commit';
    form.appendChild(commitField);
  }
  commitField.value = 'Sauvegarder en brouillon';

  console.log('📋 Soumission du formulaire pour sauvegarde en brouillon');

  // Désactiver le bouton pendant la soumission
  const button = document.getElementById('wallonie-submit-btn');
  if (button) {
    button.disabled = true;
    button.textContent = 'Sauvegarde...';
  }

  // Soumettre le formulaire de manière standard
  form.submit();

  return false;
};

// Gestion simple des interactions spécifiques à Wallonie
document.addEventListener('DOMContentLoaded', function() {
  // Forcer à nouveau l'affichage au chargement complet
  const wallonieSection = document.getElementById('wallonie-section');
  const formTypeInput = document.querySelector('input[name*="form_type"]');

  if (wallonieSection && formTypeInput && formTypeInput.value === 'regional_wallonie') {
    console.log('🏠 Affichage forcé de la section Wallonie au DOMContentLoaded');
    wallonieSection.style.display = 'block';
  }

  // Gestion du maintien du régime
  const maintienNon = document.getElementById('maintien_regime_non');
  const infoAlert = document.getElementById('maintien_regime_info');

  function toggleMaintienInfo() {
    if (maintienNon && maintienNon.checked && infoAlert) {
      infoAlert.style.display = 'block';
    } else if (infoAlert) {
      infoAlert.style.display = 'none';
    }
  }

  document.querySelectorAll('input[name*="maintien_regime"]').forEach(radio => {
    radio.addEventListener('change', toggleMaintienInfo);
  });

  // Gestion de l'adresse du logement
  const adresseLogementFields = document.getElementById('adresse_logement_fields');

  function toggleAdresseLogement() {
    const locAutreAdresse = document.getElementById('loc_autre_adresse');
    if (locAutreAdresse && locAutreAdresse.checked && adresseLogementFields) {
      adresseLogementFields.style.display = 'block';
    } else if (adresseLogementFields) {
      adresseLogementFields.style.display = 'none';
    }
  }

  document.querySelectorAll('input[name*="localisation_travaux"]').forEach(radio => {
    radio.addEventListener('change', toggleAdresseLogement);
  });

  // État initial
  toggleMaintienInfo();
  toggleAdresseLogement();
});
</script>
