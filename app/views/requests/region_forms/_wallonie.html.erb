<!-- Formulaire spécifique pour la Wallonie -->
<div class="alert alert-info">
  <i class="bi bi-info-circle me-2"></i>
  <strong>Formulaire pour la Région Wallonne</strong>
  <p class="mb-0 small">Primes disponibles : Prime Habitation, Prime Énergie, Prime Rénovation, Prime Logement</p>
</div>

<div class="wallonie-specific-fields">

  <!-- SECTION 4 – Revenus du ménage -->
  <h2>Revenus du ménage</h2>
  <div class="mb-3">
    <label class="form-label">Revenu imposable net du ménage (N-2)</label>
    <%= form.number_field :revenus_menage, placeholder: "Revenu imposable net du ménage (N-2)", class: "form-control" %>
    <small class="form-text text-muted">Comme mentionné dans l'avertissement-extrait de rôle</small>
  </div>
  <div class="mb-3">
    <label class="form-label">Nombre de personnes à charge</label>
    <%= form.number_field :nombre_personnes, placeholder: "Nombre de personnes à charge", class: "form-control" %>
  </div>

  <hr>

  <!-- SECTION 5 – Travaux envisagés ou réalisés -->
  <h2>Travaux</h2>
  <div class="mb-3">
    <label class="form-label">Type de travaux</label>
    <%= form.text_field :type_travaux, placeholder: "Type de travaux", class: "form-control" %>
  </div>

  <div class="mb-3">
    <label class="form-label">Montant des travaux (TVAC)</label>
    <%= form.number_field :montant_travaux, placeholder: "Montant des travaux (TVAC)", class: "form-control", step: 0.01 %>
  </div>

  <hr>

  <!-- SECTION 6 – Documents à joindre -->
  <h2>Documents à fournir</h2>
  <p class="text-muted">Les documents seront demandés après validation de votre demande :</p>
  <ul>
    <li>Factures ou devis</li>
    <li>Photos avant/après</li>
    <li>Preuve de revenus (avertissement extrait de rôle)</li>
    <li>Rapport d'audit énergétique (si applicable)</li>
  </ul>

</div>
