<script>
// Fonction simple pour sauvegarder le formulaire Wallonie en brouillon
function saveWallonieFormData(event) {
  // Empêcher la propagation d'événements
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }

  console.log('💾 Sauvegarde formulaire Wallonie en brouillon');

  const form = document.querySelector('#request-form-main');
  if (!form) {
    console.error('❌ Formulaire non trouvé');
    alert('Erreur: formulaire non trouvé');
    return false;
  }

  // Ajouter le champ commit pour indiquer qu'on sauvegarde en brouillon
  let commitField = form.querySelector('input[name="commit"]');
  if (!commitField) {
    commitField = document.createElement('input');
    commitField.type = 'hidden';
    commitField.name = 'commit';
    form.appendChild(commitField);
  }
  commitField.value = 'Sauvegarder en brouillon';

  console.log('📋 Soumission du formulaire pour sauvegarde en brouillon');

  // Désactiver le bouton pendant la soumission
  const button = document.getElementById('wallonie-submit-btn');
  if (button) {
    button.disabled = true;
    button.textContent = 'Sauvegarde...';
  }

  // Soumettre le formulaire de manière standard
  form.submit();

  return false;
}
</script>
