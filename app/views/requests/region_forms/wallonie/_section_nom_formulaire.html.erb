  <!-- SECTION 0 – Nom du formulaire -->
  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0">
        <i class="bi bi-file-earmark-text me-2"></i>Nom du formulaire
      </h5>
    </div>
    <div class="card-body">
      <div class="mb-3">
        <%= form.label :title, "Nom du formulaire *", class: "form-label" %>
        <%= form.text_field :title,
            class: "form-control",
            placeholder: "Ex: Demande de prime pour rénovation énergétique",
            required: true %>
        <div class="form-text">Ce nom vous aidera à identifier facilement votre demande dans la liste.</div>
      </div>
    </div>
  </div>

