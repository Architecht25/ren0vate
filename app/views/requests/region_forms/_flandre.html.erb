<!-- Formulaire spécifique pour la Flandre -->
<div class="alert alert-info">
  <i class="bi bi-info-circle me-2"></i>
  <strong>Formulaire pour la Région Flandre</strong>
  <p class="mb-0 small">Primes disponibles : Primes régionales flamandes (énergie + rénovation)</p>
</div>

<div class="flandre-specific-fields">

  <!-- SECTION 0 – Conditions préalables -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Conditions préalables</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-warning">
        <i class="bi bi-info-circle me-2"></i>
        Le dépôt de votre demande ne peut se faire que si vous êtes domicilié dans votre bien après travaux
      </div>
      <div class="form-check">
        <%= form.check_box :domicile, { class: "form-check-input", required: true }, "domicile", "" %>
        <%= form.label :domicile, "Je confirme être domicilié dans mon bien après travaux", class: "form-check-label fw-bold" %>
      </div>
    </div>
  </div>

  <!-- SECTION 1 – Identification du demandeur -->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Identification du demandeur</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :type_demandeur, "Type de demandeur *", class: "form-label" %>
            <%= form.select :type_demandeur,
                [
                  ["Particulier", "particulier"],
                  ["Société", "societe"],
                  ["Syndicat de copropriété", "syndic"],
                  ["Bailleur social", "bailleur_social"],
                  ["ASBL ou Coopérative", "asbl_cooperative"]
                ],
                { prompt: "-- Sélectionnez --" },
                { class: "form-select", required: true } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :registre_national, "Numéro de registre national ou BCE *", class: "form-label" %>
            <%= form.text_field :registre_national, class: "form-control", placeholder: "XX.XX.XX-XXX.XX ou BE0123456789", required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :nom, "Nom du demandeur *", class: "form-label" %>
            <%= form.text_field :nom, class: "form-control", placeholder: "Nom complet", required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :prenom, "Prénom du demandeur *", class: "form-label" %>
            <%= form.text_field :prenom, class: "form-control", placeholder: "Prénom", required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :telephone, "Téléphone *", class: "form-label" %>
            <%= form.telephone_field :telephone, class: "form-control", placeholder: "0x/xxx.xx.xx", required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :email, "Adresse email *", class: "form-label" %>
            <%= form.email_field :email, class: "form-control", placeholder: "nom@email.com", required: true %>
          </div>
        </div>
      </div>
    </div>
  </div>  <!-- SECTION 2 – Données du logement -->
  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0"><i class="bi bi-house-door me-2"></i>Données du logement concerné</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :ean, "Code EAN (optionnel)", class: "form-label" %>
            <%= form.text_field :ean, class: "form-control", placeholder: "Ex: 54144..." %>
            <div class="form-text">Code EAN de votre compteur électrique</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :parcelle, "Numéro de parcelle (optionnel)", class: "form-label" %>
            <%= form.text_field :parcelle, class: "form-control", placeholder: "Ex: 12345/02A" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="mb-3">
            <%= form.label :adresse, "Adresse du logement *", class: "form-label" %>
            <%= form.text_field :adresse, class: "form-control", placeholder: "Rue, numéro", required: true %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :code_postal, "Code postal *", class: "form-label" %>
            <%= form.text_field :code_postal, class: "form-control", placeholder: "Ex: 1000", required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :commune, "Commune *", class: "form-label" %>
            <%= form.text_field :commune, class: "form-control", placeholder: "Nom de la commune", required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :type_bien, "Type de bien *", class: "form-label" %>
            <%= form.select :type_bien,
                [
                  ["Maison unifamiliale", "maison"],
                  ["Appartement", "appartement"],
                  ["Immeuble avec plusieurs unités", "immeuble"]
                ],
                { prompt: "-- Sélectionnez --" },
                { class: "form-select", required: true } %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :usage, "Usage du bien *", class: "form-label" %>
            <%= form.select :usage,
                [
                  ["Résidence principale", "residence_principale"],
                  ["Bien en location", "location"],
                  ["Autre", "autre"]
                ],
                { prompt: "-- Sélectionnez --" },
                { class: "form-select", required: true } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :chauffage_post_renovation, "Système de chauffage après rénovation *", class: "form-label" %>
            <%= form.select :chauffage_post_renovation,
                [
                  ["Chauffage central au gaz (condensation)", "gaz"],
                  ["Chauffage au mazout", "mazout"],
                  ["Chauffage électrique direct", "electrique"],
                  ["Pompe à chaleur air/eau", "pac-air-eau"],
                  ["Pompe à chaleur géothermique", "pac-geothermique"],
                  ["Réseau de chaleur", "reseau-chaleur"],
                  ["Poêle / insert bois / biomasse", "bois"],
                  ["Autre (à spécifier)", "autre"],
                  ["Je ne sais pas", "ne_sais_pas"]
                ],
                { prompt: "-- Sélectionnez --" },
                { class: "form-select", required: true } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 3 – Travaux à déclarer -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Travaux à déclarer</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Sélectionnez les travaux envisagés. Les détails spécifiques pourront être complétés ultérieurement.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-primary mb-3">
                <i class="bi bi-house-up me-2"></i>Travaux d'isolation
              </h6>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_toiture, { class: "form-check-input" }, "toiture", "" %>
                <%= form.label :travaux_toiture, "Isolation de la toiture", class: "form-check-label" %>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_murs, { class: "form-check-input" }, "murs", "" %>
                <%= form.label :travaux_murs, "Isolation des murs extérieurs", class: "form-check-label" %>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_sol, { class: "form-check-input" }, "sol", "" %>
                <%= form.label :travaux_sol, "Isolation du sol ou des caves", class: "form-check-label" %>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_vitrage, { class: "form-check-input" }, "vitrage", "" %>
                <%= form.label :travaux_vitrage, "Remplacement du vitrage", class: "form-check-label" %>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_amiante, { class: "form-check-input" }, "amiante", "" %>
                <%= form.label :travaux_amiante, "Travaux de désamiantage (toiture et/ou murs)", class: "form-check-label" %>
              </div>
              
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-success mb-3">
                <i class="bi bi-lightning-charge me-2"></i>Systèmes énergétiques
              </h6>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_chauffage, { class: "form-check-input" }, "chauffage", "" %>
                <%= form.label :travaux_chauffage, "Installation pompe à chaleur", class: "form-check-label" %>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_complementaires, { class: "form-check-input" }, "complementaires", "" %>
                <%= form.label :travaux_complementaires, "Travaux complémentaires", class: "form-check-label" %>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_ventilation, { class: "form-check-input" }, "ventilation", "" %>
                <%= form.label :travaux_ventilation, "Système de ventilation", class: "form-check-label" %>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 4 – Revenus et composition du ménage -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><i class="bi bi-currency-euro me-2"></i>Revenus et composition du ménage</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Ces informations sont nécessaires pour déterminer le montant de la prime éligible.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :revenus_annuels, "Revenus annuels imposables (ménage complet) *", class: "form-label" %>
            <%= form.number_field :revenus_annuels, class: "form-control", min: 0, step: 100, placeholder: "Ex : 42 000", required: true %>
            <div class="form-text">Montant total des revenus imposables du ménage</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :personnes_charge, "Nombre de personnes à charge *", class: "form-label" %>
            <%= form.number_field :personnes_charge, class: "form-control", min: 0, max: 10, value: 0, required: true %>
            <div class="form-text">Nombre de personnes à charge fiscalement</div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :annee_aer, "Année de l'avertissement extrait de rôle utilisé *", class: "form-label" %>
            <%= form.select :annee_aer,
                [
                  ["2023 (revenus 2022)", "2023"],
                  ["2022 (revenus 2021)", "2022"],
                  ["2021 (revenus 2020)", "2021"]
                ],
                { prompt: "-- Sélectionnez une année --" },
                { class: "form-select", required: true } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :compte_bancaire, "Compte bancaire (IBAN)", class: "form-label" %>
            <%= form.text_field :compte_bancaire, class: "form-control", placeholder: "BE XX XXXX XXXX XXXX" %>
            <div class="form-text">Compte pour le versement de la prime</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 5 – Documents justificatifs -->
  <div class="card mb-4">
    <div class="card-header bg-secondary text-white">
      <h5 class="mb-0"><i class="bi bi-paperclip me-2"></i>Documents justificatifs</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Joignez les documents nécessaires à l'analyse de votre demande.
        <strong>Formats acceptés :</strong> PDF, JPG, PNG (max 10MB par fichier)
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>Documents obligatoires
              </h6>

              <div class="mb-3">
                <%= form.label :document_devis, "📎 Devis des travaux *", class: "form-label fw-bold" %>
                <%= form.file_field :document_devis, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true, required: true %>
              </div>

              <div class="mb-3">
                <%= form.label :document_factures, "📎 Factures des travaux *", class: "form-label fw-bold" %>
                <%= form.file_field :document_factures, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true, required: true %>
              </div>

              <div class="mb-3">
                <%= form.label :document_aer, "📊 Avertissement extrait de rôle *", class: "form-label fw-bold" %>
                <%= form.file_field :document_aer, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", required: true %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-success">
                <i class="bi bi-plus-circle me-2"></i>Documents complémentaires
              </h6>

              <div class="mb-3">
                <%= form.label :document_peb, "📊 Certificat PEB", class: "form-label" %>
                <%= form.file_field :document_peb, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png" %>
              </div>

              <div class="mb-3">
                <%= form.label :document_attestations, "🧑‍🔧 Attestations entrepreneurs", class: "form-label" %>
                <%= form.file_field :document_attestations, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true %>
              </div>

              <div class="mb-3">
                <%= form.label :document_photos, "📸 Photos des travaux", class: "form-label" %>
                <%= form.file_field :document_photos, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true %>
              </div>

              <div class="mb-3">
                <%= form.label :document_autres, "📂 Autres documents", class: "form-label" %>
                <%= form.file_field :document_autres, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 6 – Soumission de la demande -->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>Soumission de la demande</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-success">
        <i class="bi bi-info-circle me-2"></i>
        Vous êtes sur le point de soumettre votre demande de primes.
        Veuillez vérifier que toutes les informations sont correctes et que les documents obligatoires ont été joints.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :email_contact, "📧 Email pour le suivi de la demande *", class: "form-label" %>
            <%= form.email_field :email_contact, class: "form-control", placeholder: "nom@email.com", data: { required: "true" } %>
            <div class="form-text">Adresse email pour recevoir les notifications</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :telephone_contact, "📞 Téléphone de contact", class: "form-label" %>
            <%= form.telephone_field :telephone_contact, class: "form-control", placeholder: "0x/xxx.xx.xx" %>
            <div class="form-text">Numéro de téléphone pour un contact éventuel</div>
          </div>
        </div>
      </div>

      <div class="form-check mb-4">
        <%= form.check_box :confirmation_veracite, { class: "form-check-input", data: { required: "true" } }, "true", "" %>
        <%= form.label :confirmation_veracite, "Je confirme que les informations fournies sont exactes et complètes à ma connaissance.", class: "form-check-label fw-bold" %>
      </div>

      <div class="form-check mb-4">
        <%= form.check_box :acceptation_conditions, { class: "form-check-input", data: { required: "true" } }, "true", "" %>
        <%= form.label :acceptation_conditions, "J'accepte les conditions générales et autorise le traitement de mes données personnelles.", class: "form-check-label" %>
      </div>

      <!-- Statut et soumission spécifique Flandre -->
      <div class="mb-4">
        <%= form.label :status, "Statut de la demande", class: "form-label" %>
        <%= form.select :status,
              options_for_select([
                ['Brouillon', 'draft'],
                ['En attente', 'pending'],
                ['En cours', 'in_progress'],
                ['Terminée', 'completed']
              ], @request.status || 'draft'),
              {},
              { class: "form-select" } %>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="text-muted">
          <small>
            <i class="bi bi-shield-check me-1"></i>
            Vos données sont traitées de manière sécurisée
          </small>
        </div>
        <div>
          <a href="https://www.vlaanderen.be/bouwen-wonen-en-energie/premies-voor-verbouwing-en-renovatie"
             target="_blank"
             rel="noopener noreferrer"
             class="btn btn-outline-info btn-sm">
            <i class="bi bi-link-45deg me-1"></i>
            Site officiel Vlaanderen
          </a>
        </div>
      </div>

      <div class="d-flex gap-2">
        <%= form.submit "Sauvegarder en brouillon", class: "btn btn-outline-primary px-4" %>
        <a href="https://www.vlaanderen.be/bouwen-wonen-en-energie/premies-voor-verbouwing-en-renovatie"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-primary-custom px-4">
          <i class="bi bi-box-arrow-up-right me-2"></i>
          Continuer sur le site Vlaanderen
        </a>
        <%= link_to "Annuler", requests_path, class: "btn btn-outline-secondary px-4" %>
      </div>      <div id="message-soumission" class="mt-3 fw-bold text-success"></div>
    </div>
  </div>

</div>
