<!-- Formulaire spécifique pour la Flandre -->
<div class="alert alert-info">
  <i class="bi bi-info-circle me-2"></i>
  <strong>Formulaire pour la Région Flamande</strong>
  <p class="mb-0 small">Primes disponibles : Vlaio, Mijn VerbouwPremie, Energiepremie</p>
</div>

<div class="flandre-specific-fields">

  <!-- Titre principal -->
  <div class="text-center mb-4">
    <h2 class="h4 text-primary-custom">Prévisualisation de votre demande via le formulaire Miroir</h2>
    <p class="text-muted">Complétez les informations ci-dessous puis soumettez votre demande</p>
  </div>

  <!-- Étape 0 : Condition préalable -->
  <div class="card mb-4">
    <div class="card-body">
      <h3 class="card-title text-primary-custom">
        <i class="bi bi-house-check me-2"></i>0. Conditions préalables
      </h3>
      <p class="card-text text-muted">Le dépôt de votre demande ne peut se faire que si vous êtes domicilié dans votre bien après travaux</p>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="domicile" name="domicile" value="domicile" required>
        <label class="form-check-label" for="domicile">
          <strong>Êtes-vous bien domicilié dans votre bien?</strong>
        </label>
      </div>
    </div>
  </div>

  <!-- Étape 1 : Profil du demandeur -->
  <div class="card mb-4">
    <div class="card-body">
      <h3 class="card-title text-primary-custom">
        <i class="bi bi-person me-2"></i>1. Profil du demandeur
      </h3>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="type-demandeur" class="form-label">Type de demandeur *</label>
          <select id="type-demandeur" name="type_demandeur" class="form-select" required>
            <option disabled selected value="">-- Sélectionnez --</option>
            <option value="particulier">Particulier</option>
            <option value="societe">Société</option>
            <option value="syndic">Syndicat de copropriété</option>
            <option value="bailleur_social">Bailleur social</option>
            <option value="asbl_cooperative">ASBL ou Coopérative</option>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label for="registre-national" class="form-label">Numéro de registre national ou BCE *</label>
          <input type="text" id="registre-national" name="registre_national" class="form-control" required />
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="nom" class="form-label">Nom du demandeur *</label>
          <input type="text" id="nom" name="nom" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
          <label for="prenom" class="form-label">Prénom du demandeur *</label>
          <input type="text" id="prenom" name="prenom" class="form-control" required />
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="telephone" class="form-label">Téléphone *</label>
          <input type="tel" id="telephone" name="telephone" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
          <label for="email" class="form-label">Adresse email *</label>
          <input type="email" id="email" name="email" class="form-control" required />
        </div>
      </div>
    </div>
  </div>

  <!-- Étape 2 : Données du logement concerné -->
  <div class="card mb-4">
    <div class="card-body">
      <h3 class="card-title text-primary-custom">
        <i class="bi bi-house me-2"></i>2. Données du logement concerné
      </h3>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="ean" class="form-label">Votre code EAN</label>
          <input type="text" id="ean" name="ean" class="form-control" placeholder="Ex: 54144..." />
        </div>
        <div class="col-md-6 mb-3">
          <label for="parcelle" class="form-label">Numéro de parcelle (optionnel)</label>
          <input type="text" id="parcelle" name="parcelle" class="form-control" />
        </div>
      </div>

      <div class="mb-3">
        <label for="adresse" class="form-label">Adresse du logement *</label>
        <input type="text" id="adresse" name="adresse" class="form-control" required />
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="code-postal" class="form-label">Code postal *</label>
          <input type="text" id="code-postal" name="code_postal" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
          <label for="commune" class="form-label">Commune *</label>
          <input type="text" id="commune" name="commune" class="form-control" required />
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="type-bien" class="form-label">Type de bien *</label>
          <select id="type-bien" name="type_bien" class="form-select" required>
            <option disabled selected value="">-- Sélectionnez --</option>
            <option value="maison">Maison unifamiliale</option>
            <option value="appartement">Appartement</option>
            <option value="immeuble">Immeuble avec plusieurs unités</option>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label for="usage" class="form-label">Usage du bien *</label>
          <select id="usage" name="usage" class="form-select" required>
            <option disabled selected value="">-- Sélectionnez --</option>
            <option value="residence_principale">Résidence principale</option>
            <option value="location">Bien en location</option>
            <option value="autre">Autre</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Étape 2.1 : Informations complémentaires -->
  <div class="card mb-4">
    <div class="card-body">
      <h3 class="card-title text-primary-custom">
        <i class="bi bi-thermometer-half me-2"></i>2.1 Informations complémentaires sur le système de chauffage
      </h3>
      <div class="mb-3">
        <label for="chauffage-post-renovation" class="form-label">Système de chauffage après rénovation *</label>
        <select id="chauffage-post-renovation" name="chauffage_post_renovation" class="form-select" required>
          <option disabled selected value="">-- Sélectionnez --</option>
          <option value="gaz">Chauffage central au gaz (condensation)</option>
          <option value="mazout">Chauffage au mazout</option>
          <option value="electrique">Chauffage électrique direct</option>
          <option value="pac-air-eau">Pompe à chaleur air/eau</option>
          <option value="pac-geothermique">Pompe à chaleur géothermique</option>
          <option value="reseau-chaleur">Réseau de chaleur</option>
          <option value="bois">Poêle / insert bois / biomasse</option>
          <option value="autre">Autre (à spécifier)</option>
          <option value="ne_sais_pas">Je ne sais pas</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Étape 3 : Travaux à déclarer -->
  <section id="travaux-section" class="formulaire-prime mt-5">
    <h3>3. Travaux à déclarer</h3>
    <p>Veuillez cocher les types de travaux envisagés et compléter les champs demandés pour chaque type sélectionné.</p>

    <!-- Isolation toiture -->
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="travaux-toiture" name="travaux[]" value="toiture">
      <label class="form-check-label" for="travaux-toiture">Isolation de la toiture</label>
    </div>
    <div id="details-toiture" class="travaux-details d-none">
      <label for="surface-toiture">Surface (m²)</label>
      <input type="number" id="surface-toiture" name="surface_toiture" min="0" step="1">
      <label for="type-toiture">Méthode</label>
      <select id="type-toiture" name="type_toiture">
        <option value="">-- Sélectionnez --</option>
        <option value="interieur">Par l’intérieur</option>
        <option value="exterieur">Par l’extérieur</option>
      </select>
    </div>

    <!-- Isolation murs extérieurs -->
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="travaux-murs" name="travaux[]" value="murs">
      <label class="form-check-label" for="travaux-murs">Isolation des murs extérieurs</label>
    </div>
    <div id="details-murs" class="travaux-details d-none">
      <label for="surface-murs">Surface (m²)</label>
      <input type="number" id="surface-murs" name="surface_murs" min="0" step="1">
      <label for="type-murs">Méthode</label>
      <select id="type-murs" name="type_murs">
        <option value="">-- Sélectionnez --</option>
        <option value="creux">Murs creux</option>
        <option value="interieur">Par l’intérieur</option>
        <option value="exterieur">Par l’extérieur</option>
      </select>
    </div>

    <!-- Vitrage -->
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="travaux-vitrage" name="travaux[]" value="vitrage">
      <label class="form-check-label" for="travaux-vitrage">Remplacement du vitrage</label>
    </div>
    <div id="details-vitrage" class="travaux-details d-none">
      <label for="surface-vitrage">Surface (m²)</label>
      <input type="number" id="surface-vitrage" name="surface_vitrage" min="0" step="1">
    </div>

    <!-- Isolation du sol -->
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="travaux-sol" name="travaux[]" value="sol">
      <label class="form-check-label" for="travaux-sol">Isolation du sol ou des caves</label>
    </div>
    <div id="details-sol" class="travaux-details d-none">
      <label for="surface-sol">Surface (m²)</label>
      <input type="number" id="surface-sol" name="surface_sol" min="0" step="1">
    </div>

    <!-- Chauffage (chaudière ou PAC) -->
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="travaux-chauffage" name="travaux[]" value="chauffage">
      <label class="form-check-label" for="travaux-chauffage">Installation d'une pompe à clhaleur et chauffe-eau thermodynamique</label>
    </div>
    <div id="details-chauffage" class="travaux-details d-none">
      <label for="type-chauffage">Type de système</label>
      <select id="type-chauffage" name="type_chauffage">
        <option value="">-- Sélectionnez --</option>
        <option value="pac-geothermique">Pompe à chaleur géothermique</option>
        <option value="pac-air-eau">Pompe à chaleur air/eau</option>
        <option value="pac-air-air">Pompe à chaleur air/air</option>
        <option value="hybride">Pompe à chaleur hybride</option>
        <option value="boiler">Boiler thermodynamique</option>
      </select>
    </div>

  </section>

  <!-- Étape 3.1 – Travaux complémentaires et non subventionnés -->
  <section id="travaux-complementaires" class="formulaire-prime mt-5">
    <h4 class="mb-4">🔧 Travaux complémentaires (préparatoires ou non subventionnés)</h4>

    <!-- Travaux préparatoires -->
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="travaux-preparatoires" name="travaux[]" value="preparatoires">
      <label class="form-check-label fw-bold" for="travaux-preparatoires">
        Travaux préparatoires à l’isolation
      </label>
    </div>
    <div id="details-preparatoires" class="travaux-details d-none ms-3">
      <label for="type-preparatoires">Type de préparatifs</label>
      <input type="text" id="type-preparatoires" name="type_preparatoires" placeholder="Ex : retrait du plafonnage" class="form-control mb-2">
      <label for="montant-preparatoires">Montant total facturé (€)</label>
      <input type="number" id="montant-preparatoires" name="montant_preparatoires" min="0" step="10" class="form-control">
    </div>

    <!-- Travaux d’électricité -->
    <div class="form-check mt-4">
      <input class="form-check-input" type="checkbox" id="travaux-electricite" name="travaux[]" value="electricite">
      <label class="form-check-label fw-bold" for="travaux-electricite">
        Travaux préparatoire sanitaires et électricité
      </label>
    </div>
    <div id="details-electricite" class="travaux-details d-none ms-3">
      <label for="type-electricite">Nature des travaux</label>
      <input type="text" id="type-electricite" name="type_electricite" placeholder="Ex : Mise en conformité RGIE, tableau électrique…" class="form-control mb-2">
      <label for="montant-electricite">Montant estimé ou facturé (€)</label>
      <input type="number" id="montant-electricite" name="montant_electricite" min="0" step="10" class="form-control">
    </div>
  </section>

  <!-- Étape 4 : Revenus et catégorie de prime -->
  <section id="section-revenus" class="formulaire-prime mt-5">
    <h3>4. Revenus et composition du ménage</h3>

    <!-- Revenus imposables du ménage -->
    <label for="revenus-annuels">Revenus annuels imposables (ménage complet) *</label>
    <input type="number" id="revenus-annuels" name="revenus_annuels" min="0" step="100" placeholder="Ex : 42 000" required>

    <!-- Année de l'AER -->
    <label for="annee-aer">Année de l’avertissement extrait de rôle utilisé *</label>
    <select id="annee-aer" name="annee_aer" required>
      <option disabled selected value="">-- Sélectionnez une année --</option>
      <option value="2023">2023 (revenus 2022)</option>
      <option value="2022">2022 (revenus 2021)</option>
      <option value="2021">2021 (revenus 2020)</option>
    </select>

    <!-- Composition du ménage -->
    <label for="nombre-personnes-charge">Nombre de personnes à charge *</label>
    <input type="number" id="nombre-personnes-charge" name="personnes_charge" min="0" max="10" value="0" required>
  </section>

  <!-- Étape 5 : Documents à fournir -->
  <section id="section-documents" class="formulaire-prime mt-5">
  <h3>5. Documents justificatifs</h3>

  <p class="mb-3">Joignez les documents nécessaires à l’analyse de votre demande. Les formats acceptés sont PDF, JPG ou PNG.</p>

  <!-- Devis -->
  <label for="upload-factures">📎 Devis des travaux *</label>
  <input type="file" id="upload-devis" name="document_devis" accept=".pdf,.jpg,.jpeg,.png" multiple required>

  <!-- Factures -->
  <label for="upload-factures">📎 Factures des travaux *</label>
  <input type="file" id="upload-factures" name="document_factures" accept=".pdf,.jpg,.jpeg,.png" multiple required>

  <!-- Etats d'avancement -->
  <label for="upload-avancement">📊 Etats d'avancement (si disponible)</label>
  <input type="file" id="upload-avancement" name="document_avancement" accept=".pdf,.jpg,.jpeg,.png">

  <!-- Attestations entrepreneur -->
  <label for="upload-attestations">🧑‍🔧 Attestations des entrepreneurs</label>
  <input type="file" id="upload-attestations" name="document_attestations" accept=".pdf,.jpg,.jpeg,.png" multiple>

  <!-- PEB -->
  <label for="upload-peb">📊 Certificat PEB (si disponible)</label>
  <input type="file" id="upload-peb" name="document_peb" accept=".pdf,.jpg,.jpeg,.png">

  <!-- photo -->
  <label for="upload-photo">📊 Photos</label>
  <input type="file" id="upload-photo" name="document_photo" accept=".pdf,.jpg,.jpeg,.png">

  <!-- label -->
  <label for="upload-label">📊 label européen</label>
  <input type="file" id="upload-label" name="document_label" accept=".pdf,.jpg,.jpeg,.png">

  <!-- conformité -->
  <label for="upload-conformité">📊 Attestations de conformité</label>
  <input type="file" id="upload-conformité" name="document_conformité" accept=".pdf,.jpg,.jpeg,.png">

  <!-- plans -->
  <label for="upload-plans">📊 Plans</label>
  <input type="file" id="upload-plans" name="document_plans" accept=".pdf,.jpg,.jpeg,.png">

  <!-- permis -->
  <label for="upload-permis">📊 Permis</label>
  <input type="file" id="upload-permis" name="document_permis" accept=".pdf,.jpg,.jpeg,.png">

  <!-- Autres documents -->
  <label for="upload-autres">📂 Autres documents utiles</label>
  <input type="file" id="upload-autres" name="document_autres" accept=".pdf,.jpg,.jpeg,.png" multiple>

  </section>

  <!-- Étape 6 : Soumission du formulaire -->
  <div class="card mb-4">
    <div class="card-body">
      <h3 class="card-title text-primary-custom">
        <i class="bi bi-send me-2"></i>6. Soumission de la demande
      </h3>

      <!-- Récapitulatif -->
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Vérification finale</strong>
        <p class="mb-0">Vous êtes sur le point de soumettre votre demande de primes. Veuillez vérifier que toutes les informations sont correctes et que les documents justificatifs ont bien été joints.</p>
      </div>

      <!-- Confirmation utilisateur -->
      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="confirmation-veracite" name="confirmation_veracite" required>
        <label class="form-check-label fw-bold" for="confirmation-veracite">
          Je confirme que les informations fournies sont exactes et complètes à ma connaissance.
        </label>
      </div>

      <!-- Email de contact -->
      <div class="mb-3">
        <label for="email-contact" class="form-label">
          <i class="bi bi-envelope me-2"></i>Adresse email pour le suivi de la demande *
        </label>
        <input type="email" id="email-contact" name="email_contact" class="form-control" placeholder="Ex : nom@email.com" required>
      </div>

      <!-- Envoi -->
      <div class="d-flex flex-column flex-md-row gap-3">
        <a href="https://authenticatie.vlaanderen.be/stb/html/ssologin" target="_blank" class="btn btn-primary btn-lg">
          <i class="bi bi-send me-2"></i>Soumettre la demande
        </a>
        <button type="button" class="btn btn-outline-secondary btn-lg" onclick="telechargerResume()">
          <i class="bi bi-download me-2"></i>Télécharger le résumé PDF
        </button>
      </div>

      <!-- Message de validation -->
      <div id="message-soumission" class="mt-3 fw-bold text-success"></div>
    </div>
  </div>

  <!-- Liens de navigation -->
  <div class="d-flex justify-content-center gap-3 mt-4">
    <a href="#" class="btn btn-outline-primary">
      <i class="bi bi-graph-up me-2"></i>Suivez l'avancement de vos primes
    </a>
    <a href="#" class="btn btn-outline-success">
      <i class="bi bi-house me-2"></i>Retour au menu principal
    </a>
  </div>

</div>
