<!-- Formulaire spécifique pour la Flandre -->
<div class="container" style="max-width: 80%;">
  <div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Formulaire pour la Région Flandre</strong>
    <p class="mb-0 small">Primes disponibles : Primes régionales flamandes (énergie + rénovation)</p>
  </div>

  <div class="flandre-specific-fields">

  <!-- SECTION 0 – Conditions préalables -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Conditions préalables</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-warning">
        <i class="bi bi-info-circle me-2"></i>
        Le dépôt de votre demande ne peut se faire que si vous êtes domicilié dans votre bien après travaux
      </div>
      <div class="form-check">
        <%= form.check_box :domicile, { class: "form-check-input", required: true }, "domicile", "" %>
        <%= form.label :domicile, "Je confirme être domicilié dans mon bien après travaux", class: "form-check-label fw-bold" %>
      </div>
    </div>
  </div>

  <!-- SECTION 1 – Identification du demandeur -->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0">
        <i class="bi bi-person-circle me-2"></i>Identification du demandeur
        <% if @form_data.present? %>
          <%= indicateur_section_complete(@form_data, [:nom, :prenom, :email, :telephone, :registre_national]) %>
        <% end %>
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :profil_demandeur, "Profil du demandeur *", class: "form-label" %>
            <div class="form-control-plaintext fw-bold text-primary">
              <%= @property&.profil_demandeur&.humanize || "Non défini" %>
            </div>
            <%= form.hidden_field :profil_demandeur, value: @property&.profil_demandeur %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :registre_national, class: "form-label" do %>
              Numéro de registre national ou BCE *
              <%= badge_prerempli(@form_data, :registre_national) if @form_data.present? %>
            <% end %>
            <%= form.text_field :registre_national,
                value: preremplir_champ(@form_data, :registre_national, current_user.national_number),
                class: "form-control",
                placeholder: "XX.XX.XX-XXX.XX ou BE0123456789",
                required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :nom, class: "form-label" do %>
              Nom du demandeur *
              <%= badge_prerempli(@form_data, :nom) if @form_data.present? %>
            <% end %>
            <%= form.text_field :nom,
                value: preremplir_champ(@form_data, :nom, current_user.last_name),
                class: "form-control",
                placeholder: "Nom complet",
                required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :prenom, class: "form-label" do %>
              Prénom du demandeur *
              <%= badge_prerempli(@form_data, :prenom) if @form_data.present? %>
            <% end %>
            <%= form.text_field :prenom,
                value: preremplir_champ(@form_data, :prenom, current_user.first_name),
                class: "form-control",
                placeholder: "Prénom",
                required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :telephone, class: "form-label" do %>
              Téléphone *
              <%= badge_prerempli(@form_data, :telephone) if @form_data.present? %>
            <% end %>
            <%= form.telephone_field :telephone,
                value: preremplir_champ(@form_data, :telephone, current_user.phone),
                class: "form-control",
                placeholder: "0x/xxx.xx.xx",
                required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :email, class: "form-label" do %>
              Adresse email *
              <%= badge_prerempli(@form_data, :email) if @form_data.present? %>
            <% end %>
            <%= form.email_field :email,
                value: preremplir_champ(@form_data, :email, current_user.email),
                class: "form-control",
                placeholder: "nom@email.com",
                required: true %>
          </div>
        </div>
      </div>
    </div>
  </div>  <!-- SECTION 2 – Données du logement -->
  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0">
        <i class="bi bi-house-door me-2"></i>Données du logement concerné
        <% if @form_data.present? && @property.present? %>
          <%= indicateur_section_complete(@form_data, [:adresse, :code_postal, :commune, :type_bien, :usage]) %>
        <% end %>
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :ean, class: "form-label" do %>
              Code EAN (optionnel)
              <%= badge_prerempli(@form_data, :ean) if @form_data.present? %>
            <% end %>
            <%= form.text_field :ean,
                value: preremplir_champ(@form_data, :ean),
                class: "form-control",
                placeholder: "Ex: 54144..." %>
            <div class="form-text">Code EAN de votre compteur électrique</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :parcelle, class: "form-label" do %>
              Numéro de parcelle (optionnel)
              <%= badge_prerempli(@form_data, :parcelle) if @form_data.present? %>
            <% end %>
            <%= form.text_field :parcelle,
                value: preremplir_champ(@form_data, :parcelle),
                class: "form-control",
                placeholder: "Ex: 12345/02A" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="mb-3">
            <%= form.label :adresse, class: "form-label" do %>
              Adresse du logement *
              <%= badge_prerempli(@form_data, :adresse) if @form_data.present? %>
            <% end %>
            <%= form.text_field :adresse,
                value: preremplir_champ(@form_data, :adresse),
                class: "form-control",
                placeholder: "Rue, numéro",
                required: true %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :code_postal, class: "form-label" do %>
              Code postal *
              <%= badge_prerempli(@form_data, :code_postal) if @form_data.present? %>
            <% end %>
            <%= form.text_field :code_postal,
                value: preremplir_champ(@form_data, :code_postal),
                class: "form-control",
                placeholder: "Ex: 1000",
                required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :commune, class: "form-label" do %>
              Commune *
              <%= badge_prerempli(@form_data, :commune) if @form_data.present? %>
            <% end %>
            <%= form.text_field :commune,
                value: preremplir_champ(@form_data, :commune),
                class: "form-control",
                placeholder: "Nom de la commune",
                required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :type_bien, class: "form-label" do %>
              Type de bien *
              <%= badge_prerempli(@form_data, :type_bien) if @form_data.present? %>
            <% end %>
            <%= form.select :type_bien,
                [
                  ["Maison unifamiliale", "maison"],
                  ["Appartement", "appartement"],
                  ["Immeuble avec plusieurs unités", "immeuble"]
                ],
                {
                  prompt: "-- Sélectionnez --",
                  selected: preremplir_champ(@form_data, :type_bien)
                },
                { class: "form-select", required: true } %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :usage, class: "form-label" do %>
              Usage du bien *
              <%= badge_prerempli(@form_data, :usage) if @form_data.present? %>
            <% end %>
            <%= form.select :usage,
                [
                  ["Résidence principale", "residence_principale"],
                  ["Bien en location", "location"],
                  ["Autre", "autre"]
                ],
                {
                  prompt: "-- Sélectionnez --",
                  selected: preremplir_champ(@form_data, :usage)
                },
                { class: "form-select", required: true } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :chauffage_post_renovation, class: "form-label" do %>
              Système de chauffage après rénovation *
              <%= badge_prerempli(@form_data, :chauffage_post_renovation) if @form_data.present? %>
            <% end %>
            <%= form.select :chauffage_post_renovation,
                [
                  ["Chauffage central au gaz (condensation)", "gaz"],
                  ["Chauffage au mazout", "mazout"],
                  ["Chauffage électrique direct", "electrique"],
                  ["Pompe à chaleur air/eau", "pac-air-eau"],
                  ["Pompe à chaleur géothermique", "pac-geothermique"],
                  ["Réseau de chaleur", "reseau-chaleur"],
                  ["Poêle / insert bois / biomasse", "bois"],
                  ["Autre (à spécifier)", "autre"],
                  ["Je ne sais pas", "ne_sais_pas"]
                ],
                {
                  prompt: "-- Sélectionnez --",
                  selected: preremplir_champ(@form_data, :chauffage_post_renovation)
                },
                { class: "form-select", required: true } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 3 – Travaux à déclarer -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Travaux à déclarer</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Sélectionnez les travaux envisagés. Les détails spécifiques pourront être complétés ultérieurement.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-primary mb-3">
                <i class="bi bi-house-up me-2"></i>Travaux d'isolation
              </h6>

              <!-- Isolation toiture -->
              <div class="form-check mb-3">
                <%= form.check_box :travaux_toiture,
                                   { class: "form-check-input", checked: (defined?(form_data) && form_data ? form_data[:travaux_toiture] : false) },
                                   "true", "" %>
                <%= form.label :travaux_toiture, "Isolation de la toiture", class: "form-check-label fw-semibold" %>
              </div>
              <div class="travaux-details ms-4 mb-4">
                <div class="row g-2">
                  <div class="col-md-6">
                    <%= form.label :surface_toiture, "Surface (m²)", class: "form-label" %>
                    <%= form.number_field :surface_toiture,
                                         class: "form-control",
                                         min: 0, step: 1 %>
                  </div>
                  <div class="col-md-6">
                    <%= form.label :type_toiture, "Méthode", class: "form-label" %>
                    <%= form.select :type_toiture,
                                   options_for_select([
                                     ['-- Sélectionnez --', ''],
                                     ['Par l\'intérieur', 'interieur'],
                                     ['Par l\'extérieur', 'exterieur']
                                   ]),
                                   {},
                                   { class: "form-select" } %>
                  </div>
                </div>
              </div>

              <!-- Isolation murs extérieurs -->
              <div class="form-check mb-3">
                <%= form.check_box :travaux_murs,
                                   { class: "form-check-input", checked: (defined?(form_data) && form_data ? form_data[:travaux_murs] : false) },
                                   "true", "" %>
                <%= form.label :travaux_murs, "Isolation des murs extérieurs", class: "form-check-label fw-semibold" %>
              </div>
              <div class="travaux-details ms-4 mb-4">
                <div class="row g-2">
                  <div class="col-md-6">
                    <%= form.label :surface_murs, "Surface (m²)", class: "form-label" %>
                    <%= form.number_field :surface_murs,
                                         class: "form-control",
                                         min: 0, step: 1 %>
                  </div>
                  <div class="col-md-6">
                    <%= form.label :type_murs, "Méthode", class: "form-label" %>
                    <%= form.select :type_murs,
                                   options_for_select([
                                     ['-- Sélectionnez --', ''],
                                     ['Murs creux', 'creux'],
                                     ['Par l\'intérieur', 'interieur'],
                                     ['Par l\'extérieur', 'exterieur']
                                   ]),
                                   {},
                                   { class: "form-select" } %>
                  </div>
                </div>
              </div>

              <!-- Isolation du sol -->
              <div class="form-check mb-3">
                <%= form.check_box :travaux_sol,
                                   { class: "form-check-input", checked: (defined?(form_data) && form_data ? form_data[:travaux_sol] : false) },
                                   "true", "" %>
                <%= form.label :travaux_sol, "Isolation du sol ou des caves", class: "form-check-label fw-semibold" %>
              </div>
              <div class="travaux-details ms-4 mb-4">
                <div class="row g-2">
                  <div class="col-md-6">
                    <%= form.label :surface_sol, "Surface (m²)", class: "form-label" %>
                    <%= form.number_field :surface_sol,
                                         class: "form-control",
                                         min: 0, step: 1 %>
                  </div>
                </div>
              </div>

              <!-- Vitrage -->
              <div class="form-check mb-3">
                <%= form.check_box :travaux_vitrage,
                                   { class: "form-check-input", checked: (defined?(form_data) && form_data ? form_data[:travaux_vitrage] : false) },
                                   "true", "" %>
                <%= form.label :travaux_vitrage, "Remplacement du vitrage", class: "form-check-label fw-semibold" %>
              </div>
              <div class="travaux-details ms-4 mb-4">
                <div class="row g-2">
                  <div class="col-md-6">
                    <%= form.label :surface_vitrage, "Surface (m²)", class: "form-label" %>
                    <%= form.number_field :surface_vitrage,
                                         class: "form-control",
                                         min: 0, step: 1 %>
                  </div>
                </div>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_amiante, { class: "form-check-input" }, "amiante", "" %>
                <%= form.label :travaux_amiante, "Travaux de désamiantage (toiture et/ou murs)", class: "form-check-label" %>
              </div>

            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-success mb-3">
                <i class="bi bi-lightning-charge me-2"></i>Systèmes énergétiques
              </h6>

              <div class="form-check mb-3">
                <%= form.check_box :travaux_chauffage,
                                   { class: "form-check-input", checked: (defined?(form_data) && form_data ? form_data[:travaux_chauffage] : false) },
                                   "true", "" %>
                <%= form.label :travaux_chauffage, "Installation d'une pompe à chaleur et chauffe-eau thermodynamique", class: "form-check-label fw-semibold" %>
              </div>
              <div class="travaux-details ms-4 mb-4">
                <div class="row g-2">
                  <div class="col-md-6">
                    <%= form.label :type_chauffage, "Type de système", class: "form-label" %>
                    <%= form.select :type_chauffage,
                                   options_for_select([
                                     ['-- Sélectionnez --', ''],
                                     ['Pompe à chaleur géothermique', 'pac-geothermique'],
                                     ['Pompe à chaleur air/eau', 'pac-air-eau'],
                                     ['Pompe à chaleur air/air', 'pac-air-air'],
                                     ['Pompe à chaleur hybride', 'hybride'],
                                     ['Boiler thermodynamique', 'boiler']
                                   ]),
                                   {},
                                   { class: "form-select" } %>
                  </div>
                </div>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_complementaires, { class: "form-check-input" }, "complementaires", "" %>
                <%= form.label :travaux_complementaires, "Travaux complémentaires", class: "form-check-label" %>
              </div>

              <div class="form-check mb-2">
                <%= form.check_box :travaux_ventilation, { class: "form-check-input" }, "ventilation", "" %>
                <%= form.label :travaux_ventilation, "Système de ventilation", class: "form-check-label" %>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 4 – Revenus et composition du ménage -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><i class="bi bi-currency-euro me-2"></i>Revenus et composition du ménage</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Ces informations sont nécessaires pour déterminer le montant de la prime éligible.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :revenus_annuels, "Revenus annuels imposables (ménage complet) *", class: "form-label" %>
            <%= form.number_field :revenus_annuels, class: "form-control", min: 0, step: 100, placeholder: "Ex : 42 000", required: true %>
            <div class="form-text">Montant total des revenus imposables du ménage</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :personnes_charge, "Nombre de personnes à charge *", class: "form-label" %>
            <%= form.number_field :personnes_charge, class: "form-control", min: 0, max: 10, value: 0, required: true %>
            <div class="form-text">Nombre de personnes à charge fiscalement</div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :annee_aer, "Année de l'avertissement extrait de rôle utilisé *", class: "form-label" %>
            <%= form.select :annee_aer,
                [
                  ["2023 (revenus 2022)", "2023"],
                  ["2022 (revenus 2021)", "2022"],
                  ["2021 (revenus 2020)", "2021"]
                ],
                { prompt: "-- Sélectionnez une année --" },
                { class: "form-select", required: true } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :compte_bancaire, "Compte bancaire (IBAN)", class: "form-label" %>
            <%= form.text_field :compte_bancaire, class: "form-control", placeholder: "BE XX XXXX XXXX XXXX" %>
            <div class="form-text">Compte pour le versement de la prime</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 5 – Documents justificatifs -->
  <div class="card mb-4">
    <div class="card-header bg-secondary text-white">
      <h5 class="mb-0"><i class="bi bi-paperclip me-2"></i>Documents justificatifs</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Joignez les documents nécessaires à l'analyse de votre demande.
        <strong>Formats acceptés :</strong> PDF, JPG, PNG (max 10MB par fichier)
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-danger">
                <i class="bi bi-exclamation-triangle me-2"></i>Documents obligatoires
              </h6>

              <div class="mb-3">
                <%= form.label :document_devis, "📎 Devis des travaux *", class: "form-label fw-bold" %>
                <%= form.file_field :document_devis, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true, required: true %>
              </div>

              <div class="mb-3">
                <%= form.label :document_factures, "📎 Factures des travaux *", class: "form-label fw-bold" %>
                <%= form.file_field :document_factures, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true, required: true %>
              </div>

              <div class="mb-3">
                <%= form.label :document_aer, "📊 Avertissement extrait de rôle *", class: "form-label fw-bold" %>
                <%= form.file_field :document_aer, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", required: true %>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-success">
                <i class="bi bi-plus-circle me-2"></i>Documents complémentaires
              </h6>

              <div class="mb-3">
                <%= form.label :document_peb, "📊 Certificat PEB", class: "form-label" %>
                <%= form.file_field :document_peb, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png" %>
              </div>

              <div class="mb-3">
                <%= form.label :document_attestations, "🧑‍🔧 Attestations entrepreneurs", class: "form-label" %>
                <%= form.file_field :document_attestations, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true %>
              </div>

              <div class="mb-3">
                <%= form.label :document_photos, "📸 Photos des travaux", class: "form-label" %>
                <%= form.file_field :document_photos, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true %>
              </div>

              <div class="mb-3">
                <%= form.label :document_autres, "📂 Autres documents", class: "form-label" %>
                <%= form.file_field :document_autres, class: "form-control", accept: ".pdf,.jpg,.jpeg,.png", multiple: true %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>



  <!-- SECTION 6 – Soumission de la demande -->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>Soumission de la demande</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-success">
        <i class="bi bi-info-circle me-2"></i>
        Vous êtes sur le point de soumettre votre demande de primes.
        Veuillez vérifier que toutes les informations sont correctes et que les documents obligatoires ont été joints.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :email_contact, "📧 Email pour le suivi de la demande *", class: "form-label" %>
