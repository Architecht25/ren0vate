<!-- Formulaire spécifique pour la Flandre -->
<div class="request-form-container">
  <div class="flandre-specific-fields">

  <!-- SECTION 1 – Identification du demandeur -->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0">
        <i class="bi bi-person-circle me-2"></i>Identification du demandeur
        <% if @form_data.present? %>
          <%= indicateur_section_complete(@form_data, [:nom, :prenom, :email, :telephone, :registre_national]) %>
        <% end %>
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :profil_demandeur, "Profil du demandeur *", class: "form-label" %>
            <div class="form-control-plaintext fw-bold text-primary">
              <%= @property&.profil_demandeur&.humanize || "Non défini" %>
            </div>
            <%= form.hidden_field :profil_demandeur, value: @property&.profil_demandeur %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :registre_national, class: "form-label" do %>
              Numéro de registre national ou BCE *
              <%= badge_prerempli_avec_fallback(@form_data, :registre_national, current_user.national_number) if @form_data.present? %>
            <% end %>
            <%= form.text_field :registre_national,
                value: preremplir_champ(@form_data, :registre_national, current_user.national_number),
                class: "form-control",
                placeholder: "XX.XX.XX-XXX.XX ou BE0123456789",
                required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :nom, class: "form-label" do %>
              Nom du demandeur *
              <%= badge_prerempli_avec_fallback(@form_data, :nom, current_user.last_name) if @form_data.present? %>
            <% end %>
            <%= form.text_field :nom,
                value: preremplir_champ(@form_data, :nom, current_user.last_name),
                class: "form-control",
                placeholder: "Nom complet",
                required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :prenom, class: "form-label" do %>
              Prénom du demandeur *
              <%= badge_prerempli_avec_fallback(@form_data, :prenom, current_user.first_name) if @form_data.present? %>
            <% end %>
            <%= form.text_field :prenom,
                value: preremplir_champ(@form_data, :prenom, current_user.first_name),
                class: "form-control",
                placeholder: "Prénom",
                required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :telephone, class: "form-label" do %>
              Téléphone *
              <%= badge_prerempli_avec_fallback(@form_data, :telephone, current_user.phone) if @form_data.present? %>
            <% end %>
            <%= form.telephone_field :telephone,
                value: preremplir_champ(@form_data, :telephone, current_user.phone),
                class: "form-control",
                placeholder: "0x/xxx.xx.xx",
                required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :email, class: "form-label" do %>
              Adresse email *
              <%= badge_prerempli_avec_fallback(@form_data, :email, current_user.email) if @form_data.present? %>
            <% end %>
            <%= form.email_field :email,
                value: preremplir_champ(@form_data, :email, current_user.email),
                class: "form-control",
                placeholder: "nom@email.com",
                required: true %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 2 – Données du logement -->
  <div class="card mb-4">
    <div class="card-header bg-info text-white">
      <h5 class="mb-0">
        <i class="bi bi-house-door me-2"></i>Données du logement concerné
        <% if @form_data.present? && @property.present? %>
          <%= indicateur_section_complete(@form_data, [:adresse, :code_postal, :commune, :type_bien, :usage]) %>
        <% end %>
      </h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :ean, class: "form-label" do %>
              Code EAN (optionnel)
              <%= badge_prerempli_avec_fallback(@form_data, :ean, @property&.ean_flandre || @property&.numero_ean) if @form_data.present? %>
            <% end %>
            <%= form.text_field :ean,
                value: preremplir_champ(@form_data, :ean, @property&.ean_flandre || @property&.numero_ean),
                class: "form-control",
                placeholder: "Ex: 54144..." %>
            <div class="form-text">Code EAN de votre compteur électrique</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :parcelle, class: "form-label" do %>
              Numéro de parcelle (optionnel)
              <%= badge_prerempli_avec_fallback(@form_data, :parcelle, @property&.parcelle_flandre || @property&.numero_cadastre) if @form_data.present? %>
            <% end %>
            <%= form.text_field :parcelle,
                value: preremplir_champ(@form_data, :parcelle, @property&.parcelle_flandre || @property&.numero_cadastre),
                class: "form-control",
                placeholder: "Ex: 12345/02A" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :adresse, class: "form-label" do %>
              Adresse du logement *
              <%= badge_prerempli_avec_fallback(@form_data, :adresse, @property&.adresse) if @form_data.present? %>
            <% end %>
            <%= form.text_field :adresse,
                value: preremplir_champ(@form_data, :adresse, @property&.adresse),
                class: "form-control",
                placeholder: "Rue, numéro",
                required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :code_postal, class: "form-label" do %>
              Code postal *
              <%= badge_prerempli_avec_fallback(@form_data, :code_postal, @property&.code_postal) if @form_data.present? %>
            <% end %>
            <%= form.text_field :code_postal,
                value: preremplir_champ(@form_data, :code_postal, @property&.code_postal),
                class: "form-control",
                placeholder: "Ex: 1000",
                required: true %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :commune, class: "form-label" do %>
              Commune *
              <%= badge_prerempli_avec_fallback(@form_data, :commune, @property&.commune) if @form_data.present? %>
            <% end %>
            <%= form.text_field :commune,
                value: preremplir_champ(@form_data, :commune, @property&.commune),
                class: "form-control",
                placeholder: "Nom de la commune",
                required: true %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :type_bien, class: "form-label" do %>
              Type de bien *
              <%= badge_prerempli(@form_data, :type_bien) if @form_data.present? %>
            <% end %>
            <%= form.select :type_bien,
                [
                  ["Maison unifamiliale", "maison"],
                  ["Appartement", "appartement"],
                  ["Immeuble avec plusieurs unités", "immeuble"]
                ],
                {
                  prompt: "-- Sélectionnez --",
                  selected: preremplir_champ(@form_data, :type_bien)
                },
                { class: "form-select", required: true } %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :usage, class: "form-label" do %>
              Usage du bien *
              <%= badge_prerempli(@form_data, :usage) if @form_data.present? %>
            <% end %>
            <%= form.select :usage,
                [
                  ["Résidence principale", "residence_principale"],
                  ["Bien en location", "location"],
                  ["Autre", "autre"]
                ],
                {
                  prompt: "-- Sélectionnez --",
                  selected: preremplir_champ(@form_data, :usage)
                },
                { class: "form-select", required: true } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :chauffage_post_renovation, class: "form-label" do %>
              Système de chauffage après rénovation *
              <%= badge_prerempli(@form_data, :chauffage_post_renovation) if @form_data.present? %>
            <% end %>
            <%= form.select :chauffage_post_renovation,
                [
                  ["Chauffage central au gaz (condensation)", "gaz"],
                  ["Chauffage au mazout", "mazout"],
                  ["Chauffage électrique direct", "electrique"],
                  ["Pompe à chaleur air/eau", "pac-air-eau"],
                  ["Pompe à chaleur géothermique", "pac-geothermique"],
                  ["Réseau de chaleur", "reseau-chaleur"],
                  ["Poêle / insert bois / biomasse", "bois"],
                  ["Autre (à spécifier)", "autre"],
                  ["Je ne sais pas", "ne_sais_pas"]
                ],
                {
                  prompt: "-- Sélectionnez --",
                  selected: preremplir_champ(@form_data, :chauffage_post_renovation)
                },
                { class: "form-select", required: true } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 3 – Revenus et composition du ménage -->
  <div class="card mb-4">
    <div class="card-header bg-warning text-dark">
      <h5 class="mb-0"><i class="bi bi-currency-euro me-2"></i>Revenus et composition du ménage</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Ces informations sont nécessaires pour déterminer le montant de la prime éligible.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :revenus_annuels, class: "form-label" do %>
              Revenus annuels imposables (ménage complet) *
              <%= badge_prerempli_avec_fallback(@form_data, :revenus_annuels, current_user.household_income) if @form_data.present? %>
            <% end %>
            <%= form.number_field :revenus_annuels,
                value: preremplir_champ(@form_data, :revenus_annuels, current_user.household_income),
                class: "form-control",
                style: "border: 2px solid #dc3545;",
                min: 0,
                step: 100,
                placeholder: "Ex : 42 000",
                required: true %>
            <div class="form-text">Montant total des revenus imposables du ménage</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :personnes_charge, class: "form-label" do %>
              Nombre de personnes à charge *
              <%= badge_prerempli_avec_fallback(@form_data, :personnes_charge, current_user.nombre_enfants) if @form_data.present? %>
            <% end %>
            <%
              # Calculer la valeur des personnes à charge avec debug détaillé
              form_data_value = @form_data&.dig(:personnes_charge)
              user_enfants_value = current_user.nombre_enfants
              # Si en production et pas de valeur définie, utiliser 2 comme valeur de test
              fallback_value = Rails.env.production? && user_enfants_value.nil? ? 2 : 0

              # Ignore les valeurs "0" ou vides dans form_data, utilise les données utilisateur
              if form_data_value.present? && form_data_value != "0" && form_data_value != 0
                personnes_charge_value = form_data_value
              else
                personnes_charge_value = user_enfants_value || fallback_value
              end

              # Debug détaillé pour production
              Rails.logger.info "🔍 DEBUG PERSONNES_CHARGE DÉTAILLÉ:"
              Rails.logger.info "  - @form_data present: #{@form_data.present?}"
              Rails.logger.info "  - @form_data[:personnes_charge]: #{form_data_value.inspect}"
              Rails.logger.info "  - current_user.nombre_enfants: #{user_enfants_value.inspect}"
              Rails.logger.info "  - current_user.id: #{current_user.id}"
              Rails.logger.info "  - valeur_finale_calculée: #{personnes_charge_value.inspect}"
            %>
            <%= form.number_field :personnes_charge,
                value: personnes_charge_value,
                class: "form-control",
                style: "border: 2px solid #dc3545;",
                min: 0,
                max: 10,
                required: true %>
            <div class="form-text">Nombre de personnes à charge fiscalement</div>
            <script>
              console.log("🔍 DEBUG PERSONNES_CHARGE CLIENT:", {
                value_calculated: "<%= personnes_charge_value %>",
                form_data_present: <%= @form_data.present? %>,
                form_data_value: <%= (@form_data&.dig(:personnes_charge) || 'null').to_json.html_safe %>,
                user_enfants: <%= (current_user.nombre_enfants || 'null').to_json.html_safe %>,
                user_id: <%= current_user.id %>,
                rails_env: "<%= Rails.env %>",
                input_value: document.getElementById('request_form_data_personnes_charge') ? document.getElementById('request_form_data_personnes_charge').value : 'input_not_found'
              });
            </script>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :annee_aer, class: "form-label" do %>
              Année de l'avertissement extrait de rôle utilisé *
              <%= badge_prerempli_avec_fallback(@form_data, :annee_aer, current_user.annee_revenus_demandeur) if @form_data.present? %>
            <% end %>
            <%= form.select :annee_aer,
                [
                  ["2023 (revenus 2022)", "2023"],
                  ["2022 (revenus 2021)", "2022"],
                  ["2021 (revenus 2020)", "2021"]
                ],
                {
                  prompt: "-- Sélectionnez une année --",
                  selected: preremplir_champ(@form_data, :annee_aer, current_user.annee_revenus_demandeur)
                },
                { class: "form-select", style: "border: 2px solid #dc3545;", required: true } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :compte_bancaire, class: "form-label" do %>
              Compte bancaire (IBAN)
              <%= badge_prerempli_avec_fallback(@form_data, :compte_bancaire, current_user.iban) if @form_data.present? %>
            <% end %>
            <%= form.text_field :compte_bancaire,
                value: preremplir_champ(@form_data, :compte_bancaire, current_user.iban),
                class: "form-control",
                style: "border: 2px solid #dc3545;",
                placeholder: "BE XX XXXX XXXX XXXX" %>
            <div class="form-text">Compte pour le versement de la prime</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 4 – Travaux à déclarer -->
  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Travaux à déclarer</h5>
    </div>
    <div class="card-body">
      <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Sélectionnez les travaux envisagés. Les détails spécifiques pourront être complétés ultérieurement.
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card border-0 bg-light mb-3">
            <div class="card-body">
              <h6 class="card-title text-primary mb-3">
                <i class="bi bi-house-up me-2"></i>Travaux d'isolation
              </h6>

              <!-- Isolation toiture -->
              <div class="form-check mb-3">
                <%= form.check_box :travaux_toiture,
                                   { class: "form-check-input", checked: (@form_data&.dig('travaux_toiture') == true || @form_data&.dig('travaux_toiture') == 'true') },
                                   "true", "" %>
                <%= form.label :travaux_toiture, "Isolation de la toiture", class: "form-check-label fw-semibold" %>
              </div>
              <div class="travaux-details ms-4 mb-4 <%= 'd-none' unless (@form_data&.dig('travaux_toiture') == true || @form_data&.dig('travaux_toiture') == 'true') %>">
                <div class="row g-2">
                  <div class="col-md-4">
                    <%= form.label :surface_toiture, "Surface (m²)", class: "form-label" %>
                    <%= form.number_field :surface_toiture,
                                         value: @form_data&.dig('surface_toiture'),
                                         class: "form-control",
                                         min: 0, step: 1 %>
                  </div>
                  <div class="col-md-4">
                    <%= form.label :methode_toiture, "Méthode", class: "form-label" %>
                    <%= form.select :methode_toiture,
                                   [
                                     ['-- Sélectionnez --', ''],
                                     ['Par l\'intérieur', 'interieur'],
                                     ['Par l\'extérieur', 'exterieur']
                                   ],
                                   { selected: @form_data&.dig('methode_toiture') },
                                   { class: "form-select" } %>
                  </div>
                  <div class="col-md-4">
                    <%= form.label :date_placement_toiture, "Date de placement", class: "form-label" %>
                    <%= form.date_field :date_placement_toiture,
                                       value: @form_data&.dig('date_placement_toiture'),
                                       class: "form-control" %>
                  </div>
                  <div class="col-md-6">
                    <%= form.label :materiau_toiture, "Matériau d'isolation", class: "form-label" %>
                    <%= form.select :materiau_toiture,
                                   options_for_select([
                                     ['-- Sélectionnez --', ''],
                                     ['Bio-écologique matériaal', 'bio_ecologique'],
                                     ['Minerale wol', 'minerale_wol'],
                                     ['PIR/PUR (polyuréthaan)', 'pir_pur'],
                                     ['Andere', 'andere']
                                   ], @form_data&.dig('materiau_toiture')),
                                   {},
                                   { class: "form-select" } %>
                  </div>
                  <div class="col-md-6">
                    <%= form.label :marque_toiture, "Marque isolation", class: "form-label" %>
                    <%= form.text_field :marque_toiture,
                                       value: @form_data&.dig('marque_toiture'),
                                       class: "form-control",
                                       maxlength: 60,
                                       placeholder: "Max 60 caractères" %>
                  </div>
                  <div class="col-12">
                    <%= form.label :type_isolation_toiture, "Type isolation", class: "form-label" %>
                    <%= form.text_field :type_isolation_toiture,
                                       value: @form_data&.dig('type_isolation_toiture'),
                                       class: "form-control",
                                       maxlength: 60,
                                       placeholder: "Max 60 caractères" %>
                  </div>
                </div>
              </div>

              <!-- Isolation murs extérieurs -->
              <div class="form-check mb-3">
                <%= form.check_box :travaux_murs,
                                   { class: "form-check-input", checked: (@form_data&.dig('travaux_murs') == true || @form_data&.dig('travaux_murs') == 'true') },
                                   "true", "" %>
                <%= form.label :travaux_murs, "Isolation des murs extérieurs", class: "form-check-label fw-semibold" %>
              </div>
              <div class="travaux-details ms-4 mb-4 <%= 'd-none' unless (@form_data&.dig('travaux_murs') == true || @form_data&.dig('travaux_murs') == 'true') %>">
                <div class="row g-2">
                  <div class="col-md-4">
                    <%= form.label :surface_murs, "Surface (m²)", class: "form-label" %>
                    <%= form.number_field :surface_murs,
                                         value: @form_data&.dig('surface_murs'),
                                         class: "form-control",
                                         min: 0, step: 1 %>
                  </div>
                  <div class="col-md-4">
                    <%= form.label :methode_murs, "Méthode", class: "form-label" %>
                    <%= form.select :methode_murs,
                                   [
                                     ['-- Sélectionnez --', ''],
                                     ['Murs creux', 'creux'],
                                     ['Par l\'intérieur', 'interieur'],
                                     ['Par l\'extérieur', 'exterieur']
                                   ],
                                   { selected: @form_data&.dig('methode_murs') },
                                   { class: "form-select" } %>
                  </div>
                  <div class="col-md-4">
                    <%= form.label :date_placement_murs, "Date de placement", class: "form-label" %>
                    <%= form.date_field :date_placement_murs,
                                       value: @form_data&.dig('date_placement_murs'),
                                       class: "form-control" %>
                  </div>
                  <div class="col-md-6">
                    <%= form.label :materiau_murs, "Matériau d'isolation", class: "form-label" %>
                    <%= form.select :materiau_murs,
                                   options_for_select([
                                     ['-- Sélectionnez --', ''],
                                     ['Bio-écologique matériaal', 'bio_ecologique'],
                                     ['Minerale wol', 'minerale_wol'],
                                     ['PIR/PUR (polyuréthaan)', 'pir_pur'],
                                     ['Andere', 'andere']
                                   ], @form_data&.dig('materiau_murs')),
                                   {},
                                   { class: "form-select" } %>
                  </div>
                  <div class="col-md-6">
                    <%= form.label :marque_murs, "Marque isolation", class: "form-label" %>
                    <%= form.text_field :marque_murs,
                                       value: @form_data&.dig('marque_murs'),
                                       class: "form-control",
                                       maxlength: 60,
                                       placeholder: "Max 60 caractères" %>
                  </div>
                  <div class="col-12">
                    <%= form.label :type_isolation_murs, "Type isolation", class: "form-label" %>
                    <%= form.text_field :type_isolation_murs,
                                       value: @form_data&.dig('type_isolation_murs'),
                                       class: "form-control",
                                       maxlength: 60,
                                       placeholder: "Max 60 caractères" %>
                </div>
                </div>
              </div>

              <!-- Isolation du sol -->
              <div class="form-check mb-3">
                <%= form.check_box :travaux_sol,
                                   { class: "form-check-input", checked: (@form_data&.dig('travaux_sol') == true || @form_data&.dig('travaux_sol') == 'true') },
                                   "true", "" %>
                <%= form.label :travaux_sol, "Isolation du sol ou des caves", class: "form-check-label fw-semibold" %>
              </div>
              <div class="travaux-details ms-4 mb-4 <%= 'd-none' unless (@form_data&.dig('travaux_sol') == true || @form_data&.dig('travaux_sol') == 'true') %>">
                <div class="row g-2">
                  <div class="col-md-4">
                    <%= form.label :surface_sol, "Surface (m²)", class: "form-label" %>
                    <%= form.number_field :surface_sol,
                                         value: @form_data&.dig('surface_sol'),
                                         class: "form-control",
                                         min: 0, step: 1 %>
                  </div>
                  <div class="col-md-4">
                    <%= form.label :date_placement_sol, "Date de placement", class: "form-label" %>
                    <%= form.date_field :date_placement_sol,
                                       value: @form_data&.dig('date_placement_sol'),
                                       class: "form-control" %>
                  </div>
                  <div class="col-md-4">
                    <%= form.label :materiau_sol, "Matériau d'isolation", class: "form-label" %>
                    <%= form.select :materiau_sol,
