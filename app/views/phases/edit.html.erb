<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: "Modifier la phase", subtitle: @phase.project.nom } do %><% end %>

  <div class="row">
    <div class="col-12 col-lg-6">
      <%= simple_form_for @phase do |f| %>
        <%= f.error_notification %>
        <%= f.input :name, label: "Nom de la phase" %>
        <%= f.input :key, label: "Clé technique (sans espace, ex: chantier)" %>
        <%= f.button :submit, "Enregistrer", class: "btn btn-primary-custom" %>
      <% end %>
    </div>
  </div>
</div>
