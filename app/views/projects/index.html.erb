<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Chantiers de Rénovation</h1>
    <%= link_to new_project_path, class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter un chantier
    <% end %>
  </div>

  <!-- Liste des chantiers -->
  <% if @projects.any? %>
    <div class="row g-3">
      <% @projects.each do |project| %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 bg-light-custom h-100 property-card position-relative">
            <!-- Menu actions trois points -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;">
              <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                  <li>
                    <%= link_to project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-eye me-2"></i>Voir
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-pencil me-2"></i>Modifier
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to project_path(project),
                        class: "dropdown-item text-danger",
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Êtes-vous sûr de vouloir supprimer le chantier '#{project.nom}' ?\n\nCette action supprimera définitivement :\n- Le chantier et ses informations\n- Tous les travaux associés\n- Les documents liés\n\nCette action est irréversible."
                        } do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

            <%= link_to project_path(project), class: "text-decoration-none" do %>
              <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                  <div class="icon-circle me-3">
                    <i class="bi bi-hammer"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h5 class="card-title text-dark mb-1 fw-normal"><%= project.nom %></h5>
                    <% if project.property.present? %>
                      <p class="text-muted-custom mb-0 small">
                        <i class="bi bi-house-door me-1"></i>
                        <%= project.property.respond_to?(:address) ? project.property.address : "#{project.property.rue} #{project.property.numero}" %>
                      </p>
                    <% else %>
                      <p class="text-muted-custom mb-0 small">Bien non associé</p>
                    <% end %>
                  </div>
                </div>
                <div class="mt-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span class="badge bg-primary-custom rounded-pill px-3 py-2">
                      <%= project.simulations.count %> simulations
                    </span>
                    <span class="text-muted-custom small">
                      <i class="bi bi-calendar-check me-1"></i>
                      <%= project.created_at.strftime("%d/%m/%Y") %>
                    </span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-hammer"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun chantier enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par ajouter votre premier chantier de rénovation</p>
      <%= link_to new_project_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Créer mon premier chantier
      <% end %>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
