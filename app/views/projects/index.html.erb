<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Projets</h1>
    <div class="d-flex gap-2">
      <%= link_to new_project_path(project_type: 'renovation'), class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-hammer me-2"></i>Ajouter un chantier de rénovation résidentiel
      <% end %>
      <%= link_to new_project_path(project_type: 'investment'), class: "btn btn-outline-primary-custom px-4" do %>
        <i class="bi bi-building me-2"></i>Ajouter un investissement en entreprise
      <% end %>
      <%= link_to properties_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Mes biens
      <% end %>
    </div>
  </div>

  <!-- Liste des chantiers -->
  <% if @projects.any? %>
    <%
      # Grouper les projets par région de leur propriété pour afficher les séparateurs
      grouped_projects = @projects.group_by { |p| p.property&.region&.downcase || 'autre' }
      region_order = ['flandre', 'bruxelles', 'wallonie', 'autre']
      region_names = {
        'flandre' => 'Flandre',
        'bruxelles' => 'Bruxelles',
        'wallonie' => 'Wallonie',
        'autre' => 'Autres régions'
      }
    %>

    <% region_order.each do |region_key| %>
      <% if grouped_projects[region_key]&.any? %>
        <!-- Séparateur de région -->
        <div class="row mb-3">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <h5 class="text-muted mb-0 me-3">
                <i class="bi bi-geo-alt me-2"></i><%= region_names[region_key] %>
              </h5>
              <hr class="flex-grow-1 my-0 text-muted">
              <span class="badge bg-light text-dark ms-3"><%= grouped_projects[region_key].count %> projet<%= 's' if grouped_projects[region_key].count > 1 %></span>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-5">
          <% grouped_projects[region_key].each do |project| %>
        <div class="col-xl-4 col-lg-6 col-md-12">
          <div class="card border-0 bg-light-custom h-100 property-card position-relative<%= ' property-card-entreprise' if project.property.is_entreprise? %>">
            <!-- Menu actions trois points -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index: 10;">
              <div class="dropdown dropup">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index: 1050;">
                  <li>
                    <%= link_to project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-eye me-2"></i>Voir
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-pencil me-2"></i>Modifier
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to project_path(project),
                        class: "dropdown-item text-danger",
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Êtes-vous sûr de vouloir supprimer le chantier '#{project.nom}' ?\n\nCette action supprimera définitivement :\n- Le chantier et ses informations\n- Tous les travaux associés\n- Les documents liés\n\nCette action est irréversible."
                        } do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

            <%= link_to project_path(project), class: "text-decoration-none" do %>
              <div class="row g-0 h-100">
                <!-- Image à gauche -->
                <div class="col-4 rounded-start"
                     style="min-height: 140px;
                            background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_300,h_140,q_auto,f_auto/istockphoto-1467348539-1024x1024_l8dpxl');
                            background-size: cover;
                            background-position: center;
                            background-repeat: no-repeat;
                            opacity: 0.8;">
                </div>

                <!-- Contenu à droite -->
                <div class="col-8">
                  <div class="card-body p-3 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                      <div class="icon-circle-small me-2">
                        <i class="bi bi-hammer"></i>
                      </div>
                      <div class="flex-grow-1">
                        <h6 class="card-title text-dark mb-1 fw-normal"><%= project.nom %></h6>
                        <% if project.property.present? %>
                          <p class="text-muted-custom mb-0 small">
                            <i class="bi bi-house-door me-1"></i>
                            <%= project.property.respond_to?(:address) ? project.property.address : "#{project.property.rue} #{project.property.numero}" %>
                          </p>
                        <% else %>
                          <p class="text-muted-custom mb-0 small">Bien non associé</p>
                        <% end %>
                      </div>
                    </div>

                    <div class="mt-auto">
                      <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary-custom rounded-pill px-2 py-1 small">
                          <%= project.simulations.count %> simulations
                        </span>
                        <span class="text-muted-custom small">
                          <i class="bi bi-calendar-check me-1"></i>
                          <%= project.created_at.strftime("%d/%m/%Y") %>
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-folder-plus"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun projet enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par créer votre premier projet</p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <%= link_to new_project_path(project_type: 'renovation'), class: "btn btn-primary-custom px-4" do %>
          <i class="bi bi-hammer me-2"></i>Créer un chantier de rénovation
        <% end %>
        <%= link_to new_project_path(project_type: 'investment'), class: "btn btn-outline-primary-custom px-4" do %>
          <i class="bi bi-building me-2"></i>Créer un investissement d'entreprise
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
