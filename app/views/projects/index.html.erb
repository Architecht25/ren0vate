<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Projets</h1>
    <div class="d-flex gap-2">
      <%= link_to new_project_path(project_type: 'renovation'), class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-hammer me-2"></i>Ajouter un chantier de rénovation résidentiel
      <% end %>
      <% if @property %>
        <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Dashboard bien
        <% end %>
      <% end %>
      <%= link_to properties_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Mes biens
      <% end %>
    </div>
  </div>

  <!-- Message d'information -->
  <div class="alert alert-info border-0 mb-4" style="background-color: #e8f4f8;">
    <div class="d-flex align-items-start">
      <i class="bi bi-info-circle me-3 mt-1" style="font-size: 1.2rem;"></i>
      <p class="mb-0">
        Pour suivre un chantier de rénovation, il est important de renseigner dans un premier temps les informations générales comme le timing, les coordonnées de l'architecte, des entrepreneurs, le budget chantier afin de commencer à visualiser les éléments de base.
      </p>
    </div>
  </div>

  <!-- Liste des chantiers -->
  <% if @projects.any? %>
    <%
      # Grouper les projets par région de leur propriété pour afficher les séparateurs
      grouped_projects = @projects.group_by { |p| p.property&.region&.downcase || 'autre' }
      region_order = ['flandre', 'bruxelles', 'wallonie', 'autre']
      region_names = {
        'flandre' => 'Flandre',
        'bruxelles' => 'Bruxelles',
        'wallonie' => 'Wallonie',
        'autre' => 'Autres régions'
      }
    %>

    <% region_order.each do |region_key| %>
      <% if grouped_projects[region_key]&.any? %>
        <!-- Séparateur de région -->
        <div class="row mb-3">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <h5 class="text-muted mb-0 me-3">
                <i class="bi bi-geo-alt me-2"></i><%= region_names[region_key] %>
              </h5>
              <hr class="flex-grow-1 my-0 text-muted">
              <span class="badge bg-light text-dark ms-3"><%= grouped_projects[region_key].count %> projet<%= 's' if grouped_projects[region_key].count > 1 %></span>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-5">
          <% grouped_projects[region_key].each do |project| %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card border-0 h-100 property-card position-relative overflow-hidden" style="min-height: 200px;">

            <!-- Image de fond sur toute la carte -->
            <div class="position-absolute w-100 h-100"
                 style="background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_200,q_auto,f_auto/renovation-interieure-a-bruxelles-CfiLU_qtwkug');
                        background-size: cover;
                        background-position: center;
                        background-repeat: no-repeat;
                        top: 0;
                        left: 0;
                        z-index: 1;">
            </div>

            <!-- Overlay sombre pour la lisibilité -->
            <div class="position-absolute w-100 h-100" style="background: rgba(0,0,0,0.1); top: 0; left: 0; z-index: 2;"></div>

            <!-- Badge région en haut à gauche -->
            <% if project.property&.region %>
              <div class="position-absolute top-0 start-0 m-2" style="z-index: 4;">
                <span class="badge bg-<%= project.property.region == 'wallonie' ? 'danger' : project.property.region == 'flandre' ? 'dark' : 'warning' %>" style="font-size: 0.7rem;">
                  <%= project.property.region.humanize %>
                </span>
              </div>
            <% end %>

            <!-- Menu actions trois points en haut à droite -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index: 4;">
              <div class="dropdown dropup">
                <button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="opacity: 0.9;">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index: 1050;">
                  <li>
                    <%= link_to project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-eye me-2"></i>Voir
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-pencil me-2"></i>Modifier
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to project_path(project),
                        class: "dropdown-item text-danger",
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Êtes-vous sûr de vouloir supprimer le chantier '#{project.nom}' ?\n\nCette action supprimera définitivement :\n- Le chantier et ses informations\n- Tous les travaux associés\n- Les documents liés\n\nCette action est irréversible."
                        } do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Contenu centré avec le titre du projet -->
            <%= link_to project_path(project), class: "text-decoration-none position-absolute w-100 h-100 d-flex align-items-center justify-content-center", style: "z-index: 3;" do %>
              <div class="text-center text-white">
                <!-- Titre du projet -->
                <h5 class="fw-bold mb-3" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.7);">
                  <i class="bi bi-hammer me-2"></i>
                  <%= project.nom %>
                </h5>

                <!-- Adresse de la propriété associée -->
                <% if project.property.present? %>
                  <div class="text-white mb-3" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.8);">
                    <% if project.property.rue && project.property.numero && project.property.commune %>
                      <div style="font-size: 0.95rem; font-weight: 400;">
                        <i class="bi bi-geo-alt me-2"></i>
                        <%= project.property.rue %> <%= project.property.numero %>
                      </div>
                      <div style="font-size: 0.85rem; opacity: 0.9;">
                        <%= project.property.code_postal %> <%= project.property.commune %>
                      </div>
                    <% else %>
                      <div class="text-warning" style="font-size: 0.9rem;">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Adresse incomplète
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-warning mb-3" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.8); font-size: 0.9rem;">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Bien non associé
                  </div>
                <% end %>

                <!-- Informations supplémentaires en bas -->
                <div class="d-flex justify-content-center align-items-center gap-3">
                  <span class="badge bg-light text-dark px-2 py-1" style="font-size: 0.75rem;">
                    <%= project.simulations.count %> simulation<%= 's' if project.simulations.count > 1 %>
                  </span>
                  <span class="text-white" style="font-size: 0.75rem; opacity: 0.8;">
                    <i class="bi bi-calendar-check me-1"></i>
                    <%= project.created_at.strftime("%d/%m/%Y") %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-folder-plus"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun projet enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par créer votre premier projet</p>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <%= link_to new_project_path(project_type: 'renovation'), class: "btn btn-primary-custom px-4" do %>
          <i class="bi bi-hammer me-2"></i>Créer un chantier de rénovation
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
