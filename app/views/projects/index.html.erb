<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes chantiers</h1>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to new_project_path(project_type: 'renovation'), class: "btn btn-primary-custom btn-sm px-3" do %>
        <i class="bi bi-plus-lg me-2"></i>Ajouter un chantier
      <% end %>
      <% if @property %>
        <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-arrow-left me-1"></i>Dashboard bien
        <% end %>
      <% end %>
      <%= link_to properties_path, class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i>Mes biens
      <% end %>
    </div>
  </div>

  <!-- Bandeau métriques -->
  <% if @projects.any? %>
    <%
      total_simulations = @projects.sum { |p| p.simulations.count }
      projets_en_cours  = @projects.count { |p| p.statut.to_s.in?(%w[en_cours actif]) }
      regions_count     = @projects.filter_map { |p| p.property&.region }.uniq.count
    %>
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-primary-light-ren0vate" style="border-radius: 12px;">
          <div class="fw-bold fs-3 text-primary-ren0vate"><%= @projects.count %></div>
          <div class="text-muted small"><i class="bi bi-hammer me-1"></i>Chantier<%= 's' if @projects.count > 1 %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-success-light-ren0vate" style="border-radius: 12px;">
          <div class="fw-bold fs-3 text-success-ren0vate"><%= projets_en_cours %></div>
          <div class="text-muted small"><i class="bi bi-play-circle me-1"></i>En cours</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-accent-light-ren0vate" style="border-radius: 12px;">
          <div class="fw-bold fs-3 text-accent-ren0vate"><%= total_simulations %></div>
          <div class="text-muted small"><i class="bi bi-calculator me-1"></i>Simulation<%= 's' if total_simulations != 1 %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-danger-light-ren0vate" style="border-radius: 12px;">
          <div class="fw-bold fs-3 text-danger-ren0vate"><%= regions_count %></div>
          <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>Région<%= 's' if regions_count != 1 %></div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Grille chantiers -->
  <% if @projects.any? %>
    <div class="row g-3">
      <% @projects.each do |project| %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card border-0 h-100 property-card position-relative overflow-hidden" style="min-height: 220px; border-radius: 12px;">

            <!-- COUCHE 1 : image de fond -->
            <div class="position-absolute w-100 h-100"
                 style="background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_220,q_auto,f_auto/renovation-interieure-a-bruxelles-CfiLU_qtwkug');
                        background-size: cover;
                        background-position: center;
                        top: 0; left: 0; z-index: 1;">
            </div>

            <!-- COUCHE 2 : overlay sombre -->
            <div class="position-absolute w-100 h-100" style="background: rgba(0,0,0,0.45); top: 0; left: 0; z-index: 2;"></div>

            <!-- COUCHE 3 : lien cliquable (toute la carte sauf barre du bas) -->
            <%= link_to project_path(project),
                class: "position-absolute w-100 d-flex flex-column justify-content-center align-items-center text-decoration-none text-white",
                style: "z-index: 3; top: 0; left: 0; bottom: 36px;" do %>
              <h5 class="fw-bold mb-2 text-center px-3 text-arch-orange" style="text-shadow: 2px 2px 8px rgba(0,0,0,1);">
                <i class="bi bi-hammer me-1"></i><%= project.nom %>
              </h5>
              <% if project.property.present? %>
                <div class="text-center" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.9);">
                  <% if project.property.rue && project.property.numero && project.property.commune %>
                    <div style="font-size: 0.9rem; font-weight: 500;">
                      <i class="bi bi-geo-alt me-1"></i><%= project.property.rue %> <%= project.property.numero %>
                    </div>
                    <div style="font-size: 0.82rem; opacity: 0.85;">
                      <%= project.property.code_postal %> <%= project.property.commune %>
                    </div>
                  <% else %>
                    <div class="text-warning" style="font-size: 0.82rem;">
                      <i class="bi bi-exclamation-triangle me-1"></i>Adresse incomplète
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="text-warning text-center" style="font-size: 0.82rem; text-shadow: 1px 1px 3px rgba(0,0,0,0.9);">
                  <i class="bi bi-exclamation-triangle me-1"></i>Bien non associé
                </div>
              <% end %>
            <% end %>

            <!-- COUCHE 4 : barre inférieure (simulations + date) -->
            <div class="position-absolute w-100" style="bottom: 0; left: 0; z-index: 4; background: rgba(0,0,0,0.55); padding: 6px 10px;">
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-white" style="font-size: 0.68rem; opacity: 0.85;">
                  <i class="bi bi-calculator me-1"></i><%= project.simulations.count %> simulation<%= 's' if project.simulations.count != 1 %>
                </span>
                <span class="text-white" style="font-size: 0.68rem; opacity: 0.75;">
                  <i class="bi bi-calendar me-1"></i><%= project.created_at.strftime("%d/%m/%Y") %>
                </span>
              </div>
            </div>

            <!-- COUCHE 5 : badge région (haut gauche) -->
            <% if project.property&.region %>
              <div class="position-absolute top-0 start-0 m-2" style="z-index: 5;">
                <span class="badge bg-<%= project.property.region == 'wallonie' ? 'danger' : project.property.region == 'flandre' ? 'dark' : 'warning' %>" style="font-size: 0.65rem;">
                  <%= project.property.region.humanize %>
                </span>
              </div>
            <% end %>

            <!-- COUCHE 5 : menu actions (haut droite) -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index: 5;">
              <div class="dropdown">
                <button class="btn btn-sm btn-dark opacity-75 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 7px;">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index: 1050;">
                  <li>
                    <%= link_to project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-eye me-2"></i>Voir
                    <% end %>
                  </li>
                  <li>
                    <%= link_to gantt_project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-calendar-range me-2"></i>Planning Gantt
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_project_path(project), class: "dropdown-item" do %>
                      <i class="bi bi-pencil me-2"></i>Modifier
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to project_path(project),
                        class: "dropdown-item text-danger",
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Êtes-vous sûr de vouloir supprimer le chantier '#{project.nom}' ?\n\nCette action supprimera définitivement :\n- Le chantier et ses informations\n- Tous les travaux associés\n- Les documents liés\n\nCette action est irréversible."
                        } do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-hammer"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun chantier enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par créer votre premier chantier de rénovation</p>
      <%= link_to new_project_path(project_type: 'renovation'), class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Créer mon premier chantier
      <% end %>
    </div>
  <% end %>
</div>
