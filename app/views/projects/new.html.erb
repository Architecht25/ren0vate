<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-hammer"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">
          Nouveau Chantier de Rénovation
        </h1>
      </div>
    </div>
    <%= link_to projects_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à la liste
    <% end %>
  </div>

  <!-- Formulaire dans une card épurée -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-info-circle me-2"></i>
            Informations du chantier
          </h5>

          <%= form_with model: @project, local: true do |form| %>
            <!-- Type de projet (caché) -->
            <%= form.hidden_field :project_type %>

            <!-- Champs de base communs -->
            <%= render 'projects/partials_general/basic_fields', form: form %>

            <!-- Sélection de propriété avec détection de région -->
            <%= render 'projects/partials_general/property_selection', form: form %>

            <!-- Champs spécifiques par région -->
            <%= render 'projects/partials_wallonie/eligibility_fields', form: form %>
            <%= render 'projects/partials_flandre/eligibility_fields', form: form %>
            <%= render 'projects/partials_bruxelles/eligibility_fields', form: form %>

            <!-- Informations des professionnels -->
            <%= render 'projects/partials_general/professionals_fields', form: form %>

            <div class="d-flex justify-content-end mt-4">
              <%= link_to "Annuler", projects_path, class: "btn btn-outline-secondary me-2" %>
              <% if defined?(Property) && current_user.properties.any? %>
                <%= form.submit "Créer le chantier", class: "btn btn-primary-custom" %>
              <% else %>
                <%= form.submit "Créer le chantier", class: "btn btn-primary-custom", disabled: true, title: "Ajoutez d'abord un bien immobilier" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-lightbulb me-2"></i>Conseils
          </h5>
          <p class="text-muted-custom small mb-3">Un chantier vous permet d'organiser vos travaux de rénovation pour un bien immobilier. Une fois créé, vous pourrez y ajouter des travaux spécifiques.</p>
          <p class="text-muted-custom small mb-0">Associez votre chantier à un bien immobilier pour faciliter la gestion de vos projets et simuler les primes disponibles.</p>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-check-circle me-2"></i>Prochaines étapes
          </h5>
          <ul class="text-muted-custom small mb-0 ps-3">
            <li class="mb-2">Ajouter des travaux spécifiques à votre chantier</li>
            <li class="mb-2">Joindre des documents (devis, plans, etc.)</li>
            <li class="mb-2">Simuler les primes disponibles pour vos travaux</li>
            <li>Suivre l'avancement de votre chantier</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>

<script nonce="<%= content_security_policy_nonce %>">
// Fonction pour initialiser les champs régionaux
function initializeRegionFields() {
  console.log('🏗️ Project form loaded - initializing region-specific fields');

  const propertySelect = document.getElementById('project_property_id');
  const wallonieFields = document.getElementById('wallonie-fields');
  const flandreFields = document.getElementById('flandre-fields');
  const bruxellesFields = document.getElementById('bruxelles-fields');

  if (!propertySelect) {
    console.log('No property select found');
    return;
  }

  // Map des propriétés et leurs régions (à charger dynamiquement)
  const propertyRegions = {};

  // Récupérer les régions des propriétés via AJAX ou les injecter depuis le controller
  <% if current_user.properties.any? %>
    <% current_user.properties.each do |property| %>
      propertyRegions[<%= property.id %>] = '<%= property.region&.downcase %>';
    <% end %>
  <% end %>

  function updateRegionFields(selectedPropertyId) {
    console.log('🏠 Property selected:', selectedPropertyId);

    // Masquer tous les champs régionaux
    if (wallonieFields) wallonieFields.style.display = 'none';
    if (flandreFields) flandreFields.style.display = 'none';
    if (bruxellesFields) bruxellesFields.style.display = 'none';

    if (!selectedPropertyId || selectedPropertyId === '') {
      console.log('No property selected, hiding all regional fields');
      return;
    }

    const region = propertyRegions[selectedPropertyId];
    console.log('🌍 Property region:', region);

    // Afficher les champs de la région correspondante
    switch(region) {
      case 'wallonie':
        if (wallonieFields) {
          wallonieFields.style.display = 'block';
          console.log('✅ Showing Wallonie fields');
        }
        break;
      case 'flandre':
        if (flandreFields) {
          flandreFields.style.display = 'block';
          console.log('✅ Showing Flandre fields');
        }
        break;
      case 'bruxelles':
        if (bruxellesFields) {
          bruxellesFields.style.display = 'block';
          console.log('✅ Showing Bruxelles fields');
        }
        break;
      default:
        console.log('⚠️ Unknown region:', region);
    }
  }

  // Écouter les changements de sélection de propriété
  propertySelect.addEventListener('change', function() {
    updateRegionFields(this.value);
  });

  // Initialiser avec la valeur actuelle (si en édition)
  updateRegionFields(propertySelect.value);

  console.log('✅ Region-specific fields initialized');
}

// Initialiser quand le DOM est chargé ET avec Turbo
document.addEventListener('DOMContentLoaded', initializeRegionFields);
document.addEventListener('turbo:load', initializeRegionFields);

// Double sécurité si les événements ont déjà été déclenchés
if (document.readyState === 'loading') {
  // Le document est encore en cours de chargement
} else {
  // Le document est déjà chargé
  initializeRegionFields();
}
</script>
