<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-hammer"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouveau Chantier de Rénovation</h1>
      </div>
    </div>
    <%= link_to projects_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à la liste
    <% end %>
  </div>

  <!-- Formulaire dans une card épurée -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-info-circle me-2"></i>Informations du chantier
          </h5>

          <%= form_with model: @project, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :nom, "Nom du chantier*", class: "form-label" %>
              <%= form.text_field :nom, class: "form-control", placeholder: "Ex: Rénovation complète appartement" %>
            </div>

            <div class="mb-3">
              <%= form.label :description, "Description", class: "form-label" %>
              <%= form.text_area :description, rows: 4, class: "form-control", placeholder: "Décrivez le chantier et les travaux à réaliser..." %>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :date_début, "Date de début prévue", class: "form-label" %>
                  <%= form.date_field :date_début, class: "form-control" %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :date_fin, "Date de fin prévue", class: "form-label" %>
                  <%= form.date_field :date_fin, class: "form-control" %>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :statut, "Statut du chantier", class: "form-label" %>
              <%= form.select :statut,
                  options_for_select([
                    ['En préparation', 'preparation'],
                    ['En cours', 'en_cours'],
                    ['En pause', 'pause'],
                    ['Terminé', 'termine'],
                    ['Annulé', 'annule']
                  ], 'preparation'),
                  { include_blank: false },
                  { class: "form-select" } %>
            </div>

            <!-- Nouvelle section : Informations pour l'éligibilité aux primes Wallonie -->
            <div class="mb-4 mt-4">
              <h6 class="text-primary-custom mb-3">
                <i class="bi bi-award me-2"></i>Informations pour l'éligibilité aux primes (Wallonie)
              </h6>
              <div class="border rounded p-3 bg-light">
                <div class="row">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :bce_number, "Numéro BCE de l'entrepreneur", class: "form-label" %>
                      <%= form.text_field :bce_number, class: "form-control", placeholder: "Ex: 0123456789", pattern: "[0-9]{10}", maxlength: "10" %>
                      <div class="form-text">Numéro d'entreprise à 10 chiffres (obligatoire pour les primes Wallonie)</div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :invoice_date, "Date des factures", class: "form-label" %>
                      <%= form.date_field :invoice_date, class: "form-control" %>
                      <div class="form-text">Date des factures pour vérifier l'éligibilité (max 2 ans)</div>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :work_completion_date, "Date de fin des travaux", class: "form-label" %>
                      <%= form.date_field :work_completion_date, class: "form-control" %>
                      <div class="form-text">Date de finalisation des travaux</div>
                    </div>
                  </div>
                </div>
                <div class="alert alert-info small mb-0">
                  <i class="bi bi-info-circle me-2"></i>
                  Ces informations sont nécessaires pour vérifier l'éligibilité aux primes de rénovation en Wallonie. Elles peuvent être remplies plus tard.
                </div>
              </div>
            </div>

            <!-- Sélection de propriété obligatoire -->
            <div class="mb-3">
              <%= form.label :property_id, "Bien immobilier associé*", class: "form-label" %>
              <% if defined?(Property) && current_user.properties.any? %>
                <%= form.collection_select :property_id, current_user.properties, :id, :full_address, { include_blank: "-- Sélectionner un bien --" }, class: "form-select" %>
                <div class="form-text">Sélectionnez le bien immobilier pour lequel vous créez ce chantier de rénovation.</div>
              <% else %>
                <div class="alert alert-warning">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  <strong>Aucun bien immobilier trouvé</strong>
                  <p class="mb-2">Vous devez d'abord ajouter un bien immobilier avant de créer un chantier.</p>
                  <%= link_to "Ajouter un bien immobilier", new_property_path, class: "btn btn-primary btn-sm" %>
                </div>
                <%= form.hidden_field :property_id, value: "" %>
              <% end %>
            </div>

            <div class="d-flex justify-content-end mt-4">
              <%= link_to "Annuler", projects_path, class: "btn btn-outline-secondary me-2" %>
              <% if defined?(Property) && current_user.properties.any? %>
                <%= form.submit "Créer le chantier", class: "btn btn-primary-custom" %>
              <% else %>
                <%= form.submit "Créer le chantier", class: "btn btn-primary-custom", disabled: true, title: "Ajoutez d'abord un bien immobilier" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-lightbulb me-2"></i>Conseils
          </h5>
          <p class="text-muted-custom small mb-3">Un chantier vous permet d'organiser vos travaux de rénovation pour un bien immobilier. Une fois créé, vous pourrez y ajouter des travaux spécifiques.</p>
          <p class="text-muted-custom small mb-0">Associez votre chantier à un bien immobilier pour faciliter la gestion de vos projets et simuler les primes disponibles.</p>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-check-circle me-2"></i>Prochaines étapes
          </h5>
          <ul class="text-muted-custom small mb-0 ps-3">
            <li class="mb-2">Ajouter des travaux spécifiques à votre chantier</li>
            <li class="mb-2">Joindre des documents (devis, plans, etc.)</li>
            <li class="mb-2">Simuler les primes disponibles pour vos travaux</li>
            <li>Suivre l'avancement de votre chantier</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
