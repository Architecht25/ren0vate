<div class="container-fluid px-4 py-4"
     data-controller="roi-calculator">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-graph-up-arrow"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">ROI Calculator</h1>
        <small class="text-muted"><%= @project.nom %></small>
      </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <%= link_to carnet_entretien_project_path(@project), class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-book me-1"></i>Carnet d'entretien
      <% end %>
      <%= link_to @project, class: "btn btn-outline-primary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour au projet
      <% end %>
    </div>
  </div>

  <!-- Alertes données manquantes -->
  <% missing = [] %>
  <% missing << "devis (architecte ou entrepreneur)" if @cout_travaux == 0 %>
  <% missing << "simulation de primes" if @primes_estimees == 0 %>
  <% missing << "valeur d'achat du bien" if @valeur_bien == 0 %>
  <% if missing.any? %>
    <div class="alert alert-warning d-flex align-items-start mb-4">
      <i class="bi bi-exclamation-triangle-fill me-3 mt-1 flex-shrink-0"></i>
      <div>
        <strong>Données manquantes pour ce projet :</strong>
        <ul class="mb-1 mt-1">
          <% missing.each do |m| %>
            <li>Aucun <%= m %> enregistré — valeur à renseigner manuellement ci-dessous</li>
          <% end %>
        </ul>
        <small class="text-muted">Les champs pré-remplis à 0 peuvent être modifiés librement — les calculs s'actualisent en temps réel.</small>
      </div>
    </div>
  <% end %>

  <div class="row g-4">

    <!-- Colonne gauche : inputs -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-sliders me-2"></i>Paramètres du calcul</h5>
        </div>
        <div class="card-body">

          <!-- Coût total travaux -->
          <div class="mb-4">
            <label class="form-label fw-bold">
              <i class="bi bi-wrench text-primary me-1"></i>
              Coût total des travaux (€)
              <% if @cout_source == :factures %>
                <span class="badge bg-success ms-1" style="font-size:0.7rem;">Factures réelles</span>
              <% elsif @cout_travaux.to_f > 0 %>
                <span class="badge bg-info text-dark ms-1" style="font-size:0.7rem;">Devis</span>
              <% end %>
            </label>
            <input type="number" class="form-control form-control-lg"
                   data-roi-calculator-target="coutTravaux"
                   data-action="input->roi-calculator#calculate"
                   value="<%= @cout_travaux.to_i %>"
                   min="0" step="500"
                   placeholder="Ex : 35 000">
            <div class="form-text">
              <% if @cout_source == :factures %>
                <i class="bi bi-check-circle text-success me-1"></i>
                Architecte&nbsp;: <%= number_to_currency(@factures_architecte, unit: "€", format: "%n %u", precision: 0) %> —
                Entrepreneur&nbsp;: <%= number_to_currency(@factures_entrepreneur, unit: "€", format: "%n %u", precision: 0) %>
                <em>(factures enregistrées)</em>
              <% elsif @cout_travaux.to_f > 0 %>
                <i class="bi bi-file-text text-info me-1"></i>
                Architecte&nbsp;: <%= number_to_currency(@devis_architecte, unit: "€", format: "%n %u", precision: 0) %> —
                Entrepreneur&nbsp;: <%= number_to_currency(@devis_entrepreneur, unit: "€", format: "%n %u", precision: 0) %>
                <em>(devis — remplacé automatiquement par les factures dès qu'elles sont encodées)</em>
              <% else %>
                Montant total à renseigner manuellement
              <% end %>
            </div>
          </div>

          <!-- Primes estimées -->
          <div class="mb-4">
            <label class="form-label fw-bold">
              <i class="bi bi-cash-coin text-success me-1"></i>
              Primes & subsides obtenus (€)
            </label>
            <input type="number" class="form-control form-control-lg"
                   data-roi-calculator-target="primesObtenues"
                   data-action="input->roi-calculator#calculate"
                   value="<%= @primes_estimees.to_i %>"
                   min="0" step="100"
                   placeholder="Ex : 8 500">
            <div class="form-text">Primes régionales, primes communales, avantages fiscaux</div>
          </div>

          <!-- Gain mensuel énergie -->
          <div class="mb-4">
            <label class="form-label fw-bold">
              <i class="bi bi-lightning-charge text-warning me-1"></i>
              Économie mensuelle sur la facture énergie (€/mois)
            </label>
            <input type="number" class="form-control form-control-lg"
                   data-roi-calculator-target="gainMensuelEnergie"
                   data-action="input->roi-calculator#calculate"
                   value="0"
                   min="0" step="10"
                   placeholder="Ex : 120">
            <div class="form-text">Estimation de réduction de votre consommation énergétique mensuelle</div>
          </div>

          <!-- Valeur actuelle du bien -->
          <div class="mb-4">
            <label class="form-label fw-bold">
              <i class="bi bi-house text-info me-1"></i>
              Valeur vénale actuelle du bien (€)
              <% if @valeur_bien.to_f == 0 %>
                <span class="badge bg-warning text-dark ms-1" style="font-size:0.7rem;">À renseigner</span>
              <% else %>
                <span class="badge bg-warning text-dark ms-1" style="font-size:0.7rem;">Prix d'achat — à vérifier</span>
              <% end %>
            </label>
            <input type="number" class="form-control form-control-lg"
                   data-roi-calculator-target="valeurBien"
                   data-action="input->roi-calculator#calculate"
                   value="<%= @valeur_bien.to_i %>"
                   min="0" step="5000"
                   placeholder="Ex : 250 000">
            <div class="form-text">
              <% if @valeur_bien.to_f > 0 %>
                <i class="bi bi-exclamation-triangle text-warning me-1"></i>
                Pré-rempli avec le <strong>prix d'achat</strong> enregistré — remplacez par la valeur vénale actuelle si le bien a été acquis il y a plusieurs années.
              <% else %>
                Valeur de marché estimée de votre bien <em>aujourd'hui</em> (pas le prix d'achat si celui-ci date de plusieurs années).
              <% end %>
            </div>
          </div>

          <hr>

          <!-- Horizon -->
          <div class="mb-4">
            <label class="form-label fw-bold">
              <i class="bi bi-calendar-range text-secondary me-1"></i>
              Horizon de calcul
            </label>
            <select class="form-select form-select-lg"
                    data-roi-calculator-target="horizonAns"
                    data-action="change->roi-calculator#calculate">
              <option value="10">10 ans</option>
              <option value="15">15 ans</option>
              <option value="20" selected>20 ans</option>
              <option value="25">25 ans</option>
              <option value="30">30 ans</option>
            </select>
          </div>

          <!-- Taux valorisation bien -->
          <div class="mb-2">
            <label class="form-label fw-bold">
              <i class="bi bi-graph-up text-success me-1"></i>
              Plus-value estimée du bien (%)
            </label>
            <select class="form-select"
                    data-roi-calculator-target="tauxValorisation"
                    data-action="change->roi-calculator#calculate">
              <option value="3">+3% — Rénovation légère (peinture, châssis)</option>
              <option value="5" selected>+5% — Rénovation énergétique standard</option>
              <option value="8">+8% — Rénovation lourde (isolation + chauffage)</option>
              <option value="12">+12% — Rénovation complète (label B ou A)</option>
            </select>
            <div class="form-text">Valorisation moyenne constatée en Belgique après rénovation énergétique</div>
          </div>

        </div>
      </div>
    </div>

    <!-- Colonne droite : résultats -->
    <div class="col-lg-7">

      <!-- Résultats -->
      <div data-roi-calculator-target="resultsSection" class="d-none">

        <!-- Récapitulatif financier -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-calculator me-2"></i>Résultats de votre investissement</h5>
          </div>
          <div class="card-body">
            <div class="row g-3 text-center">

              <div class="col-sm-6">
                <div class="bg-light rounded p-3">
                  <div class="text-muted small mb-1">Coût net après primes</div>
                  <div class="h4 fw-bold text-dark" data-roi-calculator-target="coutNet">—</div>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="bg-light rounded p-3">
                  <div class="text-muted small mb-1">Économies énergie totales</div>
                  <div class="h4 fw-bold text-warning" data-roi-calculator-target="economiesEnergie">—</div>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="bg-light rounded p-3">
                  <div class="text-muted small mb-1">Plus-value bien estimée</div>
                  <div class="h4 fw-bold text-info" data-roi-calculator-target="valorisationBien">—</div>
                </div>
              </div>

              <div class="col-sm-6">
                <div class="bg-light rounded p-3">
                  <div class="text-muted small mb-1">Gain total (primes + énergie + bien)</div>
                  <div class="h4 fw-bold text-success" data-roi-calculator-target="gainTotal">—</div>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- KPIs ROI -->
        <div class="row g-4 mb-4">
          <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100 text-center py-4">
              <div class="card-body">
                <i class="bi bi-percent fs-1 text-primary mb-3"></i>
                <div class="text-muted small mb-1">Retour sur investissement</div>
                <div class="display-5 fw-bold" data-roi-calculator-target="roi">—</div>
                <div class="text-muted small mt-2">vs coût net après primes</div>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100 text-center py-4">
              <div class="card-body">
                <i class="bi bi-hourglass-split fs-1 text-warning mb-3"></i>
                <div class="text-muted small mb-1">Délai de remboursement</div>
                <div class="display-5 fw-bold text-warning" data-roi-calculator-target="delaiRemboursement">—</div>
                <div class="text-muted small mt-2">énergie + valorisation bien</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Note pédagogique -->
        <div class="alert alert-info">
          <h6 class="alert-heading">
            <i class="bi bi-info-circle me-2"></i>Comment interpréter ces chiffres ?
          </h6>
          <ul class="mb-0 small">
            <li><strong>Coût net</strong> : ce que vous payez réellement après déduction des primes</li>
            <li><strong>Économies énergie</strong> : cumul de vos économies sur la durée choisie</li>
            <li><strong>Plus-value</strong> : augmentation estimée de la valeur de revente de votre bien</li>
            <li><strong>ROI</strong> : si > 100%, vous gagnez plus que vous n'investissez</li>
            <li><strong>Délai de remboursement</strong> : quand votre investissement « s'amortit »</li>
          </ul>
          <hr class="my-2">
          <small class="text-muted">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Ces projections sont indicatives. Les économies réelles dépendent de vos habitudes de consommation
            et de l'évolution des prix de l'énergie.
          </small>
        </div>

      </div>

      <!-- État vide (avant calcul) -->
      <div class="card border-0 shadow-sm h-100 d-flex align-items-center justify-content-center text-center p-5">
        <i class="bi bi-graph-up-arrow fs-1 text-primary mb-3"></i>
        <h5 class="text-muted">Renseignez les paramètres</h5>
        <p class="text-muted small">Les résultats s'affichent automatiquement dès que vous saisissez le coût des travaux.</p>
      </div>

    </div>
  </div>

</div>
