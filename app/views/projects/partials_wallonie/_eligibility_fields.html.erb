<!-- Champs spécifiques pour l'audit énergétique -->
<div class="mb-4 mt-4" id="wallonie-fields">
  <h6 class="text-primary-custom mb-3">
    <i class="bi bi-award me-2"></i>Informations pour l'audit énergétique
  </h6>
  <div class="border rounded p-3 bg-light">
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :numero_audit, "Numéro d'audit", class: "form-label" %>
          <%= form.text_field :numero_audit, class: "form-control", placeholder: "Ex: A20" %>
          <div class="form-text">Numéro d'entrepriseaudit à 10 chiffres (obligatoire pour les primes Wallonie)</div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :date_audit, "Date de réalisaiton de l'audit", class: "form-label" %>
          <%= form.date_field :date_audit, class: "form-control" %>
          <div class="form-text">Date de production du rapprt d'audit</div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :numero_agrement_auditeur, "Numéro d'agrément de l'auditeur", class: "form-label" %>
          <%= form.text_field :numero_agrement_auditeur, class: "form-control", placeholder: "Ex: PAE2 - PX - XXXXX" %>
          <div class="form-text">Numéro d'agrément de l'auditeur à 10 chiffres (obligatoire pour les primes Wallonie)</div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :prix_audit, "Prix de l'audit", class: "form-label" %>
          <%= form.text_field :prix_audit, class: "form-control", placeholder: "Ex: 1500" %>
          <div class="form-text">Prix de l'audit en euros (obligatoire pour les primes Wallonie)</div>
        </div>
      </div>
    </div>
    <div class="alert alert-info small mb-0">
      <i class="bi bi-info-circle me-2"></i>
      Ces informations sont nécessaires pour vérifier l'éligibilité aux primes de rénovation en Wallonie.
    </div>
  </div>
</div>
