<%# Audit énergétique Walloreno — Wallonie uniquement %>
<% _audit = @project.property&.audit_energ_donnees&.order(created_at: :desc)&.first rescue nil %>
<% _upload_url = scan_audit_energ_project_path(@project) %>
<% _statut_url = audit_energ_statut_project_path(@project) %>

<%# L'extraction Claude tourne en arrière-plan (AuditEnergExtractionJob) — data-audit-statut
    permet au JS de reprendre le polling si la page est rechargée pendant que ça tourne encore. %>
<div class="card border-0 shadow-sm rounded-4 h-100" id="audit-energ-card"
     data-statut-url="<%= _statut_url %>"
     data-audit-id="<%= _audit&.id %>"
     data-audit-statut="<%= _audit&.statut %>">
  <%# ─────────────────────────── Header ──────────────────────────────────── %>
  <div class="card-header border-0 py-3 px-4 d-flex align-items-center justify-content-between"
       style="background:linear-gradient(135deg,#064e3b,#065f46); border-radius: 1rem 1rem 0 0 !important;">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-file-earmark-text text-white fs-5"></i>
      <div>
        <span class="fw-semibold text-white">Audit énergétique</span>
        <div class="text-white opacity-75" style="font-size:0.75rem;">Requis pour certaines primes en Wallonie</div>
      </div>
    </div>
    <%# Bouton upload toujours visible pour re-scanner %>
    <button class="btn btn-sm text-white rounded-3"
            style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);"
            onclick="document.getElementById('audit-energ-file-input').click()"
            title="Scanner un rapport d'audit">
      <i class="bi bi-upload me-1"></i>
      <span style="font-size:0.78rem;"><%= _audit ? 'Remplacer' : 'Scanner' %></span>
    </button>

    <%# Input file caché %>
    <input type="file" id="audit-energ-file-input" class="d-none"
           accept=".pdf,image/*"
           data-upload-url="<%= _upload_url %>"
           onchange="auditEnergScan(this)">
  </div>

  <div class="card-body p-3">
    <%# ── État : aucun audit ── %>
    <% unless _audit %>
      <div class="text-center py-4 text-muted" id="audit-energ-empty">
        <i class="bi bi-file-earmark-plus fs-3 d-block mb-2" style="color:#1a7a4a;"></i>
        <p class="small mb-3">Aucun audit énergétique pour ce bien</p>
        <button class="btn btn-sm rounded-3 text-white" style="background:#1a7a4a;"
                onclick="document.getElementById('audit-energ-file-input').click()">
          <i class="bi bi-upload me-1"></i>Scanner le rapport d'audit
        </button>
      </div>
    <% end %>

    <%# ── État : analyse en cours (persiste après un rechargement de page) ── %>
    <% if _audit&.en_cours? %>
      <div class="text-center py-4" id="audit-energ-processing">
        <div class="spinner-border text-success mb-2" role="status" style="width:2rem;height:2rem;"></div>
        <p class="small text-muted mb-1">Analyse du rapport en cours par l'IA…</p>
        <p class="text-muted mb-0" style="font-size:0.68rem;">Jusqu'à 1-2 minutes pour un audit complet — cette page se
          mettra à jour automatiquement.</p>
      </div>
    <% end %>

    <%# ── État : échec de l'analyse ── %>
    <% if _audit&.echec? %>
      <div class="text-center py-4" id="audit-energ-echec">
        <i class="bi bi-exclamation-circle fs-3 d-block mb-2 text-danger"></i>
        <p class="small text-muted mb-3">L'analyse de ce document a échoué.</p>
        <button class="btn btn-sm rounded-3 text-white" style="background:#1a7a4a;"
                onclick="document.getElementById('audit-energ-file-input').click()">
          <i class="bi bi-upload me-1"></i>Réessayer
        </button>
      </div>
    <% end %>

    <%# ── Spinner transitoire JS (immédiatement après l'upload, avant le 1er poll) ── %>
    <div id="audit-energ-spinner" class="text-center py-4 d-none">
      <div class="spinner-border text-success mb-2" role="status" style="width:2rem;height:2rem;"></div>
      <p class="small text-muted mb-0">Envoi du document…</p>
    </div>

    <%# ── Données extraites ── %>
    <% if _audit&.termine? %>
      <%# Badge confiance + méthode d'extraction %>
      <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom flex-wrap">
        <i class="bi bi-patch-check text-success"></i>
        <span class="small text-muted">Confiance</span>
        <span class="badge <%= _audit.confiance_ocr.to_i >= 70 ? 'bg-success' : 'bg-warning text-dark' %>">
          <%= _audit.confiance_ocr.to_i %> %
        </span>
        <% if _audit.extrait_via_claude? %>
          <span class="badge rounded-pill" style="background:rgba(124,58,237,0.12);color:#7c3aed;font-size:0.68rem;">
            <i class="bi bi-stars me-1"></i>Extraction IA
          </span>
        <% elsif _audit.source_extraction == 'ocr_fallback' %>
          <span class="badge rounded-pill bg-light text-secondary border" style="font-size:0.68rem;">
            OCR (secours)
          </span>
        <% end %>
        <% if _audit.perime? %>
          <span class="badge bg-danger ms-auto">Périmé</span>
        <% end %>
      </div>

      <%# ── Bandeau alertes non-énergétiques (prérequis primes) ── %>
      <% _alertes = _audit.alertes_non_conformes %>
      <% if _alertes.any? %>
        <div class="alert <%= _audit.alertes_bloquantes.any? ? 'alert-danger' : 'alert-warning' %> py-2 px-3 mb-3" style="font-size:0.78rem;">
          <div class="fw-semibold mb-1">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            <%= _audit.alertes_bloquantes.any? ? "Préalable bloquant pour les primes" : "Points d'attention avant travaux" %>
          </div>
          <ul class="mb-0 ps-3">
            <% _alertes.first(5).each do |a| %>
              <li><%= a[:description].presence || a[:categorie]&.humanize %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# ── Sections 1 + 2 : Identification & Labels côte à côte ── %>
      <div class="row gx-4 mb-3">

        <%# Colonne identification %>
        <div class="col-lg-8 col-12">
          <div class="text-uppercase fw-semibold mb-2" style="font-size:0.68rem;color:#1a7a4a;letter-spacing:0.05em;">
            <i class="bi bi-card-heading me-1"></i>Identification
          </div>
          <div class="row g-0">
            <% if _audit.numero_audit.present? %>
              <div class="col-6 pe-3">
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted small">N° audit</span>
                  <span class="small fw-semibold font-monospace"><%= _audit.numero_audit %></span>
                </div>
              </div>
            <% end %>
            <% if _audit.date_enregistrement.present? %>
              <div class="col-6 ps-3">
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted small">Enregistré le</span>
                  <span class="small"><%= _audit.date_enregistrement.strftime('%d/%m/%Y') %></span>
                </div>
              </div>
            <% end %>
            <% if _audit.numero_pae.present? %>
              <div class="col-6 pe-3">
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted small">N° agréé</span>
                  <span class="small fw-semibold"><%= _audit.numero_pae %></span>
                </div>
              </div>
            <% end %>
            <% if _audit.denomination_auditeur.present? %>
              <div class="col-6 ps-3">
                <div class="d-flex justify-content-between py-1 border-bottom">
                  <span class="text-muted small">Auditeur</span>
                  <span class="small text-end" style="max-width:60%;"><%= _audit.denomination_auditeur %></span>
                </div>
              </div>
            <% end %>
            <% if _audit.adresse_auditeur.present? %>
              <div class="col-12">
                <div class="d-flex justify-content-between py-1">
                  <span class="text-muted small flex-shrink-0 me-2">Adresse auditeur</span>
                  <span class="small text-end"><%= _audit.adresse_auditeur %></span>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# Colonne labels énergétiques %>
        <% if _audit.label_initial.present? || _audit.label_final.present? %>
          <div class="col-lg-4 col-12 mt-3 mt-lg-0">
            <div class="text-uppercase fw-semibold mb-2" style="font-size:0.68rem;color:#1a7a4a;letter-spacing:0.05em;">
              <i class="bi bi-lightning me-1"></i>Performance énergétique
            </div>
            <div class="d-flex align-items-center justify-content-center gap-3 py-3 rounded-3 h-100"
                 style="background:rgba(26,122,74,0.04);min-height:80px;">
              <% if _audit.label_initial.present? %>
                <div class="text-center">
                  <div class="badge bg-<%= _audit.couleur_label_initial %> fs-4 px-3 py-2"><%= _audit.label_initial %></div>
                  <div class="text-muted mt-1" style="font-size:0.68rem;">Actuel</div>
                </div>
              <% end %>
              <% if _audit.label_initial.present? && _audit.label_final.present? %>
                <i class="bi bi-arrow-right fs-3 text-muted"></i>
              <% end %>
              <% if _audit.label_final.present? %>
                <div class="text-center">
                  <div class="badge bg-<%= _audit.couleur_label_final %> fs-4 px-3 py-2"><%= _audit.label_final %></div>
                  <div class="text-muted mt-1" style="font-size:0.68rem;">Objectif</div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>

      <%# ── Section 2bis : Trajectoire vers le Label A (objectif 2050) ── %>
      <% _peb = _audit.peb_projection %>
      <% if _peb.present? || _audit.label_initial.present? %>
        <div class="mb-3 pt-2 border-top">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="text-uppercase fw-semibold" style="font-size:0.68rem;color:#1a7a4a;letter-spacing:0.05em;">
              <i class="bi bi-globe-europe-africa me-1"></i>Trajectoire vers le Label A (objectif 2050)
            </div>
            <% if _audit.distance_label_a.present? %>
              <span class="badge rounded-pill" style="background:rgba(26,122,74,0.12);color:#1a7a4a;font-size:0.68rem;">
                <%= _audit.distance_label_a.zero? ? "Déjà au niveau A" : "#{_audit.distance_label_a} palier(s) à franchir" %>
              </span>
            <% end %>
          </div>
          <div class="row gx-2 gy-1">
            <% if _peb[:epw_initial].present? || _peb[:epw_apres].present? %>
              <div class="col-6 col-lg-3">
                <div class="p-2 rounded-3 text-center" style="background:rgba(0,0,0,0.04);">
                  <div class="fw-bold" style="font-size:0.95rem;">
                    <%= _peb[:epw_initial] || '—' %> → <%= _peb[:epw_apres] || '—' %>
                  </div>
                  <div class="text-muted" style="font-size:0.65rem;">Score Epw (PEB projeté)</div>
                </div>
              </div>
            <% end %>
            <% %w[besoins_chaleur performance_chauffage performance_ecs ventilation].each do |cle| %>
              <% _bloc = _peb[cle] %>
              <% next unless _bloc.is_a?(Hash) && (_bloc[:initial].present? || _bloc[:apres].present?) %>
              <div class="col-6 col-lg-3">
                <div class="p-2 rounded-3 text-center" style="background:rgba(26,122,74,0.05);">
                  <div class="fw-semibold" style="font-size:0.75rem;">
                    <%= _bloc[:initial]&.humanize || '—' %> → <%= _bloc[:apres]&.humanize || '—' %>
                  </div>
                  <div class="text-muted" style="font-size:0.62rem;"><%= cle.humanize %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# ── Section 3 : Feuille de route par étapes ── %>
      <% _etapes = _audit.etapes.sort_by { |e| e[:numero].to_i } %>
      <% if _etapes.any? %>
        <div class="mb-3 pt-2 border-top">
          <div class="text-uppercase fw-semibold mb-2" style="font-size:0.68rem;color:#1a7a4a;letter-spacing:0.05em;">
            <i class="bi bi-signpost-split me-1"></i>Feuille de route par étapes
          </div>
          <div class="d-flex flex-nowrap gap-2 overflow-auto pb-1">
            <% _etapes.each do |etape| %>
              <% _montant_net = _audit.montant_net_etape(etape) %>
              <div class="border rounded-3 p-2 flex-shrink-0" style="min-width:150px;<%= etape[:label_cible] == _audit.label_initial ? 'opacity:0.5;' : '' %>">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="text-muted" style="font-size:0.62rem;">Étape <%= etape[:numero] %></span>
                  <span class="badge bg-<%= AuditEnergDonnee::COULEURS_LABEL.fetch(etape[:label_cible].to_s.upcase, 'secondary') %>" style="font-size:0.68rem;">
                    <%= etape[:label_cible] %>
                  </span>
                </div>
                <% if etape[:cout_cumule_euro].present? %>
                  <div class="fw-semibold" style="font-size:0.78rem;"><%= number_with_delimiter(etape[:cout_cumule_euro].to_i) %> €</div>
                <% end %>
                <% if etape[:primes_cumule_euro].present? %>
                  <div class="text-primary" style="font-size:0.66rem;">− <%= number_with_delimiter(etape[:primes_cumule_euro].to_i) %> € primes</div>
                <% end %>
                <% if _montant_net.present? %>
                  <div class="text-success fw-semibold" style="font-size:0.66rem;">net : <%= number_with_delimiter(_montant_net.to_i) %> €</div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# ── Section 4 : Bilan scénario complet + montant net à financer ── %>
      <% _bilan = _audit.bilan %>
      <% if _audit.cout_total_estime.to_i > 0 || _audit.gain_annuel_total.to_i > 0 %>
        <div class="mb-3 pt-2 border-top">
          <div class="text-uppercase fw-semibold mb-2" style="font-size:0.68rem;color:#1a7a4a;letter-spacing:0.05em;">
            <i class="bi bi-calculator me-1"></i>Scénario complet
          </div>
          <div class="row gx-2 gy-1">
            <% if _audit.gain_annuel_total.to_i > 0 %>
              <div class="col-6 col-lg-3">
                <div class="p-2 rounded-3 text-center" style="background:rgba(26,122,74,0.07);">
                  <div class="fw-bold text-success" style="font-size:0.95rem;">
                    <%= number_with_delimiter(_audit.gain_annuel_total.to_i) %> €/an
                  </div>
                  <div class="text-muted" style="font-size:0.65rem;">Économie</div>
                </div>
              </div>
            <% end %>
            <% if _audit.cout_total_estime.to_i > 0 %>
              <div class="col-6 col-lg-3">
                <div class="p-2 rounded-3 text-center" style="background:rgba(0,0,0,0.04);">
                  <div class="fw-bold" style="font-size:0.95rem;">
                    <%= number_with_delimiter(_audit.cout_total_estime.to_i) %> €
                  </div>
                  <div class="text-muted" style="font-size:0.65rem;">Coût total</div>
                </div>
              </div>
            <% end %>
            <% if _audit.primes_total.to_i > 0 %>
              <div class="col-6 col-lg-3">
                <div class="p-2 rounded-3 text-center" style="background:rgba(13,110,253,0.07);">
                  <div class="fw-bold text-primary" style="font-size:0.95rem;">
                    <%= number_with_delimiter(_audit.primes_total.to_i) %> €
                  </div>
                  <div class="text-muted" style="font-size:0.65rem;">Subsides</div>
                </div>
              </div>
            <% end %>
            <% if _audit.temps_retour_global.to_s.present? %>
              <div class="col-6 col-lg-3">
                <div class="p-2 rounded-3 text-center" style="background:rgba(0,0,0,0.04);">
                  <div class="fw-bold" style="font-size:0.95rem;"><%= _audit.temps_retour_global %> ans</div>
                  <div class="text-muted" style="font-size:0.65rem;">Retour invest.</div>
                </div>
              </div>
            <% end %>
          </div>
          <% if _audit.montant_net_a_financer.present? %>
            <div class="mt-2 p-2 rounded-3 d-flex align-items-center justify-content-between" style="background:rgba(124,58,237,0.06);">
              <span class="small" style="color:#5b21b6;"><i class="bi bi-piggy-bank me-1"></i>Montant net à financer (après primes)</span>
              <span class="fw-bold" style="color:#5b21b6;"><%= number_with_delimiter(_audit.montant_net_a_financer.to_i) %> €</span>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# ── Section 5 : Recommandations par bouquet ── %>
      <% _recos = _audit.recommandations %>
      <% if _recos.any? %>
        <div class="pt-2 border-top">
          <div class="d-flex align-items-center justify-content-between mb-1">
            <div class="text-uppercase fw-semibold" style="font-size:0.68rem;color:#1a7a4a;letter-spacing:0.05em;">
              <i class="bi bi-list-check me-1"></i>Recommandations par bouquet
            </div>
            <span class="badge rounded-pill" style="background:rgba(26,122,74,0.12);color:#1a7a4a;font-size:0.68rem;">
              <%= _recos.size %> travaux
            </span>
          </div>
          <div class="text-muted mb-2" style="font-size:0.68rem;">
            <i class="bi bi-info-circle me-1"></i>Les travaux sont regroupés par bouquet (à réaliser ensemble, par ordre
            de priorité) puis par type de travaux. Pour chacun : coût estimé, prime estimée,
            <strong>reste à charge</strong> une fois la prime déduite, et économie annuelle attendue.
          </div>

          <%# Légende des codes de référence du rapport (T1, F8, CC, ECS1…) ── %>
          <div class="d-flex flex-wrap gap-2 mb-2 p-2 rounded-3" style="background:rgba(0,0,0,0.03);font-size:0.62rem;">
            <% AuditEnergDonnee::REFERENCE_PREFIXES.each do |prefixe, (label, icone)| %>
              <span class="text-muted">
                <i class="bi <%= icone %> me-1" style="color:#1a7a4a;"></i><strong><%= prefixe %></strong> = <%= label %>
              </span>
            <% end %>
          </div>

          <%# Grille 2 bouquets par ligne — contenu plus riche, donc cartes plus larges %>
          <div class="row g-2">
            <% _recos.group_by { |r| r[:bouquet] }.sort.each do |bouquet_num, lignes| %>
              <% _eco_bouquet    = lignes.sum { |l| l[:economie_euro_an].to_i } %>
              <% _cout_bouquet   = lignes.sum { |l| l[:cout_estime_euro].to_i } %>
              <% _prime_bouquet  = lignes.sum { |l| l[:subsides_euro].to_i } %>
              <% _reste_bouquet  = _cout_bouquet - _prime_bouquet %>
              <% _etape_bouquet  = _audit.etape_pour_bouquet(bouquet_num) %>
              <% _label_avant_bq = _etape_bouquet && _audit.label_avant_etape(_etape_bouquet) %>
              <% _label_apres_bq = _etape_bouquet && _etape_bouquet[:label_cible] %>
              <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <div class="border rounded-3 h-100 overflow-hidden">
                  <%# En-tête bouquet %>
                  <div class="px-3 py-2 d-flex align-items-center justify-content-between" style="background:#1a7a4a;">
                    <span class="text-white fw-semibold" style="font-size:0.78rem;">Bouquet <%= bouquet_num %></span>
                    <% if _label_avant_bq.present? && _label_apres_bq.present? %>
                      <div class="d-flex align-items-center gap-1" title="Label énergétique atteint une fois ce bouquet réalisé (avec les bouquets précédents de cette étape)">
                        <span class="badge bg-<%= AuditEnergDonnee::COULEURS_LABEL.fetch(_label_avant_bq.to_s.upcase, 'secondary') %>" style="font-size:0.65rem;"><%= _label_avant_bq %></span>
                        <i class="bi bi-arrow-right text-white" style="font-size:0.6rem;"></i>
                        <span class="badge bg-<%= AuditEnergDonnee::COULEURS_LABEL.fetch(_label_apres_bq.to_s.upcase, 'secondary') %>" style="font-size:0.65rem;"><%= _label_apres_bq %></span>
                      </div>
                    <% end %>
                  </div>
                  <%# Totaux du bouquet %>
                  <div class="px-3 py-2 border-bottom d-flex flex-wrap gap-2" style="background:rgba(26,122,74,0.05);">
                    <% if _eco_bouquet > 0 %>
                      <div>
                        <div class="text-muted" style="font-size:0.6rem;">Économie</div>
                        <div class="fw-bold text-success" style="font-size:0.85rem;"><%= number_with_delimiter(_eco_bouquet) %> €/an</div>
                      </div>
                    <% end %>
                    <% if _cout_bouquet > 0 %>
                      <div>
                        <div class="text-muted" style="font-size:0.6rem;">Coût total</div>
                        <div class="fw-semibold" style="font-size:0.85rem;"><%= number_with_delimiter(_cout_bouquet) %> €</div>
                      </div>
                    <% end %>
                    <% if _prime_bouquet > 0 %>
                      <div>
                        <div class="text-muted" style="font-size:0.6rem;">Primes</div>
                        <div class="fw-semibold text-primary" style="font-size:0.85rem;">− <%= number_with_delimiter(_prime_bouquet) %> €</div>
                      </div>
                    <% end %>
                    <% if _cout_bouquet > 0 %>
                      <div class="ms-auto">
                        <div class="text-muted" style="font-size:0.6rem;">Reste à charge</div>
                        <div class="fw-bold" style="font-size:0.85rem;color:#5b21b6;"><%= number_with_delimiter(_reste_bouquet) %> €</div>
                      </div>
                    <% end %>
                  </div>

                  <%# Travaux regroupés par corps de métier ── %>
                  <div class="p-2">
                    <% _groupes = lignes.group_by { |l| l[:type_element].presence }
                                         .sort_by { |type, _| AuditEnergDonnee.type_element_ordre_index(type) } %>
                    <% _groupes.each_with_index do |(type, items), gidx| %>
                      <div class="<%= gidx < _groupes.size - 1 ? 'mb-2 pb-2 border-bottom' : '' %>">
                        <% if type.present? %>
                          <div class="d-flex align-items-center gap-1 mb-1">
                            <i class="bi <%= AuditEnergDonnee.type_element_icon(type) %>" style="font-size:0.7rem;color:#1a7a4a;"></i>
                            <span class="text-uppercase fw-semibold" style="font-size:0.62rem;color:#1a7a4a;letter-spacing:0.03em;">
                              <%= AuditEnergDonnee.type_element_label(type) %>
                            </span>
                          </div>
                        <% end %>
                        <% items.each_with_index do |reco, idx| %>
                          <% _titre  = AuditEnergDonnee.reco_titre(reco) %>
                          <% _avant  = AuditEnergDonnee.reco_avant(reco) %>
                          <% _apres  = AuditEnergDonnee.reco_apres(reco) %>
                          <% _reste  = AuditEnergDonnee.reco_reste_a_charge(reco) %>
                          <div class="<%= idx < items.size - 1 ? 'mb-2 pb-2 border-bottom' : '' %>">
                            <% if AuditEnergDonnee.reco_reference_affichable?(reco) %>
                              <span class="d-inline-flex align-items-center gap-1 rounded-pill px-2 py-1 mb-1" style="background:rgba(26,122,74,0.1);">
                                <i class="bi <%= AuditEnergDonnee.reco_reference_icon(reco) %>" style="font-size:0.68rem;color:#1a7a4a;"></i>
                                <span class="fw-bold font-monospace" style="font-size:0.62rem;color:#1a7a4a;"><%= reco[:reference] %></span>
                                <span style="font-size:0.62rem;color:#1a7a4a;">· <%= AuditEnergDonnee.reco_reference_label(reco) %></span>
                              </span>
                            <% end %>
                            <div style="font-size:0.75rem;line-height:1.35;color:#333;">
                              <%= truncate(_titre, length: 60) %>
                            </div>
                            <% if _avant.present? && _apres.present? %>
                              <div class="text-muted mt-1" style="font-size:0.66rem;">
                                <%= _avant %> <i class="bi bi-arrow-right mx-1"></i> <%= _apres %>
                              </div>
                            <% end %>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                              <% if reco[:cout_estime_euro].to_i > 0 %>
                                <div>
                                  <span class="text-muted" style="font-size:0.6rem;">Coût </span>
                                  <span class="fw-semibold" style="font-size:0.68rem;"><%= number_with_delimiter(reco[:cout_estime_euro].to_i) %> €</span>
                                </div>
                              <% end %>
                              <% if reco[:subsides_euro].to_i > 0 %>
                                <div>
                                  <span class="text-muted" style="font-size:0.6rem;">Prime </span>
                                  <span class="fw-semibold text-primary" style="font-size:0.68rem;">− <%= number_with_delimiter(reco[:subsides_euro].to_i) %> €</span>
                                </div>
                              <% end %>
                              <% if _reste.present? %>
                                <div>
                                  <span class="text-muted" style="font-size:0.6rem;">Reste à charge </span>
                                  <span class="fw-semibold" style="font-size:0.68rem;color:#5b21b6;"><%= number_with_delimiter(_reste.to_i) %> €</span>
                                </div>
                              <% end %>
                              <% if reco[:economie_euro_an].to_i > 0 %>
                                <div class="ms-auto">
                                  <span class="badge" style="background:rgba(26,122,74,0.12);color:#1a7a4a;font-size:0.65rem;">
                                    +<%= number_with_delimiter(reco[:economie_euro_an].to_i) %> €/an
                                  </span>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# ── Message d'erreur OCR ── %>
    <div id="audit-energ-error" class="alert alert-danger alert-sm d-none mt-2 mb-0 py-2" style="font-size:0.8rem;"></div>
  </div>
</div>

<%# ── Script upload + polling (extraction asynchrone) ────────────────────────── %>
<script nonce="<%= content_security_policy_nonce %>">
// L'extraction tourne dans AuditEnergExtractionJob (dyno worker) — on interroge
// #audit_energ_statut toutes les 4s jusqu'à ce que ce ne soit plus "en_cours",
// puis on recharge la page pour afficher le résultat (ou l'état d'échec).
function auditEnergPoll(auditId) {
  const card     = document.getElementById('audit-energ-card');
  const statutUrl = card && card.dataset.statutUrl;
  if (!statutUrl || !auditId) return;

  const POLL_INTERVAL_MS = 4000;
  const MAX_ATTEMPTS      = 45; // ~3 minutes

  let attempts = 0;
  const timer = setInterval(() => {
    attempts += 1;
    if (attempts > MAX_ATTEMPTS) {
      clearInterval(timer);
      return; // on abandonne le polling silencieusement ; un refresh manuel affichera l'état réel
    }

    fetch(`${statutUrl}?audit_id=${encodeURIComponent(auditId)}`, {
      headers: { 'Accept': 'application/json' }
    })
      .then(r => r.json())
      .then(data => {
        if (data.statut && data.statut !== 'en_cours') {
          clearInterval(timer);
          window.location.reload();
        }
      })
      .catch(() => { /* erreur ponctuelle de polling — on retente au prochain tick */ });
  }, POLL_INTERVAL_MS);
}

document.addEventListener('DOMContentLoaded', function () {
  const card = document.getElementById('audit-energ-card');
  if (card && card.dataset.auditStatut === 'en_cours' && card.dataset.auditId) {
    auditEnergPoll(card.dataset.auditId);
  }
});

function auditEnergScan(input) {
  if (!input.files || !input.files[0]) return;

  const uploadUrl = input.dataset.uploadUrl;
  const spinner   = document.getElementById('audit-energ-spinner');
  const emptyEl   = document.getElementById('audit-energ-empty');
  const errorEl   = document.getElementById('audit-energ-error');
  const echecEl   = document.getElementById('audit-energ-echec');

  // Afficher le spinner transitoire (l'état "en cours" persistant apparaîtra
  // au prochain rechargement, une fois le job réellement lancé côté serveur)
  if (spinner)  spinner.classList.remove('d-none');
  if (emptyEl)  emptyEl.classList.add('d-none');
  if (echecEl)  echecEl.classList.add('d-none');
  if (errorEl)  errorEl.classList.add('d-none');

  const formData = new FormData();
  formData.append('file', input.files[0]);
  formData.append('authenticity_token', document.querySelector('meta[name="csrf-token"]').content);

  fetch(uploadUrl, { method: 'POST', body: formData, headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content } })
    .then(r => r.json())
    .then(data => {
      if (data.success && data.processing) {
        // Le job est lancé — on garde le spinner visible et on lance le polling
        auditEnergPoll(data.audit_id);
      } else if (data.success) {
        if (spinner) spinner.classList.add('d-none');
        window.location.reload();
      } else {
        if (spinner) spinner.classList.add('d-none');
        if (errorEl) {
          errorEl.textContent = data.error || "Erreur lors de l'extraction.";
          errorEl.classList.remove('d-none');
        }
        if (emptyEl) emptyEl.classList.remove('d-none');
      }
    })
    .catch(() => {
      if (spinner) spinner.classList.add('d-none');
      if (emptyEl) emptyEl.classList.remove('d-none');
      if (errorEl) {
        errorEl.textContent = "Erreur réseau lors de l'envoi du fichier.";
        errorEl.classList.remove('d-none');
      }
    });

  // Reset input pour permettre re-upload du même fichier
  input.value = '';
}
</script>
