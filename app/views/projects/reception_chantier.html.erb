<%# JavaScript : Plan annotations — épingler une réserve sur un plan            %>
<%# ═══════════════════════════════════════════════════════════════════════════ %>
<script>
(function() {
  const planSelect    = document.getElementById('reserve-plan-select');
  const pinContainer  = document.getElementById('plan-pin-container');
  const pinImg        = document.getElementById('plan-pin-img');
  const pinMarker     = document.getElementById('plan-pin-marker');
  const pinXField     = document.getElementById('reserve-pin-x');
  const pinYField     = document.getElementById('reserve-pin-y');
  const pinStatusText = document.getElementById('pin-status-text');

  if (!planSelect || !pinContainer) return;

  // Données plans disponibles depuis Rails
  const planDocs = {
    <% @plan_documents.each do |doc| %>
      "<%= doc.id %>": "<%= doc.file.attached? ? rails_blob_url(doc.file) : '' %>",
    <% end %>
  };

  // Afficher/masquer le plan selon la sélection
  planSelect.addEventListener('change', function() {
    const docId = this.value;
    const url   = planDocs[docId];
    if (docId && url) {
      pinImg.src = url;
      pinContainer.classList.remove('d-none');
      pinMarker.classList.add('d-none');
      pinXField.value = '';
      pinYField.value = '';
      if (pinStatusText) pinStatusText.textContent = 'Cliquez sur le plan pour épingler';
    } else {
      pinContainer.classList.add('d-none');
    }
  });

  // Capture du clic sur le plan → calcul coordonnées en %
  pinContainer.addEventListener('click', function(evt) {
    const rect = pinImg.getBoundingClientRect();
    const x = ((evt.clientX - rect.left) / rect.width  * 100).toFixed(2);
    const y = ((evt.clientY - rect.top)  / rect.height * 100).toFixed(2);

    pinXField.value = x;
    pinYField.value = y;

    // Afficher le marker à la bonne position
    pinMarker.style.left = x + '%';
    pinMarker.style.top  = y + '%';
    pinMarker.classList.remove('d-none');

    if (pinStatusText) pinStatusText.textContent = `📍 Épinglée (${x}%, ${y}%)`;
  });
})();

// Vue plan viewer : changer de plan dans la vue épinglée
function switchPlanViewer(docId) {
  const select = document.getElementById('plan-viewer-select');
  if (!select) return;
  const opt = select.querySelector(`option[value="${docId}"]`);
  const url = opt?.dataset?.url;
  const img = document.getElementById('plan-viewer-img');
  if (img && url) img.src = url;
}
</script>

<%# ═══════════════════════════════════════════════════════════════════════════ %>
<%# JavaScript OCR scan attestation de conformité RGIE                         %>
<%# ═══════════════════════════════════════════════════════════════════════════ %>
<script>
(function() {
  const UPLOAD_URL  = "<%= scan_attestation_conformite_project_path(@project) %>";
  const CSRF_TOKEN  = document.querySelector('meta[name="csrf-token"]')?.content || '';

  const RESULTAT_CONFIG = {
    conforme:                { label: 'Conforme',               bg: '#f0fdf4', couleur: 'text-success', icone: 'bi-shield-check',       badge: 'success' },
    conforme_avec_remarques: { label: 'Conforme avec réserves', bg: '#fffbeb', couleur: 'text-warning', icone: 'bi-shield-exclamation',  badge: 'warning' },
    non_conforme:            { label: 'Non conforme',           bg: '#fef2f2', couleur: 'text-danger',  icone: 'bi-shield-x',            badge: 'danger'  }
  };

  function set(id, val) {
    const el = document.getElementById(id);
    if (el) el.textContent = val || '—';
  }

  function setupScan() {
    const btn       = document.getElementById('btn-scan-conformite');
    const fileInput = document.getElementById('file-conformite');
    // Garde contre double initialisation (DOMContentLoaded + turbo:load)
    if (!btn || !fileInput || btn.dataset.scanBound) return;
    btn.dataset.scanBound = '1';
    btn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', evt => {
      const file = evt.target.files[0];
      if (file) uploadAttestation(file);
      fileInput.value = '';
    });
  }

  function uploadAttestation(file) {
    const statusDiv = document.getElementById('status-conformite');
    const alertDiv  = document.getElementById('alert-conformite');
    const spinner   = document.getElementById('spinner-conformite');
    const icon      = document.getElementById('icon-conformite');
    const msg       = document.getElementById('msg-conformite');
    const resultDiv = document.getElementById('result-conformite');

    statusDiv.classList.remove('d-none');
    alertDiv.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2 alert-secondary';
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    msg.textContent = 'Analyse de l\'attestation RGIE…';
    resultDiv.classList.add('d-none');

    const fd = new FormData();
    fd.append('file', file);

    fetch(UPLOAD_URL, {
      method: 'POST',
      headers: { 'X-CSRF-Token': CSRF_TOKEN, 'Accept': 'application/json' },
      body: fd
    })
    .then(r => r.json())
    .then(data => {
      spinner.classList.add('d-none');

      if (data.success) {
        const complet = data.extraction_complete;
        alertDiv.className = `alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2 alert-${complet ? 'success' : 'warning'}`;
        icon.className = `bi bi-${complet ? 'check-circle-fill' : 'exclamation-circle'} d-block`;
        msg.textContent = complet ? 'Attestation extraite et enregistrée.' : 'Extraction partielle — vérifiez les données.';

        // Remplir les champs
        set('r-conf-organisme',    data.organisme_controleur);
        set('r-conf-date',         data.date_controle);
        set('r-conf-numero',       data.numero_rapport);
        set('r-conf-prochain',     data.date_prochain_controle);
        set('r-conf-installateur', data.installateur);

        // Statut visuel
        const cfg = RESULTAT_CONFIG[data.resultat] || { label: data.resultat, bg: '#f8f9fa', couleur: 'text-secondary', icone: 'bi-shield', badge: 'secondary' };
        const iconEl  = document.getElementById('r-conf-statut-icon');
        const labelEl = document.getElementById('r-conf-statut-label');
        if (iconEl) {
          iconEl.style.background = cfg.bg;
          iconEl.innerHTML = `<i class="bi ${cfg.icone} fs-4 ${cfg.couleur}"></i>`;
        }
        if (labelEl) {
          labelEl.textContent   = cfg.label;
          labelEl.className     = `small fw-bold ${cfg.couleur} mt-1`;
        }

        const bar = document.getElementById('r-conf-confiance');
        if (bar) {
          bar.style.width = (data.confiance_ocr || 0) + '%';
          bar.className = 'progress-bar bg-' + (data.confiance_ocr >= 70 ? 'success' : data.confiance_ocr >= 40 ? 'warning' : 'danger');
        }

        resultDiv.classList.remove('d-none');
      } else {
        alertDiv.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2 alert-danger';
        icon.className = 'bi bi-x-circle-fill d-block';
        msg.textContent = data.error || 'Erreur lors du traitement.';
      }
    })
    .catch(() => {
      spinner.classList.add('d-none');
      alertDiv.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2 alert-danger';
      icon.className = 'bi bi-x-circle-fill d-block';
      msg.textContent = 'Erreur réseau. Veuillez réessayer.';
    });
  }

  document.addEventListener('DOMContentLoaded', setupScan);
  document.addEventListener('turbo:load',       setupScan);
})();
</script>
