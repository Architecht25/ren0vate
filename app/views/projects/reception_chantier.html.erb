<div class="container-fluid px-4 py-4">

  <!-- ── Header ─────────────────────────────────────────────────────────────── -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-file-earmark-check"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Réception de chantier</h1>
        <small class="text-muted"><%= @project.nom %></small>
      </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <%= link_to project_path(@project), class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour
      <% end %>
    </div>
  </div>

  <!-- ── Barre de complétion globale ────────────────────────────────────────── -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-lg-6">
          <div class="d-flex align-items-center gap-3 mb-2">
            <h5 class="mb-0 text-primary-custom fw-normal">État du dossier de réception</h5>
            <span class="badge bg-<%= @nb_obligatoires_ok == @nb_obligatoires ? 'success' : 'warning' %> fs-6">
              <%= @nb_presents %> / <%= @checklist.size %> éléments
            </span>
          </div>
          <div class="progress mb-1" style="height:10px;">
            <div class="progress-bar bg-<%= @completion_pct >= 80 ? 'success' : @completion_pct >= 50 ? 'warning' : 'danger' %>"
                 role="progressbar" style="width:<%= @completion_pct %>%"></div>
          </div>
          <small class="text-muted">
            Documents obligatoires : <%= @nb_obligatoires_ok %> / <%= @nb_obligatoires %> présents
          </small>
        </div>
        <div class="col-lg-6">
          <div class="row g-2 text-center">
            <div class="col-4">
              <div class="small text-muted">Début chantier</div>
              <div class="fw-semibold">
                <%= @project.date_début ? @project.date_début.strftime('%d/%m/%Y') : '—' %>
              </div>
            </div>
            <div class="col-4">
              <div class="small text-muted">Fin prévue</div>
              <div class="fw-semibold">
                <%= @project.date_fin ? @project.date_fin.strftime('%d/%m/%Y') : '—' %>
              </div>
            </div>
            <div class="col-4">
              <div class="small text-muted">Statut</div>
              <div>
                <span class="badge bg-<%= @project.statut == 'termine' ? 'success' : 'primary' %>">
                  <%= @project.statut&.humanize || '—' %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- COLONNE GAUCHE                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <div class="col-lg-6">

      <!-- ─── Bilan PEB ───────────────────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-graph-up-arrow me-2"></i>Bilan Performance Énergétique
          </h5>
          <%= link_to fin_chantier_project_path(@project), class: "btn btn-sm btn-outline-success" do %>
            <i class="bi bi-eye me-1"></i>Analyse complète
          <% end %>
        </div>
        <div class="card-body p-4">

          <div class="row g-3 align-items-center mb-3">
            <!-- PEB Avant -->
            <div class="col-5 text-center">
              <div class="small text-muted mb-1">Avant travaux</div>
              <% if @peb_avant.present? %>
                <div class="display-5 fw-bold text-<%= @peb_avant.couleur_bootstrap %>">
                  <%= @peb_avant.label_peb %>
                </div>
                <div class="small text-muted"><%= @peb_avant.score_ep_formate || '—' %></div>
              <% else %>
                <div class="display-5 fw-bold text-muted">?</div>
                <div class="small text-muted">Non renseigné</div>
              <% end %>
            </div>

            <!-- Flèche gain -->
            <div class="col-2 text-center">
              <% gain = @analyse_politique&.dig(:amelioration) %>
              <% if gain %>
                <% coul = gain > 0 ? 'success' : (gain == 0 ? 'secondary' : 'danger') %>
                <i class="bi bi-arrow-right fs-4 text-<%= coul %>"></i>
                <div class="small fw-bold text-<%= coul %>">
                  <%= gain > 0 ? "+#{gain}" : gain.to_s %>
                </div>
              <% else %>
                <i class="bi bi-arrow-right fs-4 text-muted"></i>
              <% end %>
            </div>

            <!-- PEB Après -->
            <div class="col-5 text-center">
              <div class="small text-muted mb-1">Après travaux</div>
              <% if @peb_actuel.present? %>
                <div class="display-5 fw-bold text-<%= @peb_actuel.couleur_bootstrap %>">
                  <%= @peb_actuel.label_peb %>
                </div>
                <div class="small text-muted"><%= @peb_actuel.score_ep_formate || '—' %></div>
              <% else %>
                <div class="display-5 fw-bold text-muted">?</div>
                <div class="small text-muted">
                  <%= link_to fin_chantier_project_path(@project), class: "btn btn-sm btn-primary mt-1" do %>
                    <i class="bi bi-camera me-1"></i>Scanner le PEB
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Validité + région -->
          <% if @peb_actuel&.date_validite.present? || @region.present? %>
            <hr class="my-2">
            <div class="d-flex justify-content-between align-items-center small text-muted flex-wrap gap-2">
              <% if @region.present? %>
                <span><i class="bi bi-geo-alt me-1"></i><%= @region.capitalize %></span>
              <% end %>
              <% if @peb_actuel&.date_validite %>
                <span>
                  <i class="bi bi-calendar3 me-1"></i>
                  Valide jusqu'au <%= @peb_actuel.date_validite.strftime('%d/%m/%Y') %>
                  <% annees = @peb_actuel.annees_validite_restantes %>
                  <% if annees && annees > 0 %>
                    <span class="badge bg-success-subtle text-success ms-1"><%= annees %>a restantes</span>
                  <% elsif annees %>
                    <span class="badge bg-danger ms-1">Expiré</span>
                  <% end %>
                </span>
              <% end %>
            </div>
          <% end %>

          <!-- Urgence réglementaire -->
          <% if @analyse_politique&.dig(:urgence_globale).present? && @analyse_politique[:urgence_globale] != :faible %>
            <% ur = @analyse_politique[:urgence_globale] %>
            <div class="alert alert-<%= PebPolitiqueRegionale.couleur_urgence(ur) %> py-2 px-3 mt-3 mb-0 small d-flex align-items-center gap-2">
              <i class="bi bi-exclamation-circle-fill"></i>
              <strong><%= PebPolitiqueRegionale.libelle_urgence(ur) %></strong>
              — Des échéances réglementaires s'appliquent.
              <%= link_to "Voir l'analyse →", fin_chantier_project_path(@project), class: "ms-auto text-nowrap" %>
            </div>
          <% end %>

        </div>
      </div>

      <!-- ─── Checklist documents de réception ─────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-card-checklist me-2"></i>Checklist documents
          </h5>
        </div>
        <div class="list-group list-group-flush">
          <% @checklist.each do |item| %>
            <div class="list-group-item px-4 py-3 d-flex align-items-start gap-3">
              <!-- Icône état -->
              <div class="flex-shrink-0 mt-1">
                <% if item[:present] %>
                  <div class="rounded-circle bg-success d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-check text-white" style="font-size:14px;"></i>
                  </div>
                <% elsif item[:obligatoire] %>
                  <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-exclamation text-white" style="font-size:14px;"></i>
                  </div>
                <% else %>
                  <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-dash text-secondary" style="font-size:14px;"></i>
                  </div>
                <% end %>
              </div>
              <!-- Contenu -->
              <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <i class="bi <%= item[:icone] %> text-<%= item[:present] ? 'success' : item[:obligatoire] ? 'danger' : 'secondary' %>"></i>
                  <span class="fw-medium small"><%= item[:titre] %></span>
                  <% if item[:obligatoire] %>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger" style="font-size:0.6rem;">Obligatoire</span>
                  <% end %>
                </div>
                <p class="text-muted mb-0 mt-1" style="font-size:0.78rem;"><%= item[:note] %></p>
              </div>
              <!-- Action -->
              <div class="flex-shrink-0">
                <% if item[:action].present? %>
                  <%= link_to item[:action], class: "btn btn-sm #{item[:present] ? 'btn-outline-success' : 'btn-outline-primary'}" do %>
                    <i class="bi bi-<%= item[:present] ? 'eye' : 'plus' %>"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- ─── Photos après travaux ──────────────────────────────────────────── -->
      <% if @docs_photos_apres.any? %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary-custom fw-normal">
              <i class="bi bi-camera me-2"></i>Photos après travaux
            </h5>
            <%= link_to photos_documents_path, class: "btn btn-sm btn-outline-secondary" do %>
              Toutes les photos
            <% end %>
          </div>
          <div class="card-body p-3">
            <div class="row g-2">
              <% @docs_photos_apres.each do |photo| %>
                <div class="col-4">
                  <% if photo.file.attached? %>
                    <%= image_tag rails_blob_url(photo.file), class: "img-fluid rounded-2 w-100",
                        style: "height:100px;object-fit:cover;",
                        alt: photo.notes.presence || "Photo après travaux" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

    </div><!-- /col gauche -->

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- COLONNE DROITE                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <div class="col-lg-6">

      <!-- ─── Bilan financier ───────────────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-cash-stack me-2"></i>Bilan financier
          </h5>
          <%= link_to edit_budget_project_path(@project), class: "btn btn-sm btn-outline-secondary" do %>
            <i class="bi bi-calculator me-1"></i>Détail
          <% end %>
        </div>
        <div class="card-body p-4">

          <!-- Tableau récap -->
          <div class="table-responsive">
            <table class="table table-sm mb-3">
              <thead class="table-light">
                <tr>
                  <th></th>
                  <th class="text-end text-muted small">Devis</th>
                  <th class="text-end text-muted small">Facturé</th>
                  <th class="text-end text-muted small">Écart</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="small"><i class="bi bi-person-badge me-1 text-muted"></i>Architecte</td>
                  <td class="text-end small"><%= number_to_currency(@total_architecte_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end small"><%= number_to_currency(@total_architecte_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <% ecart_arch = @total_architecte_factures - @total_architecte_devis %>
                  <td class="text-end small fw-medium text-<%= ecart_arch > 0 ? 'danger' : ecart_arch < 0 ? 'success' : 'muted' %>">
                    <%= ecart_arch >= 0 ? '+' : '' %><%= number_to_currency(ecart_arch, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
                <tr>
                  <td class="small"><i class="bi bi-tools me-1 text-muted"></i>Entrepreneurs</td>
                  <td class="text-end small"><%= number_to_currency(@total_entrepreneur_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end small"><%= number_to_currency(@total_entrepreneur_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <% ecart_entr = @total_entrepreneur_factures - @total_entrepreneur_devis %>
                  <td class="text-end small fw-medium text-<%= ecart_entr > 0 ? 'danger' : ecart_entr < 0 ? 'success' : 'muted' %>">
                    <%= ecart_entr >= 0 ? '+' : '' %><%= number_to_currency(ecart_entr, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
              </tbody>
              <tfoot class="table-light">
                <tr>
                  <td class="fw-semibold small">Total</td>
                  <td class="text-end fw-semibold small"><%= number_to_currency(@total_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end fw-semibold small"><%= number_to_currency(@total_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end fw-semibold small text-<%= @solde_total > 0 ? 'danger' : @solde_total < 0 ? 'success' : 'muted' %>">
                    <%= @solde_total >= 0 ? '+' : '' %><%= number_to_currency(@solde_total, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>

          <% if @solde_total > @total_devis * 0.1 && @total_devis > 0 %>
            <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-0">
              <i class="bi bi-exclamation-triangle-fill"></i>
              Les factures dépassent le devis de plus de 10 %. Vérifiez les suppléments hors devis.
            </div>
          <% end %>

        </div>
      </div>

      <!-- ─── Décompte par entrepreneur ─────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-building me-2"></i>Décompte par entrepreneur
          </h5>
        </div>

        <% if @factures_par_entreprise.any? %>
          <div class="accordion accordion-flush" id="accordionEntrepreneurs">
            <% total_general = 0 %>
            <% @factures_par_entreprise.each_with_index do |(entreprise, factures_ent), idx| %>
              <% total_ent = factures_ent.sum { |f| f.montant.to_f } %>
              <% total_general += total_ent %>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed py-2 px-4 small" type="button"
                          data-bs-toggle="collapse" data-bs-target="#ent-<%= idx %>">
                    <div class="d-flex w-100 justify-content-between align-items-center pe-2">
                      <span class="fw-medium">
                        <i class="bi bi-building me-1 text-muted"></i>
                        <%= entreprise.presence || 'Entreprise non identifiée' %>
                      </span>
                      <span class="badge bg-primary-subtle text-primary ms-3">
                        <%= number_to_currency(total_ent, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                      </span>
                    </div>
                  </button>
                </h2>
                <div id="ent-<%= idx %>" class="accordion-collapse collapse">
                  <div class="accordion-body px-4 py-2">
                    <% factures_ent.each do |f| %>
                      <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light gap-2">
                        <div class="small flex-grow-1">
                          <span class="badge bg-<%= f.type_facture == 'acompte' ? 'warning' : f.type_facture == 'solde' ? 'success' : 'primary' %>-subtle
                                       text-<%= f.type_facture == 'acompte' ? 'warning' : f.type_facture == 'solde' ? 'success' : 'primary' %> me-1">
                            <%= f.type_facture_display %>
                          </span>
                          <span class="text-muted">
                            <% if f.numero_facture.present? %>N° <%= f.numero_facture %><% end %>
                            <% if f.date_facture.present? %> — <%= f.date_facture.strftime('%d/%m/%Y') %><% end %>
                          </span>
                        </div>
                        <div class="fw-medium small text-end flex-shrink-0">
                          <%= f.montant.present? && f.montant > 0 ?
                              number_to_currency(f.montant, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') : '—' %>
                        </div>
                        <% unless f.valide_manuellement %>
                          <span class="badge bg-warning-subtle text-warning" title="À valider" style="font-size:0.6rem;">À valider</span>
                        <% end %>
                      </div>
                    <% end %>
                    <div class="d-flex justify-content-end pt-2">
                      <small class="fw-semibold">
                        Total : <%= number_to_currency(total_ent, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                      </small>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card-body p-4 text-center text-muted small">
            <i class="bi bi-inbox fs-4 d-block mb-2"></i>
            Aucune facture enregistrée. Scannez des factures via le
            <%= link_to "suivi budgétaire", edit_budget_project_path(@project) %>.
          </div>
        <% end %>
      </div>

      <!-- ─── Attestation de conformité électrique — scan OCR ──────────────── -->
      <div class="card border-0 shadow-sm mb-4" id="card-conformite">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-shield-check me-2"></i>Attestation de conformité RGIE
          </h5>
          <% if @docs_conformite.any? %>
            <span class="badge bg-success">
              <i class="bi bi-check2 me-1"></i><%= @docs_conformite.count %> attestation<%= 's' if @docs_conformite.count > 1 %>
            </span>
          <% end %>
        </div>
        <div class="card-body p-4">

          <!-- Zone de scan -->
          <div class="d-flex align-items-center gap-3 mb-3">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btn-scan-conformite">
              <i class="bi bi-camera me-1"></i>Scanner l'attestation
            </button>
            <input type="file" id="file-conformite" accept=".pdf,.jpg,.jpeg,.png" class="d-none">
            <div id="status-conformite" class="d-none flex-grow-1">
              <div class="alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2" id="alert-conformite">
                <div class="spinner-border spinner-border-sm d-none" id="spinner-conformite" role="status"></div>
                <i class="bi d-none" id="icon-conformite"></i>
                <span id="msg-conformite"></span>
              </div>
            </div>
          </div>

          <!-- Résultat OCR temps réel -->
          <div id="result-conformite" class="d-none mb-3">
            <div class="border rounded-3 p-3">
              <div class="row g-3 align-items-center">
                <!-- Statut (grande icône) -->
                <div class="col-auto text-center">
                  <div id="r-conf-statut-icon" class="rounded-circle d-flex align-items-center justify-content-center mx-auto"
                       style="width:52px;height:52px;background:#f0fdf4;">
                    <i class="bi bi-shield-check fs-4 text-success"></i>
                  </div>
                  <div id="r-conf-statut-label" class="small fw-bold text-success mt-1">—</div>
                </div>
                <!-- Données -->
                <div class="col">
                  <div class="row g-2">
                    <div class="col-sm-6">
                      <small class="text-muted d-block">Organisme de contrôle</small>
                      <span id="r-conf-organisme" class="fw-medium">—</span>
                    </div>
                    <div class="col-sm-6">
                      <small class="text-muted d-block">Date de contrôle</small>
                      <span id="r-conf-date" class="fw-medium">—</span>
                    </div>
                    <div class="col-sm-6">
                      <small class="text-muted d-block">N° rapport</small>
                      <span id="r-conf-numero" class="fw-medium small">—</span>
                    </div>
                    <div class="col-sm-6">
                      <small class="text-muted d-block">Prochain contrôle avant</small>
                      <span id="r-conf-prochain" class="fw-medium small">—</span>
                    </div>
                    <div class="col-12">
                      <small class="text-muted d-block">Installateur</small>
                      <span id="r-conf-installateur" class="fw-medium small">—</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-2">
                <small class="text-muted d-block mb-1">Confiance OCR</small>
                <div class="progress" style="height:5px;">
                  <div class="progress-bar" id="r-conf-confiance" role="progressbar" style="width:0%"></div>
                </div>
              </div>
            </div>
            <div class="mt-2 d-flex gap-2">
              <button onclick="window.location.reload()" class="btn btn-sm btn-success">
                <i class="bi bi-arrow-clockwise me-1"></i>Actualiser
              </button>
            </div>
          </div>

          <!-- Liste des attestations déjà scannées -->
          <% if @docs_conformite.any? %>
            <hr class="my-3">
            <% @docs_conformite.each do |doc| %>
              <% ocr = doc.donnees_extraites || {} %>
              <% resultat = ocr['resultat'] %>
              <% meta = AttestationConformiteOcrService.label_resultat(resultat) %>
              <div class="d-flex align-items-start gap-3 py-3 <%= 'border-bottom' unless doc == @docs_conformite.last %>">
                <!-- Icône statut -->
                <div class="flex-shrink-0">
                  <div class="rounded-circle d-flex align-items-center justify-content-center bg-<%= meta[:couleur] %>-subtle"
                       style="width:40px;height:40px;">
                    <i class="bi <%= meta[:icone] %> text-<%= meta[:couleur] %> fs-5"></i>
                  </div>
                </div>
                <!-- Données -->
                <div class="flex-grow-1 small">
                  <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <span class="fw-semibold"><%= ocr['organisme_controleur'].presence || 'Organisme non identifié' %></span>
                    <span class="badge bg-<%= meta[:couleur] %>-subtle text-<%= meta[:couleur] %> border border-<%= meta[:couleur] %>">
                      <%= meta[:label] %>
                    </span>
                  </div>
                  <div class="text-muted">
                    <% if ocr['date_controle'].present? %>
                      <i class="bi bi-calendar3 me-1"></i>Contrôle du <%=
                        Date.parse(ocr['date_controle']).strftime('%d/%m/%Y') rescue ocr['date_controle']
                      %>
                    <% end %>
                    <% if ocr['numero_rapport'].present? %>
                      &nbsp;·&nbsp;N° <%= ocr['numero_rapport'] %>
                    <% end %>
                  </div>
                  <% if ocr['date_prochain_controle'].present? %>
                    <div class="text-muted">
                      <i class="bi bi-arrow-repeat me-1"></i>Prochain contrôle avant <%=
                        Date.parse(ocr['date_prochain_controle']).strftime('%d/%m/%Y') rescue ocr['date_prochain_controle']
                      %>
                    </div>
                  <% end %>
                  <% if ocr['installateur'].present? %>
                    <div class="text-muted"><i class="bi bi-tools me-1"></i>Installateur : <%= ocr['installateur'] %></div>
                  <% end %>
                  <% if ocr['confiance_ocr'].present? %>
                    <div class="mt-1">
                      <span class="text-muted">Confiance OCR : </span>
                      <span class="<%= ocr['confiance_ocr'].to_i >= 70 ? 'text-success' : 'text-warning' %>">
                        <%= ocr['confiance_ocr'].to_i %> %
                      </span>
                    </div>
                  <% end %>
                </div>
                <!-- Actions -->
                <div class="flex-shrink-0 d-flex gap-1">
                  <% if doc.file.attached? %>
                    <%= link_to rails_blob_url(doc.file), target: '_blank', rel: 'noopener',
                        class: "btn btn-sm btn-outline-secondary", title: "Voir le document" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                  <% end %>
                  <%= button_to document_path(doc, return_context: 'reception_chantier'),
                      method: :delete,
                      form: { data: { turbo_confirm: "Supprimer cette attestation ?" } },
                      class: "btn btn-sm btn-outline-danger",
                      title: "Supprimer" do %>
                    <i class="bi bi-trash3"></i>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted small mb-0">
              <i class="bi bi-info-circle me-1"></i>
              Aucune attestation scannée. Uploadez le rapport de contrôle RGIE/AREI de l'électricien.
            </p>
          <% end %>

        </div>
      </div>

      <!-- ─── Prochaine étape : synthèse réglementaire ─────────────────────── -->
      <% if @analyse_politique.present? %>
        <% prochaines = @analyse_politique[:recommandations]&.first(2) %>
        <% if prochaines&.any? %>
          <div class="card border-0 shadow-sm border-start border-4 border-<%=
            PebPolitiqueRegionale.couleur_urgence(@analyse_politique[:urgence_globale]) %> mb-4">
            <div class="card-body p-4">
              <h6 class="text-primary-custom mb-3">
                <i class="bi bi-forward me-2"></i>Prochaines étapes réglementaires
              </h6>
              <% prochaines.each do |rec| %>
                <div class="d-flex gap-2 mb-3 small">
                  <i class="bi <%= rec[:icone] %> text-<%= rec[:couleur] %> flex-shrink-0 mt-1"></i>
                  <div>
                    <div class="fw-medium"><%= rec[:titre] %></div>
                    <div class="text-muted lh-sm"><%= rec[:description]&.truncate(150) %></div>
                  </div>
                </div>
              <% end %>
              <%= link_to fin_chantier_project_path(@project), class: "btn btn-sm btn-outline-success w-100" do %>
                <i class="bi bi-chevron-right me-1"></i>Voir toutes les recommandations
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

    </div><!-- /col droite -->
  </div><!-- /row -->
</div><!-- /container -->

<%# ═══════════════════════════════════════════════════════════════════════════ %>
<%# JavaScript OCR scan attestation de conformité RGIE                         %>
<%# ═══════════════════════════════════════════════════════════════════════════ %>
<script>
(function() {
  const UPLOAD_URL  = "<%= scan_attestation_conformite_project_path(@project) %>";
  const CSRF_TOKEN  = document.querySelector('meta[name="csrf-token"]')?.content || '';

  const RESULTAT_CONFIG = {
    conforme:                { label: 'Conforme',               bg: '#f0fdf4', couleur: 'text-success', icone: 'bi-shield-check',       badge: 'success' },
    conforme_avec_remarques: { label: 'Conforme avec réserves', bg: '#fffbeb', couleur: 'text-warning', icone: 'bi-shield-exclamation',  badge: 'warning' },
    non_conforme:            { label: 'Non conforme',           bg: '#fef2f2', couleur: 'text-danger',  icone: 'bi-shield-x',            badge: 'danger'  }
  };

  function set(id, val) {
    const el = document.getElementById(id);
    if (el) el.textContent = val || '—';
  }

  function setupScan() {
    const btn       = document.getElementById('btn-scan-conformite');
    const fileInput = document.getElementById('file-conformite');
    // Garde contre double initialisation (DOMContentLoaded + turbo:load)
    if (!btn || !fileInput || btn.dataset.scanBound) return;
    btn.dataset.scanBound = '1';
    btn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', evt => {
      const file = evt.target.files[0];
      if (file) uploadAttestation(file);
      fileInput.value = '';
    });
  }

  function uploadAttestation(file) {
    const statusDiv = document.getElementById('status-conformite');
    const alertDiv  = document.getElementById('alert-conformite');
    const spinner   = document.getElementById('spinner-conformite');
    const icon      = document.getElementById('icon-conformite');
    const msg       = document.getElementById('msg-conformite');
    const resultDiv = document.getElementById('result-conformite');

    statusDiv.classList.remove('d-none');
    alertDiv.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2 alert-secondary';
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    msg.textContent = 'Analyse de l\'attestation RGIE…';
    resultDiv.classList.add('d-none');

    const fd = new FormData();
    fd.append('file', file);

    fetch(UPLOAD_URL, {
      method: 'POST',
      headers: { 'X-CSRF-Token': CSRF_TOKEN, 'Accept': 'application/json' },
      body: fd
    })
    .then(r => r.json())
    .then(data => {
      spinner.classList.add('d-none');

      if (data.success) {
        const complet = data.extraction_complete;
        alertDiv.className = `alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2 alert-${complet ? 'success' : 'warning'}`;
        icon.className = `bi bi-${complet ? 'check-circle-fill' : 'exclamation-circle'} d-block`;
        msg.textContent = complet ? 'Attestation extraite et enregistrée.' : 'Extraction partielle — vérifiez les données.';

        // Remplir les champs
        set('r-conf-organisme',    data.organisme_controleur);
        set('r-conf-date',         data.date_controle);
        set('r-conf-numero',       data.numero_rapport);
        set('r-conf-prochain',     data.date_prochain_controle);
        set('r-conf-installateur', data.installateur);

        // Statut visuel
        const cfg = RESULTAT_CONFIG[data.resultat] || { label: data.resultat, bg: '#f8f9fa', couleur: 'text-secondary', icone: 'bi-shield', badge: 'secondary' };
        const iconEl  = document.getElementById('r-conf-statut-icon');
        const labelEl = document.getElementById('r-conf-statut-label');
        if (iconEl) {
          iconEl.style.background = cfg.bg;
          iconEl.innerHTML = `<i class="bi ${cfg.icone} fs-4 ${cfg.couleur}"></i>`;
        }
        if (labelEl) {
          labelEl.textContent   = cfg.label;
          labelEl.className     = `small fw-bold ${cfg.couleur} mt-1`;
        }

        const bar = document.getElementById('r-conf-confiance');
        if (bar) {
          bar.style.width = (data.confiance_ocr || 0) + '%';
          bar.className = 'progress-bar bg-' + (data.confiance_ocr >= 70 ? 'success' : data.confiance_ocr >= 40 ? 'warning' : 'danger');
        }

        resultDiv.classList.remove('d-none');
      } else {
        alertDiv.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2 alert-danger';
        icon.className = 'bi bi-x-circle-fill d-block';
        msg.textContent = data.error || 'Erreur lors du traitement.';
      }
    })
    .catch(() => {
      spinner.classList.add('d-none');
      alertDiv.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2 alert-danger';
      icon.className = 'bi bi-x-circle-fill d-block';
      msg.textContent = 'Erreur réseau. Veuillez réessayer.';
    });
  }

  document.addEventListener('DOMContentLoaded', setupScan);
  document.addEventListener('turbo:load',       setupScan);
})();
</script>
