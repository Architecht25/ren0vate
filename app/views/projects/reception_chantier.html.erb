<div class="container-fluid px-4 py-4">

  <!-- ── Header ─────────────────────────────────────────────────────────────── -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-file-earmark-check"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Réception de chantier</h1>
        <small class="text-muted"><%= @project.nom %></small>
      </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <%= link_to project_path(@project), class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour
      <% end %>
    </div>
  </div>

  <!-- ── Barre de complétion globale ────────────────────────────────────────── -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-lg-6">
          <div class="d-flex align-items-center gap-3 mb-2">
            <h5 class="mb-0 text-primary-custom fw-normal">État du dossier de réception</h5>
            <span class="badge bg-<%= @nb_obligatoires_ok == @nb_obligatoires ? 'success' : 'warning' %> fs-6">
              <%= @nb_presents %> / <%= @checklist.size %> éléments
            </span>
          </div>
          <div class="progress mb-1" style="height:10px;">
            <div class="progress-bar bg-<%= @completion_pct >= 80 ? 'success' : @completion_pct >= 50 ? 'warning' : 'danger' %>"
                 role="progressbar" style="width:<%= @completion_pct %>%"></div>
          </div>
          <small class="text-muted">
            Documents obligatoires : <%= @nb_obligatoires_ok %> / <%= @nb_obligatoires %> présents
          </small>
        </div>
        <div class="col-lg-6">
          <div class="row g-2 text-center">
            <div class="col-4">
              <div class="small text-muted">Début chantier</div>
              <div class="fw-semibold">
                <%= @project.date_début ? @project.date_début.strftime('%d/%m/%Y') : '—' %>
              </div>
            </div>
            <div class="col-4">
              <div class="small text-muted">Fin prévue</div>
              <div class="fw-semibold">
                <%= @project.date_fin ? @project.date_fin.strftime('%d/%m/%Y') : '—' %>
              </div>
            </div>
            <div class="col-4">
              <div class="small text-muted">Statut</div>
              <div>
                <span class="badge bg-<%= @project.statut == 'termine' ? 'success' : 'primary' %>">
                  <%= @project.statut&.humanize || '—' %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- COLONNE GAUCHE                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <div class="col-lg-6">

      <!-- ─── Bilan PEB ───────────────────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-graph-up-arrow me-2"></i>Bilan Performance Énergétique
          </h5>
          <%= link_to fin_chantier_project_path(@project), class: "btn btn-sm btn-outline-success" do %>
            <i class="bi bi-eye me-1"></i>Analyse complète
          <% end %>
        </div>
        <div class="card-body p-4">

          <div class="row g-3 align-items-center mb-3">
            <!-- PEB Avant -->
            <div class="col-5 text-center">
              <div class="small text-muted mb-1">Avant travaux</div>
              <% if @peb_avant.present? %>
                <div class="display-5 fw-bold text-<%= @peb_avant.couleur_bootstrap %>">
                  <%= @peb_avant.label_peb %>
                </div>
                <div class="small text-muted"><%= @peb_avant.score_ep_formate || '—' %></div>
              <% else %>
                <div class="display-5 fw-bold text-muted">?</div>
                <div class="small text-muted">Non renseigné</div>
              <% end %>
            </div>

            <!-- Flèche gain -->
            <div class="col-2 text-center">
              <% gain = @analyse_politique&.dig(:amelioration) %>
              <% if gain %>
                <% coul = gain > 0 ? 'success' : (gain == 0 ? 'secondary' : 'danger') %>
                <i class="bi bi-arrow-right fs-4 text-<%= coul %>"></i>
                <div class="small fw-bold text-<%= coul %>">
                  <%= gain > 0 ? "+#{gain}" : gain.to_s %>
                </div>
              <% else %>
                <i class="bi bi-arrow-right fs-4 text-muted"></i>
              <% end %>
            </div>

            <!-- PEB Après -->
            <div class="col-5 text-center">
              <div class="small text-muted mb-1">Après travaux</div>
              <% if @peb_actuel.present? %>
                <div class="display-5 fw-bold text-<%= @peb_actuel.couleur_bootstrap %>">
                  <%= @peb_actuel.label_peb %>
                </div>
                <div class="small text-muted"><%= @peb_actuel.score_ep_formate || '—' %></div>
              <% else %>
                <div class="display-5 fw-bold text-muted">?</div>
                <div class="small text-muted">
                  <%= link_to fin_chantier_project_path(@project), class: "btn btn-sm btn-primary mt-1" do %>
                    <i class="bi bi-camera me-1"></i>Scanner le PEB
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Validité + région -->
          <% if @peb_actuel&.date_validite.present? || @region.present? %>
            <hr class="my-2">
            <div class="d-flex justify-content-between align-items-center small text-muted flex-wrap gap-2">
              <% if @region.present? %>
                <span><i class="bi bi-geo-alt me-1"></i><%= @region.capitalize %></span>
              <% end %>
              <% if @peb_actuel&.date_validite %>
                <span>
                  <i class="bi bi-calendar3 me-1"></i>
                  Valide jusqu'au <%= @peb_actuel.date_validite.strftime('%d/%m/%Y') %>
                  <% annees = @peb_actuel.annees_validite_restantes %>
                  <% if annees && annees > 0 %>
                    <span class="badge bg-success-subtle text-success ms-1"><%= annees %>a restantes</span>
                  <% elsif annees %>
                    <span class="badge bg-danger ms-1">Expiré</span>
                  <% end %>
                </span>
              <% end %>
            </div>
          <% end %>

          <!-- Urgence réglementaire -->
          <% if @analyse_politique&.dig(:urgence_globale).present? && @analyse_politique[:urgence_globale] != :faible %>
            <% ur = @analyse_politique[:urgence_globale] %>
            <div class="alert alert-<%= PebPolitiqueRegionale.couleur_urgence(ur) %> py-2 px-3 mt-3 mb-0 small d-flex align-items-center gap-2">
              <i class="bi bi-exclamation-circle-fill"></i>
              <strong><%= PebPolitiqueRegionale.libelle_urgence(ur) %></strong>
              — Des échéances réglementaires s'appliquent.
              <%= link_to "Voir l'analyse →", fin_chantier_project_path(@project), class: "ms-auto text-nowrap" %>
            </div>
          <% end %>

        </div>
      </div>

      <!-- ─── Checklist documents de réception ─────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-card-checklist me-2"></i>Checklist documents
          </h5>
        </div>
        <div class="list-group list-group-flush">
          <% @checklist.each do |item| %>
            <div class="list-group-item px-4 py-3 d-flex align-items-start gap-3">
              <!-- Icône état -->
              <div class="flex-shrink-0 mt-1">
                <% if item[:present] %>
                  <div class="rounded-circle bg-success d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-check text-white" style="font-size:14px;"></i>
                  </div>
                <% elsif item[:obligatoire] %>
                  <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-exclamation text-white" style="font-size:14px;"></i>
                  </div>
                <% else %>
                  <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-dash text-secondary" style="font-size:14px;"></i>
                  </div>
                <% end %>
              </div>
              <!-- Contenu -->
              <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <i class="bi <%= item[:icone] %> text-<%= item[:present] ? 'success' : item[:obligatoire] ? 'danger' : 'secondary' %>"></i>
                  <span class="fw-medium small"><%= item[:titre] %></span>
                  <% if item[:obligatoire] %>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger" style="font-size:0.6rem;">Obligatoire</span>
                  <% end %>
                </div>
                <p class="text-muted mb-0 mt-1" style="font-size:0.78rem;"><%= item[:note] %></p>
              </div>
              <!-- Action -->
              <div class="flex-shrink-0">
                <% if item[:action].present? %>
                  <%= link_to item[:action], class: "btn btn-sm #{item[:present] ? 'btn-outline-success' : 'btn-outline-primary'}" do %>
                    <i class="bi bi-<%= item[:present] ? 'eye' : 'plus' %>"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- ─── Photos après travaux ──────────────────────────────────────────── -->
      <% if @docs_photos_apres.any? %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary-custom fw-normal">
              <i class="bi bi-camera me-2"></i>Photos après travaux
            </h5>
            <%= link_to photos_documents_path, class: "btn btn-sm btn-outline-secondary" do %>
              Toutes les photos
            <% end %>
          </div>
          <div class="card-body p-3">
            <div class="row g-2">
              <% @docs_photos_apres.each do |photo| %>
                <div class="col-4">
                  <% if photo.file.attached? %>
                    <%= image_tag rails_blob_url(photo.file), class: "img-fluid rounded-2 w-100",
                        style: "height:100px;object-fit:cover;",
                        alt: photo.notes.presence || "Photo après travaux" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

    </div><!-- /col gauche -->

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- COLONNE DROITE                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <div class="col-lg-6">

      <!-- ─── Bilan financier ───────────────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-cash-stack me-2"></i>Bilan financier
          </h5>
          <%= link_to edit_budget_project_path(@project), class: "btn btn-sm btn-outline-secondary" do %>
            <i class="bi bi-calculator me-1"></i>Détail
          <% end %>
        </div>
        <div class="card-body p-4">

          <!-- Tableau récap -->
          <div class="table-responsive">
            <table class="table table-sm mb-3">
              <thead class="table-light">
                <tr>
                  <th></th>
                  <th class="text-end text-muted small">Devis</th>
                  <th class="text-end text-muted small">Facturé</th>
                  <th class="text-end text-muted small">Écart</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="small"><i class="bi bi-person-badge me-1 text-muted"></i>Architecte</td>
                  <td class="text-end small"><%= number_to_currency(@total_architecte_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end small"><%= number_to_currency(@total_architecte_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <% ecart_arch = @total_architecte_factures - @total_architecte_devis %>
                  <td class="text-end small fw-medium text-<%= ecart_arch > 0 ? 'danger' : ecart_arch < 0 ? 'success' : 'muted' %>">
                    <%= ecart_arch >= 0 ? '+' : '' %><%= number_to_currency(ecart_arch, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
                <tr>
                  <td class="small"><i class="bi bi-tools me-1 text-muted"></i>Entrepreneurs</td>
                  <td class="text-end small"><%= number_to_currency(@total_entrepreneur_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end small"><%= number_to_currency(@total_entrepreneur_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <% ecart_entr = @total_entrepreneur_factures - @total_entrepreneur_devis %>
                  <td class="text-end small fw-medium text-<%= ecart_entr > 0 ? 'danger' : ecart_entr < 0 ? 'success' : 'muted' %>">
                    <%= ecart_entr >= 0 ? '+' : '' %><%= number_to_currency(ecart_entr, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
              </tbody>
              <tfoot class="table-light">
                <tr>
                  <td class="fw-semibold small">Total</td>
                  <td class="text-end fw-semibold small"><%= number_to_currency(@total_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end fw-semibold small"><%= number_to_currency(@total_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end fw-semibold small text-<%= @solde_total > 0 ? 'danger' : @solde_total < 0 ? 'success' : 'muted' %>">
                    <%= @solde_total >= 0 ? '+' : '' %><%= number_to_currency(@solde_total, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>

          <% if @solde_total > @total_devis * 0.1 && @total_devis > 0 %>
            <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-0">
              <i class="bi bi-exclamation-triangle-fill"></i>
              Les factures dépassent le devis de plus de 10 %. Vérifiez les suppléments hors devis.
            </div>
          <% end %>

        </div>
      </div>

      <!-- ─── Réserves de réception (punch list) ───────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4" id="reserves">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-0 text-primary-custom fw-normal">
              <i class="bi bi-list-check me-2"></i>Réserves de réception
            </h5>
            <% actives = @project.reserves.actives.count %>
            <% if actives > 0 %>
              <small class="text-warning">
                <i class="bi bi-exclamation-triangle me-1"></i><%= actives %> réserve<%= 's' if actives > 1 %> en attente
              </small>
            <% else %>
              <small class="text-success">
                <i class="bi bi-check-circle me-1"></i>Aucune réserve ouverte
              </small>
            <% end %>
          </div>
          <button class="btn btn-sm btn-outline-primary rounded-3" type="button"
                  data-bs-toggle="collapse" data-bs-target="#form-reserve-<%= @project.id %>">
            <i class="bi bi-plus me-1"></i>Ajouter
          </button>
        </div>

        <%# Formulaire d'ajout de réserve %>
        <div class="collapse" id="form-reserve-<%= @project.id %>">
          <%= form_with url: project_reserves_path(@project), method: :post,
                        data: { turbo: false }, multipart: true do |f| %>
            <div class="p-3 border-bottom bg-light">
              <div class="row g-2">
                <div class="col-12">
                  <%= f.text_area :description, class: "form-control form-control-sm rounded-3",
                      rows: 2, placeholder: "Description du défaut constaté (ex : fissure au plafond chambre 2, joint douche non posé…)", required: true %>
                </div>
                <div class="col-sm-6">
                  <%= f.text_field :responsable, class: "form-control form-control-sm rounded-3",
                      placeholder: "Responsable (entrepreneur ou corps de métier)" %>
                </div>
                <div class="col-sm-3">
                  <%= f.date_field :date_constat, class: "form-control form-control-sm rounded-3",
                      value: Date.current %>
                </div>
                <div class="col-sm-3">
                  <%= f.date_field :date_limite, class: "form-control form-control-sm rounded-3",
                      placeholder: "Délai levée" %>
                </div>
                <!-- Photo du défaut -->
                <div class="col-sm-6">
                  <label class="form-label small text-muted mb-1">Photo du défaut (optionnel)</label>
                  <%= f.file_field :photo, class: "form-control form-control-sm rounded-3",
                      accept: "image/*", capture: "environment" %>
                </div>
                <!-- Étage / localisation -->
                <div class="col-sm-6">
                  <%= f.text_field :etage, class: "form-control form-control-sm rounded-3",
                      placeholder: "Étage / localisation (ex: RdC, Cuisine)" %>
                </div>
                <!-- Épingle sur plan (si plans disponibles) -->
                <% if @plan_documents.any? %>
                  <div class="col-12">
                    <label class="form-label small text-muted mb-1">
                      <i class="bi bi-geo-alt me-1"></i>Épingler sur un plan
                    </label>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                      <%= f.select :plan_document_id,
                          options_for_select([['— Choisir un plan —', '']] + @plan_documents.map { |d| [d.notes.presence || "Plan #{d.id}", d.id] }),
                          {}, { class: "form-select form-select-sm rounded-3 w-auto", id: "reserve-plan-select" } %>
                      <span class="small text-muted" id="pin-status-text">Cliquez sur le plan pour épingler</span>
                    </div>
                    <!-- Conteneur plan interactif -->
                    <div id="plan-pin-container" class="d-none mt-2 position-relative border rounded-3 overflow-hidden"
                         style="cursor:crosshair;max-height:300px;">
                      <img id="plan-pin-img" src="" alt="Plan" class="img-fluid w-100" style="display:block;">
                      <div id="plan-pin-marker" class="d-none position-absolute"
                           style="width:24px;height:24px;margin-left:-12px;margin-top:-24px;pointer-events:none;">
                        <i class="bi bi-geo-alt-fill text-danger" style="font-size:24px;"></i>
                      </div>
                    </div>
                    <%= f.hidden_field :pin_x, id: "reserve-pin-x" %>
                    <%= f.hidden_field :pin_y, id: "reserve-pin-y" %>
                  </div>
                <% end %>

                <div class="col-12 d-flex justify-content-end gap-2">
                  <button type="button" class="btn btn-sm btn-outline-secondary rounded-3"
                          data-bs-toggle="collapse" data-bs-target="#form-reserve-<%= @project.id %>">
                    Annuler
                  </button>
                  <%= f.submit "Ajouter la réserve", class: "btn btn-sm btn-primary rounded-3" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <%# Liste des réserves %>
        <% reserves_all = @project.reserves.order(statut: :asc, created_at: :desc) %>
        <% if reserves_all.any? %>
          <div class="list-group list-group-flush">
            <% reserves_all.each do |reserve| %>
              <div class="list-group-item px-4 py-3 <%= 'bg-success-subtle' if reserve.levee? %>">
                <div class="d-flex align-items-start gap-3">
                  <%# Icône statut %>
                  <div class="flex-shrink-0 mt-1">
                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-<%= reserve.statut_color %>-subtle"
                         style="width:32px;height:32px;">
                      <i class="bi <%= reserve.statut_icon %> text-<%= reserve.statut_color %>" style="font-size:1rem;"></i>
                    </div>
                  </div>
                  <%# Contenu %>
                  <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                      <span class="badge bg-<%= reserve.statut_color %>-subtle text-<%= reserve.statut_color %> border border-<%= reserve.statut_color %>"
                            style="font-size:0.65rem;"><%= reserve.statut_label %></span>
                      <% if reserve.responsable.present? %>
                        <span class="small text-muted">
                          <i class="bi bi-person me-1"></i><%= reserve.responsable %>
                        </span>
                      <% end %>
                      <% if reserve.date_limite.present? %>
                        <% overdue = !reserve.levee? && reserve.date_limite < Date.current %>
                        <span class="small <%= overdue ? 'text-danger fw-semibold' : 'text-muted' %>">
                          <i class="bi bi-calendar3 me-1"></i>
                          Délai : <%= reserve.date_limite.strftime('%d/%m/%Y') %>
                          <% if overdue %><i class="bi bi-exclamation-triangle ms-1"></i><% end %>
                        </span>
                      <% end %>
                    </div>
                    <p class="mb-0 small <%= reserve.levee? ? 'text-decoration-line-through text-muted' : '' %>">
                      <%= reserve.description %>
                    </p>
                    <% if reserve.notes.present? %>
                      <p class="mb-0 text-muted fst-italic mt-1" style="font-size:0.75rem;"><%= reserve.notes %></p>
                    <% end %>
                    <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                      <span class="text-muted" style="font-size:0.68rem;">
                        Constatée le <%= reserve.date_constat&.strftime('%d/%m/%Y') || reserve.created_at.strftime('%d/%m/%Y') %>
                      </span>
                      <% if reserve.etage.present? %>
                        <span class="badge bg-secondary-subtle text-secondary" style="font-size:0.6rem;">
                          <i class="bi bi-layers me-1"></i><%= reserve.etage %>
                        </span>
                      <% end %>
                      <% if reserve.has_pin? %>
                        <span class="badge bg-info-subtle text-info" style="font-size:0.6rem;">
                          <i class="bi bi-geo-alt me-1"></i>Épinglée sur plan
                        </span>
                      <% end %>
                      <% if reserve.photo.attached? %>
                        <a href="<%= rails_blob_url(reserve.photo) %>" target="_blank" rel="noopener"
                           class="badge bg-primary-subtle text-primary text-decoration-none" style="font-size:0.6rem;">
                          <i class="bi bi-camera me-1"></i>Photo
                        </a>
                      <% end %>
                    </div>
                  </div>
                  <%# Actions %>
                  <div class="flex-shrink-0 d-flex flex-column gap-1 align-items-end">
                    <% unless reserve.levee? %>
                      <%# Bouton Marquer levée %>
                      <%= button_to project_reserve_path(@project, reserve),
                          method: :patch,
                          params: { reserve: { statut: 'levee' } },
                          class: "btn btn-xs btn-outline-success rounded-3 py-0 px-2",
                          title: "Marquer comme levée",
                          style: "font-size:0.7rem;" do %>
                        <i class="bi bi-check2-circle me-1"></i>Levée
                      <% end %>
                      <%# Bouton En cours %>
                      <% if reserve.ouverte? %>
                        <%= button_to project_reserve_path(@project, reserve),
                            method: :patch,
                            params: { reserve: { statut: 'en_cours' } },
                            class: "btn btn-xs btn-outline-warning rounded-3 py-0 px-2",
                            title: "Marquer en cours",
                            style: "font-size:0.7rem;" do %>
                          <i class="bi bi-clock me-1"></i>En cours
                        <% end %>
                      <% end %>
                    <% else %>
                      <%# Rouvrir %>
                      <%= button_to project_reserve_path(@project, reserve),
                          method: :patch,
                          params: { reserve: { statut: 'ouverte' } },
                          class: "btn btn-xs btn-outline-secondary rounded-3 py-0 px-2",
                          style: "font-size:0.7rem;" do %>
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Rouvrir
                      <% end %>
                    <% end %>
                    <%# Supprimer %>
                    <%= button_to project_reserve_path(@project, reserve),
                        method: :delete,
                        form: { data: { turbo_confirm: "Supprimer cette réserve ?" } },
                        class: "btn btn-xs btn-outline-danger rounded-3 py-0 px-2",
                        style: "font-size:0.7rem;" do %>
                      <i class="bi bi-trash3"></i>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card-body p-4 text-center text-muted small">
            <i class="bi bi-clipboard-check fs-4 d-block mb-2 text-success"></i>
            Aucune réserve enregistrée pour ce chantier.
            <div class="mt-2 text-muted" style="font-size:0.78rem;">
              Ajoutez les défauts constatés lors de la visite de réception pour en assurer le suivi.
            </div>
          </div>
        <% end %>
      </div>

      <!-- ─── Vue Plan : annotations épinglées ─────────────────────────────── -->
      <% pinned = @project.reserves.where.not(pin_x: nil).where.not(plan_document_id: nil) %>
      <% if @plan_documents.any? || pinned.any? %>
        <div class="card border-0 shadow-sm mb-4" id="vue-plan">
          <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary-custom fw-normal">
              <i class="bi bi-map me-2"></i>Vue Plan — Réserves épinglées
            </h5>
            <% if @plan_documents.many? %>
              <select class="form-select form-select-sm rounded-3 w-auto" id="plan-viewer-select"
                      onchange="switchPlanViewer(this.value)">
                <% @plan_documents.each do |doc| %>
                  <option value="<%= doc.id %>"
                          data-url="<%= doc.file.attached? ? rails_blob_url(doc.file) : '' %>">
                    <%= doc.notes.presence || "Plan #{doc.id}" %>
                  </option>
                <% end %>
              </select>
            <% end %>
          </div>
          <div class="card-body p-3">
            <% first_plan = @plan_documents.first %>
            <% if first_plan&.file&.attached? %>
              <div class="position-relative border rounded-3 overflow-hidden" id="plan-viewer-container">
                <img id="plan-viewer-img"
                     src="<%= rails_blob_url(first_plan.file) %>"
                     alt="Plan" class="img-fluid w-100" style="display:block;">
                <% pinned.select { |r| r.plan_document_id == first_plan.id }.each do |reserve| %>
                  <div class="position-absolute" title="<%= reserve.description %>"
                       style="left:<%= reserve.pin_x %>%;top:<%= reserve.pin_y %>%;
                              transform:translate(-50%,-100%);pointer-events:none;">
                    <i class="bi bi-geo-alt-fill text-<%= reserve.statut_color %>" style="font-size:20px;
                       filter:drop-shadow(0 1px 2px rgba(0,0,0,.5));"></i>
                  </div>
                <% end %>
              </div>
              <p class="small text-muted mt-2 mb-0">
                <i class="bi bi-info-circle me-1"></i>
                <%= pinned.count %> réserve<%= 's' if pinned.count != 1 %> épinglée<%= 's' if pinned.count != 1 %> sur ce projet.
              </p>
            <% else %>
              <div class="text-center text-muted py-4 small">
                <i class="bi bi-map fs-3 d-block mb-2"></i>
                Uploadez un plan (type « Plan ») dans la GED pour épingler les réserves dessus.
                <%= link_to project_documents_path(@project), class: "btn btn-sm btn-outline-primary mt-2" do %>
                  <i class="bi bi-upload me-1"></i>Uploader un plan
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- ─── Checklists d'inspection par phase ───────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4" id="checklists">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-0 text-primary-custom fw-normal">
              <i class="bi bi-clipboard2-check me-2"></i>Inspections de chantier
            </h5>
            <% done = @project_checklists.count { |c| c.completed? } %>
            <small class="text-muted">
              <%= @project_checklists.count %> inspection<%= 's' if @project_checklists.count != 1 %> lancée<%= 's' if @project_checklists.count != 1 %>
              <% if done > 0 %>
                — <span class="text-success"><%= done %> terminée<%= 's' if done != 1 %></span>
              <% end %>
            </small>
          </div>
          <button class="btn btn-sm btn-outline-primary rounded-3" type="button"
                  data-bs-toggle="collapse" data-bs-target="#form-checklist-<%= @project.id %>">
            <i class="bi bi-plus me-1"></i>Démarrer
          </button>
        </div>

        <!-- Formulaire : choisir un template -->
        <div class="collapse" id="form-checklist-<%= @project.id %>">
          <div class="p-3 border-bottom bg-light">
            <p class="small text-muted mb-2">Choisissez le type d'inspection à démarrer :</p>
            <div class="row g-2">
              <% @checklist_templates.each do |tpl| %>
                <div class="col-sm-6">
                  <%= form_with url: project_project_checklists_path(@project), method: :post,
                                data: { turbo: false } do |f| %>
                    <%= f.hidden_field :checklist_template_id, value: tpl.id %>
                    <button type="submit" class="btn btn-outline-<%= tpl.phase_color %> rounded-3 w-100 text-start p-2">
                      <div class="d-flex align-items-center gap-2">
                        <i class="bi <%= tpl.phase_icon %> fs-5"></i>
                        <div>
                          <div class="fw-semibold small"><%= tpl.name %></div>
                          <div class="text-muted" style="font-size:0.72rem;"><%= tpl.checklist_items.count %> points de contrôle</div>
                        </div>
                      </div>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div class="text-end mt-2">
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-3"
                      data-bs-toggle="collapse" data-bs-target="#form-checklist-<%= @project.id %>">
                Annuler
              </button>
            </div>
          </div>
        </div>

        <!-- Liste des inspections lancées -->
        <% if @project_checklists.any? %>
          <div class="list-group list-group-flush">
            <% @project_checklists.each do |pc| %>
              <div class="list-group-item px-4 py-3 d-flex align-items-center gap-3">
                <div class="flex-shrink-0">
                  <div class="rounded-circle d-flex align-items-center justify-content-center
                               bg-<%= pc.completed? ? 'success' : pc.checklist_template.phase_color %>-subtle"
                       style="width:36px;height:36px;">
                    <i class="bi <%= pc.checklist_template.phase_icon %>
                               text-<%= pc.completed? ? 'success' : pc.checklist_template.phase_color %>"></i>
                  </div>
                </div>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <span class="fw-medium small"><%= pc.checklist_template.name %></span>
                    <span class="badge bg-<%= pc.checklist_template.phase_color %>-subtle
                                 text-<%= pc.checklist_template.phase_color %> border" style="font-size:0.6rem;">
                      <%= pc.checklist_template.phase_label %>
                    </span>
                    <% if pc.completed? %>
                      <span class="badge bg-success-subtle text-success border" style="font-size:0.6rem;">
                        <i class="bi bi-check-circle me-1"></i>Terminée
                      </span>
                    <% end %>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height:5px;max-width:120px;">
                      <div class="progress-bar bg-<%= pc.completed? ? 'success' : 'primary' %>"
                           style="width:<%= pc.progress_pct %>%"></div>
                    </div>
                    <span class="small text-muted"><%= pc.progress_pct %>%</span>
                  </div>
                </div>
                <%= link_to project_project_checklist_path(@project, pc),
                            class: "btn btn-sm btn-outline-primary rounded-3 flex-shrink-0" do %>
                  <i class="bi bi-eye me-1"></i>Ouvrir
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card-body p-4 text-center text-muted small">
            <i class="bi bi-clipboard2 fs-4 d-block mb-2 text-secondary"></i>
            Aucune inspection démarrée.
            <div class="mt-2" style="font-size:0.78rem;">
              Démarrez une inspection pour contrôler chaque phase : gros œuvre, second œuvre, finitions ou réception.
            </div>
          </div>
        <% end %>
      </div>

      <!-- ─── PV de réception numérique ─────────────────────────────────────── -->
      <% pv = @project.pv_reception %>
      <div class="card border-0 shadow-sm mb-4" id="pv-reception">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-0 text-primary-custom fw-normal">
              <i class="bi bi-patch-check me-2"></i>PV de Réception
              <span class="badge bg-primary ms-1" style="font-size:0.6rem;vertical-align:middle;">Numérique</span>
            </h5>
            <% if pv %>
              <small class="text-<%= pv.statut_color %>">
                <i class="bi <%= pv.statut_icon %> me-1"></i><%= pv.statut_label %>
                <% if pv.envoye? %>— <%= pv.nb_signatures %>/<%= pv.nb_signatures_attendues %> signatures<% end %>
              </small>
            <% else %>
              <small class="text-muted">Procès-Verbal 3-parties horodaté</small>
            <% end %>
          </div>
          <div class="d-flex gap-2">
            <% if pv %>
              <%= link_to project_pv_reception_path(@project), class: "btn btn-sm btn-outline-primary" do %>
                <i class="bi bi-eye me-1"></i>Voir le PV
              <% end %>
            <% elsif @project.user_id == current_user.id %>
              <button class="btn btn-sm btn-primary" type="button"
                      data-bs-toggle="collapse" data-bs-target="#form-pv-<%= @project.id %>">
                <i class="bi bi-plus me-1"></i>Créer le PV
              </button>
            <% end %>
          </div>
        </div>

        <%# Formulaire de création du PV (owner seulement) %>
        <% if pv.nil? && @project.user_id == current_user.id %>
          <div class="collapse" id="form-pv-<%= @project.id %>">
            <%= form_with url: project_pv_reception_path(@project), method: :post,
                          data: { turbo: false } do |f| %>
              <div class="p-3 border-bottom bg-light">
                <div class="row g-2">
                  <div class="col-sm-6">
                    <%= f.label :date_reception, "Date de réception", class: "form-label small fw-semibold" %>
                    <%= f.date_field :date_reception, class: "form-control form-control-sm rounded-3",
                        value: Date.current, name: "pv_reception[date_reception]" %>
                  </div>
                  <div class="col-12">
                    <%= f.label :observations, "Observations générales (facultatif)", class: "form-label small fw-semibold" %>
                    <%= f.text_area :observations, class: "form-control form-control-sm rounded-3",
                        rows: 2, placeholder: "Travaux réalisés conformément aux plans. Réserves listées ci-dessus…",
                        name: "pv_reception[observations]" %>
                  </div>
                  <div class="col-12 small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Les parties identifiées (maître d'ouvrage, architecte, entrepreneur) seront détectées
                    depuis les membres actifs du projet.
                  </div>
                  <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3"
                            data-bs-toggle="collapse" data-bs-target="#form-pv-<%= @project.id %>">
                      Annuler
                    </button>
                    <%= f.submit "Créer le PV de réception", class: "btn btn-sm btn-primary rounded-3" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <%# Aperçu condensé si PV existant %>
        <% if pv %>
          <div class="card-body p-4">
            <div class="row g-3 align-items-center">
              <div class="col-sm-6">
                <div class="small text-muted">Date de réception</div>
                <div class="fw-semibold">
                  <%= pv.date_reception ? pv.date_reception.strftime('%d/%m/%Y') : '—' %>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="small text-muted">Signatures</div>
                <div class="d-flex gap-1 flex-wrap mt-1">
                  <% [
                    { nom: pv.nom_owner,        signed: pv.signed_owner?,        label: "MO",   skip: false },
                    { nom: pv.nom_architect,    signed: pv.signed_architect?,    label: "Arch", skip: pv.email_architect.blank? },
                    { nom: pv.nom_entrepreneur, signed: pv.signed_entrepreneur?, label: "Entr", skip: pv.email_entrepreneur.blank? }
                  ].each do |s| %>
                    <% next if s[:skip] %>
                    <span class="badge bg-<%= s[:signed] ? 'success' : 'secondary' %>-subtle text-<%= s[:signed] ? 'success' : 'secondary' %> border"
                          title="<%= s[:nom] %>" style="font-size:0.65rem;">
                      <i class="bi bi-<%= s[:signed] ? 'check2' : 'clock' %> me-1"></i><%= s[:label] %>
                    </span>
                  <% end %>
                </div>
              </div>
              <% if pv.finalise? %>
                <div class="col-12">
                  <div class="alert alert-success py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-patch-check-fill"></i>
                    <strong>PV finalisé</strong> — Toutes les signatures ont été recueillies.
                    <%= link_to print_project_pv_reception_path(@project), target: "_blank",
                        class: "ms-auto btn btn-sm btn-outline-success" do %>
                      <i class="bi bi-printer me-1"></i>PDF
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="card-body p-4 text-center text-muted small">
            <i class="bi bi-patch-check fs-4 d-block mb-2 text-secondary"></i>
            Aucun PV créé pour ce chantier.
            <% if @project.user_id == current_user.id %>
              <div class="mt-2" style="font-size:0.78rem;">
                Créez le PV pour recueillir les signatures des 3 parties (maître d'ouvrage, architecte, entrepreneur).
              </div>
            <% end %>
          </div>
        <% end %>

      </div><!-- /card PV -->

      <!-- ─── Décompte par entrepreneur ─────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-building me-2"></i>Décompte par entrepreneur
          </h5>
        </div>

        <% if @factures_par_entreprise.any? %>
          <div class="accordion accordion-flush" id="accordionEntrepreneurs">
            <% total_general = 0 %>
            <% @factures_par_entreprise.each_with_index do |(entreprise, factures_ent), idx| %>
              <% total_ent = factures_ent.sum { |f| f.montant.to_f } %>
              <% total_general += total_ent %>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed py-2 px-4 small" type="button"
                          data-bs-toggle="collapse" data-bs-target="#ent-<%= idx %>">
                    <div class="d-flex w-100 justify-content-between align-items-center pe-2">
                      <span class="fw-medium">
                        <i class="bi bi-building me-1 text-muted"></i>
                        <%= entreprise.presence || 'Entreprise non identifiée' %>
                      </span>
                      <span class="badge bg-primary-subtle text-primary ms-3">
                        <%= number_to_currency(total_ent, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                      </span>
                    </div>
                  </button>
                </h2>
                <div id="ent-<%= idx %>" class="accordion-collapse collapse">
                  <div class="accordion-body px-4 py-2">
                    <% factures_ent.each do |f| %>
                      <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light gap-2">
                        <div class="small flex-grow-1">
                          <span class="badge bg-<%= f.type_facture == 'acompte' ? 'warning' : f.type_facture == 'solde' ? 'success' : 'primary' %>-subtle
                                       text-<%= f.type_facture == 'acompte' ? 'warning' : f.type_facture == 'solde' ? 'success' : 'primary' %> me-1">
                            <%= f.type_facture_display %>
                          </span>
                          <span class="text-muted">
                            <% if f.numero_facture.present? %>N° <%= f.numero_facture %><% end %>
                            <% if f.date_facture.present? %> — <%= f.date_facture.strftime('%d/%m/%Y') %><% end %>
                          </span>
                        </div>
                        <div class="fw-medium small text-end flex-shrink-0">
                          <%= f.montant.present? && f.montant > 0 ?
                              number_to_currency(f.montant, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') : '—' %>
                        </div>
                        <% unless f.valide_manuellement %>
                          <span class="badge bg-warning-subtle text-warning" title="À valider" style="font-size:0.6rem;">À valider</span>
                        <% end %>
                      </div>
                    <% end %>
                    <div class="d-flex justify-content-end pt-2">
                      <small class="fw-semibold">
                        Total : <%= number_to_currency(total_ent, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                      </small>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card-body p-4 text-center text-muted small">
            <i class="bi bi-inbox fs-4 d-block mb-2"></i>
            Aucune facture enregistrée. Scannez des factures via le
            <%= link_to "suivi budgétaire", edit_budget_project_path(@project) %>.
          </div>
        <% end %>
      </div>

      <!-- ─── Attestation de conformité électrique — scan OCR ──────────────── -->
      <div class="card border-0 shadow-sm mb-4" id="card-conformite">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-shield-check me-2"></i>Attestation de conformité RGIE
          </h5>
          <% if @docs_conformite.any? %>
            <span class="badge bg-success">
              <i class="bi bi-check2 me-1"></i><%= @docs_conformite.count %> attestation<%= 's' if @docs_conformite.count > 1 %>
            </span>
          <% end %>
        </div>
        <div class="card-body p-4">

          <!-- Zone de scan -->
          <div class="d-flex align-items-center gap-3 mb-3">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btn-scan-conformite">
              <i class="bi bi-camera me-1"></i>Scanner l'attestation
            </button>
            <input type="file" id="file-conformite" accept=".pdf,.jpg,.jpeg,.png" class="d-none">
            <div id="status-conformite" class="d-none flex-grow-1">
              <div class="alert border-0 rounded-2 py-1 px-2 mb-0 small d-flex align-items-center gap-2" id="alert-conformite">
                <div class="spinner-border spinner-border-sm d-none" id="spinner-conformite" role="status"></div>
                <i class="bi d-none" id="icon-conformite"></i>
                <span id="msg-conformite"></span>
              </div>
            </div>
          </div>

          <!-- Résultat OCR temps réel -->
          <div id="result-conformite" class="d-none mb-3">
            <div class="border rounded-3 p-3">
              <div class="row g-3 align-items-center">
                <!-- Statut (grande icône) -->
                <div class="col-auto text-center">
                  <div id="r-conf-statut-icon" class="rounded-circle d-flex align-items-center justify-content-center mx-auto"
                       style="width:52px;height:52px;background:#f0fdf4;">
                    <i class="bi bi-shield-check fs-4 text-success"></i>
                  </div>
                  <div id="r-conf-statut-label" class="small fw-bold text-success mt-1">—</div>
                </div>
                <!-- Données -->
                <div class="col">
                  <div class="row g-2">
                    <div class="col-sm-6">
                      <small class="text-muted d-block">Organisme de contrôle</small>
                      <span id="r-conf-organisme" class="fw-medium">—</span>
                    </div>
                    <div class="col-sm-6">
                      <small class="text-muted d-block">Date de contrôle</small>
                      <span id="r-conf-date" class="fw-medium">—</span>
                    </div>
                    <div class="col-sm-6">
                      <small class="text-muted d-block">N° rapport</small>
                      <span id="r-conf-numero" class="fw-medium small">—</span>
                    </div>
                    <div class="col-sm-6">
                      <small class="text-muted d-block">Prochain contrôle avant</small>
                      <span id="r-conf-prochain" class="fw-medium small">—</span>
                    </div>
                    <div class="col-12">
                      <small class="text-muted d-block">Installateur</small>
                      <span id="r-conf-installateur" class="fw-medium small">—</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="mt-2">
                <small class="text-muted d-block mb-1">Confiance OCR</small>
                <div class="progress" style="height:5px;">
                  <div class="progress-bar" id="r-conf-confiance" role="progressbar" style="width:0%"></div>
                </div>
              </div>
            </div>
            <div class="mt-2 d-flex gap-2">
              <button onclick="window.location.reload()" class="btn btn-sm btn-success">
                <i class="bi bi-arrow-clockwise me-1"></i>Actualiser
              </button>
            </div>
          </div>

          <!-- Liste des attestations déjà scannées -->
          <% if @docs_conformite.any? %>
            <hr class="my-3">
            <% @docs_conformite.each do |doc| %>
              <% ocr = doc.donnees_extraites || {} %>
              <% resultat = ocr['resultat'] %>
              <% meta = AttestationConformiteOcrService.label_resultat(resultat) %>
              <div class="d-flex align-items-start gap-3 py-3 <%= 'border-bottom' unless doc == @docs_conformite.last %>">
                <!-- Icône statut -->
                <div class="flex-shrink-0">
                  <div class="rounded-circle d-flex align-items-center justify-content-center bg-<%= meta[:couleur] %>-subtle"
                       style="width:40px;height:40px;">
                    <i class="bi <%= meta[:icone] %> text-<%= meta[:couleur] %> fs-5"></i>
                  </div>
                </div>
                <!-- Données -->
                <div class="flex-grow-1 small">
                  <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <span class="fw-semibold"><%= ocr['organisme_controleur'].presence || 'Organisme non identifié' %></span>
                    <span class="badge bg-<%= meta[:couleur] %>-subtle text-<%= meta[:couleur] %> border border-<%= meta[:couleur] %>">
                      <%= meta[:label] %>
                    </span>
                  </div>
                  <div class="text-muted">
                    <% if ocr['date_controle'].present? %>
                      <i class="bi bi-calendar3 me-1"></i>Contrôle du <%=
                        Date.parse(ocr['date_controle']).strftime('%d/%m/%Y') rescue ocr['date_controle']
                      %>
                    <% end %>
                    <% if ocr['numero_rapport'].present? %>
                      &nbsp;·&nbsp;N° <%= ocr['numero_rapport'] %>
                    <% end %>
                  </div>
                  <% if ocr['date_prochain_controle'].present? %>
                    <div class="text-muted">
                      <i class="bi bi-arrow-repeat me-1"></i>Prochain contrôle avant <%=
                        Date.parse(ocr['date_prochain_controle']).strftime('%d/%m/%Y') rescue ocr['date_prochain_controle']
                      %>
                    </div>
                  <% end %>
                  <% if ocr['installateur'].present? %>
                    <div class="text-muted"><i class="bi bi-tools me-1"></i>Installateur : <%= ocr['installateur'] %></div>
                  <% end %>
                  <% if ocr['confiance_ocr'].present? %>
                    <div class="mt-1">
                      <span class="text-muted">Confiance OCR : </span>
                      <span class="<%= ocr['confiance_ocr'].to_i >= 70 ? 'text-success' : 'text-warning' %>">
                        <%= ocr['confiance_ocr'].to_i %> %
                      </span>
                    </div>
                  <% end %>
                </div>
                <!-- Actions -->
                <div class="flex-shrink-0 d-flex gap-1">
                  <% if doc.file.attached? %>
                    <%= link_to rails_blob_url(doc.file), target: '_blank', rel: 'noopener',
                        class: "btn btn-sm btn-outline-secondary", title: "Voir le document" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                  <% end %>
                  <%= button_to document_path(doc, return_context: 'reception_chantier'),
                      method: :delete,
                      form: { data: { turbo_confirm: "Supprimer cette attestation ?" } },
                      class: "btn btn-sm btn-outline-danger",
                      title: "Supprimer" do %>
                    <i class="bi bi-trash3"></i>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted small mb-0">
              <i class="bi bi-info-circle me-1"></i>
              Aucune attestation scannée. Uploadez le rapport de contrôle RGIE/AREI de l'électricien.
            </p>
          <% end %>

        </div>
      </div>

      <!-- ─── Prochaine étape : synthèse réglementaire ─────────────────────── -->
      <% if @analyse_politique.present? %>
        <% prochaines = @analyse_politique[:recommandations]&.first(2) %>
        <% if prochaines&.any? %>
          <div class="card border-0 shadow-sm border-start border-4 border-<%=
            PebPolitiqueRegionale.couleur_urgence(@analyse_politique[:urgence_globale]) %> mb-4">
            <div class="card-body p-4">
              <h6 class="text-primary-custom mb-3">
                <i class="bi bi-forward me-2"></i>Prochaines étapes réglementaires
              </h6>
              <% prochaines.each do |rec| %>
                <div class="d-flex gap-2 mb-3 small">
                  <i class="bi <%= rec[:icone] %> text-<%= rec[:couleur] %> flex-shrink-0 mt-1"></i>
                  <div>
                    <div class="fw-medium"><%= rec[:titre] %></div>
                    <div class="text-muted lh-sm"><%= rec[:description]&.truncate(150) %></div>
                  </div>
                </div>
              <% end %>
              <%= link_to fin_chantier_project_path(@project), class: "btn btn-sm btn-outline-success w-100" do %>
                <i class="bi bi-chevron-right me-1"></i>Voir toutes les recommandations
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

    </div><!-- /col droite -->
  </div><!-- /row -->
</div><!-- /container -->

