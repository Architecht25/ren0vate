<div class="container-fluid px-4 py-4">

  <!-- ── Header ─────────────────────────────────────────────────────────────── -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-file-earmark-check"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Réception de chantier</h1>
        <small class="text-muted"><%= @project.nom %></small>
      </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      <%= link_to project_path(@project, tab: :reception), class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour
      <% end %>
    </div>
  </div>

  <!-- ── Barre de complétion globale ────────────────────────────────────────── -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center g-3">
        <div class="col-lg-6">
          <div class="d-flex align-items-center gap-3 mb-2">
            <h5 class="mb-0 text-primary-custom fw-normal">État du dossier de réception</h5>
            <span class="badge bg-<%= @nb_obligatoires_ok == @nb_obligatoires ? 'success' : 'warning' %> fs-6">
              <%= @nb_presents %> / <%= @checklist.size %> éléments
            </span>
          </div>
          <div class="progress mb-1" style="height:10px;">
            <div class="progress-bar bg-<%= @completion_pct >= 80 ? 'success' : @completion_pct >= 50 ? 'warning' : 'danger' %>"
                 role="progressbar" style="width:<%= @completion_pct %>%"></div>
          </div>
          <small class="text-muted">
            Documents obligatoires : <%= @nb_obligatoires_ok %> / <%= @nb_obligatoires %> présents
          </small>
        </div>
        <div class="col-lg-6">
          <div class="row g-2 text-center">
            <div class="col-4">
              <div class="small text-muted">Début chantier</div>
              <div class="fw-semibold">
                <%= @project.date_début ? @project.date_début.strftime('%d/%m/%Y') : '—' %>
              </div>
            </div>
            <div class="col-4">
              <div class="small text-muted">Fin prévue</div>
              <div class="fw-semibold">
                <%= @project.date_fin ? @project.date_fin.strftime('%d/%m/%Y') : '—' %>
              </div>
            </div>
            <div class="col-4">
              <div class="small text-muted">Statut</div>
              <div>
                <span class="badge bg-<%= @project.statut == 'termine' ? 'success' : 'primary' %>">
                  <%= @project.statut&.humanize || '—' %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- COLONNE GAUCHE                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <div class="col-lg-6">

      <!-- ─── Bilan PEB ───────────────────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-graph-up-arrow me-2"></i>Bilan Performance Énergétique
          </h5>
          <%= link_to fin_chantier_project_path(@project), class: "btn btn-sm btn-outline-success" do %>
            <i class="bi bi-eye me-1"></i>Analyse complète
          <% end %>
        </div>
        <div class="card-body p-4">

          <div class="row g-3 align-items-center mb-3">
            <!-- PEB Avant -->
            <div class="col-5 text-center">
              <div class="small text-muted mb-1">Avant travaux</div>
              <% if @peb_avant.present? %>
                <div class="display-5 fw-bold text-<%= @peb_avant.couleur_bootstrap %>">
                  <%= @peb_avant.label_peb %>
                </div>
                <div class="small text-muted"><%= @peb_avant.score_ep_formate || '—' %></div>
              <% else %>
                <div class="display-5 fw-bold text-muted">?</div>
                <div class="small text-muted">Non renseigné</div>
              <% end %>
            </div>

            <!-- Flèche gain -->
            <div class="col-2 text-center">
              <% gain = @analyse_politique&.dig(:amelioration) %>
              <% if gain %>
                <% coul = gain > 0 ? 'success' : (gain == 0 ? 'secondary' : 'danger') %>
                <i class="bi bi-arrow-right fs-4 text-<%= coul %>"></i>
                <div class="small fw-bold text-<%= coul %>">
                  <%= gain > 0 ? "+#{gain}" : gain.to_s %>
                </div>
              <% else %>
                <i class="bi bi-arrow-right fs-4 text-muted"></i>
              <% end %>
            </div>

            <!-- PEB Après -->
            <div class="col-5 text-center">
              <div class="small text-muted mb-1">Après travaux</div>
              <% if @peb_actuel.present? %>
                <div class="display-5 fw-bold text-<%= @peb_actuel.couleur_bootstrap %>">
                  <%= @peb_actuel.label_peb %>
                </div>
                <div class="small text-muted"><%= @peb_actuel.score_ep_formate || '—' %></div>
              <% else %>
                <div class="display-5 fw-bold text-muted">?</div>
                <div class="small text-muted">
                  <%= link_to fin_chantier_project_path(@project), class: "btn btn-sm btn-primary mt-1" do %>
                    <i class="bi bi-camera me-1"></i>Scanner le PEB
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Validité + région -->
          <% if @peb_actuel&.date_validite.present? || @region.present? %>
            <hr class="my-2">
            <div class="d-flex justify-content-between align-items-center small text-muted flex-wrap gap-2">
              <% if @region.present? %>
                <span><i class="bi bi-geo-alt me-1"></i><%= @region.capitalize %></span>
              <% end %>
              <% if @peb_actuel&.date_validite %>
                <span>
                  <i class="bi bi-calendar3 me-1"></i>
                  Valide jusqu'au <%= @peb_actuel.date_validite.strftime('%d/%m/%Y') %>
                  <% annees = @peb_actuel.annees_validite_restantes %>
                  <% if annees && annees > 0 %>
                    <span class="badge bg-success-subtle text-success ms-1"><%= annees %>a restantes</span>
                  <% elsif annees %>
                    <span class="badge bg-danger ms-1">Expiré</span>
                  <% end %>
                </span>
              <% end %>
            </div>
          <% end %>

          <!-- Urgence réglementaire -->
          <% if @analyse_politique&.dig(:urgence_globale).present? && @analyse_politique[:urgence_globale] != :faible %>
            <% ur = @analyse_politique[:urgence_globale] %>
            <div class="alert alert-<%= PebPolitiqueRegionale.couleur_urgence(ur) %> py-2 px-3 mt-3 mb-0 small d-flex align-items-center gap-2">
              <i class="bi bi-exclamation-circle-fill"></i>
              <strong><%= PebPolitiqueRegionale.libelle_urgence(ur) %></strong>
              — Des échéances réglementaires s'appliquent.
              <%= link_to "Voir l'analyse →", fin_chantier_project_path(@project), class: "ms-auto text-nowrap" %>
            </div>
          <% end %>

        </div>
      </div>

      <!-- ─── Checklist documents de réception ─────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-card-checklist me-2"></i>Checklist documents
          </h5>
        </div>
        <div class="list-group list-group-flush">
          <% @checklist.each do |item| %>
            <div class="list-group-item px-4 py-3 d-flex align-items-start gap-3">
              <!-- Icône état -->
              <div class="flex-shrink-0 mt-1">
                <% if item[:present] %>
                  <div class="rounded-circle bg-success d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-check text-white" style="font-size:14px;"></i>
                  </div>
                <% elsif item[:obligatoire] %>
                  <div class="rounded-circle bg-danger d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-exclamation text-white" style="font-size:14px;"></i>
                  </div>
                <% else %>
                  <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center"
                       style="width:26px;height:26px;">
                    <i class="bi bi-dash text-secondary" style="font-size:14px;"></i>
                  </div>
                <% end %>
              </div>
              <!-- Contenu -->
              <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <i class="bi <%= item[:icone] %> text-<%= item[:present] ? 'success' : item[:obligatoire] ? 'danger' : 'secondary' %>"></i>
                  <span class="fw-medium small"><%= item[:titre] %></span>
                  <% if item[:obligatoire] %>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger" style="font-size:0.6rem;">Obligatoire</span>
                  <% end %>
                </div>
                <p class="text-muted mb-0 mt-1" style="font-size:0.78rem;"><%= item[:note] %></p>
              </div>
              <!-- Action -->
              <div class="flex-shrink-0">
                <% if item[:action].present? %>
                  <%= link_to item[:action], class: "btn btn-sm #{item[:present] ? 'btn-outline-success' : 'btn-outline-primary'}" do %>
                    <i class="bi bi-<%= item[:present] ? 'eye' : 'plus' %>"></i>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- ─── Documents de clôture & garanties ───────────────────────────────── -->
      <%
        cloture_doc_types = [
          { type: 'certificat_label',         label: 'Label énergétique',         icon: 'bi-award',                note: 'Label de performance de l\'équipement installé.' },
          { type: 'plan_diu',                 label: 'Plan DIU',                  icon: 'bi-diagram-3',            note: 'Dossier d\'Intervention Ultérieure — plans de récolement.' },
          { type: 'fiche_technique',          label: 'Fiche technique',           icon: 'bi-file-earmark-text',    note: 'Fiche technique des équipements et matériaux posés.' },
          { type: 'notice_equipement',        label: "Notice d'équipement",       icon: 'bi-book',                 note: 'Notices d\'utilisation et d\'entretien des équipements.' },
          { type: 'fiche_securite_materiaux', label: 'Fiche sécurité matériaux',  icon: 'bi-exclamation-triangle', note: 'Fiches de données de sécurité des matériaux utilisés.' },
          { type: 'instruction_entretien',    label: "Instruction d'entretien",   icon: 'bi-tools',                note: 'Recommandations d\'entretien périodique.' },
        ]
        all_cloture_types   = cloture_doc_types.map { |d| d[:type] }
        existing_cloture    = @project.documents.where(type_document: all_cloture_types).to_a
        nb_presents_cloture = existing_cloture.map(&:type_document).uniq.count
      %>
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-folder2-open me-2"></i>Documents DIU &amp; clôture
          </h5>
          <span class="badge bg-<%= nb_presents_cloture == cloture_doc_types.size ? 'success' : 'secondary' %>-subtle text-<%= nb_presents_cloture == cloture_doc_types.size ? 'success' : 'secondary' %> border">
            <%= nb_presents_cloture %> / <%= cloture_doc_types.size %>
          </span>
        </div>
        <div class="list-group list-group-flush">
          <% cloture_doc_types.each do |doc_type| %>
            <% existing = existing_cloture.find { |d| d.type_document == doc_type[:type] } %>
            <div class="list-group-item px-4 py-3 d-flex align-items-start gap-3">
              <!-- Icône état -->
              <div class="flex-shrink-0 mt-1">
                <% if existing %>
                  <div class="rounded-circle bg-success d-flex align-items-center justify-content-center" style="width:26px;height:26px;">
                    <i class="bi bi-check text-white" style="font-size:14px;"></i>
                  </div>
                <% else %>
                  <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center" style="width:26px;height:26px;">
                    <i class="bi bi-dash text-secondary" style="font-size:14px;"></i>
                  </div>
                <% end %>
              </div>
              <!-- Contenu -->
              <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <i class="bi <%= doc_type[:icon] %> text-<%= existing ? 'success' : 'secondary' %>"></i>
                  <span class="fw-medium small"><%= doc_type[:label] %></span>
                  <% if existing %>
                    <small class="text-muted" style="font-size:0.7rem;"><%= existing.file.attached? ? existing.file.filename.to_s.truncate(30) : '—' %></small>
                  <% end %>
                </div>
                <p class="text-muted mb-0 mt-1" style="font-size:0.78rem;"><%= doc_type[:note] %></p>
              </div>
              <!-- Action -->
              <div class="flex-shrink-0 d-flex gap-1">
                <% if existing %>
                  <%= link_to download_document_path(existing), class: 'btn btn-sm btn-outline-success', title: 'Télécharger' do %>
                    <i class="bi bi-download"></i>
                  <% end %>
                  <%= link_to existing, data: { turbo_method: :delete, turbo_confirm: 'Supprimer ce document ?' }, class: 'btn btn-sm btn-outline-danger' do %>
                    <i class="bi bi-trash"></i>
                  <% end %>
                <% else %>
                  <%= form_with url: project_documents_path(@project), method: :post, multipart: true do |f| %>
                    <%= hidden_field_tag 'document[type_document]', doc_type[:type] %>
                    <%= hidden_field_tag 'document[status]', 'approved' %>
                    <label class="btn btn-sm btn-outline-primary mb-0">
                      <i class="bi bi-plus"></i>
                      <input type="file" name="document[file]" class="d-none" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" onchange="this.form.submit()">
                    </label>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- ─── Photos après travaux ──────────────────────────────────────────── -->
      <% if @docs_photos_apres.any? %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary-custom fw-normal">
              <i class="bi bi-camera me-2"></i>Photos après travaux
            </h5>
            <%= link_to photos_documents_path, class: "btn btn-sm btn-outline-secondary" do %>
              Toutes les photos
            <% end %>
          </div>
          <div class="card-body p-3">
            <div class="row g-2">
              <% @docs_photos_apres.each do |photo| %>
                <div class="col-4">
                  <% if photo.file.attached? %>
                    <%= image_tag rails_blob_url(photo.file), class: "img-fluid rounded-2 w-100",
                        style: "height:100px;object-fit:cover;",
                        alt: photo.notes.presence || "Photo après travaux" %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

    </div><!-- /col gauche -->

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- COLONNE DROITE                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <div class="col-lg-6">

      <!-- ─── Bilan financier ───────────────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-cash-stack me-2"></i>Bilan financier
          </h5>
          <%= link_to edit_budget_project_path(@project, return_to: 'reception'), class: "btn btn-sm btn-outline-secondary" do %>
            <i class="bi bi-calculator me-1"></i>Détail
          <% end %>
        </div>
        <div class="card-body p-4">

          <!-- Tableau récap -->
          <div class="table-responsive">
            <table class="table table-sm mb-3">
              <thead class="table-light">
                <tr>
                  <th></th>
                  <th class="text-end text-muted small">Devis</th>
                  <th class="text-end text-muted small">Facturé</th>
                  <th class="text-end text-muted small">Écart</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="small"><i class="bi bi-person-badge me-1 text-muted"></i>Architecte</td>
                  <td class="text-end small"><%= number_to_currency(@total_architecte_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end small"><%= number_to_currency(@total_architecte_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <% ecart_arch = @total_architecte_factures - @total_architecte_devis %>
                  <td class="text-end small fw-medium text-<%= ecart_arch > 0 ? 'danger' : ecart_arch < 0 ? 'success' : 'muted' %>">
                    <%= ecart_arch >= 0 ? '+' : '' %><%= number_to_currency(ecart_arch, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
                <tr>
                  <td class="small"><i class="bi bi-tools me-1 text-muted"></i>Entrepreneurs</td>
                  <td class="text-end small"><%= number_to_currency(@total_entrepreneur_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end small"><%= number_to_currency(@total_entrepreneur_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <% ecart_entr = @total_entrepreneur_factures - @total_entrepreneur_devis %>
                  <td class="text-end small fw-medium text-<%= ecart_entr > 0 ? 'danger' : ecart_entr < 0 ? 'success' : 'muted' %>">
                    <%= ecart_entr >= 0 ? '+' : '' %><%= number_to_currency(ecart_entr, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
              </tbody>
              <tfoot class="table-light">
                <tr>
                  <td class="fw-semibold small">Total</td>
                  <td class="text-end fw-semibold small"><%= number_to_currency(@total_devis, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end fw-semibold small"><%= number_to_currency(@total_factures, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %></td>
                  <td class="text-end fw-semibold small text-<%= @solde_total > 0 ? 'danger' : @solde_total < 0 ? 'success' : 'muted' %>">
                    <%= @solde_total >= 0 ? '+' : '' %><%= number_to_currency(@solde_total, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>

          <% if @solde_total > @total_devis * 0.1 && @total_devis > 0 %>
            <div class="alert alert-warning py-2 px-3 small d-flex align-items-center gap-2 mb-0">
              <i class="bi bi-exclamation-triangle-fill"></i>
              Les factures dépassent le devis de plus de 10 %. Vérifiez les suppléments hors devis.
            </div>
          <% end %>

        </div>
      </div>

      <%= render 'projects/reception_chantier/reserves' %>
      <!-- ─── Checklists d'inspection par phase ───────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4" id="checklists">
        <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-0 text-primary-custom fw-normal">
              <i class="bi bi-clipboard2-check me-2"></i>Inspections de chantier
            </h5>
            <% done = @project_checklists.count { |c| c.completed? } %>
            <small class="text-muted">
              <%= @project_checklists.count %> inspection<%= 's' if @project_checklists.count != 1 %> lancée<%= 's' if @project_checklists.count != 1 %>
              <% if done > 0 %>
                — <span class="text-success"><%= done %> terminée<%= 's' if done != 1 %></span>
              <% end %>
            </small>
          </div>
          <button class="btn btn-sm btn-outline-primary rounded-3" type="button"
                  data-bs-toggle="collapse" data-bs-target="#form-checklist-<%= @project.id %>">
            <i class="bi bi-plus me-1"></i>Démarrer
          </button>
        </div>

        <!-- Formulaire : choisir un template -->
        <div class="collapse" id="form-checklist-<%= @project.id %>">
          <div class="p-3 border-bottom bg-light">
            <p class="small text-muted mb-2">Choisissez le type d'inspection à démarrer :</p>
            <div class="row g-2">
              <% @checklist_templates.each do |tpl| %>
                <div class="col-sm-6">
                  <%= form_with url: project_project_checklists_path(@project), method: :post,
                                data: { turbo: false } do |f| %>
                    <%= f.hidden_field :checklist_template_id, value: tpl.id %>
                    <button type="submit" class="btn btn-outline-<%= tpl.phase_color %> rounded-3 w-100 text-start p-2">
                      <div class="d-flex align-items-center gap-2">
                        <i class="bi <%= tpl.phase_icon %> fs-5"></i>
                        <div>
                          <div class="fw-semibold small"><%= tpl.name %></div>
                          <div class="text-muted" style="font-size:0.72rem;"><%= tpl.checklist_items.count %> points de contrôle</div>
                        </div>
                      </div>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>
            <div class="text-end mt-2">
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-3"
                      data-bs-toggle="collapse" data-bs-target="#form-checklist-<%= @project.id %>">
                Annuler
              </button>
            </div>
          </div>
        </div>

        <!-- Liste des inspections lancées -->
        <% if @project_checklists.any? %>
          <div class="list-group list-group-flush">
            <% @project_checklists.each do |pc| %>
              <div class="list-group-item px-4 py-3 d-flex align-items-center gap-3">
                <div class="flex-shrink-0">
                  <div class="rounded-circle d-flex align-items-center justify-content-center
                               bg-<%= pc.completed? ? 'success' : pc.checklist_template.phase_color %>-subtle"
                       style="width:36px;height:36px;">
                    <i class="bi <%= pc.checklist_template.phase_icon %>
                               text-<%= pc.completed? ? 'success' : pc.checklist_template.phase_color %>"></i>
                  </div>
                </div>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <span class="fw-medium small"><%= pc.checklist_template.name %></span>
                    <span class="badge bg-<%= pc.checklist_template.phase_color %>-subtle
                                 text-<%= pc.checklist_template.phase_color %> border" style="font-size:0.6rem;">
                      <%= pc.checklist_template.phase_label %>
                    </span>
                    <% if pc.completed? %>
                      <span class="badge bg-success-subtle text-success border" style="font-size:0.6rem;">
                        <i class="bi bi-check-circle me-1"></i>Terminée
                      </span>
                    <% end %>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1" style="height:5px;max-width:120px;">
                      <div class="progress-bar bg-<%= pc.completed? ? 'success' : 'primary' %>"
                           style="width:<%= pc.progress_pct %>%"></div>
                    </div>
                    <span class="small text-muted"><%= pc.progress_pct %>%</span>
                  </div>
                </div>
                <%= link_to project_project_checklist_path(@project, pc),
                            class: "btn btn-sm btn-outline-primary rounded-3 flex-shrink-0" do %>
                  <i class="bi bi-eye me-1"></i>Ouvrir
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card-body p-4 text-center text-muted small">
            <i class="bi bi-clipboard2 fs-4 d-block mb-2 text-secondary"></i>
            Aucune inspection démarrée.
            <div class="mt-2" style="font-size:0.78rem;">
              Démarrez une inspection pour contrôler chaque phase : gros œuvre, second œuvre, finitions ou réception.
            </div>
          </div>
        <% end %>
      </div>

      <%= render 'projects/reception_chantier/pv_reception' %>

      <!-- ─── Décompte par entrepreneur ─────────────────────────────────────── -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3 px-4">
          <h5 class="mb-0 text-primary-custom fw-normal">
            <i class="bi bi-building me-2"></i>Décompte par entrepreneur
          </h5>
        </div>

        <% if @factures_par_entreprise.any? %>
          <div class="accordion accordion-flush" id="accordionEntrepreneurs">
            <% total_general = 0 %>
            <% @factures_par_entreprise.each_with_index do |(entreprise, factures_ent), idx| %>
              <% total_ent = factures_ent.sum { |f| f.montant.to_f } %>
              <% total_general += total_ent %>
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed py-2 px-4 small" type="button"
                          data-bs-toggle="collapse" data-bs-target="#ent-<%= idx %>">
                    <div class="d-flex w-100 justify-content-between align-items-center pe-2">
                      <span class="fw-medium">
                        <i class="bi bi-building me-1 text-muted"></i>
                        <%= entreprise.presence || 'Entreprise non identifiée' %>
                      </span>
                      <span class="badge bg-primary-subtle text-primary ms-3">
                        <%= number_to_currency(total_ent, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                      </span>
                    </div>
                  </button>
                </h2>
                <div id="ent-<%= idx %>" class="accordion-collapse collapse">
                  <div class="accordion-body px-4 py-2">
                    <% factures_ent.each do |f| %>
                      <div class="d-flex align-items-center justify-content-between py-2 border-bottom border-light gap-2">
                        <div class="small flex-grow-1">
                          <span class="badge bg-<%= f.type_facture == 'acompte' ? 'warning' : f.type_facture == 'solde' ? 'success' : 'primary' %>-subtle
                                       text-<%= f.type_facture == 'acompte' ? 'warning' : f.type_facture == 'solde' ? 'success' : 'primary' %> me-1">
                            <%= f.type_facture_display %>
                          </span>
                          <span class="text-muted">
                            <% if f.numero_facture.present? %>N° <%= f.numero_facture %><% end %>
                            <% if f.date_facture.present? %> — <%= f.date_facture.strftime('%d/%m/%Y') %><% end %>
                          </span>
                        </div>
                        <div class="fw-medium small text-end flex-shrink-0">
                          <%= f.montant.present? && f.montant > 0 ?
                              number_to_currency(f.montant, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') : '—' %>
                        </div>
                        <% unless f.valide_manuellement %>
                          <span class="badge bg-warning-subtle text-warning" title="À valider" style="font-size:0.6rem;">À valider</span>
                        <% end %>
                      </div>
                    <% end %>
                    <div class="d-flex justify-content-end pt-2">
                      <small class="fw-semibold">
                        Total : <%= number_to_currency(total_ent, unit: '€', format: '%n %u', separator: ',', delimiter: ' ') %>
                      </small>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="card-body p-4 text-center text-muted small">
            <i class="bi bi-inbox fs-4 d-block mb-2"></i>
            Aucune facture enregistrée. Scannez des factures via le
            <%= link_to "suivi budgétaire", edit_budget_project_path(@project, return_to: 'reception') %>.
          </div>
        <% end %>
      </div>

      <%= render 'projects/reception_chantier/conformite_rgie' %>

    </div><!-- /col droite -->
  </div><!-- /row -->
</div><!-- /container -->

<%= render 'projects/reception_chantier/javascript' %>
