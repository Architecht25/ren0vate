<%# locals: docs, type, label, project %>

<% if docs.any? %>
  <% docs.each do |doc| %>
    <div class="d-flex align-items-center gap-2 py-2 <%= 'border-bottom' unless doc == docs.last %>">
      <i class="bi bi-file-earmark-check text-success fs-5 flex-shrink-0"></i>
      <div class="flex-grow-1 small">
        <div class="fw-medium text-truncate" style="max-width:180px;">
          <%= doc.notes.presence || doc.file.filename.to_s.presence || label.capitalize %>
        </div>
        <div class="text-muted" style="font-size:0.72rem;"><%= doc.created_at.strftime('%d/%m/%Y') %></div>
      </div>
      <div class="d-flex gap-1 flex-shrink-0">
        <% if doc.file.attached? %>
          <%= link_to rails_blob_url(doc.file), target: '_blank', rel: 'noopener',
              class: "btn btn-sm btn-outline-secondary py-1", title: "Voir" do %>
            <i class="bi bi-eye"></i>
          <% end %>
        <% end %>
        <%= button_to document_path(doc, return_context: 'carnet_entretien'),
            method: :delete,
            form: { data: { turbo_confirm: "Supprimer ce document ?" } },
            class: "btn btn-sm btn-outline-danger py-1", title: "Supprimer" do %>
          <i class="bi bi-trash3"></i>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<%= form_with url: project_documents_path(project), method: :post,
    html: { class: 'd-inline-flex align-items-center gap-2', id: "form-carnet-#{type}" } do |f| %>
  <%= f.hidden_field :type_document, value: type %>
  <%= f.hidden_field :return_to, value: carnet_entretien_project_path(project) %>
  <label for="carnet-file-<%= type %>" class="btn btn-sm btn-outline-secondary mb-0">
    <i class="bi bi-upload me-1"></i>Ajouter
  </label>
  <%= f.file_field :file, id: "carnet-file-#{type}", class: "d-none",
      accept: ".pdf,.jpg,.jpeg,.png",
      onchange: "this.closest('form').submit()" %>
<% end %>
