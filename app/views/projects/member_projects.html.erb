<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
      <h1 class="h3 text-primary-custom mb-1 fw-normal">Mes projets</h1>
      <p class="text-muted mb-0 small">Projets auxquels vous participez en tant que professionnel</p>
    </div>
  </div>

  <% if @memberships.any? %>
    <div class="row g-3">
      <% @memberships.each do |membership| %>
        <% project  = membership.project %>
        <% property = project.property %>
        <div class="col-xl-4 col-lg-6 col-md-6">
          <div class="card border-0 shadow-sm h-100 hover-shadow transition-all" style="border-radius: 12px; overflow: hidden;">
            <!-- Bandeau couleur selon rôle -->
            <div class="<%= membership.role == 'entrepreneur' ? 'bg-warning' : 'bg-info' %> py-1 px-3 d-flex align-items-center justify-content-between">
              <span class="small fw-semibold text-white">
                <i class="bi <%= membership.role == 'entrepreneur' ? 'bi-hammer' : 'bi-compass' %> me-1"></i>
                <%= membership.role_label %>
              </span>
              <span class="badge bg-white text-dark small">Actif</span>
            </div>

            <div class="card-body p-4">
              <!-- Nom du projet -->
              <h5 class="fw-semibold mb-1 text-dark"><%= project.nom_projet.presence || "Projet sans nom" %></h5>

              <!-- Adresse du bien -->
              <% if property %>
                <p class="text-muted small mb-3">
                  <i class="bi bi-geo-alt me-1"></i>
                  <%= [property.adresse, property.code_postal, property.commune].compact.join(', ') %>
                </p>
              <% end %>

              <!-- Propriétaire -->
              <div class="d-flex align-items-center mb-3">
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;">
                  <i class="bi bi-person text-secondary" style="font-size:.9rem;"></i>
                </div>
                <div>
                  <div class="small text-muted" style="line-height:1.1">Propriétaire</div>
                  <div class="small fw-medium">
                    <% owner = project.user %>
                    <%= owner&.full_name.presence || owner&.email&.split('@')&.first&.capitalize || "—" %>
                  </div>
                </div>
              </div>

              <!-- Date d'acceptation -->
              <% if membership.accepted_at %>
                <p class="text-muted small mb-3">
                  <i class="bi bi-calendar-check me-1"></i>
                  Rejoint le <%= membership.accepted_at.strftime('%d/%m/%Y') %>
                </p>
              <% end %>

              <!-- Lien vers la vue pro du projet -->
              <%= link_to pro_view_project_path(project), class: "btn btn-sm btn-primary-custom w-100 mt-1" do %>
                <i class="bi bi-arrow-right-circle me-1"></i> Voir le projet
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <div class="text-center py-5">
      <div class="mb-3">
        <i class="bi bi-folder-x text-muted" style="font-size: 3rem;"></i>
      </div>
      <h5 class="text-muted fw-normal">Aucun projet actif</h5>
      <p class="text-muted small">Vous n'avez pas encore été invité à participer à un projet.</p>
    </div>
  <% end %>
</div>
