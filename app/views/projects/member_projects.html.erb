<%
  entrepreneur_ms = @memberships.select { |m| m.role == 'entrepreneur' }
  architect_ms    = @memberships.select { |m| m.role == 'architect' }
  multi_role      = entrepreneur_ms.any? && architect_ms.any?
%>

<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
      <%= link_to dashboard_path, class: "d-inline-flex align-items-center gap-1 text-muted mb-1", style: "font-size:0.82rem;text-decoration:none;" do %>
        <i class="bi bi-arrow-left"></i> Tableau de bord
      <% end %>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">
        <%= current_user.intermediary? ? 'Mon portefeuille clients' : 'Tous mes chantiers' %>
      </h1>
    </div>
    <span class="badge rounded-pill bg-light text-muted fs-6">
      <%= @memberships.size %> chantier<%= @memberships.size > 1 ? 's' : '' %>
    </span>
  </div>

  <% if @memberships.any? %>

    <% if multi_role %>
      <%# ── Layout 2 colonnes : Entrepreneur | Architecte ───────────────────── %>
      <div class="row g-4 align-items-start">

        <%# ── Colonne Entrepreneur ─────────────────────────────────────────── %>
        <div class="col-lg-6">
          <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom:2px solid #ffc107;">
            <i class="bi bi-hammer text-warning fs-5"></i>
            <span class="fw-semibold fs-6">Entrepreneur</span>
            <span class="badge bg-warning text-dark ms-auto"><%= entrepreneur_ms.size %> chantier<%= entrepreneur_ms.size > 1 ? 's' : '' %></span>
          </div>
          <div class="d-flex flex-column gap-3 mb-4">
            <% entrepreneur_ms.each do |membership| %>
              <% project  = membership.project %>
              <% property = project.property %>
              <%
                fp            = project.factures.entrepreneur
                ent_total_f   = fp.sum(:montant).to_f
                ent_attente_f = fp.non_payees.sum(:montant).to_f
                ent_devis_att = fp.devis.where(validated_by_client_at: nil).any?
                phases_json   = project.phases_avancement || {}
                pct_av        = (phases_json.values.count(&:present?) * 100.0 / 5).round
                photos_count  = project.documents.where(type_document: %w[photo_avant photo_pendant photo_apres photo_chassis]).count
              %>
              <div class="card border-0 shadow-sm" style="border-radius:12px;overflow:hidden;">
                <div class="bg-warning py-1 px-3 d-flex align-items-center justify-content-between">
                  <span class="small fw-semibold text-white"><i class="bi bi-hammer me-1"></i>Entrepreneur</span>
                  <% if ent_devis_att %>
                    <span class="badge bg-white text-warning small">Devis en attente validation</span>
                  <% else %>
                    <span class="badge bg-white text-dark small">Actif</span>
                  <% end %>
                </div>
                <div class="card-body p-3">
                  <h5 class="fw-semibold mb-1 text-dark" style="font-size:0.95rem;"><%= project.nom.presence || "Projet sans nom" %></h5>
                  <% if property %>
                    <p class="text-muted small mb-2" style="font-size:0.8rem;">
                      <i class="bi bi-geo-alt me-1"></i><%= [property.adresse, property.code_postal, property.commune].compact.join(', ') %>
                    </p>
                  <% end %>
                  <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width:28px;height:28px;">
                      <i class="bi bi-person text-secondary" style="font-size:.8rem;"></i>
                    </div>
                    <div>
                      <div class="text-muted" style="font-size:0.73rem;line-height:1.1">Propriétaire</div>
                      <div class="fw-medium" style="font-size:0.82rem;">
                        <% owner = project.user %>
                        <%= owner&.full_name.presence || owner&.email&.split('@')&.first&.capitalize || "—" %>
                      </div>
                    </div>
                  </div>
                  <div class="rounded-2 p-2 mb-3" style="background:#f8f9fa;border:1px solid #e9ecef;">
                    <div class="row g-0 text-center">
                      <div class="col-4 border-end">
                        <div class="text-muted" style="font-size:0.68rem;">Facturé</div>
                        <div class="fw-bold text-dark" style="font-size:0.85rem;"><%= ent_total_f > 0 ? "#{number_with_delimiter(ent_total_f.to_i, delimiter: '.')} €" : "—" %></div>
                      </div>
                      <div class="col-4 border-end">
                        <div class="text-muted" style="font-size:0.68rem;">En attente</div>
                        <div class="fw-bold <%= ent_attente_f > 0 ? 'text-warning' : 'text-success' %>" style="font-size:0.85rem;"><%= ent_attente_f > 0 ? "#{number_with_delimiter(ent_attente_f.to_i, delimiter: '.')} €" : "✓ 0 €" %></div>
                      </div>
                      <div class="col-4">
                        <div class="text-muted" style="font-size:0.68rem;">Photos</div>
                        <div class="fw-bold text-info" style="font-size:0.85rem;"><%= photos_count %></div>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="text-muted" style="font-size:0.72rem;">Avancement phases</span>
                      <span class="fw-medium" style="font-size:0.72rem;"><%= pct_av %>%</span>
                    </div>
                    <div class="progress" style="height:5px;border-radius:3px;">
                      <div class="progress-bar bg-warning" role="progressbar" style="width:<%= pct_av %>%;"></div>
                    </div>
                  </div>
                  <%= link_to pro_view_project_path(project), class: "btn btn-sm btn-primary-custom w-100" do %>
                    <i class="bi bi-arrow-right-circle me-1"></i> Ouvrir le chantier
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

        </div>
        <%# ── fin colonne Entrepreneur ──────────────────────────────────────── %>

        <%# ── Colonne Architecte ───────────────────────────────────────────── %>
        <div class="col-lg-6">
          <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom:2px solid #0dcaf0;">
            <i class="bi bi-compass text-info fs-5"></i>
            <span class="fw-semibold fs-6">Architecte</span>
            <span class="badge bg-info text-dark ms-auto"><%= architect_ms.size %> projet<%= architect_ms.size > 1 ? 's' : '' %></span>
          </div>
          <div class="d-flex flex-column gap-3 mb-4">
            <% architect_ms.each do |membership| %>
              <% project  = membership.project %>
              <% property = project.property %>
              <%
                phases_json  = project.phases_avancement || {}
                pct_av       = (phases_json.values.count(&:present?) * 100.0 / 5).round
                photos_count = project.documents.where(type_document: %w[photo_avant photo_pendant photo_apres photo_chassis]).count
                docs_count   = project.documents.count
              %>
              <div class="card border-0 shadow-sm" style="border-radius:12px;overflow:hidden;">
                <div class="bg-info py-1 px-3 d-flex align-items-center justify-content-between">
                  <span class="small fw-semibold text-white"><i class="bi bi-compass me-1"></i>Architecte</span>
                  <span class="badge bg-white text-dark small">Actif</span>
                </div>
                <div class="card-body p-3">
                  <h5 class="fw-semibold mb-1 text-dark" style="font-size:0.95rem;"><%= project.nom.presence || "Projet sans nom" %></h5>
                  <% if property %>
                    <p class="text-muted small mb-2" style="font-size:0.8rem;">
                      <i class="bi bi-geo-alt me-1"></i><%= [property.adresse, property.code_postal, property.commune].compact.join(', ') %>
                    </p>
                  <% end %>
                  <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width:28px;height:28px;">
                      <i class="bi bi-person text-secondary" style="font-size:.8rem;"></i>
                    </div>
                    <div>
                      <div class="text-muted" style="font-size:0.73rem;line-height:1.1">Propriétaire</div>
                      <div class="fw-medium" style="font-size:0.82rem;">
                        <% owner = project.user %>
                        <%= owner&.full_name.presence || owner&.email&.split('@')&.first&.capitalize || "—" %>
                      </div>
                    </div>
                  </div>
                  <div class="rounded-2 p-2 mb-3" style="background:#f0f9ff;border:1px solid #bae6fd;">
                    <div class="row g-0 text-center">
                      <div class="col-4 border-end">
                        <div class="text-muted" style="font-size:0.68rem;">Avancement</div>
                        <div class="fw-bold text-info" style="font-size:0.85rem;"><%= pct_av %>%</div>
                      </div>
                      <div class="col-4 border-end">
                        <div class="text-muted" style="font-size:0.68rem;">Documents</div>
                        <div class="fw-bold text-info" style="font-size:0.85rem;"><%= docs_count %></div>
                      </div>
                      <div class="col-4">
                        <div class="text-muted" style="font-size:0.68rem;">Photos</div>
                        <div class="fw-bold text-info" style="font-size:0.85rem;"><%= photos_count %></div>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="text-muted" style="font-size:0.72rem;">Avancement phases</span>
                      <span class="fw-medium" style="font-size:0.72rem;"><%= pct_av %>%</span>
                    </div>
                    <div class="progress" style="height:5px;border-radius:3px;">
                      <div class="progress-bar bg-info" role="progressbar" style="width:<%= pct_av %>%;"></div>
                    </div>
                  </div>
                  <%= link_to pro_view_project_path(project), class: "btn btn-sm btn-primary-custom w-100" do %>
                    <i class="bi bi-arrow-right-circle me-1"></i> Ouvrir le chantier
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>

        </div>
        <%# ── fin colonne Architecte ────────────────────────────────────────── %>

      </div>
      <%# ── fin layout 2 colonnes ─────────────────────────────────────────── %>

    <% else %>
      <%# Layout mono-rôle (intermediary, ou pending-only) %>
      <div class="row g-3">
        <% @memberships.each do |membership| %>
          <% project  = membership.project %>
          <% property = project.property %>
          <%
            factures_projet    = project.factures.entrepreneur if membership.role == 'entrepreneur'
            total_facture      = factures_projet&.sum(:montant).to_f || 0
            total_attente      = factures_projet&.non_payees&.sum(:montant).to_f || 0
            has_devis_attente  = factures_projet&.devis&.where(validated_by_client_at: nil)&.any? || false
            phases_json        = project.phases_avancement || {}
            nb_phases_validees = phases_json.values.count(&:present?)
            pct_avancement     = (nb_phases_validees * 100.0 / 5).round
            photos_count       = project.documents.where(type_document: %w[photo_avant photo_pendant photo_apres photo_chassis]).count
          %>
          <div class="col-xl-4 col-lg-6 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden;">
              <%
                bandeau_class = case membership.role
                                when 'entrepreneur' then 'bg-warning'
                                when 'architect'    then 'bg-info'
                                when 'intermediary' then 'bg-purple'
                                else 'bg-secondary'
                                end
                bandeau_icon  = case membership.role
                                when 'entrepreneur' then 'bi-hammer'
                                when 'architect'    then 'bi-compass'
                                when 'intermediary' then 'bi-people'
                                else 'bi-person'
                                end
              %>
              <div class="<%= bandeau_class %> py-1 px-3 d-flex align-items-center justify-content-between"
                   style="<%= membership.role == 'intermediary' ? 'background:linear-gradient(90deg,#6f42c1,#9d6bde)!important' : '' %>">
                <span class="small fw-semibold text-white">
                  <i class="bi <%= bandeau_icon %> me-1"></i>
                  <%= membership.role_label %>
                </span>
                <% if has_devis_attente %>
                  <span class="badge bg-white text-warning small">Devis en attente validation</span>
                <% else %>
                  <span class="badge bg-white text-dark small">Actif</span>
                <% end %>
              </div>
              <div class="card-body p-3">
                <h5 class="fw-semibold mb-1 text-dark" style="font-size:0.95rem;"><%= project.nom.presence || "Projet sans nom" %></h5>
                <% if property %>
                  <p class="text-muted small mb-2" style="font-size:0.8rem;">
                    <i class="bi bi-geo-alt me-1"></i>
                    <%= [property.adresse, property.code_postal, property.commune].compact.join(', ') %>
                  </p>
                <% end %>
                <div class="d-flex align-items-center mb-3">
                  <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width:28px;height:28px;">
                    <i class="bi bi-person text-secondary" style="font-size:.8rem;"></i>
                  </div>
                  <div>
                    <div class="text-muted" style="font-size:0.73rem;line-height:1.1">Propriétaire</div>
                    <div class="fw-medium" style="font-size:0.82rem;">
                      <% owner = project.user %>
                      <%= owner&.full_name.presence || owner&.email&.split('@')&.first&.capitalize || "—" %>
                    </div>
                  </div>
                </div>
                <% if membership.role == 'entrepreneur' %>
                  <div class="rounded-2 p-2 mb-3" style="background:#f8f9fa;border:1px solid #e9ecef;">
                    <div class="row g-0 text-center">
                      <div class="col-4 border-end">
                        <div class="text-muted" style="font-size:0.68rem;">Facturé</div>
                        <div class="fw-bold text-dark" style="font-size:0.85rem;"><%= total_facture > 0 ? "#{number_with_delimiter(total_facture.to_i, delimiter: '.')} €" : "—" %></div>
                      </div>
                      <div class="col-4 border-end">
                        <div class="text-muted" style="font-size:0.68rem;">En attente</div>
                        <div class="fw-bold <%= total_attente > 0 ? 'text-warning' : 'text-success' %>" style="font-size:0.85rem;"><%= total_attente > 0 ? "#{number_with_delimiter(total_attente.to_i, delimiter: '.')} €" : "✓ 0 €" %></div>
                      </div>
                      <div class="col-4">
                        <div class="text-muted" style="font-size:0.68rem;">Photos</div>
                        <div class="fw-bold text-info" style="font-size:0.85rem;"><%= photos_count %></div>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="text-muted" style="font-size:0.72rem;">Avancement phases</span>
                      <span class="fw-medium" style="font-size:0.72rem;"><%= pct_avancement %>%</span>
                    </div>
                    <div class="progress" style="height:5px;border-radius:3px;">
                      <div class="progress-bar bg-warning" role="progressbar" style="width:<%= pct_avancement %>%;"></div>
                    </div>
                  </div>
                <% elsif membership.role == 'intermediary' %>
                  <% docs_count = project.documents.count %>
                  <div class="rounded-2 p-2 mb-3" style="background:#f5f0ff;border:1px solid #d8b4fe;">
                    <div class="row g-0 text-center">
                      <div class="col-4 border-end">
                        <div class="text-muted" style="font-size:0.68rem;">Avancement</div>
                        <div class="fw-bold text-dark" style="font-size:0.85rem;"><%= pct_avancement %>%</div>
                      </div>
                      <div class="col-4 border-end">
                        <div class="text-muted" style="font-size:0.68rem;">Documents</div>
                        <div class="fw-bold text-dark" style="font-size:0.85rem;"><%= docs_count %></div>
                      </div>
                      <div class="col-4">
                        <div class="text-muted" style="font-size:0.68rem;">Photos</div>
                        <div class="fw-bold text-dark" style="font-size:0.85rem;"><%= photos_count %></div>
                      </div>
                    </div>
                  </div>
                  <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="text-muted" style="font-size:0.72rem;">Avancement global</span>
                      <span class="fw-medium" style="font-size:0.72rem;"><%= pct_avancement %>%</span>
                    </div>
                    <div class="progress" style="height:5px;border-radius:3px;">
                      <div class="progress-bar" role="progressbar" style="width:<%= pct_avancement %>%;background:linear-gradient(90deg,#6f42c1,#9d6bde);"></div>
                    </div>
                  </div>
                <% end %>
                <%= link_to pro_view_project_path(project), class: "btn btn-sm btn-primary-custom w-100" do %>
                  <i class="bi bi-arrow-right-circle me-1"></i> Ouvrir le chantier
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <div class="text-center py-5">
      <div class="mb-3">
        <i class="bi bi-folder-x text-muted" style="font-size: 3rem;"></i>
      </div>
      <h5 class="text-muted fw-normal">Aucun projet actif</h5>
      <p class="text-muted small mb-4">Vous n'avez pas encore été invité à participer à un projet.</p>

      <% if current_user.professional? %>
        <div class="card border-0 shadow-sm rounded-3 mx-auto" style="max-width:420px;">
          <div class="card-body px-4 py-4 text-start">
            <div class="d-flex align-items-center mb-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0"
                   style="width:44px;height:44px;background:linear-gradient(135deg,#0d6efd,#6610f2);">
                <i class="bi bi-person-plus text-white" style="font-size:1.1rem;"></i>
              </div>
              <div>
                <div class="fw-semibold" style="font-size:0.95rem;">Invitez votre premier client</div>
                <div class="text-muted" style="font-size:0.8rem;">Partagez un lien — votre client vous ajoutera à son projet</div>
              </div>
            </div>
            <%= link_to pro_referral_path, class: "btn btn-primary w-100" do %>
              <i class="bi bi-link-45deg me-1"></i>Générer mon lien d'invitation client
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<% if current_user.intermediary? %>
<%# ── Assistant IA Intermédiaire ─────────────────────────────────────────── %>
<div class="container-fluid px-4 pb-5">
  <div class="border-top pt-4 mt-2">
    <div class="d-flex align-items-center gap-2 mb-3">
      <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
           style="width:38px;height:38px;background:linear-gradient(135deg,#6f42c1,#9d6bde);">
        <i class="bi bi-robot text-white" style="font-size:1rem;"></i>
      </div>
      <div>
        <h2 class="h5 mb-0 fw-semibold">Assistant IA — Vue portefeuille</h2>
        <p class="text-muted mb-0 small">Posez vos questions sur l'ensemble de vos dossiers clients</p>
      </div>
      <div class="ms-auto d-flex align-items-center gap-2">
        <span class="badge rounded-pill" style="background:rgba(111,66,193,0.12);color:#6f42c1;">
          <i class="bi bi-people me-1"></i><%= @memberships.size %> dossier<%= @memberships.size > 1 ? 's' : '' %>
        </span>
        <span class="badge rounded-pill bg-light text-muted small">
          <i class="bi bi-circle-fill me-1" style="color:#84a98c;font-size:0.4rem;"></i>Claude Sonnet
        </span>
      </div>
    </div>

    <div class="row g-3">
      <%# Suggestions rapides %>
      <div class="col-lg-3 d-none d-lg-block">
        <div class="card border-0 h-100" style="background:#faf8ff;border:1px solid #e9d8fd!important;">
          <div class="card-body p-3">
            <div class="small fw-semibold text-muted mb-2 text-uppercase" style="font-size:0.68rem;letter-spacing:.06em;">
              Questions fréquentes
            </div>
            <div id="proIaSuggestions" class="d-flex flex-column gap-2">
              <% [
                   "Quel client a le dossier le plus avancé ?",
                   "Quels dossiers sont en retard ou bloqués ?",
                   "Synthèse des primes éligibles par client",
                   "Prochaines échéances urgentes dans mon portefeuille",
                   "Quels documents manquent sur l'ensemble des dossiers ?"
                 ].each do |suggestion| %>
                <button type="button"
                        class="btn btn-sm text-start pro-ia-suggestion"
                        style="background:#fff;border:1px solid #d8b4fe;color:#6f42c1;font-size:0.78rem;border-radius:8px;"
                        data-suggestion="<%= suggestion %>">
                  <%= suggestion %>
                </button>
              <% end %>
            </div>
            <div class="mt-3 pt-2 border-top">
              <div class="text-muted" style="font-size:0.7rem;">
                <i class="bi bi-shield-lock me-1"></i>
                Cloisonnement RGPD actif — données limitées à votre périmètre
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Zone de chat %>
      <div class="col-lg-9">
        <div class="card border-0 shadow-sm d-flex flex-column" style="border-radius:12px;min-height:400px;max-height:520px;">
          <%# Messages %>
          <div class="flex-grow-1 overflow-auto p-3" id="proIaMessages" style="min-height:300px;">
            <div class="d-flex mb-3 pro-ia-msg-bot">
              <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center me-2"
                   style="width:32px;height:32px;background:linear-gradient(135deg,#6f42c1,#9d6bde);flex-shrink:0;">
                <i class="bi bi-robot text-white" style="font-size:0.8rem;"></i>
              </div>
              <div class="rounded-3 px-3 py-2 small" style="background:#f5f0ff;max-width:85%;font-size:0.85rem;">
                <p class="mb-1"><strong>Bonjour <%= current_user.first_name || current_user.email.split('@').first.capitalize %> !</strong></p>
                <p class="mb-1">Je connais votre portefeuille de <strong><%= @memberships.size %> dossier<%= @memberships.size > 1 ? 's' : '' %> clients</strong> et leurs données de chantier : avancement, documents, permis, primes éligibles.</p>
                <p class="mb-0 text-muted" style="font-size:0.78rem;">Posez une question sur un dossier spécifique ou sur l'ensemble du portefeuille.</p>
              </div>
            </div>
          </div>

          <%# Saisie %>
          <div class="border-top p-3" style="border-radius:0 0 12px 12px;background:#faf8ff;">
            <form id="proIaForm">
              <div class="input-group">
                <input type="text" class="form-control" id="proIaInput"
                       placeholder="Ex : Quels dossiers nécessitent une action urgente ?"
                       autocomplete="off"
                       style="border-color:#d8b4fe;font-size:0.9rem;">
                <button class="btn fw-semibold" type="submit" id="proIaSendBtn"
                        style="background:linear-gradient(135deg,#6f42c1,#9d6bde);color:#fff;border:none;">
                  <i class="bi bi-send"></i>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {
  const form        = document.getElementById('proIaForm');
  const input       = document.getElementById('proIaInput');
  const messages    = document.getElementById('proIaMessages');
  const sendBtn     = document.getElementById('proIaSendBtn');
  const suggestions = document.querySelectorAll('.pro-ia-suggestion');
  if (!form || !input || !messages) return;

  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  function appendMsg(text, isUser) {
    const wrap = document.createElement('div');
    wrap.className = 'd-flex mb-3 ' + (isUser ? 'justify-content-end' : 'pro-ia-msg-bot');
    if (isUser) {
      wrap.innerHTML = `<div class="rounded-3 px-3 py-2 small text-white" style="background:linear-gradient(135deg,#6f42c1,#9d6bde);max-width:80%;font-size:0.85rem;">${escHtml(text)}</div>`;
    } else {
      wrap.innerHTML = `
        <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center me-2"
             style="width:32px;height:32px;background:linear-gradient(135deg,#6f42c1,#9d6bde);flex-shrink:0;">
          <i class="bi bi-robot text-white" style="font-size:0.8rem;"></i>
        </div>
        <div class="rounded-3 px-3 py-2 small" style="background:#f5f0ff;max-width:85%;font-size:0.85rem;">${renderMd(text)}</div>`;
    }
    messages.appendChild(wrap);
    messages.scrollTop = messages.scrollHeight;
  }

  function appendLoading() {
    const el = document.createElement('div');
    el.id = 'proIaLoading';
    el.className = 'd-flex mb-3 pro-ia-msg-bot';
    el.innerHTML = `
      <div class="flex-shrink-0 rounded-circle d-flex align-items-center justify-content-center me-2"
           style="width:32px;height:32px;background:linear-gradient(135deg,#6f42c1,#9d6bde);flex-shrink:0;">
        <i class="bi bi-robot text-white" style="font-size:0.8rem;"></i>
      </div>
      <div class="rounded-3 px-3 py-2 small" style="background:#f5f0ff;">
        <div class="d-flex gap-1 align-items-center">
          <div class="spinner-grow spinner-grow-sm" style="color:#9d6bde;width:.5rem;height:.5rem;"></div>
          <div class="spinner-grow spinner-grow-sm" style="color:#9d6bde;width:.5rem;height:.5rem;animation-delay:.15s;"></div>
          <div class="spinner-grow spinner-grow-sm" style="color:#9d6bde;width:.5rem;height:.5rem;animation-delay:.3s;"></div>
        </div>
      </div>`;
    messages.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
  }

  function removeLoading() {
    document.getElementById('proIaLoading')?.remove();
  }

  function escHtml(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function renderMd(text) {
    return text
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/`(.+?)`/g, '<code>$1</code>')
      .replace(/^#{1,3} (.+)$/gm, '<p class="fw-semibold mb-1">$1</p>')
      .replace(/^- (.+)$/gm, '<li style="margin-left:1rem;">$1</li>')
      .replace(/\n/g, '<br>');
  }

  async function sendMessage(msg) {
    if (!msg.trim()) return;
    input.value = '';
    sendBtn.disabled = true;
    appendMsg(msg, true);
    appendLoading();

    try {
      const resp = await fetch('/api/contextual_bot/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ message: msg, mode: 'expert' })
      });
      const data = await resp.json();
      removeLoading();
      if (data.quota_exceeded) {
        appendMsg(data.response?.content || "Quota atteint.", false);
      } else {
        appendMsg(data.response?.content || "Désolé, je n'ai pas pu répondre.", false);
      }
    } catch(e) {
      removeLoading();
      appendMsg("Une erreur est survenue. Veuillez réessayer.", false);
    } finally {
      sendBtn.disabled = false;
      input.focus();
    }
  }

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    sendMessage(input.value);
  });

  suggestions.forEach(function(btn) {
    btn.addEventListener('click', function() {
      sendMessage(btn.dataset.suggestion);
    });
  });
})();
</script>
<% end %>
