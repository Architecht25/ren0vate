<!-- Informations des consultants pour investissements d'entreprise -->
<div class="card border-0 bg-light mb-4">
  <div class="card-header bg-transparent border-0 pt-4 pb-0">
    <h6 class="card-title text-primary-custom mb-3">
      <i class="bi bi-people me-2"></i>Consultants spécialisés
    </h6>
  </div>
  <div class="card-body">

       <!-- Consultants spécialisés -->
    <div class="mb-4">

      <div class="row">
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :maitre_ouvrage_nom, "Nom du consultant", class: "form-label" %>
            <%= form.text_field :maitre_ouvrage_nom, class: "form-control", placeholder: "Ex: Sophie Leroy" %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :maitre_ouvrage_contact, "Email", class: "form-label" %>
            <%= form.text_field :maitre_ouvrage_contact, class: "form-control", placeholder: "Ex: sophie.leroy@entreprise.be" %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :numero_bce, "Numéro BCE", class: "form-label" %>
            <%= form.text_field :numero_bce, class: "form-control", placeholder: "Ex: BE0 833.618.097" %>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :coordinateur_securite_nom, "Consultant sécurité/conformité", class: "form-label" %>
            <%= form.text_field :coordinateur_securite_nom, class: "form-control", placeholder: "Ex: Bureau Sécurité Plus" %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.label :coordinateur_securite_contact, "Contact consultant", class: "form-label" %>
            <%= form.text_field :coordinateur_securite_contact, class: "form-control", placeholder: "Ex: +32 123 45 67 89" %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
