<!-- Partial des champs d'investissement pour les entreprises -->

<!-- Champ Finalité spécifique aux entreprises -->
<div class="mb-3">
  <%= form.label :finalite, "Finalité du projet*", class: "form-label" %>
  <%= form.select :finalite,
      options_for_select([
        ['Résidentielle - Pour un usage d\'habitation', 'residentielle'],
        ['Économique - Pour une activité professionnelle/commerciale', 'economique']
      ], form.object.finalite || 'economique'),
      { include_blank: false },
      { class: "form-select" } %>
  <div class="form-text">
    <i class="bi bi-info-circle me-1"></i>
    <strong>Résidentielle :</strong> Travaux sur un logement (appartement, maison).
    <strong>Économique :</strong> Travaux ou investissements pour une activité professionnelle.
  </div>
</div>

<!-- Nouveaux champs d'éligibilité pour Bruxelles -->
<div class="row g-3 mb-3">
  <div class="col-lg-6">
    <div class="form-check form-switch">
      <%= form.check_box :finalite_economique_confirmee,
          class: "form-check-input",
          style: "transform: scale(1.2);" %>
      <%= form.label :finalite_economique_confirmee,
          '<i class="bi bi-briefcase me-2 text-primary"></i>Finalité économique confirmée'.html_safe,
          class: "form-check-label fw-medium" %>
      <small class="text-muted d-block mt-1">
        Je confirme que ce projet a une finalité économique et commerciale
      </small>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="form-check form-switch">
      <%= form.check_box :demande_avant_debut,
          class: "form-check-input",
          style: "transform: scale(1.2);" %>
      <%= form.label :demande_avant_debut,
          '<i class="bi bi-clock me-2 text-warning"></i>Demande avant début'.html_safe,
          class: "form-check-label fw-medium" %>
      <small class="text-muted d-block mt-1">
        La demande sera introduite AVANT le début de la mission/investissement
      </small>
    </div>
  </div>
</div>

<div class="alert alert-success text-center">
  <i class="bi bi-building me-2"></i>
  <strong>Partial Investment Fields pour Entreprises</strong>
  <br>
  <small>Vous êtes bien sur le partial spécifique aux investissements d'entreprise</small>
</div>
