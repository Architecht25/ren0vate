<div class="container-fluid px-4 py-4">
  <!-- Header avec actions -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-hammer"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Modifier un chantier</h1>
    </div>
    <div>
      <%= link_to project_path(@project), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-pencil-square me-2"></i>Informations du chantier
          </h5>

          <%= form_with model: @project, local: true do |form| %>
            <%= render 'projects/partials_general/basic_fields', form: form %>

            <!-- Nouveau: Informations des professionnels -->
            <%= render 'projects/partials_general/professionals_fields', form: form %>

            <% if @project.property&.region.present? %>
              <%= render "projects/partials_#{@project.property.region.downcase}/eligibility_fields", form: form %>
            <% end %>

            <% if @project.respond_to?(:property_id) && defined?(Property) %>
              <div class="mb-3">
                <%= form.label :property_id, "Bien associé", class: "form-label" %>
                <%= form.collection_select :property_id, Property.all, :id, :name, { include_blank: "Sélectionner un bien..." }, class: "form-select" %>
              </div>
            <% end %>

            <div class="d-flex justify-content-end mt-4">
              <%= link_to "Annuler", project_path(@project), class: "btn btn-outline-secondary me-2" %>
              <%= form.submit "Enregistrer les modifications", class: "btn btn-primary-custom" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-info-circle me-2"></i>Aide
          </h5>
          <p class="text-muted-custom small mb-0">Un chantier vous permet d'organiser vos travaux de rénovation pour un bien immobilier. Vous pourrez y ajouter des travaux spécifiques, suivre leur avancement et gérer les documents associés.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
