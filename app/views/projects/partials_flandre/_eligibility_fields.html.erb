<!-- Champs spécifiques pour l'éligibilité aux primes Flandre -->
<div class="mb-4 mt-4" id="flandre-fields" style="display: none;">
  <h6 class="text-primary-custom mb-3">
    <i class="bi bi-award me-2"></i>Informations pour l'éligibilité aux primes (Flandre)
  </h6>
  <div class="border rounded p-3 bg-light">

    <!-- Type de travaux prévus -->
    <div class="mb-4">
      <label class="form-label fw-medium">Type de travaux prévus*</label>
      <div class="form-text mb-2">Sélectionnez tous les types de travaux que vous prévoyez réaliser :</div>
      <div class="row">
        <div class="col-md-6">
          <div class="form-check">
            <%= form.check_box :type_travaux_isolation, { class: "form-check-input" }, "1", "" %>
            <%= form.label :type_travaux_isolation, "Isolation (toiture, murs, sols)", class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= form.check_box :type_travaux_chauffage, { class: "form-check-input" }, "1", "" %>
            <%= form.label :type_travaux_chauffage, "Chauffage (pompe à chaleur, chaudière)", class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= form.check_box :type_travaux_ventilation, { class: "form-check-input" }, "1", "" %>
            <%= form.label :type_travaux_ventilation, "Ventilation", class: "form-check-label" %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-check">
            <%= form.check_box :type_travaux_fenetres, { class: "form-check-input" }, "1", "" %>
            <%= form.label :type_travaux_fenetres, "Fenêtres et portes", class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= form.check_box :type_travaux_toiture, { class: "form-check-input" }, "1", "" %>
            <%= form.label :type_travaux_toiture, "Rénovation de toiture", class: "form-check-label" %>
          </div>
          <div class="form-check">
            <%= form.check_box :type_travaux_autre, { class: "form-check-input" }, "1", "" %>
            <%= form.label :type_travaux_autre, "Autres travaux énergétiques", class: "form-check-label" %>
          </div>
        </div>
      </div>
    </div>

    <!-- Questions spécifiques Flandre -->
    <div class="mb-4">
      <label class="form-label fw-medium">Reconstruction et TVA</label>

      <div class="mb-3">
        <label class="form-label">Le bien est-il une reconstruction complète après démolition ?</label>
        <div class="form-check">
          <%= form.radio_button :reconstruction_demolition, true, class: "form-check-input" %>
          <%= form.label :reconstruction_demolition_true, "Oui", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= form.radio_button :reconstruction_demolition, false, class: "form-check-input" %>
          <%= form.label :reconstruction_demolition_false, "Non", class: "form-check-label" %>
        </div>
        <div class="form-text">Les reconstructions avec TVA réduite à 6% ne sont pas éligibles</div>
      </div>

      <div class="mb-3">
        <label class="form-label">Bénéficiez-vous du taux réduit de TVA à 6% ?</label>
        <div class="form-check">
          <%= form.radio_button :tva_reduit_6_pourcent, true, class: "form-check-input" %>
          <%= form.label :tva_reduit_6_pourcent_true, "Oui", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= form.radio_button :tva_reduit_6_pourcent, false, class: "form-check-input" %>
          <%= form.label :tva_reduit_6_pourcent_false, "Non", class: "form-check-label" %>
        </div>
        <div class="form-text">Les travaux avec TVA réduite peuvent affecter l'éligibilité</div>
      </div>
    </div>

    <!-- Dates importantes -->
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :invoice_date, "Date des factures de solde", class: "form-label" %>
          <%= form.date_field :invoice_date, class: "form-control" %>
          <div class="form-text">Les factures doivent dater de moins de 2 ans</div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :work_completion_date, "Date de fin des travaux", class: "form-label" %>
          <%= form.date_field :work_completion_date, class: "form-control" %>
          <div class="form-text">Date de finalisation des travaux</div>
        </div>
      </div>
    </div>

    <div class="alert alert-info small mb-0">
      <i class="bi bi-info-circle me-2"></i>
      Ces informations sont nécessaires pour vérifier l'éligibilité aux primes de rénovation en Flandre selon le questionnaire en 14 points.
    </div>
  </div>
</div>
