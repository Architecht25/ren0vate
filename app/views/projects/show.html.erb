<div class="container-fluid px-4 py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <% if @project.investment? %>
          <i class="bi bi-building"></i>
        <% else %>
          <i class="bi bi-hammer"></i>
        <% end %>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal"><%= @project.nom %></h1>
        <small class="text-muted">
          <i class="bi bi-tag me-1"></i><%= @project.type_display %>
          <% if @project.property.present? %>
            &nbsp;·&nbsp;<i class="bi bi-geo-alt me-1"></i><%= @project.property.rue %> <%= @project.property.numero %>, <%= @project.property.commune %>
          <% end %>
        </small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to project_path(@project),
            class: "btn btn-outline-danger",
            data: {
              turbo_method: :delete,
              turbo_confirm: "Supprimer définitivement '#{@project.nom}' ?\n\nCette action est IRRÉVERSIBLE."
            } do %>
        <i class="bi bi-trash me-1"></i>Supprimer ce chantier
      <% end %>
      <%= link_to projects_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour
      <% end %>
    </div>
  </div>

  <!-- ─── KPI chips ───────────────────────────────────────────────────── -->
  <%= render 'projects/partials_general/kpi_chips' %>

  <!-- ─── Navigation par onglets ─────────────────────────────────────── -->
  <ul class="nav nav-pills mb-4 gap-1 border-bottom pb-3">
    <li class="nav-item">
      <%= link_to project_path(@project, tab: :preparation),
            class: "nav-link #{'active' if @current_tab == 'preparation'}",
            data: { turbo_frame: "project_content", turbo_action: "advance" } do %>
        <i class="bi bi-clipboard-check me-2"></i>Préparation
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to project_path(@project, tab: :suivi),
            class: "nav-link #{'active' if @current_tab == 'suivi'}",
            data: { turbo_frame: "project_content", turbo_action: "advance" } do %>
        <i class="bi bi-hammer me-2"></i>Suivi
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to project_path(@project, tab: :reception),
            class: "nav-link #{'active' if @current_tab == 'reception'}",
            data: { turbo_frame: "project_content", turbo_action: "advance" } do %>
        <i class="bi bi-file-earmark-check me-2"></i>Réception
      <% end %>
    </li>
  </ul>

  <!-- ─── Contenu de la section active (Turbo Frame) ─────────────────── -->
  <%= turbo_frame_tag "project_content", target: "_top" do %>
    <% case @current_tab %>
    <% when 'suivi' %>
      <%= render 'projects/partials_general/tab_suivi' %>
    <% when 'reception' %>
      <%= render 'projects/partials_general/tab_reception' %>
    <% else %>
      <%= render 'projects/partials_general/tab_preparation' %>
    <% end %>
  <% end %>

</div>
