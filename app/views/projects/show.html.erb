    <div class="col-lg-4 col-md-6">
      <div class="card border border-2 rounded-4 h-100" style="border-color:#e2e8f0!important; opacity:0.75;">
        <div class="card-body p-3 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-2">
            <div class="rounded-3 p-2 flex-shrink-0" style="background:rgba(51,65,85,0.08);">
              <i class="bi bi-file-earmark-ruled text-primary fs-5"></i>
            </div>
            <div>
              <div class="fw-semibold" style="font-size:0.9rem;">Templates de contrat</div>
              <span class="badge bg-secondary" style="font-size:0.65rem;">Bientôt disponible</span>
            </div>
          </div>
          <p class="text-muted small mb-0">Accédez à des modèles de contrats pré-remplis adaptés à votre type de chantier.</p>
        </div>
      </div>
    </div>

    <!-- Permis d'urbanisme -->
    <div class="col-lg-4 col-md-6">
      <div class="card border border-2 rounded-4 h-100" style="border-color:#e2e8f0!important; opacity:0.75;">
        <div class="card-body p-3 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-2">
            <div class="rounded-3 p-2 flex-shrink-0" style="background:rgba(51,65,85,0.08);">
              <i class="bi bi-building-gear text-primary fs-5"></i>
            </div>
            <div>
              <div class="fw-semibold" style="font-size:0.9rem;">Permis d'urbanisme</div>
              <span class="badge bg-secondary" style="font-size:0.65rem;">Bientôt disponible</span>
