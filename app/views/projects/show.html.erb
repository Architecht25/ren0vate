<div class="container-fluid px-4 py-4">
  <!-- Header avec actions -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <% if @project.investment? %>
          <i class="bi bi-building"></i>
        <% else %>
          <i class="bi bi-hammer"></i>
        <% end %>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal"><%= @project.nom %></h1>
        <small class="text-muted">
          <i class="bi bi-tag me-1"></i><%= @project.type_display %>
        </small>
      </div>
    </div>
    <div>
      <%= link_to edit_project_path(@project), class: "btn btn-outline-primary-custom me-2" do %>
        <i class="bi bi-pencil me-2"></i>Modifier
      <% end %>

      <div class="btn-group me-2" role="group">
        <button type="button" class="btn btn-outline-danger dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-trash me-2"></i>Supprimer
        </button>
        <ul class="dropdown-menu">
          <li>
            <h6 class="dropdown-header">Attention</h6>
          </li>
          <li>
            <span class="dropdown-item-text small text-muted">
              Cette action supprimera définitivement <%= @project.investment? ? "l'investissement" : "le chantier" %> et toutes ses données associées.
            </span>
          </li>
          <li><hr class="dropdown-divider"></li>
          <li>
            <%= link_to project_path(@project),
                class: "dropdown-item text-danger fw-bold",
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Êtes-vous absolument sûr de vouloir supprimer #{@project.investment? ? "l'investissement" : "le chantier"} '#{@project.nom}' ?\n\nCette action est IRRÉVERSIBLE et supprimera :\n- #{@project.investment? ? "L'investissement" : "Le chantier"} et ses paramètres\n- Tous les #{@project.investment? ? "aménagements" : "travaux"} associés\n- Les documents liés\n- L'historique complet\n\nTapez 'SUPPRIMER' pour confirmer"
                } do %>
              <i class="bi bi-trash me-2"></i>Confirmer la suppression
            <% end %>
          </li>
        </ul>
      </div>

      <%= link_to projects_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Colonne latérale - Actions rapides -->
    <div class="col-lg-4 order-lg-2">
      <!-- Actions rapides -->
      <div class="form-section bg-light-subtle border rounded-3 p-4 mb-4">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle me-3">
            <i class="bi bi-lightning-charge"></i>
          </div>
          <h5 class="mb-0 fw-normal text-primary-custom">Actions rapides</h5>
        </div>
        <div class="d-grid gap-2">
          <%= link_to technical_validation_project_path(@project), class: "btn btn-outline-success mb-2" do %>
            <i class="bi bi-shield-check me-2"></i>Validation technique
          <% end %>
          <%= link_to projects_path, class: "btn btn-outline-primary-custom mb-2" do %>
            <i class="bi bi-file-earmark-pdf me-2"></i>Exporter en PDF
          <% end %>
          <%= link_to projects_path, class: "btn btn-outline-primary-custom" do %>
            <i class="bi bi-share me-2"></i>Partager avec un artisan
          <% end %>
        </div>
      </div>

      <!-- Statut validation technique -->
      <% if @project.validation_status.present? %>
        <div class="form-section bg-light-subtle border rounded-3 p-4 mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <% if @project.validation_status == 'validated' %>
                <i class="bi bi-shield-check text-success"></i>
              <% elsif @project.validation_status == 'failed' %>
                <i class="bi bi-shield-x text-danger"></i>
              <% else %>
                <i class="bi bi-shield-question text-warning"></i>
              <% end %>
            </div>
            <h5 class="mb-0 fw-normal text-primary-custom">Validation technique</h5>
          </div>

          <div class="mb-3">
            <% case @project.validation_status %>
            <% when 'validated' %>
              <div class="alert alert-success mb-2">
                <i class="bi bi-check-circle me-2"></i>
                <strong>Validé</strong> - Projet conforme aux exigences techniques
              </div>
            <% when 'failed' %>
              <div class="alert alert-warning mb-2">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Non conforme</strong> - Corrections requises
              </div>
            <% else %>
              <div class="alert alert-info mb-2">
                <i class="bi bi-info-circle me-2"></i>
                <strong>En attente</strong> - Validation en cours
              </div>
            <% end %>

            <% if @project.validation_score.present? %>
              <div class="d-flex align-items-center mb-2">
                <span class="me-2">Score :</span>
                <div class="progress flex-grow-1 me-2" style="height: 6px;">
                  <div class="progress-bar
                    <%= @project.validation_score >= 80 ? 'bg-success' :
                        @project.validation_score >= 60 ? 'bg-warning' : 'bg-danger' %>"
                       style="width: <%= @project.validation_score %>%"></div>
                </div>
                <span class="fw-bold"><%= @project.validation_score %>/100</span>
              </div>
            <% end %>

            <% if @project.last_validation_at.present? %>
              <small class="text-muted">
                Dernière validation : <%= @project.last_validation_at.strftime("%d/%m/%Y à %H:%M") %>
              </small>
            <% end %>
          </div>

          <div class="d-grid">
            <%= link_to technical_validation_project_path(@project), class: "btn btn-outline-success btn-sm" do %>
              <i class="bi bi-arrow-right me-2"></i>Voir les détails
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Informations générales -->
    <div class="col-lg-8 order-lg-1">
      <div class="form-section bg-light-subtle border rounded-3 p-4 mb-4">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle me-3">
            <i class="bi bi-info-circle"></i>
          </div>
          <h5 class="mb-0 fw-normal text-primary-custom">Informations générales</h5>
        </div>

        <div class="row mb-3">
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Nom du chantier</label>
              <p class="mb-0 fs-5"><%= @project.nom %></p>
            </div>
          </div>
          <div class="col-md-6">
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Date de création</label>
              <p class="mb-0"><%= @project.created_at.strftime("%d/%m/%Y") %></p>
            </div>
          </div>
        </div>

          <% if @project.property.present? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Bien associé</label>
              <div class="d-flex align-items-center">
                <div class="icon-circle me-3" style="width: 32px; height: 32px; font-size: 14px;">
                  <i class="bi bi-house-door"></i>
                </div>
                <div>
                  <p class="mb-0"><%= @project.property.respond_to?(:address) ? @project.property.address : "#{@project.property.rue} #{@project.property.numero}" %></p>
                </div>
              </div>
            </div>
          <% end %>

          <% if @project.description.present? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Description</label>
              <p class="mb-0"><%= @project.description %></p>
            </div>
          <% end %>

          <!-- Dates du projet -->
          <% if @project.date_début.present? || @project.date_fin.present? %>
            <div class="row">
              <% if @project.date_début.present? %>
                <div class="col-md-6">
                  <div class="mb-3">
                    <label class="form-label text-muted-custom small">Date de début</label>
                    <p class="mb-0">
                      <i class="bi bi-calendar-event text-success me-2"></i>
                      <%= @project.date_début.strftime("%d/%m/%Y") %>
                    </p>
                  </div>
                </div>
              <% end %>

              <% if @project.date_fin.present? %>
                <div class="col-md-6">
                  <div class="mb-3">
                    <label class="form-label text-muted-custom small">Date de fin prévue</label>
                    <p class="mb-0">
                      <i class="bi bi-calendar-check text-primary me-2"></i>
                      <%= @project.date_fin.strftime("%d/%m/%Y") %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <!-- Statut du projet -->
          <% if @project.statut.present? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Statut</label>
              <p class="mb-0">
                <% case @project.statut %>
                <% when 'preparation' %>
                  <span class="badge bg-secondary"><i class="bi bi-clock me-1"></i>En préparation</span>
                <% when 'en_cours' %>
                  <span class="badge bg-primary"><i class="bi bi-play me-1"></i>En cours</span>
                <% when 'pause' %>
                  <span class="badge bg-warning"><i class="bi bi-pause me-1"></i>En pause</span>
                <% when 'termine' %>
                  <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Terminé</span>
                <% when 'annule' %>
                  <span class="badge bg-danger"><i class="bi bi-x me-1"></i>Annulé</span>
                <% else %>
                  <span class="badge bg-light text-dark"><%= @project.statut.humanize %></span>
                <% end %>
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Informations pour l'éligibilité aux primes -->
      <% if @project.bce_number.present? || @project.invoice_date.present? || @project.work_completion_date.present? %>
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <h5 class="card-title text-primary-custom mb-3">
              <i class="bi bi-award me-2"></i>Informations pour l'éligibilité aux primes
            </h5>

            <div class="row">
              <% if @project.bce_number.present? %>
                <div class="col-md-6">
                  <div class="mb-3">
                    <label class="form-label text-muted-custom small">Numéro BCE Entrepreneur</label>
                    <p class="mb-0">
                      <i class="bi bi-building text-info me-2"></i>
                      <%= @project.bce_number %>
                      <% if @project.bce_number.match?(/\A\d{10}\z/) %>
                        <span class="badge bg-success ms-2">
                          <i class="bi bi-check-circle me-1"></i>Valide
                        </span>
                      <% else %>
                        <span class="badge bg-warning ms-2">
                          <i class="bi bi-exclamation-triangle me-1"></i>Format invalide
                        </span>
                      <% end %>
                    </p>
                  </div>
                </div>
              <% end %>

              <% if @project.invoice_date.present? %>
                <div class="col-md-6">
                  <div class="mb-3">
                    <label class="form-label text-muted-custom small">Date des factures</label>
                    <p class="mb-0">
                      <i class="bi bi-receipt text-info me-2"></i>
                      <%= @project.invoice_date.strftime("%d/%m/%Y") %>
                      <% days_diff = (Date.current - @project.invoice_date).to_i %>
                      <% if days_diff <= (2 * 365) %>
                        <span class="badge bg-success ms-2">
                          <i class="bi bi-check-circle me-1"></i>Éligible
                        </span>
                      <% else %>
                        <span class="badge bg-danger ms-2">
                          <i class="bi bi-x-circle me-1"></i>Trop ancien (>2 ans)
                        </span>
                      <% end %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>

            <% if @project.work_completion_date.present? %>
              <div class="mb-3">
                <label class="form-label text-muted-custom small">Date de fin des travaux</label>
                <p class="mb-0">
                  <i class="bi bi-calendar-check text-info me-2"></i>
                  <%= @project.work_completion_date.strftime("%d/%m/%Y") %>
                </p>
              </div>
            <% end %>

            <!-- Indicateur d'éligibilité global -->
            <div class="alert alert-info mb-0">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Statut d'éligibilité :</strong>
              <% if @project.property&.region == 'wallonie' %>
                <% if @project.bce_number.present? && @project.bce_number.match?(/\A\d{10}\z/) %>
                  <span class="text-success">✓ Prêt pour la vérification d'éligibilité Wallonie</span>
                <% else %>
                  <span class="text-warning">⚠ Numéro BCE requis pour l'éligibilité Wallonie</span>
                <% end %>
              <% else %>
                <span class="text-muted">Informations enregistrées pour référence</span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Section Suivi budgétaire : Devis vs Factures -->
    <% if @project.architecte_devis_montant.present? || @project.contractor_devis_montant.present? %>
      <div class="col-lg-4 order-lg-2 mb-4">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-header bg-transparent border-0 pt-4">
            <h5 class="card-title text-primary-custom mb-0">
              <i class="bi bi-calculator me-2"></i>Suivi budgétaire
            </h5>
          </div>
          <div class="card-body">

            <!-- Devis Architecte -->
            <% if @project.architecte_devis_montant.present? %>
              <div class="mb-4">
                <h6 class="text-secondary mb-2">
                  <i class="bi bi-building me-2"></i>Architecte
                </h6>
                <div class="row">
                  <div class="col-6">
                    <small class="text-muted d-block">Devis initial</small>
                    <span class="fw-bold text-primary"><%= @project.architecte_devis_montant_formatted %></span>
                  </div>
                  <div class="col-6">
                    <small class="text-muted d-block">Facturé</small>
                    <span class="fw-bold"><%= number_to_currency(@project.architecte_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
                  </div>
                </div>
                <% if @project.architecte_devis_vs_factures_difference %>
                  <div class="mt-2">
                    <small class="text-muted d-block">Écart</small>
                    <span class="fw-bold <%= @project.architecte_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                      <%= @project.architecte_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.architecte_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                    </span>
                  </div>
                <% end %>
              </div>
            <% end %>

            <!-- Devis Entrepreneur -->
            <% if @project.contractor_devis_montant.present? %>
              <div class="mb-4">
                <h6 class="text-secondary mb-2">
                  <i class="bi bi-hammer me-2"></i>Entrepreneur
                </h6>
                <div class="row">
                  <div class="col-6">
                    <small class="text-muted d-block">Devis initial</small>
                    <span class="fw-bold text-primary"><%= @project.contractor_devis_montant_formatted %></span>
                  </div>
                  <div class="col-6">
                    <small class="text-muted d-block">Facturé</small>
                    <span class="fw-bold"><%= number_to_currency(@project.contractor_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
                  </div>
                </div>
                <% if @project.contractor_devis_vs_factures_difference %>
                  <div class="mt-2">
                    <small class="text-muted d-block">Écart</small>
                    <span class="fw-bold <%= @project.contractor_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                      <%= @project.contractor_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.contractor_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                    </span>
                  </div>
                <% end %>
              </div>
            <% end %>

            <!-- Total -->
            <div class="border-top pt-3">
              <div class="row">
                <div class="col-6">
                  <small class="text-muted d-block">Total devis</small>
                  <span class="fw-bold text-primary h6"><%= number_to_currency(@project.total_devis_montant, unit: "€", separator: ",", delimiter: " ") %></span>
                </div>
                <div class="col-6">
                  <small class="text-muted d-block">Total facturé</small>
                  <span class="fw-bold h6"><%= number_to_currency(@project.architecte_factures_total + @project.contractor_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
                </div>
              </div>
              <div class="mt-2">
                <small class="text-muted d-block">Écart total</small>
                <span class="fw-bold h6 <%= @project.total_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                  <%= @project.total_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.total_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Section Équipe projet & Professionnels dans la même row -->
    <div class="col-lg-8 order-lg-1">
      <!-- Informations des professionnels -->
      <%= render 'projects/partials_general/professionals_display' %>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
