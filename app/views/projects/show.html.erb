<div class="container-fluid px-4 py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <% if @project.investment? %>
          <i class="bi bi-building"></i>
        <% else %>
          <i class="bi bi-hammer"></i>
        <% end %>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal"><%= @project.nom %></h1>
        <small class="text-muted">
          <i class="bi bi-tag me-1"></i><%= @project.type_display %>
          <% if @project.property.present? %>
            &nbsp;·&nbsp;<i class="bi bi-geo-alt me-1"></i><%= @project.property.rue %> <%= @project.property.numero %>, <%= @project.property.commune %>
          <% end %>
        </small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to edit_project_path(@project), class: "btn btn-outline-primary-custom" do %>
        <i class="bi bi-pencil me-2"></i>Modifier
      <% end %>
      <%= link_to gantt_project_path(@project), class: "btn btn-outline-primary-custom" do %>
        <i class="bi bi-calendar-range me-2"></i>Planning
      <% end %>
      <div class="dropdown">
        <button class="btn btn-outline-danger dropdown-toggle" type="button" data-bs-toggle="dropdown">
          <i class="bi bi-three-dots-vertical"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
          <li><h6 class="dropdown-header text-danger">Zone dangereuse</h6></li>
          <li>
            <%= link_to project_path(@project),
                class: "dropdown-item text-danger",
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Supprimer définitivement '#{@project.nom}' ?\n\nCette action est IRRÉVERSIBLE."
                } do %>
              <i class="bi bi-trash me-2"></i>Supprimer le chantier
            <% end %>
          </li>
        </ul>
      </div>
      <%= link_to projects_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour
      <% end %>
    </div>
  </div>

  <!-- ─── Rangée 1 : KPI chips ──────────────────────────────────────── -->
  <div class="row g-3 mb-4">

    <!-- Statut -->
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-3 p-2 flex-shrink-0" style="background:#e8f4f8;">
            <i class="bi bi-activity fs-5 text-primary"></i>
          </div>
          <div>
            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em;">Statut</div>
            <% if @project.statut == 'preparation' %>
              <span class="badge bg-secondary">En préparation</span>
            <% elsif @project.statut == 'en_cours' %>
              <span class="badge bg-primary">En cours</span>
            <% elsif @project.statut == 'pause' %>
              <span class="badge bg-warning text-dark">En pause</span>
            <% elsif @project.statut == 'termine' %>
              <span class="badge bg-success">Terminé</span>
            <% elsif @project.statut == 'annule' %>
              <span class="badge bg-danger">Annulé</span>
            <% else %>
              <span class="badge bg-light text-dark"><%= @project.statut&.humanize || '—' %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Période -->
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-3 p-2 flex-shrink-0" style="background:#f0fdf4;">
            <i class="bi bi-calendar-range fs-5 text-success"></i>
          </div>
          <div>
            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em;">Période</div>
            <div class="fw-semibold" style="font-size:0.85rem;">
              <% if @project.date_début && @project.date_fin %>
                <%= @project.date_début.strftime("%d/%m/%y") %> → <%= @project.date_fin.strftime("%d/%m/%y") %>
              <% elsif @project.date_début %>
                Début <%= @project.date_début.strftime("%d/%m/%Y") %>
              <% else %>
                <span class="text-muted">Non défini</span>
              <% end %>
            </div>
            <% if @project.date_début && @project.date_fin %>
              <small class="text-muted"><%= (@project.date_fin - @project.date_début).to_i %> jours</small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Budget -->
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-3 p-2 flex-shrink-0" style="background:#fff7ed;">
            <i class="bi bi-currency-euro fs-5 text-warning"></i>
          </div>
          <div>
            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em;">Budget total</div>
            <% total = @project.total_devis_montant.to_f %>
            <div class="fw-semibold" style="font-size:0.9rem;">
              <% if total > 0 %>
                <%= number_to_currency(total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
              <% else %>
                <span class="text-muted">Non renseigné</span>
              <% end %>
            </div>
            <% if @planning_items_count > 0 %>
              <small class="text-muted"><%= @planning_items_count %> poste<%= 's' if @planning_items_count != 1 %> au devis</small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Factures -->
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-3 p-2 flex-shrink-0" style="background:#fdf4ff;">
            <i class="bi bi-receipt fs-5 text-purple" style="color:#7c3aed;"></i>
          </div>
          <div>
            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em;">Factures</div>
            <div class="fw-semibold" style="font-size:0.9rem;"><%= @factures_count %> facture<%= 's' if @factures_count != 1 %></div>
            <% factures_total = @project.architecte_factures_total.to_f + @project.contractor_factures_total.to_f %>
            <% if factures_total > 0 %>
              <small class="text-muted"><%= number_to_currency(factures_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %> facturé</small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- ─── Rangée 2 : Infos | Budget | Éligibilité ───────────────────── -->
  <div class="row g-3 mb-4">

    <!-- Infos générales -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-bottom py-3">
          <h6 class="mb-0 fw-semibold text-primary-custom">
            <i class="bi bi-info-circle me-2"></i>Informations générales
          </h6>
        </div>
        <div class="card-body p-3">
          <% if @project.property.present? %>
            <div class="mb-3">
              <div class="text-muted small mb-1">Bien associé</div>
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-house-door text-primary"></i>
                <span class="fw-semibold"><%= @project.property.rue %> <%= @project.property.numero %>, <%= @project.property.commune %></span>
              </div>
            </div>
          <% end %>
          <% if @project.description.present? %>
            <div class="mb-3">
              <div class="text-muted small mb-1">Description</div>
              <p class="mb-0 small"><%= @project.description %></p>
            </div>
          <% end %>
          <div class="mb-3">
            <div class="text-muted small mb-1">Créé le</div>
            <span><%= @project.created_at.strftime("%d/%m/%Y") %></span>
          </div>
          <% if @project.date_début.present? || @project.date_fin.present? %>
            <div class="row gx-2 mb-3">
              <% if @project.date_début.present? %>
                <div class="col-6">
                  <div class="text-muted small mb-1">Début</div>
                  <span class="text-success fw-semibold"><%= @project.date_début.strftime("%d/%m/%Y") %></span>
                </div>
              <% end %>
              <% if @project.date_fin.present? %>
                <div class="col-6">
                  <div class="text-muted small mb-1">Fin prévue</div>
                  <span class="text-danger fw-semibold"><%= @project.date_fin.strftime("%d/%m/%Y") %></span>
                </div>
              <% end %>
            </div>
          <% end %>
          <% if @project.date_début && @project.date_fin %>
            <%
              total_d = (@project.date_fin - @project.date_début).to_i
              elapsed_d = [(Date.today - @project.date_début).to_i, 0].max
              pct_d = total_d > 0 ? [[elapsed_d.to_f / total_d * 100, 0].max, 100].min.round : 0
            %>
            <div class="text-muted small mb-1">Avancement temporel — <%= pct_d %>%</div>
            <div class="progress" style="height:6px;">
              <div class="progress-bar bg-success" style="width:<%= pct_d %>%;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Suivi budgétaire -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-bottom py-3">
          <h6 class="mb-0 fw-semibold text-primary-custom">
            <i class="bi bi-calculator me-2"></i>Suivi budgétaire
          </h6>
        </div>
        <div class="card-body p-3">
          <% if @project.architecte_devis_montant.present? || @project.contractor_devis_montant.present? %>

            <% if @project.architecte_devis_montant.present? %>
              <div class="mb-3 pb-3 border-bottom">
                <div class="text-muted small mb-2"><i class="bi bi-building me-1"></i>Architecte</div>
                <div class="d-flex justify-content-between">
                  <div>
                    <div class="text-muted" style="font-size:0.72rem;">Devis</div>
                    <span class="fw-semibold text-primary"><%= @project.architecte_devis_montant_formatted %></span>
                  </div>
                  <div class="text-end">
                    <div class="text-muted" style="font-size:0.72rem;">Facturé</div>
                    <span class="fw-semibold"><%= number_to_currency(@project.architecte_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
                  </div>
                  <% if @project.architecte_devis_vs_factures_difference %>
                    <div class="text-end">
                      <div class="text-muted" style="font-size:0.72rem;">Écart</div>
                      <span class="fw-semibold <%= @project.architecte_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                        <%= @project.architecte_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.architecte_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @project.contractor_devis_montant.present? %>
              <div class="mb-3 pb-3 border-bottom">
                <div class="text-muted small mb-2"><i class="bi bi-hammer me-1"></i>Entrepreneur</div>
                <div class="d-flex justify-content-between">
                  <div>
                    <div class="text-muted" style="font-size:0.72rem;">Devis</div>
                    <span class="fw-semibold text-primary"><%= @project.contractor_devis_montant_formatted %></span>
                  </div>
                  <div class="text-end">
                    <div class="text-muted" style="font-size:0.72rem;">Facturé</div>
                    <span class="fw-semibold"><%= number_to_currency(@project.contractor_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
                  </div>
                  <% if @project.contractor_devis_vs_factures_difference %>
                    <div class="text-end">
                      <div class="text-muted" style="font-size:0.72rem;">Écart</div>
                      <span class="fw-semibold <%= @project.contractor_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                        <%= @project.contractor_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.contractor_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="d-flex justify-content-between align-items-center">
              <div>
                <div class="text-muted small">Total devis</div>
                <span class="fw-bold text-primary"><%= number_to_currency(@project.total_devis_montant, unit: "€", separator: ",", delimiter: " ") %></span>
              </div>
              <div class="text-end">
                <div class="text-muted small">Total facturé</div>
                <span class="fw-bold"><%= number_to_currency(@project.architecte_factures_total + @project.contractor_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
              </div>
              <div class="text-end">
                <div class="text-muted small">Écart</div>
                <span class="fw-bold <%= @project.total_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                  <%= @project.total_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.total_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                </span>
              </div>
            </div>

          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-calculator text-muted mb-3 d-block" style="font-size:2rem;"></i>
              <div class="text-muted small">Aucun budget défini</div>
              <%= link_to edit_project_path(@project), class: "btn btn-sm btn-outline-primary-custom mt-3" do %>
                <i class="bi bi-pencil me-1"></i>Renseigner le budget
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Éligibilité primes -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-bottom py-3">
          <h6 class="mb-0 fw-semibold text-primary-custom">
            <i class="bi bi-award me-2"></i>Éligibilité aux primes
          </h6>
        </div>
        <div class="card-body p-3">
          <% if @project.bce_number.present? || @project.invoice_date.present? || @project.work_completion_date.present? %>

            <% if @project.bce_number.present? %>
              <div class="mb-3">
                <div class="text-muted small mb-1">Numéro BCE Entrepreneur</div>
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-building text-info"></i>
                  <span><%= @project.bce_number %></span>
                  <% if @project.bce_number.match?(/\A\d{10}\z/) %>
                    <span class="badge bg-success ms-auto">Valide</span>
                  <% else %>
                    <span class="badge bg-warning text-dark ms-auto">Format invalide</span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @project.invoice_date.present? %>
              <div class="mb-3">
                <div class="text-muted small mb-1">Date des factures</div>
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-receipt text-info"></i>
                  <span><%= @project.invoice_date.strftime("%d/%m/%Y") %></span>
                  <% if (Date.current - @project.invoice_date).to_i <= (2 * 365) %>
                    <span class="badge bg-success ms-auto">Éligible</span>
                  <% else %>
                    <span class="badge bg-danger ms-auto">&gt; 2 ans</span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @project.work_completion_date.present? %>
              <div class="mb-3">
                <div class="text-muted small mb-1">Fin des travaux</div>
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-calendar-check text-info"></i>
                  <span><%= @project.work_completion_date.strftime("%d/%m/%Y") %></span>
                </div>
              </div>
            <% end %>

            <div class="alert alert-info mb-0 p-2" style="font-size:0.82rem;">
              <i class="bi bi-info-circle me-1"></i>
              <% if @project.property&.region == 'wallonie' %>
                <% if @project.bce_number.present? && @project.bce_number.match?(/\A\d{10}\z/) %>
                  <span class="text-success fw-semibold">Prêt pour la vérification Wallonie</span>
                <% else %>
                  Numéro BCE requis pour l'éligibilité Wallonie
                <% end %>
              <% else %>
                Données enregistrées pour référence
              <% end %>
            </div>

          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-award text-muted d-block mb-3" style="font-size:2rem;"></i>
              <div class="text-muted small">Aucune information d'éligibilité renseignée</div>
              <%= link_to edit_project_path(@project), class: "btn btn-sm btn-outline-primary-custom mt-3" do %>
                <i class="bi bi-pencil me-1"></i>Compléter
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <!-- ─── Rangée 3 : Planning Gantt preview ─────────────────────────── -->
  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%); color: #fff; overflow: hidden;">
        <div class="card-body p-4">
          <div class="row align-items-center">
            <div class="col-lg-7">
              <div class="d-flex align-items-center mb-3">
                <div class="me-3" style="width:44px; height:44px; background:rgba(255,255,255,0.12); border-radius:12px; display:flex; align-items:center; justify-content:center;">
                  <i class="bi bi-calendar-range fs-4"></i>
                </div>
                <div>
                  <h5 class="mb-0 fw-semibold">Planning de chantier</h5>
                  <small style="opacity:0.7;">Diagramme de Gantt automatique depuis le devis</small>
                </div>
              </div>
              <div class="d-flex flex-wrap gap-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                  <span style="width:8px;height:8px;border-radius:50%;background:#4ade80;display:inline-block;"></span>
                  <span style="font-size:0.85rem;opacity:0.9;">
                    <% if @project.date_début %>Début <%= @project.date_début.strftime("%d/%m/%Y") %>
                    <% else %><span style="opacity:0.6;">Date début non définie</span><% end %>
                  </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span style="width:8px;height:8px;border-radius:50%;background:#f87171;display:inline-block;"></span>
                  <span style="font-size:0.85rem;opacity:0.9;">
                    <% if @project.date_fin %>Fin <%= @project.date_fin.strftime("%d/%m/%Y") %>
                    <% else %><span style="opacity:0.6;">Date fin non définie</span><% end %>
                  </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-list-task" style="opacity:0.7;"></i>
                  <span style="font-size:0.85rem;opacity:0.9;"><%= @planning_items_count %> poste<%= 's' if @planning_items_count != 1 %></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <i class="bi bi-receipt" style="opacity:0.7;"></i>
                  <span style="font-size:0.85rem;opacity:0.9;"><%= @factures_count %> facture<%= 's' if @factures_count != 1 %></span>
                </div>
              </div>
              <% if @project.date_début && @project.date_fin %>
                <%
                  total_g = (@project.date_fin - @project.date_début).to_i
                  elapsed_g = [(Date.today - @project.date_début).to_i, 0].max
                  pct_g = total_g > 0 ? [[elapsed_g.to_f / total_g * 100, 0].max, 100].min.round : 0
                %>
                <div class="mb-1" style="font-size:0.75rem;opacity:0.7;">Avancement temporel — <%= pct_g %>%</div>
                <div style="height:6px;background:rgba(255,255,255,0.15);border-radius:4px;overflow:hidden;">
                  <div style="height:100%;width:<%= pct_g %>%;background:linear-gradient(90deg,#4ade80,#22d3ee);border-radius:4px;"></div>
                </div>
              <% end %>
            </div>
            <div class="col-lg-5 text-lg-end mt-4 mt-lg-0">
              <%= link_to gantt_project_path(@project), class: "btn px-5 py-3 fw-semibold",
                  style: "background:#fff;color:#1a1a2e;border-radius:12px;font-size:0.95rem;box-shadow:0 4px 20px rgba(0,0,0,0.2);" do %>
                <i class="bi bi-calendar-range me-2"></i>Voir le planning Gantt
              <% end %>
              <% unless @latest_quote %>
                <div class="mt-2" style="font-size:0.78rem;opacity:0.6;">
                  <i class="bi bi-info-circle me-1"></i>Créez un devis pour générer le planning
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ─── Rangée 4 : Équipe projet ──────────────────────────────────── -->
  <div class="row g-3 mb-4">
    <div class="col-12">
      <%= render 'projects/partials_general/professionals_display' %>
    </div>
  </div>

  <!-- ─── Rangée 4b : Inviter des pros (collaboration) ─────────────── -->
  <div class="row g-3 mb-4">
    <div class="col-12">
      <%= render 'projects/partials_general/invite_pros', project: @project %>
    </div>
  </div>

  <!-- ─── Rangée 5 : Photos de suivi ───────────────────────────────── -->
  <div class="row g-3">
    <div class="col-12">
      <%= render 'projects/partials_general/photos_suivi' %>
    </div>
  </div>

</div>
