<div class="container-fluid px-4 py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <% if @project.investment? %>
          <i class="bi bi-building"></i>
        <% else %>
          <i class="bi bi-hammer"></i>
        <% end %>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal"><%= @project.nom %></h1>
        <small class="text-muted">
          <i class="bi bi-tag me-1"></i><%= @project.type_display %>
          <% if @project.property.present? %>
            &nbsp;·&nbsp;<i class="bi bi-geo-alt me-1"></i><%= @project.property.rue %> <%= @project.property.numero %>, <%= @project.property.commune %>
          <% end %>
        </small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to project_path(@project),
            class: "btn btn-outline-danger",
            data: {
              turbo_method: :delete,
              turbo_confirm: "Supprimer définitivement '#{@project.nom}' ?\n\nCette action est IRRÉVERSIBLE."
            } do %>
        <i class="bi bi-trash me-1"></i>Supprimer ce chantier
      <% end %>
      <%= link_to projects_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour
      <% end %>
    </div>
  </div>

  <!-- ─── KPI chips (synthèse globale) ─────────────────────────────── -->
  <div class="row g-3 mb-5">

    <!-- Statut -->
    <div class="col-6 col-md-3">
      <div class="card border border-2 rounded-4 h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-3 p-2 flex-shrink-0" style="background:#e8f4f8;">
            <i class="bi bi-activity fs-5 text-primary"></i>
          </div>
          <div>
            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em;">Statut</div>
            <% if @project.statut == 'preparation' %>
              <span class="badge bg-secondary">En préparation</span>
            <% elsif @project.statut == 'en_cours' %>
              <span class="badge bg-primary">En cours</span>
            <% elsif @project.statut == 'pause' %>
              <span class="badge bg-warning text-dark">En pause</span>
            <% elsif @project.statut == 'termine' %>
              <span class="badge bg-success">Terminé</span>
            <% elsif @project.statut == 'annule' %>
              <span class="badge bg-danger">Annulé</span>
            <% else %>
              <span class="badge bg-light text-dark"><%= @project.statut&.humanize || '—' %></span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Période -->
    <div class="col-6 col-md-3">
      <div class="card border border-2 rounded-4 h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-3 p-2 flex-shrink-0" style="background:#f0fdf4;">
            <i class="bi bi-calendar-range fs-5 text-success"></i>
          </div>
          <div>
            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em;">Période</div>
            <div class="fw-semibold" style="font-size:0.85rem;">
              <% if @project.date_début && @project.date_fin %>
                <%= @project.date_début.strftime("%d/%m/%y") %> → <%= @project.date_fin.strftime("%d/%m/%y") %>
              <% elsif @project.date_début %>
                Début <%= @project.date_début.strftime("%d/%m/%Y") %>
              <% else %>
                <span class="text-muted">Non défini</span>
              <% end %>
            </div>
            <% if @project.date_début && @project.date_fin %>
              <small class="text-muted"><%= (@project.date_fin - @project.date_début).to_i %> jours</small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Budget -->
    <div class="col-6 col-md-3">
      <div class="card border border-2 rounded-4 h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-3 p-2 flex-shrink-0" style="background:#fff7ed;">
            <i class="bi bi-currency-euro fs-5 text-warning"></i>
          </div>
          <div>
            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em;">Budget total</div>
            <% total = @project.total_devis_montant.to_f %>
            <div class="fw-semibold" style="font-size:0.9rem;">
              <% if total > 0 %>
                <%= number_to_currency(total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
              <% else %>
                <span class="text-muted">Non renseigné</span>
              <% end %>
            </div>
            <% if @planning_items_count > 0 %>
              <small class="text-muted"><%= @planning_items_count %> poste<%= 's' if @planning_items_count != 1 %> au devis</small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Factures -->
    <div class="col-6 col-md-3">
      <div class="card border border-2 rounded-4 h-100">
        <div class="card-body p-3 d-flex align-items-center gap-3">
          <div class="rounded-3 p-2 flex-shrink-0" style="background:#fdf4ff;">
            <i class="bi bi-receipt fs-5 text-purple" style="color:#7c3aed;"></i>
          </div>
          <div>
            <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase; letter-spacing:.05em;">Factures</div>
            <div class="fw-semibold" style="font-size:0.9rem;"><%= @factures_count %> facture<%= 's' if @factures_count != 1 %></div>
            <% factures_total = @project.architecte_factures_total.to_f + @project.contractor_factures_total.to_f %>
            <% if factures_total > 0 %>
              <small class="text-muted"><%= number_to_currency(factures_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %> facturé</small>
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       SECTION 1 — PRÉPARATION DE CHANTIER
  ════════════════════════════════════════════════════════════════════ -->
  <div class="row mb-4 mt-2">
    <div class="col-12">
      <div class="d-flex align-items-center gap-3 py-3 px-4 rounded-3" style="background: rgba(51,65,85,0.06); border-left: 4px solid var(--ren0vate-primary);">
        <span class="d-flex align-items-center justify-content-center rounded-circle text-white fw-bold flex-shrink-0" style="width:34px;height:34px;background:var(--ren0vate-primary);font-size:0.85rem;">1</span>
        <div>
          <h5 class="mb-0 fw-semibold" style="color:var(--ren0vate-primary); font-size:1rem;">
            <i class="bi bi-clipboard-check me-2"></i>Préparation de chantier
          </h5>
          <small style="color:var(--ren0vate-text-muted);">Informations, équipe &amp; éligibilité aux primes</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Infos générales | Suivi budgétaire | Éligibilité primes -->
  <div class="row g-3 mb-4">

    <!-- Infos générales -->
    <div class="col-lg-4">
      <div class="card border border-2 rounded-4 h-100">
        <div class="card-header bg-white border-0 py-3">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
                <i class="bi bi-info-circle text-white fs-6"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Informations générales</h5>
                <p class="text-muted mb-0" style="font-size:0.75rem;">Détails du chantier</p>
              </div>
            </div>
            <%= link_to edit_project_path(@project), class: "btn btn-sm btn-outline-primary rounded-3" do %>
              <i class="bi bi-pencil me-1"></i><span style="font-size:0.78rem;">Modifier</span>
            <% end %>
          </div>
        </div>
        <div class="card-body p-3">
          <% if @project.property.present? %>
            <div class="mb-3">
              <div class="text-muted small mb-1">Bien associé</div>
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-house-door text-primary"></i>
                <span class="fw-semibold"><%= @project.property.rue %> <%= @project.property.numero %>, <%= @project.property.commune %></span>
              </div>
            </div>
          <% end %>
          <% if @project.description.present? %>
            <div class="mb-3">
              <div class="text-muted small mb-1">Description</div>
              <p class="mb-0 small"><%= @project.description %></p>
            </div>
          <% end %>
          <div class="mb-3">
            <div class="text-muted small mb-1">Créé le</div>
            <span><%= @project.created_at.strftime("%d/%m/%Y") %></span>
          </div>
          <% if @project.date_début.present? || @project.date_fin.present? %>
            <div class="row gx-2 mb-3">
              <% if @project.date_début.present? %>
                <div class="col-6">
                  <div class="text-muted small mb-1">Début</div>
                  <span class="text-success fw-semibold"><%= @project.date_début.strftime("%d/%m/%Y") %></span>
                </div>
              <% end %>
              <% if @project.date_fin.present? %>
                <div class="col-6">
                  <div class="text-muted small mb-1">Fin prévue</div>
                  <span class="text-danger fw-semibold"><%= @project.date_fin.strftime("%d/%m/%Y") %></span>
                </div>
              <% end %>
            </div>
          <% end %>
          <% if @project.date_début && @project.date_fin %>
            <%
              total_d = (@project.date_fin - @project.date_début).to_i
              elapsed_d = [(Date.today - @project.date_début).to_i, 0].max
              pct_d = total_d > 0 ? [[elapsed_d.to_f / total_d * 100, 0].max, 100].min.round : 0
            %>
            <div class="text-muted small mb-1">Avancement temporel — <%= pct_d %>%</div>
            <div class="progress" style="height:6px;">
              <div class="progress-bar bg-success" style="width:<%= pct_d %>%;"></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Suivi budgétaire -->
    <div class="col-lg-4">
      <div class="card border border-2 rounded-4 h-100">
        <div class="card-header bg-white border-0 py-3">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
                <i class="bi bi-calculator text-white fs-6"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Suivi budgétaire</h5>
                <p class="text-muted mb-0" style="font-size:0.75rem;">Devis vs factures</p>
              </div>
            </div>
            <%= link_to edit_budget_project_path(@project), class: "btn btn-sm btn-outline-success rounded-3" do %>
              <i class="bi bi-pencil me-1"></i><span style="font-size:0.78rem;">Modifier</span>
            <% end %>
          </div>
        </div>
        <div class="card-body p-3">
          <% if @project.architecte_devis_montant.present? || @project.contractor_devis_montant.present? %>

            <% if @project.architecte_devis_montant.present? %>
              <div class="mb-3 pb-3 border-bottom">
                <div class="text-muted small mb-2"><i class="bi bi-building me-1"></i>Architecte</div>
                <div class="d-flex justify-content-between">
                  <div>
                    <div class="text-muted" style="font-size:0.72rem;">Devis</div>
                    <span class="fw-semibold text-primary"><%= @project.architecte_devis_montant_formatted %></span>
                  </div>
                  <div class="text-end">
                    <div class="text-muted" style="font-size:0.72rem;">Facturé</div>
                    <span class="fw-semibold"><%= number_to_currency(@project.architecte_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
                  </div>
                  <% if @project.architecte_devis_vs_factures_difference %>
                    <div class="text-end">
                      <div class="text-muted" style="font-size:0.72rem;">Écart</div>
                      <span class="fw-semibold <%= @project.architecte_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                        <%= @project.architecte_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.architecte_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @project.contractor_devis_montant.present? %>
              <div class="mb-3 pb-3 border-bottom">
                <div class="text-muted small mb-2"><i class="bi bi-hammer me-1"></i>Entrepreneur</div>
                <div class="d-flex justify-content-between">
                  <div>
                    <div class="text-muted" style="font-size:0.72rem;">Devis</div>
                    <span class="fw-semibold text-primary"><%= @project.contractor_devis_montant_formatted %></span>
                  </div>
                  <div class="text-end">
                    <div class="text-muted" style="font-size:0.72rem;">Facturé</div>
                    <span class="fw-semibold"><%= number_to_currency(@project.contractor_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
                  </div>
                  <% if @project.contractor_devis_vs_factures_difference %>
                    <div class="text-end">
                      <div class="text-muted" style="font-size:0.72rem;">Écart</div>
                      <span class="fw-semibold <%= @project.contractor_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                        <%= @project.contractor_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.contractor_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="d-flex justify-content-between align-items-center">
              <div>
                <div class="text-muted small">Total devis</div>
                <span class="fw-bold text-primary"><%= number_to_currency(@project.total_devis_montant, unit: "€", separator: ",", delimiter: " ") %></span>
              </div>
              <div class="text-end">
                <div class="text-muted small">Total facturé</div>
                <span class="fw-bold"><%= number_to_currency(@project.architecte_factures_total + @project.contractor_factures_total, unit: "€", separator: ",", delimiter: " ") %></span>
              </div>
              <div class="text-end">
                <div class="text-muted small">Écart</div>
                <span class="fw-bold <%= @project.total_devis_vs_factures_difference > 0 ? 'text-danger' : 'text-success' %>">
                  <%= @project.total_devis_vs_factures_difference > 0 ? '+' : '' %><%= number_to_currency(@project.total_devis_vs_factures_difference, unit: "€", separator: ",", delimiter: " ") %>
                </span>
              </div>
            </div>

          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-calculator text-muted mb-3 d-block" style="font-size:2rem;"></i>
              <div class="text-muted small">Aucun budget défini</div>
              <%= link_to edit_budget_project_path(@project), class: "btn btn-sm btn-outline-primary-custom mt-3" do %>
                <i class="bi bi-pencil me-1"></i>Renseigner le budget
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Éligibilité primes -->
    <div class="col-lg-4">
      <div class="card border border-2 rounded-4 h-100">
        <div class="card-header bg-white border-0 py-3">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
                <i class="bi bi-award text-white fs-6"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Éligibilité aux primes</h5>
                <p class="text-muted mb-0" style="font-size:0.75rem;">Simulations associées</p>
              </div>
            </div>
            <% if @project.property.present? %>
              <%= link_to new_simulation_path(property_id: @project.property_id, project_id: @project.id), class: "btn btn-sm btn-outline-warning rounded-3" do %>
                <i class="bi bi-plus me-1"></i><span style="font-size:0.78rem;">Nouvelle</span>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="card-body p-3">
          <% if @simulations.any? %>
            <% @simulations.each do |simulation| %>
              <div class="d-flex align-items-start gap-2 mb-3 pb-3 border-bottom last-child-no-border">
                <div class="flex-shrink-0 mt-1">
                  <% if simulation.eligible == true %>
                    <i class="bi bi-check-circle-fill text-success"></i>
                  <% elsif simulation.eligible == false %>
                    <i class="bi bi-x-circle-fill text-danger"></i>
                  <% else %>
                    <i class="bi bi-question-circle text-muted"></i>
                  <% end %>
                </div>
                <div class="flex-grow-1 overflow-hidden">
                  <div class="fw-semibold text-truncate" style="font-size:0.85rem;"><%= simulation.titre %></div>
                  <div class="text-muted" style="font-size:0.75rem;">
                    <%= simulation.region&.humanize %>
                    <% if simulation.total_simule.present? && simulation.total_simule > 0 %>
                      &nbsp;·&nbsp;<span class="text-success fw-semibold"><%= number_to_currency(simulation.total_simule, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span>
                    <% end %>
                  </div>
                </div>
                <%= link_to simulation_path(simulation), class: "btn btn-sm btn-outline-secondary flex-shrink-0", title: "Voir la simulation" do %>
                  <i class="bi bi-arrow-right"></i>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-5">
              <i class="bi bi-award text-muted d-block mb-3" style="font-size:2rem;"></i>
              <div class="text-muted small">Aucune simulation associée</div>
              <% if @project.property.present? %>
                <%= link_to new_simulation_path(property_id: @project.property_id, project_id: @project.id), class: "btn btn-sm btn-outline-warning mt-3" do %>
                  <i class="bi bi-plus me-1"></i>Créer une simulation
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <!-- Équipe projet & Invitations -->
  <div class="row g-3 mb-4">
    <div class="col-lg-7 d-flex flex-column gap-3">
      <%= render 'projects/partials_general/professionals_display' %>
    </div>
    <div class="col-lg-5 d-flex flex-column gap-3">
      <%= render 'projects/partials_general/invite_pros', project: @project %>
    </div>
  </div>

  <% if @project.property.present? %>
    <% property = @project.property %>
    <% peb = property.peb_donnees.order(created_at: :desc).first rescue nil %>

    <!-- PEB Recommandations + Devis -->
    <div class="row g-3 mb-5">

      <!-- Recommandations PEB -->
      <div class="col-lg-6">
        <div class="card border border-2 rounded-4 h-100">
          <div class="card-header bg-white border-0 py-3">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center">
                <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
                  <i class="bi bi-lightbulb text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Recommandations PEB</h5>
                  <p class="text-muted mb-0" style="font-size:0.75rem;">Certificat énergétique du bien</p>
                </div>
              </div>
              <%= link_to peb_recommandations_property_path(property), class: "btn btn-sm btn-outline-warning rounded-3" do %>
                <i class="bi bi-arrow-right me-1"></i><span style="font-size:0.78rem;">Voir tout</span>
              <% end %>
            </div>
          </div>
          <div class="card-body p-3">
            <% if peb.present? %>
              <% all_recs = peb.donnees_extraites['recommandations'] || [] rescue [] %>
              <% top_recs = all_recs.first.is_a?(Hash) \
                              ? all_recs.select { |r| r['has_recommandation'] }.first(4) \
                              : all_recs.first(4) %>
              <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                <i class="bi bi-house-gear text-primary"></i>
                <span class="fw-semibold small"><%= property.region&.capitalize %></span>
                <% couleur = { 'A++' => 'success', 'A+' => 'success', 'A' => 'success', 'B' => 'info', 'C' => 'primary', 'D' => 'warning', 'E' => 'warning', 'F' => 'danger', 'G' => 'danger' }[peb.label_peb] || 'secondary' %>
                <span class="badge bg-<%= couleur %> ms-auto">Classe <%= peb.label_peb || '?' %></span>
                <span class="text-muted small"><%= peb.score_ep_formate || '' %></span>
              </div>
              <% if top_recs.any? %>
                <% top_recs.each do |rec| %>
                  <% label = rec.is_a?(Hash) ? rec['recommandation'].to_s : rec.to_s %>
                  <div class="d-flex align-items-start py-1">
                    <i class="bi bi-<%= rec.is_a?(Hash) ? rec['icone'].to_s.delete_prefix('bi-') : 'check2' %> me-2 text-warning mt-1 flex-shrink-0"></i>
                    <small class="text-dark" style="line-height:1.4;"><%= truncate(label, length: 80) %></small>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center py-3 text-muted">
                  <i class="bi bi-info-circle d-block mb-1"></i>
                  <small>Aucune recommandation extraite</small>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-4 text-muted">
                <i class="bi bi-file-earmark-plus fs-3 d-block mb-2"></i>
                <p class="small mb-3">Aucun certificat PEB pour ce bien</p>
                <%= link_to peb_recommandations_property_path(property), class: "btn btn-sm btn-outline-warning" do %>
                  <i class="bi bi-lightbulb me-1"></i>Scanner un PEB
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Devis du bien -->
      <div class="col-lg-6">
        <div class="card border border-2 rounded-4 h-100">
          <div class="card-header bg-white border-0 py-3">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center">
                <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
                  <i class="bi bi-file-text text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Devis estimatifs</h5>
                  <p class="text-muted mb-0" style="font-size:0.75rem;">Devis générés pour ce bien</p>
                </div>
              </div>
              <%= link_to new_property_quote_path(property, project_id: @project.id), class: "btn btn-sm btn-outline-primary rounded-3" do %>
                <i class="bi bi-plus me-1"></i><span style="font-size:0.78rem;">Nouveau</span>
              <% end %>
            </div>
          </div>
          <div class="card-body p-3">
            <% quotes = property.quotes.order(created_at: :desc).limit(5) rescue [] %>
            <% if quotes.any? %>
              <% quotes.each do |quote| %>
                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                  <i class="bi bi-file-earmark-text text-primary flex-shrink-0"></i>
                  <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-semibold text-truncate" style="font-size:0.85rem;">Devis #<%= quote.id %></div>
                    <div class="text-muted" style="font-size:0.72rem;"><%= quote.created_at.strftime("%d/%m/%Y") %>
                      <% if quote.total_min.present? && quote.total_max.present? %>
                        &nbsp;·&nbsp;<span class="text-success fw-semibold">
                          <%= number_to_currency(quote.total_min, unit: '', separator: ',', delimiter: '.', precision: 0) %>&ndash;<%= number_to_currency(quote.total_max, unit: '€', separator: ',', delimiter: '.', precision: 0, format: "%n %u") %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                  <%= link_to property_quote_path(property, quote), class: "btn btn-sm btn-outline-secondary flex-shrink-0" do %>
                    <i class="bi bi-arrow-right"></i>
                  <% end %>
                </div>
              <% end %>
              <%= link_to property_quotes_path(property), class: "btn btn-sm btn-outline-primary-custom w-100 mt-1" do %>
                <i class="bi bi-list me-1"></i>Tous les devis
              <% end %>
            <% else %>
              <div class="text-center py-4 text-muted">
                <i class="bi bi-file-earmark-plus fs-3 d-block mb-2"></i>
                <p class="small mb-3">Aucun devis estimatif pour ce bien</p>
                <%= link_to new_property_quote_path(property, project_id: @project.id), class: "btn btn-sm btn-outline-primary" do %>
                  <i class="bi bi-plus-circle me-1"></i>Créer un devis estimatif
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

    </div>
  <% end %>

  <!-- Outils à venir -->
