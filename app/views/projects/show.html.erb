            <div class="text-muted small mb-2"><%= docs_of_type.count %> document(s)</div>
            <%= link_to new_project_document_path(@project, type_document: opt[:key]), class: "text-primary small fw-medium mb-2 d-block" do %>
              <i class="bi bi-plus me-1"></i>Ajouter
            <% end %>
            <% if docs_of_type.any? %>
              <%= link_to project_documents_path(@project, type_document: opt[:key]), class: "btn btn-sm btn-outline-secondary mb-2" do %>
                <i class="bi bi-folder2-open me-1"></i>Voir tous (<%= docs_of_type.count %>)
              <% end %>
            <% end %>
            <p class="text-muted mt-auto mb-0" style="font-size:0.72rem; font-style:italic;"><%= opt[:hint] %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════
       SECTION 3 — RÉCEPTION DE CHANTIER
  ════════════════════════════════════════════════════════════════════ -->
