<!-- Titre principal pour les professionnels -->
<div class="mb-4">
  <h5 class="text-primary-custom mb-3">
    <i class="bi bi-people me-2"></i>Équipe projet & Professionnels
  </h5>
  <p class="text-muted small">Renseignez les informations des différents intervenants de votre projet de rénovation.</p>
</div>

<!-- Section Architecte -->
<div class="card shadow-sm mb-4" style="border: 1px solid rgba(44, 82, 130, 0.2);">
  <div class="card-header bg-primary-light border-0">
    <h6 class="card-title text-primary-custom mb-0 fw-semibold">
      <i class="bi bi-building me-2"></i>Architecte
    </h6>
  </div>
  <div class="card-body">
    <!-- Première rangée : informations principales -->
    <div class="row g-2 mb-3">
      <div class="col">
        <%= form.label :architecte_prenom, "Prénom", class: "form-label" %>
        <%= form.text_field :architecte_prenom, class: "form-control", placeholder: "Ex: Jean" %>
      </div>
      <div class="col">
        <%= form.label :architecte_nom, "Nom", class: "form-label" %>
        <%= form.text_field :architecte_nom, class: "form-control", placeholder: "Ex: Dupont" %>
      </div>
      <div class="col">
        <%= form.label :architecte_entreprise, "Cabinet", class: "form-label" %>
        <%= form.text_field :architecte_entreprise, class: "form-control", placeholder: "Ex: Cabinet Dupont" %>
      </div>
      <div class="col">
        <%= form.label :architecte_telephone, "Téléphone", class: "form-label" %>
        <%= form.text_field :architecte_telephone, class: "form-control", placeholder: "Ex: +32 123 45 67 89", type: "tel" %>
      </div>
      <div class="col">
        <%= form.label :architecte_email, "Email", class: "form-label" %>
        <%= form.email_field :architecte_email, class: "form-control", placeholder: "Ex: jean.dupont@cabinet.be" %>
      </div>
    </div>

    <!-- Seconde rangée : montant du devis -->
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :architecte_devis_montant, "Montant du devis architecte", class: "form-label" %>
          <div class="input-group">
            <%= form.number_field :architecte_devis_montant,
                step: 0.01, min: 0,
                class: "form-control",
                placeholder: "Ex: 15000.00" %>
            <span class="input-group-text">€</span>
          </div>
          <small class="form-text text-muted">
            Montant HT du devis de l'architecte pour comparer avec les factures
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Section Entrepreneurs -->
<div class="card shadow-sm mb-4" style="border: 1px solid rgba(255, 193, 7, 0.3);"
     data-controller="entrepreneurs-management"
     data-entrepreneurs-management-container-target="container">
  <div class="card-header bg-warning-light border-0">
    <div class="d-flex justify-content-between align-items-center">
      <h6 class="card-title text-warning-emphasis mb-0 fw-semibold">
        <i class="bi bi-hammer me-2"></i>Entrepreneurs
      </h6>
      <button type="button"
              class="btn btn-sm btn-warning"
              data-entrepreneurs-management-target="addButton"
              data-action="click->entrepreneurs-management#addEntrepreneur">
        <i class="bi bi-plus-circle me-1"></i> Ajouter un entrepreneur
      </button>
    </div>
  </div>
  <div class="card-body">
    <div id="entrepreneurs-container">
      <!-- Entrepreneur Principal (converti en premier entrepreneur) -->
      <div class="entrepreneur-item border rounded p-3 mb-3" style="background-color: #f8f9fa;">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <h6 class="text-warning-emphasis mb-0 fw-semibold">
            <i class="bi bi-hammer me-2"></i>Entrepreneur Principal
          </h6>
        </div>

        <!-- Première rangée : informations principales -->
        <div class="row g-2 mb-3">
          <div class="col">
            <%= form.label :entrepreneur_principal_nom, "Nom", class: "form-label" %>
            <%= form.text_field :entrepreneur_principal_nom, class: "form-control", placeholder: "Ex: Pierre Martin" %>
          </div>
          <div class="col">
            <%= form.label :entrepreneur_principal_entreprise, "Entreprise", class: "form-label" %>
            <%= form.text_field :entrepreneur_principal_entreprise, class: "form-control", placeholder: "Ex: Entreprise Martin SPRL" %>
          </div>
          <div class="col">
            <%= form.label :entrepreneur_principal_numero_tva, "N° TVA", class: "form-label" %>
            <%= form.text_field :entrepreneur_principal_numero_tva, class: "form-control", placeholder: "Ex: BE0123456789" %>
          </div>
          <div class="col">
            <%= form.label :entrepreneur_principal_telephone, "Téléphone", class: "form-label" %>
            <%= form.text_field :entrepreneur_principal_telephone, class: "form-control", placeholder: "Ex: +32 123 45 67 89", type: "tel" %>
          </div>
          <div class="col">
            <%= form.label :entrepreneur_principal_email, "Email", class: "form-label" %>
            <%= form.email_field :entrepreneur_principal_email, class: "form-control", placeholder: "Ex: contact@entreprise-martin.be" %>
          </div>
        </div>

        <!-- Seconde rangée : montant du devis -->
        <div class="row">
          <div class="col-md-6">
            <div class="mb-3">
              <%= form.label :contractor_devis_montant, "Montant du devis entrepreneur", class: "form-label" %>
              <div class="input-group">
                <%= form.number_field :contractor_devis_montant,
                    step: 0.01, min: 0,
                    class: "form-control",
                    placeholder: "Ex: 45000.00" %>
                <span class="input-group-text">€</span>
              </div>
              <small class="form-text text-muted">
                Montant HT du devis de l'entrepreneur pour comparer avec les factures
              </small>
            </div>
          </div>
        </div>
      </div>

      <!-- Container pour les entrepreneurs additionnels -->
      <div id="additional-entrepreneurs-container" data-entrepreneurs-management-target="additionalContainer">
        <% if @project.additional_entrepreneurs.present? %>
          <% JSON.parse(@project.additional_entrepreneurs).each_with_index do |entrepreneur, index| %>
            <div class="entrepreneur-item border rounded p-3 mb-3" style="background-color: #f8f9fa;">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <h6 class="text-warning-emphasis mb-0 fw-semibold">
                  <i class="bi bi-hammer me-2"></i>Entrepreneur <%= index + 2 %>
                </h6>
                <button type="button" class="btn btn-sm btn-outline-danger remove-entrepreneur">
                  <i class="bi bi-trash"></i> Supprimer
                </button>
              </div>

              <!-- Première rangée : informations principales -->
              <div class="row g-2 mb-3">
                <div class="col">
                  <label class="form-label">Nom</label>
                  <input type="text" class="form-control" name="additional_entrepreneurs[][nom]" value="<%= entrepreneur['nom'] %>" placeholder="Ex: Pierre Martin">
                </div>
                <div class="col">
                  <label class="form-label">Entreprise</label>
                  <input type="text" class="form-control" name="additional_entrepreneurs[][entreprise]" value="<%= entrepreneur['entreprise'] %>" placeholder="Ex: Entreprise Martin SPRL">
                </div>
                <div class="col">
                  <label class="form-label">N° TVA</label>
                  <input type="text" class="form-control" name="additional_entrepreneurs[][numero_tva]" value="<%= entrepreneur['numero_tva'] %>" placeholder="Ex: BE0123456789">
                </div>
                <div class="col">
                  <label class="form-label">Téléphone</label>
                  <input type="tel" class="form-control" name="additional_entrepreneurs[][telephone]" value="<%= entrepreneur['telephone'] %>" placeholder="Ex: +32 123 45 67 89">
                </div>
                <div class="col">
                  <label class="form-label">Email</label>
                  <input type="email" class="form-control" name="additional_entrepreneurs[][email]" value="<%= entrepreneur['email'] %>" placeholder="Ex: contact@entreprise-martin.be">
                </div>
              </div>

              <!-- Seconde rangée : montant du devis -->
              <div class="row">
                <div class="col-md-6">
                  <div class="mb-3">
                    <label class="form-label">Montant du devis</label>
                    <div class="input-group">
                      <input type="number" step="0.01" min="0" class="form-control" name="additional_entrepreneurs[][devis_montant]" value="<%= entrepreneur['devis_montant'] %>" placeholder="Ex: 25000.00">
                      <span class="input-group-text">€</span>
                    </div>
                    <small class="form-text text-muted">
                      Montant HT du devis pour comparer avec les factures
                    </small>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
