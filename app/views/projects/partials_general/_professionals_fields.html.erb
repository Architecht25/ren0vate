<!-- Titre principal pour les professionnels -->
<div class="mb-4">
  <h5 class="text-primary-custom mb-3">
    <i class="bi bi-people me-2"></i>Équipe projet & Professionnels
  </h5>
  <p class="text-muted small">Renseignez les informations des différents intervenants de votre projet de rénovation.</p>
</div>

<!-- Section Architecte -->
<div class="card shadow-sm mb-4" style="border: 1px solid rgba(44, 82, 130, 0.2);">
  <div class="card-header bg-primary-light border-0">
    <h6 class="card-title text-primary-custom mb-0 fw-semibold">
      <i class="bi bi-building me-2"></i>Architecte
    </h6>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :architecte_prenom, "Prénom", class: "form-label" %>
          <%= form.text_field :architecte_prenom, class: "form-control", placeholder: "Ex: Jean" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :architecte_nom, "Nom", class: "form-label" %>
          <%= form.text_field :architecte_nom, class: "form-control", placeholder: "Ex: Dupont" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :architecte_entreprise, "Cabinet/Entreprise", class: "form-label" %>
          <%= form.text_field :architecte_entreprise, class: "form-control", placeholder: "Ex: Cabinet Dupont Architectes" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :architecte_numero_ordre, "N° Ordre des Architectes", class: "form-label" %>
          <%= form.text_field :architecte_numero_ordre, class: "form-control", placeholder: "Ex: A12345" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :architecte_telephone, "Téléphone", class: "form-label" %>
          <%= form.text_field :architecte_telephone, class: "form-control", placeholder: "Ex: +32 123 45 67 89", type: "tel" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :architecte_email, "Email", class: "form-label" %>
          <%= form.email_field :architecte_email, class: "form-control", placeholder: "Ex: jean.dupont@cabinet.be" %>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :architecte_adresse, "Adresse", class: "form-label" %>
      <%= form.text_area :architecte_adresse, rows: 2, class: "form-control", placeholder: "Ex: Rue de l'Architecture 123, 1000 Bruxelles" %>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :architecte_devis_montant, "Montant du devis architecte", class: "form-label" %>
          <div class="input-group">
            <%= form.number_field :architecte_devis_montant,
                step: 0.01, min: 0,
                class: "form-control",
                placeholder: "Ex: 15000.00" %>
            <span class="input-group-text">€</span>
          </div>
          <small class="form-text text-muted">
            Montant HT du devis de l'architecte pour comparer avec les factures
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Section Entrepreneur Principal -->
<div class="card shadow-sm mb-4" style="border: 1px solid rgba(255, 193, 7, 0.3);">
  <div class="card-header bg-warning-light border-0">
    <h6 class="card-title text-warning-emphasis mb-0 fw-semibold">
      <i class="bi bi-hammer me-2"></i>Entrepreneur Principal
    </h6>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :entrepreneur_principal_nom, "Nom du responsable", class: "form-label" %>
          <%= form.text_field :entrepreneur_principal_nom, class: "form-control", placeholder: "Ex: Pierre Martin" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :entrepreneur_principal_entreprise, "Entreprise", class: "form-label" %>
          <%= form.text_field :entrepreneur_principal_entreprise, class: "form-control", placeholder: "Ex: Entreprise Martin SPRL" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :entrepreneur_principal_numero_tva, "N° TVA", class: "form-label" %>
          <%= form.text_field :entrepreneur_principal_numero_tva, class: "form-control", placeholder: "Ex: BE0123456789" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :entrepreneur_principal_telephone, "Téléphone", class: "form-label" %>
          <%= form.text_field :entrepreneur_principal_telephone, class: "form-control", placeholder: "Ex: +32 123 45 67 89", type: "tel" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :entrepreneur_principal_email, "Email", class: "form-label" %>
          <%= form.email_field :entrepreneur_principal_email, class: "form-control", placeholder: "Ex: contact@entreprise-martin.be" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :entrepreneur_principal_assurance, "Assurance responsabilité", class: "form-label" %>
          <%= form.text_field :entrepreneur_principal_assurance, class: "form-control", placeholder: "Ex: AXA Police n° 123456" %>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :entrepreneur_principal_adresse, "Adresse", class: "form-label" %>
      <%= form.text_area :entrepreneur_principal_adresse, rows: 2, class: "form-control", placeholder: "Ex: Zone Industrielle 45, 5000 Namur" %>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :contractor_devis_montant, "Montant du devis entrepreneur", class: "form-label" %>
          <div class="input-group">
            <%= form.number_field :contractor_devis_montant,
                step: 0.01, min: 0,
                class: "form-control",
                placeholder: "Ex: 45000.00" %>
            <span class="input-group-text">€</span>
          </div>
          <small class="form-text text-muted">
            Montant HT du devis de l'entrepreneur pour comparer avec les factures
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Section Autres Professionnels -->
<div class="card shadow-sm mb-4" style="border: 1px solid rgba(13, 202, 240, 0.3);">
  <div class="card-header bg-info-light border-0">
    <h6 class="card-title text-info-emphasis mb-0 fw-semibold">
      <i class="bi bi-person-gear me-2"></i>Autres Professionnels
    </h6>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :maitre_ouvrage_nom, "Maître d'ouvrage", class: "form-label" %>
          <%= form.text_field :maitre_ouvrage_nom, class: "form-control", placeholder: "Ex: Sophie Leroy" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :maitre_ouvrage_contact, "Contact maître d'ouvrage", class: "form-label" %>
          <%= form.text_field :maitre_ouvrage_contact, class: "form-control", placeholder: "Ex: sophie.leroy@email.be" %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :coordinateur_securite_nom, "Coordinateur sécurité", class: "form-label" %>
          <%= form.text_field :coordinateur_securite_nom, class: "form-control", placeholder: "Ex: Bureau Sécurité Plus" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :coordinateur_securite_contact, "Contact coordinateur", class: "form-label" %>
          <%= form.text_field :coordinateur_securite_contact, class: "form-control", placeholder: "Ex: +32 123 45 67 89" %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Section Assurances & Garanties -->
<div class="card shadow-sm mb-4" style="border: 1px solid rgba(25, 135, 84, 0.3);">
  <div class="card-header bg-success-light border-0">
    <h6 class="card-title text-success-emphasis mb-0 fw-semibold">
      <i class="bi bi-shield-check me-2"></i>Assurances & Garanties
    </h6>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :assurance_decennale_architecte, "Assurance décennale architecte", class: "form-label" %>
          <%= form.text_field :assurance_decennale_architecte, class: "form-control", placeholder: "Ex: Ethias Police n° ABC123" %>
        </div>
      </div>
      <div class="col-md-6">
        <div class="mb-3">
          <%= form.label :assurance_decennale_entrepreneur, "Assurance décennale entrepreneur", class: "form-label" %>
          <%= form.text_field :assurance_decennale_entrepreneur, class: "form-control", placeholder: "Ex: AG Police n° DEF456" %>
        </div>
      </div>
    </div>

    <div class="mb-3">
      <%= form.label :garanties_travaux, "Autres garanties", class: "form-label" %>
      <%= form.text_area :garanties_travaux, rows: 3, class: "form-control", placeholder: "Décrivez les autres garanties applicables aux travaux..." %>
    </div>
  </div>
</div>
