<%# Plans architecturaux du chantier %>
<% plans_docs = @project.documents.where(type_document: 'plan').order(created_at: :desc) %>

<div class="card border-0 shadow-sm rounded-4 h-100">
  <div class="card-header border-0 py-3 px-4 d-flex align-items-center justify-content-between"
       style="background:linear-gradient(135deg,#134e4a,#0f766e); border-radius: 1rem 1rem 0 0 !important;">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-rulers text-white fs-5"></i>
      <div>
        <span class="fw-semibold text-white">Plans</span>
        <div class="text-white opacity-75" style="font-size:0.75rem;">Plans architecturaux du chantier</div>
      </div>
    </div>
    <%= link_to new_project_document_path(@project, type_document: 'plan'),
          class: "btn btn-sm text-white rounded-3",
          style: "background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);" do %>
      <i class="bi bi-plus me-1"></i><span style="font-size:0.78rem;">Ajouter</span>
    <% end %>
  </div>
  <div class="card-body p-3">
    <% if plans_docs.any? %>
      <% plans_docs.first(5).each do |doc| %>
        <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
          <i class="bi bi-file-earmark-ruled text-info flex-shrink-0"></i>
          <div class="flex-grow-1 overflow-hidden">
            <div class="fw-semibold text-truncate" style="font-size:0.85rem;"><%= doc.file_name || "Plan" %></div>
            <div class="text-muted" style="font-size:0.72rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
          </div>
        </div>
      <% end %>
      <%= link_to project_documents_path(@project, type_document: 'plan'), class: "btn btn-sm btn-outline-info w-100 mt-1" do %>
        <i class="bi bi-folder2-open me-1"></i>Voir tous (<%= plans_docs.count %>)
      <% end %>
    <% else %>
      <div class="text-center py-4 text-muted">
        <i class="bi bi-rulers fs-3 d-block mb-2"></i>
        <p class="small mb-3">Aucun plan architectural ajouté</p>
        <%= link_to new_project_document_path(@project, type_document: 'plan'), class: "btn btn-sm btn-outline-info" do %>
          <i class="bi bi-plus-circle me-1"></i>Ajouter un plan
        <% end %>
      </div>
    <% end %>
  </div>
</div>
