<%# Synthèse des devis — architecte, entrepreneur, châssis %>
<% chassis_total = @project.bordereau_chassis_donnees.where.not(montant_tvac: nil).sum(:montant_tvac).to_f %>
<div class="card border border-2 rounded-4 h-100">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
          <i class="bi bi-file-earmark-text text-white fs-6"></i>
        </div>
        <div>
          <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Synthèse des devis</h5>
          <p class="text-muted mb-0" style="font-size:0.75rem;">Architecte, entrepreneur &amp; châssis</p>
        </div>
      </div>
      <%= link_to edit_budget_project_path(@project, context: 'devis'), class: "btn btn-sm btn-outline-success rounded-3" do %>
        <i class="bi bi-pencil me-1"></i><span style="font-size:0.78rem;">Ajouter un devis</span>
      <% end %>
    </div>
  </div>
  <div class="card-body p-3">
    <% if @project.architecte_devis_montant.present? || @project.contractor_devis_montant.present? || chassis_total > 0 %>

      <% if @project.architecte_devis_montant.present? %>
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-building text-muted"></i>
            <span class="text-muted small">Architecte</span>
          </div>
          <span class="fw-semibold text-primary"><%= @project.architecte_devis_montant_formatted %></span>
        </div>
      <% end %>

      <% if @project.contractor_devis_montant.present? %>
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-hammer text-muted"></i>
            <span class="text-muted small">Entrepreneur</span>
          </div>
          <span class="fw-semibold text-primary"><%= @project.contractor_devis_montant_formatted %></span>
        </div>
      <% end %>

      <% if chassis_total > 0 %>
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-border-all text-muted"></i>
            <span class="text-muted small">Châssis</span>
          </div>
          <span class="fw-semibold text-primary"><%= number_to_currency(chassis_total, unit: "€", separator: ",", delimiter: " ") %></span>
        </div>
      <% end %>

      <div class="d-flex align-items-center justify-content-between pt-1">
        <span class="text-muted small fw-semibold">Total devis</span>
        <span class="fw-bold text-primary fs-6"><%= number_to_currency(@project.total_devis_montant + chassis_total, unit: "€", separator: ",", delimiter: " ") %></span>
      </div>

    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-file-earmark-text text-muted mb-3 d-block" style="font-size:2rem;"></i>
        <div class="text-muted small">Aucun devis renseigné</div>
        <%= link_to edit_budget_project_path(@project), class: "btn btn-sm btn-outline-primary-custom mt-3" do %>
          <i class="bi bi-pencil me-1"></i>Renseigner le budget
        <% end %>
      </div>
    <% end %>
  </div>
</div>
