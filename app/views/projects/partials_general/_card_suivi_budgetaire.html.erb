<%# Synthèse des devis — architecte, entrepreneur, châssis %>
<% chassis_total = @project.bordereau_chassis_donnees.where.not(montant_tvac: nil).sum(:montant_tvac).to_f %>
<div class="card border-0 shadow-sm rounded-4 h-100">
  <div class="card-header border-0 py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2"
       style="background:linear-gradient(135deg,#14532d,#166534); border-radius: 1rem 1rem 0 0 !important;">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-file-earmark-text text-white fs-5"></i>
      <div>
        <span class="fw-semibold text-white">Synthèse des devis</span>
        <div class="text-white opacity-75" style="font-size:0.75rem;">Votre budget total consolidé par intervenant</div>
      </div>
    </div>
    <%= link_to edit_budget_project_path(@project, context: 'devis'),
          class: "btn btn-sm text-white rounded-3",
          style: "background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);" do %>
      <i class="bi bi-pencil me-1"></i><span style="font-size:0.78rem;">Ajouter un devis</span>
    <% end %>
  </div>
  <div class="card-body p-3">
    <% architecte_effectif = @project.architecte_devis_montant_effectif
       contractor_effectif = @project.contractor_devis_montant_effectif %>
    <% if architecte_effectif.present? || contractor_effectif.present? || chassis_total > 0 %>

      <% if architecte_effectif.present? %>
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-building text-muted"></i>
            <span class="text-muted small">Architecte</span>
          </div>
          <span class="fw-semibold text-primary"><%= number_to_currency(architecte_effectif, unit: "€", separator: ",", delimiter: " ") %></span>
        </div>
      <% end %>

      <% if contractor_effectif.present? %>
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-hammer text-muted"></i>
            <span class="text-muted small">Entrepreneur</span>
          </div>
          <span class="fw-semibold text-primary"><%= number_to_currency(contractor_effectif, unit: "€", separator: ",", delimiter: " ") %></span>
        </div>
      <% end %>

      <% if chassis_total > 0 %>
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-border-all text-muted"></i>
            <span class="text-muted small">Châssis</span>
          </div>
          <span class="fw-semibold text-primary"><%= number_to_currency(chassis_total, unit: "€", separator: ",", delimiter: " ") %></span>
        </div>
      <% end %>

      <div class="d-flex align-items-center justify-content-between pt-1">
        <span class="text-muted small fw-semibold">Total devis</span>
        <span class="fw-bold text-primary fs-6"><%= number_to_currency(@project.total_devis_montant + chassis_total, unit: "€", separator: ",", delimiter: " ") %></span>
      </div>

    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-file-earmark-text text-muted mb-3 d-block" style="font-size:2rem;"></i>
        <div class="text-muted small">Aucun devis renseigné</div>
        <%= link_to edit_budget_project_path(@project), class: "btn btn-sm btn-outline-primary-custom mt-3" do %>
          <i class="bi bi-pencil me-1"></i>Renseigner le budget
        <% end %>
      </div>
    <% end %>
  </div>
</div>
