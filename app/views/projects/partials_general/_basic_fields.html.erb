<!-- Champs de base communs à toutes les régions -->
<div class="mb-3">
  <%= form.label :nom, class: "form-label" do %>
    <% if form.object.investment? %>
      Nom de l'investissement*
    <% else %>
      Nom du chantier*
    <% end %>
  <% end %>
  <%= form.text_field :nom, class: "form-control",
      placeholder: form.object.investment? ? "Ex: Acquisition et aménagement bureau" : "Ex: Rénovation complète appartement" %>
</div>

<div class="mb-3">
  <%= form.label :description, "Description", class: "form-label" %>
  <%= form.text_area :description, rows: 4, class: "form-control",
      placeholder: form.object.investment? ? "Décrivez l'investissement et les aménagements prévus..." : "Décrivez le chantier et les travaux à réaliser..." %>
  <% unless form.object.investment? %>
    <div class="form-text">
      <i class="bi bi-robot me-1"></i>Plus la description est détaillée (nature des travaux, matériaux, surfaces concernées…), plus l'analyse IA « Ai-je besoin d'un permis ? » (onglet Autorisations) sera précise.
    </div>
  <% end %>
</div>

<% unless form.object.investment? %>
  <div class="mb-3">
    <div class="form-label">Types de travaux</div>
    <div class="form-text mb-2">
      <i class="bi bi-info-circle me-1"></i>Détermine les rappels d'entretien proposés après réception (onglet Réception → Carnet d'entretien).
    </div>
    <div class="row row-cols-2 row-cols-md-3 g-2">
      <% [['isolation', '🧱 Isolation'], ['chauffage', '🔥 Chauffage'], ['ventilation', '💨 Ventilation'],
          ['fenetres', '🪟 Fenêtres'], ['toiture', '🏠 Toiture'], ['autre', '🔧 Autre']].each do |key, label| %>
        <div class="col">
          <div class="form-check">
            <%= form.check_box "type_travaux_#{key}", class: "form-check-input" %>
            <%= form.label "type_travaux_#{key}", label, class: "form-check-label" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="row">
  <div class="col-md-4">
    <div class="mb-3">
      <%= form.label :date_début, "Date de début prévue", class: "form-label" %>
      <%= form.date_field :date_début, class: "form-control" %>
    </div>
  </div>
  <div class="col-md-4">
    <div class="mb-3">
      <%= form.label :date_fin, "Date de fin prévue", class: "form-label" %>
      <%= form.date_field :date_fin, class: "form-control" %>
    </div>
  </div>
  <div class="col-md-4">
    <div class="mb-3">
      <%= form.label :statut, "Statut du chantier", class: "form-label" %>
  <%= form.select :statut,
      options_for_select([
        ['En préparation', 'preparation'],
        ['En cours', 'en_cours'],
        ['En pause', 'pause'],
        ['Terminé', 'termine'],
        ['Annulé', 'annule']
      ], form.object.statut || 'preparation'),
      { include_blank: false },
      { class: "form-select" } %>
    </div>
</div>
</div>
