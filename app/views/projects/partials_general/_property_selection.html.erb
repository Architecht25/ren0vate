<!-- Sélection de propriété obligatoire -->
<div class="mb-3">
  <%= form.label :property_id, "Bien immobilier associé*", class: "form-label" %>
  <% if defined?(Property) && current_user.properties.any? %>
    <%= form.collection_select :property_id, current_user.properties, :id, :full_address,
        { include_blank: "-- Sélectionner un bien --" },
        { class: "form-select", id: "project_property_id",
          "data-region-target" => "propertySelect" } %>
    <div class="form-text">
      <% if form.object.investment? %>
        Sélectionnez le bien immobilier pour lequel vous réalisez cet investissement.
      <% else %>
        Sélectionnez le bien immobilier pour lequel vous créez ce chantier de rénovation.
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-warning">
      <i class="bi bi-exclamation-triangle me-2"></i>
      <strong>Aucun bien immobilier trouvé</strong>
      <p class="mb-2">
        <% if form.object.investment? %>
          Vous devez d'abord ajouter un bien immobilier avant de créer un investissement.
        <% else %>
          Vous devez d'abord ajouter un bien immobilier avant de créer un chantier.
        <% end %>
      </p>
      <%= link_to "Ajouter un bien immobilier", new_property_path, class: "btn btn-primary btn-sm" %>
    </div>
    <%= form.hidden_field :property_id, value: "" %>
  <% end %>
</div>
