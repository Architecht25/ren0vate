<%# Éligibilité aux primes — simulations associées %>
<div class="card border-0 shadow-sm rounded-4 h-100">
  <div class="card-header border-0 py-3 px-4 d-flex align-items-center justify-content-between"
       style="background:linear-gradient(135deg,#78350f,#92400e); border-radius: 1rem 1rem 0 0 !important;">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-award text-white fs-5"></i>
      <div>
        <span class="fw-semibold text-white">Éligibilité aux primes</span>
        <div class="text-white opacity-75" style="font-size:0.75rem;">Calculez les aides financières disponibles pour vos travaux</div>
      </div>
    </div>
    <% if @project.property.present? %>
      <%= link_to new_simulation_path(property_id: @project.property_id, project_id: @project.id),
            class: "btn btn-sm text-white rounded-3",
            style: "background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);" do %>
        <i class="bi bi-plus me-1"></i><span style="font-size:0.78rem;">Nouvelle</span>
      <% end %>
    <% end %>
  </div>
  <div class="card-body p-3">
    <% if @simulations.any? %>
      <% @simulations.each do |simulation| %>
        <div class="d-flex align-items-start gap-2 mb-3 pb-3 border-bottom last-child-no-border">
          <div class="flex-shrink-0 mt-1">
            <% if simulation.eligible == true %>
              <i class="bi bi-check-circle-fill text-success"></i>
            <% elsif simulation.eligible == false %>
              <i class="bi bi-x-circle-fill text-danger"></i>
            <% else %>
              <i class="bi bi-question-circle text-muted"></i>
            <% end %>
          </div>
          <div class="flex-grow-1 overflow-hidden">
            <div class="fw-semibold text-truncate" style="font-size:0.85rem;"><%= simulation.titre %></div>
            <div class="text-muted" style="font-size:0.75rem;">
              <%= simulation.region&.humanize %>
              <% if simulation.total_simule.present? && simulation.total_simule > 0 %>
                &nbsp;·&nbsp;<span class="text-success fw-semibold"><%= number_to_currency(simulation.total_simule, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span>
              <% end %>
            </div>
          </div>
          <%= link_to simulation_path(simulation), class: "btn btn-sm btn-outline-secondary flex-shrink-0", title: "Voir la simulation" do %>
            <i class="bi bi-arrow-right"></i>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-5">
        <i class="bi bi-award text-muted d-block mb-3" style="font-size:2rem;"></i>
        <div class="text-muted small">Aucune simulation associée</div>
        <% if @project.property.present? %>
          <%= link_to new_simulation_path(property_id: @project.property_id, project_id: @project.id), class: "btn btn-sm btn-outline-warning mt-3" do %>
            <i class="bi bi-plus me-1"></i>Créer une simulation
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
