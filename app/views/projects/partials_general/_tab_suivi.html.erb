<%# Tab 2 — Suivi de chantier %>

<!-- Sous-onglets -->
<ul class="nav nav-pills mb-4 gap-1 p-1 rounded-3 flex-nowrap overflow-x-auto tabs-scroll-x" style="background: rgba(0,0,0,0.04);" id="suiviTabs" role="tablist">
  <li class="nav-item flex-shrink-0" role="presentation">
    <button class="nav-link active text-nowrap" id="suivi-avancement-tab"
            data-bs-toggle="tab" data-bs-target="#suivi-avancement"
            type="button" role="tab" aria-selected="true">
      <i class="bi bi-graph-up-arrow me-1"></i>Avancement & Planning
    </button>
  </li>
  <li class="nav-item flex-shrink-0" role="presentation">
    <button class="nav-link text-nowrap" id="suivi-validations-tab"
            data-bs-toggle="tab" data-bs-target="#suivi-validations"
            type="button" role="tab" aria-selected="false">
      <i class="bi bi-check2-square me-1"></i>Validations & Paiements
    </button>
  </li>
  <li class="nav-item flex-shrink-0" role="presentation">
    <button class="nav-link text-nowrap" id="suivi-terrain-tab"
            data-bs-toggle="tab" data-bs-target="#suivi-terrain"
            type="button" role="tab" aria-selected="false">
      <i class="bi bi-camera me-1"></i>Suivi terrain
    </button>
  </li>
</ul>

<div class="tab-content" id="suiviTabsContent">

  <!-- ── Sous-onglet 1 : Avancement & Planning ── -->
  <div class="tab-pane fade show active" id="suivi-avancement" role="tabpanel" aria-labelledby="suivi-avancement-tab">
    <%# Regroupement par thème (ajusté avec Robin le 12/10/2026) : suivi
        global (score + avancement déclaré) sur une rangée, planification
        (Gantt automatique + planning détaillé manuel V2) sur l'autre —
        plutôt que Planning détaillé seul sur une rangée à 2/3 vide. %>
    <div class="row g-3 mb-4">
      <div class="col-12 col-lg-6">
        <%= render 'projects/partials_general/card_score_sante' %>
      </div>
      <div class="col-12 col-lg-6">
        <%= render 'projects/partials_general/card_phases_chantier' %>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-12 col-lg-6">
        <%= render 'projects/partials_general/card_planning_gantt' %>
      </div>
      <div class="col-12 col-lg-6">
        <%# V2 — Lot 4 : planning par lot avec dépendances. Complémentaire au
            Gantt ci-contre (calculé automatiquement depuis le devis retenu)
            — celui-ci est une saisie manuelle de tâches, utile quand le
            Gantt automatique ne suffit pas (tâches hors devis, dépendances
            précises). %>
        <%= render "shared/v2_feature_card",
              title: "Planning détaillé", icon: "bi-list-task",
              subtitle: "Tâches manuelles avec dépendances",
              description: "Ajoutez des tâches par lot avec dates et dépendances simples — complémentaire au Gantt automatique ci-contre.",
              path: project_schedule_items_path(@project) %>
      </div>
    </div>
  </div>

  <!-- ── Sous-onglet 2 : Validations & Paiements ── -->
  <div class="tab-pane fade" id="suivi-validations" role="tabpanel" aria-labelledby="suivi-validations-tab">
    <div class="row g-3 mb-4">
      <div class="col-lg-3">
        <%= render 'projects/partials_general/card_factures' %>
      </div>
      <div class="col-lg-3">
        <%= render 'projects/partials_general/card_etat_avancement' %>
      </div>
      <div class="col-lg-3">
        <%= render 'projects/partials_general/card_bordereaux_avancement' %>
      </div>
      <div class="col-lg-3">
        <%= render 'projects/partials_general/card_accords_phase' %>
      </div>
    </div>
  </div>

  <!-- ── Sous-onglet 3 : Suivi terrain ── -->
  <div class="tab-pane fade" id="suivi-terrain" role="tabpanel" aria-labelledby="suivi-terrain-tab">
    <%# Regroupement par thème (ajusté avec Robin le 12/10/2026, même logique
        que l'onglet Avancement & Planning) : documentation visuelle terrain
        sur une rangée, observations + communication (V2) sur l'autre —
        plutôt que Messagerie V2 seule sur une rangée à 2/3 vide. %>
    <div class="row g-3 mb-4">
      <div class="col-12 col-lg-6">
        <%= render 'projects/partials_general/card_pv_visites' %>
      </div>
      <div class="col-12 col-lg-6">
        <%= render 'projects/partials_general/photos_suivi' %>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <%# V2 — Lot 4 : Journal de chantier remplace le carnet de bord V1
          (project_notes) — strict sur-ensemble (auteur identifié, lot,
          photos multiples, géolocalisation), voir mémoire
          "project_v2_navigation_ia_decision" pour la comparaison détaillée
          actée avec Robin le 12/10/2026. %>
      <div class="col-12 col-lg-6">
        <%= render "shared/v2_feature_card",
              title: "Journal de chantier", icon: "bi-journal-text",
              subtitle: "Observations datées, photos, lot",
              description: "Consignez une observation avec photos et géolocalisation, rattachée à un lot — remplace le carnet de bord.",
              path: project_site_log_entries_path(@project) %>
      </div>
      <div class="col-12 col-lg-6">
        <%= render "shared/v2_feature_card",
              title: "Messagerie", icon: "bi-chat-dots",
              subtitle: "Fils de discussion par lot",
              description: "Échangez avec les intervenants, par chantier ou par lot — accès filtré selon le périmètre de chacun.",
              path: project_message_threads_path(@project) %>
      </div>
    </div>
  </div>

</div>

<!-- CTA transition → Réception -->
<div class="row mt-2 mb-2">
  <div class="col-12">
    <div class="d-flex align-items-center justify-content-between gap-3 p-4 rounded-3 flex-wrap"
         style="background: rgba(var(--ren0vate-accent-rgb), 0.06); border: 1px solid rgba(var(--ren0vate-accent-rgb), 0.3);">
      <div>
        <p class="mb-1 fw-semibold" style="color: var(--ren0vate-text-secondary);">
          <i class="bi bi-flag-fill me-2" style="color: var(--ren0vate-accent);"></i>Travaux terminés ?
        </p>
        <small style="color: var(--ren0vate-text-muted);">
          Le chantier est achevé ? Passez à la réception pour documenter la fin des travaux,
          gérer les réserves et archiver vos garanties.
        </small>
      </div>
      <%= link_to project_path(@project, tab: :reception), class: "btn btn-warning fw-semibold flex-shrink-0" do %>
        <i class="bi bi-flag-fill me-2"></i>Passer à la réception
      <% end %>
    </div>
  </div>
</div>
