<%# Tab 2 — Suivi de chantier %>

<!-- Banner -->
<div class="row mb-4 mt-2">
  <div class="col-12">
    <div class="d-flex align-items-center gap-3 py-3 px-4 rounded-3" style="background: rgba(217,119,6,0.07); border-left: 4px solid var(--ren0vate-accent);">
      <span class="d-flex align-items-center justify-content-center rounded-circle text-white fw-bold flex-shrink-0" style="width:34px;height:34px;background:var(--ren0vate-accent);font-size:0.85rem;">2</span>
      <div>
        <h5 class="mb-0 fw-semibold" style="color:var(--ren0vate-accent-dark); font-size:1rem;">
          <i class="bi bi-hammer me-2"></i>Suivi de chantier
        </h5>
        <small style="color:var(--ren0vate-text-muted);">Chantier en cours : suivez l'avancement des phases, les factures et les PV de visite.</small>
      </div>
    </div>
  </div>
</div>

<!-- Score Santé Projet (synthèse transversale, remontée en tête) + PV de visite -->
<div class="row g-3 mb-4">
  <div class="col-lg-6">
    <%= render 'projects/partials_general/card_score_sante' %>
  </div>
  <div class="col-lg-6">
    <%= render 'projects/partials_general/card_pv_visites' %>
  </div>
</div>

<!-- Ligne 1 : Factures | Photos | Avancement chantier -->
<div class="row g-3 mb-4">
  <div class="col-lg-4">
    <%= render 'projects/partials_general/card_factures' %>
  </div>
  <div class="col-lg-4">
    <%= render 'projects/partials_general/photos_suivi' %>
  </div>
  <div class="col-lg-4">
    <%= render 'projects/partials_general/card_phases_chantier' %>
  </div>
</div>

<!-- Ligne 2 : Accords de phase | État d'avancement | Bordereau d'avancement -->
<div class="row g-3 mb-4">
  <div class="col-lg-4">
    <%= render 'projects/partials_general/card_accords_phase' %>
  </div>
  <div class="col-lg-4">
    <%= render 'projects/partials_general/card_etat_avancement' %>
  </div>
  <div class="col-lg-4">
    <%= render 'projects/partials_general/card_bordereaux_avancement' %>
  </div>
</div>

<!-- Ligne 3 : Planning de chantier | Carnet de bord -->
<div class="row g-3 mb-4">
  <div class="col-lg-6">
    <%= render 'projects/partials_general/card_planning_gantt' %>
  </div>
  <div class="col-lg-6">
    <%= render 'projects/partials_general/carnet_de_bord', project: @project, tab: 'suivi' %>
  </div>
</div>

<!-- CTA transition → Réception -->
<div class="row mt-2 mb-2">
  <div class="col-12">
    <div class="d-flex align-items-center justify-content-between gap-3 p-4 rounded-3 flex-wrap"
         style="background: rgba(var(--ren0vate-accent-rgb), 0.06); border: 1px solid rgba(var(--ren0vate-accent-rgb), 0.3);">
      <div>
        <p class="mb-1 fw-semibold" style="color: var(--ren0vate-text-secondary);">
          <i class="bi bi-flag-fill me-2" style="color: var(--ren0vate-accent);"></i>Travaux terminés ?
        </p>
        <small style="color: var(--ren0vate-text-muted);">
          Le chantier est achevé ? Passez à la réception pour documenter la fin des travaux,
          gérer les réserves et archiver vos garanties.
        </small>
      </div>
      <%= link_to project_path(@project, tab: :reception), class: "btn btn-warning fw-semibold flex-shrink-0" do %>
        <i class="bi bi-flag-fill me-2"></i>Passer à la réception
      <% end %>
    </div>
  </div>
</div>
