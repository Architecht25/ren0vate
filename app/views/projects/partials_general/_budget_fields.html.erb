<!-- Champs de suivi budgétaire -->
<div class="mb-4">
  <div class="mb-3">
    <%= form.label :architecte_devis_montant, "Devis architecte", class: "form-label" %>
    <div class="input-group">
      <%= form.number_field :architecte_devis_montant,
          step: 0.01, min: 0,
          class: "form-control",
          placeholder: "Ex: 15000.00" %>
      <span class="input-group-text">€</span>
    </div>
    <small class="form-text text-muted">Montant HTVA — pré-rempli automatiquement si scan confiance ≥ 75 %</small>
  </div>

  <div class="mb-3">
    <%= form.label :contractor_devis_montant, "Devis entrepreneur", class: "form-label" %>
    <div class="input-group">
      <%= form.number_field :contractor_devis_montant,
          step: 0.01, min: 0,
          class: "form-control",
          placeholder: "Ex: 45000.00" %>
      <span class="input-group-text">€</span>
    </div>
    <small class="form-text text-muted">Montant HTVA — pré-rempli automatiquement si scan confiance ≥ 75 %</small>
  </div>
</div>
