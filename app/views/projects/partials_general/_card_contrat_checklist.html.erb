<% if @contrat_checklist.present? %>
  <% items = @contrat_checklist.project_checklist_items.sort_by { |i| i.checklist_item.position } %>
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex flex-column flex-sm-row align-items-sm-center justify-content-sm-between gap-2">
      <h5 class="mb-0 text-primary-custom fw-normal">
        <i class="bi bi-file-earmark-text me-2"></i>Vérification du contrat d'entrepreneur
      </h5>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-secondary"><%= items.count(&:checked) %> / <%= items.count %></span>
        <div class="progress" style="height:6px;width:80px;">
          <div class="progress-bar bg-<%= @contrat_checklist.progress_pct == 100 ? 'success' : 'info' %>"
               style="width:<%= @contrat_checklist.progress_pct %>%"></div>
        </div>
      </div>
    </div>
    <div class="card-body p-3">
      <p class="text-muted small mb-3">
        Les 10 points à vérifier avant de signer un contrat avec un entrepreneur, à cocher au fur et à mesure.
        Les points juridiques (assurance, délai de rétractation) sont à confirmer avec l'entrepreneur ou un professionnel — ceci n'est pas un conseil juridique.
      </p>
      <div class="row g-0">
        <% items.each_slice((items.size / 2.0).ceil).to_a.each do |column_items| %>
          <div class="col-12 col-md-6">
            <div class="list-group list-group-flush">
              <% column_items.each do |item| %>
                <div class="list-group-item px-2 py-2 border-0 <%= 'bg-success-subtle' if item.checked %>">
                  <div class="d-flex align-items-start gap-2">
                    <%= form_with url: project_checklist_item_path(item), method: :patch,
                                  data: { turbo: false } do %>
                      <% if item.checked %>
                        <input type="hidden" name="checked" value="false">
                        <button type="submit" class="btn btn-success btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:26px;height:26px;" title="Décocher">
                          <i class="bi bi-check2 text-white" style="font-size:12px;"></i>
                        </button>
                      <% else %>
                        <input type="hidden" name="checked" value="true">
                        <button type="submit" class="btn btn-outline-secondary btn-sm rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0"
                                style="width:26px;height:26px;" title="Cocher">
                          <i class="bi bi-circle" style="font-size:12px;"></i>
                        </button>
                      <% end %>
                    <% end %>
                    <span class="small <%= 'text-decoration-line-through text-muted' if item.checked %>">
                      <%= item.checklist_item.description %>
                      <% if item.checklist_item.required %>
                        <span class="badge bg-info-subtle text-info border border-info ms-1" style="font-size:0.55rem;">Clé</span>
                      <% end %>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
