<%# Permis d'urbanisme & Plans — documents légaux et architecturaux %>
<% permis_docs = @project.documents.where(type_document: 'permis_urbanisme').order(created_at: :desc) %>
<% plans_docs  = @project.documents.where(type_document: 'plan').order(created_at: :desc) %>

<%
  statut_config = {
    'non_requis' => { label: 'Non requis',       color: 'secondary', icon: 'bi-slash-circle'      },
    'en_cours'   => { label: 'En cours',          color: 'warning',   icon: 'bi-hourglass-split'   },
    'obtenu'     => { label: 'Obtenu',            color: 'success',   icon: 'bi-check-circle-fill' },
    'refuse'     => { label: 'Refusé',            color: 'danger',    icon: 'bi-x-circle-fill'     },
    'a_deposer'  => { label: 'À déposer',         color: 'info',      icon: 'bi-send'              }
  }
  current_statut = statut_config[@project.permis_urbanisme_statut] || { label: 'Non renseigné', color: 'light text-muted', icon: 'bi-question-circle' }
%>

<div class="card border border-2 rounded-4 h-100">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="bg-secondary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
          <i class="bi bi-building-gear text-white fs-6"></i>
        </div>
        <div>
          <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Permis &amp; Plans</h5>
          <p class="text-muted mb-0" style="font-size:0.75rem;">Documents légaux et architecturaux</p>
        </div>
      </div>
      <button class="btn btn-sm btn-outline-secondary rounded-3" type="button"
              data-bs-toggle="collapse" data-bs-target="#permis-edit-form-<%= @project.id %>"
              aria-expanded="false">
        <i class="bi bi-pencil me-1"></i><span style="font-size:0.78rem;">Infos permis</span>
      </button>
    </div>
  </div>

  <div class="card-body p-3">

    <%# —— Formulaire inline permis (collapse) —— %>
    <div class="collapse mb-3" id="permis-edit-form-<%= @project.id %>">
      <%= form_with url: project_path(@project), method: :patch, local: false,
                    data: { turbo: true, turbo_frame: '_top', controller: 'auto-submit' } do |f| %>
        <div class="p-3 rounded-3 border bg-light mb-0">
          <p class="fw-semibold mb-2" style="font-size:0.85rem;"><i class="bi bi-pencil-square me-1 text-secondary"></i>Informations sur le permis</p>

          <%# Statut %>
          <div class="mb-2">
            <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Statut du permis</label>
            <select name="project[permis_urbanisme_statut]" class="form-select form-select-sm rounded-3">
              <option value="">— Non renseigné —</option>
              <option value="non_requis"  <%= 'selected' if @project.permis_urbanisme_statut == 'non_requis'  %>>Non requis</option>
              <option value="a_deposer"  <%= 'selected' if @project.permis_urbanisme_statut == 'a_deposer'  %>>À déposer</option>
              <option value="en_cours"   <%= 'selected' if @project.permis_urbanisme_statut == 'en_cours'   %>>En cours d'instruction</option>
              <option value="obtenu"     <%= 'selected' if @project.permis_urbanisme_statut == 'obtenu'     %>>Obtenu</option>
              <option value="refuse"     <%= 'selected' if @project.permis_urbanisme_statut == 'refuse'     %>>Refusé</option>
            </select>
          </div>

          <%# Numéro %>
          <div class="mb-2">
            <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Numéro de permis</label>
            <input type="text" name="project[permis_urbanisme_number]"
                   value="<%= @project.permis_urbanisme_number %>"
                   class="form-control form-control-sm rounded-3"
                   placeholder="ex : URB/2025/00123">
          </div>

          <%# Date de délivrance %>
          <div class="mb-2">
            <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Date de délivrance</label>
            <input type="date" name="project[permis_urbanisme_date]"
                   value="<%= @project.permis_urbanisme_date&.strftime('%Y-%m-%d') %>"
                   class="form-control form-control-sm rounded-3">
          </div>

          <%# Autorité délivrante %>
          <div class="mb-2">
            <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Autorité délivrante</label>
            <input type="text" name="project[permis_urbanisme_autorite]"
                   value="<%= @project.permis_urbanisme_autorite %>"
                   class="form-control form-control-sm rounded-3"
                   placeholder="ex : Administration communale de Liège">
          </div>

          <%# Notes %>
          <div class="mb-3">
            <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Notes / conditions</label>
            <textarea name="project[permis_urbanisme_notes]"
                      class="form-control form-control-sm rounded-3" rows="2"
                      placeholder="Conditions particulières, recours, remarques…"><%= @project.permis_urbanisme_notes %></textarea>
          </div>

          <button type="submit" class="btn btn-sm btn-primary rounded-3 w-100">
            <i class="bi bi-check2 me-1"></i>Enregistrer
          </button>
        </div>
      <% end %>
    </div>

    <%# —— Récapitulatif statut permis —— %>
    <div class="d-flex align-items-center gap-2 mb-3 p-2 rounded-3" style="background:rgba(0,0,0,0.03);">
      <i class="bi <%= current_statut[:icon] %> text-<%= current_statut[:color].split.first %>" style="font-size:1.1rem;"></i>
      <div class="flex-grow-1">
        <div class="fw-semibold" style="font-size:0.82rem;">
          Permis d'urbanisme :
          <span class="badge bg-<%= current_statut[:color].split.first %>-subtle text-<%= current_statut[:color].split.first %> ms-1"><%= current_statut[:label] %></span>
        </div>
        <% if @project.permis_urbanisme_number.present? || @project.permis_urbanisme_date.present? %>
          <div class="text-muted" style="font-size:0.72rem;">
            <% if @project.permis_urbanisme_number.present? %>
              N° <strong><%= @project.permis_urbanisme_number %></strong>
            <% end %>
            <% if @project.permis_urbanisme_date.present? %>
              &nbsp;·&nbsp;délivré le <%= @project.permis_urbanisme_date.strftime("%d/%m/%Y") %>
            <% end %>
          </div>
        <% end %>
        <% if @project.permis_urbanisme_autorite.present? %>
          <div class="text-muted" style="font-size:0.72rem;"><%= @project.permis_urbanisme_autorite %></div>
        <% end %>
        <% if @project.permis_urbanisme_notes.present? %>
          <div class="text-muted fst-italic mt-1" style="font-size:0.72rem;"><%= truncate(@project.permis_urbanisme_notes, length: 80) %></div>
        <% end %>
      </div>
    </div>

    <%# —— Section documents permis —— %>
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="d-flex align-items-center gap-2">
        <% if permis_docs.any? %>
          <span class="badge rounded-circle p-1 bg-success d-flex align-items-center justify-content-center" style="width:18px;height:18px;">
            <i class="bi bi-check2" style="font-size:0.6rem;"></i>
          </span>
        <% else %>
          <span class="badge rounded-circle p-1 bg-warning d-flex align-items-center justify-content-center" style="width:18px;height:18px;">
            <i class="bi bi-exclamation" style="font-size:0.6rem;"></i>
          </span>
        <% end %>
        <span class="fw-semibold" style="font-size:0.85rem;">Document(s) permis</span>
        <% if permis_docs.any? %>
          <span class="badge bg-success-subtle text-success rounded-3" style="font-size:0.68rem;"><%= permis_docs.count %> doc<%= permis_docs.count > 1 ? 's' : '' %></span>
        <% end %>
      </div>
      <%= link_to new_project_document_path(@project, type_document: 'permis_urbanisme'), class: "btn btn-sm btn-outline-secondary rounded-3 py-0 px-2" do %>
        <i class="bi bi-plus me-1"></i><span style="font-size:0.75rem;">Ajouter</span>
      <% end %>
    </div>

    <% if permis_docs.any? %>
      <% permis_docs.first(3).each do |doc| %>
        <div class="d-flex align-items-center gap-2 mb-1 pb-1 border-bottom ms-1">
          <i class="bi bi-file-earmark-text text-secondary flex-shrink-0" style="font-size:0.8rem;"></i>
          <div class="flex-grow-1 overflow-hidden">
            <div class="text-truncate" style="font-size:0.82rem;"><%= doc.nom || (doc.fichier.filename rescue "Permis") %></div>
            <div class="text-muted" style="font-size:0.7rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
          </div>
        </div>
      <% end %>
      <% if permis_docs.count > 3 %>
        <%= link_to project_documents_path(@project, type_document: 'permis_urbanisme'), class: "btn btn-sm btn-link text-secondary p-0 ms-1 mb-1", style: "font-size:0.78rem;" do %>
          <i class="bi bi-folder2-open me-1"></i>Voir tous (<%= permis_docs.count %>)
        <% end %>
      <% end %>
    <% else %>
      <div class="ms-1 mb-2">
        <p class="text-muted mb-1" style="font-size:0.78rem;">Aucun fichier enregistré — ajoutez le document officiel.</p>
      </div>
    <% end %>

    <hr class="my-3">

    <%# —— Section Plans du bien —— %>
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="d-flex align-items-center gap-2">
        <% if plans_docs.any? %>
          <span class="badge rounded-circle p-1 bg-success d-flex align-items-center justify-content-center" style="width:18px;height:18px;">
            <i class="bi bi-check2" style="font-size:0.6rem;"></i>
          </span>
        <% else %>
          <span class="badge rounded-circle p-1 bg-warning d-flex align-items-center justify-content-center" style="width:18px;height:18px;">
            <i class="bi bi-exclamation" style="font-size:0.6rem;"></i>
          </span>
        <% end %>
        <span class="fw-semibold" style="font-size:0.85rem;">Plans du bien</span>
        <% if plans_docs.any? %>
          <span class="badge bg-info-subtle text-info rounded-3" style="font-size:0.68rem;"><%= plans_docs.count %> plan<%= plans_docs.count > 1 ? 's' : '' %></span>
        <% end %>
      </div>
      <%= link_to new_project_document_path(@project, type_document: 'plan'), class: "btn btn-sm btn-outline-info rounded-3 py-0 px-2" do %>
        <i class="bi bi-plus me-1"></i><span style="font-size:0.75rem;">Ajouter</span>
      <% end %>
    </div>

    <% if plans_docs.any? %>
      <% plans_docs.first(3).each do |doc| %>
        <div class="d-flex align-items-center gap-2 mb-1 pb-1 border-bottom ms-1">
          <i class="bi bi-file-earmark-ruled text-info flex-shrink-0" style="font-size:0.8rem;"></i>
          <div class="flex-grow-1 overflow-hidden">
            <div class="text-truncate" style="font-size:0.82rem;"><%= doc.nom || (doc.fichier.filename rescue "Plan") %></div>
            <div class="text-muted" style="font-size:0.7rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
          </div>
        </div>
      <% end %>
      <% if plans_docs.count > 3 %>
        <%= link_to project_documents_path(@project, type_document: 'plan'), class: "btn btn-sm btn-link text-info p-0 ms-1", style: "font-size:0.78rem;" do %>
          <i class="bi bi-folder2-open me-1"></i>Voir tous (<%= plans_docs.count %>)
        <% end %>
      <% end %>
    <% else %>
      <div class="ms-1">
        <p class="text-muted mb-1" style="font-size:0.78rem;">Aucun plan enregistré — ajoutez les plans architecturaux du bien.</p>
      </div>
    <% end %>

  </div>
</div>
