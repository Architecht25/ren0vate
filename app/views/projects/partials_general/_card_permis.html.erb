<%# Permis d'urbanisme — autorisation légale travaux %>
<% permis_docs = @project.documents.where(type_document: 'permis_urbanisme').order(created_at: :desc) %>

<div class="card border border-2 rounded-4 h-100">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="bg-secondary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
          <i class="bi bi-building-gear text-white fs-6"></i>
        </div>
        <div>
          <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Permis d'urbanisme</h5>
          <p class="text-muted mb-0" style="font-size:0.75rem;">Autorisation légale travaux</p>
        </div>
      </div>
      <%= link_to new_project_document_path(@project, type_document: 'permis_urbanisme'), class: "btn btn-sm btn-outline-secondary rounded-3" do %>
        <i class="bi bi-plus me-1"></i><span style="font-size:0.78rem;">Ajouter</span>
      <% end %>
    </div>
  </div>
  <div class="card-body p-3">
    <% if permis_docs.any? %>
      <% permis_docs.first(5).each do |doc| %>
        <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
          <i class="bi bi-file-earmark-text text-secondary flex-shrink-0"></i>
          <div class="flex-grow-1 overflow-hidden">
            <div class="fw-semibold text-truncate" style="font-size:0.85rem;"><%= doc.nom || doc.fichier.filename rescue "Permis" %></div>
            <div class="text-muted" style="font-size:0.72rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
          </div>
        </div>
      <% end %>
      <%= link_to project_documents_path(@project, type_document: 'permis_urbanisme'), class: "btn btn-sm btn-outline-secondary w-100 mt-1" do %>
        <i class="bi bi-folder2-open me-1"></i>Voir tous (<%= permis_docs.count %>)
      <% end %>
    <% else %>
      <div class="text-center py-4 text-muted">
        <i class="bi bi-building-gear fs-3 d-block mb-2"></i>
        <p class="small mb-3">Aucun permis d'urbanisme ajouté</p>
        <%= link_to new_project_document_path(@project, type_document: 'permis_urbanisme'), class: "btn btn-sm btn-outline-secondary" do %>
          <i class="bi bi-plus-circle me-1"></i>Ajouter un permis
        <% end %>
      </div>
    <% end %>
  </div>
</div>
