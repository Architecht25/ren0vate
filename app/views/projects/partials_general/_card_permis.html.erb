<%# Permis d'urbanisme — Informations & Statut %>
<%
  statut_config = {
    'non_requis' => { label: 'Non requis',       color: 'secondary', icon: 'bi-slash-circle'      },
    'en_cours'   => { label: 'En cours',          color: 'warning',   icon: 'bi-hourglass-split'   },
    'obtenu'     => { label: 'Obtenu',            color: 'success',   icon: 'bi-check-circle-fill' },
    'refuse'     => { label: 'Refusé',            color: 'danger',    icon: 'bi-x-circle-fill'     },
    'a_deposer'  => { label: 'À déposer',         color: 'info',      icon: 'bi-send'              }
  }
  current_statut = statut_config[@project.permis_urbanisme_statut] || { label: 'Non renseigné', color: 'light text-muted', icon: 'bi-question-circle' }
  historique     = (@project.permis_urbanisme_historique || []).sort_by { |h| h['changed_at'] || '' }
  statut_date    = historique.group_by { |h| h['statut'] }.transform_values { |arr| arr.last['changed_at'] }
  current        = @project.permis_urbanisme_statut.to_s
  stepper_steps  = [
    { key: 'a_deposer', label: 'À déposer',  icon: 'bi-send',              color: 'info'    },
    { key: 'en_cours',  label: 'En cours',   icon: 'bi-hourglass-split',   color: 'warning' },
    { key: 'obtenu',    label: 'Obtenu',      icon: 'bi-check-circle-fill', color: 'success' },
  ]
  current_idx = stepper_steps.index { |s| s[:key] == current }
%>

<div class="card border border-2 rounded-4 h-100">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex align-items-center gap-3">
      <div class="bg-secondary bg-gradient rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px;height:40px;">
        <i class="bi bi-building-gear text-white fs-6"></i>
      </div>
      <div>
        <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Informations du permis</h5>
        <p class="text-muted mb-0" style="font-size:0.75rem;">Statut, numéro et autorité délivrante</p>
      </div>
    </div>
  </div>

  <div class="card-body p-3">

    <%# ── Stepper visuel ── %>
    <% if current == 'non_requis' %>
      <div class="d-flex align-items-center gap-2 mb-3 px-2 py-2 rounded-3"
           style="background:rgba(108,117,125,0.08);">
        <i class="bi bi-slash-circle text-secondary"></i>
        <span class="text-muted fw-semibold" style="font-size:0.82rem;">Permis non requis pour ce chantier</span>
      </div>
    <% elsif current == 'refuse' %>
      <div class="d-flex align-items-center gap-2 mb-3 px-2 py-2 rounded-3"
           style="background:rgba(220,53,69,0.07);">
        <i class="bi bi-x-circle-fill text-danger"></i>
        <div>
          <span class="text-danger fw-semibold" style="font-size:0.82rem;">Permis refusé</span>
          <% if statut_date['refuse'].present? %>
            <div class="text-muted" style="font-size:0.7rem;">
              le <%= Time.zone.parse(statut_date['refuse']).strftime('%d/%m/%Y') rescue statut_date['refuse'] %>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="mb-3">
        <div class="d-flex align-items-center" style="gap:0;">
          <% stepper_steps.each_with_index do |step, idx| %>
            <%
              is_done    = current_idx && idx < current_idx
              is_current = current_idx && idx == current_idx
              step_date  = statut_date[step[:key]]
            %>
            <div class="d-flex flex-column align-items-center flex-shrink-0" style="min-width:60px;">
              <div class="rounded-circle d-flex align-items-center justify-content-center
                          <%= is_done ? "bg-#{step[:color]}" : is_current ? "bg-#{step[:color]}" : 'bg-light border' %>"
                   style="width:32px;height:32px;">
                <% if is_done %>
                  <i class="bi bi-check2 text-white" style="font-size:0.85rem;"></i>
                <% elsif is_current %>
                  <i class="bi <%= step[:icon] %> text-white" style="font-size:0.75rem;"></i>
                <% else %>
                  <i class="bi <%= step[:icon] %> text-secondary" style="font-size:0.75rem;"></i>
                <% end %>
              </div>
              <div class="text-center mt-1" style="font-size:0.62rem; line-height:1.2;
                           color:<%= is_current ? "var(--bs-#{step[:color]})" : is_done ? '#6c757d' : '#adb5bd' %>;
                           font-weight:<%= is_current ? '600' : '400' %>;">
                <%= step[:label] %>
                <% if step_date.present? %>
                  <div style="font-size:0.58rem; color:#adb5bd;">
                    <%= Time.zone.parse(step_date).strftime('%d/%m') rescue '' %>
                  </div>
                <% end %>
              </div>
            </div>
            <% if idx < stepper_steps.size - 1 %>
              <div class="flex-grow-1" style="height:2px; margin-bottom:22px;
                           background:<%= is_done ? "var(--bs-#{step[:color]})" : '#dee2e6' %>;"></div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── Formulaire infos permis (toujours visible) ── %>
    <%= form_with url: project_path(@project), method: :patch, local: false,
                  data: { turbo: true, turbo_frame: '_top' } do |f| %>
      <div class="p-3 rounded-3 border bg-light mb-3">

        <div class="mb-2">
          <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Statut du permis</label>
          <select name="project[permis_urbanisme_statut]" class="form-select form-select-sm rounded-3">
            <option value="">— Non renseigné —</option>
            <option value="non_requis" <%= 'selected' if @project.permis_urbanisme_statut == 'non_requis' %>>Non requis</option>
            <option value="a_deposer"  <%= 'selected' if @project.permis_urbanisme_statut == 'a_deposer'  %>>À déposer</option>
            <option value="en_cours"   <%= 'selected' if @project.permis_urbanisme_statut == 'en_cours'   %>>En cours d'instruction</option>
            <option value="obtenu"     <%= 'selected' if @project.permis_urbanisme_statut == 'obtenu'     %>>Obtenu</option>
            <option value="refuse"     <%= 'selected' if @project.permis_urbanisme_statut == 'refuse'     %>>Refusé</option>
          </select>
        </div>

        <div class="mb-2">
          <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Numéro de permis</label>
          <input type="text" name="project[permis_urbanisme_number]"
                 value="<%= @project.permis_urbanisme_number %>"
                 class="form-control form-control-sm rounded-3"
                 placeholder="ex : URB/2025/00123">
        </div>

        <div class="mb-2">
          <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Date de délivrance</label>
          <input type="date" name="project[permis_urbanisme_date]"
                 value="<%= @project.permis_urbanisme_date&.strftime('%Y-%m-%d') %>"
                 class="form-control form-control-sm rounded-3">
        </div>

        <div class="mb-2">
          <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Autorité délivrante</label>
          <input type="text" name="project[permis_urbanisme_autorite]"
                 value="<%= @project.permis_urbanisme_autorite %>"
                 class="form-control form-control-sm rounded-3"
                 placeholder="ex : Administration communale de Liège">
        </div>

        <div class="mb-3">
          <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Notes / conditions</label>
          <textarea name="project[permis_urbanisme_notes]"
                    class="form-control form-control-sm rounded-3" rows="3"
                    placeholder="Conditions particulières, recours, remarques…"><%= @project.permis_urbanisme_notes %></textarea>
        </div>

        <button type="submit" class="btn btn-sm btn-primary rounded-3 w-100">
          <i class="bi bi-check2 me-1"></i>Enregistrer
        </button>
      </div>
    <% end %>

    <%# ── Historique des changements de statut ── %>
    <% if historique.size > 1 %>
      <details>
        <summary class="text-muted" style="font-size:0.72rem; cursor:pointer;">
          <i class="bi bi-clock-history me-1"></i>Historique (<%= historique.size %> entrées)
        </summary>
        <div class="mt-2 ps-2 border-start border-2 border-secondary-subtle">
          <% historique.reverse.first(5).each do |h| %>
            <% sc = statut_config[h['statut']] || { label: h['statut'], color: 'secondary', icon: 'bi-circle' } %>
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="bi <%= sc[:icon] %> text-<%= sc[:color].split.first %>" style="font-size:0.7rem;"></i>
              <span class="badge bg-<%= sc[:color].split.first %>-subtle text-<%= sc[:color].split.first %>"
                    style="font-size:0.6rem;"><%= sc[:label] %></span>
              <span class="text-muted" style="font-size:0.68rem;">
                <%= Time.zone.parse(h['changed_at']).strftime('%d/%m/%Y à %H:%M') rescue h['changed_at'] %>
              </span>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

  </div>
</div>
