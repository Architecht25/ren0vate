<% photo_types = {
  'photo_avant'    => { label: 'Avant travaux',  icon: 'bi-clock-history', color: 'secondary' },
  'photo_pendant'  => { label: 'Pendant travaux', icon: 'bi-hammer',       color: 'warning'   },
  'photo_apres'    => { label: 'Après travaux',   icon: 'bi-check-circle', color: 'success'   },
  'photo_chassis'  => { label: 'Châssis',         icon: 'bi-window',       color: 'info'      }
} %>

<div class="form-section bg-white border border-2 rounded-3 p-3 h-100" id="photos-suivi-section" style="border-color: #dee2e6 !important;">

  <%# ── En-tête ── %>
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
      <div class="icon-circle" style="width:28px;height:28px;font-size:14px;">
        <i class="bi bi-camera"></i>
      </div>
      <h6 class="mb-0 fw-normal text-primary-custom">
        Photos de suivi
        <span class="badge bg-secondary ms-1"><%= @photos.size %></span>
      </h6>
    </div>
    <%= link_to new_project_document_path(@project, type_document: 'photo_pendant'),
          class: "btn btn-sm btn-outline-primary rounded-3" do %>
      <i class="bi bi-plus-lg me-1"></i><span style="font-size:0.78rem;">Ajouter</span>
    <% end %>
  </div>

  <% if @photos.empty? %>

    <%# ── État vide compact ── %>
    <div class="d-flex flex-column align-items-center justify-content-center py-4 h-100" style="min-height:160px;">
      <i class="bi bi-camera text-muted d-block mb-2" style="font-size:1.8rem;"></i>
      <p class="text-muted small mb-3">Documentez l'avancement de votre chantier avec des photos.</p>
      <div class="d-flex gap-1 justify-content-center flex-wrap">
        <% photo_types.each do |type, meta| %>
          <%= link_to new_project_document_path(@project, type_document: type),
                class: "btn btn-sm btn-outline-#{meta[:color]}", style: "font-size:0.75rem;padding:3px 8px;" do %>
            <i class="bi <%= meta[:icon] %> me-1"></i><%= meta[:label] %>
          <% end %>
        <% end %>
      </div>
    </div>

  <% else %>

    <%# ── Grille thumbnails (4 colonnes, 8 max) ── %>
    <div class="row g-1 mb-2">
      <% @photos.first(8).each do |doc| %>
        <div class="col-3">
          <div class="rounded overflow-hidden position-relative" style="aspect-ratio:1;background:#eee;">
            <% if doc.file_url.present? %>
              <a href="<%= doc.file_url %>" target="_blank" rel="noopener noreferrer">
                <img src="<%= doc.file_url %>"
                     class="w-100 h-100" style="object-fit:cover;"
                     alt="<%= photo_types[doc.type_document]&.dig(:label) || 'Photo' %>">
              </a>
            <% else %>
              <div class="w-100 h-100 d-flex align-items-center justify-content-center bg-light">
                <i class="bi bi-image text-muted"></i>
              </div>
            <% end %>
            <% meta = photo_types[doc.type_document] %>
            <% if meta %>
              <span class="position-absolute bottom-0 start-0 m-1 badge bg-<%= meta[:color] %>"
                    style="font-size:0.6rem;opacity:0.9;">
                <%= meta[:label].split(' ').first %>
              </span>
            <% end %>
            <%# ── Bouton suppression ── %>
            <%= button_to document_path(doc),
                  method: :delete,
                  data: { turbo_confirm: "Supprimer cette photo ?" },
                  form: { style: "position:absolute;top:2px;right:2px;" },
                  class: "btn btn-danger btn-sm p-0 d-flex align-items-center justify-content-center",
                  style: "width:20px;height:20px;font-size:0.65rem;opacity:0.85;border-radius:50%;" do %>
              <i class="bi bi-x"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# ── Lien voir tout ── %>
    <%= link_to project_documents_path(@project, type_document: %w[photo_avant photo_pendant photo_apres photo_chassis]),
          class: "btn btn-sm btn-outline-secondary w-100", style: "font-size:0.8rem;" do %>
      <i class="bi bi-images me-1"></i>
      <% if @photos.size > 8 %>
        Voir les <%= @photos.size %> photos
      <% else %>
        Voir toutes les photos du chantier
      <% end %>
    <% end %>

  <% end %>

  <%# ── Séparateur + Analyse IA ── %>
  <hr class="my-3">
  <%= render 'projects/partials_general/vision_analysis' %>

</div>
