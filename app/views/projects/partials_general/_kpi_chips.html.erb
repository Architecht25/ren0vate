<%# KPI chips — synthèse globale du chantier, sous forme de badges compacts %>
<%
  statut_badge = case @project.statut
                 when 'preparation' then ['secondary', 'En préparation']
                 when 'en_cours' then ['primary', 'En cours']
                 when 'pause' then ['warning text-dark', 'En pause']
                 when 'termine' then ['success', 'Terminé']
                 when 'annule' then ['danger', 'Annulé']
                 else ['light text-dark', @project.statut&.humanize || '—']
                 end

  devis_total = @project.total_devis_montant.to_f
  facture_total = @project.total_facture.to_f
  factures_total = @project.architecte_factures_total.to_f + @project.contractor_factures_total.to_f
%>

<div class="d-flex flex-wrap gap-2 mt-3 mb-3">
  <span class="badge text-bg-<%= statut_badge[0] %>">
    <i class="bi bi-activity me-1"></i><%= statut_badge[1] %>
  </span>

  <span class="badge text-bg-light">
    <i class="bi bi-calendar-range me-1"></i>
    <% if @project.date_début && @project.date_fin %>
      <%= @project.date_début.strftime("%d/%m/%y") %> → <%= @project.date_fin.strftime("%d/%m/%y") %>
    <% elsif @project.date_début %>
      Début <%= @project.date_début.strftime("%d/%m/%y") %>
    <% else %>
      Période non définie
    <% end %>
  </span>

  <span class="badge text-bg-light">
    <i class="bi bi-currency-euro me-1"></i>
    <% if devis_total > 0 %>
      <%= number_to_currency(facture_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
      / <%= number_to_currency(devis_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
      (<%= [(facture_total / devis_total * 100).round, 100].min %>% facturé)
    <% else %>
      Budget non renseigné
    <% end %>
  </span>

  <span class="badge text-bg-light">
    <i class="bi bi-receipt me-1"></i>
    <%= @factures_count %> facture<%= 's' if @factures_count != 1 %>
    <% if factures_total > 0 %>
      · <%= number_to_currency(factures_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
    <% end %>
  </span>
</div>
