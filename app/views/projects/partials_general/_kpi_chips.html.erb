<%# KPI chips — synthèse globale du chantier %>
<div class="row g-3 mb-5">

  <!-- Statut -->
  <div class="col-6 col-md-3">
    <div class="card border-0 rounded-4 h-100" style="border-left: 4px solid var(--ren0vate-accent) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.07);">
      <div class="card-body p-3 d-flex align-items-center gap-2">
        <div class="rounded-3 p-2 flex-shrink-0" style="background: rgba(var(--ren0vate-accent-rgb), 0.12);">
          <i class="bi bi-activity fs-5" style="color: var(--ren0vate-accent);"></i>
        </div>
        <div style="min-width:0;overflow:hidden;">
          <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase;">Statut</div>
          <% if @project.statut == 'preparation' %>
            <span class="badge bg-secondary">En préparation</span>
          <% elsif @project.statut == 'en_cours' %>
            <span class="badge bg-primary">En cours</span>
          <% elsif @project.statut == 'pause' %>
            <span class="badge bg-warning text-dark">En pause</span>
          <% elsif @project.statut == 'termine' %>
            <span class="badge bg-success">Terminé</span>
          <% elsif @project.statut == 'annule' %>
            <span class="badge bg-danger">Annulé</span>
          <% else %>
            <span class="badge bg-light text-dark"><%= @project.statut&.humanize || '—' %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Période -->
  <div class="col-6 col-md-3">
    <div class="card border-0 rounded-4 h-100" style="border-left: 4px solid var(--ren0vate-success) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.07);">
      <div class="card-body p-3 d-flex align-items-center gap-2">
        <div class="rounded-3 p-2 flex-shrink-0" style="background: rgba(var(--ren0vate-success-rgb), 0.12);">
          <i class="bi bi-calendar-range fs-5" style="color: var(--ren0vate-success-dark);"></i>
        </div>
        <div style="min-width:0;overflow:hidden;">
          <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase;">Période</div>
          <div class="fw-semibold" style="font-size:0.82rem; line-height:1.3;">
            <% if @project.date_début && @project.date_fin %>
              <%= @project.date_début.strftime("%d/%m/%y") %> →<br><%= @project.date_fin.strftime("%d/%m/%y") %>
            <% elsif @project.date_début %>
              Début<br><%= @project.date_début.strftime("%d/%m/%y") %>
            <% else %>
              <span class="text-muted">Non défini</span>
            <% end %>
          </div>
          <% if @project.date_début && @project.date_fin %>
            <% duration_days = (@project.date_fin - @project.date_début).to_i %>
            <% if duration_days > 0 %>
              <small class="text-muted"><%= duration_days %> jours</small>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Budget -->
  <div class="col-6 col-md-3">
    <div class="card border-0 rounded-4 h-100" style="border-left: 4px solid var(--ren0vate-primary) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.07);">
      <div class="card-body p-3 d-flex align-items-center gap-2">
        <div class="rounded-3 p-2 flex-shrink-0" style="background: rgba(var(--ren0vate-primary-rgb), 0.1);">
          <i class="bi bi-currency-euro fs-5" style="color: var(--ren0vate-primary);"></i>
        </div>
        <div style="min-width:0; overflow:hidden; width:100%;">
          <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase;">Budget</div>
          <% devis_total = @project.total_devis_montant.to_f %>
          <% facture_total = @project.total_facture.to_f %>
          <% if devis_total > 0 %>
            <div class="fw-semibold" style="font-size:0.82rem; line-height:1.3;">
              <%= number_to_currency(facture_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
              <span class="text-muted fw-normal">/ <%= number_to_currency(devis_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %></span>
            </div>
            <% budget_pct = [(facture_total / devis_total * 100).round, 100].min %>
            <% bar_color = budget_pct >= 95 ? '#dc3545' : (budget_pct >= 80 ? '#ffc107' : '#198754') %>
            <div style="height:4px; background:#e9ecef; border-radius:4px; margin-top:4px; overflow:hidden;">
              <div style="height:100%; width:<%= budget_pct %>%; background:<%= bar_color %>; border-radius:4px;"></div>
            </div>
            <small class="text-muted"><%= budget_pct %>% facturé</small>
          <% else %>
            <div class="fw-semibold" style="font-size:0.82rem;">
              <span class="text-muted">Non renseigné</span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Factures -->
  <div class="col-6 col-md-3">
    <div class="card border-0 rounded-4 h-100" style="border-left: 4px solid var(--ren0vate-accent-dark) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.07);">
      <div class="card-body p-3 d-flex align-items-center gap-2">
        <div class="rounded-3 p-2 flex-shrink-0" style="background: rgba(var(--ren0vate-accent-rgb), 0.08);">
          <i class="bi bi-receipt fs-5" style="color: var(--ren0vate-accent-dark);"></i>
        </div>
        <div style="min-width:0;overflow:hidden;">
          <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase;">Factures</div>
          <div class="fw-semibold" style="font-size:0.82rem;"><%= @factures_count %> facture<%= 's' if @factures_count != 1 %></div>
          <% factures_total = @project.architecte_factures_total.to_f + @project.contractor_factures_total.to_f %>
          <% if factures_total > 0 %>
            <small class="text-muted"><%= number_to_currency(factures_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %> facturé</small>
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>
