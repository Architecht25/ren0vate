<%# KPI chips — synthèse globale du chantier %>
<div class="row g-3 mb-5">

  <!-- Statut -->
  <div class="col-6 col-md-3">
    <div class="card border border-2 rounded-4 h-100">
      <div class="card-body p-3 d-flex align-items-center gap-2">
        <div class="rounded-3 p-2 flex-shrink-0" style="background:#e8f4f8;">
          <i class="bi bi-activity fs-5 text-primary"></i>
        </div>
        <div style="min-width:0;overflow:hidden;">
          <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase;">Statut</div>
          <% if @project.statut == 'preparation' %>
            <span class="badge bg-secondary">En préparation</span>
          <% elsif @project.statut == 'en_cours' %>
            <span class="badge bg-primary">En cours</span>
          <% elsif @project.statut == 'pause' %>
            <span class="badge bg-warning text-dark">En pause</span>
          <% elsif @project.statut == 'termine' %>
            <span class="badge bg-success">Terminé</span>
          <% elsif @project.statut == 'annule' %>
            <span class="badge bg-danger">Annulé</span>
          <% else %>
            <span class="badge bg-light text-dark"><%= @project.statut&.humanize || '—' %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Période -->
  <div class="col-6 col-md-3">
    <div class="card border border-2 rounded-4 h-100">
      <div class="card-body p-3 d-flex align-items-center gap-2">
        <div class="rounded-3 p-2 flex-shrink-0" style="background:#f0fdf4;">
          <i class="bi bi-calendar-range fs-5 text-success"></i>
        </div>
        <div style="min-width:0;overflow:hidden;">
          <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase;">Période</div>
          <div class="fw-semibold" style="font-size:0.82rem; line-height:1.3;">
            <% if @project.date_début && @project.date_fin %>
              <%= @project.date_début.strftime("%d/%m/%y") %> →<br><%= @project.date_fin.strftime("%d/%m/%y") %>
            <% elsif @project.date_début %>
              Début<br><%= @project.date_début.strftime("%d/%m/%y") %>
            <% else %>
              <span class="text-muted">Non défini</span>
            <% end %>
          </div>
          <% if @project.date_début && @project.date_fin %>
            <small class="text-muted"><%= (@project.date_fin - @project.date_début).to_i %> jours</small>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Budget -->
  <div class="col-6 col-md-3">
    <div class="card border border-2 rounded-4 h-100">
      <div class="card-body p-3 d-flex align-items-center gap-2">
        <div class="rounded-3 p-2 flex-shrink-0" style="background:#fff7ed;">
          <i class="bi bi-currency-euro fs-5 text-warning"></i>
        </div>
        <div style="min-width:0;overflow:hidden;">
          <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase;">Budget total</div>
          <% total = @project.total_devis_montant.to_f %>
          <div class="fw-semibold" style="font-size:0.82rem;">
            <% if total > 0 %>
              <%= number_to_currency(total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
            <% else %>
              <span class="text-muted">Non renseigné</span>
            <% end %>
          </div>
          <% if @planning_items_count > 0 %>
            <small class="text-muted"><%= @planning_items_count %> poste<%= 's' if @planning_items_count != 1 %> au devis</small>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Factures -->
  <div class="col-6 col-md-3">
    <div class="card border border-2 rounded-4 h-100">
      <div class="card-body p-3 d-flex align-items-center gap-2">
        <div class="rounded-3 p-2 flex-shrink-0" style="background:#fdf4ff;">
          <i class="bi bi-receipt fs-5" style="color:#7c3aed;"></i>
        </div>
        <div style="min-width:0;overflow:hidden;">
          <div class="text-muted" style="font-size:0.72rem; text-transform:uppercase;">Factures</div>
          <div class="fw-semibold" style="font-size:0.82rem;"><%= @factures_count %> facture<%= 's' if @factures_count != 1 %></div>
          <% factures_total = @project.architecte_factures_total.to_f + @project.contractor_factures_total.to_f %>
          <% if factures_total > 0 %>
            <small class="text-muted"><%= number_to_currency(factures_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %> facturé</small>
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>
