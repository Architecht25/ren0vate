<!-- Section Équipe & Professionnels -->
<div class="form-section bg-white border border-2 rounded-3 p-3" style="max-width: 100%; overflow: hidden; box-sizing: border-box; border-color: #dee2e6 !important;">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-people"></i>
      </div>
      <h5 class="mb-0 fw-normal text-primary-custom">Équipe projet & Professionnels</h5>
    </div>

    <div class="d-flex gap-2">
      <%# ── Trouver architecte ── %>
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-primary rounded-3 dropdown-toggle"
                type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-search me-1"></i><span style="font-size:0.78rem;">Trouver architecte</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="min-width:230px;">
          <li>
            <h6 class="dropdown-header text-muted" style="font-size:0.7rem;">ANNUAIRES OFFICIELS</h6>
          </li>
          <li>
            <%= link_to "https://procheck.ordredesarchitectes.be/",
                        target: "_blank", rel: "noopener noreferrer",
                        class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size:0.65rem;width:22px;text-align:center;">OA</span>
              <div>
                <div style="font-size:0.8rem;" class="fw-medium">Ordre des Architectes</div>
                <div class="text-muted" style="font-size:0.68rem;">Annuaire officiel belge — architectes agréés</div>
              </div>
            <% end %>
          </li>
          <li><hr class="dropdown-divider my-1"></li>
          <li>
            <h6 class="dropdown-header text-muted" style="font-size:0.7rem;">PLATEFORMES</h6>
          </li>
          <li>
            <%= link_to "https://www.homify.be/professionnels/architectes",
                        target: "_blank", rel: "noopener noreferrer",
                        class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
              <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.65rem;width:22px;text-align:center;">Hf</span>
              <div>
                <div style="font-size:0.8rem;" class="fw-medium">Homify.be</div>
                <div class="text-muted" style="font-size:0.68rem;">Portfolios + avis clients · Belgique</div>
              </div>
            <% end %>
          </li>
          <li>
            <%= link_to "https://www.trustup.be/architecte",
                        target: "_blank", rel: "noopener noreferrer",
                        class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
              <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size:0.65rem;width:22px;text-align:center;">TU</span>
              <div>
                <div style="font-size:0.8rem;" class="fw-medium">Trustup.be</div>
                <div class="text-muted" style="font-size:0.68rem;">Devis gratuits + avis vérifiés</div>
              </div>
            <% end %>
          </li>
        </ul>
      </div>

      <%# ── Trouver entrepreneur ── %>
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-primary rounded-3 dropdown-toggle"
                type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="bi bi-hammer me-1"></i><span style="font-size:0.78rem;">Trouver entrepreneur</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="min-width:230px;">
          <li>
            <h6 class="dropdown-header text-muted" style="font-size:0.7rem;">PLATEFORMES DE DEVIS</h6>
          </li>
          <li>
            <%= link_to "https://www.bobex.be/renovation",
                        target: "_blank", rel: "noopener noreferrer",
                        class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.65rem;width:22px;text-align:center;">Bx</span>
              <div>
                <div style="font-size:0.8rem;" class="fw-medium">Bobex.be</div>
                <div class="text-muted" style="font-size:0.68rem;">3 devis gratuits · Entreprises vérifiées</div>
              </div>
            <% end %>
          </li>
          <li>
            <%= link_to "https://www.trustup.be/renovation",
                        target: "_blank", rel: "noopener noreferrer",
                        class: "dropdown-item d-flex align-items-center gap-2 py-2" do %>
              <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size:0.65rem;width:22px;text-align:center;">TU</span>
              <div>
                <div style="font-size:0.8rem;" class="fw-medium">Trustup.be</div>
                <div class="text-muted" style="font-size:0.68rem;">Devis gratuits + avis vérifiés</div>
              </div>
            <% end %>
          </li>
          <li><hr class="dropdown-divider my-1"></li>
          <li>
            <p class="px-3 text-muted mb-2" style="font-size:0.7rem;">
              <i class="bi bi-lightbulb me-1 text-warning"></i>
              Uploadez ensuite les devis reçus dans le <strong>Comparateur de devis</strong> pour les analyser côte à côte.
            </p>
          </li>
        </ul>
      </div>
      <%= link_to edit_professionals_project_path(@project), class: "btn btn-sm btn-outline-primary rounded-3" do %>
        <i class="bi bi-pencil me-1"></i><span style="font-size:0.78rem;">Modifier</span>
      <% end %>
    </div>
  </div>

  <div class="alert border-0 mb-3" style="background: linear-gradient(45deg, rgba(13, 110, 253, 0.05), rgba(13, 202, 240, 0.05)); word-wrap: break-word; max-width: 100%;">
    <div class="d-flex align-items-start">
      <i class="bi bi-lightbulb text-warning me-2 mt-1" style="flex-shrink: 0;"></i>
      <small style="word-wrap: break-word; overflow-wrap: break-word;">
        <strong>Astuce :</strong> Trouvez des professionnels sur Bobex, Trustup ou l'Ordre des Architectes, puis uploadez leurs devis dans l'onglet <strong>Préparation → Comparateur de devis</strong> pour les analyser côte à côte.
      </small>
    </div>
  </div>

  <div>
    <%# Pré-calcul des emails déjà invités pour éviter N+1 %>
    <% invited_map = @project.project_members.index_by { |m| m.invited_email&.downcase } %>

    <% if @project.architecte_nom.present? || @project.entrepreneur_principal_nom.present? || @project.maitre_ouvrage_nom.present? %>

      <!-- Architecte -->
      <% if @project.architecte_nom.present? %>
        <div class="row mb-4">
          <div class="col-12">
            <h6 class="text-secondary mb-3">
              <i class="bi bi-building me-2"></i>Architecte
            </h6>

            <!-- Informations architecte -->
            <div class="row g-2">
              <% if @project.architecte_prenom.present? %>
                <div class="col">
                  <strong>Prénom :</strong>
                  <span class="text-muted"><%= @project.architecte_prenom %></span>
                </div>
              <% end %>

              <% if @project.architecte_nom.present? %>
                <div class="col">
                  <strong>Nom :</strong>
                  <span class="text-muted"><%= @project.architecte_nom %></span>
                </div>
              <% end %>

              <% if @project.architecte_entreprise.present? %>
                <div class="col">
                  <strong>Cabinet :</strong>
                  <span class="text-muted"><%= @project.architecte_entreprise %></span>
                </div>
              <% end %>

              <% if @project.architecte_telephone.present? %>
                <div class="col">
                  <strong>Téléphone :</strong>
                  <span class="text-muted">
                    <a href="tel:<%= @project.architecte_telephone %>" class="text-decoration-none">
                      <i class="bi bi-telephone me-1"></i><%= @project.architecte_telephone %>
                    </a>
                  </span>
                </div>
              <% end %>

              <% if @project.architecte_email.present? %>
                <div class="col">
                  <strong>Email :</strong>
                  <span class="text-muted">
                    <a href="mailto:<%= @project.architecte_email %>" class="text-decoration-none">
                      <i class="bi bi-envelope me-1"></i><%= @project.architecte_email %>
                    </a>
                  </span>
                </div>
              <% end %>

              <% if @project.architecte_devis_montant.present? %>
                <div class="col">
                  <strong>Montant du devis :</strong>
                  <span class="text-muted"><%= @project.architecte_devis_montant_formatted %></span>
                </div>
              <% end %>
            </div>

            <%# ── Bouton invitation architecte ── %>
            <% if @project.architecte_email.present? %>
              <% archi_member = invited_map[@project.architecte_email.downcase] %>
              <div class="mt-2">
                <% if archi_member %>
                  <% if archi_member.active? %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.72rem;">
                      <i class="bi bi-check-circle me-1"></i>Actif sur le projet
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size:0.72rem;">
                      <i class="bi bi-clock me-1"></i>En attente
                      <% if archi_member.invite_sent_at.present? %>
                        · depuis <%= time_ago_in_words(archi_member.invite_sent_at) %>
                      <% end %>
                    </span>
                    <% if archi_member.reminder_sent_at.present? %>
                      <span class="badge bg-secondary-subtle text-secondary" style="font-size:0.68rem;">
                        <i class="bi bi-bell me-1"></i>Rappel envoyé <%= archi_member.reminder_sent_at.strftime("%d/%m") %>
                      </span>
                    <% end %>
                  <% end %>
                <% else %>
                  <%= button_to invite_project_path(@project), method: :post,
                        params: { email: @project.architecte_email, role: 'architect' },
                        class: 'btn btn-sm btn-outline-primary rounded-3 py-1 px-2',
                        style: 'font-size:0.78rem;' do %>
                    <i class="bi bi-send me-1"></i>Inviter<% if @project.architecte_prenom.present? %> <%= @project.architecte_prenom %><% end %> sur ce projet
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <hr>
      <% end %>

      <!-- Entrepreneur Principal -->
      <% if @project.entrepreneur_principal_nom.present? %>
        <div class="row mb-4">
          <div class="col-12">
            <h6 class="text-secondary mb-3">
              <i class="bi bi-hammer me-2"></i>Entrepreneur Principal
            </h6>

            <!-- Informations entrepreneur -->
            <div class="row g-2">
              <% if @project.entrepreneur_principal_nom.present? %>
                <div class="col">
                  <strong>Nom :</strong>
                  <span class="text-muted"><%= @project.entrepreneur_principal_nom %></span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_entreprise.present? %>
                <div class="col">
                  <strong>Entreprise :</strong>
                  <span class="text-muted"><%= @project.entrepreneur_principal_entreprise %></span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_numero_tva.present? %>
                <div class="col">
                  <strong>N° TVA :</strong>
                  <span class="text-muted"><%= @project.entrepreneur_principal_numero_tva %></span>
                  <%# Badge vérification BCE via VIES %>
                  <% case @project.entrepreneur_bce_statut
                     when 'valide' %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle ms-1"
                          title="N° TVA vérifié via registre européen VIES le <%= @project.entrepreneur_bce_verifie_at&.strftime('%d/%m/%Y') %>"
                          style="font-size:0.65rem;">
                      <i class="bi bi-patch-check-fill me-1"></i>BCE vérifié
                    </span>
                  <% when 'invalide' %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1"
                          title="N° TVA non reconnu dans le registre européen VIES"
                          style="font-size:0.65rem;">
                      <i class="bi bi-exclamation-triangle me-1"></i>Non vérifié
                    </span>
                  <% when nil %>
                    <% if @project.entrepreneur_principal_numero_tva.present? %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1"
                            style="font-size:0.65rem;">
                        <i class="bi bi-hourglass-split me-1"></i>Vérification en cours…
                      </span>
                    <% end %>
                  <% end %>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_telephone.present? %>
                <div class="col">
                  <strong>Téléphone :</strong>
                  <span class="text-muted">
                    <a href="tel:<%= @project.entrepreneur_principal_telephone %>" class="text-decoration-none">
                      <i class="bi bi-telephone me-1"></i><%= @project.entrepreneur_principal_telephone %>
                    </a>
                  </span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_email.present? %>
                <div class="col">
                  <strong>Email :</strong>
                  <span class="text-muted">
                    <a href="mailto:<%= @project.entrepreneur_principal_email %>" class="text-decoration-none">
                      <i class="bi bi-envelope me-1"></i><%= @project.entrepreneur_principal_email %>
                    </a>
                  </span>
                </div>
              <% end %>

              <% if @project.contractor_devis_montant.present? %>
                <div class="col">
                  <strong>Montant du devis :</strong>
                  <span class="text-muted"><%= number_to_currency(@project.contractor_devis_montant, unit: "€", separator: ",", delimiter: " ") %></span>
                </div>
              <% end %>
            </div>

            <%# ── Bouton invitation entrepreneur ── %>
            <% if @project.entrepreneur_principal_email.present? %>
              <% entr_member = invited_map[@project.entrepreneur_principal_email.downcase] %>
              <div class="mt-2">
                <% if entr_member %>
                  <% if entr_member.active? %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.72rem;">
                      <i class="bi bi-check-circle me-1"></i>Actif sur le projet
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size:0.72rem;">
                      <i class="bi bi-clock me-1"></i>En attente
                      <% if entr_member.invite_sent_at.present? %>
                        · depuis <%= time_ago_in_words(entr_member.invite_sent_at) %>
                      <% end %>
                    </span>
                    <% if entr_member.reminder_sent_at.present? %>
                      <span class="badge bg-secondary-subtle text-secondary" style="font-size:0.68rem;">
                        <i class="bi bi-bell me-1"></i>Rappel envoyé <%= entr_member.reminder_sent_at.strftime("%d/%m") %>
                      </span>
                    <% end %>
                  <% end %>
                <% else %>
                  <%= button_to invite_project_path(@project), method: :post,
                        params: { email: @project.entrepreneur_principal_email, role: 'entrepreneur' },
                        class: 'btn btn-sm btn-outline-primary rounded-3 py-1 px-2',
                        style: 'font-size:0.78rem;' do %>
                    <i class="bi bi-send me-1"></i>Inviter<% if @project.entrepreneur_principal_nom.present? %> <%= @project.entrepreneur_principal_nom %><% end %> sur ce projet
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <hr>
      <% end %>





      <!-- Corps de métiers (si implémenté plus tard) -->
      <% if @project.corps_metiers_list.any? %>
        <hr>
        <div class="row">
          <div class="col-12">
            <h6 class="text-secondary mb-3">
              <i class="bi bi-tools me-2"></i>Corps de métiers
            </h6>
            <div class="row">
              <% @project.corps_metiers_list.each_with_index do |metier, index| %>
                <div class="col-md-6 mb-2">
                  <div class="border rounded p-2">
                    <strong><%= metier['specialite'] %></strong>
                    <div class="small text-muted">
                      <%= metier['nom'] %> - <%= metier['entreprise'] %>
                    </div>
                    <% if metier['contact'].present? %>
                      <div class="small text-muted"><%= metier['contact'] %></div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

    <% else %>
      <!-- Message si aucune information -->
      <div class="text-center py-4">
        <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
        <h6 class="text-muted mt-3">Aucun professionnel renseigné</h6>
        <p class="text-muted small mb-3">Ajoutez les informations de votre architecte, entrepreneur et autres professionnels impliqués dans ce projet.</p>
        <%= link_to edit_professionals_project_path(@project), class: "btn btn-outline-primary-custom btn-sm" do %>
          <i class="bi bi-plus me-2"></i>Ajouter des professionnels
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<!-- Modal Preview Fonctionnalités Professionnels -->
<div class="modal fade" id="professionalsPreviewModal" tabindex="-1" aria-labelledby="professionalsPreviewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="professionalsPreviewModalLabel">
          <i class="bi bi-rocket me-2"></i>Fonctionnalités Professionnels à Venir
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-md-6">
            <div class="feature-preview mb-4">
              <h6 class="text-primary mb-2">
                <i class="bi bi-search me-2"></i>Recherche Professionnels
              </h6>
              <ul class="list-unstyled text-muted small">
                <li><i class="bi bi-check text-success me-1"></i>Base données architectes/entrepreneurs certifiés</li>
                <li><i class="bi bi-check text-success me-1"></i>Filtres par région et spécialisation</li>
                <li><i class="bi bi-check text-success me-1"></i>Vérification assurances automatique</li>
                <li><i class="bi bi-check text-success me-1"></i>Invitations directes par email</li>
              </ul>
            </div>

            <div class="feature-preview mb-4">
              <h6 class="text-warning mb-2">
                <i class="bi bi-star me-2"></i>Avis & Évaluations
              </h6>
              <ul class="list-unstyled text-muted small">
                <li><i class="bi bi-check text-success me-1"></i>Avis clients vérifiés</li>
                <li><i class="bi bi-check text-success me-1"></i>Photos réalisations récentes</li>
                <li><i class="bi bi-check text-success me-1"></i>Notation qualité/délais/prix</li>
                <li><i class="bi bi-check text-success me-1"></i>Recommandations personnalisées</li>
              </ul>
            </div>
          </div>

          <div class="col-md-6">
            <div class="feature-preview mb-4">
              <h6 class="text-success mb-2">
                <i class="bi bi-calculator me-2"></i>Comparaison Devis
              </h6>
              <ul class="list-unstyled text-muted small">
                <li><i class="bi bi-check text-success me-1"></i>Analyse automatique des devis</li>
                <li><i class="bi bi-check text-success me-1"></i>Comparaison prix du marché</li>
                <li><i class="bi bi-check text-success me-1"></i>Détection anomalies tarifaires</li>
                <li><i class="bi bi-check text-success me-1"></i>Négociation assistée par IA</li>
              </ul>
            </div>

            <div class="feature-preview">
              <h6 class="text-info mb-2">
                <i class="bi bi-people me-2"></i>Collaboration Temps Réel
              </h6>
              <ul class="list-unstyled text-muted small">
                <li><i class="bi bi-check text-success me-1"></i>Partage documents sécurisé</li>
                <li><i class="bi bi-check text-success me-1"></i>Planning coordonné automatiquement</li>
                <li><i class="bi bi-check text-success me-1"></i>Suivi avancement en temps réel</li>
                <li><i class="bi bi-check text-success me-1"></i>Communication centralisée</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <div class="me-auto">
          <small class="text-muted">
            <i class="bi bi-calendar me-1"></i>Disponibilité prévue : <strong>Mars 2026</strong>
          </small>
        </div>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
        <%= link_to dashboard_path, class: "btn btn-primary" do %>
          <i class="bi bi-bell me-1"></i>M'informer des nouveautés
        <% end %>
      </div>
    </div>
  </div>
</div>
