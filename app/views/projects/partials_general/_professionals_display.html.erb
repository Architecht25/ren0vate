<!-- Section Équipe & Professionnels -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-light border-0">
    <h5 class="card-title mb-0 text-primary-custom">
      <i class="bi bi-people me-2"></i>Équipe projet & Professionnels
    </h5>
  </div>
  <div class="card-body">

    <% if @project.architecte_nom.present? || @project.entrepreneur_principal_nom.present? || @project.maitre_ouvrage_nom.present? %>

      <!-- Architecte -->
      <% if @project.architecte_nom.present? %>
        <div class="row mb-4">
          <div class="col-12">
            <h6 class="text-secondary mb-3">
              <i class="bi bi-building me-2"></i>Architecte
            </h6>

            <div class="row g-3">
              <% if @project.architecte_nom_complet.present? %>
                <div class="col-md-6">
                  <strong>Nom :</strong>
                  <span class="text-muted"><%= @project.architecte_nom_complet %></span>
                </div>
              <% end %>

              <% if @project.architecte_entreprise.present? %>
                <div class="col-md-6">
                  <strong>Cabinet/Entreprise :</strong>
                  <span class="text-muted"><%= @project.architecte_entreprise %></span>
                </div>
              <% end %>

              <% if @project.architecte_numero_ordre.present? %>
                <div class="col-md-6">
                  <strong>N° Ordre :</strong>
                  <span class="text-muted"><%= @project.architecte_numero_ordre %></span>
                </div>
              <% end %>

              <% if @project.architecte_telephone.present? %>
                <div class="col-md-6">
                  <strong>Téléphone :</strong>
                  <span class="text-muted">
                    <a href="tel:<%= @project.architecte_telephone %>" class="text-decoration-none">
                      <i class="bi bi-telephone me-1"></i><%= @project.architecte_telephone %>
                    </a>
                  </span>
                </div>
              <% end %>

              <% if @project.architecte_email.present? %>
                <div class="col-md-6">
                  <strong>Email :</strong>
                  <span class="text-muted">
                    <a href="mailto:<%= @project.architecte_email %>" class="text-decoration-none">
                      <i class="bi bi-envelope me-1"></i><%= @project.architecte_email %>
                    </a>
                  </span>
                </div>
              <% end %>

              <% if @project.architecte_adresse.present? %>
                <div class="col-12">
                  <strong>Adresse :</strong>
                  <span class="text-muted"><%= simple_format(@project.architecte_adresse) %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <hr>
      <% end %>

      <!-- Entrepreneur Principal -->
      <% if @project.entrepreneur_principal_nom.present? %>
        <div class="row mb-4">
          <div class="col-12">
            <h6 class="text-secondary mb-3">
              <i class="bi bi-hammer me-2"></i>Entrepreneur Principal
            </h6>

            <div class="row g-3">
              <% if @project.entrepreneur_principal_nom.present? %>
                <div class="col-md-6">
                  <strong>Responsable :</strong>
                  <span class="text-muted"><%= @project.entrepreneur_principal_nom %></span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_entreprise.present? %>
                <div class="col-md-6">
                  <strong>Entreprise :</strong>
                  <span class="text-muted"><%= @project.entrepreneur_principal_entreprise %></span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_numero_tva.present? %>
                <div class="col-md-6">
                  <strong>N° TVA :</strong>
                  <span class="text-muted"><%= @project.entrepreneur_principal_numero_tva %></span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_telephone.present? %>
                <div class="col-md-6">
                  <strong>Téléphone :</strong>
                  <span class="text-muted">
                    <a href="tel:<%= @project.entrepreneur_principal_telephone %>" class="text-decoration-none">
                      <i class="bi bi-telephone me-1"></i><%= @project.entrepreneur_principal_telephone %>
                    </a>
                  </span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_email.present? %>
                <div class="col-md-6">
                  <strong>Email :</strong>
                  <span class="text-muted">
                    <a href="mailto:<%= @project.entrepreneur_principal_email %>" class="text-decoration-none">
                      <i class="bi bi-envelope me-1"></i><%= @project.entrepreneur_principal_email %>
                    </a>
                  </span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_assurance.present? %>
                <div class="col-md-6">
                  <strong>Assurance :</strong>
                  <span class="text-muted"><%= @project.entrepreneur_principal_assurance %></span>
                </div>
              <% end %>

              <% if @project.entrepreneur_principal_adresse.present? %>
                <div class="col-12">
                  <strong>Adresse :</strong>
                  <span class="text-muted"><%= simple_format(@project.entrepreneur_principal_adresse) %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <hr>
      <% end %>

      <!-- Autres Professionnels -->
      <% if @project.maitre_ouvrage_nom.present? || @project.coordinateur_securite_nom.present? %>
        <div class="row mb-4">
          <div class="col-12">
            <h6 class="text-secondary mb-3">
              <i class="bi bi-person-gear me-2"></i>Autres Professionnels
            </h6>

            <div class="row g-3">
              <% if @project.maitre_ouvrage_nom.present? %>
                <div class="col-md-6">
                  <strong>Maître d'ouvrage :</strong>
                  <span class="text-muted"><%= @project.maitre_ouvrage_nom %></span>
                  <% if @project.maitre_ouvrage_contact.present? %>
                    <br><small class="text-muted"><%= @project.maitre_ouvrage_contact %></small>
                  <% end %>
                </div>
              <% end %>

              <% if @project.coordinateur_securite_nom.present? %>
                <div class="col-md-6">
                  <strong>Coordinateur sécurité :</strong>
                  <span class="text-muted"><%= @project.coordinateur_securite_nom %></span>
                  <% if @project.coordinateur_securite_contact.present? %>
                    <br><small class="text-muted"><%= @project.coordinateur_securite_contact %></small>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <hr>
      <% end %>

      <!-- Assurances -->
      <% if @project.assurance_decennale_architecte.present? || @project.assurance_decennale_entrepreneur.present? || @project.garanties_travaux.present? %>
        <div class="row">
          <div class="col-12">
            <h6 class="text-secondary mb-3">
              <i class="bi bi-shield-check me-2"></i>Assurances & Garanties
            </h6>

            <div class="row g-3">
              <% if @project.assurance_decennale_architecte.present? %>
                <div class="col-md-6">
                  <strong>Assurance décennale architecte :</strong>
                  <span class="text-muted"><%= @project.assurance_decennale_architecte %></span>
                </div>
              <% end %>

              <% if @project.assurance_decennale_entrepreneur.present? %>
                <div class="col-md-6">
                  <strong>Assurance décennale entrepreneur :</strong>
                  <span class="text-muted"><%= @project.assurance_decennale_entrepreneur %></span>
                </div>
              <% end %>

              <% if @project.garanties_travaux.present? %>
                <div class="col-12">
                  <strong>Autres garanties :</strong>
                  <div class="text-muted"><%= simple_format(@project.garanties_travaux) %></div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Corps de métiers (si implémenté plus tard) -->
      <% if @project.corps_metiers_list.any? %>
        <hr>
        <div class="row">
          <div class="col-12">
            <h6 class="text-secondary mb-3">
              <i class="bi bi-tools me-2"></i>Corps de métiers
            </h6>
            <div class="row">
              <% @project.corps_metiers_list.each_with_index do |metier, index| %>
                <div class="col-md-6 mb-2">
                  <div class="border rounded p-2">
                    <strong><%= metier['specialite'] %></strong>
                    <div class="small text-muted">
                      <%= metier['nom'] %> - <%= metier['entreprise'] %>
                    </div>
                    <% if metier['contact'].present? %>
                      <div class="small text-muted"><%= metier['contact'] %></div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

    <% else %>
      <!-- Message si aucune information -->
      <div class="text-center py-4">
        <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
        <h6 class="text-muted mt-3">Aucun professionnel renseigné</h6>
        <p class="text-muted small mb-3">Ajoutez les informations de votre architecte, entrepreneur et autres professionnels impliqués dans ce projet.</p>
        <%= link_to edit_project_path(@project), class: "btn btn-outline-primary-custom btn-sm" do %>
          <i class="bi bi-plus me-2"></i>Ajouter des professionnels
        <% end %>
      </div>
    <% end %>

  </div>
</div>
