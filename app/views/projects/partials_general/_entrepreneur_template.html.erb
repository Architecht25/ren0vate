<!-- Template pour un entrepreneur -->
<div class="entrepreneur-item border rounded p-3 mb-3" style="background-color: #f8f9fa;">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <h6 class="text-warning-emphasis mb-0 fw-semibold">
      <i class="bi bi-hammer me-2"></i>Entrepreneur <span class="entrepreneur-number"></span>
    </h6>
    <button type="button" class="btn btn-sm btn-outline-danger remove-entrepreneur" style="display: none;">
      <i class="bi bi-trash"></i> Supprimer
    </button>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="mb-3">
        <label class="form-label">Nom du responsable</label>
        <input type="text" class="form-control" name="additional_entrepreneurs[][nom]" placeholder="Ex: Pierre Martin">
      </div>
    </div>
    <div class="col-md-6">
      <div class="mb-3">
        <label class="form-label">Entreprise</label>
        <input type="text" class="form-control" name="additional_entrepreneurs[][entreprise]" placeholder="Ex: Entreprise Martin SPRL">
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="mb-3">
        <label class="form-label">N° TVA</label>
        <input type="text" class="form-control" name="additional_entrepreneurs[][numero_tva]" placeholder="Ex: BE0123456789">
      </div>
    </div>
    <div class="col-md-6">
      <div class="mb-3">
        <label class="form-label">Téléphone</label>
        <input type="tel" class="form-control" name="additional_entrepreneurs[][telephone]" placeholder="Ex: +32 123 45 67 89">
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" class="form-control" name="additional_entrepreneurs[][email]" placeholder="Ex: contact@entreprise-martin.be">
      </div>
    </div>
    <div class="col-md-6">
      <div class="mb-3">
        <label class="form-label">Assurance responsabilité</label>
        <input type="text" class="form-control" name="additional_entrepreneurs[][assurance]" placeholder="Ex: AXA Police n° 123456">
      </div>
    </div>
  </div>

  <div class="mb-3">
    <label class="form-label">Adresse</label>
    <textarea rows="2" class="form-control" name="additional_entrepreneurs[][adresse]" placeholder="Ex: Zone Industrielle 45, 5000 Namur"></textarea>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="mb-3">
        <label class="form-label">Spécialité/Corps de métier</label>
        <input type="text" class="form-control" name="additional_entrepreneurs[][specialite]" placeholder="Ex: Plomberie, Électricité, Chauffage...">
      </div>
    </div>
    <div class="col-md-6">
      <div class="mb-3">
        <label class="form-label">Montant du devis</label>
        <div class="input-group">
          <input type="number" step="0.01" min="0" class="form-control" name="additional_entrepreneurs[][devis_montant]" placeholder="Ex: 25000.00">
          <span class="input-group-text">€</span>
        </div>
        <small class="form-text text-muted">
          Montant HT du devis pour comparer avec les factures
        </small>
      </div>
    </div>
  </div>
</div>
