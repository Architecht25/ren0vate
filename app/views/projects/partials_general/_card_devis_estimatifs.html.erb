<%# Devis estimatifs — devis générés pour ce bien %>
<div class="card border border-2 rounded-4 h-100">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
          <i class="bi bi-file-text text-white fs-6"></i>
        </div>
        <div>
          <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Devis estimatifs</h5>
          <p class="text-muted mb-0" style="font-size:0.75rem;">Devis générés personnellement pour ce bien à titre d'étude</p>
        </div>
      </div>
      <% if @project.property.present? %>
        <%= link_to new_property_quote_path(@project.property, project_id: @project.id), class: "btn btn-sm btn-outline-primary rounded-3" do %>
          <i class="bi bi-plus me-1"></i><span style="font-size:0.78rem;">Nouveau</span>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="card-body p-3">
    <% if @project.property.present? %>
      <% quotes = @project.property.quotes.order(created_at: :desc).limit(5) rescue [] %>
      <% if quotes.any? %>
        <% quotes.each do |quote| %>
          <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
            <i class="bi bi-file-earmark-text text-primary flex-shrink-0"></i>
            <div class="flex-grow-1 overflow-hidden">
              <div class="fw-semibold text-truncate" style="font-size:0.85rem;">Devis #<%= quote.id %></div>
              <div class="text-muted" style="font-size:0.72rem;"><%= quote.created_at.strftime("%d/%m/%Y") %>
                <% if quote.total_min.present? && quote.total_max.present? %>
                  &nbsp;·&nbsp;<span class="text-success fw-semibold">
                    <%= number_to_currency(quote.total_min, unit: '', separator: ',', delimiter: '.', precision: 0) %>&ndash;<%= number_to_currency(quote.total_max, unit: '€', separator: ',', delimiter: '.', precision: 0, format: "%n %u") %>
                  </span>
                <% end %>
              </div>
            </div>
            <%= link_to property_quote_path(@project.property, quote), class: "btn btn-sm btn-outline-secondary flex-shrink-0" do %>
              <i class="bi bi-arrow-right"></i>
            <% end %>
          </div>
        <% end %>
        <%= link_to property_quotes_path(@project.property), class: "btn btn-sm btn-outline-primary-custom w-100 mt-1" do %>
          <i class="bi bi-list me-1"></i>Tous les devis
        <% end %>
      <% else %>
        <div class="text-center py-4 text-muted">
          <i class="bi bi-file-earmark-plus fs-3 d-block mb-2"></i>
          <p class="small mb-3">Aucun devis estimatif pour ce bien</p>
          <%= link_to new_property_quote_path(@project.property, project_id: @project.id), class: "btn btn-sm btn-outline-primary" do %>
            <i class="bi bi-plus-circle me-1"></i>Créer un devis estimatif
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-4 text-muted">
        <i class="bi bi-house-x fs-3 d-block mb-2"></i>
        <p class="small mb-0">Aucun bien associé à ce chantier</p>
      </div>
    <% end %>
  </div>

  <%# ── Section Métrés (uploadés par l'architecte) ── %>
  <% metres_docs = @project.documents.where(type_document: 'metre').order(created_at: :desc) %>
  <% if metres_docs.any? %>
    <div class="card-footer bg-white border-top px-3 py-3">
      <div class="d-flex align-items-center gap-2 mb-2">
        <i class="bi bi-file-earmark-spreadsheet text-info flex-shrink-0"></i>
        <span class="fw-semibold" style="font-size:0.85rem;">Métrés de l'architecte</span>
        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-3" style="font-size:0.68rem;"><%= metres_docs.count %></span>
      </div>
      <% metres_docs.each do |doc| %>
        <div class="d-flex align-items-center gap-2 mb-1 pb-1 border-bottom">
          <i class="bi bi-file-earmark-spreadsheet text-info flex-shrink-0" style="font-size:0.9rem;"></i>
          <div class="flex-grow-1 overflow-hidden">
            <div class="text-truncate" style="font-size:0.82rem;"><%= doc.file_name.presence || "Métré" %></div>
            <div class="text-muted" style="font-size:0.7rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
          </div>
          <%= link_to rails_blob_path(doc, disposition: 'inline'), target: '_blank',
                class: "btn btn-sm btn-outline-info py-0 px-1 flex-shrink-0" do %>
            <i class="bi bi-eye" style="font-size:0.75rem;"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
