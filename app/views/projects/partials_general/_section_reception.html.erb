<%# Section 3 — Réception de chantier (bannière + 4 cartes) %>

<!-- Banner Section 3 -->
<div class="row mb-4 mt-2">
  <div class="col-12">
    <div class="d-flex align-items-center gap-3 py-3 px-4 rounded-3" style="background: rgba(132,169,140,0.1); border-left: 4px solid var(--ren0vate-success);">
      <span class="d-flex align-items-center justify-content-center rounded-circle text-white fw-bold flex-shrink-0" style="width:34px;height:34px;background:var(--ren0vate-success);font-size:0.85rem;">3</span>
      <div>
        <h5 class="mb-0 fw-semibold" style="color:var(--ren0vate-success-dark); font-size:1rem;">
          <i class="bi bi-file-earmark-check me-2"></i>Réception de chantier
        </h5>
        <small style="color:var(--ren0vate-text-muted);">Réception, garanties, carnet d'entretien &amp; ROI</small>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-5">

  <!-- Réception de chantier -->
  <div class="col-lg-3">
    <div class="card border border-2 rounded-4 h-100">
      <div class="card-header bg-white border-0 py-3">
        <div class="d-flex align-items-center">
          <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
            <i class="bi bi-file-earmark-check text-white fs-6"></i>
          </div>
          <div>
            <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Réception de chantier</h5>
            <p class="text-muted mb-0" style="font-size:0.75rem;">PV de réception &amp; réserves</p>
          </div>
        </div>
      </div>
      <div class="card-body p-3 d-flex flex-column">
        <p class="text-muted small mb-4">
          Enregistrez le procès-verbal de réception, les réserves éventuelles et les documents liés à la fin des travaux.
        </p>
        <div class="mt-auto">
          <%= link_to reception_chantier_project_path(@project), class: "btn btn-primary w-100" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>Accéder à la réception
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Garanties -->
  <div class="col-lg-3">
    <div class="card border border-2 rounded-4 h-100">
      <div class="card-header bg-white border-0 py-3">
        <div class="d-flex align-items-center">
          <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
            <i class="bi bi-shield-check text-white fs-6"></i>
          </div>
          <div>
            <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Garanties</h5>
            <p class="text-muted mb-0" style="font-size:0.75rem;">Suivi des garanties légales</p>
          </div>
        </div>
      </div>
      <div class="card-body p-3 d-flex flex-column">
        <p class="text-muted small mb-4">
          Suivez les garanties décennale, biennale et de parfait achèvement ainsi que leurs dates d'expiration.
        </p>
        <div class="mt-auto">
          <%= link_to garanties_project_path(@project), class: "btn btn-success w-100" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>Accéder aux garanties
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Carnet d'entretien -->
  <div class="col-lg-3">
    <div class="card border border-2 rounded-4 h-100">
      <div class="card-header bg-white border-0 py-3">
        <div class="d-flex align-items-center">
          <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
            <i class="bi bi-journal-text text-white fs-6"></i>
          </div>
          <div>
            <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Carnet d'entretien</h5>
            <p class="text-muted mb-0" style="font-size:0.75rem;">DIU &amp; dossier d'intervention</p>
          </div>
        </div>
      </div>
      <div class="card-body p-3 d-flex flex-column">
        <p class="text-muted small mb-4">
          Centralisez le dossier d'intervention ultérieure (DIU), les notices techniques et les recommandations d'entretien.
        </p>
        <div class="mt-auto">
          <%= link_to carnet_entretien_project_path(@project), class: "btn btn-warning w-100" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>Accéder au carnet
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- ROI Calculator -->
  <div class="col-lg-3">
    <div class="card border border-2 rounded-4 h-100">
      <div class="card-header bg-white border-0 py-3">
        <div class="d-flex align-items-center">
          <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
               style="width:40px;height:40px;flex-shrink:0;background:var(--ren0vate-primary-dark);">
            <i class="bi bi-graph-up-arrow text-white fs-6"></i>
          </div>
          <div>
            <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">ROI Calculator</h5>
            <p class="text-muted mb-0" style="font-size:0.75rem;">Rentabilité &amp; retour sur investissement</p>
          </div>
        </div>
      </div>
      <div class="card-body p-3 d-flex flex-column">
        <p class="text-muted small mb-4">
          Calculez la rentabilité de votre rénovation et estimez le retour sur investissement du projet.
        </p>
        <div class="mt-auto">
          <%= link_to roi_calculator_project_path(@project),
                class: "btn w-100 text-white",
                style: "background-color: var(--ren0vate-primary-dark); border-color: var(--ren0vate-primary-dark);" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>Accéder au calculateur
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>
