<%# Section 3 — Réception de chantier (4 cartes) %>

<div class="row g-3 mb-5">

  <!-- Réception de chantier -->
  <div class="col-6 col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header border-0 py-3 px-4 d-flex flex-wrap gap-2 align-items-center"
           style="background:linear-gradient(135deg,#0f172a,#1e3a5f); border-radius: 1rem 1rem 0 0 !important;">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-file-earmark-check text-white fs-5"></i>
          <div>
            <span class="fw-semibold text-white">Réception de chantier</span>
            <div class="text-white opacity-75" style="font-size:0.75rem;">PV de réception &amp; réserves</div>
          </div>
        </div>
      </div>
      <div class="card-body p-3 d-flex flex-column">
        <p class="text-muted small mb-4">
          Enregistrez le procès-verbal de réception, les réserves éventuelles et les documents liés à la fin des travaux.
        </p>
        <div class="mt-auto">
          <%= link_to reception_chantier_project_path(@project), class: "btn btn-primary w-100" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>Accéder à la réception
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Garanties -->
  <div class="col-6 col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header border-0 py-3 px-4 d-flex flex-wrap gap-2 align-items-center"
           style="background:linear-gradient(135deg,#064e3b,#065f46); border-radius: 1rem 1rem 0 0 !important;">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-shield-check text-white fs-5"></i>
          <div>
            <span class="fw-semibold text-white">Garanties</span>
            <div class="text-white opacity-75" style="font-size:0.75rem;">Décennale, biennale et bon fonctionnement</div>
          </div>
        </div>
      </div>
      <div class="card-body p-3 d-flex flex-column">
        <p class="text-muted small mb-4">
          Suivez les garanties décennale, biennale et de parfait achèvement ainsi que leurs dates d'expiration.
        </p>
        <div class="mt-auto">
          <%= link_to garanties_project_path(@project), class: "btn btn-success w-100" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>Accéder aux garanties
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Carnet d'entretien -->
  <div class="col-6 col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header border-0 py-3 px-4 d-flex flex-wrap gap-2 align-items-center"
           style="background:linear-gradient(135deg,#78350f,#92400e); border-radius: 1rem 1rem 0 0 !important;">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-journal-text text-white fs-5"></i>
          <div>
            <span class="fw-semibold text-white">Carnet d'entretien</span>
            <div class="text-white opacity-75" style="font-size:0.75rem;">Historique d'interventions et maintenance</div>
          </div>
        </div>
      </div>
      <div class="card-body p-3 d-flex flex-column">
        <p class="text-muted small mb-4">
          Centralisez le dossier d'intervention ultérieure (DIU), les notices techniques et les recommandations d'entretien.
        </p>
        <div class="mt-auto">
          <%= link_to carnet_entretien_project_path(@project), class: "btn btn-warning w-100" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>Accéder au carnet
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Retour sur investissement -->
  <div class="col-6 col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 h-100">
      <div class="card-header border-0 py-3 px-4 d-flex flex-wrap gap-2 align-items-center"
           style="background:linear-gradient(135deg,#1e1b4b,#312e81); border-radius: 1rem 1rem 0 0 !important;">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-graph-up-arrow text-white fs-5"></i>
          <div>
            <span class="fw-semibold text-white">Retour sur investissement</span>
            <div class="text-white opacity-75" style="font-size:0.75rem;">Estimez la valorisation de vos travaux</div>
          </div>
        </div>
      </div>
      <div class="card-body p-3 d-flex flex-column">
        <p class="text-muted small mb-4">
          Calculez la rentabilité de votre rénovation et estimez le retour sur investissement du projet.
        </p>
        <div class="mt-auto">
          <%= link_to roi_calculator_project_path(@project),
                class: "btn w-100 text-white",
                style: "background-color: var(--ren0vate-primary-dark); border-color: var(--ren0vate-primary-dark);" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>Accéder au calculateur
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>

<%# V2 — Lot 6 : conformité par région, garanties structurées, coffre-fort
    exportable. "Garanties" et "Carnet d'entretien" ci-dessus (V1) restent
    côte à côte, pas remplacés — voir mémoire
    "project_v2_navigation_ia_decision" pour la distinction actée avec
    Robin le 12/10/2026 : V1 dérive l'info des documents déposés (pas de
    date d'échéance réelle, rappels de maintenance déjà présents), V2
    apporte le suivi de date d'échéance structuré et l'export ZIP. %>
<div class="row g-3 mb-5">

  <div class="col-6 col-md-6 col-lg-4">
    <%= render "shared/v2_feature_card",
          title: "Conformité", icon: "bi-shield-check",
          subtitle: "Obligations par région",
          description: "Suivez les obligations légales/administratives par région (permis, PEB, attestations, assurances) avec échéances.",
          path: project_compliance_items_path(@project) %>
  </div>

  <div class="col-6 col-md-6 col-lg-4">
    <%= render "shared/v2_feature_card",
          title: "Garanties", icon: "bi-patch-check",
          subtitle: "Suivi structuré des échéances",
          description: "Enregistrez chaque garantie avec dates précises — alerte visuelle sur les garanties bientôt expirées ou expirées. Complémentaire à la carte Garanties ci-dessus (basée sur les documents déposés).",
          path: project_warranties_path(@project) %>
  </div>

  <div class="col-6 col-md-6 col-lg-4">
    <%= render "shared/v2_feature_card",
          title: "Coffre-fort", icon: "bi-archive",
          subtitle: "Export ZIP transmissible",
          description: "Plans, garanties, attestations, PV et permis en un seul export ZIP — transmissible à un acheteur ou locataire. Complémentaire au Carnet d'entretien ci-dessus (DIU, rappels de maintenance).",
          path: project_vault_path(@project) %>
  </div>

</div>
