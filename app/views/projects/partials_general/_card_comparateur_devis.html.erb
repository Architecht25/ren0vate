<%# Comparateur de devis — comparaison des offres entrepreneurs %>
<div class="card border border-2 rounded-4 h-100">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width:40px;height:40px;flex-shrink:0;">
          <i class="bi bi-bar-chart-steps text-white fs-6"></i>
        </div>
        <div>
          <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Comparateur de devis</h5>
          <p class="text-muted mb-0" style="font-size:0.75rem;">Comparaison des offres entrepreneurs</p>
        </div>
      </div>
      <span class="badge bg-secondary-subtle text-secondary rounded-3" style="font-size:0.7rem;">Bientôt disponible</span>
    </div>
  </div>
  <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 160px;">
    <i class="bi bi-bar-chart-steps text-warning fs-2 mb-3"></i>
    <p class="fw-semibold mb-1" style="font-size:0.9rem;">Fonctionnalité en cours de développement</p>
    <p class="text-muted mb-0" style="font-size:0.8rem;">
      Comparez côte à côte les devis de plusieurs entrepreneurs : postes, montants, délais et conditions.
    </p>
  </div>
</div>
