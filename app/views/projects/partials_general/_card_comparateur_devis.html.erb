<%# Comparateur de devis — comparaison des offres entrepreneurs (upload OCR) %>
<%
  tous_devis = (@project.devis_donnees.par_categorie('entrepreneur').avec_montant.includes(:document).order(created_at: :desc) rescue [])
  estimatif  = @project.property&.quotes&.order(created_at: :desc)&.first
  montant_estimatif = estimatif&.total_avg
  tous_types_union  = tous_devis.flat_map { |d| Array(d.types_travaux_detectes) }.uniq.sort
%>

<div class="card border border-2 rounded-4 h-100">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div class="d-flex align-items-center">
        <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3"
             style="width:40px;height:40px;flex-shrink:0;">
          <i class="bi bi-bar-chart-steps text-white fs-6"></i>
        </div>
        <div>
          <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Comparateur de devis</h5>
          <p class="text-muted mb-0" style="font-size:0.75rem;">
            Uploadez les devis reçus par email — OCR extrait et compare automatiquement
          </p>
        </div>
      </div>
      <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-3" style="font-size:0.7rem;">
        <%= tous_devis.count %> devis
      </span>
    </div>
  </div>

  <div class="card-body p-3">

    <%# ── Zone d'upload ─────────────────────────────── %>
    <div class="rounded-3 p-3 mb-3" style="background:#fffbeb;border:1px dashed #fbbf24;">
      <form id="devis-comparateur-upload-form"
            data-project-id="<%= @project.id %>"
            enctype="multipart/form-data">
        <div class="row g-2 align-items-end">
          <div class="col-12 col-sm-8">
            <label class="form-label mb-1 text-muted" style="font-size:0.75rem;">
              <i class="bi bi-file-earmark-pdf me-1"></i>Devis PDF / image (un à la fois)
            </label>
            <input type="file" name="file" id="devis-upload-file"
                   class="form-control form-control-sm"
                   accept=".pdf,.jpg,.jpeg,.png" style="font-size:0.78rem;">
          </div>
          <div class="col-12 col-sm-4">
            <button type="button" id="devis-scan-btn"
                    class="btn btn-warning btn-sm w-100" style="font-size:0.78rem;">
              <i class="bi bi-magic me-1"></i>Analyser
            </button>
          </div>
        </div>
        <div id="devis-scan-status" class="mt-2" style="font-size:0.75rem;display:none;"></div>
      </form>
    </div>

    <%# ── Tableau comparatif ──────────────────────── %>
    <% if tous_devis.any? %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0" style="font-size:0.78rem;">
          <thead>
            <tr class="text-muted" style="font-size:0.7rem;background:#f8f9fa;">
              <th class="fw-normal py-2">Entreprise</th>
              <th class="fw-normal text-end">Montant HTVA</th>
              <th class="fw-normal text-end">TVAC</th>
              <th class="fw-normal text-center">TVA</th>
              <% if tous_devis.any?(&:surface_travaux) %>
                <th class="fw-normal text-end">€/m²</th>
              <% end %>
              <th class="fw-normal text-center">Travaux détectés</th>
              <% if tous_types_union.size > 1 %>
                <th class="fw-normal text-center">Postes manquants</th>
              <% end %>
              <th class="fw-normal text-center">Validité</th>
              <% if montant_estimatif.to_f > 0 %>
                <th class="fw-normal text-end">Écart estimatif</th>
              <% end %>
              <th class="fw-normal text-center">Conf.</th>
              <% if tous_devis.size > 1 %>
                <th class="fw-normal text-center">Score</th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <%
              montants = tous_devis.map { |d| d.montant_total_htva.to_f }.reject(&:zero?)
              min_montant = montants.min
              max_montant = montants.max
              has_surface_col = tous_devis.any?(&:surface_travaux)

              total_colspan = 4 # Entreprise, HTVA, TVAC, TVA
              total_colspan += 1 if has_surface_col
              total_colspan += 1 # Travaux
              total_colspan += 1 if tous_types_union.size > 1 # Postes manquants
              total_colspan += 1 # Validité
              total_colspan += 1 if montant_estimatif.to_f > 0 # Écart estimatif
              total_colspan += 1 # Confiance
              total_colspan += 1 if tous_devis.size > 1 # Score
            %>
            <% tous_devis.each do |d| %>
              <%
                montant = d.montant_total_htva.to_f
                is_min  = montants.size > 1 && montant == min_montant
                is_max  = montants.size > 1 && montant == max_montant
                ecart_pct = montant_estimatif.to_f > 0 ? ((montant - montant_estimatif.to_f) / montant_estimatif.to_f * 100).round(1) : nil
                anomalie  = d.anomalie_prix(tous_devis)
                score     = tous_devis.size > 1 ? d.score_composite(tous_devis) : nil
                manquants = tous_types_union.size > 1 ? d.types_travaux_manquants(tous_types_union) : []
                prix_m2   = (d.surface_travaux.to_f > 0 && montant > 0) ? (montant / d.surface_travaux.to_f).round(0) : nil
              %>
              <tr class="<%= is_min ? 'table-success' : is_max ? 'table-danger' : '' %>">
                <td>
                  <div class="fw-medium">
                    <%= d.nom_entreprise.presence || "—" %>
                    <% if anomalie == :high %>
                      <span class="badge bg-danger ms-1" style="font-size:0.58rem;" title="Prix anormalement élevé vs les autres devis">⚠️ élevé</span>
                    <% elsif anomalie == :low %>
                      <span class="badge bg-info ms-1" style="font-size:0.58rem;" title="Prix anormalement bas — vérifiez le périmètre">⚠️ bas</span>
                    <% end %>
                  </div>
                  <% if d.numero_bce_entreprise.present? %>
                    <div class="text-muted" style="font-size:0.68rem;">BCE <%= d.numero_bce_entreprise %></div>
                  <% else %>
                    <div class="text-warning" style="font-size:0.68rem;">BCE absent</div>
                  <% end %>
                  <% if d.date_devis.present? %>
                    <div class="text-muted" style="font-size:0.68rem;"><%= d.date_devis.strftime('%d/%m/%Y') %></div>
                  <% end %>
                  <%# ── Analyse de contenu (ventilation par poste) ──────────────── %>
                  <% if d.analyse_contenu_terminee? %>
                    <button type="button"
                            class="btn btn-link btn-sm p-0 devis-contenu-toggle-btn"
                            style="font-size:0.68rem;"
                            data-devis-donnee-id="<%= d.id %>"
                            data-repartition='<%= d.repartition_par_categorie.map { |cat, montant| { categorie: cat, libelle: DevisDonnee.categorie_libelle(cat), montant_htva: montant } }.to_json %>'
                            data-confiance="<%= d.analyse_contenu_confiance %>"
                            data-postes-count="<%= d.postes.size %>">
                      <i class="bi bi-pie-chart me-1"></i>Répartition par poste
                    </button>
                  <% elsif d.analyse_contenu_en_cours? %>
                    <div class="text-muted devis-contenu-pending" data-devis-donnee-id="<%= d.id %>" style="font-size:0.68rem;">
                      <span class="spinner-border spinner-border-sm" style="width:0.6rem;height:0.6rem;"></span>
                      Analyse du contenu…
                    </div>
                  <% end %>
                </td>
                <td class="text-end fw-semibold">
                  <% if montant > 0 %>
                    <%= number_to_currency(montant, unit: '', separator: ',', delimiter: '.', precision: 0) %> €
                    <% if is_min %><span class="badge bg-success ms-1" style="font-size:0.6rem;">✓ min</span><% end %>
                    <% if is_max %><span class="badge bg-danger ms-1" style="font-size:0.6rem;">max</span><% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="text-end text-muted">
                  <% if d.montant_total_tvac.to_f > 0 %>
                    <%= number_to_currency(d.montant_total_tvac, unit: '', separator: ',', delimiter: '.', precision: 0) %> €
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="text-center text-muted">
                  <%= d.taux_tva.present? ? "#{d.taux_tva.to_i}%" : "—" %>
                </td>
                <% if has_surface_col %>
                  <td class="text-end text-muted">
                    <% if prix_m2 %>
                      <%= number_to_currency(prix_m2, unit: '', separator: ',', delimiter: '.', precision: 0) %> €/m²
                    <% else %>
                      —
                    <% end %>
                  </td>
                <% end %>
                <td class="text-center">
                  <% travaux = d.types_travaux_detectes.presence || [] %>
                  <% if travaux.any? %>
                    <% travaux.first(2).each do |t| %>
                      <span class="badge bg-secondary-subtle text-secondary d-block mb-1"
                            style="font-size:0.62rem;white-space:normal;">
                        <%= t.gsub('_', ' ').capitalize %>
                      </span>
                    <% end %>
                    <% if travaux.size > 2 %>
                      <span class="text-muted" style="font-size:0.65rem;">+<%= travaux.size - 2 %></span>
                    <% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <% if tous_types_union.size > 1 %>
                  <td class="text-center">
                    <% if manquants.any? %>
                      <% manquants.first(2).each do |t| %>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle d-block mb-1"
                              style="font-size:0.6rem;white-space:normal;"
                              title="Ce poste est présent dans d'autres devis mais absent ici">
                          <%= t.gsub('_', ' ').capitalize %>
                        </span>
                      <% end %>
                      <% if manquants.size > 2 %>
                        <span class="text-muted" style="font-size:0.63rem;">+<%= manquants.size - 2 %></span>
                      <% end %>
                    <% else %>
                      <span class="text-success" style="font-size:0.72rem;">✓</span>
                    <% end %>
                  </td>
                <% end %>
                <td class="text-center">
                  <% if d.validite_devis.present? %>
                    <% expired = d.validite_devis < Date.current %>
                    <span class="<%= expired ? 'text-danger' : 'text-success' %>" style="font-size:0.72rem;">
                      <%= d.validite_devis.strftime('%d/%m/%y') %>
                      <%= expired ? '⚠️' : '✓' %>
                    </span>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <% if montant_estimatif.to_f > 0 %>
                  <td class="text-end">
                    <% if ecart_pct %>
                      <span class="fw-medium <%= ecart_pct > 15 ? 'text-danger' : ecart_pct < -15 ? 'text-info' : 'text-success' %>">
                        <%= ecart_pct > 0 ? "+#{ecart_pct}" : ecart_pct %>%
                      </span>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                <% end %>
                <td class="text-center">
                  <% conf = d.confiance_ocr.to_f %>
                  <span class="badge <%= conf >= 75 ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>
                               border border-<%= conf >= 75 ? 'success' : 'warning' %>-subtle"
                        style="font-size:0.65rem;">
                    <%= conf.round %>%
                  </span>
                </td>
                <% if tous_devis.size > 1 %>
                  <td class="text-center">
                    <% if score %>
                      <%
                        score_color = score >= 70 ? 'success' : score >= 45 ? 'warning' : 'danger'
                      %>
                      <span class="badge bg-<%= score_color %>-subtle text-<%= score_color %> border border-<%= score_color %>-subtle fw-semibold"
                            style="font-size:0.68rem;"
                            title="Score composite : prix (40%), confiance (20%), complétude (15%), BCE (10%), validité (15%)">
                        <%= score %>/100
                      </span>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
              <% if d.analyse_contenu_terminee? || d.analyse_contenu_en_cours? %>
                <tr class="devis-contenu-detail-row d-none" data-devis-donnee-id="<%= d.id %>">
                  <td colspan="<%= total_colspan %>" class="p-3" style="background:#fdfaf3;">
                    <div class="row g-3 align-items-center">
                      <div class="col-12 col-md-5">
                        <canvas class="devis-contenu-chart" data-devis-donnee-id="<%= d.id %>" height="140"></canvas>
                      </div>
                      <div class="col-12 col-md-7">
                        <div class="devis-contenu-postes" style="font-size:0.72rem;max-height:180px;overflow-y:auto;"></div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
          <% if tous_devis.size > 1 && montants.size > 1 %>
            <tfoot style="background:#f8f9fa;">
              <tr>
                <td class="text-muted py-2" style="font-size:0.72rem;">Écart min/max</td>
                <%
                  tfoot_colspan = 3  # HTVA, TVAC, TVA
                  tfoot_colspan += 1 if has_surface_col
                  tfoot_colspan += 1  # Travaux
                  tfoot_colspan += 1 if tous_types_union.size > 1  # Postes manquants
                  tfoot_colspan += 1  # Validité
                  tfoot_colspan += 1 if montant_estimatif.to_f > 0  # Écart estimatif
                  tfoot_colspan += 1  # Confiance
                  tfoot_colspan += 1 if tous_devis.size > 1  # Score
                %>
                <td colspan="<%= tfoot_colspan %>" class="text-end fw-semibold py-2">
                  <% ecart_abs = max_montant - min_montant %>
                  <% ecart_rel = (ecart_abs / min_montant * 100).round(1) %>
                  <span class="<%= ecart_rel > 20 ? 'text-danger' : 'text-muted' %>">
                    <%= number_to_currency(ecart_abs, unit: '', separator: ',', delimiter: '.', precision: 0) %> €
                    (<%= ecart_rel %>%)
                  </span>
                </td>
              </tr>
            </tfoot>
          <% end %>
        </table>
      </div>

      <%# ── Bouton recommandation IA ──────────────────────────── %>
      <% if tous_devis.size >= 2 %>
        <div class="mt-3 pt-3 border-top">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted" style="font-size:0.75rem;">Analyse comparative IA</span>
            <button type="button" id="devis-ia-btn"
                    class="btn btn-sm btn-outline-warning"
                    data-project-id="<%= @project.id %>"
                    style="font-size:0.75rem;">
              <i class="bi bi-stars me-1"></i>Recommandation IA
            </button>
          </div>
          <div id="devis-ia-result" style="display:none;"></div>
        </div>
      <% end %>

    <% else %>
      <div class="text-center py-3 text-muted" style="font-size:0.82rem;">
        <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
        Aucun devis uploadé — importez les PDFs reçus par email pour les comparer
      </div>
    <% end %>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
document.getElementById('devis-scan-btn')?.addEventListener('click', function() {
  const form     = document.getElementById('devis-comparateur-upload-form');
  const fileInput = document.getElementById('devis-upload-file');
  const status   = document.getElementById('devis-scan-status');
  const btn      = this;

  if (!fileInput.files[0]) {
    status.style.display = 'block';
    status.className = 'mt-2 text-warning';
    status.textContent = 'Veuillez sélectionner un fichier.';
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Analyse OCR…';
  status.style.display = 'block';
  status.className = 'mt-2 text-muted';
  status.textContent = 'Extraction en cours (5-15 sec)…';

  const formData = new FormData();
  formData.append('file', fileInput.files[0]);
  formData.append('project_id', form.dataset.projectId);
  formData.append('categorie_emetteur', 'entrepreneur');

  fetch('<%= ocr_scan_devis_path %>', {
    method: 'POST',
    headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
    body: formData
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      status.className = 'mt-2 text-success';
      status.innerHTML = `✓ ${data.message || 'Devis analysé'} — <strong>${data.nom_entreprise || 'Entreprise'}</strong> : ${data.montant_htva ? data.montant_htva.toLocaleString('fr-BE') + ' € HTVA' : 'montant non extrait'} (confiance ${data.confiance_extraction?.toFixed(0) ?? '?'}%)`;
      setTimeout(() => window.location.reload(), 1500);
    } else {
      status.className = 'mt-2 text-danger';
      status.textContent = 'Erreur : ' + (data.error || 'Extraction échouée');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-magic me-1"></i>Analyser';
    }
  })
  .catch(() => {
    status.className = 'mt-2 text-danger';
    status.textContent = 'Erreur réseau — réessayez.';
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-magic me-1"></i>Analyser';
  });
});

// Recommandation IA comparateur
document.getElementById('devis-ia-btn')?.addEventListener('click', function() {
  const btn    = this;
  const result = document.getElementById('devis-ia-result');
  const csrf   = document.querySelector('meta[name="csrf-token"]').content;

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Analyse…';
  result.style.display = 'none';

  fetch('<%= ocr_analyser_devis_path %>', {
    method: 'POST',
    headers: {
      'X-CSRF-Token': csrf,
      'Content-Type': 'application/x-www-form-urlencoded'
    },
    body: new URLSearchParams({ project_id: btn.dataset.projectId })
  })
  .then(r => r.json())
  .then(data => {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-stars me-1"></i>Recommandation IA';
    result.style.display = 'block';

    if (!data.success) {
      result.innerHTML = `<div class="alert alert-warning py-2 mb-0" style="font-size:0.78rem;">${data.error || 'Erreur'}</div>`;
      return;
    }

    const anomalieHtml = data.alerte_anomalie
      ? `<div class="alert alert-danger py-2 mb-2" style="font-size:0.75rem;"><i class="bi bi-exclamation-triangle me-1"></i>Anomalie de prix détectée — vérifiez le périmètre des offres.</div>`
      : '';

    const attentionHtml = (data.points_attention || []).length
      ? `<ul class="mb-2 ps-3" style="font-size:0.75rem;">${data.points_attention.map(p => `<li>${p}</li>`).join('')}</ul>`
      : '';

    const negoHtml = (data.conseils_nego || []).length
      ? `<div class="text-muted mb-1" style="font-size:0.72rem;">Conseils de négociation :</div><ul class="mb-0 ps-3" style="font-size:0.75rem;">${data.conseils_nego.map(c => `<li>${c}</li>`).join('')}</ul>`
      : '';

    result.innerHTML = `
      <div class="rounded-3 p-3" style="background:#fffbeb;border:1px solid #fbbf24;font-size:0.78rem;">
        ${anomalieHtml}
        ${ data.meilleur_devis ? `<div class="fw-semibold text-success mb-2">✓ Recommandé : ${data.meilleur_devis}</div>` : '' }
        <p class="mb-2">${data.recommandation || ''}</p>
        ${attentionHtml}
        ${negoHtml}
      </div>
    `;
  })
  .catch(() => {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-stars me-1"></i>Recommandation IA';
    result.style.display = 'block';
    result.innerHTML = '<div class="alert alert-danger py-2 mb-0" style="font-size:0.78rem;">Erreur réseau — réessayez.</div>';
  });
});
</script>

<%# ── Analyse de contenu : répartition budgétaire par poste (graphique) ────────
    Le montant total du devis est déjà extrait en synchrone plus haut ; cette
    ventilation par poste (Bots::DevisContenuClaudeService, appel Claude vision
    PDF plus coûteux) tourne en tâche de fond (DevisContenuExtractionJob) — d'où
    le badge "Analyse du contenu…" + polling ci-dessous pour les devis encore
    en_cours au moment du rendu de la page. %>
<script type="module" nonce="<%= content_security_policy_nonce %>">
import Chart from 'chart.js/auto';

const devisCharts = new Map(); // devisDonneeId -> Chart instance

function currencyBe(n) {
  return Math.round(n).toLocaleString('fr-BE') + ' €';
}

// Regroupe les catégories au-delà des 7 premières sous "Autres" — un graphique
// à 15+ barres devient illisible et n'apporte plus rien à la décision.
function repartitionPourGraphique(repartition) {
  const triee = [...repartition].sort((a, b) => b.montant_htva - a.montant_htva);
  if (triee.length <= 7) return triee;
  const tete = triee.slice(0, 7);
  const autres = triee.slice(7).reduce((sum, r) => sum + r.montant_htva, 0);
  return [...tete, { categorie: 'autre', libelle: 'Autres postes', montant_htva: autres }];
}

function renderDevisContenuChart(devisDonneeId, repartition, meta) {
  const canvas = document.querySelector(`.devis-contenu-chart[data-devis-donnee-id="${devisDonneeId}"]`);
  const panel  = document.querySelector(`.devis-contenu-postes[data-devis-donnee-id="${devisDonneeId}"]`) ||
                 document.querySelector(`tr.devis-contenu-detail-row[data-devis-donnee-id="${devisDonneeId}"] .devis-contenu-postes`);
  if (!canvas) return;

  const donnees = repartitionPourGraphique(repartition);

  devisCharts.get(devisDonneeId)?.destroy();
  devisCharts.set(devisDonneeId, new Chart(canvas, {
    type: 'bar',
    data: {
      labels: donnees.map(d => d.libelle),
      datasets: [{
        data: donnees.map(d => d.montant_htva),
        backgroundColor: '#d97706',
        borderRadius: 4,
        borderSkipped: false,
        barThickness: 14
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: { label: ctx => currencyBe(ctx.parsed.x) + ' HTVA' }
        }
      },
      scales: {
        x: {
          beginAtZero: true,
          grid: { color: '#eee' },
          ticks: { font: { size: 10 }, callback: v => currencyBe(v) }
        },
        y: {
          grid: { display: false },
          ticks: { font: { size: 10 } }
        }
      }
    }
  }));

  if (panel) {
    const total = donnees.reduce((sum, d) => sum + d.montant_htva, 0);
    const lignes = donnees.map(d => `
      <div class="d-flex justify-content-between border-bottom py-1">
        <span>${d.libelle}</span>
        <span class="fw-medium">${currencyBe(d.montant_htva)}</span>
      </div>
    `).join('');
    const metaHtml = meta ? `
      <div class="text-muted mb-2" style="font-size:0.68rem;">
        ${meta.postesCount ?? '?'} poste(s) détecté(s) — confiance ${meta.confiance ? Math.round(meta.confiance) + ' %' : 'N/A'}
      </div>
    ` : '';
    panel.innerHTML = `
      ${metaHtml}
      ${lignes}
      <div class="d-flex justify-content-between pt-2 fw-semibold" style="font-size:0.75rem;">
        <span>Total ventilé</span><span>${currencyBe(total)}</span>
      </div>
    `;
  }
}

function toggleDetailRow(devisDonneeId) {
  const row = document.querySelector(`tr.devis-contenu-detail-row[data-devis-donnee-id="${devisDonneeId}"]`);
  if (!row) return;
  row.classList.toggle('d-none');
  return !row.classList.contains('d-none');
}

document.querySelectorAll('.devis-contenu-toggle-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const id = btn.dataset.devisDonneeId;
    const opened = toggleDetailRow(id);
    if (!opened) return;

    if (!devisCharts.has(id)) {
      const repartition = JSON.parse(btn.dataset.repartition || '[]');
      renderDevisContenuChart(id, repartition, {
        confiance: parseFloat(btn.dataset.confiance),
        postesCount: parseInt(btn.dataset.postesCount, 10)
      });
    }
  });
});

// ── Polling des analyses encore en cours au chargement de la page ───────────
document.querySelectorAll('.devis-contenu-pending').forEach(pendingEl => {
  const id = pendingEl.dataset.devisDonneeId;
  let attempts = 0;
  const MAX_ATTEMPTS = 40; // ~2 minutes, même budget que le polling PEB

  const timer = setInterval(() => {
    attempts += 1;
    if (attempts > MAX_ATTEMPTS) {
      clearInterval(timer);
      pendingEl.remove();
      return;
    }

    fetch(`<%= ocr_devis_analyse_contenu_statut_path %>?devis_donnee_id=${encodeURIComponent(id)}`, {
      headers: { 'Accept': 'application/json' }
    })
      .then(r => r.json())
      .then(data => {
        if (data.statut === 'en_cours') return;
        clearInterval(timer);

        if (!data.success) {
          pendingEl.remove(); // échec de l'analyse de contenu — le reste du comparateur reste utilisable
          return;
        }

        // Remplace le spinner par le bouton "Répartition par poste"
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-link btn-sm p-0 devis-contenu-toggle-btn';
        btn.style.fontSize = '0.68rem';
        btn.dataset.devisDonneeId = id;
        btn.dataset.repartition = JSON.stringify(data.repartition || []);
        btn.dataset.confiance = data.confiance ?? '';
        btn.dataset.postesCount = (data.postes || []).length;
        btn.innerHTML = '<i class="bi bi-pie-chart me-1"></i>Répartition par poste';
        btn.addEventListener('click', () => {
          const opened = toggleDetailRow(id);
          if (opened && !devisCharts.has(id)) {
            renderDevisContenuChart(id, JSON.parse(btn.dataset.repartition || '[]'), {
              confiance: parseFloat(btn.dataset.confiance),
              postesCount: parseInt(btn.dataset.postesCount, 10)
            });
          }
        });

        pendingEl.replaceWith(btn);

        // Une fois l'analyse prête, on l'affiche directement plutôt que de
        // forcer un second clic — l'utilisateur vient de la demander via l'upload.
        const row = document.querySelector(`tr.devis-contenu-detail-row[data-devis-donnee-id="${id}"]`);
        if (row) {
          row.classList.remove('d-none');
          renderDevisContenuChart(id, data.repartition || [], {
            confiance: data.confiance,
            postesCount: (data.postes || []).length
          });
        }
      })
      .catch(() => { /* erreur ponctuelle de polling — on retente au prochain tick */ });
  }, 3000);
});
</script>
