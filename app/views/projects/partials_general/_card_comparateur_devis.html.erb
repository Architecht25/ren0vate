<%# Comparateur de devis — comparaison des offres entrepreneurs (upload OCR) %>
<%
  tous_devis = (@project.devis_donnees.par_categorie('entrepreneur').avec_montant.includes(:document).order(created_at: :desc) rescue [])
  estimatif  = @project.property&.quotes&.order(created_at: :desc)&.first
  montant_estimatif = estimatif&.total_avg
%>

<div class="card border border-2 rounded-4 h-100">
  <div class="card-header bg-white border-0 py-3">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3"
             style="width:40px;height:40px;flex-shrink:0;">
          <i class="bi bi-bar-chart-steps text-white fs-6"></i>
        </div>
        <div>
          <h5 class="card-title mb-0 text-dark fw-normal" style="font-size:0.95rem;">Comparateur de devis</h5>
          <p class="text-muted mb-0" style="font-size:0.75rem;">
            Uploadez les devis reçus par email — OCR extrait et compare automatiquement
          </p>
        </div>
      </div>
      <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-3" style="font-size:0.7rem;">
        <%= tous_devis.count %> devis
      </span>
    </div>
  </div>

  <div class="card-body p-3">

    <%# ── Zone d'upload ─────────────────────────────── %>
    <div class="rounded-3 p-3 mb-3" style="background:#fffbeb;border:1px dashed #fbbf24;">
      <form id="devis-comparateur-upload-form"
            data-project-id="<%= @project.id %>"
            enctype="multipart/form-data">
        <div class="row g-2 align-items-end">
          <div class="col-8">
            <label class="form-label mb-1 text-muted" style="font-size:0.75rem;">
              <i class="bi bi-file-earmark-pdf me-1"></i>Devis PDF / image (un à la fois)
            </label>
            <input type="file" name="file" id="devis-upload-file"
                   class="form-control form-control-sm"
                   accept=".pdf,.jpg,.jpeg,.png" style="font-size:0.78rem;">
          </div>
          <div class="col-4">
            <button type="button" id="devis-scan-btn"
                    class="btn btn-warning btn-sm w-100" style="font-size:0.78rem;">
              <i class="bi bi-magic me-1"></i>Analyser
            </button>
          </div>
        </div>
        <div id="devis-scan-status" class="mt-2" style="font-size:0.75rem;display:none;"></div>
      </form>
    </div>

    <%# ── Tableau comparatif ──────────────────────── %>
    <% if tous_devis.any? %>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0" style="font-size:0.78rem;">
          <thead>
            <tr class="text-muted" style="font-size:0.7rem;background:#f8f9fa;">
              <th class="fw-normal py-2">Entreprise</th>
              <th class="fw-normal text-end">Montant HTVA</th>
              <th class="fw-normal text-end">TVAC</th>
              <th class="fw-normal text-center">TVA</th>
              <th class="fw-normal text-center">Travaux détectés</th>
              <th class="fw-normal text-center">Validité</th>
              <% if montant_estimatif.to_f > 0 %>
                <th class="fw-normal text-end">Écart estimatif</th>
              <% end %>
              <th class="fw-normal text-center">Conf.</th>
            </tr>
          </thead>
          <tbody>
            <%
              montants = tous_devis.map { |d| d.montant_total_htva.to_f }.reject(&:zero?)
              min_montant = montants.min
              max_montant = montants.max
            %>
            <% tous_devis.each do |d| %>
              <%
                montant = d.montant_total_htva.to_f
                is_min  = montants.size > 1 && montant == min_montant
                is_max  = montants.size > 1 && montant == max_montant
                ecart_pct = montant_estimatif.to_f > 0 ? ((montant - montant_estimatif.to_f) / montant_estimatif.to_f * 100).round(1) : nil
              %>
              <tr class="<%= is_min ? 'table-success' : is_max ? 'table-danger' : '' %>">
                <td>
                  <div class="fw-medium"><%= d.nom_entreprise.presence || "—" %></div>
                  <% if d.numero_bce_entreprise.present? %>
                    <div class="text-muted" style="font-size:0.68rem;">BCE <%= d.numero_bce_entreprise %></div>
                  <% end %>
                  <% if d.date_devis.present? %>
                    <div class="text-muted" style="font-size:0.68rem;"><%= d.date_devis.strftime('%d/%m/%Y') %></div>
                  <% end %>
                </td>
                <td class="text-end fw-semibold">
                  <% if montant > 0 %>
                    <%= number_to_currency(montant, unit: '', separator: ',', delimiter: '.', precision: 0) %> €
                    <% if is_min %><span class="badge bg-success ms-1" style="font-size:0.6rem;">✓ min</span><% end %>
                    <% if is_max %><span class="badge bg-danger ms-1" style="font-size:0.6rem;">max</span><% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="text-end text-muted">
                  <% if d.montant_total_tvac.to_f > 0 %>
                    <%= number_to_currency(d.montant_total_tvac, unit: '', separator: ',', delimiter: '.', precision: 0) %> €
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="text-center text-muted">
                  <%= d.taux_tva.present? ? "#{d.taux_tva.to_i}%" : "—" %>
                </td>
                <td class="text-center">
                  <% travaux = d.types_travaux_detectes.presence || [] %>
                  <% if travaux.any? %>
                    <% travaux.first(2).each do |t| %>
                      <span class="badge bg-secondary-subtle text-secondary d-block mb-1"
                            style="font-size:0.62rem;white-space:normal;">
                        <%= t.gsub('_', ' ').capitalize %>
                      </span>
                    <% end %>
                    <% if travaux.size > 2 %>
                      <span class="text-muted" style="font-size:0.65rem;">+<%= travaux.size - 2 %></span>
                    <% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <% if d.validite_devis.present? %>
                    <% expired = d.validite_devis < Date.current %>
                    <span class="<%= expired ? 'text-danger' : 'text-success' %>" style="font-size:0.72rem;">
                      <%= d.validite_devis.strftime('%d/%m/%y') %>
                      <%= expired ? '⚠️' : '✓' %>
                    </span>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <% if montant_estimatif.to_f > 0 %>
                  <td class="text-end">
                    <% if ecart_pct %>
                      <span class="fw-medium <%= ecart_pct > 15 ? 'text-danger' : ecart_pct < -15 ? 'text-info' : 'text-success' %>">
                        <%= ecart_pct > 0 ? "+#{ecart_pct}" : ecart_pct %>%
                      </span>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                <% end %>
                <td class="text-center">
                  <% conf = d.confiance_ocr.to_f %>
                  <span class="badge <%= conf >= 75 ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>
                               border border-<%= conf >= 75 ? 'success' : 'warning' %>-subtle"
                        style="font-size:0.65rem;">
                    <%= conf.round %>%
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
          <% if tous_devis.size > 1 && montants.size > 1 %>
            <tfoot style="background:#f8f9fa;">
              <tr>
                <td class="text-muted py-2" style="font-size:0.72rem;">
                  Écart min/max
                </td>
                <td colspan="<%= montant_estimatif.to_f > 0 ? 6 : 5 %>" class="text-end fw-semibold py-2">
                  <% ecart_abs = max_montant - min_montant %>
                  <% ecart_rel = (ecart_abs / min_montant * 100).round(1) %>
                  <span class="<%= ecart_rel > 20 ? 'text-danger' : 'text-muted' %>">
                    <%= number_to_currency(ecart_abs, unit: '', separator: ',', delimiter: '.', precision: 0) %> €
                    (<%= ecart_rel %>%)
                  </span>
                </td>
              </tr>
            </tfoot>
          <% end %>
        </table>
      </div>

    <% else %>
      <div class="text-center py-3 text-muted" style="font-size:0.82rem;">
        <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
        Aucun devis uploadé — importez les PDFs reçus par email pour les comparer
      </div>
    <% end %>
  </div>
</div>

<script>
document.getElementById('devis-scan-btn')?.addEventListener('click', function() {
  const form     = document.getElementById('devis-comparateur-upload-form');
  const fileInput = document.getElementById('devis-upload-file');
  const status   = document.getElementById('devis-scan-status');
  const btn      = this;

  if (!fileInput.files[0]) {
    status.style.display = 'block';
    status.className = 'mt-2 text-warning';
    status.textContent = 'Veuillez sélectionner un fichier.';
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Analyse OCR…';
  status.style.display = 'block';
  status.className = 'mt-2 text-muted';
  status.textContent = 'Extraction en cours (5-15 sec)…';

  const formData = new FormData();
  formData.append('file', fileInput.files[0]);
  formData.append('project_id', form.dataset.projectId);
  formData.append('categorie_emetteur', 'entrepreneur');

  fetch('<%= ocr_scan_devis_path %>', {
    method: 'POST',
    headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
    body: formData
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      status.className = 'mt-2 text-success';
      status.innerHTML = `✓ ${data.message || 'Devis analysé'} — <strong>${data.nom_entreprise || 'Entreprise'}</strong> : ${data.montant_htva ? data.montant_htva.toLocaleString('fr-BE') + ' € HTVA' : 'montant non extrait'} (confiance ${data.confiance_extraction?.toFixed(0) ?? '?'}%)`;
      setTimeout(() => window.location.reload(), 1500);
    } else {
      status.className = 'mt-2 text-danger';
      status.textContent = 'Erreur : ' + (data.error || 'Extraction échouée');
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-magic me-1"></i>Analyser';
    }
  })
  .catch(() => {
    status.className = 'mt-2 text-danger';
    status.textContent = 'Erreur réseau — réessayez.';
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-magic me-1"></i>Analyser';
  });
});
</script>
