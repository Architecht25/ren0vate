<%# Documents de permis — permis officiel + plans signés/cachetés de l'urbanisme %>
<% permis_docs = @project.documents.where(type_document: 'permis_urbanisme').order(created_at: :desc) %>
<% plans_urbanisme_docs = @project.documents.where(type_document: 'plan_urbanisme_signe').order(created_at: :desc) %>

<div class="card border-0 shadow-sm rounded-4 h-100">
  <div class="card-header border-0 py-3 px-4 d-flex align-items-center"
       style="background:linear-gradient(135deg,#1e293b,#334155); border-radius: 1rem 1rem 0 0 !important;">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-folder2-open text-white fs-5"></i>
      <div>
        <span class="fw-semibold text-white">Documents de permis</span>
        <div class="text-white opacity-75" style="font-size:0.75rem;">Permis et plans cachetés de l'urbanisme</div>
      </div>
    </div>
  </div>

  <div class="card-body p-3">

    <%# ── Section Documents permis ── %>
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="d-flex align-items-center gap-2">
        <% if permis_docs.any? %>
          <span class="badge rounded-circle p-1 bg-success d-flex align-items-center justify-content-center" style="width:18px;height:18px;">
            <i class="bi bi-check2" style="font-size:0.6rem;"></i>
          </span>
        <% else %>
          <span class="badge rounded-circle p-1 bg-warning d-flex align-items-center justify-content-center" style="width:18px;height:18px;">
            <i class="bi bi-exclamation" style="font-size:0.6rem;"></i>
          </span>
        <% end %>
        <span class="fw-semibold" style="font-size:0.85rem;">Document(s) permis</span>
        <% if permis_docs.any? %>
          <span class="badge bg-success-subtle text-success rounded-3" style="font-size:0.68rem;"><%= permis_docs.count %> doc<%= permis_docs.count > 1 ? 's' : '' %></span>
        <% end %>
      </div>
      <%= link_to new_project_document_path(@project, type_document: 'permis_urbanisme'), class: "btn btn-sm btn-outline-secondary rounded-3 py-0 px-2" do %>
        <i class="bi bi-plus me-1"></i><span style="font-size:0.75rem;">Ajouter</span>
      <% end %>
    </div>

    <% if permis_docs.any? %>
      <div class="row g-1 mb-2">
        <% permis_docs.first(4).each do |doc| %>
          <div class="col-4 col-sm-3">
            <%= render 'projects/partials_general/doc_thumbnail', doc: doc, color: 'secondary' %>
          </div>
        <% end %>
      </div>
      <% if permis_docs.count > 4 %>
        <%= link_to project_documents_path(@project, type_document: 'permis_urbanisme'), class: "btn btn-sm btn-outline-secondary w-100 mb-2", style: "font-size:0.78rem;" do %>
          <i class="bi bi-folder2-open me-1"></i>Voir tous (<%= permis_docs.count %>)
        <% end %>
      <% end %>
    <% else %>
      <div class="d-flex flex-column align-items-center justify-content-center py-3 mb-2 rounded-3"
           style="background:rgba(0,0,0,0.03); min-height:80px;">
        <i class="bi bi-file-earmark-text text-muted mb-1" style="font-size:1.4rem;"></i>
        <p class="text-muted mb-0" style="font-size:0.78rem;">Aucun document de permis</p>
      </div>
    <% end %>

    <hr class="my-3">

    <%# ── Section Plans signés/cachetés de l'urbanisme ── %>
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div class="d-flex align-items-center gap-2">
        <% if plans_urbanisme_docs.any? %>
          <span class="badge rounded-circle p-1 bg-success d-flex align-items-center justify-content-center" style="width:18px;height:18px;">
            <i class="bi bi-check2" style="font-size:0.6rem;"></i>
          </span>
        <% else %>
          <span class="badge rounded-circle p-1 bg-warning d-flex align-items-center justify-content-center" style="width:18px;height:18px;">
            <i class="bi bi-exclamation" style="font-size:0.6rem;"></i>
          </span>
        <% end %>
        <span class="fw-semibold" style="font-size:0.85rem;">Plans cachetés urbanisme</span>
        <% if plans_urbanisme_docs.any? %>
          <span class="badge bg-info-subtle text-info rounded-3" style="font-size:0.68rem;"><%= plans_urbanisme_docs.count %> plan<%= plans_urbanisme_docs.count > 1 ? 's' : '' %></span>
        <% end %>
      </div>
      <%= link_to new_project_document_path(@project, type_document: 'plan_urbanisme_signe'), class: "btn btn-sm btn-outline-info rounded-3 py-0 px-2" do %>
        <i class="bi bi-plus me-1"></i><span style="font-size:0.75rem;">Ajouter</span>
      <% end %>
    </div>

    <% if plans_urbanisme_docs.any? %>
      <div class="row g-1 mb-2">
        <% plans_urbanisme_docs.first(4).each do |doc| %>
          <div class="col-4 col-sm-3">
            <%= render 'projects/partials_general/doc_thumbnail', doc: doc, color: 'info' %>
          </div>
        <% end %>
      </div>
      <% if plans_urbanisme_docs.count > 4 %>
        <%= link_to project_documents_path(@project, type_document: 'plan_urbanisme_signe'), class: "btn btn-sm btn-outline-info w-100", style: "font-size:0.78rem;" do %>
          <i class="bi bi-folder2-open me-1"></i>Voir tous (<%= plans_urbanisme_docs.count %>)
        <% end %>
      <% end %>
    <% else %>
      <div class="d-flex flex-column align-items-center justify-content-center py-3 rounded-3"
           style="background:rgba(0,0,0,0.03); min-height:80px;">
        <i class="bi bi-file-earmark-ruled text-muted mb-1" style="font-size:1.4rem;"></i>
        <p class="text-muted mb-0" style="font-size:0.78rem;">Aucun plan cacheté de l'urbanisme</p>
      </div>
    <% end %>

  </div>
</div>
