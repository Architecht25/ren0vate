<%# Partial : _invite_pros.html.erb %>
<%# Affiche la section d'invitation et la liste des membres invités/actifs %>
<%# Utilisé uniquement pour le propriétaire du projet %>

<% members = project.project_members.includes(:user).order(:role, :created_at) %>

<div class="card border border-2 rounded-3 mb-3" style="border-color: #dee2e6 !important;">
  <div class="card-header bg-white border-bottom-0 pt-3 pb-0 px-4">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <div class="rounded-circle d-flex align-items-center justify-content-center"
             style="width:38px;height:38px;background:linear-gradient(135deg,#0d6efd,#6610f2);">
          <i class="bi bi-send text-white" style="font-size:0.9rem;"></i>
        </div>
        <h5 class="mb-0 fw-semibold" style="font-size:1rem;">Inviter des professionnels</h5>
      </div>
      <button class="btn btn-sm btn-outline-primary" type="button"
              data-bs-toggle="collapse" data-bs-target="#invite-form-<%= project.id %>">
        <i class="bi bi-plus-lg me-1"></i>Nouvelle invitation
      </button>
    </div>
  </div>

  <div class="card-body px-4 pt-3 pb-4">

    <%# ─── Formulaire d'invitation (collapsible) ───── %>
    <div class="collapse mb-3" id="invite-form-<%= project.id %>">
      <div class="bg-light rounded-3 p-3">
        <%= form_with url: invite_project_path(project), method: :post, class: "row g-2 align-items-end" do |f| %>
          <div class="col-md-5">
            <%= label_tag :email, "Email du professionnel", class: "form-label fw-medium", style: "font-size:0.85rem;" %>
            <%= email_field_tag :email, nil,
                  class: "form-control form-control-sm",
                  placeholder: "pro@exemple.be",
                  required: true %>
          </div>
          <div class="col-md-4">
            <%= label_tag :role, "Rôle", class: "form-label fw-medium", style: "font-size:0.85rem;" %>
            <%= select_tag :role,
                  options_for_select([
                    ["🔨 Entrepreneur", "entrepreneur"],
                    ["🏛️ Architecte",   "architect"]
                  ]),
                  class: "form-select form-select-sm" %>
          </div>
          <div class="col-md-3">
            <%= f.submit "Envoyer l'invitation",
                  class: "btn btn-primary btn-sm w-100",
                  style: "font-size:0.82rem;" %>
          </div>
        <% end %>
        <p class="text-muted mt-2 mb-0" style="font-size:0.78rem;">
          <i class="bi bi-info-circle me-1"></i>
          Un email avec un lien sécurisé (valable 7 jours) sera envoyé au professionnel.
        </p>
      </div>
    </div>

    <%# ─── Liste des membres ───── %>
    <% if members.any? %>
      <div class="table-responsive">
        <table class="table table-sm mb-0" style="font-size:0.85rem;">
          <thead>
            <tr class="text-muted" style="font-size:0.78rem;">
              <th class="fw-normal ps-0">Professionnel</th>
              <th class="fw-normal">Rôle</th>
              <th class="fw-normal">Statut</th>
              <th class="fw-normal">Invité le</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% members.each do |member| %>
              <tr class="align-middle">
                <td class="ps-0">
                  <div class="fw-medium">
                    <% if member.user.first_name.present? %>
                      <%= member.user.full_name %>
                    <% else %>
                      <span class="text-muted"><%= member.invited_email %></span>
                    <% end %>
                  </div>
                  <div class="text-muted" style="font-size:0.75rem;"><%= member.invited_email %></div>
                </td>
                <td>
                  <% badge_color = member.role == 'entrepreneur' ? 'warning' : 'info' %>
                  <span class="badge bg-<%= badge_color %>-subtle text-<%= badge_color %>-emphasis fw-normal">
                    <%= member.role == 'entrepreneur' ? '🔨' : '🏛️' %> <%= member.role_label %>
                  </span>
                </td>
                <td>
                  <% if member.active? %>
                    <span class="badge bg-success-subtle text-success-emphasis fw-normal">
                      <i class="bi bi-check-circle me-1"></i>Actif
                    </span>
                  <% elsif member.expired? %>
                    <span class="badge bg-danger-subtle text-danger-emphasis fw-normal">
                      <i class="bi bi-clock-history me-1"></i>Expiré
                    </span>
                  <% else %>
                    <span class="badge bg-warning-subtle text-warning-emphasis fw-normal">
                      <i class="bi bi-hourglass-split me-1"></i>En attente
                    </span>
                  <% end %>
                </td>
                <td class="text-muted">
                  <%= member.invite_sent_at&.strftime("%d/%m/%y") || "—" %>
                </td>
                <td class="text-end">
                  <%= button_to remove_member_project_path(project, member_id: member.id),
                        method: :delete,
                        form: { data: { turbo_confirm: "Retirer #{member.role_label} du projet ?" } },
                        class: "btn btn-sm btn-outline-danger py-0 px-2",
                        style: "font-size:0.75rem;" do %>
                    <i class="bi bi-person-dash"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0" style="font-size:0.85rem;">
        <i class="bi bi-people me-1"></i>
        Aucun professionnel invité pour l'instant. Invitez un entrepreneur ou un architecte ci-dessus.
      </p>
    <% end %>

  </div>
</div>
