<%# Card Bordereaux d'avancement IA — suivi structuré par thématique %>
<% etats = @project.etats_avancement.chronologique.includes(:lignes) %>
<% dernier_approuve = etats.approuves.last %>

<div class="card border-0 shadow-sm rounded-4">
  <div class="card-header border-0 py-3 px-4 d-flex align-items-center justify-content-between"
       style="background:linear-gradient(135deg,#0f172a,#1e3a5f); border-radius: 1rem 1rem 0 0 !important;">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-receipt-cutoff text-white fs-5"></i>
      <span class="fw-semibold text-white">Bordereaux d'avancement</span>
      <% if etats.any? %>
        <span class="badge rounded-pill" style="background:rgba(255,255,255,0.2);color:#fff;font-size:0.7rem;">
          <%= etats.count %>
        </span>
      <% end %>
    </div>
    <%= link_to new_project_etats_avancement_path(@project),
                class: "btn btn-sm rounded-3 d-flex align-items-center gap-1",
                style: "background:var(--ren0vate-accent);color:#fff;border:none;font-size:0.75rem;" do %>
      <i class="bi bi-stars"></i><span class="d-none d-sm-inline">Créer avec l'IA</span>
    <% end %>
  </div>

  <div class="card-body p-3">
    <% if dernier_approuve %>
      <div class="d-flex align-items-center gap-3 p-2 rounded-3 mb-3"
           style="background:rgba(25,135,84,0.07);">
        <i class="bi bi-patch-check-fill text-success fs-5 flex-shrink-0"></i>
        <div>
          <div class="small fw-semibold text-success">Dernier approuvé : État n°<%= dernier_approuve.numero %></div>
          <div class="text-muted" style="font-size:0.75rem;">
            <%= number_to_currency(dernier_approuve.montant_cumule_actuel, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %> cumulé
            · approuvé le <%= dernier_approuve.approuve_at&.strftime("%d/%m/%Y") %>
          </div>
        </div>
      </div>
    <% end %>

    <% if etats.any? %>
      <% etats.last(4).reverse.each do |etat| %>
        <div class="d-flex align-items-center gap-2 py-2 border-bottom">
          <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-white fw-bold"
               style="width:28px;height:28px;background:var(--ren0vate-navy);font-size:0.72rem;">
            <%= etat.numero %>
          </div>
          <div class="flex-grow-1 overflow-hidden">
            <div class="d-flex align-items-center gap-1 flex-wrap">
              <span class="fw-medium" style="font-size:0.82rem;">État n°<%= etat.numero %></span>
              <span class="badge rounded-pill bg-<%= etat.statut_color %>" style="font-size:0.62rem;">
                <%= etat.statut_label %>
              </span>
              <% if etat.genere_par_ia %>
                <span class="badge rounded-pill" style="background:rgba(79,70,229,0.1);color:#4f46e5;font-size:0.62rem;">
                  <i class="bi bi-stars"></i>
                </span>
              <% end %>
            </div>
            <div class="text-muted" style="font-size:0.72rem;">
              <%= etat.date_emission&.strftime("%d/%m/%Y") || etat.created_at.strftime("%d/%m/%Y") %>
              · <%= etat.lignes.count %> postes · <%= etat.avancement_global_pct %>%
            </div>
            <!-- mini barre -->
            <div style="height:3px;background:#e9ecef;border-radius:3px;overflow:hidden;margin-top:3px;">
              <div style="height:100%;width:<%= etat.avancement_global_pct %>%;background:var(--ren0vate-accent);border-radius:3px;"></div>
            </div>
          </div>
          <div class="flex-shrink-0 text-end">
            <div class="fw-bold" style="font-size:0.82rem;color:var(--ren0vate-accent);">
              <%= number_to_currency(etat.montant_reclame_periode, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %>
            </div>
            <%= link_to project_etats_avancement_path(@project, etat), class: "btn btn-sm btn-outline-secondary rounded-3 mt-1", style: "font-size:0.65rem;padding:1px 6px;" do %>
              <i class="bi bi-eye"></i>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="d-flex justify-content-between align-items-center mt-2">
        <%= link_to project_etats_avancement_index_path(@project), class: "btn btn-sm btn-outline-secondary rounded-3 w-100", style: "font-size:0.78rem;" do %>
          <i class="bi bi-folder2-open me-1"></i>Tous les états (<%= etats.count %>)
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4">
        <i class="bi bi-receipt-cutoff fs-3 text-muted d-block mb-2"></i>
        <p class="text-muted small mb-3">
          Aucun bordereau d'avancement.<br>
          L'IA analyse le devis et propose une structure par thématique.
        </p>
        <%= link_to new_project_etats_avancement_path(@project),
                    class: "btn btn-sm rounded-3",
                    style: "background:var(--ren0vate-accent);color:#fff;border:none;" do %>
          <i class="bi bi-stars me-1"></i>Générer le premier état
        <% end %>
      </div>
    <% end %>
  </div>
</div>
