<%# Carnet de bord du chantier — journal horodaté, accessible à l'IA %>
<% _project = local_assigns.fetch(:project, @project) %>
<% _tab     = local_assigns.fetch(:tab, 'suivi') %>
<% _notes   = _project.project_notes %>

<div class="card border-0 shadow-sm rounded-4">

  <!-- En-tête -->
  <div class="card-header border-0 rounded-top-4 d-flex align-items-center justify-content-between py-3 px-4"
       style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-journal-text text-white fs-5"></i>
      <span class="fw-semibold text-white">Carnet de bord</span>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge rounded-pill d-flex align-items-center gap-1"
            style="background:rgba(99,202,183,0.2); color:#63cab7; border:1px solid rgba(99,202,183,0.3); font-size:0.7rem;">
        <i class="bi bi-stars" style="font-size:0.75rem;"></i> Lu par l'IA
      </span>
      <span class="badge rounded-pill"
            style="background:rgba(255,255,255,0.12); color:rgba(255,255,255,0.8); font-size:0.7rem;">
        <%= _notes.count %> note<%= _notes.count > 1 ? 's' : '' %>
      </span>
    </div>
  </div>

  <div class="card-body p-4">

    <!-- Formulaire d'ajout -->
    <%= form_with model: [_project, ProjectNote.new],
                  html: { class: 'mb-4' },
                  data: { turbo: false } do |f| %>
      <%= hidden_field_tag :tab, _tab %>
      <div class="mb-2">
        <%= f.text_area :content,
              placeholder: "Remarque, question, décision prise… votre IA s'en souviendra.",
              class: "form-control rounded-3",
              rows: 3,
              maxlength: 2000,
              style: "resize:vertical; font-size:0.9rem; border-color: rgba(15,23,42,0.2);" %>
      </div>
      <div class="d-flex align-items-center justify-content-between">
        <small style="color:var(--ren0vate-text-muted); font-size:0.78rem;">
          <i class="bi bi-info-circle me-1"></i>Vos notes enrichissent les réponses de l'IA sur ce chantier.
        </small>
        <%= f.submit "Ajouter",
              class: "btn btn-sm fw-semibold px-3",
              style: "background:#1e3a5f; color:white; border:none;" %>
      </div>
    <% end %>

    <!-- Journal des entrées -->
    <% if _notes.any? %>
      <div class="d-flex flex-column gap-2" id="carnet-notes-list">
        <% _notes.each do |note| %>
          <div class="rounded-3 p-3 position-relative" id="note-<%= note.id %>"
               style="background:rgba(15,23,42,0.04); border-left:3px solid rgba(15,23,42,0.15);">
            <div class="d-flex align-items-start justify-content-between gap-2">
              <p class="mb-1" style="font-size:0.875rem; color:var(--ren0vate-text-secondary); white-space:pre-wrap;"><%= note.content %></p>
              <%= button_to project_project_note_path(_project, note),
                    method: :delete,
                    params: { tab: _tab },
                    data: { turbo: false, confirm: "Supprimer cette note ?" },
                    class: "btn btn-sm p-0 flex-shrink-0",
                    style: "color:rgba(0,0,0,0.25); background:none; border:none; line-height:1;" do %>
                <i class="bi bi-x-lg" style="font-size:0.8rem;"></i>
              <% end %>
            </div>
            <small style="color:var(--ren0vate-text-muted); font-size:0.75rem;">
              <i class="bi bi-clock me-1"></i><%= note.created_at.strftime('%d/%m/%Y à %H:%M') %>
            </small>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-4" style="color:var(--ren0vate-text-muted);">
        <i class="bi bi-journal-plus d-block mb-2" style="font-size:1.8rem; opacity:0.4;"></i>
        <small>Aucune note pour l'instant. Commencez à documenter votre chantier.</small>
      </div>
    <% end %>

  </div>
</div>
