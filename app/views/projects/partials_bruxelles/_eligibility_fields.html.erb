<!-- Champs spécifiques pour l'éligibilité aux primes Bruxelles -->
<div class="mb-4 mt-4" id="bruxelles-fields">
  <h6 class="text-primary-custom mb-3">
    <i class="bi bi-award me-2"></i>Informations pour l'éligibilité aux primes (Bruxelles)
  </h6>
  <div class="border rounded p-4 bg-light">

    <!-- Section Permis d'urbanisme -->
    <div class="mb-4">
      <h6 class="text-primary mb-3">
        <i class="bi bi-file-text me-2"></i>Permis d'urbanisme
      </h6>
      <div class="row">
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :permis_urbanisme_number, "Numéro de permis d'urbanisme", class: "form-label" %>
            <%= form.text_field :permis_urbanisme_number, class: "form-control", placeholder: "Ex: PU-2024-001" %>
            <div class="form-text">Si applicable selon le type de travaux</div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="mb-3">
            <%= form.label :permis_urbanisme_date, "Date d'octroi du permis", class: "form-label" %>
            <%= form.date_field :permis_urbanisme_date, class: "form-control" %>
            <div class="form-text">Date d'obtention du permis d'urbanisme</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section Usage professionnel -->
    <div class="mb-4">
      <h6 class="text-primary mb-3">
        <i class="bi bi-briefcase me-2"></i>Usage professionnel
      </h6>
      <div class="row align-items-end">
        <div class="col-md-4">
          <div class="mb-3">
            <%= form.check_box :usage_professionnel, class: "form-check-input me-2" %>
            <%= form.label :usage_professionnel, "Usage professionnel du bien", class: "form-check-label" %>
          </div>
        </div>
        <div class="col-md-4" id="surface-totale-field" style="display: none;">
          <div class="mb-3">
            <%= form.label :surface_totale, "Surface totale (m²)", class: "form-label" %>
            <%= form.number_field :surface_totale, class: "form-control", placeholder: "Ex: 120", min: "1" %>
          </div>
        </div>
        <div class="col-md-4" id="surface-professionnelle-field" style="display: none;">
          <div class="mb-3">
            <%= form.label :surface_professionnelle, "Surface professionnelle (m²)", class: "form-label" %>
            <%= form.number_field :surface_professionnelle, class: "form-control", placeholder: "Ex: 30", min: "0" %>
          </div>
        </div>
      </div>
    </div>

    <div class="alert alert-info small mb-0">
      <i class="bi bi-info-circle me-2"></i>
      Ces informations sont nécessaires pour vérifier l'éligibilité aux primes RENOLUTION en Région de Bruxelles-Capitale.
      Les champs marqués d'un * sont obligatoires.
    </div>
  </div>
</div>

<script>
  // Afficher/masquer les champs de surface selon l'usage professionnel
  document.addEventListener('DOMContentLoaded', function() {
    const usageProfessionnel = document.getElementById('project_usage_professionnel');
    const surfaceTotaleField = document.getElementById('surface-totale-field');
    const surfaceProfessionnelleField = document.getElementById('surface-professionnelle-field');

    if (usageProfessionnel && surfaceTotaleField && surfaceProfessionnelleField) {
      usageProfessionnel.addEventListener('change', function() {
        if (this.checked) {
          surfaceTotaleField.style.display = 'block';
          surfaceProfessionnelleField.style.display = 'block';
        } else {
          surfaceTotaleField.style.display = 'none';
          surfaceProfessionnelleField.style.display = 'none';
        }
      });

      // Vérifier l'état initial
      if (usageProfessionnel.checked) {
        surfaceTotaleField.style.display = 'block';
        surfaceProfessionnelleField.style.display = 'block';
      }
    }
  });
</script>
