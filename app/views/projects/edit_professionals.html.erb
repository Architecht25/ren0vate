<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-people"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Équipe projet & Professionnels</h1>
    </div>
    <div>
      <%= link_to project_path(@project), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-10">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <%= form_with model: @project, url: update_professionals_project_path(@project), method: :patch, local: true do |form| %>
            <%= render 'projects/partials_general/professionals_fields', form: form %>

            <div class="d-flex justify-content-end mt-4">
              <%= link_to "Annuler", project_path(@project), class: "btn btn-outline-secondary me-2" %>
              <%= form.submit "Enregistrer", class: "btn btn-primary-custom" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
