<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Test Email Simple</title>
</head>
<body>
  <h1>Test Email - Résultats localStorage</h1>

  <p>Email envoyé à: <%= @email %></p>

  <h2>Données reçues:</h2>
  <ul>
    <% @localStorage_data.each do |key, value| %>
      <li><strong><%= key %>:</strong> <%= value %></li>
    <% end %>
  </ul>

  <p>Email généré le <%= Time.current %></p>
</body>
</html>
