<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Résultats de votre simulation rénovation énergétique</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
      background-color: #f8f9fa;
    }
    .header {
      background: linear-gradient(135deg, #28a745, #20c997);
      color: white;
      padding: 30px;
      text-align: center;
      border-radius: 10px 10px 0 0;
    }
    .content {
      background: white;
      padding: 30px;
      border-radius: 0 0 10px 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }
    .section {
      margin-bottom: 25px;
      padding: 15px;
      border-left: 4px solid #28a745;
      background-color: #f8f9fa;
    }
    .section h3 {
      margin-top: 0;
      color: #28a745;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin: 15px 0;
    }
    .data-table th,
    .data-table td {
      padding: 12px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    .data-table th {
      background-color: #28a745;
      color: white;
      font-weight: bold;
    }
    .data-table tr:nth-child(even) {
      background-color: #f2f2f2;
    }
    .badge {
      display: inline-block;
      padding: 4px 8px;
      background-color: #6c757d;
      color: white;
      border-radius: 4px;
      font-size: 0.875em;
      margin-right: 5px;
    }
    .value {
      font-weight: bold;
      color: #28a745;
    }
    .footer {
      text-align: center;
      margin-top: 30px;
      padding: 20px;
      color: #6c757d;
      font-size: 0.9em;
    }
    .prime-details {
      background-color: #e8f5e8;
      padding: 15px;
      border-radius: 5px;
      margin: 10px 0;
    }
    .prime-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid #c3e6c3;
    }
    .prime-item:last-child {
      border-bottom: none;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>🏠 Résultats de votre simulation</h1>
    <p>Rénovation énergétique - Analyse complète</p>
  </div>

  <div class="content">
    <p>Bonjour,</p>
    <p>Voici les résultats détaillés de votre simulation de rénovation énergétique :</p>

    <% if @parsed_data['region'] %>
    <div class="section">
      <h3>📍 Informations géographiques</h3>
      <p><strong>Région :</strong> <span class="value"><%= @parsed_data['region'] %></span></p>
    </div>
    <% end %>

    <% if @parsed_data['user-type'] %>
    <div class="section">
      <h3>👤 Profil utilisateur</h3>
      <p><strong>Type d'utilisateur :</strong> <span class="value"><%= @parsed_data['user-type'] %></span></p>
    </div>
    <% end %>

    <% if @parsed_data['categorie_estimee'] || @parsed_data['statut_familial'] || @parsed_data['personnes_charge'] || @parsed_data['revenu_net'] %>
    <div class="section">
      <h3>👨‍👩‍👧‍👦 Situation familiale et revenus</h3>
      <table class="data-table">
        <% if @parsed_data['categorie_estimee'] %>
        <tr>
          <td><strong>Catégorie estimée</strong></td>
          <td class="value"><%= @parsed_data['categorie_estimee'] %></td>
        </tr>
        <% end %>
        <% if @parsed_data['statut_familial'] %>
        <tr>
          <td><strong>Statut familial</strong></td>
          <td class="value"><%= @parsed_data['statut_familial'] %></td>
        </tr>
        <% end %>
        <% if @parsed_data['personnes_charge'] %>
        <tr>
          <td><strong>Personnes à charge</strong></td>
          <td class="value"><%= @parsed_data['personnes_charge'] %></td>
        </tr>
        <% end %>
        <% if @parsed_data['revenu_net'] %>
        <tr>
          <td><strong>Revenu net</strong></td>
          <td class="value"><%= @parsed_data['revenu_net'] %> €</td>
        </tr>
        <% end %>
      </table>
    </div>
    <% end %>

    <% if @parsed_data['eligibiliteRenovate'] %>
    <div class="section">
      <h3>✅ Éligibilité aux primes</h3>
      <div class="prime-details">
        <% @parsed_data['eligibiliteRenovate'].each do |key, value| %>
          <div class="prime-item">
            <span class="badge"><%= key.to_s.tr('_', ' ').capitalize %></span>
            <span class="value"><%= value %></span>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <% if @parsed_data['total_primes'] %>
    <div class="section">
      <h3>💰 Total des primes</h3>
      <p style="font-size: 1.2em; text-align: center; background-color: #28a745; color: white; padding: 15px; border-radius: 5px;">
        <strong><%= @parsed_data['total_primes'] %> €</strong>
      </p>
    </div>
    <% end %>

    <% if @parsed_data['details_primes'] %>
    <div class="section">
      <h3>🔍 Détail des primes par type</h3>
      <div class="prime-details">
        <% @parsed_data['details_primes'].each do |key, value| %>
          <div class="prime-item">
            <span class="badge"><%= key.to_s.tr('_', ' ').capitalize %></span>
            <span class="value"><%= value %> €</span>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <% if @parsed_data['categorie_badge'] %>
    <div class="section">
      <h3>🏷️ Catégorie finale</h3>
      <p><strong>Badge attribué :</strong> <span class="value"><%= @parsed_data['categorie_badge'] %></span></p>
    </div>
    <% end %>

    <div class="section">
      <h3>📋 Données techniques complètes</h3>
      <table class="data-table">
        <thead>
          <tr>
            <th>Paramètre</th>
            <th>Valeur</th>
          </tr>
        </thead>
        <tbody>
          <% @localStorage_data.each do |key, value| %>
          <tr>
            <td><%= key.to_s.tr('_', ' ').capitalize %></td>
            <td>
              <% if key == 'eligibiliteRenovate' || key == 'details_primes' %>
                <% begin %>
                  <% parsed = JSON.parse(value) %>
                  <% parsed.each do |k, v| %>
                    <span class="badge"><%= k %></span> <%= v %><br>
                  <% end %>
                <% rescue JSON::ParserError %>
                  <%= value %>
                <% end %>
              <% else %>
                <%= value %>
              <% end %>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <p>Ces résultats sont basés sur les informations que vous avez fournies lors de votre simulation. Pour obtenir des informations plus précises ou démarrer vos démarches, n'hésitez pas à contacter nos conseillers.</p>
  </div>

  <div class="footer">
    <p>© 2025 Rénovation Énergétique - Tous droits réservés</p>
    <p>Cet email a été généré automatiquement suite à votre simulation en ligne.</p>
  </div>
</body>
</html>
