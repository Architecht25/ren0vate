<div class="auth-container">
  <div class="row justify-content-center">
    <div class="col-auto" style="min-width: 280px; max-width: 350px;">
      <div class="auth-card">
        <!-- Header avec logo -->
        <div class="auth-header text-center mb-4">
          <div class="auth-logo mb-3">
            <i class="bi bi-key-fill text-primary-custom" style="font-size: 3rem;"></i>
          </div>
          <h2 class="auth-title">Nouveau mot de passe</h2>
          <p class="auth-subtitle text-muted">Choisissez un mot de passe sécurisé</p>
        </div>

        <!-- Formulaire -->
        <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
          <%= f.error_notification %>

          <%= f.input :reset_password_token, as: :hidden %>
          <%= f.full_error :reset_password_token %>

          <div class="form-group mb-3">
            <%= f.input :password,
                        label: "Nouveau mot de passe",
                        required: true,
                        autofocus: true,
                        hint: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length),
                        input_html: {
                          class: "form-control form-control-lg",
                          autocomplete: "new-password",
                          placeholder: "Choisissez un mot de passe sécurisé"
                        },
                        label_html: { class: "form-label fw-semibold" } %>
          </div>

          <div class="form-group mb-4">
            <%= f.input :password_confirmation,
                        label: "Confirmer le nouveau mot de passe",
                        required: true,
                        input_html: {
                          class: "form-control form-control-lg",
                          autocomplete: "new-password",
                          placeholder: "Répétez votre nouveau mot de passe"
                        },
                        label_html: { class: "form-label fw-semibold" } %>
          </div>

          <div class="form-actions mb-4">
            <%= f.button :submit, "Changer mon mot de passe",
                         class: "btn btn-primary-custom btn-lg w-100 d-flex align-items-center justify-content-center" do %>
              <i class="bi bi-shield-check me-2"></i>
              Changer mon mot de passe
            <% end %>
          </div>
        <% end %>

        <!-- Liens -->
        <div class="auth-links text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
