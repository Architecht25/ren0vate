<h2 class="text-center mb-4">Inscription</h2>

<div class="container mt-5">
  <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form-horizontal" }) do |f| %>
    <%= f.error_notification %>

    <div class="form-group w-50 mx-auto">
      <%= f.input :email,
                  required: true,
                  autofocus: true,
                  input_html: { class: "form-control", autocomplete: "email" },
                  label_html: { class: "form-label" } %>
    </div>

    <div class="form-group w-50 mx-auto">
      <%= f.input :password,
                  required: true,
                  hint: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length),
                  input_html: { class: "form-control", autocomplete: "new-password" },
                  label_html: { class: "form-label" } %>
    </div>

    <div class="form-group w-50 mx-auto">
      <%= f.input :password_confirmation,
                  required: true,
                  input_html: { class: "form-control", autocomplete: "new-password" },
                  label_html: { class: "form-label" } %>
    </div>

    <div class="form-actions text-center mt-4">
      <%= f.button :submit, "S'inscrire", class: "btn btn-primary" %>
    </div>
  <% end %>

  <div class="text-center mt-3">
    <%= render "devise/shared/links" %>
  </div>
</div>
