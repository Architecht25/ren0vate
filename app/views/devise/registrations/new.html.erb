<div class="auth-container">
  <div class="row justify-content-center">
    <div class="col-auto" style="min-width: 320px; max-width: 400px;">
      <div class="auth-card">
        <!-- Header avec logo -->
        <div class="auth-header text-center mb-4">
          <div class="auth-logo mb-3">
            <i class="bi bi-house-heart-fill text-primary-custom" style="font-size: 3rem;"></i>
          </div>
          <h2 class="auth-title">Rejoignez Ren0vate</h2>
          <p class="auth-subtitle text-muted">Créez votre compte pour commencer</p>

          <!-- Notification temporaire -->
          <div class="alert alert-success alert-sm mt-3" style="font-size: 0.9rem;">
            <i class="bi bi-check-circle me-2"></i>
            <strong>Info :</strong> Votre compte sera activé immédiatement après création.
          </div>
        </div>

        <!-- Formulaire -->
        <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
          <%= f.error_notification %>

          <div class="form-group mb-3">
            <%= f.input :email,
                        required: true,
                        autofocus: true,
                        label: "Email",
                        input_html: {
                          class: "form-control",
                          autocomplete: "email",
                          placeholder: "votre.email@exemple.com"
                        },
                        label_html: { class: "form-label fw-semibold" } %>
          </div>

          <div class="form-group mb-3">
            <label for="user_password" class="form-label fw-semibold">Mot de passe</label>
            <% if @minimum_password_length %>
              <small class="form-text text-muted d-block mb-2"><%= @minimum_password_length %> caractères minimum</small>
            <% end %>
            <div class="input-group">
              <%= f.password_field :password,
                                   class: "form-control",
                                   autocomplete: "new-password",
                                   placeholder: "Choisissez un mot de passe sécurisé",
                                   id: "user_password",
                                   required: true %>
              <button type="button" class="btn btn-outline-secondary password-toggle-btn" aria-label="Afficher/masquer le mot de passe">
                <i class="bi bi-eye" data-show-icon="bi-eye" data-hide-icon="bi-eye-slash"></i>
              </button>
            </div>
          </div>

          <div class="form-group mb-4">
            <label for="user_password_confirmation" class="form-label fw-semibold">Confirmer le mot de passe</label>
            <div class="input-group">
              <%= f.password_field :password_confirmation,
                                   class: "form-control",
                                   autocomplete: "new-password",
                                   placeholder: "Répétez votre mot de passe",
                                   id: "user_password_confirmation",
                                   required: true %>
              <button type="button" class="btn btn-outline-secondary password-toggle-btn" aria-label="Afficher/masquer le mot de passe">
                <i class="bi bi-eye" data-show-icon="bi-eye" data-hide-icon="bi-eye-slash"></i>
              </button>
            </div>
          </div>

          <div class="form-actions mb-4">
            <%= f.button :submit, "Créer mon compte",
                         class: "btn btn-primary-custom btn-lg w-100 d-flex align-items-center justify-content-center" do %>
              <i class="bi bi-person-plus-fill me-2"></i>
              Créer mon compte
            <% end %>
          </div>
        <% end %>

        <!-- Liens -->
        <div class="auth-links text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
