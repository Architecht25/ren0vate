<div class="auth-container">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-auto" style="max-width: 350px;">
      <div class="auth-card">
        <!-- Header avec logo -->
        <div class="auth-header text-center mb-4">
          <div class="auth-logo mb-3">
            <i class="bi bi-unlock-fill text-primary-custom" style="font-size: 3rem;"></i>
          </div>
          <h2 class="auth-title">Déverrouiller le compte</h2>
          <p class="auth-subtitle text-muted">Recevez un lien pour déverrouiller votre compte</p>
        </div>

        <!-- Formulaire -->
        <%= simple_form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
          <%= f.error_notification %>
          <%= f.full_error :unlock_token %>

          <div class="form-group mb-4">
            <%= f.input :email,
                        required: true,
                        autofocus: true,
                        label: "Email",
                        input_html: {
                          class: "form-control",
                          autocomplete: "email",
                          placeholder: "votre.email@exemple.com"
                        },
                        label_html: { class: "form-label fw-semibold" } %>
          </div>

          <div class="form-actions mb-4">
            <%= f.button :submit, "Resend unlock instructions",
                         class: "btn btn-primary-custom btn-lg w-100 d-flex align-items-center justify-content-center" %>
          </div>
        <% end %>

        <!-- Liens -->
        <div class="auth-links text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
