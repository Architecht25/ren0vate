<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-book"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Exigences Réglementaires</h1>
    </div>
    <%= link_to dashboard_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour au dashboard
    <% end %>
  </div>

  <!-- Sélection de la région -->
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-geo-alt-fill me-2"></i>Choisissez votre région
          </h5>
          <p class="text-muted-custom mb-4">
            Consultez les exigences réglementaires spécifiques à votre région pour l'isolation,
            la ventilation, le chauffage et les primes énergétiques.
          </p>

          <div class="row g-4 mt-2">
            <!-- Carte pour Bruxelles -->
            <div class="col-md-4">
              <%= link_to regulations_path(region: "bruxelles"), class: "text-decoration-none" do %>
                <div class="card h-100 region-card">
                  <div class="card-body text-center p-4">
                    <div class="icon-circle-large mx-auto mb-3">
                      <i class="bi bi-buildings"></i>
                    </div>
                    <h5 class="card-title mb-2">Bruxelles</h5>
                    <p class="text-muted-custom small mb-0">
                      Réglementations bruxelloises pour l'efficacité énergétique et les primes de rénovation.
                    </p>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- Carte pour la Wallonie -->
            <div class="col-md-4">
              <%= link_to regulations_path(region: "wallonie"), class: "text-decoration-none" do %>
                <div class="card h-100 region-card">
                  <div class="card-body text-center p-4">
                    <div class="icon-circle-large mx-auto mb-3">
                      <i class="bi bi-house-heart"></i>
                    </div>
                    <h5 class="card-title mb-2">Wallonie</h5>
                    <p class="text-muted-custom small mb-0">
                      Réglementations wallonnes pour l'efficacité énergétique et les primes habitation.
                    </p>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- Carte pour la Flandre -->
            <div class="col-md-4">
              <%= link_to regulations_path(region: "flandre"), class: "text-decoration-none" do %>
                <div class="card h-100 region-card">
                  <div class="card-body text-center p-4">
                    <div class="icon-circle-large mx-auto mb-3">
                      <i class="bi bi-house-check"></i>
                    </div>
                    <h5 class="card-title mb-2">Flandre</h5>
                    <p class="text-muted-custom small mb-0">
                      Réglementations flamandes pour l'efficacité énergétique et les primes de rénovation.
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>

<!-- CSS harmonisé avec properties/new -->
<style>
  .region-card {
    transition: all 0.2s ease;
    border-radius: 8px;
    border: 1px solid var(--border-custom);
  }

  .region-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(44, 82, 130, 0.15);
    border-color: var(--primary-custom);
  }

  .icon-circle-large {
    width: 80px;
    height: 80px;
    background-color: var(--light-custom);
    border: 2px solid var(--border-custom);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-custom);
    font-size: 32px;
    transition: all 0.2s ease;
  }

  .region-card:hover .icon-circle-large {
    background-color: var(--primary-custom);
    border-color: var(--primary-custom);
    color: white;
    transform: scale(1.05);
  }

  .card-title {
    color: var(--text-primary-custom);
    font-weight: 500;
  }
</style>
