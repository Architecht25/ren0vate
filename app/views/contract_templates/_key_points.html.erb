<% case template[:category] %>
<% when 'Architecte' %>
  <div class="alert alert-info">
    <h6 class="alert-heading">Points de vigilance pour contrat d'architecte</h6>
    <ul class="mb-0">
      <li><strong>Définition précise de la mission</strong> : Assurez-vous que les phases sont clairement définies (esquisse, avant-projet, permis, exécution, suivi)</li>
      <li><strong>Honoraires</strong> : Vérifiez la base de calcul (pourcentage, forfait, horaire) et les conditions de révision</li>
      <li><strong>Propriété intellectuelle</strong> : Clarifiez qui détient les droits sur les plans</li>
      <li><strong>Assurance décennale</strong> : Vérifiez que l'architecte a une assurance valide</li>
      <li><strong>Résiliation</strong> : Comprenez les conditions et indemnités en cas d'arrêt anticipé</li>
    </ul>
  </div>

<% when 'Entrepreneur' %>
  <div class="alert alert-warning">
    <h6 class="alert-heading">Points de vigilance pour contrat d'entreprise</h6>
    <ul class="mb-0">
      <li><strong>Loi Breyne obligatoire</strong> si habitation neuve ou rénovation lourde (> 80 000€)</li>
      <li><strong>Description détaillée des travaux</strong> : Cahier des charges complet annexé</li>
      <li><strong>Prix et révision</strong> : Conditions de variation du prix (index, matériaux)</li>
      <li><strong>Délais et pénalités</strong> : Date de début, durée, conséquences des retards</li>
      <li><strong>Garanties obligatoires</strong> : Décennale (10 ans), biennale (2 ans), parfait achèvement (1 an)</li>
      <li><strong>Assurances</strong> : RC chantier, tous risques chantier, contrôle technique</li>
      <li><strong>Réception</strong> : Procédure de réception provisoire et définitive</li>
    </ul>
  </div>

<% when 'Coordination' %>
  <div class="alert alert-info">
    <h6 class="alert-heading">Points de vigilance pour coordinateur sécurité</h6>
    <ul class="mb-0">
      <li><strong>Obligation légale</strong> : Coordinateur obligatoire si > 500 jours-hommes ou travaux simultanés</li>
      <li><strong>Plan de sécurité</strong> : Élaboration avant début des travaux</li>
      <li><strong>Visites régulières</strong> : Fréquence définie selon importance chantier</li>
      <li><strong>Responsabilités</strong> : Limites d'intervention du coordinateur</li>
      <li><strong>Dossier d'intervention ultérieure</strong> : Constitution pour future maintenance</li>
    </ul>
  </div>

<% when 'Études' %>
  <div class="alert alert-success">
    <h6 class="alert-heading">Points de vigilance pour bureau d'études</h6>
    <ul class="mb-0">
      <li><strong>Objet précis des études</strong> : Stabilité, techniques spéciales, PEB, acoustique...</li>
      <li><strong>Livrables attendus</strong> : Plans, notes de calcul, rapports, certifications</li>
      <li><strong>Coordination</strong> : Interface avec architecte et entrepreneur</li>
      <li><strong>Responsabilité décennale</strong> : Vérifier l'assurance pour études de stabilité</li>
      <li><strong>Propriété des études</strong> : Droits d'utilisation et de modification</li>
    </ul>
  </div>

<% else %>
  <div class="alert alert-secondary">
    <p class="mb-0">Consultez les clauses spécifiques de ce type de contrat avec attention.</p>
  </div>
<% end %>

<!-- Points communs à tous les contrats -->
<div class="card bg-light mt-3">
  <div class="card-body">
    <h6 class="card-title">
      <i class="bi bi-clipboard-check text-primary me-2"></i>
      Checklist avant signature
    </h6>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" id="check1">
      <label class="form-check-label" for="check1">
        Toutes les parties sont clairement identifiées (nom, adresse, n° BCE/TVA)
      </label>
    </div>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" id="check2">
      <label class="form-check-label" for="check2">
        L'objet du contrat est décrit de manière précise et complète
      </label>
    </div>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" id="check3">
      <label class="form-check-label" for="check3">
        Le prix total et les modalités de paiement sont clairement indiqués
      </label>
    </div>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" id="check4">
      <label class="form-check-label" for="check4">
        Les délais de réalisation et dates importantes sont précisés
      </label>
    </div>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" id="check5">
      <label class="form-check-label" for="check5">
        Les garanties et assurances obligatoires sont mentionnées
      </label>
    </div>
    <div class="form-check mb-2">
      <input class="form-check-input" type="checkbox" id="check6">
      <label class="form-check-label" for="check6">
        Les conditions de résiliation ou modification sont comprises
      </label>
    </div>
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="check7">
      <label class="form-check-label" for="check7">
        Toutes les annexes nécessaires sont jointes (plans, cahier des charges, devis)
      </label>
    </div>
  </div>
</div>
