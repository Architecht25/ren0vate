<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: @message_thread.title, subtitle: @message_thread.project.nom } do %><% end %>

  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm mb-3" style="border-radius: 12px;">
        <div class="card-body">
          <% if @messages.any? %>
            <% @messages.each do |message| %>
              <div class="mb-3 pb-3 border-bottom">
                <div class="small text-muted"><%= message.author.full_name.presence || message.author.email %> — <%= l(message.created_at, format: :short) %></div>
                <div><%= message.body %></div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted mb-0">Aucun message pour l'instant.</p>
          <% end %>
        </div>
      </div>

      <%= simple_form_for @message, url: message_thread_messages_path(@message_thread) do |f| %>
        <div class="input-group">
          <%= f.input_field :body, class: "form-control", placeholder: "Écrire un message…" %>
          <%= f.submit "Envoyer", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
