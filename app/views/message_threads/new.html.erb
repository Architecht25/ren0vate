<% content_for :title, "Nouveau fil de discussion" %>

<div class="container py-4" style="max-width: 600px;">
  <div class="d-flex align-items-center mb-4">
    <%= link_to project_message_threads_path(@project), class: "btn btn-outline-secondary btn-sm me-3" do %>
      <i class="bi bi-arrow-left"></i>
    <% end %>
    <div style="min-width: 0;">
      <h3 class="mb-0 text-truncate">Nouveau fil de discussion</h3>
      <p class="text-muted small mb-0 text-truncate"><%= @project.nom %></p>
    </div>
  </div>

  <%= simple_form_for [@project, @message_thread] do |f| %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-chat-dots me-2"></i>Informations</h6>
      </div>
      <div class="card-body p-4">
        <%= f.error_notification %>
        <div class="row g-3">
          <div class="col-12">
            <%= f.input :title, label: "Sujet", input_html: { class: "form-control" } %>
          </div>
          <div class="col-12">
            <%= f.input :lot_id, label: "Lot", as: :select,
                collection: @project.lots.ordered, label_method: :name, value_method: :id,
                include_blank: "Tous les lots", input_html: { class: "form-select" } %>
          </div>
        </div>
      </div>
      <div class="card-footer bg-transparent d-flex flex-wrap gap-2 justify-content-end">
        <%= link_to "Annuler", project_message_threads_path(@project), class: "btn btn-outline-secondary" %>
        <%= f.submit "Créer", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
