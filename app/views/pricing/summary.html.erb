<% content_for :title, "Résumé de votre abonnement - Ren0vate" %>

<div class="container py-5">
  <!-- Progress Bar -->
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="step completed">
          <div class="step-circle bg-success text-white">
            <i class="bi bi-check"></i>
          </div>
          <div class="step-label text-success">Sélection</div>
        </div>
        <div class="step-line bg-success"></div>
        <div class="step active">
          <div class="step-circle bg-primary text-white">2</div>
          <div class="step-label text-primary">Résumé</div>
        </div>
        <div class="step-line bg-light"></div>
        <div class="step">
          <div class="step-circle bg-light text-muted">3</div>
          <div class="step-label text-muted">Paiement</div>
        </div>
        <div class="step-line bg-light"></div>
        <div class="step">
          <div class="step-circle bg-light text-muted">4</div>
          <div class="step-label text-muted">Confirmation</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Header -->
  <div class="row mb-4">
    <div class="col-lg-8 mx-auto text-center">
      <h1 class="display-6 fw-bold mb-3">
        <i class="bi bi-clipboard-check text-primary me-3"></i>
        Résumé de votre abonnement
      </h1>
      <p class="lead text-muted">
        Vérifiez les détails de votre formule avant de procéder au paiement
      </p>
    </div>
  </div>

  <div class="row">
    <!-- Résumé de commande -->
    <div class="col-lg-7 mb-4">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h4 class="mb-0">
            <i class="bi bi-receipt me-2"></i>
            Détails de l'abonnement
          </h4>
        </div>
        <div class="card-body">
          <!-- Tier sélectionné -->
          <div class="row align-items-center mb-4 p-3 bg-light rounded">
            <div class="col-md-8">
              <div class="d-flex align-items-center">
                <div class="tier-icon bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                  <% case @tier %>
                  <% when :freemium %>
                    <i class="bi bi-gift"></i>
                  <% when :individual %>
                    <i class="bi bi-person"></i>
                  <% when :portfolio %>
                    <i class="bi bi-buildings"></i>
                  <% when :professional %>
                    <i class="bi bi-briefcase"></i>
                  <% when :enterprise %>
                    <i class="bi bi-building"></i>
                  <% end %>
                </div>
                <div>
                  <h5 class="mb-1 fw-bold"><%= @selected_tier[:name] %></h5>
                  <p class="text-muted mb-0"><%= @selected_tier[:description] %></p>
                  <small class="text-primary"><%= @selected_tier[:target] %></small>
                </div>
              </div>
            </div>
            <div class="col-md-4 text-end">
              <div class="tier-price">
                <span class="h4 fw-bold text-primary"><%= @selected_tier[:price] %>€</span>
                <div class="text-muted">/mois</div>
              </div>
            </div>
          </div>

          <!-- Fonctionnalités incluses -->
          <div class="mb-4">
            <h6 class="fw-bold mb-3">
              <i class="bi bi-check-circle-fill text-success me-2"></i>
              Fonctionnalités incluses
            </h6>
            <div class="row">
              <% @selected_tier[:features].each_with_index do |feature, index| %>
                <div class="col-md-6 mb-2">
                  <small class="d-flex align-items-start">
                    <i class="bi bi-check text-success me-2 mt-1"></i>
                    <%= feature %>
                  </small>
                </div>
                <% if index == 7 && @selected_tier[:features].length > 8 %>
                  <div class="col-12">
                    <div class="collapse" id="allFeatures<%= @tier %>">
                <% end %>
              <% end %>
              <% if @selected_tier[:features].length > 8 %>
                    </div>
                    <div class="col-12 mt-2">
                      <button class="btn btn-sm btn-outline-primary" type="button"
                              data-bs-toggle="collapse" data-bs-target="#allFeatures<%= @tier %>">
                        <i class="bi bi-plus me-1"></i>
                        Voir toutes les fonctionnalités (<%= @selected_tier[:features].length %>)
                      </button>
                    </div>
                  </div>
              <% end %>
            </div>
          </div>

          <!-- ROI Information -->
          <% if @selected_tier[:roi] %>
            <div class="alert alert-success bg-light border-success">
              <div class="d-flex align-items-center">
                <i class="bi bi-graph-up-arrow text-success me-3 fs-4"></i>
                <div>
                  <strong>Retour sur investissement estimé :</strong><br>
                  <small><%= @selected_tier[:roi] %></small>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar de commande -->
    <div class="col-lg-5">
      <div class="card shadow-sm sticky-top" style="top: 20px;">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="bi bi-credit-card me-2"></i>
            Facturation
          </h5>
        </div>
        <div class="card-body">
          <!-- Cycle de facturation -->
          <div class="billing-cycle mb-4">
            <label class="form-label fw-bold">Cycle de facturation :</label>
            <div class="btn-group w-100" role="group">
              <input type="radio" class="btn-check" name="billing_cycle" id="monthly" value="monthly" checked>
              <label class="btn btn-outline-primary" for="monthly">
                <div>Mensuel</div>
                <small class="text-muted"><%= @selected_tier[:price] %>€/mois</small>
              </label>

              <input type="radio" class="btn-check" name="billing_cycle" id="yearly" value="yearly">
              <label class="btn btn-outline-success" for="yearly">
                <div>Annuel</div>
                <small class="text-success">
                  <%= (@selected_tier[:price] * 10).to_i %>€/an
                  <span class="badge bg-success ms-1">-17%</span>
                </small>
              </label>
            </div>
          </div>

          <!-- Résumé de prix -->
          <div class="price-breakdown">
            <div class="d-flex justify-content-between mb-2">
              <span>Abonnement <%= @selected_tier[:name] %></span>
              <span class="billing-price"><%= @selected_tier[:price] %>€</span>
            </div>

            <div class="d-flex justify-content-between text-muted mb-2">
              <small>TVA (21% - Belgique)</small>
              <small class="tax-amount"><%= (@selected_tier[:price] * 0.21).round(2) %>€</small>
            </div>

            <hr>

            <div class="d-flex justify-content-between fw-bold fs-5">
              <span>Total <span class="billing-period">mensuel</span></span>
              <span class="total-amount text-primary"><%= (@selected_tier[:price] * 1.21).round(2) %>€</span>
            </div>

            <small class="text-muted d-block mt-2">
              Facturation automatique chaque mois. Annulation possible à tout moment.
            </small>
          </div>

          <!-- Promo code -->
          <div class="promo-section mt-4">
            <div class="input-group">
              <input type="text" class="form-control" placeholder="Code promo (optionnel)" id="promoCode">
              <button class="btn btn-outline-secondary" type="button">Appliquer</button>
            </div>
          </div>

          <!-- CTA Button -->
          <div class="checkout-actions mt-4">
            <% stripe_configured = controller.send(:stripe_configured?) %>

            <% unless stripe_configured %>
              <div class="alert alert-warning mb-3">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Mode démo :</strong> Clés Stripe non configurées. Le paiement sera simulé.
              </div>
            <% end %>

            <%= form_with url: pricing_checkout_path, method: :post, class: "d-grid" do |form| %>
              <%= form.hidden_field :tier, value: @tier %>
              <%= form.hidden_field :billing_cycle, value: "monthly", class: "billing-cycle-input" %>
              <%= form.hidden_field :total_amount, value: (@selected_tier[:price] * 1.21).round(2), class: "total-amount-input" %>

              <%= form.submit class: "btn btn-primary btn-lg shadow",
                  data: { disable_with: stripe_configured ? "Redirection vers Stripe..." : "Simulation paiement..." } do %>
                <i class="bi bi-shield-check me-2"></i>
                <%= stripe_configured ? "Procéder au paiement sécurisé" : "Simuler le paiement (Démo)" %>
              <% end %>
            <% end %>

            <div class="text-center mt-3">
              <%= link_to pricing_select_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-arrow-left me-2"></i>
                Modifier ma sélection
              <% end %>
            </div>
          </div>

          <!-- Sécurité -->
          <div class="security-badges mt-4 text-center">
            <div class="row g-2">
              <div class="col-4">
                <div class="security-badge">
                  <i class="bi bi-shield-lock text-success fs-4"></i>
                  <div class="small text-muted">SSL</div>
                </div>
              </div>
              <div class="col-4">
                <div class="security-badge">
                  <img src="https://stripe.com/img/v3/home/social.png" alt="Stripe" height="20" class="mb-1">
                  <div class="small text-muted">Stripe</div>
                </div>
              </div>
              <div class="col-4">
                <div class="security-badge">
                  <i class="bi bi-credit-card text-primary fs-4"></i>
                  <div class="small text-muted">Cards</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Guarantee -->
      <div class="card mt-3 border-success">
        <div class="card-body text-center">
          <i class="bi bi-shield-check text-success fs-3"></i>
          <h6 class="mt-2">Garantie 30 jours</h6>
          <small class="text-muted">
            Remboursement intégral si vous n'êtes pas satisfait
          </small>
        </div>
      </div>
    </div>
  </div>

  <!-- User context (if logged in) -->
  <% if user_signed_in? && @current_user_context %>
    <div class="row mt-5">
      <div class="col-lg-8 mx-auto">
        <div class="alert alert-info">
          <h6 class="alert-heading">
            <i class="bi bi-person-check me-2"></i>
            Profil utilisateur
          </h6>
          <div class="row">
            <div class="col-md-4">
              <strong><%= @current_user_context[:properties_count] %></strong> propriété<%= 's' if @current_user_context[:properties_count] > 1 %>
            </div>
            <div class="col-md-4">
              <strong><%= @current_user_context[:simulations_count] %></strong> simulation<%= 's' if @current_user_context[:simulations_count] > 1 %>
            </div>
            <div class="col-md-4">
              <strong><%= @current_user_context[:projects_count] %></strong> projet<%= 's' if @current_user_context[:projects_count] > 1 %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style nonce="<%= content_security_policy_nonce %>">
/* Progress Steps */
.step {
  text-align: center;
  position: relative;
}

.step-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 8px;
  font-weight: bold;
}

.step-line {
  height: 2px;
  flex: 1;
  margin-top: 20px;
}

.step-label {
  font-size: 0.875rem;
  font-weight: 500;
}

.step.completed .step-circle {
  background-color: #198754 !important;
}

.step.active .step-circle {
  background-color: #0d6efd !important;
}

/* Tier Icon */
.tier-icon {
  min-width: 50px;
  font-size: 1.25rem;
}

/* Billing Cycle */
.billing-cycle .btn-check:checked + .btn {
  background-color: var(--bs-primary);
  border-color: var(--bs-primary);
  color: white;
}

.billing-cycle .btn-check:checked + .btn.btn-outline-success {
  background-color: var(--bs-success);
  border-color: var(--bs-success);
}

/* Security badges */
.security-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8px;
}

/* Responsive */
@media (max-width: 768px) {
  .step-label {
    font-size: 0.75rem;
  }

  .step-circle {
    width: 35px;
    height: 35px;
  }

  .sticky-top {
    position: relative !important;
  }
}

/* Animations */
.card {
  transition: all 0.3s ease;
}

.btn {
  transition: all 0.2s ease;
}

.btn:hover {
  transform: translateY(-1px);
}
</style>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  // Billing cycle toggle
  const monthlyRadio = document.getElementById('monthly');
  const yearlyRadio = document.getElementById('yearly');
  const billingPrice = document.querySelector('.billing-price');
  const taxAmount = document.querySelector('.tax-amount');
  const totalAmount = document.querySelector('.total-amount');
  const billingPeriod = document.querySelector('.billing-period');
  const billingCycleInput = document.querySelector('.billing-cycle-input');
  const totalAmountInput = document.querySelector('.total-amount-input');

  const basePrice = <%= @selected_tier[:price] %>;

  function updatePricing() {
    const isYearly = yearlyRadio.checked;
    const price = isYearly ? basePrice * 10 : basePrice;
    const tax = (price * 0.21).toFixed(2);
    const total = (price * 1.21).toFixed(2);

    billingPrice.textContent = price + '€';
    taxAmount.textContent = tax + '€';
    totalAmount.textContent = total + '€';
    billingPeriod.textContent = isYearly ? 'annuel' : 'mensuel';

    billingCycleInput.value = isYearly ? 'yearly' : 'monthly';
    totalAmountInput.value = total;
  }

  monthlyRadio.addEventListener('change', updatePricing);
  yearlyRadio.addEventListener('change', updatePricing);

  // Promo code
  const promoInput = document.getElementById('promoCode');
  const applyPromoBtn = promoInput.nextElementSibling;

  applyPromoBtn.addEventListener('click', function() {
    const code = promoInput.value.trim();
    if (code) {
      // TODO: Implement promo code logic
      console.log('Applying promo code:', code);
    }
  });
});
</script>
