<% content_for :title, "Paiement annulé - Ren0vate" %>

<div class="container py-5">
  <div class="row">
    <div class="col-lg-6 mx-auto text-center">
      <div class="cancel-icon mb-4">
        <i class="bi bi-x-circle text-warning display-1"></i>
      </div>

      <h1 class="h3 mb-3">Paiement annulé</h1>

      <p class="text-muted mb-4">
        Aucun souci ! Vous pouvez reprendre votre sélection quand vous voulez.
        Votre formule Découverte reste active en attendant.
      </p>

      <div class="btn-group" role="group">
        <%= link_to pricing_select_path, class: "btn btn-primary" do %>
          <i class="bi bi-arrow-left me-2"></i>
          Reprendre ma sélection
        <% end %>
        <%= link_to root_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-house me-2"></i>
          Retour à l'accueil
        <% end %>
      </div>
    </div>
  </div>
</div>
