<style nonce="<%= content_security_policy_nonce %>">
.pricing-price { margin: .5rem 0; }
.card { transition: transform .3s ease, box-shadow .3s ease; }
.card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,.12) !important; }
.actor-card { cursor: pointer; }
.actor-card:hover { border-width: 2px !important; }
@media (max-width: 768px) {
  .card { transform: none !important; margin-bottom: 1.5rem; }
}
/* Billing toggle */
#billingToggle { transition: background-color .2s; }
.billing-label-annual .badge { font-size: .65rem; }
#billing-toggle-row .bg-light { box-shadow: 0 1px 4px rgba(0,0,0,.06); }
</style>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('turbo:load', function () {
  const toggle = document.getElementById('billingToggle');
  if (!toggle) return;

  const monthlyLabel = document.querySelector('.billing-label-monthly');
  const annualLabel  = document.querySelector('.billing-label-annual');
  const annualNote   = document.querySelector('.annual-savings-note');

  function applyBilling(isAnnual) {
    // Afficher/masquer les prix
    document.querySelectorAll('.price-monthly').forEach(el => el.classList.toggle('d-none', isAnnual));
    document.querySelectorAll('.price-annual').forEach(el => el.classList.toggle('d-none', !isAnnual));

    // Mettre à jour les labels du toggle
    monthlyLabel.classList.toggle('text-muted', isAnnual);
    monthlyLabel.classList.toggle('text-dark', !isAnnual);
    monthlyLabel.classList.toggle('fw-semibold', !isAnnual);
    annualLabel.classList.toggle('text-muted', !isAnnual);
    annualLabel.classList.toggle('text-dark', isAnnual);
    annualLabel.classList.toggle('fw-semibold', isAnnual);

    // Note d'économies
    if (annualNote) annualNote.classList.toggle('d-none', !isAnnual);

    // Mettre à jour les URLs des CTAs
    document.querySelectorAll('a.cta-link').forEach(function (link) {
      const href = isAnnual ? link.dataset.annualHref : link.dataset.monthlyHref;
      if (href) link.href = href;
    });
  }

  toggle.addEventListener('change', function () { applyBilling(this.checked); });
  applyBilling(false); // État initial : mensuel
});
</script>
