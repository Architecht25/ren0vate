<% content_for :title, "Tarifs — Ren0vate" %>
<% content_for :full_width_page, true %>

<div class="container-fluid px-3 px-md-4 py-5" style="max-width:1400px;margin:0 auto;">

  <%# ── Header ── %>
  <div class="row mb-4 text-center">
    <div class="col-lg-7 mx-auto">
      <h1 class="display-5 fw-bold mb-2">Gérez votre bien, de bout en bout</h1>
      <p class="lead text-muted mb-0">Rénovation, primes, DIU, vente et gestion locative — une formule pour chaque profil.</p>
    </div>
  </div>

  <%# ── Actor cards ── %>
  <div class="row g-3 justify-content-center mb-5">
    <div class="col-md-4 col-lg-3">
      <a href="#offres-proprietaires" class="text-decoration-none">
        <div class="card border-primary h-100 p-3 text-center actor-card">
          <i class="bi bi-house-heart fs-2 text-primary mb-2"></i>
          <h6 class="fw-bold text-primary mb-1">Propriétaire</h6>
          <p class="text-muted small mb-2">Pilotez votre rénovation, maximisez vos primes</p>
          <span class="badge bg-primary">0€ → 149€/mois</span>
        </div>
      </a>
    </div>
    <div class="col-md-4 col-lg-3">
      <a href="#offres-professionnels" class="text-decoration-none">
        <div class="card border-success h-100 p-3 text-center actor-card">
          <i class="bi bi-person-workspace fs-2 text-success mb-2"></i>
          <h6 class="fw-bold text-success mb-1">Architecte / Bureau d'études</h6>
          <p class="text-muted small mb-2">Collaborez avec vos clients sur une plateforme unique</p>
          <span class="badge bg-success">Pro 99€/mois</span>
        </div>
      </a>
    </div>
    <div class="col-md-4 col-lg-3">
      <a href="#offres-professionnels" class="text-decoration-none">
        <div class="card border-warning h-100 p-3 text-center actor-card">
          <i class="bi bi-hammer fs-2 text-warning mb-2"></i>
          <h6 class="fw-bold mb-1" style="color:#b45309">Entrepreneur</h6>
          <p class="text-muted small mb-2">Recevez des dossiers clients complets, gérez vos chantiers</p>
          <span class="badge bg-warning text-dark">Pro 99€/mois</span>
        </div>
      </a>
    </div>
  </div>

  <%# ── Toggle mensuel / annuel ── %>
  <div class="row mb-4" id="billing-toggle-row">
    <div class="col-auto mx-auto">
      <div class="d-flex align-items-center gap-3 bg-light rounded-pill px-4 py-2">
        <span class="fw-semibold text-dark billing-label-monthly">Mensuel</span>
        <div class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" role="switch" id="billingToggle"
                 style="width:3rem;height:1.5rem;cursor:pointer;">
          <label class="form-check-label visually-hidden" for="billingToggle">Annuel</label>
        </div>
        <span class="fw-semibold text-muted billing-label-annual">
          Annuel <span class="badge bg-success ms-1">-17%</span>
        </span>
      </div>
      <p class="text-center text-muted small mt-1 mb-0 annual-savings-note d-none">
        <i class="bi bi-piggy-bank me-1 text-success"></i>2 mois offerts par rapport à la facturation mensuelle
      </p>
    </div>
  </div>

  <hr class="my-4">

  <%# ── Offres Propriétaires ── %>
  <div id="offres-proprietaires" class="mb-3 text-center">
    <h2 class="fw-bold text-primary mb-1"><i class="bi bi-house-heart me-2"></i>Offres Propriétaires</h2>
    <p class="text-muted small">Du premier projet à la gestion de patrimoine complet</p>
  </div>

  <div class="row g-3 justify-content-center mb-5">

    <%# Starter %>
    <div class="col-xl-3 col-lg-6 col-md-6">
      <div class="card h-100 border-secondary">
        <div class="card-header bg-secondary text-white text-center py-2">
          <span class="badge bg-light text-dark mb-1">Gratuit</span>
          <h5 class="card-title mb-1"><%= @pricing_tiers[:freemium][:name] %></h5>
          <div class="my-1"><span class="h3 fw-bold">0€</span><span class="small">/mois</span></div>
          <small class="opacity-75"><%= @pricing_tiers[:freemium][:description] %></small>
        </div>
        <div class="card-body p-2">
          <ul class="list-unstyled mb-0" style="font-size:.73rem;">
            <% @pricing_tiers[:freemium][:features].each do |f| %>
              <%= render_pricing_feature(f, small: true) %>
            <% end %>
          </ul>
          <hr class="my-2">
          <p class="small text-muted fw-bold mb-1">Limitations :</p>
          <ul class="list-unstyled mb-0" style="font-size:.73rem;">
            <% @pricing_tiers[:freemium][:limitations].each do |l| %>
              <li class="mb-1 text-muted"><i class="bi bi-x-circle text-danger me-1"></i><%= l %></li>
            <% end %>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center py-2">
          <% if user_signed_in? %>
            <span class="btn btn-secondary btn-sm w-100" disabled>
              <i class="bi bi-check-circle me-1"></i>Formule actuelle
            </span>
          <% else %>
            <%= link_to new_user_registration_path, class: "btn btn-secondary btn-sm w-100" do %>
              <i class="bi bi-play-circle me-1"></i><%= @pricing_tiers[:freemium][:cta] %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# Propriétaire — le plus populaire %>
    <div class="col-xl-3 col-lg-6 col-md-6">
      <div class="card h-100 shadow position-relative" style="border:2px solid var(--ren0vate-accent) !important;transform:scale(1.02);z-index:1;">
        <div class="position-absolute top-0 start-50 translate-middle">
          <span class="badge px-3 py-1 fw-bold" style="background:var(--ren0vate-accent);border-radius:20px;">
            <i class="bi bi-star-fill me-1"></i>Le plus populaire
          </span>
        </div>
        <div class="card-header text-white text-center py-2 mt-2" style="background:var(--ren0vate-primary);">
          <h5 class="card-title mb-1"><%= @pricing_tiers[:individual][:name] %></h5>
          <div class="my-1">
            <span class="price-monthly"><span class="h3 fw-bold"><%= @pricing_tiers[:individual][:price] %>€</span><span class="small">/mois</span></span>
            <span class="price-annual d-none">
              <span class="h3 fw-bold"><%= (@pricing_tiers[:individual][:annual_total] / 12.0).round %>€</span><span class="small">/mois</span>
              <div class="small opacity-75" style="font-size:.75rem;">facturé <%= @pricing_tiers[:individual][:annual_total] %>€/an</div>
            </span>
          </div>
          <small class="opacity-75"><%= @pricing_tiers[:individual][:description] %></small>
        </div>
        <div class="card-body p-2">
          <div class="alert alert-primary bg-light border-primary py-1 mb-2">
            <small><strong>ROI :</strong> <%= @pricing_tiers[:individual][:roi] %></small>
          </div>
          <ul class="list-unstyled mb-0" style="font-size:.73rem;">
            <% @pricing_tiers[:individual][:features].each do |f| %>
              <%= render_pricing_feature(f, small: true) %>
            <% end %>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center py-2">
          <% if user_signed_in? %>
            <%= link_to pricing_summary_path(tier: :individual, billing_cycle: :monthly),
                class: "btn btn-primary btn-sm w-100 cta-link",
                data: { monthly_href: pricing_summary_path(tier: :individual, billing_cycle: :monthly),
                        annual_href: pricing_summary_path(tier: :individual, billing_cycle: :yearly) } do %>
              <i class="bi bi-rocket-takeoff me-1"></i><%= @pricing_tiers[:individual][:cta] %>
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path, class: "btn btn-primary btn-sm w-100" do %>
              <i class="bi bi-person-plus me-1"></i>Créer un compte
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# Investisseur %>
    <div class="col-xl-3 col-lg-6 col-md-6">
      <div class="card h-100 border-warning">
        <div class="card-header bg-warning text-dark text-center py-2">
          <h5 class="card-title mb-1"><%= @pricing_tiers[:portfolio][:name] %></h5>
          <div class="my-1">
            <span class="price-monthly"><span class="h3 fw-bold"><%= @pricing_tiers[:portfolio][:price] %>€</span><span class="small">/mois</span></span>
            <span class="price-annual d-none">
              <span class="h3 fw-bold"><%= (@pricing_tiers[:portfolio][:annual_total] / 12.0).round %>€</span><span class="small">/mois</span>
              <div class="small opacity-75" style="font-size:.75rem;">facturé <%= @pricing_tiers[:portfolio][:annual_total] %>€/an</div>
            </span>
          </div>
          <small><%= @pricing_tiers[:portfolio][:description] %></small>
        </div>
        <div class="card-body p-2">
          <div class="alert alert-warning bg-light border-warning py-1 mb-2">
            <small><strong>ROI :</strong> <%= @pricing_tiers[:portfolio][:roi] %></small>
          </div>
          <ul class="list-unstyled mb-0" style="font-size:.73rem;">
            <% @pricing_tiers[:portfolio][:features].take(7).each do |f| %>
              <%= render_pricing_feature(f, small: true) %>
            <% end %>
            <li class="text-muted"><small>+ <%= @pricing_tiers[:portfolio][:features].length - 7 %> autres fonctionnalités</small></li>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center py-2">
          <% if user_signed_in? %>
            <%= link_to pricing_summary_path(tier: :portfolio, billing_cycle: :monthly),
                class: "btn btn-warning btn-sm w-100 text-dark cta-link",
                data: { monthly_href: pricing_summary_path(tier: :portfolio, billing_cycle: :monthly),
                        annual_href: pricing_summary_path(tier: :portfolio, billing_cycle: :yearly) } do %>
              <i class="bi bi-crown me-1"></i><%= @pricing_tiers[:portfolio][:cta] %>
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path, class: "btn btn-warning btn-sm w-100 text-dark" do %>
              <i class="bi bi-person-plus me-1"></i>Créer un compte
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# Premium %>
    <div class="col-xl-3 col-lg-6 col-md-6">
      <div class="card h-100 border-danger">
        <div class="card-header bg-danger text-white text-center py-2">
          <h5 class="card-title mb-1"><%= @pricing_tiers[:premium_mixed][:name] %></h5>
          <div class="my-1">
            <span class="price-monthly"><span class="h3 fw-bold"><%= @pricing_tiers[:premium_mixed][:price] %>€</span><span class="small">/mois</span></span>
            <span class="price-annual d-none">
              <span class="h3 fw-bold"><%= (@pricing_tiers[:premium_mixed][:annual_total] / 12.0).round %>€</span><span class="small">/mois</span>
              <div class="small opacity-75" style="font-size:.75rem;">facturé <%= @pricing_tiers[:premium_mixed][:annual_total] %>€/an</div>
            </span>
          </div>
          <small class="opacity-75"><%= @pricing_tiers[:premium_mixed][:description] %></small>
        </div>
        <div class="card-body p-2">
          <div class="alert alert-danger bg-light border-danger py-1 mb-2">
            <small><strong>ROI :</strong> <%= @pricing_tiers[:premium_mixed][:roi] %></small>
          </div>
          <ul class="list-unstyled mb-0" style="font-size:.73rem;">
            <% @pricing_tiers[:premium_mixed][:features].take(7).each do |f| %>
              <%= render_pricing_feature(f, small: true) %>
            <% end %>
            <li class="text-muted"><small>+ <%= @pricing_tiers[:premium_mixed][:features].length - 7 %> autres fonctionnalités</small></li>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center py-2">
          <% if user_signed_in? %>
            <%= link_to pricing_summary_path(tier: :premium_mixed, billing_cycle: :monthly),
                class: "btn btn-danger btn-sm w-100 cta-link",
                data: { monthly_href: pricing_summary_path(tier: :premium_mixed, billing_cycle: :monthly),
                        annual_href: pricing_summary_path(tier: :premium_mixed, billing_cycle: :yearly) } do %>
              <i class="bi bi-gem me-1"></i><%= @pricing_tiers[:premium_mixed][:cta] %>
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path, class: "btn btn-danger btn-sm w-100" do %>
              <i class="bi bi-person-plus me-1"></i>Créer un compte
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <hr class="my-4">

  <%# ── Offres Professionnels ── %>
  <div id="offres-professionnels" class="mb-3 text-center">
    <h2 class="fw-bold text-success mb-1"><i class="bi bi-briefcase me-2"></i>Offres Professionnels</h2>
    <p class="text-muted small">Pour architectes, entrepreneurs et bureaux d'études</p>
  </div>

  <%# IA Banner %>
  <div class="row mb-4">
    <div class="col-lg-10 mx-auto">
      <div class="rounded-4 overflow-hidden" style="background:linear-gradient(135deg,#1e293b 0%,#334155 60%,#065f46 100%);box-shadow:0 8px 32px rgba(0,0,0,.18);">
        <div class="p-3 p-md-4 text-white d-flex flex-column flex-md-row align-items-center gap-3">
          <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
               style="width:64px;height:64px;background:rgba(255,255,255,.12);font-size:2rem;min-width:64px;">
            <i class="bi bi-robot"></i>
          </div>
          <div class="flex-grow-1 text-center text-md-start">
            <div class="mb-1">
              <span class="badge px-2 py-1 fw-semibold" style="background:#D97706;border-radius:20px;font-size:.72rem;">
                <i class="bi bi-stars me-1"></i>NOUVEAU · Inclus dans toutes les offres Pro
              </span>
            </div>
            <h5 class="fw-bold mb-1" style="color:#fff;">Expert IA dédié à vos chantiers</h5>
            <p class="mb-0 small opacity-90">Posez toutes vos questions sur vos projets clients — primes, avancement, documents — et obtenez des réponses <strong>contextualisées à chaque dossier</strong>.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3 justify-content-center mb-5">

    <%# Pro %>
    <div class="col-xl-4 col-lg-6">
      <div class="card h-100 border-success">
        <div class="card-header bg-success text-white text-center py-2">
          <div class="mb-1">
            <span class="badge px-2 py-1 fw-semibold" style="background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);border-radius:20px;font-size:.68rem;">
              <i class="bi bi-gift me-1"></i>14 jours gratuits &middot; sans CB
            </span>
          </div>
          <h5 class="card-title mb-1"><%= @pricing_tiers[:professional][:name] %></h5>
          <div class="my-1">
            <span class="price-monthly"><span class="h3 fw-bold"><%= @pricing_tiers[:professional][:price] %>€</span><span class="small">/mois</span></span>
            <span class="price-annual d-none">
              <span class="h3 fw-bold"><%= (@pricing_tiers[:professional][:annual_total] / 12.0).round %>€</span><span class="small">/mois</span>
              <div class="small opacity-75" style="font-size:.75rem;">facturé <%= @pricing_tiers[:professional][:annual_total] %>€/an</div>
            </span>
          </div>
          <small class="opacity-75"><%= @pricing_tiers[:professional][:description] %></small>
        </div>
        <div class="card-body p-2">
          <div class="alert alert-success bg-light border-success py-1 mb-2">
            <small><strong>ROI :</strong> <%= @pricing_tiers[:professional][:roi] %></small>
          </div>
          <div class="row g-0">
            <div class="col-6">
              <ul class="list-unstyled pe-1 mb-0" style="font-size:.73rem;">
                <% @pricing_tiers[:professional][:features].first((@pricing_tiers[:professional][:features].length / 2.0).ceil).each do |f| %>
                  <%= render_pricing_feature(f, small: true) %>
                <% end %>
              </ul>
            </div>
            <div class="col-6">
              <ul class="list-unstyled ps-1 mb-0" style="font-size:.73rem;">
                <% @pricing_tiers[:professional][:features].last(@pricing_tiers[:professional][:features].length / 2).each do |f| %>
                  <%= render_pricing_feature(f, small: true) %>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
        <div class="card-footer bg-transparent text-center py-2">
          <% if user_signed_in? %>
            <%= link_to pricing_summary_path(tier: :professional, billing_cycle: :monthly),
                class: "btn btn-success btn-sm w-100 cta-link",
                data: { monthly_href: pricing_summary_path(tier: :professional, billing_cycle: :monthly),
                        annual_href: pricing_summary_path(tier: :professional, billing_cycle: :yearly) } do %>
              <i class="bi bi-play-circle me-1"></i>Démarrer mon essai gratuit
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path, class: "btn btn-success btn-sm w-100" do %>
              <i class="bi bi-person-plus me-1"></i>Créer un compte
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <%# Entreprise %>
    <div class="col-xl-4 col-lg-6">
      <div class="card h-100 border-dark">
        <div class="card-header bg-dark text-white text-center py-2">
          <h5 class="card-title mb-1"><%= @pricing_tiers[:enterprise][:name] %></h5>
          <div class="my-1">
            <span class="price-monthly"><span class="h3 fw-bold"><%= @pricing_tiers[:enterprise][:price] %>€</span><span class="small">/mois</span></span>
            <span class="price-annual d-none">
              <span class="h3 fw-bold"><%= (@pricing_tiers[:enterprise][:annual_total] / 12.0).round %>€</span><span class="small">/mois</span>
              <div class="small opacity-75" style="font-size:.75rem;">facturé <%= @pricing_tiers[:enterprise][:annual_total] %>€/an</div>
            </span>
          </div>
          <small class="opacity-75"><%= @pricing_tiers[:enterprise][:description] %></small>
        </div>
        <div class="card-body p-2">
          <div class="alert bg-light border-secondary py-1 mb-2">
            <small><strong>ROI :</strong> <%= @pricing_tiers[:enterprise][:roi] %></small>
          </div>
          <div class="row g-0">
            <div class="col-6">
              <ul class="list-unstyled pe-1 mb-0" style="font-size:.73rem;">
                <% @pricing_tiers[:enterprise][:features].first((@pricing_tiers[:enterprise][:features].length / 2.0).ceil).each do |f| %>
                  <%= render_pricing_feature(f, small: true) %>
                <% end %>
              </ul>
            </div>
            <div class="col-6">
              <ul class="list-unstyled ps-1 mb-0" style="font-size:.73rem;">
                <% @pricing_tiers[:enterprise][:features].last(@pricing_tiers[:enterprise][:features].length / 2).each do |f| %>
                  <%= render_pricing_feature(f, small: true) %>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
        <div class="card-footer bg-transparent text-center py-2">
          <a href="mailto:robin@architecht.be?subject=Offre Entreprise Ren0vate" class="btn btn-dark btn-sm w-100">
            <i class="bi bi-envelope me-1"></i><%= @pricing_tiers[:enterprise][:cta] %>
          </a>
        </div>
      </div>
    </div>

    <%# Sur mesure %>
    <div class="col-xl-3 col-lg-6">
      <div class="card h-100 border-info">
        <div class="card-header bg-info text-white text-center py-2">
          <h5 class="card-title mb-1">Sur mesure</h5>
          <div class="my-1"><span class="h5 fw-bold">Devis personnalisé</span></div>
          <small class="opacity-75">Solutions spécifiques</small>
        </div>
        <div class="card-body p-2 text-center">
          <p class="small text-muted mb-2">Vous avez des besoins spécifiques ?</p>
          <ul class="list-unstyled text-start mb-0" style="font-size:.73rem;">
            <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Architecture personnalisée</li>
            <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Développements dédiés</li>
            <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Formation équipe</li>
            <li class="mb-1"><i class="bi bi-check-circle-fill text-success me-1"></i>Support dédié</li>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center py-2">
          <a href="mailto:robin@architecht.be" class="btn btn-info btn-sm w-100">
            <i class="bi bi-envelope me-1"></i>Demander un devis
          </a>
        </div>
      </div>
    </div>

  </div>

  <%# ── Garantie ── %>
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto text-center">
      <div class="bg-light p-3 rounded-3">
        <h5 class="mb-2"><i class="bi bi-shield-check text-success me-2"></i>Garantie 30 jours satisfait ou remboursé</h5>
        <p class="text-muted small mb-3">Testez votre nouvelle formule sans risque. Remboursement intégral sous 30 jours.</p>
        <div class="row">
          <div class="col-4"><i class="bi bi-lightning-charge text-warning fs-4"></i><div class="small text-muted">Activation immédiate</div></div>
          <div class="col-4"><i class="bi bi-arrow-up-circle text-success fs-4"></i><div class="small text-muted">Upgrade facile</div></div>
          <div class="col-4"><i class="bi bi-headset text-primary fs-4"></i><div class="small text-muted">Support dédié</div></div>
        </div>
      </div>
    </div>
  </div>

  <%# ── FAQ ── %>
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto">
      <h3 class="text-center mb-3">Questions fréquentes</h3>
      <div class="accordion" id="pricingFAQ">
        <div class="accordion-item">
          <h3 class="accordion-header">
            <button class="accordion-button py-2" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
              Puis-je changer de formule à tout moment ?
            </button>
          </h3>
          <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#pricingFAQ">
            <div class="accordion-body py-2 small">
              Oui, vous pouvez upgrader ou downgrader à tout moment. Les changements prennent effet immédiatement et la facturation est ajustée au prorata.
            </div>
          </div>
        </div>
        <div class="accordion-item">
          <h3 class="accordion-header">
            <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
