<% content_for :title, "Bienvenue dans votre nouvelle formule ! - Ren0vate" %>

<div class="container py-5">
  <!-- Success Header -->
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto text-center">
      <div class="success-animation mb-4">
        <div class="success-circle">
          <i class="bi bi-check-lg text-white"></i>
        </div>
      </div>

      <h1 class="display-5 fw-bold text-success mb-3">
        🎉 Paiement confirmé !
      </h1>

      <p class="lead text-muted mb-4">
        Votre abonnement <strong><%= params[:tier]&.humanize || 'Premium' %></strong> a été activé avec succès.
        Vous avez maintenant accès à toutes les fonctionnalités de votre formule.
      </p>

      <div class="alert alert-success bg-light border-success">
        <div class="d-flex align-items-center justify-content-center">
          <i class="bi bi-shield-check-fill text-success me-3 fs-4"></i>
          <div>
            <strong>Abonnement activé</strong><br>
            <small>Votre accès premium est effectif immédiatement</small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Next Steps -->
  <div class="row mb-5">
    <div class="col-lg-10 mx-auto">
      <h3 class="text-center mb-4">
        <i class="bi bi-list-check me-2"></i>
        Prochaines étapes
      </h3>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <div class="feature-icon bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-house-add-fill fs-4"></i>
              </div>
              <h5 class="card-title">1. Ajoutez vos propriétés</h5>
              <p class="card-text text-muted">
                Commencez par enregistrer toutes vos propriétés pour profiter pleinement de votre nouvelle formule.
              </p>
              <%= link_to root_path, class: "btn btn-primary" do %>
                <i class="bi bi-plus-circle me-2"></i>
                Ajouter une propriété
              <% end %>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <div class="feature-icon bg-success text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-calculator-fill fs-4"></i>
              </div>
              <h5 class="card-title">2. Lancez vos simulations</h5>
              <p class="card-text text-muted">
                Utilisez notre simulateur pour optimiser vos primes énergétiques et calculer votre ROI.
              </p>
              <%= link_to root_path, class: "btn btn-success" do %>
                <i class="bi bi-play-circle me-2"></i>
                Nouvelle simulation
              <% end %>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center">
              <div class="feature-icon bg-warning text-dark rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                <i class="bi bi-chat-dots-fill fs-4"></i>
              </div>
              <h5 class="card-title">3. Explorez Ren0Chat</h5>
              <p class="card-text text-muted">
                Posez vos questions à notre assistant IA spécialisé en rénovation énergétique.
              </p>
              <a href="#" class="btn btn-warning text-dark">
                <i class="bi bi-robot me-2"></i>
                Démarrer le chat
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Features Unlocked -->
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto">
      <div class="card border-primary shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">
            <i class="bi bi-unlock-fill me-2"></i>
            Fonctionnalités débloquées
          </h4>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <ul class="list-unstyled">
                <li class="mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  Projets illimités
                </li>
                <li class="mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  Simulations illimitées
                </li>
                <li class="mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  Support prioritaire (24h)
                </li>
                <li class="mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  Dashboard comparatif
                </li>
              </ul>
            </div>
            <div class="col-md-6">
              <ul class="list-unstyled">
                <li class="mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  Ren0Chat IA (50 questions/mois)
                </li>
                <li class="mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  Analytics ROI avancées
                </li>
                <li class="mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  Export PDF reports
                </li>
                <li class="mb-2">
                  <i class="bi bi-check-circle-fill text-success me-2"></i>
                  BCE search illimitée
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact & Support -->
  <div class="row mb-5">
    <div class="col-lg-6 mx-auto">
      <div class="card bg-light border-0">
        <div class="card-body text-center">
          <i class="bi bi-headset fs-1 text-primary mb-3"></i>
          <h5>Besoin d'aide pour commencer ?</h5>
          <p class="text-muted mb-3">
            Notre équipe support est là pour vous accompagner dans la prise en main de votre nouvelle formule.
          </p>
          <div class="btn-group" role="group">
            <a href="mailto:support@ren0vate.be" class="btn btn-outline-primary">
              <i class="bi bi-envelope me-2"></i>
              support@ren0vate.be
            </a>
            <a href="tel:+32123456789" class="btn btn-outline-primary">
              <i class="bi bi-telephone me-2"></i>
              +32 123 456 789
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Billing Information -->
  <% if params[:session_id] %>
    <div class="row">
      <div class="col-lg-6 mx-auto">
        <div class="alert alert-info">
          <h6 class="alert-heading">
            <i class="bi bi-receipt me-2"></i>
            Informations de facturation
          </h6>
          <p class="mb-2">
            <strong>Session ID :</strong> <code><%= params[:session_id] %></code>
          </p>
          <small class="text-muted">
            Votre facture sera envoyée par email dans les prochaines minutes.
            Vous pouvez gérer votre abonnement depuis votre espace client.
          </small>
        </div>
      </div>
    </div>
  <% end %>

  <!-- CTA -->
  <div class="row">
    <div class="col-lg-6 mx-auto text-center">
      <%= link_to root_path, class: "btn btn-primary btn-lg" do %>
        <i class="bi bi-house-door me-2"></i>
        Accéder à mon tableau de bord
      <% end %>
    </div>
  </div>
</div>

<style nonce="<%= content_security_policy_nonce %>">
/* Success Animation */
.success-animation {
  position: relative;
  display: inline-block;
}

.success-circle {
  width: 80px;
  height: 80px;
  background: linear-gradient(135deg, #198754, #20c997);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2rem;
  margin: 0 auto;
  animation: successPulse 2s ease-in-out infinite;
  box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.4);
}

@keyframes successPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.4);
  }
  50% {
    box-shadow: 0 0 0 20px rgba(25, 135, 84, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(25, 135, 84, 0);
  }
}

/* Feature Icons */
.feature-icon {
  transition: all 0.3s ease;
}

.card:hover .feature-icon {
  transform: scale(1.1);
}

/* Cards */
.card {
  transition: all 0.3s ease;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
}

/* Responsive */
@media (max-width: 768px) {
  .success-circle {
    width: 60px;
    height: 60px;
    font-size: 1.5rem;
  }

  .display-5 {
    font-size: 2rem !important;
  }
}
</style>

<script nonce="<%= content_security_policy_nonce %>">
// Auto-track success conversion
document.addEventListener('DOMContentLoaded', function() {
  // Analytics tracking
  console.log('🎉 Conversion successful!');

  // TODO: Add conversion tracking (Google Analytics, Facebook Pixel, etc.)

  // Confetti effect (optional)
  setTimeout(() => {
    console.log('🎊 Welcome to your new subscription!');
  }, 1000);
});
</script>
