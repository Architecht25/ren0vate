<% content_for :title, "Choisissez votre formule - Ren0vate" %>

<div class="container-fluid px-4 py-5">

  <%# ── Étapes ── %>
  <div class="row mb-5">
    <div class="col-12">
      <div class="d-flex align-items-center justify-content-between flex-wrap">
        <div class="text-center">
          <div class="step-circle-sel active-step mx-auto">1</div>
          <div class="step-label-sel text-primary fw-semibold mt-1">Sélection</div>
        </div>
        <div class="flex-grow-1 mx-2 bg-light" style="height:2px;"></div>
        <div class="text-center">
          <div class="step-circle-sel mx-auto">2</div>
          <div class="step-label-sel text-muted mt-1">Résumé</div>
        </div>
        <div class="flex-grow-1 mx-2 bg-light" style="height:2px;"></div>
        <div class="text-center">
          <div class="step-circle-sel mx-auto">3</div>
          <div class="step-label-sel text-muted mt-1">Paiement</div>
        </div>
        <div class="flex-grow-1 mx-2 bg-light" style="height:2px;"></div>
        <div class="text-center">
          <div class="step-circle-sel mx-auto">4</div>
          <div class="step-label-sel text-muted mt-1">Confirmation</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Header -->
  <div class="row mb-4">
    <div class="col-12 text-center">
      <h1 class="h3 fw-bold mb-1">
        <i class="bi bi-tools text-primary me-2"></i>
        Choisissez votre formule
      </h1>
      <p class="text-muted mb-0">
        Gérez votre projet de rénovation de bout en bout — primes, chantier, équipe, documents.
      </p>
    </div>
  </div>

  <!-- OFFRES PROPRIÉTAIRES -->
  <div id="offres-proprietaires" class="row mb-4">
    <div class="col-12 text-center mb-4">
      <h2 class="fw-bold text-primary">
        <i class="bi bi-house-heart me-2"></i>
        Offres Propriétaires
      </h2>
      <p class="text-muted">Du premier projet à la gestion de patrimoine complet</p>
    </div>
  </div>

  <div class="row g-4 justify-content-center mb-4">

    <!-- STARTER (0€) -->
    <div class="col-12 col-md-6 col-lg-6 col-xl-3" data-tier-key="freemium">
      <div class="card h-100 border-secondary position-relative">
        <% if @current_user_context[:current_tier] == :freemium %>
          <div class="position-absolute top-0 end-0 m-2">
            <span class="badge bg-secondary"><i class="bi bi-check-circle me-1"></i>Actuel</span>
          </div>
        <% end %>
        <div class="card-header bg-secondary text-white text-center py-3">
          <h4 class="card-title mb-1"><%= @pricing_tiers[:freemium][:name] %></h4>
          <div class="pricing-price my-2">
            <span class="h2 fw-bold">0€</span><span>/mois</span>
          </div>
          <small><%= @pricing_tiers[:freemium][:description] %></small>
        </div>
        <div class="card-body">
          <ul class="list-unstyled">
            <% @pricing_tiers[:freemium][:features].each do |f| %>
              <%= render_pricing_feature(f, icon_class: "bi-check text-success", small: true) %>
            <% end %>
          </ul>
          <hr>
          <p class="small text-muted fw-bold mb-2">Limitations :</p>
          <ul class="list-unstyled">
            <% @pricing_tiers[:freemium][:limitations].each do |l| %>
              <li class="mb-1 text-muted"><i class="bi bi-x text-danger me-2"></i><small><%= l %></small></li>
            <% end %>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center">
          <% if @current_user_context[:current_tier] == :freemium %>
            <button class="btn btn-secondary btn-lg w-100" disabled>
              <i class="bi bi-check-circle me-2"></i>Formule actuelle
            </button>
          <% else %>
            <button class="btn btn-outline-secondary btn-lg w-100" disabled>
              <i class="bi bi-arrow-down me-2"></i>Downgrade
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <!-- PROPRIÉTAIRE (39€) -->
    <div class="col-12 col-md-6 col-lg-6 col-xl-3" data-tier-key="individual">
      <% individual = @pricing_tiers[:individual] %>
      <% is_rec_ind = @current_user_context[:recommended_tier] == :individual %>
      <div class="card h-100 position-relative shadow-lg" style="border: 2px solid var(--ren0vate-accent) !important; transform: scale(1.02); z-index: 1;">
        <div class="card-header text-white text-center py-3" style="background: var(--ren0vate-primary);">
          <% if is_rec_ind %>
            <div class="mb-2"><span class="badge px-3 py-1 fw-bold" style="background: var(--ren0vate-accent); border: 2px solid white; border-radius: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.25);"><i class="bi bi-star-fill me-1"></i>Recommandé pour vous</span></div>
          <% elsif @current_user_context[:current_tier] == :individual %>
            <div class="mb-2"><span class="badge px-3 py-1" style="background: var(--ren0vate-accent); border: 2px solid white; border-radius: 20px;"><i class="bi bi-check-circle me-1"></i>Formule actuelle</span></div>
          <% else %>
            <div class="mb-2"><span class="badge px-3 py-1 fw-bold" style="background: var(--ren0vate-accent); border: 2px solid white; border-radius: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.25);"><i class="bi bi-star-fill me-1"></i>Le plus populaire</span></div>
          <% end %>
          <h4 class="card-title mb-1"><%= individual[:name] %></h4>
          <div class="pricing-price my-2">
            <span class="h2 fw-bold"><%= individual[:price] %>€</span><span>/mois</span>
          </div>
          <small><%= individual[:description] %></small>
        </div>
        <div class="card-body">
          <div class="alert alert-primary bg-light border-primary mb-3 py-2">
            <small><i class="bi bi-graph-up-arrow me-1"></i><%= individual[:roi] %></small>
          </div>
          <ul class="list-unstyled">
            <% individual[:features].each do |f| %>
              <%= render_pricing_feature(f, small: true) %>
            <% end %>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center">
          <% if @current_user_context[:current_tier] == :individual %>
            <button class="btn btn-primary btn-lg w-100" disabled>
              <i class="bi bi-check-circle me-2"></i>Formule actuelle
            </button>
          <% else %>
            <%= link_to pricing_summary_path(tier: :individual), class: "btn btn-primary btn-lg w-100 shadow" do %>
              <i class="bi bi-rocket-takeoff me-2"></i><%= individual[:cta] %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- INVESTISSEUR (89€) -->
    <div class="col-12 col-md-6 col-lg-6 col-xl-3" data-tier-key="portfolio">
      <% portfolio = @pricing_tiers[:portfolio] %>
      <% is_rec_port = @current_user_context[:recommended_tier] == :portfolio %>
      <div class="card h-100 border-warning <%= 'shadow-lg' if is_rec_port %>">
        <div class="card-header bg-warning text-dark text-center py-3">
          <% if is_rec_port %>
            <div class="mb-2"><span class="badge bg-white text-dark px-3 py-1 fw-bold"><i class="bi bi-star-fill me-1"></i>Recommandé pour vous</span></div>
          <% elsif @current_user_context[:current_tier] == :portfolio %>
            <div class="mb-2"><span class="badge bg-white text-dark px-3 py-1"><i class="bi bi-check-circle me-1"></i>Formule actuelle</span></div>
          <% else %>
            <div class="mb-2"><span class="badge bg-dark text-white px-3 py-1"><i class="bi bi-camera-video me-1"></i>Suivi chantier IA</span></div>
          <% end %>
          <h4 class="card-title mb-1"><%= portfolio[:name] %></h4>
          <div class="pricing-price my-2">
            <span class="h2 fw-bold"><%= portfolio[:price] %>€</span><span>/mois</span>
          </div>
          <small><%= portfolio[:description] %></small>
        </div>
        <div class="card-body">
          <div class="alert alert-warning bg-light border-warning mb-3 py-2">
            <small><i class="bi bi-graph-up-arrow me-1"></i><%= portfolio[:roi] %></small>
          </div>
          <ul class="list-unstyled">
            <% portfolio[:features].each do |f| %>
              <%= render_pricing_feature(f, small: true) %>
            <% end %>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center">
          <% if @current_user_context[:current_tier] == :portfolio %>
            <button class="btn btn-warning btn-lg w-100 text-dark" disabled>
              <i class="bi bi-check-circle me-2"></i>Formule actuelle
            </button>
          <% else %>
            <%= link_to pricing_summary_path(tier: :portfolio), class: "btn btn-warning btn-lg w-100 text-dark" do %>
              <i class="bi bi-crown me-2"></i><%= portfolio[:cta] %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- PREMIUM (149€) -->
    <div class="col-12 col-md-6 col-lg-6 col-xl-3" data-tier-key="premium_mixed">
      <% premium = @pricing_tiers[:premium_mixed] %>
      <% is_rec_prem = @current_user_context[:recommended_tier] == :premium_mixed %>
      <div class="card h-100 border-danger <%= 'shadow-lg' if is_rec_prem %>">
        <div class="card-header bg-danger text-white text-center py-3">
          <% if is_rec_prem %>
            <div class="mb-2"><span class="badge bg-white text-danger px-3 py-1 fw-bold"><i class="bi bi-star-fill me-1"></i>Recommandé pour vous</span></div>
          <% elsif @current_user_context[:current_tier] == :premium_mixed %>
            <div class="mb-2"><span class="badge bg-white text-danger px-3 py-1"><i class="bi bi-check-circle me-1"></i>Formule actuelle</span></div>
          <% end %>
          <h4 class="card-title mb-1"><%= premium[:name] %></h4>
          <div class="pricing-price my-2">
            <span class="h2 fw-bold"><%= premium[:price] %>€</span><span>/mois</span>
          </div>
          <small><%= premium[:description] %></small>
        </div>
        <div class="card-body">
          <div class="alert alert-danger bg-light border-danger mb-3 py-2">
            <small><i class="bi bi-trophy me-1"></i><%= premium[:roi] %></small>
          </div>
          <ul class="list-unstyled">
            <% premium[:features].each do |f| %>
              <%= render_pricing_feature(f, small: true) %>
            <% end %>
          </ul>
        </div>
        <div class="card-footer bg-transparent text-center">
          <% if @current_user_context[:current_tier] == :premium_mixed %>
            <button class="btn btn-danger btn-lg w-100" disabled>
              <i class="bi bi-check-circle me-2"></i>Formule actuelle
            </button>
          <% else %>
            <%= link_to pricing_summary_path(tier: :premium_mixed), class: "btn btn-danger btn-lg w-100" do %>
              <i class="bi bi-gem me-2"></i><%= premium[:cta] %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <hr class="my-4">

  <!-- OFFRES PROFESSIONNELS -->
  <div id="offres-professionnels" class="row mb-4">
    <div class="col-12 text-center mb-4">
      <h2 class="fw-bold text-success">
        <i class="bi bi-briefcase me-2"></i>
        Offres Professionnels
      </h2>
      <p class="text-muted">Pour architectes, entrepreneurs et bureaux d'études</p>
    </div>
  </div>

  <!-- Bannière IA Pro — nouveau différenciateur clé -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #1e293b 0%, #334155 60%, #065f46 100%); box-shadow: 0 8px 32px rgba(0,0,0,0.18);">
        <div class="p-4 p-md-5 text-white d-flex flex-column flex-md-row align-items-center gap-4">

          <!-- Icône -->
          <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
               style="width: 80px; height: 80px; background: rgba(255,255,255,0.12); font-size: 2.4rem; min-width: 80px;">
            <i class="bi bi-robot"></i>
          </div>

          <!-- Texte -->
          <div class="flex-grow-1 text-center text-md-start">
            <div class="mb-2">
              <span class="badge px-3 py-1 fw-semibold" style="background: #D97706; border-radius: 20px; font-size: 0.78rem; letter-spacing: 0.05em;">
                <i class="bi bi-stars me-1"></i>NOUVEAU · Inclus dans toutes les offres Pro
              </span>
            </div>
            <h3 class="fw-bold mb-3" style="font-size: 1.5rem; color: #fff;">
              Expert IA dédié à vos chantiers
            </h3>
            <div class="d-flex flex-column gap-2" style="font-size: 0.95rem; max-width: 560px;">
              <div class="d-flex align-items-start gap-2">
                <i class="bi bi-chat-dots-fill flex-shrink-0 mt-1" style="color: #D97706;"></i>
                <span class="opacity-90">
                  Posez toutes vos questions sur vos projets clients — primes, avancement, documents, réglementations —
                  et obtenez des réponses <strong style="color:#fff;">contextualisées à chaque dossier</strong>.
                </span>
              </div>
              <div class="d-flex align-items-start gap-2">
                <i class="bi bi-file-earmark-check-fill flex-shrink-0 mt-1" style="color: #34d399;"></i>
                <span class="opacity-90">
                  Générez des <strong style="color:#fff;">bordereaux d'avancement IA</strong> par chantier — suivi travaux,
                  état des factures et primes déclenchées en un clic.
                </span>
              </div>
            </div>
          </div>

          <!-- Mini-démo visuelle -->
          <div class="flex-shrink-0 d-none d-lg-block" style="min-width: 220px;">
            <div class="rounded-3 p-3" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); font-size: 0.82rem;">
              <div class="d-flex align-items-start gap-2 mb-3">
                <span class="rounded-circle bg-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width:26px;height:26px;font-size:0.75rem;min-width:26px;"><i class="bi bi-person-fill"></i></span>
                <div class="rounded-3 px-3 py-2" style="background: rgba(255,255,255,0.12);">
                  « Quelles primes pour le projet Dupont à Liège ? »
                </div>
              </div>
              <div class="d-flex align-items-start gap-2">
                <span class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:26px;height:26px;font-size:0.75rem;min-width:26px;background:#065f46;"><i class="bi bi-robot"></i></span>
                <div class="rounded-3 px-3 py-2" style="background: rgba(6,95,70,0.45);">
                  Prime Énergie + RénoWall : ~8 400 € estimés ✓
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 justify-content-center mb-4 pt-4">

    <!-- PRO (99€) -->
    <div class="col-12 col-lg-6 col-xl-5" data-tier-key="professional">
      <% pro = @pricing_tiers[:professional] %>
      <div class="card h-100 border-success position-relative
        <%= 'shadow-lg' if @current_user_context[:recommended_tier] == :professional %>">
        <% if @current_user_context[:current_tier] == :professional %>
          <div class="position-absolute top-0 end-0 m-2">
            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Actuel</span>
          </div>
        <% end %>
        <div class="card-header bg-success text-white text-center py-3">
          <div class="mb-2">
            <span class="badge px-2 py-1 fw-semibold" style="background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.4);border-radius:20px;font-size:.72rem;">
              <i class="bi bi-gift me-1"></i>14 jours gratuits &middot; sans carte bancaire
            </span>
          </div>
          <h4 class="card-title mb-1"><%= pro[:name] %></h4>
          <div class="pricing-price my-2">
            <span class="h2 fw-bold"><%= pro[:price] %>€</span><span>/mois</span>
          </div>
          <small><%= pro[:description] %></small>
        </div>
        <div class="card-body">
          <div class="alert alert-success bg-light border-success mb-3 py-2">
            <small><i class="bi bi-graph-up-arrow me-1"></i><%= pro[:roi] %></small>
          </div>
          <div class="row">
            <div class="col-12 col-sm-6">
              <ul class="list-unstyled">
                <% pro[:features].first((pro[:features].length / 2.0).ceil).each do |f| %>
                  <%= render_pricing_feature(f, small: true) %>
                <% end %>
              </ul>
            </div>
            <div class="col-12 col-sm-6">
              <ul class="list-unstyled">
                <% pro[:features].last(pro[:features].length / 2).each do |f| %>
                  <%= render_pricing_feature(f, small: true) %>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
        <div class="card-footer bg-transparent text-center">
          <% if @current_user_context[:current_tier] == :professional %>
            <button class="btn btn-success btn-lg w-100" disabled>
              <i class="bi bi-check-circle me-2"></i>Formule actuelle
            </button>
          <% else %>
            <%= link_to pricing_summary_path(tier: :professional), class: "btn btn-success btn-lg w-100" do %>
              <i class="bi bi-play-circle me-2"></i>Démarrer mon essai gratuit
            <% end %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- ENTREPRISE (299€) -->
    <div class="col-12 col-lg-6 col-xl-5" data-tier-key="enterprise">
      <% ent = @pricing_tiers[:enterprise] %>
      <div class="card h-100 border-dark position-relative
        <%= 'shadow-lg' if @current_user_context[:recommended_tier] == :enterprise %>">
        <% if @current_user_context[:current_tier] == :enterprise %>
          <div class="position-absolute top-0 end-0 m-2">
            <span class="badge bg-dark"><i class="bi bi-check-circle me-1"></i>Actuel</span>
          </div>
        <% end %>
        <div class="card-header bg-dark text-white text-center py-3">
          <h4 class="card-title mb-1"><%= ent[:name] %></h4>
          <div class="pricing-price my-2">
            <span class="h2 fw-bold"><%= ent[:price] %>€</span><span>/mois</span>
          </div>
          <small><%= ent[:description] %></small>
        </div>
        <div class="card-body">
          <div class="alert bg-light border-secondary mb-3 py-2">
            <small><i class="bi bi-award me-1"></i><%= ent[:roi] %></small>
          </div>
          <div class="row">
            <div class="col-12 col-sm-6">
              <ul class="list-unstyled">
                <% ent[:features].first((ent[:features].length / 2.0).ceil).each do |f| %>
                  <%= render_pricing_feature(f, small: true) %>
                <% end %>
              </ul>
            </div>
            <div class="col-12 col-sm-6">
              <ul class="list-unstyled">
                <% ent[:features].last(ent[:features].length / 2).each do |f| %>
                  <%= render_pricing_feature(f, small: true) %>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
        <div class="card-footer bg-transparent text-center">
          <% if @current_user_context[:current_tier] == :enterprise %>
            <button class="btn btn-dark btn-lg w-100" disabled>
              <i class="bi bi-check-circle me-2"></i>Formule actuelle
            </button>
          <% else %>
            <a href="mailto:robin@architecht.be?subject=Offre Entreprise Ren0vate" class="btn btn-dark btn-lg w-100">
              <i class="bi bi-envelope me-2"></i><%= ent[:cta] %>
            </a>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <!-- Garantie + Questions — fusionnées en un seul bandeau compact -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="bg-light p-4 rounded-3 d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3">
        <div>
          <h5 class="mb-1">
            <i class="bi bi-shield-check text-success me-2"></i>
            Garantie 30 jours satisfait ou remboursé
          </h5>
          <p class="text-muted mb-0 small">
            Testez votre nouvelle formule sans risque — activation immédiate, upgrade facile, remboursement intégral sous 30 jours.
          </p>
        </div>
        <div class="btn-group flex-shrink-0" role="group">
          <a href="mailto:robin@architecht.be" class="btn btn-outline-primary">
            <i class="bi bi-envelope me-2"></i>Nous écrire
          </a>
          <%= link_to dashboard_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-house me-2"></i>Retour au dashboard
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div><%# /container-fluid %>

<style nonce="<%= content_security_policy_nonce %>">
.card { transition: all 0.3s ease; }
.card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.15); }
.pricing-price { margin: 0.75rem 0; }

/* Steps */
.step-circle-sel {
  width: 36px; height: 36px; border-radius: 50%;
  border: 2px solid #dee2e6; background: #f8f9fa;
  color: #6c757d; display: flex; align-items: center;
  justify-content: center; font-weight: 700; font-size: .9rem;
}
.step-circle-sel.active-step {
  background: var(--ren0vate-primary, #0d6efd);
  border-color: var(--ren0vate-primary, #0d6efd);
  color: #fff;
  box-shadow: 0 0 0 4px rgba(13,110,253,.15);
}
.step-label-sel { font-size: .8rem; }
@media (max-width: 768px) {
  .card { transform: none !important; margin-bottom: 2rem; }
  .card:hover { transform: translateY(-2px); }
}
</style>
