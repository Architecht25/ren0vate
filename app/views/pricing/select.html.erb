<style nonce="<%= content_security_policy_nonce %>">
.card { transition: all 0.3s ease; }
.card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.15); }
.actor-card { cursor: pointer; }
.actor-card:hover { border-width: 2px !important; }
.pricing-price { margin: 0.75rem 0; }

/* Sidebar flottant — visible uniquement si assez de place hors container-xl */
#pricing-floating-sidebar {
  display: none;
}
@media (min-width: 1640px) {
  #pricing-floating-sidebar {
    display: block;
    position: fixed;
    right: 1.25rem;
    top: 80px;
    width: 268px;
    z-index: 400;
    max-height: calc(100vh - 96px);
    overflow-y: auto;
  }
}
/* Steps */
.step-circle-sel {
  width: 36px; height: 36px; border-radius: 50%;
  border: 2px solid #dee2e6; background: #f8f9fa;
  color: #6c757d; display: flex; align-items: center;
  justify-content: center; font-weight: 700; font-size: .9rem;
}
.step-circle-sel.active-step {
  background: var(--ren0vate-primary, #0d6efd);
  border-color: var(--ren0vate-primary, #0d6efd);
  color: #fff;
  box-shadow: 0 0 0 4px rgba(13,110,253,.15);
}
.step-label-sel { font-size: .8rem; }
@media (max-width: 768px) {
  .card { transform: none !important; margin-bottom: 2rem; }
  .card:hover { transform: translateY(-2px); }
}
</style>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('DOMContentLoaded', function () {
  const tiers = {
    freemium:     { name: 'Starter',       price: '0€',    period: '/mois', desc: 'Découverte gratuite — sans engagement',   href: null,    icon: 'bi bi-gift',       color: '#6c757d' },
    individual:   { name: 'Propriétaire',  price: '39€',   period: '/mois', desc: 'Gérez votre rénovation de A à Z',       href: '<%= pricing_summary_path(tier: :individual) %>',   icon: 'bi bi-house',      color: 'var(--ren0vate-primary,#0d6efd)' },
    portfolio:    { name: 'Investisseur',  price: '89€',   period: '/mois', desc: 'Multi-biens + suivi chantier IA',       href: '<%= pricing_summary_path(tier: :portfolio) %>',    icon: 'bi bi-buildings',  color: '#ca8a04' },
    premium_mixed:{ name: 'Premium',       price: '149€',  period: '/mois', desc: 'Multi-biens + usage professionnel',     href: '<%= pricing_summary_path(tier: :premium_mixed) %>', icon: 'bi bi-gem',        color: '#dc3545' },
    professional: { name: 'Pro',           price: '99€',   period: '/mois', desc: 'Architectes & entrepreneurs',           href: '<%= pricing_summary_path(tier: :professional) %>', icon: 'bi bi-briefcase',  color: '#198754' },
    enterprise:   { name: 'Entreprise',    price: '299€',  period: '/mois', desc: 'Syndics, promoteurs & grandes équipes', href: 'mailto:hello@ren0vate.be', icon: 'bi bi-building', color: '#212529' }
  };

  const elHeader   = document.getElementById('sticky-sel-header');
  const elIcon     = document.getElementById('sticky-sel-icon');
  const elName     = document.getElementById('sticky-sel-name');
  const elDesc     = document.getElementById('sticky-sel-desc');
  const elPrice    = document.getElementById('sticky-sel-price');
  const elPeriod   = document.getElementById('sticky-sel-period');
  const elCta      = document.getElementById('sticky-sel-cta');
  const elPlaceholder = document.getElementById('sticky-sel-placeholder');

  if (!elName) return;

  function updateSidebar(tierKey) {
    const t = tiers[tierKey];
    if (!t) return;
    elHeader.style.background = t.color;
    elIcon.className           = t.icon + ' fs-5';
    elIcon.style.color         = t.color;
    elName.textContent         = t.name;
    elDesc.textContent         = t.desc;
    elPrice.textContent        = t.price;
    elPrice.style.color        = t.color;
    elPeriod.textContent       = t.period;
    if (t.href) {
      elCta.href = t.href;
      elCta.style.background   = t.color;
      elCta.style.borderColor  = t.color;
      elCta.classList.remove('d-none');
      elPlaceholder.classList.add('d-none');
    } else {
      elCta.classList.add('d-none');
      elPlaceholder.innerHTML = '<i class="bi bi-check-circle-fill text-success me-2"></i>Starter gratuit — aucun paiement requis';
      elPlaceholder.classList.remove('d-none');
    }
  }

  document.querySelectorAll('[data-tier-key]').forEach(function (col) {
    col.addEventListener('mouseenter', function () { updateSidebar(this.dataset.tierKey); });
    col.addEventListener('click',      function () { updateSidebar(this.dataset.tierKey); });
  });

  // Init avec la formule recommandée
  updateSidebar('<%= @current_user_context[:recommended_tier] %>');
});
</script>
