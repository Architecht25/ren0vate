<% content_for :title, "PV de Réception — #{@project.nom}" %>

<style>
  body { font-size: 12px; font-family: Arial, sans-serif; color: #222; }
  .pv-section { margin-bottom: 22px; page-break-inside: avoid; }
  .pv-section h3 { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
                   color: #1e3a5f; border-bottom: 2px solid #1e3a5f; padding-bottom: 3px; margin-bottom: 10px; }
  .info-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; font-size: 11px; }
  .info-cell .label { color: #888; margin-bottom: 1px; }
  .info-cell .val { font-weight: 600; }
  table { width: 100%; border-collapse: collapse; font-size: 11px; }
  th { background: #f0f4f8; font-weight: 700; text-align: left; padding: 5px 7px; border: 1px solid #ddd; }
  td { padding: 5px 7px; border: 1px solid #eee; vertical-align: top; }
  .sig-box { border: 1px solid #ccc; border-radius: 4px; padding: 10px; min-height: 60px; }
  .sig-label { font-size: 9px; font-weight: 700; text-transform: uppercase; color: #888; margin-bottom: 3px; }
  .sig-name { font-size: 13px; font-weight: 600; }
  .sig-date { font-size: 10px; color: #555; margin-top: 3px; }
  .sig-commentaire { font-style: italic; color: #666; font-size: 10px; margin-top: 3px; }
  .sig-pending { color: #aaa; font-style: italic; font-size: 10px; margin-top: 6px; border-top: 1px dashed #ddd; padding-top: 6px; }
  .lot-box { border: 1px solid #e0e0e0; border-radius: 4px; padding: 6px 8px; margin-bottom: 5px; }
  .badge-small { font-size: 9px; padding: 1px 5px; border-radius: 3px; border: 1px solid #ccc; background: #f5f5f5; }
  .badge-accept { background: #d1fae5; border-color: #6ee7b7; color: #065f46; }
  .badge-reserve { background: #fef3c7; border-color: #fcd34d; color: #92400e; }
  .badge-refuse { background: #fee2e2; border-color: #fca5a5; color: #991b1b; }
  .garantie-box { border: 1px solid #e0e8f0; border-radius: 4px; padding: 8px 12px; margin-bottom: 5px; display: flex; justify-content: space-between; align-items: center; }
  .garantie-label { font-weight: 600; font-size: 11px; }
  .garantie-sub { color: #888; font-size: 9px; }
  .garantie-date { font-weight: 700; color: #1e3a5f; font-size: 11px; }
  .clause-box { border: 1px solid #1e3a5f; border-radius: 4px; padding: 10px 14px; background: #f8f9fa; font-size: 11px; font-style: italic; }
  @media print { .no-print { display: none !important; } }
</style>

<div class="no-print container py-3 d-flex gap-2">
  <button onclick="window.print()" class="btn btn-primary btn-sm">
    <i class="bi bi-printer me-1"></i>Imprimer / Enregistrer en PDF
  </button>
  <%= link_to project_pv_reception_path(@project), class: "btn btn-outline-secondary btn-sm" do %>
    <i class="bi bi-arrow-left me-1"></i>Retour
  <% end %>
</div>

<div style="max-width:860px;margin:0 auto;padding:24px;">

  <%# ── En-tête officiel ── %>
  <div style="display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:20px;border-bottom:3px solid #1e3a5f;padding-bottom:12px;">
    <div>
      <div style="font-size:9px;color:#888;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Document officiel</div>
      <div style="font-size:20px;font-weight:700;color:#1e3a5f;">Procès-Verbal de Réception de Chantier</div>
      <div style="font-size:12px;color:#555;">Ren0vate — Gestion numérique de projets de rénovation</div>
    </div>
    <div style="text-align:right;font-size:11px;color:#666;">
      <strong>Référence PV n°<%= @pv.id %></strong><br>
      Généré le <%= Date.today.strftime('%d/%m/%Y') %>
    </div>
  </div>

  <%# ── 1. Informations générales ── %>
  <div class="pv-section">
    <h3>1. Informations générales</h3>
    <div class="info-grid">
      <div class="info-cell"><div class="label">Projet</div><div class="val"><%= @project.nom %></div></div>
      <div class="info-cell"><div class="label">Adresse du bien</div><div class="val"><%= @project.property&.adresse.presence || "—" %></div></div>
      <div class="info-cell">
        <div class="label">Date de réception</div>
        <div class="val">
          <%= @pv.date_reception ? @pv.date_reception.strftime('%d/%m/%Y') : '—' %>
          <% if @pv.heure_reception.present? %> à <%= @pv.heure_reception %><% end %>
        </div>
      </div>
      <div class="info-cell"><div class="label">Météo</div><div class="val"><%= @pv.meteo.presence || "—" %></div></div>
      <div class="info-cell"><div class="label">Maître d'ouvrage</div><div class="val"><%= @pv.nom_owner.presence || "—" %></div></div>
      <div class="info-cell"><div class="label">Architecte</div><div class="val"><%= @pv.nom_architect.presence || "—" %></div></div>
      <div class="info-cell"><div class="label">Entrepreneur</div><div class="val"><%= @pv.nom_entrepreneur.presence || "—" %></div></div>
      <div class="info-cell"><div class="label">Coordinateur SPS</div><div class="val"><%= @pv.coordinateur_sps.presence || "—" %></div></div>
    </div>
    <% if @pv.observations.present? %>
      <div style="margin-top:8px;font-size:11px;"><span style="color:#888;">Observations :</span> <%= @pv.observations %></div>
    <% end %>
  </div>

  <%# ── 2. Participants ── %>
  <div class="pv-section">
    <h3>2. Participants</h3>
    <table>
      <thead><tr><th style="width:50%;">Présents</th><th>Absents / excusés</th></tr></thead>
      <tbody>
        <tr>
          <td><%= @pv.presents.presence || "—" %></td>
          <td><%= @pv.absents.presence || "—" %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <%# ── 3. Lots réceptionnés ── %>
  <% lots = @pv.lots_reception_liste %>
  <% if lots.any? %>
    <div class="pv-section">
      <h3>3. Lots réceptionnés (<%= lots.size %>)</h3>
      <table>
        <thead>
          <tr>
            <th style="width:5%;">#</th>
            <th style="width:25%;">Intitulé</th>
            <th style="width:25%;">Entreprise</th>
            <th style="width:20%;">Statut réception</th>
            <th>Observations</th>
          </tr>
        </thead>
        <tbody>
          <% lots.each_with_index do |lot, i| %>
            <%
              sta = lot[:statut_reception] || "accepte"
              sta_badge = case sta
                          when "accepte"               then "badge-accept"
                          when "accepte_avec_reserves" then "badge-reserve"
                          when "refuse"                then "badge-refuse"
                          else ""
                          end
              sta_label = case sta
                          when "accepte"               then "Accepté"
                          when "accepte_avec_reserves" then "Accepté avec réserves"
                          when "refuse"                then "Refusé"
                          else sta
                          end
            %>
            <tr>
              <td><%= lot[:numero].presence || (i + 1) %></td>
              <td><%= lot[:intitule].presence || "—" %></td>
              <td><%= lot[:entreprise].presence || "—" %></td>
              <td><span class="badge-small <%= sta_badge %>"><%= sta_label %></span></td>
              <td><%= lot[:observations].presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%# ── 4. Réserves constatées ── %>
  <% reserves = @pv.reserves_liste %>
  <div class="pv-section">
    <h3><%= lots.any? ? '4' : '3' %>. Réserves constatées (<%= reserves.size %>)</h3>
    <% if reserves.any? %>
      <table>
        <thead>
          <tr>
            <th>#</th><th>Description</th><th>Responsable</th><th>Statut</th><th>Délai</th>
          </tr>
        </thead>
        <tbody>
          <% reserves.each_with_index do |r, i| %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= r["description"] %></td>
              <td><%= r["responsable"].presence || "—" %></td>
              <td><span class="badge-small"><%= r["statut"] %></span></td>
              <td><%= r["date_limite"].presence || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div style="color:#198754;padding:6px 0;">
        <strong>✓ Réception sans réserve</strong> — Le chantier est accepté sans observation particulière.
      </div>
    <% end %>
  </div>

  <%# ── 5. Signatures des parties ── %>
  <% sec_num = lots.any? ? 5 : 4 %>
  <div class="pv-section">
    <h3><%= sec_num %>. Signatures des parties</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">

      <div class="sig-box">
        <div class="sig-label">Maître d'ouvrage</div>
        <div class="sig-name"><%= @pv.nom_owner.presence || "—" %></div>
        <div style="font-size:10px;color:#777;"><%= @pv.email_owner %></div>
        <% if @pv.signed_owner? %>
          <div class="sig-date">✓ Signé le <%= @pv.signed_owner_at.strftime('%d/%m/%Y à %H:%M') %></div>
          <% if @pv.commentaire_owner.present? %>
            <div class="sig-commentaire">"<%= @pv.commentaire_owner %>"</div>
          <% end %>
        <% else %>
          <div class="sig-pending">⏳ Signature en attente</div>
        <% end %>
      </div>

      <% if @pv.email_architect.present? %>
        <div class="sig-box">
          <div class="sig-label">Architecte</div>
          <div class="sig-name"><%= @pv.nom_architect.presence || "—" %></div>
          <div style="font-size:10px;color:#777;"><%= @pv.email_architect %></div>
          <% if @pv.signed_architect? %>
            <div class="sig-date">✓ Signé le <%= @pv.signed_architect_at.strftime('%d/%m/%Y à %H:%M') %></div>
            <% if @pv.commentaire_architect.present? %>
              <div class="sig-commentaire">"<%= @pv.commentaire_architect %>"</div>
            <% end %>
          <% else %>
            <div class="sig-pending">⏳ Signature en attente</div>
          <% end %>
        </div>
      <% end %>

      <% if @pv.email_entrepreneur.present? %>
        <div class="sig-box">
          <div class="sig-label">Entrepreneur</div>
          <div class="sig-name"><%= @pv.nom_entrepreneur.presence || "—" %></div>
          <div style="font-size:10px;color:#777;"><%= @pv.email_entrepreneur %></div>
          <% if @pv.signed_entrepreneur? %>
            <div class="sig-date">✓ Signé le <%= @pv.signed_entrepreneur_at.strftime('%d/%m/%Y à %H:%M') %></div>
            <% if @pv.commentaire_entrepreneur.present? %>
              <div class="sig-commentaire">"<%= @pv.commentaire_entrepreneur %>"</div>
            <% end %>
          <% else %>
            <div class="sig-pending">⏳ Signature en attente</div>
          <% end %>
        </div>
      <% end %>

    </div>
  </div>

  <%# ── 6. Délais de garantie (calculés depuis date_reception) ── %>
  <% if @pv.date_reception.present? %>
    <div class="pv-section">
      <h3><%= sec_num + 1 %>. Délais de garantie légaux</h3>
      <div class="garantie-box">
        <div>
          <div class="garantie-label">Garantie biennale</div>
          <div class="garantie-sub">Équipements dissociables — art. 1792-3 C.civ.</div>
        </div>
        <div class="garantie-date">jusqu'au <%= @pv.garantie_biennale_jusqu_au.strftime('%d/%m/%Y') %></div>
      </div>
      <div class="garantie-box">
        <div>
          <div class="garantie-label">Garantie décennale</div>
          <div class="garantie-sub">Solidité structure et étanchéité — art. 1792 C.civ.</div>
        </div>
        <div class="garantie-date">jusqu'au <%= @pv.garantie_decennale_jusqu_au.strftime('%d/%m/%Y') %></div>
      </div>
    </div>
  <% end %>

  <%# ── Clause de réception ── %>
  <div class="clause-box" style="margin-top:20px;">
    <strong>Clause de réception :</strong>
    <% if reserves.any? %>
      La présente réception est prononcée <strong>avec réserves</strong>. L'entrepreneur s'engage à lever les réserves
      dans les délais convenus, sous peine de mise en demeure. La réception définitive ne sera acquise qu'après
      levée contradictoire de l'ensemble des réserves.
    <% else %>
      La présente réception est prononcée <strong>sans réserve</strong>. Le chantier est accepté en l'état par toutes les parties.
      Elle constitue le point de départ des délais de garantie légaux (biennale et décennale).
    <% end %>
    En droit belge (art. 1792 et 2270 C.civ.), la réception des travaux marque le transfert de la garde
    de l'ouvrage au maître d'ouvrage et le point de départ de la responsabilité décennale de l'entrepreneur.
    Ce document est généré et archivé via la plateforme Ren0vate.
  </div>

  <%# ── Pied de page ── %>
  <div style="font-size:10px;color:#aaa;border-top:1px solid #eee;margin-top:20px;padding-top:10px;text-align:center;">
    Ren0vate · Gestion numérique de projets de rénovation · Belgique ·
    PV de Réception n°<%= @pv.id %> · Projet <%= @project.nom %>
  </div>

</div>
