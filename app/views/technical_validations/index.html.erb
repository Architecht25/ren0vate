<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-check-circle"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Validations Techniques</h1>
        <small class="text-muted">Gestion centralisée des validations techniques</small>
      </div>
    </div>
    <div class="text-muted">
      <i class="bi bi-file-earmark-check me-1"></i>
      <span id="total-validations"><%= @validations.count %></span> validation(s)
    </div>
  </div>

  <!-- Filtres et statistiques -->
  <div class="row mb-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <%= form_with url: technical_validations_path, method: :get, local: true, class: "row g-3" do |form| %>
            <div class="col-md-3">
              <%= form.select :status,
                              options_for_select([
                                ['Tous les statuts', ''],
                                ['En attente', 'pending'],
                                ['Validé', 'validated'],
                                ['Rejeté', 'rejected'],
                                ['En révision', 'under_review']
                              ], params[:status]),
                              {}, { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <%= form.select :region,
                              options_for_select([
                                ['Toutes les régions', ''],
                                ['Wallonie', 'wallonie'],
                                ['Bruxelles', 'bruxelles'],
                                ['Flandre', 'flandre']
                              ], params[:region]),
                              {}, { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <%= form.select :priority,
                              options_for_select([
                                ['Toutes priorités', ''],
                                ['Urgente', 'urgent'],
                                ['Haute', 'high'],
                                ['Normale', 'normal']
                              ], params[:priority]),
                              {}, { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <div class="d-flex gap-2">
                <%= form.submit "Filtrer", class: "btn btn-primary flex-grow-1" %>
                <%= link_to technical_validations_path, class: "btn btn-outline-secondary" do %>
                  <i class="bi bi-arrow-clockwise"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body text-center">
          <div class="row g-3">
            <div class="col-4">
              <div class="text-warning">
                <i class="bi bi-clock-history fs-3"></i>
                <div class="mt-1">
                  <strong><%= @validations.where("validation_status = 'pending' OR validation_status = 'under_review'").count %></strong>
                  <br><small>En cours</small>
                </div>
              </div>
            </div>
            <div class="col-4">
              <div class="text-success">
                <i class="bi bi-check-circle fs-3"></i>
                <div class="mt-1">
                  <strong><%= @validations.where(validation_status: 'validated').count %></strong>
                  <br><small>Validées</small>
                </div>
              </div>
            </div>
            <div class="col-4">
              <div class="text-danger">
                <i class="bi bi-x-circle fs-3"></i>
                <div class="mt-1">
                  <strong><%= @validations.where(validation_status: 'rejected').count %></strong>
                  <br><small>Rejetées</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Liste des validations -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h6 class="mb-0">Liste des validations techniques</h6>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" onclick="location.reload()">
          <i class="bi bi-arrow-clockwise me-1"></i>Actualiser
        </button>
      </div>
    </div>
    <div class="card-body p-0">
      <% if @validations.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Projet</th>
                <th>Demandeur</th>
                <th>Région</th>
                <th>Type</th>
                <th>Statut</th>
                <th>Priorité</th>
                <th>Date création</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @validations.each do |validation| %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <i class="bi bi-hammer me-2 text-muted"></i>
                      <div>
                        <strong><%= truncate(validation.project.title, length: 30) %></strong>
                        <br><small class="text-muted"><%= validation.project.property.address %></small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div>
                      <%= validation.project.user.full_name %>
                      <br><small class="text-muted"><%= validation.project.user.email %></small>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-info">
                      <%= validation.project.property.region&.capitalize %>
                    </span>
                  </td>
                  <td>
                    <small class="text-muted">
                      <%= validation.project.work_type || 'Non spécifié' %>
                    </small>
                  </td>
                  <td>
                    <% status_colors = { 'pending' => 'warning', 'validated' => 'success', 'rejected' => 'danger', 'under_review' => 'info' } %>
                    <span class="badge bg-<%= status_colors[validation.validation_status] || 'secondary' %>">
                      <%= t("technical_validations.statuses.#{validation.validation_status}", default: validation.validation_status.humanize) %>
                    </span>
                  </td>
                  <td>
                    <% if validation.respond_to?(:priority) %>
                      <% priority_colors = { 'urgent' => 'danger', 'high' => 'warning', 'normal' => 'secondary' } %>
                      <span class="badge bg-<%= priority_colors[validation.priority] || 'secondary' %>">
                        <%= validation.priority&.humanize || 'Normal' %>
                      </span>
                    <% else %>
                      <span class="badge bg-secondary">Normal</span>
                    <% end %>
                  </td>
                  <td>
                    <%= l(validation.created_at.to_date) %>
                    <br><small class="text-muted"><%= time_ago_in_words(validation.created_at) %></small>
                  </td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <%= link_to project_technical_validation_path(validation.project),
                                  class: "btn btn-outline-primary btn-sm",
                                  title: "Voir les détails" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>

                      <% if validation.validation_status == 'pending' || validation.validation_status == 'under_review' %>
                        <%= link_to validate_technical_project_path(validation.project),
                                    method: :post,
                                    class: "btn btn-outline-success btn-sm",
                                    title: "Valider",
                                    data: {
                                      confirm: "Êtes-vous sûr de vouloir valider cette validation technique ?"
                                    } do %>
                          <i class="bi bi-check"></i>
                        <% end %>
                      <% end %>

                      <% if validation.validation_status != 'rejected' %>
                        <%= link_to project_path(validation.project),
                                    class: "btn btn-outline-info btn-sm",
                                    title: "Voir le projet" do %>
                          <i class="bi bi-folder"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Pagination si nécessaire -->
        <% if @validations.respond_to?(:total_pages) && @validations.total_pages > 1 %>
          <div class="card-footer">
            <%= paginate @validations %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-check-circle display-1 text-muted"></i>
          <h5 class="mt-3 text-muted">Aucune validation technique</h5>
          <p class="text-muted">
            <% if params[:status].present? || params[:region].present? || params[:priority].present? %>
              Aucune validation ne correspond aux critères sélectionnés.
            <% else %>
              Toutes les validations techniques apparaîtront ici.
            <% end %>
          </p>
          <% if params[:status].present? || params[:region].present? || params[:priority].present? %>
            <%= link_to technical_validations_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-arrow-clockwise me-2"></i>Voir toutes les validations
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
// Auto-refresh toutes les 30 secondes pour les validations en cours
setInterval(function() {
  const pendingCount = document.querySelectorAll('tbody tr .badge.bg-warning').length;
  if (pendingCount > 0) {
    // Optionnel : actualisation automatique uniquement s'il y a des validations en attente
    // location.reload();
  }
}, 30000);
</script>
