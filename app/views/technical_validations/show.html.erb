<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-shield-check"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Validation Technique</h1>
        <small class="text-muted">
          <i class="bi bi-hammer me-1"></i><%= @project.nom %>
        </small>
      </div>
    </div>
    <div>
      <%= link_to project_path(@project), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour au projet
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Résultat global -->
    <div class="col-12 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="row align-items-center">
            <div class="col-md-8">
              <div class="d-flex align-items-center mb-3">
                <% if @validation_result[:valid] %>
                  <div class="icon-circle bg-success me-3">
                    <i class="bi bi-check-lg text-white"></i>
                  </div>
                  <div>
                    <h4 class="mb-0 text-success">Validation Réussie</h4>
                    <p class="mb-0 text-muted">Votre projet respecte les exigences techniques</p>
                  </div>
                <% else %>
                  <div class="icon-circle bg-warning me-3">
                    <i class="bi bi-exclamation-triangle text-white"></i>
                  </div>
                  <div>
                    <h4 class="mb-0 text-warning">Corrections Requises</h4>
                    <p class="mb-0 text-muted">Des problèmes techniques ont été détectés</p>
                  </div>
                <% end %>
              </div>
            </div>
            <div class="col-md-4 text-end">
              <div class="mb-2">
                <span class="h2 fw-bold
                  <%= @validation_result[:validation_score] >= 80 ? 'text-success' :
                      @validation_result[:validation_score] >= 60 ? 'text-warning' : 'text-danger' %>">
                  <%= @validation_result[:validation_score] %>/100
                </span>
              </div>
              <div class="progress" style="height: 8px;">
                <div class="progress-bar
                  <%= @validation_result[:validation_score] >= 80 ? 'bg-success' :
                      @validation_result[:validation_score] >= 60 ? 'bg-warning' : 'bg-danger' %>"
                     style="width: <%= @validation_result[:validation_score] %>%"></div>
              </div>
            </div>
          </div>

          <div class="d-flex gap-2 mt-3">
            <%= button_to revalidate_project_path(@project), method: :post, class: "btn btn-primary" do %>
              <i class="bi bi-arrow-clockwise me-2"></i>Re-valider
            <% end %>
            <%= link_to validation_report_project_path(@project, format: :pdf), class: "btn btn-outline-primary" do %>
              <i class="bi bi-file-pdf me-2"></i>Rapport PDF
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Erreurs critiques -->
    <% if @validation_result[:errors].any? %>
      <div class="col-lg-6 mb-4">
        <div class="card border-danger h-100">
          <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Erreurs Critiques (<%= @validation_result[:errors].count %>)
            </h5>
          </div>
          <div class="card-body">
            <% @validation_result[:errors].each do |error| %>
              <div class="alert alert-danger d-flex align-items-start">
                <i class="bi bi-x-circle text-danger me-2 mt-1"></i>
                <div>
                  <strong><%= error[:type].humanize %></strong><br>
                  <%= error[:message] %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Avertissements -->
    <% if @validation_result[:warnings].any? %>
      <div class="col-lg-6 mb-4">
        <div class="card border-warning h-100">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Avertissements (<%= @validation_result[:warnings].count %>)
            </h5>
          </div>
          <div class="card-body">
            <% @validation_result[:warnings].each do |warning| %>
              <div class="alert alert-warning d-flex align-items-start">
                <i class="bi bi-exclamation-triangle text-warning me-2 mt-1"></i>
                <div>
                  <strong><%= warning[:type].humanize %></strong><br>
                  <%= warning[:message] %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Documents analysés -->
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">
            <i class="bi bi-file-earmark-check me-2"></i>
            Documents Analysés
          </h5>
        </div>
        <div class="card-body">
          <div class="row">
            <!-- Audit énergétique -->
            <div class="col-md-4 mb-3">
              <div class="border rounded p-3 <%= @audit_document ? 'border-success bg-success-subtle' : 'border-danger bg-danger-subtle' %>">
                <div class="d-flex align-items-center">
                  <i class="bi bi-file-earmark-medical <%= @audit_document ? 'text-success' : 'text-danger' %> me-2"></i>
                  <div>
                    <strong>Audit Énergétique</strong><br>
                    <small class="<%= @audit_document ? 'text-success' : 'text-danger' %>">
                      <%= @audit_document ? 'Présent' : 'Manquant' %>
                    </small>
                  </div>
                </div>
              </div>
            </div>

            <!-- Devis -->
            <div class="col-md-4 mb-3">
              <div class="border rounded p-3 <%= @devis_documents.any? ? 'border-success bg-success-subtle' : 'border-warning bg-warning-subtle' %>">
                <div class="d-flex align-items-center">
                  <i class="bi bi-file-earmark-text <%= @devis_documents.any? ? 'text-success' : 'text-warning' %> me-2"></i>
                  <div>
                    <strong>Devis</strong><br>
                    <small class="<%= @devis_documents.any? ? 'text-success' : 'text-warning' %>">
                      <%= @devis_documents.count %> document(s)
                    </small>
                  </div>
                </div>
              </div>
            </div>

            <!-- Photos -->
            <div class="col-md-4 mb-3">
              <div class="border rounded p-3 <%= @photo_documents.any? ? 'border-success bg-success-subtle' : 'border-warning bg-warning-subtle' %>">
                <div class="d-flex align-items-center">
                  <i class="bi bi-camera <%= @photo_documents.any? ? 'text-success' : 'text-warning' %> me-2"></i>
                  <div>
                    <strong>Photos</strong><br>
                    <small class="<%= @photo_documents.any? ? 'text-success' : 'text-warning' %>">
                      <%= @photo_documents.count %> photo(s)
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <% if (@devis_documents + [@audit_document] + @photo_documents).compact.any? %>
            <div class="mt-3">
              <h6>Actions disponibles :</h6>
              <div class="d-flex gap-2">
                <% if @audit_document %>
                  <%= link_to document_path(@audit_document), class: "btn btn-sm btn-outline-primary" do %>
                    <i class="bi bi-eye me-1"></i>Voir audit
                  <% end %>
                <% end %>
                <% if @devis_documents.any? %>
                  <%= link_to project_documents_path(@project, type_document: 'devis'), class: "btn btn-sm btn-outline-primary" do %>
                    <i class="bi bi-eye me-1"></i>Voir devis
                  <% end %>
                <% end %>
                <%= link_to project_documents_path(@project), class: "btn btn-sm btn-outline-secondary" do %>
                  <i class="bi bi-folder me-1"></i>Tous les documents
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
