<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-megaphone"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Créer une notification admin</h1>
    </div>
    <%= link_to notifications_path, class: "btn btn-outline-secondary" do %>
      <i class="bi bi-arrow-left me-2"></i>Retour
    <% end %>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <%= form_with url: create_admin_notifications_path, method: :post, local: true, class: "needs-validation", novalidate: true do |form| %>

            <!-- Type de notification -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Type de notification</label>
              <select name="notification[type]" class="form-select" required>
                <option value="">Sélectionner un type</option>
                <option value="admin_info">📢 Information générale</option>
                <option value="admin_legal">⚖️ Mise à jour légale</option>
                <option value="admin_maintenance">🔧 Maintenance système</option>
                <option value="admin_nouvelle_prime">🎉 Nouvelle prime disponible</option>
                <option value="admin_urgent">🚨 Notification urgente</option>
              </select>
            </div>

            <!-- Titre -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Titre</label>
              <input type="text" name="notification[title]" class="form-control"
                     placeholder="Ex: Nouvelle prime isolation disponible" required>
            </div>

            <!-- Message -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Message</label>
              <textarea name="notification[message]" class="form-control" rows="4"
                        placeholder="Rédigez votre message ici..." required></textarea>
            </div>

            <div class="row">
              <!-- Catégorie -->
              <div class="col-md-6 mb-4">
                <label class="form-label fw-semibold">Catégorie</label>
                <select name="notification[category]" class="form-select">
                  <option value="systeme">🔧 Système</option>
                  <option value="aide">💡 Aide</option>
                  <option value="rappel">⏰ Rappel</option>
                  <option value="nouveaute">✨ Nouveauté</option>
                  <option value="urgent">🚨 Urgent</option>
                </select>
              </div>

              <!-- Priorité -->
              <div class="col-md-6 mb-4">
                <label class="form-label fw-semibold">Priorité</label>
                <select name="notification[priority]" class="form-select">
                  <option value="normale">📝 Normale</option>
                  <option value="haute">⚡ Haute</option>
                  <option value="urgente">🔥 Urgente</option>
                </select>
              </div>
            </div>

            <!-- Ciblage -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Destinataires</label>
              <div class="border rounded p-3">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="radio" name="notification[target_type]"
                         id="target_all" value="all_users" checked
                         data-action="change->notification-targeting#toggleRegion">
                  <label class="form-check-label" for="target_all">
                    <strong>Tous les utilisateurs</strong> (<%= @users.count %> utilisateurs)
                  </label>
                </div>

                <div class="form-check mb-3">
                  <input class="form-check-input" type="radio" name="notification[target_type]"
                         id="target_region" value="by_region">
                  <label class="form-check-label" for="target_region">
                    <strong>Par région</strong>
                  </label>
                  <div class="mt-2 target-sub" id="region_select_container" style="display:none;">
                    <select name="notification[target_region]" class="form-select">
                      <option value="">-- Sélectionnez une région --</option>
                      <%
                        wallonie_count  = User.where("LOWER(region) = ?", "wallonie").count
                        flandre_count   = User.where("LOWER(region) = ?", "flandre").count
                        bruxelles_count = User.where("LOWER(region) = ?", "bruxelles").count
                      %>
                      <option value="wallonie">🏛️ Wallonie (<%= wallonie_count %> utilisateur<%= 's' if wallonie_count > 1 %>)</option>
                      <option value="flandre">🇳🇱 Flandre (<%= flandre_count %> utilisateur<%= 's' if flandre_count > 1 %>)</option>
                      <option value="bruxelles">🏢 Bruxelles (<%= bruxelles_count %> utilisateur<%= 's' if bruxelles_count > 1 %>)</option>
                    </select>
                  </div>
                </div>

                <div class="form-check mb-2">
                  <input class="form-check-input" type="radio" name="notification[target_type]"
                         id="target_primes_services" value="primes_services">
                  <label class="form-check-label" for="target_primes_services">
                    <strong>Clients Primes-Services ⭐</strong>
                    <span class="badge bg-warning text-dark ms-1"><%= User.where(primes_services_client: true).count %></span>
                  </label>
                </div>

                <div class="form-check mb-3">
                  <input class="form-check-input" type="radio" name="notification[target_type]"
                         id="target_non_primes_services" value="non_primes_services">
                  <label class="form-check-label" for="target_non_primes_services">
                    <strong>Non Primes-Services</strong>
                    <span class="badge bg-secondary ms-1"><%= User.where(primes_services_client: false).count %></span>
                  </label>
                </div>

                <div class="form-check mb-2">
                  <input class="form-check-input" type="radio" name="notification[target_type]"
                         id="target_specific" value="specific_user">
                  <label class="form-check-label" for="target_specific">
                    <strong>Utilisateur spécifique</strong>
                  </label>
                  <div class="mt-2 target-sub" id="specific_user_container" style="display:none;">
                    <input type="text" id="user_search_input" class="form-control mb-2"
                           placeholder="Rechercher par nom ou email…" autocomplete="off">
                    <select name="notification[user_ids][]" class="form-select" id="user_select" size="5">
                      <% @users.order(:last_name, :first_name).each do |u| %>
                        <option value="<%= u.id %>">
                          <%= u.full_name.presence || u.email %> — <%= u.email %>
                          <% if u.region.present? %>(<%= u.region %>)<% end %>
                        </option>
                      <% end %>
                    </select>
                    <small class="text-muted">Ctrl+clic pour sélectionner plusieurs utilisateurs</small>
                  </div>
                </div>
              </div>
            </div>

            <script nonce="<%= content_security_policy_nonce %>">
              document.addEventListener('turbo:load', function() {
                const allUsersRadio = document.getElementById('target_all');
                const regionRadio = document.getElementById('target_region');
                const entrepriseRadio = document.getElementById('target_entreprise');
                const regionContainer = document.getElementById('region_select_container');

                function updateRegionVisibility() {
                  if (regionRadio && regionRadio.checked) {
                    regionContainer.style.display = 'block';
                  } else {
                    regionContainer.style.display = 'none';
                  }
                }

                if (allUsersRadio) allUsersRadio.addEventListener('change', updateRegionVisibility);
                if (regionRadio) regionRadio.addEventListener('change', updateRegionVisibility);
                if (entrepriseRadio) entrepriseRadio.addEventListener('change', updateRegionVisibility);

                updateRegionVisibility();
              });
            </script>

            <!-- URL d'action (bouton dans l'email) -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Lien d'action (optionnel)</label>
              <input type="text" name="notification[action_url]" class="form-control"
                     placeholder="Ex: /dashboard" value="/dashboard">
              <div class="form-text">Apparaît comme bouton "Voir les détails →" dans l'email.</div>
            </div>

            <!-- Expiration -->
            <div class="mb-4">
              <label class="form-label fw-semibold">Expiration (optionnel)</label>
              <select name="notification[expires_days]" class="form-select">
                <option value="">Pas d'expiration</option>
                <option value="7">Dans 7 jours</option>
                <option value="14">Dans 14 jours</option>
                <option value="30">Dans 30 jours</option>
                <option value="90">Dans 90 jours</option>
              </select>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-end gap-2">
              <%= link_to notifications_path, class: "btn btn-secondary" do %>
                Annuler
              <% end %>
              <button type="submit" class="btn btn-primary-custom">
                <i class="bi bi-send me-2"></i>Envoyer la notification
              </button>
            </div>

          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar avec info -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h5 class="card-title">📊 Aperçu des utilisateurs</h5>

          <div class="mb-3">
            <small class="text-muted">Total des utilisateurs inscrits</small>
            <h4 class="text-primary-custom"><%= @users.count %></h4>
          </div>

          <div class="mb-3">
            <small class="text-muted">Répartition par région</small>
            <% User.group(:region).count.each do |region, count| %>
              <div class="d-flex justify-content-between">
                <span><%= region&.capitalize || 'Non définie' %></span>
                <span class="badge bg-secondary"><%= count %></span>
              </div>
            <% end %>
          </div>

          <hr>

          <h6>💡 Conseils</h6>
          <ul class="small text-muted">
            <li>Utilisez un titre clair et explicite</li>
            <li>Préférez les messages courts et directs</li>
            <li>Les notifications urgentes génèrent un email</li>
            <li>Testez avec votre propre compte d'abord</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  const radios = document.querySelectorAll('input[name="notification[target_type]"]');

  function updateVisibility() {
    const val = document.querySelector('input[name="notification[target_type]"]:checked')?.value;
    document.getElementById('region_select_container').style.display  = (val === 'by_region')    ? 'block' : 'none';
    document.getElementById('specific_user_container').style.display  = (val === 'specific_user') ? 'block' : 'none';
  }

  radios.forEach(r => r.addEventListener('change', updateVisibility));
  updateVisibility();

  // Filtre live sur la liste utilisateurs
  const searchInput = document.getElementById('user_search_input');
  const userSelect  = document.getElementById('user_select');
  if (searchInput && userSelect) {
    const allOptions = Array.from(userSelect.options);
    searchInput.addEventListener('input', function() {
      const q = this.value.toLowerCase();
      userSelect.innerHTML = '';
      allOptions
        .filter(o => o.text.toLowerCase().includes(q))
        .forEach(o => userSelect.appendChild(o.cloneNode(true)));
    });
  }
});
</script>
