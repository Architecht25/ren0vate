<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-building"></i>
      </div>
      <div>
        <h1 class="h3 text-info mb-0 fw-normal">Aide aux entreprises</h1>
        <p class="text-muted mb-0"><%= @entreprise_aide.titre %></p>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to primes_path, class: "btn btn-outline-info px-4" do %>
        <i class="bi bi-arrow-left me-2"></i>
        Retour aux primes
      <% end %>
    </div>
  </div>

  <!-- Contenu principal -->
  <div class="row justify-content-center">
    <div class="col-lg-11">
      <div class="row g-4">
        <!-- Colonne de gauche - Informations générales -->
        <div class="col-lg-5">
          <!-- Informations générales -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 text-center">
              <div class="icon-circle mx-auto mb-3" style="width: 45px; height: 45px;">
                <i class="bi bi-info-circle"></i>
              </div>
              <h6 class="card-title text-info mb-3">Informations générales</h6>
              <div class="row g-2">
                <div class="col-6">
                  <div class="bg-light rounded p-2">
                    <small class="text-muted d-block mb-1">Région</small>
                    <strong class="text-dark small"><%= @entreprise_aide.region.capitalize %></strong>
                  </div>
                </div>
                <div class="col-6">
                  <div class="bg-light rounded p-2">
                    <small class="text-muted d-block mb-1">Catégorie</small>
                    <strong class="text-dark small"><%= @entreprise_aide.categorie&.capitalize || 'N/A' %></strong>
                  </div>
                </div>
                <% if @entreprise_aide.taux_aide.present? %>
                <div class="col-6">
                  <div class="bg-light rounded p-2">
                    <small class="text-muted d-block mb-1">Taux d'aide</small>
                    <strong class="text-success small"><%= @entreprise_aide.taux_aide %>%</strong>
                  </div>
                </div>
                <% end %>
                <% if @entreprise_aide.montant_max.present? %>
                <div class="col-6">
                  <div class="bg-light rounded p-2">
                    <small class="text-muted d-block mb-1">Montant max</small>
                    <strong class="text-success small"><%= number_to_currency(@entreprise_aide.montant_max, unit: "€", separator: ",", delimiter: " ") %></strong>
                  </div>
                </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Éligibilité -->
          <% if @entreprise_aide.tailles_eligibles.present? || @entreprise_aide.secteurs_eligibles.present? %>
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
              <div class="d-flex align-items-center mb-3">
                <div class="icon-circle me-3" style="width: 32px; height: 32px;">
                  <i class="bi bi-check-circle text-success"></i>
                </div>
                <h6 class="card-title text-success mb-0">Critères d'éligibilité</h6>
              </div>

              <% if @entreprise_aide.tailles_eligibles.present? %>
              <div class="mb-3">
                <strong class="small text-dark">Tailles d'entreprises éligibles :</strong>
                <div class="mt-1">
                  <% @entreprise_aide.tailles_eligibles.each do |taille| %>
                    <span class="badge bg-success-subtle text-success me-1"><%= taille.upcase %></span>
                  <% end %>
                </div>
              </div>
              <% end %>

              <% if @entreprise_aide.secteurs_eligibles.present? %>
              <div class="mb-3">
                <strong class="small text-dark">Secteurs éligibles :</strong>
                <ul class="list-unstyled mt-1 small">
                  <% @entreprise_aide.secteurs_eligibles.each do |secteur| %>
                    <li><i class="bi bi-check text-success me-1"></i><%= secteur %></li>
                  <% end %>
                </ul>
              </div>
              <% end %>
            </div>
          </div>
          <% end %>
        </div>

        <!-- Colonne de droite - Description et détails -->
        <div class="col-lg-7">
          <!-- Description -->
          <% if @entreprise_aide.description.present? %>
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
              <div class="d-flex align-items-center mb-3">
                <div class="icon-circle me-3" style="width: 32px; height: 32px;">
                  <i class="bi bi-file-text text-info"></i>
                </div>
                <h6 class="card-title text-info mb-0">Description</h6>
              </div>
              <div class="text-muted">
                <%= simple_format(@entreprise_aide.description) %>
              </div>
            </div>
          </div>
          <% end %>

          <!-- Conditions d'éligibilité détaillées -->
          <% if @entreprise_aide.conditions_eligibilite.present? %>
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
              <div class="d-flex align-items-center mb-3">
                <div class="icon-circle me-3" style="width: 32px; height: 32px;">
                  <i class="bi bi-list-check text-warning"></i>
                </div>
                <h6 class="card-title text-warning mb-0">Conditions détaillées</h6>
              </div>
              <ul class="list-unstyled small">
                <% @entreprise_aide.conditions_eligibilite.each do |condition| %>
                  <li class="mb-2"><i class="bi bi-arrow-right text-warning me-2"></i><%= condition %></li>
                <% end %>
              </ul>
            </div>
          </div>
          <% end %>

          <!-- Documents requis -->
          <% if @entreprise_aide.documents_requis.present? %>
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3">
              <div class="d-flex align-items-center mb-3">
                <div class="icon-circle me-3" style="width: 32px; height: 32px;">
                  <i class="bi bi-file-earmark-text text-primary"></i>
                </div>
                <h6 class="card-title text-primary mb-0">Documents requis</h6>
              </div>
              <ul class="list-unstyled small">
                <% @entreprise_aide.documents_requis.each do |document| %>
                  <li class="mb-2"><i class="bi bi-file-earmark text-primary me-2"></i><%= document %></li>
                <% end %>
              </ul>
            </div>
          </div>
          <% end %>

          <!-- Action -->
          <% if @entreprise_aide.url_officielle.present? %>
          <div class="card border-0 shadow-sm">
            <div class="card-body p-3 text-center">
              <div class="icon-circle mx-auto mb-3" style="width: 45px; height: 45px;">
                <i class="bi bi-external-link"></i>
              </div>
              <h6 class="card-title text-success mb-3">Candidater</h6>
              <%= link_to @entreprise_aide.url_officielle, target: '_blank', rel: 'noopener', class: "btn btn-success px-4" do %>
                <i class="bi bi-external-link me-2"></i>
                Accéder au site officiel
              <% end %>
            </div>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
