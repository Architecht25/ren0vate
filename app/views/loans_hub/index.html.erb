<div class="container-fluid px-4 py-4">
  <div class="mb-4 pb-3 border-bottom">
    <h1 class="h3 mb-1 fw-normal" style="color:#1d4ed8;">Estimer mes prêts</h1>
    <p class="text-muted small mb-0">4 simulateurs pour financer vos travaux de rénovation</p>
  </div>

  <!-- Bandeau explicatif -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100" style="background:#eff6ff;">
        <i class="bi bi-calculator fs-4 flex-shrink-0" style="color:#1d4ed8;"></i>
        <div>
          <div class="fw-semibold small" style="color:#1e40af;">Simulez avant de signer</div>
          <div class="text-muted small mt-1">Comparez différentes durées et montants pour trouver la mensualité qui correspond à votre budget, avant toute démarche auprès d'un organisme.</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100" style="background:#f0fdf4;">
        <i class="bi bi-patch-check fs-4 flex-shrink-0" style="color:#059669;"></i>
        <div>
          <div class="fw-semibold small" style="color:#065f46;">Prêts à taux 0 % disponibles</div>
          <div class="text-muted small mt-1">Flandre, Wallonie et Bruxelles proposent des prêts à taux zéro ou réduit pour les ménages modestes. Vérifiez votre éligibilité avant d'opter pour un crédit classique.</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100" style="background:#f5f3ff;">
        <i class="bi bi-bar-chart-line fs-4 flex-shrink-0" style="color:#7c3aed;"></i>
        <div>
          <div class="fw-semibold small" style="color:#5b21b6;">Combinez prêts et primes</div>
          <div class="text-muted small mt-1">Un prêt bien calibré combiné à vos primes régionales peut couvrir la quasi-totalité du coût de votre rénovation énergétique.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- Crédit classique -->
    <div class="col-lg-3 col-md-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div style="width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#1d4ed8,#3b82f6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="bi bi-bank text-white fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Crédit bancaire classique</h5>
              <p class="text-muted small mb-0">Simulez un crédit à tempérament auprès d'une banque</p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-check-circle text-primary me-2"></i>Montant libre selon votre projet</li>
            <li><i class="bi bi-check-circle text-primary me-2"></i>Taux d'intérêt configurable</li>
            <li><i class="bi bi-check-circle text-primary me-2"></i>Durée jusqu'à 25 ans</li>
            <li><i class="bi bi-check-circle text-primary me-2"></i>Tableau d'amortissement complet</li>
          </ul>
          <%= link_to loans_hub_credit_classique_path, class: "btn w-100 fw-semibold", style: "background:linear-gradient(135deg,#1d4ed8,#3b82f6);color:#fff;border-radius:8px;" do %>
            <i class="bi bi-calculator me-2"></i>Simuler un crédit classique
          <% end %>
        </div>
      </div>
    </div>

    <!-- Mijn VerbouwLening (Flandre) -->
    <div class="col-lg-3 col-md-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div style="width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#eab308,#f59e0b);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="bi bi-house-heart text-white fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Mijn VerbouwLening</h5>
              <p class="text-muted small mb-0">Prêt à taux réduit réservé à la <strong>Flandre</strong></p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-star-fill text-warning me-2"></i>Taux de 0% à 1,5% selon revenus</li>
            <li><i class="bi bi-check-circle text-warning me-2"></i>4.000€ à 60.000€</li>
            <li><i class="bi bi-check-circle text-warning me-2"></i>Durée jusqu'à 25 ans</li>
            <li><i class="bi bi-check-circle text-warning me-2"></i>Logement raccordé avant 01/01/2006</li>
          </ul>
          <%= link_to loans_hub_verbouwlening_path, class: "btn w-100 fw-semibold", style: "background:linear-gradient(135deg,#eab308,#f59e0b);color:#fff;border-radius:8px;" do %>
            <i class="bi bi-calculator me-2"></i>Simuler le VerbouwLening
          <% end %>
        </div>
      </div>
    </div>

    <!-- Rénopack (Wallonie) -->
    <div class="col-lg-3 col-md-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div style="width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#059669,#10b981);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="bi bi-tree text-white fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Rénopack — SWCS</h5>
              <p class="text-muted small mb-0">Prêt à <strong>0%</strong> réservé à la <strong>Wallonie</strong></p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-star-fill text-success me-2"></i>Taux d'intérêt : <strong>0%</strong></li>
            <li><i class="bi bi-check-circle text-success me-2"></i>1.000€ à 60.000€</li>
            <li><i class="bi bi-check-circle text-success me-2"></i>Revenus max. 122.800€/an</li>
            <li><i class="bi bi-check-circle text-success me-2"></i>Logement de plus de 15 ans</li>
          </ul>
          <%= link_to loans_hub_renopack_path, class: "btn w-100 fw-semibold", style: "background:linear-gradient(135deg,#059669,#10b981);color:#fff;border-radius:8px;" do %>
            <i class="bi bi-calculator me-2"></i>Simuler le Rénopack
          <% end %>
        </div>
      </div>
    </div>

    <!-- Prêt EcoReno (Bruxelles) -->
    <div class="col-lg-3 col-md-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div style="width:48px;height:48px;border-radius:10px;background:linear-gradient(135deg,#7c3aed,#8b5cf6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="bi bi-wind text-white fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Prêt EcoReno</h5>
              <p class="text-muted small mb-0">Prêt à <strong>0%</strong> réservé à <strong>Bruxelles</strong></p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-star-fill text-purple me-2"></i>Taux d'intérêt : <strong>0%</strong></li>
            <li><i class="bi bi-check-circle text-purple me-2"></i>Jusqu'à 100.000€</li>
            <li><i class="bi bi-check-circle text-purple me-2"></i>Travaux de rénovation énergétique</li>
            <li><i class="bi bi-check-circle text-purple me-2"></i>Propriétaires & occupants</li>
          </ul>
          <%= link_to loans_hub_ecoreno_path, class: "btn w-100 fw-semibold", style: "background:linear-gradient(135deg,#7c3aed,#8b5cf6);color:#fff;border-radius:8px;" do %>
            <i class="bi bi-calculator me-2"></i>Simuler le Prêt EcoReno
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <p class="text-muted small mt-4 mb-0">
    <i class="bi bi-info-circle me-1"></i>
    Ces simulateurs sont indicatifs. Les résultats dépendent de votre situation personnelle et de l'organisme prêteur.
  </p>
</div>
