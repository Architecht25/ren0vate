<% content_for :title, "Simuler mes prêts – Ren0vate" %>

<div class="container-fluid px-4 py-4">
  <div class="mb-4 pb-3 border-bottom d-flex align-items-start justify-content-between gap-3">
    <div>
      <h1 class="h3 text-primary-custom mb-1 fw-normal">Simuler mes prêts</h1>
      <p class="text-muted small mb-0">4 simulateurs pour financer vos travaux de rénovation</p>
    </div>
    <% if @property %>
      <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary btn-sm flex-shrink-0" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour au bien
      <% end %>
    <% end %>
  </div>

  <!-- Bandeau explicatif -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100 bg-primary-light-ren0vate">
        <i class="bi bi-calculator fs-4 flex-shrink-0 text-primary-ren0vate"></i>
        <div>
          <div class="fw-semibold small text-primary-ren0vate">Simulez avant de signer</div>
          <div class="text-muted small mt-1">Comparez différentes durées et montants pour trouver la mensualité qui correspond à votre budget, avant toute démarche auprès d'un organisme.</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100 bg-success-light-ren0vate">
        <i class="bi bi-patch-check fs-4 flex-shrink-0 text-success-ren0vate"></i>
        <div>
          <div class="fw-semibold small text-success-ren0vate">Prêts à taux 0 % disponibles</div>
          <div class="text-muted small mt-1">Flandre, Wallonie et Bruxelles proposent des prêts à taux zéro ou réduit pour les ménages modestes. Vérifiez votre éligibilité avant d'opter pour un crédit classique.</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100 bg-accent-light-ren0vate">
        <i class="bi bi-bar-chart-line fs-4 flex-shrink-0 text-accent-ren0vate"></i>
        <div>
          <div class="fw-semibold small text-accent-ren0vate">Combinez prêts et primes</div>
          <div class="text-muted small mt-1">Un prêt bien calibré combiné à vos primes régionales peut couvrir la quasi-totalité du coût de votre rénovation énergétique.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- Crédit classique -->
    <div class="col-lg-3 col-md-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:var(--ren0vate-primary);">
              <i class="bi bi-bank text-white fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Crédit bancaire classique</h5>
              <p class="text-muted small mb-0">Simulez un crédit à tempérament auprès d'une banque</p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-check-circle me-2 text-primary-ren0vate"></i>Montant libre selon votre projet</li>
            <li><i class="bi bi-check-circle me-2 text-primary-ren0vate"></i>Taux d'intérêt configurable</li>
            <li><i class="bi bi-check-circle me-2 text-primary-ren0vate"></i>Durée jusqu'à 25 ans</li>
            <li><i class="bi bi-check-circle me-2 text-primary-ren0vate"></i>Tableau d'amortissement complet</li>
          </ul>
          <%= link_to loans_hub_credit_classique_path, class: "btn w-100 fw-semibold text-white",
                style: "background:var(--ren0vate-primary);border-color:var(--ren0vate-primary);border-radius:8px;" do %>
            <i class="bi bi-calculator me-2"></i>Simuler un crédit classique
          <% end %>
        </div>
      </div>
    </div>

    <!-- Mijn VerbouwLening (Flandre) -->
    <div class="col-lg-3 col-md-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:var(--ren0vate-accent);">
              <i class="bi bi-house-heart text-white fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Mijn VerbouwLening</h5>
              <p class="text-muted small mb-0">Prêt à taux réduit réservé à la <strong>Flandre</strong></p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-star-fill me-2 text-accent-ren0vate"></i>Taux de 0% à 1,5% selon revenus</li>
            <li><i class="bi bi-check-circle me-2 text-accent-ren0vate"></i>4.000€ à 60.000€</li>
            <li><i class="bi bi-check-circle me-2 text-accent-ren0vate"></i>Durée jusqu'à 25 ans</li>
            <li><i class="bi bi-check-circle me-2 text-accent-ren0vate"></i>Logement raccordé avant 01/01/2006</li>
          </ul>
          <%= link_to loans_hub_verbouwlening_path, class: "btn w-100 fw-semibold text-white",
                style: "background:var(--ren0vate-accent);border-color:var(--ren0vate-accent);border-radius:8px;" do %>
            <i class="bi bi-calculator me-2"></i>Simuler le VerbouwLening
          <% end %>
        </div>
      </div>
    </div>

    <!-- Rénopack (Wallonie) -->
    <div class="col-lg-3 col-md-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:var(--ren0vate-success);">
              <i class="bi bi-tree text-white fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Rénopack — SWCS</h5>
              <p class="text-muted small mb-0">Prêt à <strong>0%</strong> réservé à la <strong>Wallonie</strong></p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-star-fill me-2 text-success-ren0vate"></i>Taux d'intérêt : <strong>0%</strong></li>
            <li><i class="bi bi-check-circle me-2 text-success-ren0vate"></i>1.000€ à 60.000€</li>
            <li><i class="bi bi-check-circle me-2 text-success-ren0vate"></i>Revenus max. 122.800€/an</li>
            <li><i class="bi bi-check-circle me-2 text-success-ren0vate"></i>Logement de plus de 15 ans</li>
          </ul>
          <%= link_to loans_hub_renopack_path, class: "btn w-100 fw-semibold text-white",
                style: "background:var(--ren0vate-success);border-color:var(--ren0vate-success);border-radius:8px;" do %>
            <i class="bi bi-calculator me-2"></i>Simuler le Rénopack
          <% end %>
        </div>
      </div>
    </div>

    <!-- Prêt EcoReno (Bruxelles) -->
    <div class="col-lg-3 col-md-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;background:var(--ren0vate-primary-dark);">
              <i class="bi bi-wind text-white fs-5"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Prêt EcoReno</h5>
              <p class="text-muted small mb-0">Prêt à <strong>0%</strong> réservé à <strong>Bruxelles</strong></p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-star-fill me-2" style="color:var(--ren0vate-primary-dark);"></i>Taux d'intérêt : <strong>0%</strong></li>
            <li><i class="bi bi-check-circle me-2" style="color:var(--ren0vate-primary-dark);"></i>Jusqu'à 100.000€</li>
            <li><i class="bi bi-check-circle me-2" style="color:var(--ren0vate-primary-dark);"></i>Travaux de rénovation énergétique</li>
            <li><i class="bi bi-check-circle me-2" style="color:var(--ren0vate-primary-dark);"></i>Propriétaires &amp; occupants</li>
          </ul>
          <%= link_to loans_hub_ecoreno_path, class: "btn w-100 fw-semibold text-white",
                style: "background:var(--ren0vate-primary-dark);border-color:var(--ren0vate-primary-dark);border-radius:8px;" do %>
            <i class="bi bi-calculator me-2"></i>Simuler le Prêt EcoReno
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <p class="text-muted small mt-4 mb-0">
    <i class="bi bi-info-circle me-1"></i>
    Ces simulateurs sont indicatifs. Les résultats dépendent de votre situation personnelle et de l'organisme prêteur.
  </p>
</div>
