<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-calculator"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouvelle Simulation de Primes</h1>
    </div>
    <%= link_to simulations_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à la liste
    <% end %>
  </div>

  <!-- Formulaire dans une card épurée -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-info-circle me-2"></i>Informations de la simulation
          </h5>

          <%= form_with model: @simulation, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :titre, "Titre de la simulation*", class: "form-label" %>
              <%= form.text_field :titre, class: "form-control", placeholder: "Ex: Simulation primes isolation toiture" %>
            </div>

            <div class="mb-3">
              <%= form.label :region, "Région*", class: "form-label" %>
              <%= form.select :region,
                  [
                    ["Bruxelles", "bruxelles"],
                    ["Wallonie", "wallonie"],
                    ["Flandre", "flandre"]
                  ],
                  { include_blank: "-- Sélectionnez votre région --" },
                  { class: "form-select" } %>
            </div>

            <% if @simulation.respond_to?(:parameters) %>
              <div class="mb-3">
                <%= form.label :parameters, "Paramètres de simulation", class: "form-label" %>
                <%= form.text_area :parameters, rows: 4, class: "form-control", placeholder: "Surface, matériaux, coefficient d'isolation..." %>
              </div>
            <% end %>

            <% if defined?(Property) && current_user.properties.any? %>
              <div class="mb-3">
                <%= form.label :property_id, "Bien immobilier concerné", class: "form-label" %>
                <%= form.collection_select :property_id, current_user.properties, :id, :full_address,
                    {
                      include_blank: "-- Sélectionner un bien --",
                      selected: (@simulation.property_id if @simulation.property.present?)
                    },
                    class: "form-select" %>
              </div>
            <% end %>

            <%= form.hidden_field :user_id, value: current_user.id %>

            <div class="mb-3">
              <%= form.label :source, "Source des données*", class: "form-label" %>
              <%= form.select :source,
                  [
                    ["Manuel", "manual"],
                    ["Automatique", "automatic"],
                    ["Import", "import"]
                  ],
                  { include_blank: "-- Sélectionnez la source --" },
                  { class: "form-select" } %>
            </div>

            <div class="d-flex justify-content-end mt-4">
              <%= link_to "Annuler", simulations_path, class: "btn btn-outline-secondary me-2" %>
              <%= form.submit "Lancer la simulation", class: "btn btn-primary-custom" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-lightbulb me-2"></i>Conseils
          </h5>
          <p class="text-muted-custom small mb-3">Cette simulation vous permet d'estimer les primes et aides financières auxquelles vous pourriez avoir droit pour vos travaux de rénovation énergétique.</p>
          <p class="text-muted-custom small mb-0">Les résultats varient selon votre région, le type de bien et les travaux envisagés. Associez la simulation à un bien existant pour des résultats plus précis.</p>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-check-circle me-2"></i>Primes disponibles
          </h5>
          <ul class="text-muted-custom small mb-0 ps-3">
            <li class="mb-2">Primes régionales pour la rénovation énergétique</li>
            <li class="mb-2">Primes provinciales et communales</li>
            <li class="mb-2">Primes Eco-chèque et crédit d'impôt</li>
            <li>Prêts à taux zéro pour la rénovation</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
