<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-calculator"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouvelle Simulation de Primes</h1>
    </div>
    <%= link_to simulations_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à la liste
    <% end %>
  </div>

  <!-- Formulaire dans une card épurée -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-info-circle me-2"></i>Informations de la simulation
          </h5>

          <%= form_with model: @simulation, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :titre, "Titre de la simulation*", class: "form-label" %>
              <%= form.text_field :titre, class: "form-control", placeholder: "Ex: Simulation primes isolation toiture" %>
            </div>

            <div class="mb-3">
              <%= form.label :region, "Région*", class: "form-label" %>
              <%= form.select :region,
                  [
                    ["Bruxelles", "bruxelles"],
                    ["Wallonie", "Wallonie"],
                    ["Flandre", "flandre"]
                  ],
                  { include_blank: "-- Sélectionnez votre région --" },
                  { class: "form-select" } %>
            </div>

            <!-- Type de simulation pour Bruxelles -->
            <div class="mb-3" id="simulation-type-section" style="display: none;">
              <label class="form-label">Type de simulation*</label>
              <div class="d-flex gap-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="simulation_type" id="simulation_particulier" value="particulier" checked>
                  <label class="form-check-label" for="simulation_particulier">
                    <i class="bi bi-house me-2"></i>Particulier (Rénovation)
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="simulation_type" id="simulation_entreprise" value="entreprise">
                  <label class="form-check-label" for="simulation_entreprise">
                    <i class="bi bi-building me-2"></i>Entreprise (Investissement)
                  </label>
                </div>
              </div>
              <div class="form-text">Sélectionnez le type de simulation selon votre profil</div>
            </div>

            <% if @simulation.respond_to?(:parameters) %>
              <div class="mb-3">
                <%= form.label :parameters, "Paramètres de simulation", class: "form-label" %>
                <%= form.text_area :parameters, rows: 4, class: "form-control", placeholder: "Surface, matériaux, coefficient d'isolation..." %>
              </div>
            <% end %>

            <% if defined?(Property) && current_user.properties.any? %>
              <div class="mb-3">
                <%= form.label :property_id, "Bien immobilier concerné*", class: "form-label" %>
                <%= form.collection_select :property_id, current_user.properties, :id, :full_address,
                    {
                      include_blank: "-- Sélectionner un bien --",
                      selected: (@simulation.property_id if @simulation.property.present?)
                    },
                    { class: "form-select", required: true } %>
                <div class="form-text">La sélection d'un bien immobilier est obligatoire pour effectuer une simulation.</div>
              </div>
            <% else %>
              <div class="mb-3">
                <div class="alert alert-warning" role="alert">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  <strong>Aucun bien immobilier trouvé !</strong><br>
                  Vous devez d'abord ajouter un bien immobilier avant de pouvoir créer une simulation.
                  <%= link_to "Ajouter un bien", new_property_path, class: "btn btn-sm btn-outline-primary ms-2" %>
                </div>
              </div>
            <% end %>

            <% if defined?(Project) && current_user.projects.any? %>
              <div class="mb-3">
                <%= form.label :project_id, "Chantier/Projet concerné", class: "form-label" %>
                <%= form.collection_select :project_id, current_user.projects, :id, :nom,
                    {
                      include_blank: "-- Sélectionner un chantier --",
                      selected: (@simulation.project_id if @simulation.respond_to?(:project) && @simulation.project.present?)
                    },
                    class: "form-select" %>
                <small class="form-text text-muted">Associez cette simulation à un chantier spécifique pour des résultats plus précis</small>
              </div>
            <% end %>

            <%= form.hidden_field :user_id, value: current_user.id %>

            <div class="d-flex justify-content-end mt-4">
              <%= link_to "Annuler", simulations_path, class: "btn btn-outline-secondary me-2" %>
              <% if current_user.properties.any? %>
                <%= form.submit "Lancer la simulation", class: "btn btn-primary-custom" %>
              <% else %>
                <button type="button" class="btn btn-primary-custom" disabled>
                  <i class="bi bi-exclamation-triangle me-2"></i>Ajoutez d'abord un bien
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-lightbulb me-2"></i>Conseils
          </h5>
          <p class="text-muted-custom small mb-3">Cette simulation vous permet d'estimer les primes et aides financières auxquelles vous pourriez avoir droit pour vos travaux de rénovation énergétique.</p>
          <p class="text-muted-custom small mb-0">Les résultats varient selon votre région, le type de bien et les travaux envisagés. Associez la simulation à un bien existant et/ou un chantier spécifique pour des résultats plus précis.</p>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-check-circle me-2"></i>Primes disponibles
          </h5>
          <ul class="text-muted-custom small mb-0 ps-3">
            <li class="mb-2">Primes régionales pour la rénovation énergétique</li>
            <li class="mb-2">Primes provinciales et communales</li>
            <li class="mb-2">Primes Eco-chèque et crédit d'impôt</li>
            <li>Prêts à taux zéro pour la rénovation</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>

<!-- Script pour gérer l'affichage conditionnel du type de simulation -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  const regionSelect = document.querySelector('select[name="simulation[region]"]')
  const simulationTypeSection = document.getElementById('simulation-type-section')

  function toggleSimulationType() {
    if (regionSelect.value === 'bruxelles') {
      simulationTypeSection.style.display = 'block'
    } else {
      simulationTypeSection.style.display = 'none'
    }
  }

  // Affichage initial
  toggleSimulationType()

  // Écouter les changements de région
  regionSelect.addEventListener('change', toggleSimulationType)

  // Gérer la soumission du formulaire pour inclure le type de simulation
  const form = document.querySelector('form')
  form.addEventListener('submit', function(e) {
    const simulationType = document.querySelector('input[name="simulation_type"]:checked')
    if (regionSelect.value === 'bruxelles' && simulationType) {
      // Ajouter le type de simulation comme paramètre
      const hiddenInput = document.createElement('input')
      hiddenInput.type = 'hidden'
      hiddenInput.name = 'type'
      hiddenInput.value = simulationType.value
      form.appendChild(hiddenInput)
    }
  })
})
</script>
