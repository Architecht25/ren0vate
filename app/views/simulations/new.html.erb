<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-calculator"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouvelle Simulation de Primes</h1>
    </div>
    <%= link_to simulations_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à la liste
    <% end %>
  </div>

  <p class="text-muted mb-4">Sélectionnez le chantier pour lequel vous souhaitez simuler les primes. Les données du bien et la région seront reprises automatiquement.</p>

  <% if @projects.blank? %>
    <!-- Aucun chantier -->
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="card border-0 shadow-sm text-center p-5">
          <div class="mb-3">
            <i class="bi bi-building-x text-muted" style="font-size: 3rem;"></i>
          </div>
          <h5 class="fw-normal text-muted mb-2">Aucun chantier trouvé</h5>
          <p class="text-muted small mb-4">Vous devez d'abord créer un chantier associé à un bien immobilier avant de lancer une simulation.</p>
          <%= link_to new_project_path, class: "btn btn-primary-custom px-4" do %>
            <i class="bi bi-plus me-2"></i>Créer un chantier
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
  <div data-controller="simulation-launch">
    <!-- Formulaire caché soumis par JS -->
    <%= form_with model: @simulation, local: true, id: "simulation-launch-form", data: { simulation_launch_target: "form" } do |form| %>
      <%= form.hidden_field :titre,       data: { simulation_launch_target: "titreHidden" } %>
      <%= form.hidden_field :region,      data: { simulation_launch_target: "regionHidden" } %>
      <%= form.hidden_field :property_id, data: { simulation_launch_target: "propertyIdHidden" } %>
      <%= form.hidden_field :project_id,  data: { simulation_launch_target: "projectIdHidden" } %>
      <%= form.hidden_field :user_id,     value: current_user.id %>
    <% end %>

    <!-- Grille de chantiers -->
    <div class="row g-3 mb-4">
      <% @projects.each do |project| %>
        <% property = project.property %>
        <% region = property&.region&.downcase %>
        <% region_label = case region
           when 'flandre'   then 'Flandre'
           when 'wallonie'  then 'Wallonie'
           when 'bruxelles' then 'Bruxelles'
           else property&.region.presence || '—'
           end %>
        <% region_color = case region
           when 'flandre'   then 'warning'
           when 'wallonie'  then 'orange'
           when 'bruxelles' then 'info'
           else 'secondary'
           end %>
        <% statut_color = case project.statut
           when 'en_cours'    then 'success'
           when 'planifié'    then 'primary'
           when 'terminé'     then 'secondary'
           when 'suspendu'    then 'warning'
           else 'secondary'
           end %>
        <div class="col-lg-4 col-md-6">
          <div class="card border-2 rounded-4 h-100 chantier-card"
               style="cursor: pointer; transition: border-color 0.2s ease, box-shadow 0.2s ease;"
               data-simulation-launch-target="card"
               data-action="click->simulation-launch#select"
               data-project-id="<%= project.id %>"
               data-property-id="<%= project.property_id %>"
               data-region="<%= property&.region %>"
               data-nom="<%= project.nom %>">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle d-flex align-items-center justify-content-center"
                       style="width: 38px; height: 38px; background: linear-gradient(135deg, #0d6efd22, #0d6efd44);">
                    <i class="bi bi-building text-primary fs-6"></i>
                  </div>
                  <span class="badge bg-<%= region_color == 'orange' ? 'warning' : region_color %> bg-opacity-10 text-<%= region_color == 'orange' ? 'warning' : region_color %> border border-<%= region_color == 'orange' ? 'warning' : region_color %> border-opacity-25 rounded-pill">
                    <%= region_label %>
                  </span>
                </div>
                <% if project.statut.present? %>
                  <span class="badge bg-<%= statut_color %> bg-opacity-10 text-<%= statut_color %> rounded-pill" style="font-size: 0.7rem;">
                    <%= project.statut.humanize %>
                  </span>
                <% end %>
              </div>

              <h6 class="fw-semibold text-dark mb-1"><%= project.nom %></h6>

              <% if property.present? %>
                <p class="text-muted small mb-2">
                  <i class="bi bi-geo-alt me-1"></i>
                  <%= [property.rue, property.numero].compact.join(' ') %>
                  <% if property.code_postal.present? || property.commune.present? %>
                    — <%= [property.code_postal, property.commune].compact.join(' ') %>
                  <% end %>
                </p>
              <% end %>

              <% if project.type_travaux.present? %>
                <p class="text-muted small mb-0">
                  <i class="bi bi-tools me-1"></i><%= project.type_travaux.split(',').first(3).map(&:strip).map(&:humanize).join(', ') %><%= project.type_travaux.split(',').size > 3 ? '…' : '' %>
                </p>
              <% end %>
            </div>

            <!-- Indicateur de sélection -->
            <div class="selected-indicator d-none card-footer bg-primary border-0 rounded-bottom-4 py-2 text-center">
              <i class="bi bi-check-circle-fill text-white me-1"></i>
              <span class="text-white small fw-medium">Chantier sélectionné</span>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Champ titre : visible après sélection d'un chantier -->
    <div class="d-none mb-4" data-simulation-launch-target="titrePanel">
      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body px-4 py-3">
          <label for="titre-visible" class="form-label fw-medium text-dark mb-1">
            <i class="bi bi-pencil me-2 text-arch-orange"></i>Nom de la simulation
          </label>
          <input type="text" id="titre-visible" class="form-control border-2 rounded-3"
                 data-simulation-launch-target="titreVisible"
                 data-action="input->simulation-launch#syncTitre"
                 placeholder="ex. Simulation isolation toiture · Flandre · Avr. 2026">
          <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Nom généré automatiquement — modifiez-le si vous le souhaitez.</small>
        </div>
      </div>
    </div>

    <!-- Bouton de lancement -->
    <div class="d-flex justify-content-end gap-2">
      <%= link_to simulations_path, class: "btn btn-outline-secondary px-4" do %>
        <i class="bi bi-x me-2"></i>Annuler
      <% end %>
      <button type="button"
              class="btn btn-primary-custom px-5"
              data-simulation-launch-target="launchButton"
              data-action="click->simulation-launch#launch"
              disabled>
        <i class="bi bi-play-fill me-2"></i>Lancer la simulation
      </button>
    </div>
  </div>
  <% end %>
</div>

<style>
  .chantier-card { border-color: #dee2e6 !important; }
  .chantier-card.chantier-selected {
    border-color: #0d6efd !important;
    box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15) !important;
  }
  .chantier-card:hover:not(.chantier-selected) {
    border-color: #adb5bd !important;
  }
</style>
