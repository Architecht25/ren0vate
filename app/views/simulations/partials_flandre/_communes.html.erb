<div class="card shadow-sm border-0 p-2 text-center mb-2 h-100 card-premium"
       data-controller="primes-communales"
       data-primes-communales-api-base-url-value="/api/primes_communales"
       data-primes-communales-debounce-delay-value="800">

    <!-- Bandeau en chantier -->
    <div class="alert alert-info alert-sm mb-2 d-flex align-items-center justify-content-center gap-1 py-1" role="alert">
      <i class="bi bi-cone-striped text-warning small"></i>
      <small class="mb-0 fw-bold">Fonctionnalité en chantier</small>
      <i class="bi bi-cone-striped text-warning small"></i>
    </div>

    <div class="card-body d-flex flex-column align-items-center gap-2">
      <!-- Icône et titre -->
      <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
        <i class="bi bi-building fs-5 text-warning"></i>
      </div>
      <h6 class="card-title mb-2">Primes Communales</h6>

      <!-- Formulaire de vérification -->
      <div class="w-100" style="max-width: 300px;">

        <!-- Code postal -->
        <div class="mb-3">
          <label for="code_postal_communales" class="form-label text-start w-100 small">Code postal</label>
          <input type="text"
                 class="form-control form-control-sm"
                 id="code_postal_communales"
                 placeholder="ex: 9000"
                 pattern="[0-9]{4}"
                 maxlength="4"
                 data-primes-communales-target="codePostal"
                 data-action="input->primes-communales#checkPrimes">
          <small class="text-muted">Saisissez votre code postal pour découvrir les primes disponibles</small>
        </div>

        <!-- Loading indicator -->
        <div class="mb-3"
             data-primes-communales-target="loading"
             style="display: none;">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
            <small class="text-muted">Recherche en cours...</small>
          </div>
        </div>

        <!-- Statut de vérification -->
        <div class="mb-3"
             data-primes-communales-target="status"
             style="display: none;">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <i data-primes-communales-target="statusIcon" class="bi"></i>
            <small data-primes-communales-target="statusText" class="fw-bold"></small>
          </div>
        </div>

        <!-- Sélection des primes -->
        <div class="mb-3"
             data-primes-communales-target="primesSelection"
             style="display: none;">
          <label for="prime_communale_select" class="form-label text-start w-100 small">Sélectionnez une prime</label>
          <select class="form-select form-select-sm"
                  id="prime_communale_select"
                  data-primes-communales-target="primeSelect"
                  data-action="change->primes-communales#selectPrime">
            <option value="">Choisir une prime...</option>
          </select>
        </div>

        <!-- Champ montant travaux -->
        <div class="mb-3"
             data-primes-communales-target="montantSection"
             style="display: none;">
          <label for="montant_travaux_communales" class="form-label text-start w-100 small">Montant des travaux (€)</label>
          <input type="number"
                 class="form-control form-control-sm"
                 id="montant_travaux_communales"
                 placeholder="0"
                 min="0"
                 step="0.01"
                 data-primes-communales-target="montantInput"
                 data-action="input->primes-communales#calculatePrime">
        </div>

        <!-- Résultat -->
        <div class="alert alert-warning alert-sm mb-2"
             data-primes-communales-target="resultSection"
             style="display: none;"
             role="alert">
          <small class="fw-bold">Prime estimée : </small>
          <span class="fw-bold prime-result"
                data-primes-communales-target="result">0.00 €</span>
          <div class="mt-1">
            <small data-primes-communales-target="details" class="text-muted"></small>
          </div>
        </div>

        <small class="text-muted d-block">
          Les primes communales varient selon votre commune et le type de travaux
        </small>
      </div>
    </div>
</div>
