<div class="col-lg-2 col-md-4 col-sm-6">
  <div class="card border-0 shadow-sm h-100 overflow-hidden card-premium"
       data-controller="flandre-simulation-card"
       data-flandre-simulation-card-slug-value="isolation_sol">

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/Eurofloor_1_wah35y'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-layers fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Isolation sol</h6>
          <small class="opacity-90">Par m²</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-dark bg-opacity-20 text-dark rounded-pill px-3">
            <i class="bi bi-layers me-1"></i>Sol
          </span>
          <small class="text-muted">
            <i class="bi bi-arrow-up text-dark me-1"></i>Confort thermique
          </small>
        </div>
      </div>

      <!-- Input superficie -->
      <div class="mb-3">
        <label class="form-label small text-muted">Surface (m²) :</label>
        <input type="number"
               class="form-control form-control-sm"
               placeholder="0"
               min="0"
               step="1"
               data-slug="isolation_sol"
               data-flandre-simulation-card-target="input"
               data-action="input->flandre-simulation-card#onInputChange">

        <!-- Informations contextuelles depuis la base de données -->
        <div class="mt-2">
          <small class="text-muted d-block">
            <i class="bi bi-info-circle me-1"></i>
            Conditions : <%= condition_prime("isolation_sol") %>
          </small>
          <small class="text-success d-block mt-1">
            <i class="bi bi-lightbulb me-1"></i>
            Conseil : <%= conseil_prime("isolation_sol") %>
          </small>
        </div>
      </div>

      <!-- Résultat -->
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Prime calculée :</span>
        <span class="badge bg-dark fs-6" data-flandre-simulation-card-target="result">0 €</span>
      </div>
    </div>
  </div>
</div>
