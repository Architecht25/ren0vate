<div class="col-lg-2 col-md-4 col-sm-6">
  <div class="card border-0 shadow-sm h-100 overflow-hidden card-premium"
       data-controller="flandre-simulation-card"
       data-flandre-simulation-card-slug-value="isolation_toiture">

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/isolation_toiture_f9r4hs'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-house-door fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Isolation toiture</h6>
          <small class="opacity-90">Par m²</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill px-3">
            <i class="bi bi-thermometer-half me-1"></i>Toiture
          </span>
          <small class="text-muted">
            <i class="bi bi-lightning-charge text-success me-1"></i>Économie d'énergie
          </small>
        </div>
      </div>

      <!-- Input superficie -->
      <div class="mb-3">
        <label class="form-label small text-muted">Surface (m²) :</label>
        <input type="number"
               class="form-control form-control-sm"
               placeholder="0"
               min="0"
               step="1"
               data-slug="isolation_toiture"
               data-flandre-simulation-card-target="input"
               data-action="input->flandre-simulation-card#onInputChange">

        <!-- Informations contextuelles depuis la base de données -->
        <div class="mt-2">
          <small class="text-muted d-block">
            <i class="bi bi-info-circle me-1"></i>
            Conditions : <%= condition_prime("isolation_toiture") %>
          </small>
        <!-- j'aimerais placer un point info pour expliquer ce qu'est une résistance thermique -->
        <div class="mt-2">
          <small class="text-primary d-block">
            <i class="bi bi-question-circle me-1"></i>
            Qu'est-ce que la résistance thermique ?
          </small>
          <small class="text-primary d-block mt-1">
            La résistance thermique est une mesure de la capacité d'un matériau à résister au passage de la chaleur. Plus la résistance thermique est élevée, meilleure est l'isolation. elle se calcul par le rapport entre l'épaisseur du matériau et sa conductivité thermique (R = épaisseur / conductivité).
          </small>
          <small class="text-success d-block mt-1">
            <i class="bi bi-lightbulb me-1"></i>
            Conseil : <%= conseil_prime("isolation_toiture") %>
          </small>
        </div>
        </div>
      </div>

      <!-- Résultat -->
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Prime calculée :</span>
        <span class="badge bg-warning text-dark fs-6" data-flandre-simulation-card-target="result">0 €</span>
      </div>
    </div>
  </div>
</div>
