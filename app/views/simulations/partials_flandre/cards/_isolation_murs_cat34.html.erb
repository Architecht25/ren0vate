<div class="col-lg-2 col-md-4 col-sm-6">
  <div class="card border-0 shadow-sm h-100 overflow-hidden card-premium"
       data-controller="flandre-simulation-card"
       data-flandre-simulation-card-slug-value="isolation_murs">

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/renovation_murs_istlqj'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-bricks fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Murs (cat. 3-4)</h6>
          <small class="opacity-90">Montant facture</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-primary bg-opacity-20 text-primary rounded-pill px-3">
            <i class="bi bi-bricks me-1"></i>Murs
          </span>
          <small class="text-muted">
            <i class="bi bi-shield-check text-primary me-1"></i>Isolation thermique
          </small>
        </div>
      </div>

      <!-- Input superficie -->
      <div class="mb-3">
        <label class="form-label small text-muted">Valeur à renseigner :</label>
        <input type="number"
               class="form-control form-control-sm"
               placeholder="<%= placeholder_prime_flandre(Prime.find_by(slug: 'isolation_murs', region: 'flandre'), @simulation&.category) %>"
               min="0"
               step="1"
               data-slug="isolation_murs"
               data-flandre-simulation-card-target="input"
               data-action="input->flandre-simulation-card#onInputChange">

        <!-- Informations contextuelles depuis la base de données -->
        <div class="mt-2">
          <small class="text-success d-block">
            <i class="bi bi-info-circle me-1"></i>
            Conditions : <%= condition_prime("isolation_murs") %>
          </small>
        </div>
      </div>

      <!-- Résultat -->
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Prime calculée :</span>
        <span class="badge bg-primary fs-6" data-flandre-simulation-card-target="result">0 €</span>
      </div>
    </div>
  </div>
</div>
