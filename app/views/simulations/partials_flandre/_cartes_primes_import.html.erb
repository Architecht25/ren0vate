    <div class="card-header bg-info bg-opacity-10">
      <h4 class="card-title mb-0">
        <i class="bi bi-calculator text-info me-2"></i>
        <span data-flandre-prime-calcul-target="sectionTitle">
          Vos primes Flandre - Catégorie <%= @simulation.category || '1' %>
        </span>
      </h4>
      <p class="text-muted small mb-0 mt-1">
        💡 Les montants s'ajustent automatiquement selon votre catégorie de revenus
      </p>
    </div>
