  <script id="flandre-primes-data" type="application/json">
    <%= raw Prime.where(region: "flandre").map { |prime|
      [prime.slug, {
        nom: prime.titre,
        valeurs_par_categorie: prime.valeurs_par_categorie || {}
      }]
    }.to_h.to_json %>
  </script>

  <!-- Données de simulation pour restauration auto-save -->
  <script id="simulation-category-data" type="application/json" nonce="<%= request.content_security_policy_nonce %>">
