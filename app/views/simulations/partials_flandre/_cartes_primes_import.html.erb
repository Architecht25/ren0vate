<!-- Section Primes Flandre -->
<div class="primes-section-flandre" data-controller="flandre-simulation" data-flandre-simulation-simulation-id-value="<%= @simulation.id %>" data-flandre-simulation-category-value="<%= @simulation.category %>">

  <%= render 'simulations/partials_flandre/components/data_scripts' %>
  <%= render 'simulations/partials_flandre/components/styles' %>

  <%= render 'simulations/partials_flandre/components/header_section' %>

  <!-- Section: Isolation -->
  <div class="mb-5">
    <div class="row g-3">
      <%
        # Pour les catégories 1 et 2, seules les primes pompe à chaleur et boiler thermodynamique sont disponibles
        # Les primes d'isolation (toiture, murs, sols, châssis) ont été supprimées par le gouvernement
        current_category = @simulation&.category.to_s
        is_cat_1_or_2 = ['1', '2'].include?(current_category)
      %>

      <% unless is_cat_1_or_2 %>
        <%= render 'simulations/partials_flandre/cards/isolation_toiture' %>
        <%= render 'simulations/partials_flandre/cards/isolation_murs_cat12' %>
        <%= render 'simulations/partials_flandre/cards/isolation_murs_cat34' %>
        <%= render 'simulations/partials_flandre/cards/isolation_sol' %>
        <%= render 'simulations/partials_flandre/cards/ramen_deuren' %>
      <% end %>

      <%= render 'simulations/partials_flandre/cards/warmtepomp' %>
      <%= render 'simulations/partials_flandre/cards/warmtepompboiler' %>

      <% unless is_cat_1_or_2 %>
        <%= render 'simulations/partials_flandre/cards/voorbereiding_isolatie' %>
        <%= render 'simulations/partials_flandre/cards/voorbereiding_sanitair_elec' %>
        <%= render 'simulations/partials_flandre/cards/renovation_toiture' %>
        <%= render 'simulations/partials_flandre/cards/renovation_murs' %>
        <%= render 'simulations/partials_flandre/cards/renovation_sol' %>
      <% end %>
    </div>
  </div>

  <!-- Cartes spécialisées en carré 2x2 (col-4) et section résultats (col-8) sur la même rangée -->
  <div class="row g-4 mt-4 mb-4">
    <!-- Cartes spécialisées en format carré 2x2 - 4 colonnes total -->
    <div class="col-xl-4 col-lg-6">
      <div class="row g-3 h-100">
        <!-- Première rangée du carré -->
        <div class="col-6">
          <div class="h-100">
            <%= render 'simulations/partials_flandre/peb' %>
          </div>
        </div>
        <div class="col-6">
          <div class="h-100">
            <%= render 'simulations/partials_flandre/prime_amiante' %>
          </div>
        </div>

        <!-- Deuxième rangée du carré -->
        <div class="col-6">
          <div class="h-100">
            <%= render 'simulations/partials_flandre/monuments_et_sites' %>
          </div>
        </div>
        <div class="col-6">
          <div class="h-100">
            <%= render 'simulations/partials_flandre/communes' %>
          </div>
        </div>
      </div>
    </div>

    <!-- Section résultats - 8 colonnes à droite -->
    <div class="col-xl-8 col-lg-6">
      <div class="h-100">
        <%= render 'simulations/partials_flandre/components/results_section' %>
      </div>
    </div>
  </div>
</div>

<!-- End of Flandre primes section -->

<%= render 'simulations/partials_flandre/components/summary_script' %>
