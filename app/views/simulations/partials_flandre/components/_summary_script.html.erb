<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  // Gestionnaire pour le résumé dynamique des primes sélectionnées Flandre
  function updateSelectedPrimesSummaryFlandre() {
    const summaryContainer = document.getElementById('selected-primes-summary-flandre');
    if (!summaryContainer) return;

    const selectedPrimes = [];

    // Parcourir toutes les cartes de primes pour trouver les montants > 0
    document.querySelectorAll('[data-controller="flandre-prime-card"]').forEach(card => {
      const resultSpan = card.querySelector('[data-flandre-prime-card-target="result"]');
      const slug = card.dataset.flandrePrimeCardSlugValue;

      if (resultSpan && slug) {
        const amountText = resultSpan.textContent.trim();
        const amount = parseFloat(amountText.replace(/[€\s]/g, '').replace(',', '.'));

        if (amount > 0) {
          // Récupérer le titre depuis la carte
          const titleElement = card.querySelector('.card-title');
          const title = titleElement ? titleElement.textContent.trim() : slug;

          // Récupérer la description ou l'unité
          const unitElement = card.querySelector('.text-muted small');
          const description = unitElement ? unitElement.textContent.trim() : '';

          selectedPrimes.push({
            slug: slug,
            title: title,
            description: description,
            amount: amount,
            formattedAmount: new Intl.NumberFormat('fr-BE', {
              style: 'currency',
              currency: 'EUR',
              minimumFractionDigits: 0
            }).format(amount)
          });
        }
      }
    });

    // Mettre à jour l'affichage
    if (selectedPrimes.length === 0) {
      summaryContainer.innerHTML = `
        <div class="text-muted text-center py-3">
          <i class="bi bi-info-circle me-2"></i>
          Sélectionnez des travaux dans les cartes ci-dessus pour voir le détail de vos primes
        </div>
      `;
    } else {
      let summaryHTML = '';
      selectedPrimes.forEach(prime => {
        summaryHTML += `
          <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
            <div>
              <div class="fw-medium text-dark">${prime.title}</div>
              <small class="text-muted">${prime.description}</small>
            </div>
            <div class="text-end">
              <span class="fw-bold text-primary">${prime.formattedAmount}</span>
            </div>
          </div>
        `;
      });

      // Ajouter le total si plus d'une prime
      if (selectedPrimes.length > 1) {
        const total = selectedPrimes.reduce((sum, prime) => sum + prime.amount, 0);
        const formattedTotal = new Intl.NumberFormat('fr-BE', {
          style: 'currency',
          currency: 'EUR',
          minimumFractionDigits: 0
        }).format(total);

        summaryHTML += `
          <div class="d-flex justify-content-between align-items-center py-3 mt-2 bg-primary bg-opacity-10 rounded px-3">
            <div class="fw-bold text-primary">Total de vos primes sélectionnées</div>
            <div class="fw-bold text-primary h5 mb-0">${formattedTotal}</div>
          </div>
        `;
      }

      summaryContainer.innerHTML = summaryHTML;
    }

    console.log(`📊 Résumé Flandre mis à jour: ${selectedPrimes.length} primes détectées`);
  }

  // Écouter les changements sur tous les inputs de primes
  document.addEventListener('change', function(event) {
    if (event.target.closest('[data-controller="flandre-prime-card"]')) {
      // Délai court pour laisser le contrôleur mettre à jour les montants
      setTimeout(() => {
        updateSelectedPrimesSummaryFlandre();
      }, 100);
    }
  });

  // Écouter les saisies dans les champs numériques
  document.addEventListener('input', function(event) {
    if (event.target.closest('[data-controller="flandre-prime-card"]')) {
      setTimeout(() => {
        updateSelectedPrimesSummaryFlandre();
      }, 150);
    }
  });

  // Mise à jour initiale
  setTimeout(updateSelectedPrimesSummaryFlandre, 500);

  console.log('📝 Résumé dynamique des primes Flandre initialisé');
});
</script>
