<!-- Section Résultats Flandre -->
<div class="h-100">
  <div class="card border-0 shadow-lg h-100">
    <div class="card-body p-3">

      <!-- En-tête compact -->
      <div class="text-center mb-3">
        <h6 class="text-primary mb-1 fw-bold">
          <i class="bi bi-calculator me-1"></i>
          Total estimé de vos primes Flandre
        </h6>
        <p class="text-muted small mb-0">Les montants s'ajustent selon votre catégorie de revenus</p>
      </div>

      <!-- Total principal compact -->
      <div class="rounded-3 p-3 text-center mb-3" style="background-color: var(--ren0vate-background-light); border: 1px solid var(--ren0vate-border);">
        <h3 class="fw-bold mb-1" style="color: var(--ren0vate-primary);" data-flandre-simulation-target="totalGeneral">0,00 €</h3>
        <p class="text-muted small mb-0" data-flandre-simulation-target="currentCategory">
          • Estimation selon votre profil de revenus
        </p>
      </div>

      <!-- Indicateur de sauvegarde automatique -->
      <div class="text-center mb-2 d-none" data-flandre-simulation-target="saveStatus">
      </div>

      <!-- Résumé des primes sélectionnées -->
      <div class="card border-0 bg-light">
        <div class="card-body p-3">
          <h6 class="fw-bold text-dark mb-2 small">
            <i class="bi bi-list-check me-1"></i>
            Résumé de vos primes sélectionnées
          </h6>
          <div id="selected-primes-summary-flandre" data-flandre-simulation-target="selectedPrimesSummary">
            <div class="text-muted text-center py-2 small">
              <i class="bi bi-info-circle me-1"></i>
              Sélectionnez des travaux pour voir le détail
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
