<!-- Section Résultats Flandre -->
<div class="mt-5">
  <div class="card border-0 shadow-lg">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <h4 class="text-primary mb-2">
          <i class="bi bi-calculator me-2"></i>
          Total estimé de vos primes Flandre
        </h4>
        <p class="text-muted small">Les montants s'ajustent automatiquement selon votre catégorie de revenus</p>
      </div>

      <!-- Affichage du total principal -->
      <div class="bg-primary bg-opacity-10 rounded-3 p-4 text-center mb-4">
        <div class="row align-items-center">
          <div class="col-md-8 mb-3 mb-md-0">
            <h2 class="display-4 fw-bold text-primary mb-1" data-flandre-simulation-target="totalGeneral">0,00 €</h2>
            <p class="text-muted mb-0">
              <span data-flandre-simulation-target="currentCategory">Catégorie 4</span>
              • Estimation selon votre profil de revenus
            </p>
          </div>
          <div class="col-md-4">
            <div class="bg-white rounded-2 p-3">
              <i class="bi bi-info-circle text-primary fs-4 mb-2"></i>
              <p class="small text-muted mb-0">Ce montant est une estimation basée sur vos travaux sélectionnés</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Résumé des primes sélectionnées -->
      <div class="card border-0 bg-light">
        <div class="card-body p-4">
          <h6 class="fw-bold text-dark mb-3">
            <i class="bi bi-list-check me-2"></i>
            Résumé de vos primes sélectionnées
          </h6>

          <!-- Liste dynamique des primes sélectionnées -->
          <div id="selected-primes-summary-flandre" data-flandre-simulation-target="selectedPrimesSummary">
            <div class="text-muted text-center py-3">
              <i class="bi bi-info-circle me-2"></i>
              Sélectionnez des travaux dans les cartes ci-dessus pour voir le détail de vos primes
            </div>
          </div>
        </div>
      </div>

      <!-- Note informative -->
      <div class="alert alert-info mt-4 mb-0">
        <div class="d-flex align-items-start">
          <i class="bi bi-lightbulb me-3 mt-1 fs-5"></i>
          <div>
            <h6 class="alert-heading mb-2">Bon à savoir</h6>
            <p class="mb-2">Ces montants sont des estimations basées sur les grilles tarifaires officielles de la Flandre.</p>
            <ul class="mb-0 small">
              <li>Les primes varient selon votre catégorie de revenus (1 à 4)</li>
              <li>Certaines primes sont forfaitaires, d'autres calculées au m² ou en pourcentage</li>
              <li>Des conditions techniques spécifiques peuvent s'appliquer</li>
              <li>Il est recommandé de vérifier votre éligibilité auprès des organismes officiels</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
