<!-- ÉTAPE 1: Test d'éligibilité Flandre -->
<div class="card border-0 shadow-sm mb-4" id="eligibility-step">
  <div class="card-body p-4">
    <h5 class="card-title text-primary-custom mb-3">
      <i class="bi bi-shield-check me-2"></i>Étape 1 : Test d'éligibilité (Flandre)
    </h5>

    <div id="eligibility-status">
      <% if @simulation.respond_to?(:eligible) && @simulation.eligible? %>
        <div class="alert alert-success d-flex align-items-center" role="alert">
          <i class="bi bi-check-circle-fill me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">✅ Votre demande est éligible !</h6>
            <p class="mb-0">Vous remplissez les conditions pour bénéficier des primes de rénovation en Flandre.</p>
            <% if @simulation.respond_to?(:eligibility_details) && @simulation.eligibility_details.present? %>
              <div class="mt-2">
                <small class="text-muted">
                  <strong>Critères validés :</strong>
                  <% @simulation.eligibility_details.each do |detail| %>
                    <span class="badge bg-success-subtle text-success-emphasis me-1"><%= detail %></span>
                  <% end %>
                </small>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif @simulation.respond_to?(:eligible) && !@simulation.eligible? %>
        <div class="alert alert-danger d-flex align-items-center" role="alert">
          <i class="bi bi-x-circle-fill me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">❌ Votre demande n'est pas éligible</h6>
            <p class="mb-0">Certaines conditions ne sont pas remplies pour les primes Flandre.</p>
            <% if @simulation.respond_to?(:ineligibility_reason) && @simulation.ineligibility_reason.present? %>
              <div class="mt-2">
                <small class="text-muted">
                  <strong>Motif :</strong> <%= @simulation.ineligibility_reason %>
                </small>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="alert alert-info d-flex align-items-center" role="alert">
          <i class="bi bi-hourglass-split me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">🔄 Test d'éligibilité prêt</h6>
            <p class="mb-0">Cliquez sur le bouton ci-dessous pour vérifier l'éligibilité de votre demande selon les critères Flandre.</p>
            <small class="text-muted d-block mt-1">
              Vérification des 14 critères d'éligibilité Flandre (usage, propriété, année de construction, etc.)
            </small>
          </div>
        </div>
      <% end %>
    </div>

    <% unless @simulation.respond_to?(:eligible) && @simulation.eligible? %>
      <div class="mt-3">
        <button id="check-eligibility-btn" class="btn btn-primary-custom">
          <i class="bi bi-shield-check me-2"></i>Vérifier l'éligibilité Flandre
        </button>
      </div>
    <% end %>
  </div>
</div>
