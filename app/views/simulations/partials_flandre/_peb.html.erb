<div class="card shadow-sm border-0 p-2 text-center mb-2 h-100 card-premium"
     data-controller="peb"
     data-peb-categorie-value="<%= @simulation&.category || '3' %>">
  <div class="card-body d-flex flex-column align-items-center gap-2">
    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; background-color: rgba(var(--ren0vate-primary-rgb), 0.1);">
      <i class="bi bi-speedometer2 fs-6" style="color: var(--ren0vate-primary);"></i>
    </div>
    <h6 class="card-title mb-1 small">Prime PEB</h6>

    <!-- Formulaire PEB spécifique Flandre -->
    <div class="w-100" style="max-width: 300px;">
      <!-- Label initial -->
      <div class="mb-1">
        <label for="label_initial_peb" class="form-label text-start w-100 small mb-1">Label initial</label>
        <select class="form-select form-select-sm"
                id="label_initial_peb"
                data-peb-target="labelInitial"
                data-action="change->peb#labelInitialChanged">
          <option value="">Choisir...</option>
          <option value="F">F</option>
          <option value="E">E</option>
          <option value="D">D</option>
          <option value="C">C</option>
          <option value="B">B</option>
          <option value="A">A</option>
        </select>
      </div>

      <!-- Type de logement -->
      <div class="mb-1">
        <label for="type_logement_peb" class="form-label text-start w-100 small mb-1">Type de logement</label>
        <select class="form-select form-select-sm"
                id="type_logement_peb"
                data-peb-target="typeLogement"
                data-action="change->peb#typeLogementChanged">
          <option value="">Choisir...</option>
          <option value="maison">Maison</option>
          <option value="appartement">Appartement</option>
        </select>
      </div>

      <!-- Ventilation -->
      <div class="mb-2">
        <label for="ventilation_peb" class="form-label text-start w-100 small">Ventilation conforme</label>
        <select class="form-select form-select-sm"
                id="ventilation_peb"
                data-peb-target="ventilation"
                data-action="change->peb#ventilationChanged">
          <option value="">Choisir...</option>
          <option value="avec_ventilation">Oui (système D)</option>
          <option value="sans_ventilation">Non</option>
        </select>
      </div>

      <!-- Label final -->
      <div class="mb-3">
        <label for="label_final_peb" class="form-label text-start w-100 small">Label final visé</label>
        <select class="form-select form-select-sm"
                id="label_final_peb"
                data-peb-target="labelFinal"
                data-action="change->peb#labelFinalChanged">
          <option value="">Choisir...</option>
          <option value="A">A</option>
          <option value="B">B</option>
          <option value="C">C</option>
        </select>
      </div>

      <!-- Résultat -->
      <div class="alert alert-primary alert-sm mb-2 d-none" role="alert" data-peb-target="resultatContainer">
        <small class="fw-bold">Montant estimé : </small>
        <span class="fw-bold prime-result" data-peb-target="montantCalcule">0.00 €</span>
      </div>

      <small class="text-muted d-block">
        Prime basée sur l'amélioration du label énergétique (catégorie <%= @simulation&.category || '4' %>)
      </small>
    </div>
  </div>
</div>
