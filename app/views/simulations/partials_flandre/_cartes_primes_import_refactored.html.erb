<!-- Section Primes Flandre -->
<div class="primes-section-flandre" data-controller="flandre-simulation" data-flandre-simulation-simulation-id-value="<%= @simulation.id %>">

  <%= render 'simulations/partials_flandre/components/data_scripts' %>
  <%= render 'simulations/partials_flandre/components/styles' %>

  <%= render 'simulations/partials_flandre/components/header_section' %>

    <!-- Section: Isolation -->
    <div class="mb-5">
      <h5 class="text-primary mb-3">
        <i class="bi bi-house-door me-2"></i>Isolation
      </h5>
      <div class="row g-3">
        <%= render 'simulations/partials_flandre/cards/isolation_toiture' %>
        <%= render 'simulations/partials_flandre/cards/isolation_murs_cat12' %>
        <%= render 'simulations/partials_flandre/cards/isolation_murs_cat34' %>
        <%= render 'simulations/partials_flandre/cards/isolation_sol' %>
        <%= render 'simulations/partials_flandre/cards/ramen_deuren' %>
        <%= render 'simulations/partials_flandre/cards/warmtepomp' %>
        <%= render 'simulations/partials_flandre/cards/warmtepompboiler' %>
        <%= render 'simulations/partials_flandre/cards/voorbereiding_isolatie' %>
        <%= render 'simulations/partials_flandre/cards/voorbereiding_sanitair_elec' %>
        <%= render 'simulations/partials_flandre/cards/renovation_toiture' %>
        <%= render 'simulations/partials_flandre/cards/renovation_murs' %>
        <%= render 'simulations/partials_flandre/cards/renovation_sol' %>
      </div>
    </div>

    <%= render 'simulations/partials_flandre/components/results_section' %>
  </div>
</div>

<!-- End of Flandre primes section -->

<%= render 'simulations/partials_flandre/components/summary_script' %>
