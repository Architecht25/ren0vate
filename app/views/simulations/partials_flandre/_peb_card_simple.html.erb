<div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
  <div class="card-body d-flex flex-column align-items-center gap-3">
    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
      <i class="bi bi-speedometer2 fs-5 text-primary"></i>
    </div>
    <h6 class="card-title mb-2">Prime PEB</h6>

    <!-- Formulaire PEB spécifique Flandre -->
    <div class="w-100" style="max-width: 300px;">
      <!-- Label initial -->
      <div class="mb-2">
        <label for="label_initial_peb" class="form-label text-start w-100 small">Label initial</label>
        <select class="form-select form-select-sm"
                id="label_initial_peb"
                data-peb-target="labelInitial"
                data-action="change->peb#labelInitialChanged">
          <option value="">Choisir...</option>
          <option value="F">F</option>
          <option value="E">E</option>
          <option value="D">D</option>
          <option value="C">C</option>
          <option value="B">B</option>
          <option value="A">A</option>
        </select>
      </div>

      <!-- Type de logement -->
      <div class="mb-2">
        <label for="type_logement_peb" class="form-label text-start w-100 small">Type de logement</label>
        <select class="form-select form-select-sm"
                id="type_logement_peb"
                data-peb-target="typeLogement"
                data-action="change->peb#typeLogementChanged">
          <option value="">Choisir...</option>
          <option value="appartement">Appartement</option>
          <option value="maison">Maison</option>
        </select>
      </div>

      <!-- Ventilation conforme -->
      <div class="mb-2">
        <label for="ventilation_conforme_peb" class="form-label text-start w-100 small">Ventilation conforme</label>
        <select class="form-select form-select-sm"
                id="ventilation_conforme_peb"
                data-peb-target="ventilationConforme"
                data-action="change->peb#ventilationConformeChanged">
          <option value="">Choisir...</option>
          <option value="oui">Oui</option>
          <option value="non">Non</option>
        </select>
      </div>

      <!-- Label final visé -->
      <div class="mb-3">
        <label for="label_final_vise_peb" class="form-label text-start w-100 small">Label final visé</label>
        <select class="form-select form-select-sm"
                id="label_final_vise_peb"
                data-peb-target="labelFinalVise"
                data-action="change->peb#labelFinalViseChanged">
          <option value="">Choisir...</option>
          <option value="A">A</option>
          <option value="B">B</option>
          <option value="C">C</option>
          <option value="D">D</option>
        </select>
      </div>

      <!-- Statut de vérification -->
      <div class="mb-3" id="status_peb" style="display: none;">
        <div class="d-flex align-items-center justify-content-center gap-2">
          <i id="status_icon_peb" class="bi"></i>
          <small id="status_text_peb" class="fw-bold"></small>
        </div>
      </div>

      <!-- Montant estimé -->
      <div class="text-center" id="montant_peb" style="display: none;">
        <div class="alert alert-success py-2 mb-0">
          <div class="fw-bold text-success mb-1">Montant estimé :</div>
          <div class="h5 mb-0 text-success" id="montant_estime_peb">0,00 €</div>
        </div>
      </div>
    </div>
  </div>
</div>
