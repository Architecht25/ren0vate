<div class="card shadow-sm border-0 p-2 text-center mb-2 h-100 card-premium"
     data-controller="amiante">
    <div class="card-body d-flex flex-column align-items-center gap-2">
      <div class="bg-danger bg-opacity-55 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
        <i class="bi bi-radioactive fs-6 text-white"></i>
      </div>
      <h6 class="card-title mb-1 small">Prime amiante</h6>

      <!-- Formulaire de calcul -->
      <div class="w-100" style="max-width: 300px;">
        <div class="mb-2">
          <label for="surface_toiture_amiante" class="form-label text-start w-100 small mb-1">Surface toiture isolée (m²)</label>
          <input type="number"
                 class="form-control form-control-sm"
                 id="surface_toiture_amiante"
                 placeholder="0"
                 min="0"
                 step="0.01"
                 data-amiante-target="surfaceToiture"
                 data-action="input->amiante#surfaceToitureChanged">
        </div>

        <div class="mb-3">
          <label for="surface_murs_amiante" class="form-label text-start w-100 small">Surface murs isolée (m²)</label>
          <input type="number"
                 class="form-control form-control-sm"
                 id="surface_murs_amiante"
                 placeholder="0"
                 min="0"
                 step="0.01"
                 data-amiante-target="surfaceMurs"
                 data-action="input->amiante#surfaceMursChanged">
        </div>

        <!-- Résultat -->
        <div class="alert alert-danger alert-sm mb-2" role="alert">
          <small class="fw-bold">Montant estimé : </small>
          <span class="fw-bold prime-result"
                id="result_amiante"
                data-amiante-target="result">0.00 €</span>
        </div>

        <small class="text-muted d-block">
          Calcul : 8€/m² toiture + 4€/m² murs (12€/m² murs si toiture incluse)
        </small>
      </div>
    </div>
  </div>
