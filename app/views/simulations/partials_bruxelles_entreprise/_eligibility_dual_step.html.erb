<!-- ÉTAPE 1: Éligibilité et Majorations pour les entreprises -->
<div class="row g-3">
  <!-- Éligibilité pour les aides aux investissements -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100" id="eligibility-step-investment">
      <div class="card-body p-4 d-flex flex-column">
        <h5 class="card-title text-primary-custom mb-3">
          <i class="bi bi-building me-2"></i>Éligibilité Aides aux Investissements
        </h5>

        <div id="eligibility-status-investment">
          <% if @simulation.respond_to?(:eligible_investment) && @simulation.eligible_investment? %>
            <div class="alert alert-success d-flex align-items-center" role="alert">
              <i class="bi bi-check-circle-fill me-3 fs-4"></i>
              <div>
                <h6 class="alert-heading mb-1">✅ Éligible aux aides investissements !</h6>
                <p class="mb-0">Votre entreprise peut bénéficier des aides aux investissements.</p>
              </div>
            </div>
          <% elsif @simulation.respond_to?(:eligible_investment) && !@simulation.eligible_investment? %>
            <div class="alert alert-danger d-flex align-items-center" role="alert">
              <i class="bi bi-x-circle-fill me-3 fs-4"></i>
              <div>
                <h6 class="alert-heading mb-1">❌ Non éligible aux investissements</h6>
                <p class="mb-0">Certaines conditions ne sont pas remplies.</p>
                <% if @simulation.respond_to?(:investment_ineligibility_reason) && @simulation.investment_ineligibility_reason.present? %>
                  <small class="text-muted d-block mt-1"><%= @simulation.investment_ineligibility_reason %></small>
                <% end %>
              </div>
            </div>

            <!-- Bouton pour l'analyse détaillée -->
            <div class="mt-3 p-3 bg-light rounded border-start border-3 border-info"
                 data-controller="eligibility-checker">
              <h6 class="text-info mb-2">
                <i class="bi bi-search me-2"></i>
                Analyse détaillée des critères d'éligibilité
              </h6>
              <p class="small text-muted mb-3">
                Découvrez point par point pourquoi votre entreprise n'est pas éligible et comment corriger les éléments manquants.
              </p>

              <!-- Zone d'affichage de l'analyse détaillée -->
              <div id="detailed_eligibility_result" class="mb-3"></div>

              <!-- Bouton pour lancer l'analyse -->
              <button id="launch-detailed-analysis-btn"
                      class="btn btn-info btn-sm"
                      data-simulation-id="<%= @simulation.id %>"
                      data-property-id="<%= @simulation.property_id %>"
                      data-project-id="<%= @simulation.project_id %>"
                      data-action="click->eligibility-checker#launchDetailedAnalysis">
                <i class="bi bi-list-check me-2"></i>
                Lancer l'analyse détaillée
              </button>
            </div>
          <% else %>
            <div class="alert alert-info d-flex align-items-center" role="alert">
              <i class="bi bi-hourglass-split me-3 fs-4"></i>
              <div>
                <h6 class="alert-heading mb-1">🔄 Test d'éligibilité investissements</h6>
                <p class="mb-0">Vérification basée sur vos données d'entreprise (BCE, secteur, etc.)</p>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Bouton pour relancer le test d'éligibilité -->
        <div class="text-center mt-auto" data-controller="eligibility-retester">
          <button class="btn btn-outline-primary btn-sm"
                  data-simulation-id="<%= @simulation.id %>"
                  data-action="click->eligibility-retester#retestEligibility"
                  data-eligibility-retester-target="button">
            <i class="bi bi-arrow-clockwise me-2"></i>
            Relancer le test d'éligibilité
          </button>
          <div class="text-muted small mt-2">
            <i class="bi bi-info-circle me-1"></i>
            Utile après modification des données entreprise
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Majorations Disponibles -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100" id="majorations-section">
      <div class="card-body p-4">
        <h5 class="card-title text-warning mb-3">
          <i class="bi bi-star me-2"></i>Majorations Disponibles
        </h5>

        <p class="text-muted small mb-3">
          Optimisez vos aides grâce aux majorations selon les critères de votre entreprise
        </p>

        <!-- Majoration Starter -->
        <div class="mb-3 p-3 border border-primary border-opacity-25 rounded bg-light">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="text-primary mb-0 fw-bold">
              <i class="bi bi-rocket me-2"></i>Starter
            </h6>
            <span class="badge bg-primary-subtle text-primary fs-6 px-2 py-1">+10% à +15%</span>
          </div>
          <p class="text-dark mb-2">
            Entreprise créée depuis moins de 4 ans
          </p>
          <% if @simulation.respond_to?(:property) && @simulation.property&.date_creation %>
            <% company_age = ((Date.current - @simulation.property.date_creation) / 365.25).round(1) %>
            <% if company_age < 4 %>
              <div class="text-success fw-medium">
                <i class="bi bi-check-circle-fill me-2"></i>
                ✅ Éligible (entreprise de <%= company_age %> an<%= 's' if company_age > 1 %>)
              </div>
            <% else %>
              <div class="text-muted">
                <i class="bi bi-x-circle me-2"></i>
                Non éligible (entreprise de <%= company_age %> ans)
              </div>
            <% end %>
          <% else %>
            <div class="text-info">
              <i class="bi bi-info-circle me-2"></i>
              Renseignez la date de création de votre entreprise pour vérifier
            </div>
          <% end %>
        </div>

        <!-- Majoration Exemplarité Environnementale -->
        <div class="mb-3 p-3 border border-success border-opacity-25 rounded bg-light">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="text-success mb-0 fw-bold">
              <i class="bi bi-leaf me-2"></i>Exemplarité Environnementale
            </h6>
            <span class="badge bg-success-subtle text-success fs-6 px-2 py-1">+10% à +20%</span>
          </div>
          <p class="text-dark mb-2">
            Certifications environnementales (ISO 14001, EMAS, etc.)
          </p>
          <div class="text-info">
            <i class="bi bi-info-circle me-2"></i>
            Fournissez vos certifications pour bénéficier de cette majoration
          </div>
        </div>

        <!-- Majoration Exemplarité Sociale -->
        <div class="mb-3 p-3 border border-info border-opacity-25 rounded bg-light">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="text-info mb-0 fw-bold">
              <i class="bi bi-people me-2"></i>Exemplarité Sociale
            </h6>
            <span class="badge bg-info-subtle text-info fs-6 px-2 py-1">+10% à +20%</span>
          </div>
          <p class="text-dark mb-2">
            Insertion professionnelle, économie sociale, diversité
          </p>
          <div class="text-info">
            <i class="bi bi-info-circle me-2"></i>
            Documentez vos actions sociales pour cette majoration
          </div>
        </div>

        <div class="alert alert-light border border-warning border-opacity-25 mt-3 py-3">
          <div class="text-dark">
            <i class="bi bi-lightbulb-fill text-warning me-2"></i>
            <strong>Conseil :</strong> Les majorations peuvent se cumuler jusqu'à 80% maximum.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript pour gérer les boutons de double éligibilité -->
<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  const simulationId = '<%= @simulation.id %>';

  // Bouton pour vérifier l'éligibilité investissements
  const checkInvestmentBtn = document.getElementById('check-eligibility-investment-btn');
  if (checkInvestmentBtn) {
    checkInvestmentBtn.addEventListener('click', function() {
      this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Vérification en cours...';
      this.disabled = true;

      fetch(`/simulations/${simulationId}/check_eligibility_investment`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.eligible) {
          this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Éligible aux investissements';
          this.classList.remove('btn-primary-custom');
          this.classList.add('btn-success');
          // Mettre à jour l'affichage d'éligibilité
          updateEligibilityStatus('investment', true, data.message);
        } else {
          this.innerHTML = '<i class="bi bi-x-circle me-2"></i>Non éligible';
          this.classList.remove('btn-primary-custom');
          this.classList.add('btn-danger');
          updateEligibilityStatus('investment', false, data.message);
        }
        this.disabled = true;
      })
      .catch(error => {
        console.error('Erreur:', error);
        this.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Erreur - Réessayer';
        this.disabled = false;
      });
    });
  }

  // Bouton pour vérifier l'éligibilité RENOLUTION
  const checkRenolutionBtn = document.getElementById('check-eligibility-renolution-btn');
  if (checkRenolutionBtn) {
    checkRenolutionBtn.addEventListener('click', function() {
      this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Vérification en cours...';
      this.disabled = true;

      fetch(`/simulations/${simulationId}/check_eligibility_renolution`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.eligible) {
          this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Éligible RENOLUTION';
          this.classList.remove('btn-success');
          this.classList.add('btn-success');
          updateEligibilityStatus('renolution', true, data.message);
        } else {
          this.innerHTML = '<i class="bi bi-x-circle me-2"></i>Non éligible';
          this.classList.remove('btn-success');
          this.classList.add('btn-danger');
          updateEligibilityStatus('renolution', false, data.message);
        }
        this.disabled = true;
      })
      .catch(error => {
        console.error('Erreur:', error);
        this.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Erreur - Réessayer';
        this.disabled = false;
      });
    });
  }

  // Fonction pour mettre à jour l'affichage d'éligibilité
  function updateEligibilityStatus(type, eligible, message) {
    const statusDiv = document.getElementById(`eligibility-status-${type}`);
    if (statusDiv) {
      if (eligible) {
        statusDiv.innerHTML = `
          <div class="alert alert-success d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-3 fs-4"></i>
            <div>
              <h6 class="alert-heading mb-1">✅ ${message}</h6>
              <p class="mb-0">Vous pouvez maintenant configurer les ${type === 'investment' ? 'investissements' : 'primes RENOLUTION'}.</p>
            </div>
          </div>
        `;
      } else {
        statusDiv.innerHTML = `
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-x-circle-fill me-3 fs-4"></i>
            <div>
              <h6 class="alert-heading mb-1">❌ Non éligible</h6>
              <p class="mb-0">${message}</p>
            </div>
          </div>
        `;
      }
    }
  }
});
</script>
