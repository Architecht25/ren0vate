<!-- Script pour enrichir les cartes avec les données de la base -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Récupération des données enrichies depuis la base
  const primesDataElement = document.getElementById('bruxelles-primes-data');
  if (!primesDataElement) return;

  try {
    const primesData = JSON.parse(primesDataElement.textContent);

    // Enrichissement automatique de toutes les cartes RENOLUTION
    document.querySelectorAll('[data-controller="bruxelles-prime-card"]').forEach(card => {
      const slug = card.dataset.bruxellesPrimeCardSlugValue;

      // Mapping des slugs des cartes vers les vrais slugs de la base
      const slugMapping = {
        'bruxelles_prime_a_global': 'bruxelles_audit_energetique_maison',
        'bruxelles_prime_e_global': 'bruxelles_isolation_toiture_etancheite',
        'bruxelles_prime_f_global': 'bruxelles_isolation_interieure_facade',
        'bruxelles_prime_g_global': 'bruxelles_remplacement_fenetres_bois',
        'bruxelles_prime_h_global': 'bruxelles_isolation_thermique_sols',
        'bruxelles_prime_j_global': 'bruxelles_pac_chauffage',
        'bruxelles_prime_m_global': 'bruxelles_ventilation_systeme_c'
      };

      const realSlug = slugMapping[slug] || slug;
      const primeInfo = primesData[realSlug];

      if (primeInfo) {
        // Chercher ou créer un container pour les informations contextuelles
        let infoContainer = card.querySelector('.row.g-2');
        if (infoContainer) {
          // Vérifier s'il y a déjà des infos contextuelles
          let existingInfo = infoContainer.querySelector('[data-bruxelles-prime-card-target="condition"]');

          if (!existingInfo && (primeInfo.condition || primeInfo.conseil)) {
            // Créer un nouveau conteneur d'informations
            const infoDiv = document.createElement('div');
            infoDiv.className = 'col-12 mt-2';

            let infoHTML = '';
            if (primeInfo.condition) {
              infoHTML += `
                <small class="text-muted d-block" data-bruxelles-prime-card-target="condition">
                  <i class="bi bi-info-circle me-1"></i>Conditions : ${primeInfo.condition.replace(/"/g, '&quot;').replace(/'/g, '&#39;')}
                </small>
              `;
            }
            if (primeInfo.conseil) {
              infoHTML += `
                <small class="text-success d-block mt-1" data-bruxelles-prime-card-target="conseil">
                  <i class="bi bi-lightbulb me-1"></i>Conseil : ${primeInfo.conseil.replace(/"/g, '&quot;').replace(/'/g, '&#39;')}
                </small>
              `;
            }

            infoDiv.innerHTML = infoHTML;
            infoContainer.appendChild(infoDiv);
          }
        }
      }
    });

    // Enrichissement des éléments existants avec data-prime-slug
    document.querySelectorAll('[data-bruxelles-prime-card-target="condition"]').forEach(element => {
      const primeSlug = element.dataset.primeSlug;
      const primeInfo = primesData[primeSlug];

      if (primeInfo && primeInfo.condition) {
        element.innerHTML = `<i class="bi bi-info-circle me-1"></i>Conditions : ${primeInfo.condition.replace(/"/g, '&quot;').replace(/'/g, '&#39;')}`;
      } else {
        element.style.display = 'none';
      }
    });

    document.querySelectorAll('[data-bruxelles-prime-card-target="conseil"]').forEach(element => {
      const primeSlug = element.dataset.primeSlug;
      const primeInfo = primesData[primeSlug];

      if (primeInfo && primeInfo.conseil) {
        element.innerHTML = `<i class="bi bi-lightbulb me-1"></i>Conseil : ${primeInfo.conseil.replace(/"/g, '&quot;').replace(/'/g, '&#39;')}`;
      } else {
        element.style.display = 'none';
      }
    });

    console.log('✅ Enrichissement automatique des cartes RENOLUTION réussi');
    console.log('📊 Données enrichies pour', Object.keys(primesData).length, 'primes');
  } catch (error) {
    console.error('❌ Erreur lors de l\'enrichissement des cartes:', error);
  }
});
</script>
