                <div class="col-md-8 mb-3 mb-md-0">
                  <h2 class="display-4 fw-bold text-primary mb-1" data-bruxelles-prime-calcul-target="totalGeneral">0,00 €</h2>
                  <p class="text-muted mb-0">
                    <span data-bruxelles-prime-calcul-target="currentCategory">Catégorie non définie</span>
