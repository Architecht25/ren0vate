              </div>

              <!-- Colonne milieu: Total principal -->
              <div class="col-md-3 text-center">
                <div class="p-3 bg-light rounded">
                  <h6 class="text-muted mb-2">
                    <i class="bi bi-calculator me-1"></i>
                    Total estimé
                  </h6>
                  <h3 class="text-primary mb-2" data-bruxelles-prime-calcul-target="totalGeneral">0 €</h3>
                  <small class="text-muted">
                    <span data-bruxelles-prime-calcul-target="currentCategory">Catégorie non définie</span><br>
                    Simulation du <%= Date.current.strftime("%d/%m/%Y") %>
                  </small>
                </div>
              </div>

              <!-- Colonne droite: Informations importantes -->
              <div class="col-md-4">
                <div class="alert alert-info py-2 mb-0">
                  <div class="d-flex align-items-start">
                    <i class="bi bi-lightbulb me-2 mt-1"></i>
                    <div>
                      <h6 class="alert-heading mb-1">Bon à savoir</h6>
                      <small>
                        Ces montants sont des estimations basées sur les grilles tarifaires officielles de Bruxelles Environnement.
                        Les primes varient selon votre catégorie de revenus (Cat 1, Cat 2, Cat 3).
                      </small>
                      <div class="mt-1">
                        <small>
                          <a href="#" class="text-decoration-none">Vérifier votre éligibilité</a>
                        </small>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
