<!-- Section Primes Bruxelles RENOLUTION - 13 cartes principales par catégorie -->

<style>
  .drop-shadow {
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
  }

  .card-premium {
    transition: all 0.3s ease;
  }

  .card-premium:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
  }

  .image-overlay {
    background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));
    backdrop-filter: blur(1px);
  }
</style>

<div class="primes-section-bruxelles" data-controller="bruxelles-simulation" data-bruxelles-simulation-simulation-id-value="<%= @simulation.id %>">

  <!-- Injection enrichie des données de primes depuis la base de données -->
  <script id="bruxelles-primes-data" type="application/json">
    <%= raw Prime.where(region: "bruxelles").map { |prime|
      [prime.slug, {
        nom: prime.titre,
        condition: prime.condition,
        conseil: prime.conseil,
        valeurs_par_categorie: {
          "bruxelles_cat1" => prime.valeurs_par_categorie&.dig("bruxelles_cat1") || {},
          "bruxelles_cat2" => prime.valeurs_par_categorie&.dig("bruxelles_cat2") || {},
          "bruxelles_cat3" => prime.valeurs_par_categorie&.dig("bruxelles_cat3") || {}
        }
      }]
    }.to_h.to_json %>
  </script>

  <%
    # Helper pour récupérer la condition d'une prime
    def condition_prime(slug)
      prime = Prime.find_by(slug: slug)
      prime&.condition || "Conditions en cours de chargement..."
    end

    # Helper pour récupérer le conseil d'une prime
    def conseil_prime(slug)
      prime = Prime.find_by(slug: slug)
      prime&.conseil || "Conseil en cours de chargement..."
    end
  %>

  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-success bg-opacity-10">
      <h4 class="card-title mb-0">
        <i class="bi bi-calculator text-success me-2"></i>
        <span data-bruxelles-simulation-target="sectionTitle">
          Vos primes RENOLUTION Bruxelles - Catégorie I à III
        </span>
      </h4>
      <p class="text-muted small mb-0 mt-1">
        💡 Les montants s'ajustent automatiquement selon votre catégorie de revenus
      </p>
    </div>
    <div class="card-body">

      <div class="row g-3">

        <!-- CARTE 1: E3 - ISOLATION THERMIQUE TOITURE -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="bruxelles-prime-card" data-bruxelles-prime-card-slug-value="bruxelles_prime_e_global" data-statut-compatible='["residentiel", "mixte"]'>

            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/isolation_toiture_f9r4hs'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(40, 167, 69, 0.175), rgba(40, 167, 69, 0.1));">
                <div class="text-center text-white">
                  <i class="bi bi-house-up fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Isolation toiture</h6>
                  <small class="opacity-90">Thermique performante</small>
                </div>
              </div>
            </div>

            <div class="card-body">
              <!-- Badge informatif -->
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="badge bg-success bg-opacity-20 text-success rounded-pill px-3">
                    <i class="bi bi-house-up me-1"></i>E3
                  </span>
                  <small class="text-muted">
                    <i class="bi bi-thermometer me-1"></i>Isolation
                  </small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Isolation thermique toiture -->
                <div class="col-md-12">
                  <label class="form-label small">E3 - Isolation thermique :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationThermiqueToiture"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-prime-card-target="resultIsolationThermiqueToiture">0 €</span>
                  </div>

                  <!-- Informations contextuelles depuis la base de données -->
                  <% condition_text = condition_prime("bruxelles_isolation_toiture_etancheite") %>
                  <% conseil_text = conseil_prime("bruxelles_isolation_toiture_etancheite") %>
                  <% if condition_text.present? || conseil_text.present? %>
                    <div class="mt-2">
                      <% if condition_text.present? %>
                        <div class="mb-1">
                          <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <%= condition_text %>
                          </small>
                        </div>
                      <% end %>
                      <% if conseil_text.present? %>
                        <div>
                          <small class="text-success">
                            <i class="bi bi-lightbulb me-1"></i>
                            <%= conseil_text %>
                          </small>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>

              <!-- Total -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-success">Total :</strong>
                  <span class="badge bg-success fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CARTE 2: F1 - ISOLATION FAÇADE -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="bruxelles-prime-card" data-bruxelles-prime-card-slug-value="bruxelles_prime_f_global" data-statut-compatible='["residentiel", "mixte"]'>

            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/isolation_murs_ext_ahbpat'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(108, 117, 125, 0.175), rgba(108, 117, 125, 0.1));">
                <div class="text-center text-white">
                  <i class="bi bi-house fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Isolation façade</h6>
                  <small class="opacity-90">Intérieure, extérieure, coulisse</small>
                </div>
              </div>
            </div>

            <div class="card-body">
              <!-- Badge informatif -->
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="badge bg-secondary bg-opacity-20 text-secondary rounded-pill px-3">
                    <i class="bi bi-house me-1"></i>F1
                  </span>
                  <small class="text-muted">
                    <i class="bi bi-layers me-1"></i>3 types
                  </small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Isolation intérieure façade -->
                <div class="col-md-12">
                  <label class="form-label small">F1 - Isolation intérieure :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationInterieure"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultIsolationInterieure">0 €</span>
                  </div>
                </div>

                <!-- Isolation extérieure façade -->
                <div class="col-md-12">
                  <label class="form-label small">F1 - Isolation extérieure :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationExterieure"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultIsolationExterieure">0 €</span>
                  </div>
                </div>

                <!-- Isolation coulisse -->
                <div class="col-md-12">
                  <label class="form-label small">F1 - Isolation coulisse :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationCoulisse"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultIsolationCoulisse">0 €</span>
                  </div>
                </div>

                <!-- Informations contextuelles depuis la base de données -->
                <% condition_text = condition_prime("bruxelles_isolation_interieure_facade") %>
                <% conseil_text = conseil_prime("bruxelles_isolation_interieure_facade") %>
                <% if condition_text.present? || conseil_text.present? %>
                  <div class="col-12 mt-2">
                    <% if condition_text.present? %>
                      <div class="mb-1">
                        <small class="text-muted">
                          <i class="bi bi-info-circle me-1"></i>
                          <%= condition_text %>
                        </small>
                      </div>
                    <% end %>
                    <% if conseil_text.present? %>
                      <div>
                        <small class="text-success">
                          <i class="bi bi-lightbulb me-1"></i>
                          <%= conseil_text %>
                        </small>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Total -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-secondary">Total :</strong>
                  <span class="badge bg-secondary fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CARTE 3: G1 + G2 - FENÊTRES -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="bruxelles-prime-card" data-bruxelles-prime-card-slug-value="bruxelles_prime_g_global" data-statut-compatible='["residentiel", "mixte"]'>

            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/remplacement_chassis_lrszxo'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.175), rgba(13, 110, 253, 0.1));">
                <div class="text-center text-white">
                  <i class="bi bi-window fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Fenêtres</h6>
                  <small class="opacity-90">Remplacement et réparation</small>
                </div>
              </div>
            </div>

            <div class="card-body">
              <!-- Badge informatif -->
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="badge bg-primary bg-opacity-20 text-primary rounded-pill px-3">
                    <i class="bi bi-window me-1"></i>G1+G2
                  </span>
                  <small class="text-muted">
                    <i class="bi bi-tools me-1"></i>3 types
                  </small>
                </div>
              </div>

              <div class="row g-2">
                <!-- G1 - Remplacement fenêtres bois -->
                <div class="col-md-12">
                  <label class="form-label small">G1 - Fenêtres bois :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputFenetresBois"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultFenetresBois">0 €</span>
                  </div>
                </div>

                <!-- G1 - Remplacement fenêtres PVC/alu -->
                <div class="col-md-12">
                  <label class="form-label small">G1 - Fenêtres PVC/alu :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputFenetresPvcAlu"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultFenetresPvcAlu">0 €</span>
                  </div>
                </div>

                <!-- G2 - Réparation fenêtres -->
                <div class="col-md-12">
                  <label class="form-label small">G2 - Réparation fenêtres :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputReparationFenetres"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultReparationFenetres">0 €</span>
                  </div>
                </div>

                <!-- Informations contextuelles depuis la base de données -->
                <% condition_text = condition_prime("bruxelles_remplacement_fenetres_bois") %>
                <% conseil_text = conseil_prime("bruxelles_remplacement_fenetres_bois") %>
                <% if condition_text.present? || conseil_text.present? %>
                  <div class="col-12 mt-2">
                    <% if condition_text.present? %>
                      <div class="mb-1">
                        <small class="text-muted">
                          <i class="bi bi-info-circle me-1"></i>
                          <%= condition_text %>
                        </small>
                      </div>
                    <% end %>
                    <% if conseil_text.present? %>
                      <div>
                        <small class="text-success">
                          <i class="bi bi-lightbulb me-1"></i>
                          <%= conseil_text %>
                        </small>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Total -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-primary">Total :</strong>
                  <span class="badge bg-primary fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CARTE 4: H1 - ISOLATION SOLS -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="bruxelles-prime-card" data-bruxelles-prime-card-slug-value="bruxelles_prime_h_global" data-statut-compatible='["residentiel", "mixte"]'>

            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/isolation_sol_kokpgs'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(33, 37, 41, 0.175), rgba(33, 37, 41, 0.1));">
                <div class="text-center text-white">
                  <i class="bi bi-square fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Isolation sols</h6>
                  <small class="opacity-90">Isolation thermique</small>
                </div>
              </div>
            </div>

            <div class="card-body">
              <!-- Badge informatif -->
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="badge bg-dark bg-opacity-20 text-dark rounded-pill px-3">
                    <i class="bi bi-square me-1"></i>H1
                  </span>
                  <small class="text-muted">
                    <i class="bi bi-thermometer me-1"></i>Sols
                  </small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Isolation thermique sols -->
                <div class="col-md-12">
                  <label class="form-label small">H1 - Isolation thermique :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationThermiqueSols"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-dark text-white"
                          data-bruxelles-prime-card-target="resultIsolationThermiqueSols">0 €</span>
                  </div>
                </div>

                <!-- Informations contextuelles depuis la base de données -->
                <% condition_text = condition_prime("bruxelles_isolation_thermique_sols") %>
                <% conseil_text = conseil_prime("bruxelles_isolation_thermique_sols") %>
                <% if condition_text.present? || conseil_text.present? %>
                  <div class="col-12 mt-2">
                    <% if condition_text.present? %>
                      <div class="mb-1">
                        <small class="text-muted">
                          <i class="bi bi-info-circle me-1"></i>
                          <%= condition_text %>
                        </small>
                      </div>
                    <% end %>
                    <% if conseil_text.present? %>
                      <div>
                        <small class="text-success">
                          <i class="bi bi-lightbulb me-1"></i>
                          <%= conseil_text %>
                        </small>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Total -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-dark">Total :</strong>
                  <span class="badge bg-dark fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- SECONDE LIGNE: 5 cartes J4, J6, J8, J10, M2 -->
      <div class="row g-3 mt-1">

        <!-- CARTE 5: J4 - PAC CHAUFFAGE -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="bruxelles-prime-card" data-bruxelles-prime-card-slug-value="bruxelles_prime_j_global" data-statut-compatible='["residentiel", "mixte"]'>

            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/pac_géothermique_cj7l2y'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(220, 53, 69, 0.1), rgba(220, 53, 69, 0.05));">
                <div class="text-center text-white">
                  <i class="bi bi-thermometer-half fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">PAC chauffage</h6>
                  <small class="opacity-90">Pompe à chaleur</small>
                </div>
              </div>
            </div>

            <div class="card-body">
              <!-- Badge informatif -->
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="badge bg-danger bg-opacity-20 text-danger rounded-pill px-3">
                    <i class="bi bi-thermometer-half me-1"></i>J4
                  </span>
                  <small class="text-muted">
                    <i class="bi bi-gear me-1"></i>Chauffage
                  </small>
                </div>
              </div>

              <div class="row g-2">
                <!-- PAC chauffage -->
                <div class="col-md-12">
                  <label class="form-label small">J4 - PAC chauffage :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-prime-card-target="inputPacChauffage"
                            data-action="change->bruxelles-prime-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-danger text-white"
                          data-bruxelles-prime-card-target="resultPacChauffage">0 €</span>
                  </div>
                </div>

                <!-- Informations contextuelles depuis la base de données -->
                <% condition_text = condition_prime("bruxelles_pac_chauffage") %>
                <% conseil_text = conseil_prime("bruxelles_pac_chauffage") %>
                <% if condition_text.present? || conseil_text.present? %>
                  <div class="col-12 mt-2">
                    <% if condition_text.present? %>
                      <div class="mb-1">
                        <small class="text-muted">
                          <i class="bi bi-info-circle me-1"></i>
                          <%= condition_text %>
                        </small>
                      </div>
                    <% end %>
                    <% if conseil_text.present? %>
                      <div>
                        <small class="text-success">
                          <i class="bi bi-lightbulb me-1"></i>
                          <%= conseil_text %>
                        </small>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Total -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-danger">Total :</strong>
                  <span class="badge bg-danger fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CARTE 6: J6 - RADIATEURS -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="bruxelles-prime-card" data-bruxelles-prime-card-slug-value="bruxelles_prime_j_global" data-statut-compatible='["residentiel", "mixte"]'>

            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/efficacite-energetique-batiment_mlgdaj'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(255, 193, 7, 0.1), rgba(255, 193, 7, 0.05));">
                <div class="text-center text-white">
                  <i class="bi bi-radioactive fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Radiateurs</h6>
                  <small class="opacity-90">Basse température</small>
                </div>
              </div>
            </div>

            <div class="card-body">
              <!-- Badge informatif -->
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill px-3">
                    <i class="bi bi-radioactive me-1"></i>J6
                  </span>
                  <small class="text-muted">
