<!-- Section Investissements Entreprise Bruxelles - 4 catégories basées sur les données réelles -->
<div class="investissements-section-bruxelles-entreprise" data-controller="bruxelles-entreprise-calcul">

  <!-- Injection des données d'investissements depuis la base de données -->
  <script id="bruxelles-entreprise-data" type="application/json">
    <%= raw EntrepriseAide.where(region: "bruxelles").group_by(&:categorie).transform_values { |aides|
      aides.map { |aide|
        [aide.slug, {
          nom: aide.titre,
          taux_aide: aide.taux_aide || 25.0,
          montant_min: aide.montant_min || 500,
          montant_max: aide.montant_max || 10000,
          tailles_eligibles: aide.tailles_eligibles || ["tpe", "pme"]
        }]
      }.to_h
    }.to_json %>
  </script>

  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-primary bg-opacity-10">
      <h4 class="card-title mb-0">
        <i class="bi bi-building text-primary me-2"></i>
        <span data-bruxelles-entreprise-calcul-target="sectionTitle">
          Vos aides aux investissements entreprise Bruxelles
        </span>
      </h4>
      <p class="text-muted small mb-0 mt-1">
        💼 Les montants s'ajustent selon le type d'entreprise (TPE, PME, Moyenne) et les majorations possibles
      </p>
    </div>
    <div class="card-body">


      <div class="row g-3">

        <!-- CATÉGORIE 1: TRANSITION ÉCONOMIQUE -->
        <div class="col-lg-3 col-md-12">
          <div class="card border-0 shadow h-100"
               data-aide-card="transition_energetique">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-arrow-repeat fs-5 text-success"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Transition Économique</h6>
                  <small class="text-muted">Consultance, investissements verts, mobilité</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Consultance transition -->
                <div class="col-8">
                  <label class="form-label small">Consultance transition (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           name="consultance_transition"
                           data-slug="bruxelles_entreprise_consultance_transition">
                    <span class="input-group-text bg-success text-white">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 15.000€/an - Taux 50% (max 80%)</small>
                </div>

                <!-- Investissements transition -->
                <div class="col-8">
                  <label class="form-label small">Investissements transition (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           name="investissements_transition"
                           data-slug="bruxelles_entreprise_investissements_transition">
                    <span class="input-group-text bg-success text-white">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 50.000€/an - Taux 30% (max 50%)</small>
                </div>

                <!-- Mobilité vélo-cargo -->
                <div class="col-8">
                  <label class="form-label small">Mobilité vélo-cargo (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           name="mobilite_velo"
                           data-slug="bruxelles_entreprise_mobilite_velo">
                    <span class="input-group-text bg-success text-white">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 12.000€/an - Taux 40% (max 70%)</small>
                </div>

                <!-- Utilitaires électriques -->
                <div class="col-8">
                  <label class="form-label small">Utilitaires électriques (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           name="utilitaires_electriques"
                           data-slug="bruxelles_entreprise_utilitaires_electriques">
                    <span class="input-group-text bg-success text-white">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 25.000€/véhicule - Taux 30% (max 50%)</small>
                </div>

                <!-- Utilitaire retrofit -->
                <div class="col-8">
                  <label class="form-label small">Utilitaire retrofit (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           name="utilitaire_retrofit"
                           data-slug="bruxelles_entreprise_utilitaire_retrofit">
                    <span class="input-group-text bg-success text-white">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 15.000€/véhicule - Taux 40% (max 60%)</small>
                </div>
              </div>

              <!-- Total Transition -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-success">Total Transition :</strong>
                  <span class="badge bg-success fs-6 total-card">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CATÉGORIE 2: INVESTISSEMENTS MATÉRIELS -->
        <div class="col-lg-3 col-md-12">
          <div class="card border-0 shadow h-100"
               data-controller="bruxelles-entreprise-card"
               data-bruxelles-entreprise-card-slug-value="investissements"
               data-type-entreprise='["tpe", "pme", "moyenne"]'>
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-gear-wide-connected fs-5 text-primary"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Investissements Matériels</h6>
                  <small class="text-muted">Matériel, travaux, conformité, sécurisation</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Matériel et travaux -->
                <div class="col-8">
                  <label class="form-label small">Matériel et travaux (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputMaterielTravaux"
                           data-bruxelles-entreprise-card-slug="bruxelles_prime_materiel_travaux">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-entreprise-card-target="resultMaterielTravaux">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 500.000€ - Taux 5% (micro/petite)</small>
                </div>

                <!-- Conformité -->
                <div class="col-8">
                  <label class="form-label small">Conformité (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputConformite"
                           data-bruxelles-entreprise-card-slug="bruxelles_prime_conformite">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-entreprise-card-target="resultConformite">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 40.000€ - Taux 30% (max 60%)</small>
                </div>

                <!-- Sécurisation -->
                <div class="col-8">
                  <label class="form-label small">Sécurisation établissement (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputSecurisation"
                           data-bruxelles-entreprise-card-slug="bruxelles_prime_securisation">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-entreprise-card-target="resultSecurisation">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 10.000€ - Taux 40% (max 60%)</small>
                </div>

                <!-- Immobilier -->
                <div class="col-8">
                  <label class="form-label small">Immobilier (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputImmobilier"
                           data-bruxelles-entreprise-card-slug="bruxelles_prime_immobilier">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-entreprise-card-target="resultImmobilier">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 200.000€ - Taux 15% (max 30%)</small>
                </div>

                <!-- Accessibilité -->
                <div class="col-8">
                  <label class="form-label small">Accessibilité (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputAccessibilite"
                           data-bruxelles-entreprise-card-slug="bruxelles_prime_accessibilite">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-entreprise-card-target="resultAccessibilite">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 50.000€ - Taux 50% (max 70%)</small>
                </div>
              </div>

              <!-- Total Investissements -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-primary">Total Investissements :</strong>
                  <span class="badge bg-primary fs-6" data-bruxelles-entreprise-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CATÉGORIE 3: RECRUTEMENT ET FORMATION -->
        <div class="col-lg-3 col-md-12">
          <div class="card border-0 shadow h-100"
               data-controller="bruxelles-entreprise-card"
               data-bruxelles-entreprise-card-slug-value="recrutement_formation"
               data-type-entreprise='["tpe", "pme", "moyenne"]'>
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-people fs-5 text-warning"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Recrutement & Formation</h6>
                  <small class="text-muted">Aides à l'embauche, formation personnel</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Recrutement -->
                <div class="col-8">
                  <label class="form-label small">Aides au recrutement (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputRecrutement"
                           data-bruxelles-entreprise-card-slug="bruxelles_aide_recrutement">
                    <span class="input-group-text bg-warning text-white"
                          data-bruxelles-entreprise-card-target="resultRecrutement">0 €</span>
                  </div>
                  <small class="text-muted">Forfaitaire selon profil recruté</small>
                </div>

                <!-- Formation -->
                <div class="col-8">
                  <label class="form-label small">Formation du personnel (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputFormation"
                           data-bruxelles-entreprise-card-slug="bruxelles_prime_formation">
                    <span class="input-group-text bg-warning text-white"
                          data-bruxelles-entreprise-card-target="resultFormation">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 20.000€/an - Taux 40% (max 80%)</small>
                </div>
              </div>

              <!-- Total RH -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-warning">Total RH :</strong>
                  <span class="badge bg-warning fs-6" data-bruxelles-entreprise-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CATÉGORIE 4: EXPERTISES ET SERVICES EXTERNES -->
        <div class="col-lg-3 col-md-12">
          <div class="card border-0 shadow h-100"
               data-controller="bruxelles-entreprise-card"
               data-bruxelles-entreprise-card-slug-value="expertises_services_externes"
               data-type-entreprise='["tpe", "pme", "moyenne"]'>
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-briefcase fs-5 text-info"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Expertises & Services</h6>
                  <small class="text-muted">Consultance, études, audits externes</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Consultance générale -->
                <div class="col-8">
                  <label class="form-label small">Consultance générale (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputConsultance"
                           data-bruxelles-entreprise-card-slug="bruxelles_prime_consultance">
                    <span class="input-group-text bg-info text-white"
                          data-bruxelles-entreprise-card-target="resultConsultance">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 7.500€/an - Taux 25% (max 70%)</small>
                </div>

                <!-- Consultance digitalisation -->
                <div class="col-8">
                  <label class="form-label small">Consultance digitalisation (€) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="€"
                           data-bruxelles-entreprise-card-target="inputDigitalisation"
                           data-bruxelles-entreprise-card-slug="bruxelles_consultance_digitalisation">
                    <span class="input-group-text bg-info text-white"
                          data-bruxelles-entreprise-card-target="resultDigitalisation">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 10.000€/an - Taux 50% (max 70%)</small>
                </div>
              </div>

              <!-- Total Services -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-info">Total Services :</strong>
                  <span class="badge bg-info fs-6" data-bruxelles-entreprise-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Section Résultats Totaux Entreprise -->
  <div class="mt-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-3">

        <div class="row align-items-center">
          <!-- Colonne gauche: Détail par catégorie -->
          <div class="col-md-5">
            <h6 class="text-muted mb-2">Détail par catégorie</h6>
            <div class="row g-2">
              <div class="col-6">
                <div class="p-2 bg-success bg-opacity-10 rounded text-center">
                  <small class="text-success fw-bold">Transition</small><br>
                  <span class="text-success fw-bold" data-bruxelles-entreprise-calcul-target="totalTransition">0 €</span>
                </div>
              </div>
              <div class="col-6">
                <div class="p-2 bg-primary bg-opacity-10 rounded text-center">
                  <small class="text-primary fw-bold">Investissements</small><br>
                  <span class="text-primary fw-bold" data-bruxelles-entreprise-calcul-target="totalInvestissements">0 €</span>
                </div>
              </div>
              <div class="col-6">
                <div class="p-2 bg-warning bg-opacity-10 rounded text-center">
                  <small class="text-warning fw-bold">RH</small><br>
                  <span class="text-warning fw-bold" data-bruxelles-entreprise-calcul-target="totalRH">0 €</span>
                </div>
              </div>
              <div class="col-6">
                <div class="p-2 bg-info bg-opacity-10 rounded text-center">
                  <small class="text-info fw-bold">Services</small><br>
                  <span class="text-info fw-bold" data-bruxelles-entreprise-calcul-target="totalServices">0 €</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Colonne milieu: Total principal -->
          <div class="col-md-3 text-center">
            <div class="p-3 bg-light rounded">
              <h6 class="text-muted mb-2">
                <i class="bi bi-calculator me-1"></i>
                Total estimé
              </h6>
              <h3 class="text-primary mb-2" data-bruxelles-entreprise-calcul-target="totalGeneral">0 €</h3>
              <small class="text-muted">
                <span data-bruxelles-entreprise-calcul-target="categorieEntreprise">Type d'entreprise</span><br>
                Simulation du <%= Date.current.strftime("%d/%m/%Y") %>
              </small>
            </div>
          </div>

          <!-- Colonne droite: Informations importantes -->
          <div class="col-md-4">
            <div class="alert alert-info py-2 mb-0">
              <div class="d-flex align-items-start">
                <i class="bi bi-info-circle me-2 mt-1"></i>
                <div>
                  <h6 class="alert-heading mb-1">Informations importantes</h6>
                  <small>
                    Estimations basées sur les programmes d'aide de la Région de Bruxelles-Capitale.
                    Les aides varient selon la taille d'entreprise et les majorations possibles.
                  </small>
                  <div class="mt-1">
                    <small>
                      <a href="#" class="text-decoration-none">Voir les conditions détaillées</a>
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
