<!-- Section Investissements Entreprise Bruxelles - 4 catégories basées sur les données réelles -->

<!-- Styles pour les cartes avec images de fond -->
<style>
  .card-premium {
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .card-premium:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.15) !important;
  }

  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.7) 100%);
    z-index: 1;
  }

  .card-premium .card-body {
    position: relative;
    z-index: 2;
  }
</style>

<div class="investissements-section-bruxelles-entreprise"
     data-controller="bruxelles-entreprise-cartes tooltip">

  <!-- Injection des données d'investissements depuis la base de données -->
  <script id="bruxelles-entreprise-data" type="application/json">
    <%= raw EntrepriseAide.where(region: "bruxelles").group_by(&:categorie).transform_values { |aides|
      aides.map { |aide|
        [aide.slug, {
          nom: aide.titre,
          taux_aide: aide.taux_aide || 25.0,
          montant_min: aide.montant_min || 500,
          montant_max: aide.montant_max, # Respecter le vrai plafond (peut être nil = sans plafond)
          montant_investissement_min_requis: aide.montant_investissement_min_requis,
          tailles_eligibles: aide.tailles_eligibles || ["tpe", "pme"]
        }]
      }.to_h
    }.to_json %>
  </script>

  <%
    # Helper pour récupérer le placeholder calculé pour une aide
    def placeholder_for_aide(slug)
      aide = EntrepriseAide.find_by(slug: slug)
      if aide&.slug == "bruxelles_prime_materiel_travaux"
        # Pour cette aide, le placeholder sera mis à jour dynamiquement via JavaScript
        "5.000€ min"
      elsif aide&.slug == "bruxelles_prime_immobilier"
        # Pour la prime immobilier, montant minimum statique de 100.000€
        "100.000€ min"
      elsif aide&.slug == "bruxelles_prime_conformite_normes"
        # Pour la prime conformité, montant minimum statique de 5.000€
        "5.000€ min"
      elsif aide&.slug == "bruxelles_prime_securisation"
        # Pour la prime sécurisation, montant minimum statique de 2.000€
        "2.000€ min"
      elsif aide&.slug == "bruxelles_prime_accessibilite"
        # Pour la prime accessibilité, montant minimum statique de 1.000€
        "1.000€ min"
      elsif aide&.slug == "bruxelles_investissements_transition_economique"
        # Pour les investissements transition économique, montant minimum statique de 2.000€
        "2.000€ min"
      elsif aide&.slug == "bruxelles_mobilite_velo_cargo"
        # Pour la prime mobilité vélo cargo, montant minimum statique de 500€
        "500€ min"
      elsif aide&.slug == "bruxelles_prime_consultance"
        # Pour la prime consultance, montant minimum statique de 500€
        "500€ min"
      elsif aide&.slug == "bruxelles_prime_digitalisation"
        # Pour la prime digitalisation, montant minimum statique de 500€
        "500€ min"
      elsif aide&.montant_investissement_min_requis
        "#{aide.montant_investissement_min_requis}€ min"
      else
        "€"
      end
    end

    # Helper pour récupérer le titre d'une aide
    def titre_aide(slug)
      aide = EntrepriseAide.find_by(slug: slug)
      aide&.titre || "Aide"
    end

    # Helper pour récupérer la description d'une aide
    def description_aide(slug)
      aide = EntrepriseAide.find_by(slug: slug)
      aide&.description || ""
    end

    # Helper pour générer les badges de taille d'entreprise
    def badges_tailles_aide(slug)
      aide = EntrepriseAide.find_by(slug: slug)
      return "" unless aide&.tailles_eligibles.present?

      badges = aide.tailles_eligibles.map do |taille|
        case taille
        when "tpe"
          '<span class="badge bg-success text-white border me-1 px-2 py-1" style="font-weight: 600;">TPE</span>'
        when "pme"
          '<span class="badge bg-primary text-white border me-1 px-2 py-1" style="font-weight: 600;">PME</span>'
        when "moyenne"
          '<span class="badge bg-warning text-dark border me-1 px-2 py-1" style="font-weight: 600;">Moyenne</span>'
        when "grande"
          '<span class="badge bg-danger text-white border me-1 px-2 py-1" style="font-weight: 600;">Grande</span>'
        else
          '<span class="badge bg-secondary text-white border me-1 px-2 py-1" style="font-weight: 600;">' + taille.upcase + '</span>'
        end
      end

      badges.join.html_safe
    end

    # Helper pour les infobulles d'éligibilité
    def infobulle_aide(slug)
      aide = EntrepriseAide.find_by(slug: slug)
      return "" unless aide

      # Définition des tailles d'entreprise
      definitions_tailles = {
        "tpe" => "TPE : < 10 salariés et < 2M€ CA",
        "pme" => "PME : < 50 salariés et < 10M€ CA",
        "moyenne" => "Moyenne : < 250 salariés et < 50M€ CA",
        "grande" => "Grande : ≥ 250 salariés ou ≥ 50M€ CA"
      }

      tailles_texte = ""
      if aide.tailles_eligibles.present?
        tailles_list = aide.tailles_eligibles.map { |t| definitions_tailles[t] }.compact
        tailles_texte = "👥 Tailles éligibles :<br>• " + tailles_list.join("<br>• ")
      end

      # Conditions de la mission (info spécifique)
      mission_texte = ""
      if aide.conditions_eligibilite.present?
        # Chercher les conditions spécifiques à la mission
        if aide.conditions_eligibilite["mission"].present?
          missions = aide.conditions_eligibilite["mission"].first(2)
          mission_texte = "<br><br>📋 Conditions mission :<br>• " + missions.join("<br>• ")
        elsif aide.conditions_eligibilite["missions_eligibles"].present?
          missions = aide.conditions_eligibilite["missions_eligibles"].first(2)
          mission_texte = "<br><br>📋 Missions éligibles :<br>• " + missions.join("<br>• ")
        elsif aide.conditions_eligibilite["missions_digitalisation"].present?
          missions = aide.conditions_eligibilite["missions_digitalisation"].first(2)
          mission_texte = "<br><br>📋 Missions éligibles :<br>• " + missions.join("<br>• ")
        elsif aide.conditions_eligibilite["investissements_eligibles"].present?
          investissements = aide.conditions_eligibilite["investissements_eligibles"].first(2)
          mission_texte = "<br><br>📋 Investissements éligibles :<br>• " + investissements.join("<br>• ")
        end
      end

      # Conditions du consultant (info spécifique)
      consultant_texte = ""
      if aide.conditions_eligibilite.present? && aide.conditions_eligibilite["consultant"].present?
        consultants = aide.conditions_eligibilite["consultant"].first(2)
        consultant_texte = "<br><br>👨‍💼 Conditions consultant :<br>• " + consultants.join("<br>• ")
      elsif aide.delais_procedures.present? && aide.delais_procedures["profil_consultant"].present?
        # Extraire les conditions les plus importantes du profil consultant
        profil = aide.delais_procedures["profil_consultant"]
        conditions_consultant = []
        conditions_consultant << profil["experience"] if profil["experience"].present?
        conditions_consultant << profil["specialisation"] if profil["specialisation"].present?
        if conditions_consultant.any?
          consultant_texte = "<br><br>👨‍💼 Profil consultant :<br>• " + conditions_consultant.first(2).join("<br>• ")
        end
      end

      # URL officielle
      url_texte = ""
      if aide.url_officielle.present?
        url_texte = "<br><br>🔗 Plus d'infos :<br>#{aide.url_officielle}"
      end

      tooltip_content = tailles_texte + mission_texte + consultant_texte + url_texte

      %{<i class="bi bi-info-circle-fill text-muted ms-1"
           data-bs-toggle="tooltip"
           data-bs-placement="top"
           data-bs-html="true"
           title="#{tooltip_content.gsub('"', '&quot;')}"
           style="cursor: help;"></i>}.html_safe
    end

    # Helper pour l'infobulle délais et procédures
    def infobulle_delais_aide(slug)
      aide = EntrepriseAide.find_by(slug: slug)
      return "" unless aide

      # Délais critiques
      delais_texte = ""
      if aide.modalites_paiement.present? && aide.modalites_paiement["delais"].present?
        delais = aide.modalites_paiement["delais"]
        delais_texte = "⏱️ Délais critiques :"
        delais_texte += "<br>• Demande : #{delais['demande']}" if delais["demande"].present?
        delais_texte += "<br>• Décision : #{delais['decision']}" if delais["decision"].present?
        delais_texte += "<br>• Justificatifs : #{delais['justificatifs']}" if delais["justificatifs"].present?
      end

      # Étapes procédurales
      etapes_texte = ""
      if aide.delais_procedures.present?
        etapes_texte = "<br><br>📋 Étapes clés :"
        etapes_texte += "<br>• Demande via plateforme MonBEE"
        etapes_texte += "<br>• Validation administrative (4 mois max)"
        etapes_texte += "<br>• Réalisation mission/investissement"
        etapes_texte += "<br>• Envoi justificatifs et paiement"
      end

      # Fréquence/limites
      limites_texte = ""
      if aide.modalites_paiement.present?
        if aide.modalites_paiement["frequence"].present?
          limites_texte = "<br><br>� Fréquence :<br>• #{aide.modalites_paiement['frequence']}"
        elsif aide.modalites_paiement["frequence_missions"].present?
          limites_texte = "<br><br>🔄 Fréquence :<br>• #{aide.modalites_paiement['frequence_missions']}"
        end
      end

      tooltip_content = delais_texte + etapes_texte + limites_texte

      return "" if tooltip_content.blank?

      %{<i class="bi bi-clock-fill text-muted ms-1"
           data-bs-toggle="tooltip"
           data-bs-placement="top"
           data-bs-html="true"
           title="#{tooltip_content.gsub('"', '&quot;')}"
           style="cursor: help;"></i>}.html_safe
    end
  %>

  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-primary bg-opacity-10">
      <h4 class="card-title mb-0">
        <i class="bi bi-building text-primary me-2"></i>
        <span data-bruxelles-entreprise-calcul-target="sectionTitle">
          Vos aides aux investissements entreprise Bruxelles
        </span>
      </h4>
      <p class="text-muted small mb-0 mt-1">
        💼 Les montants s'ajustent selon le type d'entreprise (TPE, PME, Moyenne) et les majorations possibles
      </p>
    </div>
    <div class="card-body">


      <div class="row g-3">

        <!-- CATÉGORIE 1: TRANSITION ÉCONOMIQUE -->
        <div class="col-lg-3 col-md-12">
          <div class="card border-0 shadow h-100 card-premium position-relative"
               data-controller="bruxelles-entreprise-card"
               data-bruxelles-entreprise-card-slug-value="transition_energetique"
               data-aide-card="transition_energetique">
            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/Les-enjeux-economiques-de-la-transition-vers-la-neutralite-carbone-min_pnxl9b'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
                <div class="text-center text-white">
                  <i class="bi bi-arrow-repeat fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Transition Économique</h6>
                  <small class="opacity-90">Consultance, investissements verts, mobilité</small>
                </div>
              </div>
            </div>
            <div class="card-body">
              <div class="row g-2">
                <!-- Consultance transition -->
                <div class="col-12">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <label class="form-label small mb-0">
                      <%= titre_aide('bruxelles_transition_consultance') %> (€) :
                      <%= infobulle_aide('bruxelles_transition_consultance') %>
                      <%= infobulle_delais_aide('bruxelles_transition_consultance') %>
                    </label>
                    <div class="text-end">
                      <%= badges_tailles_aide('bruxelles_transition_consultance') %>
                    </div>
                  </div>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="<%= placeholder_for_aide('bruxelles_transition_consultance') %>"
                           name="consultance_transition"
                           data-bruxelles-entreprise-card-slug="bruxelles_transition_consultance"
                           data-bruxelles-entreprise-card-target="inputConsultanceTransition"
                           data-action="input->bruxelles-entreprise-card#handleInput">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-entreprise-card-target="resultConsultanceTransition">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 15.000€/an - Taux 50% (max 80%)</small>
                  <p class="text-success small mt-1 mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= description_aide('bruxelles_transition_consultance').truncate(120) %>
                  </p>
                </div>

                <!-- Investissements transition -->
                <div class="col-12">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <label class="form-label small mb-0">
                      <%= titre_aide('bruxelles_investissements_transition_economique') %> (€) :
                      <%= infobulle_aide('bruxelles_investissements_transition_economique') %>
                      <%= infobulle_delais_aide('bruxelles_investissements_transition_economique') %>
                    </label>
                    <div class="text-end">
                      <%= badges_tailles_aide('bruxelles_investissements_transition_economique') %>
                    </div>
                  </div>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="<%= placeholder_for_aide('bruxelles_investissements_transition_economique') %>"
                           name="investissements_transition"
                           data-bruxelles-entreprise-card-slug="bruxelles_investissements_transition_economique"
                           data-bruxelles-entreprise-card-target="inputInvestissementsTransition"
                           data-action="input->bruxelles-entreprise-card#handleInput">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-entreprise-card-target="resultInvestissementsTransition">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 50.000€/an - Taux 30% (max 50%)</small>
                  <p class="text-success small mt-1 mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= description_aide('bruxelles_investissements_transition_economique').truncate(120) %>
                  </p>
                </div>

                <!-- Mobilité vélo-cargo -->
                <div class="col-12">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <label class="form-label small mb-0">
                      <%= titre_aide('bruxelles_mobilite_velo_cargo') %> (€) :
                      <%= infobulle_aide('bruxelles_mobilite_velo_cargo') %>
                      <%= infobulle_delais_aide('bruxelles_mobilite_velo_cargo') %>
                    </label>
                    <div class="text-end">
                      <%= badges_tailles_aide('bruxelles_mobilite_velo_cargo') %>
                    </div>
                  </div>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="<%= placeholder_for_aide('bruxelles_mobilite_velo_cargo') %>"
                           name="mobilite_velo"
                           data-bruxelles-entreprise-card-slug="bruxelles_mobilite_velo_cargo"
                           data-bruxelles-entreprise-card-target="inputMobiliteVeloCargo"
                           data-action="input->bruxelles-entreprise-card#handleInput">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-entreprise-card-target="resultMobiliteVeloCargo">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 3×4.000€/an - Taux 40% (max 70%)</small>
                  <p class="text-success small mt-1 mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= description_aide('bruxelles_mobilite_velo_cargo').truncate(120) %>
                  </p>
                </div>

                <!-- Utilitaires électriques -->
                <div class="col-12">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <label class="form-label small mb-0">
                      <%= titre_aide('bruxelles_mobilite_utilitaire_electrique') %> (€) :
                      <%= infobulle_aide('bruxelles_mobilite_utilitaire_electrique') %>
                      <%= infobulle_delais_aide('bruxelles_mobilite_utilitaire_electrique') %>
                    </label>
                    <div class="text-end">
                      <%= badges_tailles_aide('bruxelles_mobilite_utilitaire_electrique') %>
                    </div>
                  </div>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="<%= placeholder_for_aide('bruxelles_mobilite_utilitaire_electrique') %>"
                           name="utilitaires_electriques"
                           data-bruxelles-entreprise-card-slug="bruxelles_mobilite_utilitaire_electrique"
                           data-bruxelles-entreprise-card-target="inputMobiliteUtilitaireElectrique"
                           data-action="input->bruxelles-entreprise-card#handleInput">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-entreprise-card-target="resultMobiliteUtilitaireElectrique">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 3*16.000€/véhicule - Taux 5% (max 40%)</small>
                  <p class="text-success small mt-1 mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= description_aide('bruxelles_mobilite_utilitaire_electrique').truncate(120) %>
                  </p>
                </div>

                <!-- Utilitaire retrofit -->
                <div class="col-12">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <label class="form-label small mb-0">
                      <%= titre_aide('bruxelles_mobilite_utilitaire_retrofit') %> (€) :
                      <%= infobulle_aide('bruxelles_mobilite_utilitaire_retrofit') %>
                      <%= infobulle_delais_aide('bruxelles_mobilite_utilitaire_retrofit') %>
                    </label>
                    <div class="text-end">
                      <%= badges_tailles_aide('bruxelles_mobilite_utilitaire_retrofit') %>
                    </div>
                  </div>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="<%= placeholder_for_aide('bruxelles_mobilite_utilitaire_retrofit') %>"
                           name="utilitaire_retrofit"
                           data-bruxelles-entreprise-card-slug="bruxelles_mobilite_utilitaire_retrofit"
                           data-bruxelles-entreprise-card-target="inputMobiliteUtilitaireRetrofit"
                           data-action="input->bruxelles-entreprise-card#handleInput">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-entreprise-card-target="resultMobiliteUtilitaireRetrofit">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 3*16.000€/véhicule - Taux 5% (max 70%)</small>
                  <p class="text-success small mt-1 mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= description_aide('bruxelles_mobilite_utilitaire_retrofit').truncate(120) %>
                  </p>
                </div>
              </div>

              <!-- Total Transition -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-success">Total Transition :</strong>
                  <span class="badge bg-success fs-6" data-bruxelles-entreprise-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CATÉGORIE 2: INVESTISSEMENTS MATÉRIELS -->
        <div class="col-lg-3 col-md-12">
          <div class="card border-0 shadow h-100 card-premium position-relative"
               data-controller="bruxelles-entreprise-card"
               data-bruxelles-entreprise-card-slug-value="investissements"
               data-type-entreprise='["tpe", "pme", "moyenne"]'>
            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/financement-dequipement-comment-reduire-les-couts-dinvestissement-1024x683_l1zath'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
                <div class="text-center text-white">
                  <i class="bi bi-gear-wide-connected fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Investissements Matériels</h6>
                  <small class="opacity-90">Matériel, travaux, conformité, sécurisation</small>
                </div>
              </div>
            </div>
            <div class="card-body">
              <div class="row g-2">
                <!-- Matériel et travaux -->
                <div class="col-12">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <label class="form-label small mb-0">
                      <%= titre_aide('bruxelles_prime_materiel_travaux') %> (€) :
                      <%= infobulle_aide('bruxelles_prime_materiel_travaux') %>
                      <%= infobulle_delais_aide('bruxelles_prime_materiel_travaux') %>
                    </label>
                    <div class="text-end">
                      <%= badges_tailles_aide('bruxelles_prime_materiel_travaux') %>
                    </div>
                  </div>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="<%= placeholder_for_aide('bruxelles_prime_materiel_travaux') %>"
                           data-bruxelles-entreprise-card-target="inputMaterielTravaux"
                           data-bruxelles-entreprise-card-slug="bruxelles_prime_materiel_travaux"
                           data-action="input->bruxelles-entreprise-card#handleInput">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-entreprise-card-target="resultMaterielTravaux">0 €</span>
                  </div>
                  <small class="text-muted">Jusqu'à 500.000€ - Taux 5% (micro/petite)</small>
                  <p class="text-primary small mt-1 mb-2">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= description_aide('bruxelles_prime_materiel_travaux').truncate(120) %>
                  </p>
                </div>

                <!-- Conformité -->
                <div class="col-12">
                  <div class="d-flex align-items-center justify-content-between mb-1">
                    <label class="form-label small mb-0">
                      <%= titre_aide('bruxelles_prime_conformite_normes') %> (€) :
                      <%= infobulle_aide('bruxelles_prime_conformite_normes') %>
                      <%= infobulle_delais_aide('bruxelles_prime_conformite_normes') %>
                    </label>
                    <div class="text-end">
                      <%= badges_tailles_aide('bruxelles_prime_conformite_normes') %>
                    </div>
                  </div>
