<!-- Version compacte de la comparaison d'économie -->
<% if @savings_data && @savings_data[:savings_amount] > 500 %>
  <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);">
    <div class="card-body p-4">
      <div class="row align-items-center">
        <!-- Icône et message principal -->
        <div class="col-12 col-md-8 mb-3 mb-md-0">
          <div class="d-flex align-items-center">
            <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
              <i class="bi bi-calculator text-success" style="font-size: 1.5rem;"></i>
            </div>
            <div>
              <h5 class="mb-1 text-dark">
                💰 Économisez <strong class="text-success"><%= number_to_currency(@savings_data[:savings_amount], locale: :fr) %></strong>
              </h5>
              <p class="mb-0 text-muted">
                vs un chasseur de primes traditionnel (12,5% + TVA)
              </p>
            </div>
          </div>
        </div>

        <!-- Bouton d'action -->
        <div class="col-12 col-md-4 text-center text-md-end">
          <%= link_to pricing_path, class: "btn btn-success btn-lg px-4" do %>
            <i class="bi bi-arrow-right-circle me-2"></i>
            Voir les tarifs
          <% end %>
        </div>
      </div>

      <!-- Détails en petit -->
      <div class="row mt-3">
        <div class="col-12">
          <div class="bg-white bg-opacity-50 rounded-2 p-3">
            <div class="row text-center">
              <div class="col-4">
                <div class="small text-muted">Chasseur de primes</div>
                <div class="fw-bold text-decoration-line-through text-muted">
                  <%= number_to_currency(@savings_data[:chasseur_cost], locale: :fr) %>
                </div>
              </div>
              <div class="col-4">
                <div class="small text-muted">Avec Ren0vate</div>
                <div class="fw-bold text-success">
                  <%= number_to_currency(@savings_data[:saas_cost], locale: :fr) %>
                </div>
              </div>
              <div class="col-4">
                <div class="small text-muted">Économie</div>
                <div class="fw-bold text-success">
                  <%= @savings_data[:savings_percentage] %>%
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
