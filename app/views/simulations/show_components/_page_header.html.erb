<!-- En-tête de la page simulation -->
<% region_data = simulation_region_data(@simulation) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 text-primary-custom mb-1">
      <i class="bi bi-calculator me-2"></i><%= @simulation.titre %>
    </h1>
    <p class="text-muted-custom mb-0">
      <i class="bi bi-geo-alt me-1"></i>
      <%= region_data[:formatted_region] if region_data %>
      · Simulation créée le <%= region_data[:created_date] if region_data %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <%= link_to simulations_path, class: "btn btn-secondary" do %>
      <i class="bi bi-arrow-left me-1"></i>Retour
    <% end %>
  </div>
</div>

<!-- Bouton de sauvegarde flottant -->
<%= render 'shared/save_simulation_button' %>

<!-- Auto-save discret en arrière-plan -->
<%= render 'shared/simple_autosave' %>
