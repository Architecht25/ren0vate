<!-- Contenu principal selon la région -->
<% region = @simulation.region&.downcase %>

<div class="container-fluid"
     data-controller="<%= region == 'flandre' ? 'flandre-simulation' : '' %>"
     data-flandre-simulation-simulation-id-value="<%= @simulation.id %>"
     data-flandre-simulation-category-value="<%= @simulation.category %>">
  <div class="row">
    <!-- Contenu principal - pleine largeur -->
    <div class="col-12">
      <!-- Contenu spécifique par région - 2 colonnes côte à côte -->
      <div class="row g-4">
        <% case region %>
        <% when 'wallonie' %>
          <div class="col-lg-6">
            <%= render 'simulations/partials_wallonie/eligibility_step' %>
          </div>
          <div class="col-lg-6">
            <%= render 'simulations/partials_wallonie/category_step' %>
          </div>
        <% when 'flandre' %>
          <div class="col-lg-6">
            <%= render 'simulations/partials_flandre/eligibility_step' %>
          </div>
          <div class="col-lg-6">
            <%= render 'simulations/partials_flandre/category_step' %>
          </div>
        <% when 'bruxelles' %>
          <!-- Pas d'étapes d'éligibilité ou de catégorie pour Bruxelles -->
          <!-- Les cartes de primes sont affichées directement ci-dessous -->
        <% else %>
          <div class="col-12">
            <div class="alert alert-warning text-center">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Région non reconnue ou non spécifiée. Veuillez sélectionner une région valide.
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Section pleine largeur pour les cartes primes -->
  <div class="container-fluid mb-4 mt-5">
    <%= render 'simulations/show_components/primes_section' %>
  </div>
</div>
