<!-- EXEMPLE d'intégration dans une vue de simulation -->
<!-- À placer dans app/views/simulations/show.html.erb par exemple -->

<div class="container py-4">
  <div class="row">
    <div class="col-12">
      <!-- Résultats de simulation existants -->
      <div class="card mb-4">
        <div class="card-header">
          <h4>🧮 Résultats de votre simulation</h4>
        </div>
        <div class="card-body">
          <!-- Votre contenu de simulation existant -->
          <p>Total des primes estimées: <strong>€ 12,450</strong></p>
          <p>Primes éligibles: <strong>3 primes</strong></p>
        </div>
      </div>

      <!-- Documents officiels à télécharger -->
      <%= render 'prime_document_templates/simulation_documents', simulation: @simulation %>

      <!-- Actions suivantes -->
      <div class="card mt-4">
        <div class="card-body text-center">
          <h5>🚀 Prochaines étapes</h5>
          <p class="text-muted mb-3">
            Maintenant que vous avez vos documents, voici comment procéder :
          </p>
          <div class="row g-3">
            <div class="col-md-4">
              <div class="border rounded p-3 h-100">
                <div class="text-primary mb-2">
                  <i class="bi bi-person-workspace display-6"></i>
                </div>
                <h6>1. Contactez un entrepreneur</h6>
                <small class="text-muted">
                  Transmettez-lui les documents téléchargés
                </small>
              </div>
            </div>
            <div class="col-md-4">
              <div class="border rounded p-3 h-100">
                <div class="text-success mb-2">
                  <i class="bi bi-clipboard-check display-6"></i>
                </div>
                <h6>2. Faites remplir les attestations</h6>
                <small class="text-muted">
                  L'entrepreneur doit signer les documents
                </small>
              </div>
            </div>
            <div class="col-md-4">
              <div class="border rounded p-3 h-100">
                <div class="text-info mb-2">
                  <i class="bi bi-send display-6"></i>
                </div>
                <h6>3. Soumettez votre dossier</h6>
                <small class="text-muted">
                  Déposez via notre plateforme
                </small>
              </div>
            </div>
          </div>
          <div class="mt-3">
            <%= link_to "Créer un projet", new_project_path,
                  class: "btn btn-primary me-2" %>
            <%= link_to "Voir tous les documents", prime_document_templates_path,
                  class: "btn btn-outline-info" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
