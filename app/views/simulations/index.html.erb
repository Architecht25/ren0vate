<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Simulations de Primes</h1>
    <div class="d-flex gap-2">
      <%= link_to new_simulation_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Nouvelle simulation
      <% end %>
      <% if @property %>
        <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Dashboard bien
        <% end %>
      <% end %>
      <%= link_to properties_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Mes biens
      <% end %>
    </div>
  </div>

  <!-- Liste des simulations -->
  <% if @simulations.any? %>
    <%
      # Grouper les simulations par région pour afficher les séparateurs
      grouped_simulations = @simulations.group_by { |s| s.region&.downcase || 'autre' }
      region_order = ['flandre', 'bruxelles', 'wallonie', 'autre']
      region_names = {
        'flandre' => 'Flandre',
        'bruxelles' => 'Bruxelles',
        'wallonie' => 'Wallonie',
        'autre' => 'Autres régions'
      }
    %>

    <% region_order.each do |region_key| %>
      <% if grouped_simulations[region_key]&.any? %>
        <!-- Séparateur de région -->
        <div class="row mb-3">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <h5 class="text-muted mb-0 me-3">
                <i class="bi bi-geo-alt me-2"></i><%= region_names[region_key] %>
              </h5>
              <hr class="flex-grow-1 my-0 text-muted">
              <span class="badge bg-light text-dark ms-3"><%= grouped_simulations[region_key].count %> simulation<%= 's' if grouped_simulations[region_key].count > 1 %></span>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-5">
          <% grouped_simulations[region_key].each do |simulation| %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card border-0 h-100 property-card position-relative overflow-hidden<%= ' property-card-entreprise' if simulation.property&.is_entreprise? %>" style="min-height: 200px;">

            <!-- Image de fond sur toute la carte -->
            <div class="position-absolute w-100 h-100"
                 style="background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_200,q_auto,f_auto/<%= simulation.property&.is_entreprise? ? 'fiduciaire-maenhout-subsides-en-wallonie-aides-a-l-investissements_oh2wkk' : 'shutterstock_2235115125_nry60u' %>');
                        background-size: cover;
                        background-position: center;
                        background-repeat: no-repeat;
                        top: 0;
                        left: 0;
                        z-index: 1;">
            </div>            <!-- Overlay sombre pour la lisibilité -->
            <div class="position-absolute w-100 h-100" style="background: rgba(0,0,0,0.1); top: 0; left: 0; z-index: 2;"></div>

            <!-- Badge région en haut à gauche -->
            <% if simulation.region %>
              <div class="position-absolute top-0 start-0 m-2" style="z-index: 4;">
                <span class="badge bg-<%= simulation.region == 'wallonie' ? 'danger' : simulation.region == 'flandre' ? 'dark' : 'warning' %>" style="font-size: 0.7rem;">
                  <%= simulation.region.humanize %>
                </span>
              </div>
            <% end %>

            <!-- Menu actions trois points en haut à droite -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index: 4;">
              <div class="dropdown dropup">
                <button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="opacity: 0.9;">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index: 1050;">
                  <li>
                    <%= link_to simulation_path(simulation), class: "dropdown-item" do %>
                      <i class="bi bi-eye me-2"></i>Voir les détails
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_simulation_path(simulation), class: "dropdown-item" do %>
                      <i class="bi bi-pencil me-2"></i>Modifier
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to simulation_path(simulation), method: :delete,
                        class: "dropdown-item text-danger",
                        confirm: "Êtes-vous sûr de vouloir supprimer cette simulation ? Cette action est irréversible.",
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Êtes-vous sûr de vouloir supprimer la simulation '#{simulation.titre}' ? Cette action est irréversible."
                        } do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Contenu centré avec le titre de la simulation -->
            <%= link_to simulation_path(simulation), class: "text-decoration-none position-absolute w-100 h-100 d-flex align-items-center justify-content-center", style: "z-index: 3;" do %>
              <div class="text-center text-white">
                <!-- Titre de la simulation -->
                <h5 class="fw-bold mb-3" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.7);">
                  <i class="bi bi-<%= simulation.property&.is_entreprise? ? 'building' : 'calculator' %> me-2"></i>
                  <%= simulation.titre %>
                </h5>

                <!-- Région -->
                <% if simulation.region.present? %>
                  <div class="text-white mb-3" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.8);">
                    <div style="font-size: 0.95rem; font-weight: 400;">
                      <i class="bi bi-geo-alt me-2"></i>
                      <%= simulation.region.capitalize %>
                    </div>
                  </div>
                <% end %>

                <!-- Informations supplémentaires en bas -->
                <div class="d-flex justify-content-center align-items-center gap-3">
                  <span class="badge bg-light text-dark px-2 py-1" style="font-size: 0.75rem;">
                    <%= simulation.primes.count %> prime<%= 's' if simulation.primes.count > 1 %>
                  </span>
                  <% total = simulation.total_simule || simulation.total_complet_amount || 0 %>
                  <span class="text-white fw-bold" style="font-size: 0.85rem;">
                    <%= number_to_currency(total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-calculator"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucune simulation enregistrée</h4>
      <p class="text-muted-custom mb-4">Commencez par créer votre première simulation de primes</p>
      <%= link_to new_simulation_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Créer ma première simulation
      <% end %>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
