<div class="container-fluid px-4 py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes simulations</h1>
    <div class="d-flex gap-2">
      <%= link_to new_simulation_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Nouvelle simulation
      <% end %>
      <% if @property %>
        <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-arrow-left me-1"></i>Dashboard bien
        <% end %>
      <% end %>
      <%= link_to properties_path, class: "btn btn-outline-secondary btn-sm" do %>
        <i class="bi bi-arrow-left me-1"></i>Mes biens
      <% end %>
    </div>
  </div>

  <% if @simulations.any? %>
    <!-- Bandeau métriques -->
    <%
      total_primes  = @simulations.sum { |s| s.total_simule || s.total_complet_amount || 0 }
      regions_count = @simulations.filter_map(&:region).uniq.count
    %>
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-primary-light-ren0vate" style="border-radius:12px;">
          <div class="fw-bold fs-3 text-primary-ren0vate"><%= @simulations.count %></div>
          <div class="text-muted small"><i class="bi bi-calculator me-1"></i>Simulation<%= 's' if @simulations.count > 1 %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-success-light-ren0vate" style="border-radius:12px;">
          <div class="fw-bold fs-3 text-success-ren0vate"><%= number_to_currency(total_primes, unit: '€', format: '%n %u', precision: 0, delimiter: '.') %></div>
          <div class="text-muted small"><i class="bi bi-piggy-bank me-1"></i>Primes simulées</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-accent-light-ren0vate" style="border-radius:12px;">
          <div class="fw-bold fs-3 text-accent-ren0vate"><%= regions_count %></div>
          <div class="text-muted small"><i class="bi bi-geo-alt me-1"></i>Région<%= 's' if regions_count != 1 %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-danger-light-ren0vate" style="border-radius:12px;">
          <% sims_with_primes = @simulations.count { |s| (s.total_simule || s.total_complet_amount || 0) > 0 } %>
          <div class="fw-bold fs-3 text-danger-ren0vate"><%= sims_with_primes %></div>
          <div class="text-muted small"><i class="bi bi-award me-1"></i>Avec primes</div>
        </div>
      </div>
    </div>

    <!-- Grille simulations -->
    <div class="row g-3">
      <% @simulations.each do |simulation| %>
        <% total = simulation.total_simule || simulation.total_complet_amount || 0 %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card border-0 h-100 property-card position-relative overflow-hidden" style="min-height:220px; border-radius:12px;">

            <!-- COUCHE 1 : fond -->
            <div class="position-absolute w-100 h-100"
                 style="background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_220,q_auto,f_auto/<%= simulation.property&.is_entreprise? ? 'fiduciaire-maenhout-subsides-en-wallonie-aides-a-l-investissements_oh2wkk' : 'shutterstock_2235115125_nry60u' %>');
                        background-size:cover; background-position:center;
                        top:0; left:0; z-index:1;"></div>

            <!-- COUCHE 2 : overlay -->
            <div class="position-absolute w-100 h-100" style="background:rgba(0,0,0,0.45); top:0; left:0; z-index:2;"></div>

            <!-- COUCHE 3 : lien cliquable (sauf barre du bas) -->
            <%= link_to simulation_path(simulation),
                class: "position-absolute w-100 d-flex flex-column justify-content-center align-items-center text-decoration-none text-white",
                style: "z-index:3; top:0; left:0; bottom:36px;" do %>
              <h5 class="fw-bold mb-2 text-center px-3 text-arch-orange" style="text-shadow:2px 2px 8px rgba(0,0,0,1);">
                <i class="bi bi-<%= simulation.property&.is_entreprise? ? 'building' : 'calculator' %> me-1"></i>
                <%= simulation.titre %>
              </h5>
              <% if simulation.region.present? %>
                <div class="text-center" style="font-size:0.85rem; text-shadow:1px 1px 3px rgba(0,0,0,0.9); opacity:0.9;">
                  <i class="bi bi-geo-alt me-1"></i><%= simulation.region.capitalize %>
                </div>
              <% end %>
            <% end %>

            <!-- COUCHE 4 : barre inférieure -->
            <div class="position-absolute w-100" style="bottom:0; left:0; z-index:4; background:rgba(0,0,0,0.55); padding:6px 10px;">
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-white" style="font-size:0.68rem; opacity:0.85;">
                  <i class="bi bi-award me-1"></i><%= simulation.primes.count %> prime<%= 's' if simulation.primes.count != 1 %>
                </span>
                <span class="text-white fw-semibold" style="font-size:0.72rem;">
                  <%= number_to_currency(total, unit: '€', separator: ',', delimiter: '.', format: '%n %u', precision: 0) %>
                </span>
              </div>
            </div>

            <!-- COUCHE 5 : badge région (haut gauche) -->
            <% if simulation.region %>
              <div class="position-absolute top-0 start-0 m-2" style="z-index:5;">
                <span class="badge bg-<%= simulation.region == 'wallonie' ? 'danger' : simulation.region == 'flandre' ? 'dark' : 'warning' %>" style="font-size:0.65rem;">
                  <%= simulation.region.humanize %>
                </span>
              </div>
            <% end %>

            <!-- COUCHE 5 : menu actions (haut droite) -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index:5;" onclick="event.stopPropagation()">
              <div class="dropdown">
                <button class="btn btn-sm btn-dark opacity-75 dropdown-toggle" type="button"
                        data-bs-toggle="dropdown" aria-expanded="false" style="padding:2px 7px;">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index:1050;">
                  <li>
                    <%= link_to simulation_path(simulation), class: "dropdown-item" do %>
                      <i class="bi bi-eye me-2"></i>Voir les détails
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_simulation_path(simulation), class: "dropdown-item" do %>
                      <i class="bi bi-pencil me-2"></i>Modifier
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= button_to simulation_path(simulation),
                          method: :delete,
                          form: { data: { turbo_confirm: "Supprimer la simulation '#{simulation.titre}' ? Cette action est irréversible." } },
                          class: "dropdown-item text-danger border-0 bg-transparent text-start w-100" do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <!-- État vide -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-calculator"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucune simulation enregistrée</h4>
      <p class="text-muted-custom mb-4">Commencez par créer votre première simulation de primes</p>
      <%= link_to new_simulation_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Créer ma première simulation
      <% end %>
    </div>
  <% end %>

</div>
