<!-- Section Prochaines étapes après simulation -->
<div class="row g-4 mt-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm bg-gradient-success-light">
      <div class="card-body p-4">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle me-3 bg-success">
            <i class="bi bi-arrow-right text-white"></i>
          </div>
          <div>
            <h5 class="card-title mb-0 fw-normal">🎯 Prochaines étapes pour votre demande</h5>
            <small class="text-muted">Votre simulation est terminée, passons à l'action !</small>
          </div>
        </div>

        <div class="row g-4">
          <!-- Étape 1: Documents -->
          <div class="col-lg-4">
            <div class="card h-100 border-0 bg-white">
              <div class="card-body p-3 text-center">
                <div class="icon-circle-large mx-auto mb-3 bg-warning">
                  <i class="bi bi-file-earmark-check text-white"></i>
                </div>
                <h6 class="fw-bold mb-2">1. Documents obligatoires</h6>
                <div class="mb-3">
                  <%
                    # Calcul dynamique des documents requis selon la région
                    required_docs = case @simulation.region&.downcase
                    when 'bruxelles'
                      ['Factures des travaux (max 12 mois)', 'Certificat PEB', 'Numéro BCE entrepreneur', 'Photos avant/après']
                    when 'wallonie'
                      ['Factures des travaux (max 24 mois)', 'Devis détaillés', 'Attestation entrepreneur', 'RIB bancaire']
                    when 'flandre'
                      ['Factures avec TVA', 'Code EAN logement', 'Attestation conformité', 'Preuves d\'achèvement']
                    else
                      ['Factures des travaux', 'Documents techniques', 'Preuves de conformité']
                    end
                  %>
                  <ul class="list-unstyled small">
                    <% required_docs.each do |doc| %>
                      <li class="mb-1">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        <%= doc %>
                      </li>
                    <% end %>
                  </ul>
                </div>
                <%= link_to (@simulation.property ? property_documents_path(@simulation.property) : documents_path), class: "btn btn-outline-warning btn-sm w-100" do %>
                  <i class="bi bi-upload me-2"></i>Gérer documents
                <% end %>
              </div>
            </div>
          </div>

          <!-- Étape 2: Timing -->
          <div class="col-lg-4">
            <div class="card h-100 border-0 bg-white">
              <div class="card-body p-3 text-center">
                <div class="icon-circle-large mx-auto mb-3 bg-info">
                  <i class="bi bi-clock text-white"></i>
                </div>
                <h6 class="fw-bold mb-2">2. Délais à respecter</h6>
                <div class="mb-3">
                  <%
                    # Informations de timing par région
                    timing_info = case @simulation.region&.downcase
                    when 'bruxelles'
                      { deadline: '12 mois après travaux', processing: '3-6 mois', period: 'Toute l\'année' }
                    when 'wallonie'
                      { deadline: '24 mois après travaux', processing: '2-4 mois', period: 'Toute l\'année' }
                    when 'flandre'
                      { deadline: '12 mois après travaux', processing: '2-3 mois', period: 'Toute l\'année' }
                    else
                      { deadline: 'Variable', processing: '3-6 mois', period: 'Variable' }
                    end
                  %>
                  <div class="small">
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Délai limite :</span>
                      <span class="fw-medium text-danger"><%= timing_info[:deadline] %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                      <span class="text-muted">Traitement :</span>
                      <span class="fw-medium"><%= timing_info[:processing] %></span>
                    </div>
                    <div class="d-flex justify-content-between">
                      <span class="text-muted">Dépôt :</span>
                      <span class="fw-medium text-success"><%= timing_info[:period] %></span>
                    </div>
                  </div>
                </div>
                <button class="btn btn-outline-info btn-sm w-100" data-bs-toggle="modal" data-bs-target="#timingModal">
                  <i class="bi bi-calendar-event me-2"></i>Voir calendrier
                </button>
              </div>
            </div>
          </div>

          <!-- Étape 3: Recommandations techniques -->
          <div class="col-lg-4">
            <div class="card h-100 border-0 bg-white">
              <div class="card-body p-3 text-center">
                <div class="icon-circle-large mx-auto mb-3 bg-info">
                  <i class="bi bi-lightbulb text-white"></i>
                </div>
                <h6 class="fw-bold mb-2">3. Recommandations techniques</h6>
                <div class="mb-3">
                  <%
                    # Génération dynamique des recommandations basées sur les primes sélectionnées
                    selected_primes = []
                    recommendations = []

                    # Parser les paramètres de la simulation
                    begin
                      if @simulation.parameters.present?
                        params_data = JSON.parse(@simulation.parameters)
                        prime_cards = params_data['prime_cards'] || {}

                        # Analyser les primes sélectionnées
                        prime_cards.each do |category_key, category_data|
                          next unless category_data['primes'].present?

                          category_data['primes'].each do |prime|
                            next if prime['user_input_value'].blank? || prime['user_input_value'].to_f == 0

                            case prime['slug']
                            when /isolation_toiture|isolation_murs|isolation_sols/
                              selected_primes << "Isolation"
                              recommendations << "Privilégiez les matériaux certifiés (λ ≤ 0.04 W/mK)"
                            when /chaudiere|pompe_chaleur|chauffage|pac_/
                              selected_primes << "Chauffage"
                              recommendations << "Optez pour des équipements classe A++ minimum"
                            when /ventilation|vmc_/
                              selected_primes << "Ventilation"
                              recommendations << "Système VMC double flux recommandé"
                            when /audit/
                              selected_primes << "Audit"
                              recommendations << "Réalisez l'audit avant les travaux"
                            when /photovoltaique|solaire/
                              selected_primes << "Solaire"
                              recommendations << "Orientation sud/sud-ouest optimale"
                            when /menuiseries|vitrages/
                              selected_primes << "Menuiseries"
                              recommendations << "Triple vitrage Uw ≤ 1,3 W/m²K"
                            end
                          end
                        end
                      end
                    rescue JSON::ParserError => e
                      Rails.logger.warn "Erreur parsing parameters simulation #{@simulation.id}: #{e.message}"
                    end

                    # Recommandations par défaut si aucune prime sélectionnée
                    if recommendations.empty?
                      recommendations = [
                        "Commencez par l'isolation",
                        "Audit énergétique prioritaire",
                        "Matériaux certifiés requis"
                      ]
                    end

                    # Limiter à 3 recommandations
                    recommendations = recommendations.uniq.first(3)
                  %>

                  <% if recommendations.any? %>
                    <ul class="list-unstyled small text-start">
                      <% recommendations.each do |rec| %>
                        <li class="mb-1">
                          <i class="bi bi-check-circle-fill text-info me-2"></i>
                          <%= rec %>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>

                  <div class="alert alert-info alert-sm py-2 mb-0">
                    <small>
                      <i class="bi bi-tools me-1"></i>
                      <%= selected_primes.uniq.count %> domaine(s) technique(s) sélectionné(s)
                    </small>
                  </div>
                </div>
                <button class="btn btn-outline-info btn-sm w-100" data-bs-toggle="modal" data-bs-target="#technicalModal">
                  <i class="bi bi-gear me-2"></i>Voir détails techniques
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Alerte informative -->
        <div class="alert alert-info mt-4 mb-0">
          <div class="d-flex align-items-start">
            <i class="bi bi-lightbulb-fill me-3 mt-1"></i>
            <div>
              <h6 class="alert-heading mb-2">💡 Conseil de nos experts</h6>
              <p class="mb-2">
                Région <strong><%= @simulation.region&.capitalize %></strong> :
                <% case @simulation.region&.downcase
                   when 'bruxelles' %>
                  Les demandes sont traitées plus rapidement si vous joignez toutes les factures en une seule fois.
                <% when 'wallonie' %>
                  Pensez à vérifier que votre entrepreneur a bien complété l'attestation technique obligatoire.
                <% when 'flandre' %>
                  Assurez-vous que votre code EAN correspond exactement à celui du logement rénové.
                <% else %>
                  Contactez-nous pour des conseils personnalisés selon votre région.
                <% end %>
              </p>
              <small class="text-muted">
                Cette simulation a été générée le <%= @simulation.created_at.strftime('%d/%m/%Y à %H:%M') %>
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal pour le calendrier détaillé -->
<div class="modal fade" id="timingModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-calendar-event me-2"></i>
          Calendrier des démarches - <%= @simulation.region&.capitalize %>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <%= render 'simulations/partials_general/timing_calendar', simulation: @simulation %>
      </div>
    </div>
  </div>
</div>

<!-- Modal pour les recommandations techniques détaillées -->
<div class="modal fade" id="technicalModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-gear me-2"></i>
          Recommandations techniques détaillées
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <%
          # Recommandations techniques détaillées par type de prime
          detailed_recommendations = {}

          # Parser les paramètres de la simulation
          begin
            if @simulation.parameters.present?
              params_data = JSON.parse(@simulation.parameters)
              prime_cards = params_data['prime_cards'] || {}

              # Analyser les primes sélectionnées pour les recommandations détaillées
              prime_cards.each do |category_key, category_data|
                next unless category_data['primes'].present?

                category_data['primes'].each do |prime|
                  next if prime['user_input_value'].blank? || prime['user_input_value'].to_f == 0

                  case prime['slug']
                  when /isolation_toiture/
                    detailed_recommendations["Isolation de toiture"] = {
                      icon: "bi-house-up",
                      specs: ["Résistance thermique R ≥ 6 m²K/W", "Matériaux certifiés ACERMI", "Étanchéité à l'air renforcée"],
                      tips: ["Vérifiez l'absence de ponts thermiques", "Traitement de la jonction mur-toiture obligatoire"]
                    }
                  when /isolation_murs/
                    detailed_recommendations["Isolation des murs"] = {
                      icon: "bi-building",
                      specs: ["Résistance thermique R ≥ 3.7 m²K/W", "Isolation continue recommandée", "Pare-vapeur si nécessaire"],
                      tips: ["Isolation par l'extérieur plus efficace", "Attention aux prises et interrupteurs"]
                    }
                  when /isolation_sols/
                    detailed_recommendations["Isolation des sols"] = {
                      icon: "bi-layers",
                      specs: ["Résistance thermique R ≥ 2.1 m²K/W", "Étanchéité à l'humidité", "Matériaux adaptés au support"],
                      tips: ["Isolation sous chape recommandée", "Vérifiez la hauteur sous plafond"]
                    }
                  when /chaudiere|pompe_chaleur|pac_/
                    detailed_recommendations["Système de chauffage"] = {
                      icon: "bi-thermometer-half",
                      specs: ["Rendement ≥ 90% (chaudière)", "COP ≥ 4 (pompe à chaleur)", "Régulation programmable"],
                      tips: ["Dimensionnement par professionnel obligatoire", "Entretien annuel requis"]
                    }
                  when /ventilation|vmc_/
                    detailed_recommendations["Ventilation"] = {
                      icon: "bi-wind",
                      specs: ["VMC double flux préférable", "Rendement échangeur ≥ 85%", "Débit modulable"],
                      tips: ["Nettoyage filtres tous les 6 mois", "Étanchéité du réseau essentielle"]
                    }
                  when /photovoltaique|solaire/
                    detailed_recommendations["Panneaux photovoltaïques"] = {
                      icon: "bi-sun",
                      specs: ["Puissance minimale 3 kWc", "Rendement ≥ 20%", "Garantie 20 ans minimum"],
                      tips: ["Orientation sud optimale", "Inclinaison 30-35° recommandée"]
                    }
                  when /menuiseries|vitrages/
                    detailed_recommendations["Menuiseries et vitrages"] = {
                      icon: "bi-door-open",
                      specs: ["Coefficient Uw ≤ 1,3 W/m²K", "Triple vitrage recommandé", "Pose étanche obligatoire"],
                      tips: ["Mesurer précisément les surfaces", "Vérifier les dimensions d'ouverture"]
                    }
                  end
                end
              end
            end
          rescue JSON::ParserError => e
            Rails.logger.warn "Erreur parsing parameters simulation #{@simulation.id}: #{e.message}"
          end
        %>

        <% if detailed_recommendations.any? %>
          <div class="row g-4">
            <% detailed_recommendations.each do |title, data| %>
              <div class="col-12">
                <div class="card border-0 bg-light">
                  <div class="card-body p-3">
                    <h6 class="card-title d-flex align-items-center mb-3">
                      <i class="<%= data[:icon] %> me-2 text-primary"></i>
                      <%= title %>
                    </h6>

                    <div class="row">
                      <div class="col-md-6">
                        <h6 class="small fw-bold text-muted mb-2">📋 Spécifications techniques</h6>
                        <ul class="list-unstyled small">
                          <% data[:specs].each do |spec| %>
                            <li class="mb-1">
                              <i class="bi bi-check-circle text-success me-2"></i>
                              <%= spec %>
                            </li>
                          <% end %>
                        </ul>
                      </div>

                      <div class="col-md-6">
                        <h6 class="small fw-bold text-muted mb-2">💡 Conseils pratiques</h6>
                        <ul class="list-unstyled small">
                          <% data[:tips].each do |tip| %>
                            <li class="mb-1">
                              <i class="bi bi-lightbulb text-warning me-2"></i>
                              <%= tip %>
                            </li>
                          <% end %>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="alert alert-info mt-4 mb-0">
            <div class="d-flex align-items-start">
              <i class="bi bi-info-circle me-3 mt-1"></i>
              <div>
                <h6 class="alert-heading mb-2">ℹ️ Information importante</h6>
                <p class="mb-0 small">
                  Ces recommandations sont basées sur les primes sélectionnées dans votre simulation.
                  Pour des conseils personnalisés, consultez un professionnel qualifié RGE.
                </p>
              </div>
            </div>
          </div>
        <% else %>
          <div class="text-center py-4">
            <i class="bi bi-gear display-4 text-muted mb-3"></i>
            <h5 class="text-muted">Aucune prime sélectionnée</h5>
            <p class="text-muted">Sélectionnez des primes dans votre simulation pour voir les recommandations techniques.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
