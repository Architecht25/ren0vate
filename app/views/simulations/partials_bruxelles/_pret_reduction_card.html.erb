<%# Simulation THÉORIQUE du mécanisme de réduction de prêt bruxellois (printemps 2027, non officialisé).
    Calcul : Regions::Bruxelles::PretReduction. Le contrôleur Stimulus wallonie-pret-reduction est réutilisé
    (mêmes cibles et même contrat JSON). Ce montant n'entre PAS dans le total estimé des primes. %>
<% pret = @pret_reduction_bruxelles || { eligible: false, message: "Renseignez votre simulation." } %>
<% result = pret[:result] || {} %>

<div class="card border-0 shadow mb-4" data-controller="wallonie-pret-reduction"
     data-wallonie-pret-reduction-simulation-id-value="<%= @simulation.id %>"
     data-wallonie-pret-reduction-url-value="<%= update_pret_reduction_bruxelles_simulation_path(@simulation, locale: :fr) %>">
  <div class="card-header" style="background-color: var(--ren0vate-background-light); border-bottom: 1px solid var(--ren0vate-border);">
    <h5 class="card-title mb-1">
      <i class="bi bi-bank2 me-2" style="color: var(--ren0vate-primary);"></i>
      Prêt à taux 0% — réduction du solde (simulation théorique)
    </h5>
    <p class="text-muted small mb-0">Mécanisme annoncé pour le printemps 2027 à Bruxelles-Capitale.</p>
  </div>

  <div class="card-body p-4">
    <div class="alert alert-warning d-flex align-items-start" role="alert">
      <i class="bi bi-exclamation-triangle me-3 fs-5"></i>
      <div>
        <strong>Simulation théorique</strong>
        <p class="mb-0 small">Ce mécanisme n'est pas encore officialisé. Les plafonds, barèmes et critères
          affichés reprennent ceux du régime wallon à titre d'hypothèse et peuvent changer. Ce montant est
          indicatif : ce n'est ni une prime versée, ni un droit acquis.</p>
      </div>
    </div>

    <% unless pret[:eligible] %>
      <div class="alert alert-secondary small mb-0" role="status">
        <i class="bi bi-info-circle me-1"></i><%= pret[:message] %>
      </div>
    <% else %>
      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-6">
          <label for="montant_projet_bruxelles" class="form-label">Montant global du projet de rénovation</label>
          <div class="input-group">
            <input type="number" id="montant_projet_bruxelles" min="0" step="100" class="form-control"
                   placeholder="Ex: 35000"
                   value="<%= pret[:montant_saisi].to_i if pret[:montant_saisi].to_f > 0 %>"
                   data-wallonie-pret-reduction-target="montantProjet"
                   data-action="input->wallonie-pret-reduction#montantChanged">
            <span class="input-group-text">€</span>
          </div>
          <small class="text-muted">Plafonné à <%= number_to_currency(Regions::Bruxelles::PretReduction::CalculatorService::PLAFOND_EMPRUNT, unit: '€', separator: ',', delimiter: ' ', precision: 0) %>.</small>
        </div>

        <div class="col-12 col-md-6">
          <div class="rounded-3 p-3 text-center" style="background-color: var(--ren0vate-background-light); border: 1px solid var(--ren0vate-border);">
            <h3 class="fw-bold mb-1" style="color: var(--ren0vate-primary);" data-wallonie-pret-reduction-target="reductionSolde">
              <%= number_to_currency(result[:reduction_solde] || 0, unit: '€', separator: ',', delimiter: ' ', precision: 0) %>
            </h3>
            <p class="text-muted small mb-0">Réduction théorique du solde à rembourser</p>
          </div>
        </div>
      </div>

      <div class="row g-3 mt-3 text-center">
        <div class="col-6 col-md-3">
          <div class="border rounded-3 p-2">
            <div class="text-muted small">Montant retenu (plafonné)</div>
            <div class="fw-bold" data-wallonie-pret-reduction-target="montantRetenu">
              <%= number_to_currency(result[:montant_projet_retenu] || 0, unit: '€', separator: ',', delimiter: ' ', precision: 0) %>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="border rounded-3 p-2">
            <div class="text-muted small">Plafond d'emprunt</div>
            <div class="fw-bold"><%= number_to_currency(Regions::Bruxelles::PretReduction::CalculatorService::PLAFOND_EMPRUNT, unit: '€', separator: ',', delimiter: ' ', precision: 0) %></div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="border rounded-3 p-2">
            <div class="text-muted small">Taux de réduction</div>
            <div class="fw-bold" data-wallonie-pret-reduction-target="tauxReduction">
              <%= number_to_percentage((result[:taux_reduction] || 0) * 100, precision: 0) %>
            </div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="border rounded-3 p-2">
            <div class="text-muted small">Taux d'intérêt du prêt</div>
            <div class="fw-bold" data-wallonie-pret-reduction-target="tauxInteret">0%</div>
          </div>
        </div>
      </div>
      <p class="text-muted small mt-2 mb-0">
        <%= pret[:message] %>. Le taux de réduction dépend de votre tranche de revenu, selon les mêmes barèmes que la Wallonie (hypothèse).
      </p>
    <% end %>
  </div>
</div>
