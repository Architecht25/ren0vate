<!-- Section Total Général Bruxelles -->
<div class="col-12 mt-4">
  <div class="card border-0 shadow-lg">

    <div class="card-body p-4">
      <div class="text-center mb-4">
        <h4 class="text-primary mb-2">
          <i class="bi bi-calculator me-2"></i>
          Total estimé de vos primes Bruxelles
        </h4>
        <p class="text-muted small">Les montants s'ajustent automatiquement selon votre catégorie de revenus</p>
      </div>

      <!-- Organisation en 3 colonnes -->
      <div class="row g-4">

        <!-- Colonne 1: Affichage du total principal -->
        <div class="col-12 col-lg-4">
          <div class="bg-primary bg-opacity-10 rounded-3 p-4 text-center h-100 d-flex flex-column justify-content-center">
            <h2 class="display-5 fw-bold text-primary mb-2" data-bruxelles-simulation-target="totalGeneral">0,00 €</h2>
            <p class="text-muted mb-2">
              <span data-bruxelles-simulation-target="currentCategory">Catégorie non définie</span>
            </p>
            <small class="text-muted">Estimation selon votre profil de revenus</small>
            <div class="mt-3">
              <i class="bi bi-info-circle text-primary fs-5 mb-2"></i>
              <p class="small text-muted mb-0">Ce montant est une estimation basée sur vos travaux sélectionnés</p>
            </div>
          </div>
        </div>

        <!-- Colonne 2: Résumé des primes sélectionnées -->
        <div class="col-12 col-lg-4">
          <div class="card border-0 bg-light h-100">
            <div class="card-body p-4">
              <h6 class="fw-bold text-dark mb-3">
                <i class="bi bi-list-check me-2"></i>
                Résumé de vos primes sélectionnées
              </h6>

              <!-- Liste dynamique des primes sélectionnées -->
              <div id="selected-primes-summary-bruxelles" data-bruxelles-simulation-target="selectedPrimesSummary">
                <div class="text-muted text-center py-3">
                  <i class="bi bi-info-circle me-2"></i>
                  Sélectionnez des travaux dans les cartes ci-dessus pour voir le détail de vos primes
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Colonne 3: Note informative -->
        <div class="col-12 col-lg-4">
          <div class="alert alert-info mb-0 h-100">
            <div class="d-flex align-items-start h-100">
              <i class="bi bi-lightbulb me-3 mt-1 fs-5 flex-shrink-0"></i>
              <div>
                <h6 class="alert-heading mb-2">Bon à savoir</h6>
                <p class="mb-2 small">Ces montants sont des estimations basées sur les grilles tarifaires officielles de Bruxelles Environnement.</p>
                <ul class="mb-0 small">
                  <li>Les primes varient selon votre catégorie de revenus (Cat 1, Cat 2, Cat 3)</li>
                  <li>Certaines primes sont forfaitaires, d'autres calculées au m² ou par unité</li>
                  <li>Des conditions techniques et d'éligibilité spécifiques s'appliquent</li>
                  <li>Le recours à un entrepreneur agréé avec numéro BCE valide est obligatoire</li>
                  <li>Il est recommandé de vérifier votre éligibilité sur le site officiel de Bruxelles Environnement</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
