<%
  cp = @simulation.property&.code_postal.to_s.strip
  saved_communales = begin
    params_data = @simulation.parameters.present? ? JSON.parse(@simulation.parameters) : {}
    params_data['bruxelles_communales'] || []
  rescue
    []
  end
%>
<div class="card shadow-sm border-0 rounded-4 overflow-hidden h-100" id="card-communales-bruxelles">

  <%# En-tête terracotta %>
  <div class="p-3 text-white" style="background: linear-gradient(135deg, #D97706 0%, #b45309 100%);">
    <div class="d-flex align-items-center gap-2">
      <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
           style="width:40px;height:40px;flex-shrink:0;">
        <i class="bi bi-building fs-5"></i>
      </div>
      <div>
        <div class="fw-bold">Primes Communales</div>
        <div class="small opacity-75">Bruxelles-Capitale</div>
      </div>
    </div>
  </div>

  <div class="card-body d-flex flex-column gap-3 p-3">

    <!-- Code postal -->
    <div>
      <label for="cp_communales_brx" class="form-label small mb-1">Code postal du chantier</label>
      <div class="input-group input-group-sm">
        <input type="text"
               class="form-control"
               id="cp_communales_brx"
               placeholder="1000"
               pattern="[0-9]{4}"
               maxlength="4"
               value="<%= cp %>">
        <button class="btn btn-sm text-white" type="button" id="btn_detect_commune_brx"
                style="background:#D97706;">
          <i class="bi bi-search"></i>
        </button>
      </div>
    </div>

    <!-- Commune détectée -->
    <div id="commune_detected_brx" style="display:none;">
      <div class="d-flex align-items-center gap-2 p-2 rounded" style="background: rgba(217,119,6,0.08); border: 1px solid rgba(217,119,6,0.25);">
        <i class="bi bi-geo-alt-fill" style="color:#D97706;"></i>
        <span class="small fw-medium" id="commune_name_brx"></span>
      </div>
    </div>

    <!-- Primes disponibles -->
    <div id="primes_list_brx" style="display:none;">
      <p class="small text-muted mb-2">Sélectionnez les primes applicables :</p>
      <div id="primes_items_brx" class="d-flex flex-column gap-2"></div>
    </div>

    <!-- Aucune donnée -->
    <div id="primes_generic_brx" style="display:none;">
      <div class="alert alert-info alert-sm mb-0 p-2">
        <small><i class="bi bi-info-circle me-1"></i>Contactez directement votre administration communale pour connaître les primes disponibles.</small>
      </div>
    </div>

    <!-- Total sélectionné (invisible, intégration grand total) -->
    <span class="prime-result d-none" id="result_communales_bruxelles">0</span>

    <!-- Données persistées (lues par JS) -->
    <span id="brx-saved-data" data-communales="<%= saved_communales.to_json %>" class="d-none"></span>

    <!-- Récap sélection -->
    <div id="recap_communales_brx" style="display:none;">
      <div class="p-2 rounded-3" style="background:rgba(217,119,6,0.1); border:1px solid rgba(217,119,6,0.3);">
        <div class="d-flex justify-content-between align-items-center">
          <small class="fw-bold">Total primes communales :</small>
          <span class="fw-bold" style="color:#b45309;" id="total_communales_brx">0 €</span>
        </div>
      </div>
    </div>

    <!-- CTA prochaine étape — apparaît dès qu'une prime est sélectionnée -->
    <div id="cta_communales_brx" style="display:none;" class="mt-2">
      <hr class="my-2">
      <p class="small text-muted mb-2"><i class="bi bi-arrow-right-circle me-1"></i><strong>Prochaine étape</strong></p>
      <div class="d-grid gap-2">
        <% if @simulation.property_id.present? %>
        <a href="<%= new_request_path(form_type: 'communal_bruxelles', property_id: @simulation.property_id, simulation_id: @simulation.id) %>"
           class="btn btn-sm fw-semibold text-white" style="background:#D97706;">
          <i class="bi bi-file-earmark-text me-1"></i>Créer ma demande de prime
        </a>
        <% end %>
        <a href="#" id="link_commune_site_brx" target="_blank" rel="noopener noreferrer"
           class="btn btn-outline-secondary btn-sm" style="display:none;">
          <i class="bi bi-box-arrow-up-right me-1"></i>Site officiel de la commune
        </a>
      </div>
    </div>

  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {
  // ─── Source de données ─────────────────────────────────────────────────────
  // Avant le 13/10/2026 : dictionnaire JS codé en dur ici, dupliqué (et
  // désynchronisé) avec le fichier JSON utilisé par le Decision Hub
  // (public/data/primes_communales_bruxelles.json via
  // Regions::PrimesCommunales::PrimesCommunalesBruxellesService). Unifié :
  // cette carte interroge désormais la même API
  // (/api/primes_communales_bruxelles) que le Decision Hub, une seule source.
  function montantAffiche(prime) {
    // Le JSON stocke un type_calcul (pourcentage/forfait/par_unite) + une
    // valeur + un plafond ; l'affichage ici veut un montant unique (le
    // plafond quand il existe pour une prime en pourcentage, sinon la valeur
    // telle quelle).
    if (prime.type_calcul === 'pourcentage' && prime.plafond != null) return prime.plafond;
    return prime.valeur || 0;
  }

  // ─── Éléments DOM ──────────────────────────────────────────────────────────
  const cpInput       = document.getElementById('cp_communales_brx');
  const btnDetect     = document.getElementById('btn_detect_commune_brx');
  const detectedDiv   = document.getElementById('commune_detected_brx');
  const communeName   = document.getElementById('commune_name_brx');
  const listDiv       = document.getElementById('primes_list_brx');
  const itemsDiv      = document.getElementById('primes_items_brx');
  const genericDiv    = document.getElementById('primes_generic_brx');
  const recapDiv      = document.getElementById('recap_communales_brx');
  const totalSpan     = document.getElementById('total_communales_brx');
  const resultHidden  = document.getElementById('result_communales_bruxelles');
  const ctaDiv        = document.getElementById('cta_communales_brx');
  const linkSite      = document.getElementById('link_commune_site_brx');

  // sélections actives { primeId: montant }
  const selected = {};

  // Sélections sauvegardées (restaurées depuis la base via data-attribute)
  const _savedEl = document.getElementById('brx-saved-data');
  const savedCommunales = _savedEl ? JSON.parse(_savedEl.dataset.communales || '[]') : [];

  // Pré-charger les sélections sauvegardées dans `selected` avant le premier rendu
  function preloadSavedSelections(primes) {
    primes.forEach(function(p) {
      if (savedCommunales.includes(p.id)) {
        selected[p.id] = p.montant;
      }
    });
  }

  function detectFromCP(cp) {
    detectedDiv.style.display = 'none';
    listDiv.style.display     = 'none';
    genericDiv.style.display  = 'none';
    itemsDiv.innerHTML        = '';

    fetch('<%= api_primes_communales_bruxelles_path %>?code_postal=' + encodeURIComponent(cp))
      .then(function(r) { return r.json(); })
      .then(function(json) {
        if (!json.success) {
          // Code postal hors Bruxelles-Capitale ou inconnu de l'API — rien à afficher.
          return;
        }

        const data = json.data;
        detectedDiv.style.display = 'block';
        communeName.textContent   = data.commune;

        if (data.primes && data.primes.length > 0) {
          const primes = data.primes.map(function(p) {
            return { id: p.id, nom: p.nom, desc: p.description, montant: montantAffiche(p) };
          });
          preloadSavedSelections(primes);
          renderPrimes(primes);
          listDiv.style.display = 'block';
          if (Object.keys(selected).length > 0) updateTotal();
        } else {
          genericDiv.innerHTML = `
            <div class="alert alert-secondary mb-2 p-2">
              <small><i class="bi bi-slash-circle me-1"></i><strong>Aucune prime communale disponible</strong> en matière d'environnement et de rénovation à l'heure actuelle.</small>
            </div>`;
          genericDiv.style.display = 'block';
        }

        if (linkSite && data.site_web) {
          linkSite.href = data.site_web;
          linkSite.style.display = '';
        }
      })
      .catch(function() {
        // Erreur réseau/API — ne pas bloquer le reste du formulaire.
        detectedDiv.style.display = 'none';
      });
  }

  function renderPrimes(primes) {
    primes.forEach(function(p) {
      const isSelected = !!selected[p.id];
      const item = document.createElement('div');
      item.className = 'prime-communale-item d-flex align-items-center justify-content-between flex-wrap p-2 rounded border' +
                       (isSelected ? ' border-warning bg-warning bg-opacity-10' : ' border-light bg-light');
      item.style.cursor = 'pointer';
      item.dataset.primeId = p.id;
      item.dataset.montant = p.montant;
      item.innerHTML = `
        <div class="d-flex align-items-center gap-2" style="min-width:0;">
          <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" ${isSelected ? 'checked' : ''} id="chk_${p.id}">
          </div>
          <div style="min-width:0;">
            <div class="small fw-medium">${p.nom}</div>
            <div class="text-muted" style="font-size:0.72rem;">${p.desc}</div>
          </div>
        </div>
        <span class="badge bg-warning text-dark ms-2 flex-shrink-0">${p.montant.toLocaleString('fr-BE')} €</span>`;
      item.addEventListener('click', function(e) {
        if (e.target.tagName === 'A') return;
        togglePrime(p.id, p.montant, item);
      });
      itemsDiv.appendChild(item);
    });
  }

  function togglePrime(id, montant, item) {
    const chk = item.querySelector('input[type="checkbox"]');
    if (selected[id]) {
      delete selected[id];
      chk.checked = false;
      item.classList.remove('border-warning', 'bg-warning', 'bg-opacity-10');
      item.classList.add('border-light', 'bg-light');
    } else {
      selected[id] = montant;
      chk.checked = true;
      item.classList.add('border-warning', 'bg-warning', 'bg-opacity-10');
      item.classList.remove('border-light', 'bg-light');
    }
    updateTotal();
  }

  function updateTotal() {
    const total = Object.values(selected).reduce(function(s, v) { return s + v; }, 0);
    resultHidden.textContent = total;  // entier sans décimales pour compatibilité avec updateTotalImmediate
    totalSpan.textContent    = total.toLocaleString('fr-BE') + ' €';
    recapDiv.style.display   = total > 0 ? 'block' : 'none';
    if (ctaDiv) ctaDiv.style.display = total > 0 ? 'block' : 'none';
    // Recalcule le total général (toutes cartes Bruxelles confondues) et le sauvegarde
    // via window.debounceSaveTotal, qui lit window.getBruxellesCommunalesSelection() ci-dessous.
    if (typeof window.updateTotalImmediate === 'function') window.updateTotalImmediate();
  }

  btnDetect.addEventListener('click', function() {
    const cp = (cpInput.value || '').trim();
    if (/^\d{4}$/.test(cp)) detectFromCP(cp);
  });

  cpInput.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') btnDetect.click();
  });

  // Exposer les sélections pour debounceSaveTotal
  window.getBruxellesCommunalesSelection = function() {
    return Object.keys(selected);
  };

  // Auto-déclenchement si code postal déjà disponible
  const initialCP = '<%= cp %>';
  if (/^\d{4}$/.test(initialCP)) {
    detectFromCP(initialCP);
  }
})();
</script>
