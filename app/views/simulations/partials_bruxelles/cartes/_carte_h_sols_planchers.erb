<%# Carte H - Prime Sols & Planchers %>
<%# Isolation thermique et acoustique des sols %>

<!-- CARTE 7: SOLS & PLANCHERS (PRIME H) -->
<div class="col-12 col-md-6 col-lg-3">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium"
       data-controller="bruxelles-simulation-card"
       data-bruxelles-simulation-card-slug-value="bruxelles_prime_h_global"
       data-statut-compatible='["residentiel", "mixte"]'>
    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/Eurofloor_1_wah35y'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-square fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Prime H - Sols et planchers</h6>
          <small class="opacity-90">Isolation thermique, acoustique</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-dark bg-opacity-20 text-dark rounded-pill px-3">
            <i class="bi bi-square me-1"></i>Sols
          </span>
          <small class="text-muted">
            <i class="bi bi-layers text-dark me-1"></i>Isolation & revêtements
          </small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Isolation thermique sols -->
        <div class="col-md-12">
          <label class="form-label small">H1 - Isolation thermique sols :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputIsolationThermiqueSols"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-dark text-white"
                  data-bruxelles-simulation-card-target="resultIsolationThermiqueSols">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_isolation_thermique_sols") %>
          <% conseil_text = conseil_prime("bruxelles_isolation_thermique_sols") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Isolation acoustique sols -->
        <div class="col-md-12">
          <label class="form-label small">H2 - Isolation acoustique sols :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputIsolationAcoustiqueSols"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-dark text-white"
                  data-bruxelles-simulation-card-target="resultIsolationAcoustiqueSols">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_isolation_acoustique_sols") %>
          <% conseil_text = conseil_prime("bruxelles_isolation_acoustique_sols") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Total Sols -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-dark">Total Sols :</strong>
          <span class="badge bg-dark fs-6" data-bruxelles-simulation-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
