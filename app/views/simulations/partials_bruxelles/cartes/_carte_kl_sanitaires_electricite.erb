        <!-- CARTE 11: SANITAIRES & ÉLECTRICITÉ (PRIMES K+L) -->
        <div class="col-12 col-md-6 col-lg-3">
          <div class="card border-0 shadow h-100 overflow-hidden card-premium"
               data-controller="bruxelles-simulation-card"
               data-bruxelles-simulation-card-slug-value="bruxelles_prime_kl_global"
               data-statut-compatible='["residentiel"]'>

            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/électricité-plomberie-1_lbqblm'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
                <div class="text-center text-white">
                  <i class="bi bi-lightning fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Prime K - Sanitaires & électricité</h6>
                  <small class="opacity-90">Équipements, mise aux normes</small>
                </div>
              </div>
            </div>

            <div class="card-body">
              <!-- Badge informatif -->
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="badge bg-info bg-opacity-20 text-info rounded-pill px-3">
                    <i class="bi bi-lightning me-1"></i>Sanitaire
                  </span>
                  <small class="text-muted">
                    <i class="bi bi-wrench text-info me-1"></i>Plomberie & électricité
                  </small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Appareil sanitaire -->
                <div class="col-md-12">
                  <label class="form-label small">K1 - Appareil sanitaire :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Nombre"
                           data-bruxelles-simulation-card-target="inputAppareilSanitaire"
                           data-action="input->bruxelles-simulation-card#calculate">
                    <span class="input-group-text bg-info text-white"
                          data-bruxelles-simulation-card-target="resultAppareilSanitaire">0 €</span>
                  </div>
                  <!-- Informations de la prime -->
                  <% condition_text = condition_prime("bruxelles_appareil_sanitaire") %>
                  <% conseil_text = conseil_prime("bruxelles_appareil_sanitaire") %>
                  <% if condition_text.present? || conseil_text.present? %>
                    <div class="mt-1">
                      <% if condition_text.present? %>
                        <div class="mb-1">
                          <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <%= condition_text %>
                          </small>
                        </div>
                      <% end %>
                      <% if conseil_text.present? %>
                        <div>
                          <small class="text-success">
                            <i class="bi bi-lightbulb me-1"></i>
                            <%= conseil_text %>
                          </small>
                        </div>
                      <% end %>
                    </div>
                  <% end %>

                </div>

                <!-- Mise aux normes électriques -->
                <div class="col-md-12">
                  <label class="form-label small">L1 - Mise aux normes électriques :</label>
                  <div class="input-group input-group-sm">
                    <input type="number"
                           class="form-control"
                           data-bruxelles-simulation-card-target="inputMiseNormesElecGaz"
                           data-action="input->bruxelles-simulation-card#calculate"
                           placeholder="Montant travaux électricité"
                           min="0"
                           step="0.01">
                    <span class="input-group-text">€</span>
                    <span class="input-group-text bg-info text-white"
                          data-bruxelles-simulation-card-target="resultMiseNormesElecGaz">0 €</span>
                  </div>
                  <!-- Informations de la prime -->
                  <% condition_text = condition_prime("bruxelles_mise_normes_electricite_gaz") %>
                  <% conseil_text = conseil_prime("bruxelles_mise_normes_electricite_gaz") %>
                  <% if condition_text.present? || conseil_text.present? %>
                    <div class="mt-1">
                      <% if condition_text.present? %>
                        <div class="mb-1">
                          <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <%= condition_text %>
                          </small>
                        </div>
                      <% end %>
                      <% if conseil_text.present? %>
                        <div>
                          <small class="text-success">
                            <i class="bi bi-lightbulb me-1"></i>
                            <%= conseil_text %>
                          </small>
                        </div>
                      <% end %>
                    </div>
                  <% end %>

                </div>
              </div>

              <!-- Total Sanitaires -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-info">Total Sanitaires :</strong>
                  <span class="badge bg-info fs-6" data-bruxelles-simulation-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
