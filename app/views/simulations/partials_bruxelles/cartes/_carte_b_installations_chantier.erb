<!-- CARTE B: INSTALLATIONS DE CHANTIER (PRIME B) -->
<div class="col-12 col-md-6 col-lg-3">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium"
       data-controller="bruxelles-simulation-card"
       data-bruxelles-simulation-card-slug-value="bruxelles_prime_b_global"
       data-statut-compatible='["residentiel"]'>

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/d58b5cc36342bb6e3d805bb4a69c4843-31393721_inapgx'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-ladder fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Prime B - Échafaudage</h6>
          <small class="opacity-90">Échafaudages, protection</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill px-3">
            <i class="bi bi-ladder me-1"></i>Échafaudage
          </span>
          <small class="text-muted">
            <i class="bi bi-shield text-warning me-1"></i>Protection chantier
          </small>
        </div>
      </div>

      <!-- Protection/échafaudages -->
      <div class="mb-3">
        <label class="form-label small">B1 - Échafaudage (m²) :</label>
        <div class="input-group input-group-sm">
          <input type="number" class="form-control" placeholder="Surface m²"
                 data-bruxelles-simulation-card-target="inputProtectionEchafaudages"
                 data-slug="bruxelles_protection_echafaudages"
                 data-action="input->bruxelles-simulation-card#calculate">
          <span class="input-group-text bg-warning text-white"
                data-bruxelles-simulation-card-target="resultProtectionEchafaudages">0 €</span>
        </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("bruxelles_protection_echafaudages") %>
        <% conseil_text = conseil_prime("bruxelles_protection_echafaudages") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Total Installations -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-warning">Total Installations :</strong>
          <span class="badge bg-warning fs-6" data-bruxelles-simulation-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
