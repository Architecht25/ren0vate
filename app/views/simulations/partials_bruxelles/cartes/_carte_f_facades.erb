            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-simulation-card-target="resultIsolationExterieure">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_isolation_exterieure_facade") %>
          <% conseil_text = conseil_prime("bruxelles_isolation_exterieure_facade") %>
          <% if condition_text.present? || conseil_text.present? %>
