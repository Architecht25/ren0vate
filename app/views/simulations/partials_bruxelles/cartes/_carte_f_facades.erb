                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Isolation coulisse -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">F1 - Isolation coulisse :</label>
