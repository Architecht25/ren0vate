<%# Carte F - Prime Façades %>
<%# Isolation intérieure/extérieure, bardage, enduit, embellissement %>

<!-- CARTE 6: FAÇADES (PRIME F) -->
<div class="col-12 col-md-6 col-lg-4">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium"
       data-controller="bruxelles-simulation-card"
       data-bruxelles-simulation-card-slug-value="bruxelles_prime_f_global"
       data-statut-compatible='["residentiel", "mixte"]'>
    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/renovation_murs_istlqj'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-house fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Prime F - Façades</h6>
          <small class="opacity-90">Isolation, bardage, embellissement</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-secondary bg-opacity-20 text-secondary rounded-pill px-3">
            <i class="bi bi-house me-1"></i>Façades
          </span>
          <small class="text-muted">
            <i class="bi bi-brush text-secondary me-1"></i>Isolation & esthétique
          </small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Isolation intérieure façade -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">F1 - Isolation intérieure :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputIsolationInterieure"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-simulation-card-target="resultIsolationInterieure">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_isolation_interieure_facade") %>
          <% conseil_text = conseil_prime("bruxelles_isolation_interieure_facade") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Isolation extérieure façade -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">F1 - Isolation extérieure :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputIsolationExterieure"
