          <label class="form-label small">A4 - Suivi expert façade :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Honoraires €"
                   data-bruxelles-simulation-card-target="inputSuiviExpertFacade"
