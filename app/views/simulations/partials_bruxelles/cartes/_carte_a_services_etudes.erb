          <label class="form-label small">A2 - Étude acoustique :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Montant travaux isolation acoustique"
                   data-bruxelles-simulation-card-target="inputEtudeAcoustique"
