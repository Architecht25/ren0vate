<!-- CARTE A: SERVICES ET ÉTUDES PRÉALABLES (PRIME A) -->
<div class="col-12 col-lg-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium"
       data-controller="bruxelles-simulation-card"
       data-bruxelles-simulation-card-slug-value="bruxelles_prime_a_global"
       data-statut-compatible='["residentiel", "mixte"]'>

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/bureau_etude_renovation_energetique_4_yswh8x'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-clipboard-data fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Prime A - Études et audits</h6>
          <small class="opacity-90">Audits, études, suivi</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-primary bg-opacity-20 text-primary rounded-pill px-3">
            <i class="bi bi-clipboard-data me-1"></i>Études
          </span>
          <small class="text-muted">
            <i class="bi bi-search text-primary me-1"></i>Diagnostics & conseil
          </small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Audit énergétique maison -->
        <div class="col-12 col-sm-6 col-lg-4">
          <label class="form-label small">A1 - Audit énergétique :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-bruxelles-simulation-card-target="inputAuditMaison"
                    data-action="change->bruxelles-simulation-card#calculate">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-simulation-card-target="resultAuditMaison">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_audit_energetique_maison") %>
          <% conseil_text = conseil_prime("bruxelles_audit_energetique_maison") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Audit énergétique bâtiment -->
        <div class="col-12 col-sm-6 col-lg-4">
          <label class="form-label small">A1 - Audit bâtiment :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-bruxelles-simulation-card-target="inputAuditBatiment"
                    data-action="change->bruxelles-simulation-card#calculate">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-simulation-card-target="resultAuditBatiment">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_audit_energetique_batiment") %>
          <% conseil_text = conseil_prime("bruxelles_audit_energetique_batiment") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
