<%# Carte C - Prime Gros-œuvre & Gestion de l'eau %>
<%# Structure portante, égouts, récupération eau de pluie, démolition perméabilisation %>

<!-- CARTE 3: GROS-ŒUVRE & GESTION DE L'EAU (PRIME C) -->
<div class="col-12 col-lg-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium"
       data-controller="bruxelles-simulation-card"
       data-bruxelles-simulation-card-slug-value="bruxelles_prime_c_global"
       data-statut-compatible='["residentiel"]'>
    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_600,h_120,q_auto,f_auto/gros_oeuvre-scaled_g8jgzv'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-columns fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Prime C - Structure et gros œuvre</h6>
          <small class="opacity-90">Structure, égouts, récupération</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-info bg-opacity-20 text-info rounded-pill px-3">
            <i class="bi bi-columns me-1"></i>Gros œuvre
          </span>
          <small class="text-muted">
            <i class="bi bi-building text-info me-1"></i>Structure & fondations
          </small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Structures portantes -->
        <div class="col-md-6">
          <label class="form-label small">C1 - Structures portantes :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Montant €"
                   data-bruxelles-simulation-card-target="inputStructurePortante"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-info text-white"
                  data-bruxelles-simulation-card-target="resultStructurePortante">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_structure_portante") %>
          <% conseil_text = conseil_prime("bruxelles_structure_portante") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                  </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Gestion égouts -->
        <div class="col-md-12">
          <label class="form-label small">C2 - Égouts :</label>
          <div class="row g-2">
            <div class="col-6">
              <input type="number" class="form-control form-control-sm" placeholder="Mètres tuyauterie"
                     data-bruxelles-simulation-card-target="inputGestionEgouts"
                     data-action="input->bruxelles-simulation-card#calculate">
            </div>
            <div class="col-6">
              <input type="number" class="form-control form-control-sm" placeholder="Chambres visite"
                     data-bruxelles-simulation-card-target="inputGestionEgouts"
                     data-action="input->bruxelles-simulation-card#calculate">
            </div>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-6">
              <input type="number" class="form-control form-control-sm" placeholder="Avaloirs"
                     data-bruxelles-simulation-card-target="inputGestionEgouts"
                     data-action="input->bruxelles-simulation-card#calculate">
            </div>
            <div class="col-6">
              <input type="number" class="form-control form-control-sm" placeholder="Raccordements"
                     data-bruxelles-simulation-card-target="inputGestionEgouts"
                     data-action="input->bruxelles-simulation-card#calculate">
            </div>
          </div>
          <div class="mt-2">
            <span class="input-group-text bg-info text-white d-inline-block"
                  data-bruxelles-simulation-card-target="resultGestionEgouts">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_gestion_egouts") %>
          <% conseil_text = conseil_prime("bruxelles_gestion_egouts") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Récupération eau de pluie -->
        <div class="col-md-6">
          <label class="form-label small">C3 - Récupération eau pluie :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-bruxelles-simulation-card-target="inputRecuperationEauPluie"
                    data-action="change->bruxelles-simulation-card#calculate">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-info text-white"
                  data-bruxelles-simulation-card-target="resultRecuperationEauPluie">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_recuperation_eau_pluie") %>
          <% conseil_text = conseil_prime("bruxelles_recuperation_eau_pluie") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Démolition perméabilisation -->
        <div class="col-md-6">
          <label class="form-label small">C4 - Démolition perméabilisation :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputDemolitionPermeabilisation"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-info text-white"
                  data-bruxelles-simulation-card-target="resultDemolitionPermeabilisation">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_demolition_permeabilisation") %>
          <% conseil_text = conseil_prime("bruxelles_demolition_permeabilisation") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Total Gros-œuvre -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-info">Total Gros-œuvre :</strong>
          <span class="badge bg-info fs-6" data-bruxelles-simulation-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
