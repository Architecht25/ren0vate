<%# Carte I - Prime Aménagement intérieur / Équipements %>
<%# Escaliers, emplacement vélo, protection incendie, aménagement PMR %>

<!-- CARTE 9: AMÉNAGEMENT INTÉRIEUR (PRIME I) -->
<div class="col-12 col-md-6 col-lg-4">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium"
       data-controller="bruxelles-simulation-card"
       data-bruxelles-simulation-card-slug-value="bruxelles_prime_i_global"
       data-statut-compatible='["residentiel"]'>

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/renovation_escalier_peinture_bois_1919_by_mauler_couleur_blanc_yi6jr3'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-bicycle fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Prime I - Équipements</h6>
          <small class="opacity-90">Vélos, protection incendie</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill px-3">
            <i class="bi bi-bicycle me-1"></i>Équipements
          </span>
          <small class="text-muted">
            <i class="bi bi-tools text-warning me-1"></i>Aménagements & sécurité
          </small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Escaliers -->
        <div class="col-md-6">
          <label class="form-label small">I1 - Escaliers :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Nb marches"
                   data-bruxelles-simulation-card-target="inputEscaliers"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-warning text-white"
                  data-bruxelles-simulation-card-target="resultEscaliers">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_escaliers") %>
          <% conseil_text = conseil_prime("bruxelles_escaliers") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Emplacement vélo -->
        <div class="col-md-6">
          <label class="form-label small">I2 - Emplacement vélo :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Nb empl. (max 2)"
                   data-bruxelles-simulation-card-target="inputEmplacementVelo"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-warning text-white"
                  data-bruxelles-simulation-card-target="resultEmplacementVelo">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_emplacement_velo") %>
          <% conseil_text = conseil_prime("bruxelles_emplacement_velo") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Protection incendie -->
        <div class="col-md-6">
          <label class="form-label small">I3 - Protection incendie :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Montant €"
                   data-bruxelles-simulation-card-target="inputProtectionIncendie"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-warning text-white"
                  data-bruxelles-simulation-card-target="resultProtectionIncendie">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_protection_incendie") %>
          <% conseil_text = conseil_prime("bruxelles_protection_incendie") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Aménagement PMR -->
        <div class="col-md-6">
          <label class="form-label small">I4 - Aménagement PMR :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-bruxelles-simulation-card-target="inputAmenagementPmr"
                    data-action="change->bruxelles-simulation-card#calculate">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-bruxelles-simulation-card-target="resultAmenagementPmr">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_amenagement_pmr") %>
          <% conseil_text = conseil_prime("bruxelles_amenagement_pmr") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Total Aménagement -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-warning">Total Aménagement :</strong>
          <span class="badge bg-warning fs-6" data-bruxelles-simulation-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
