<%# Carte G - Prime Portes & Fenêtres %>
<%# Remplacement et réparation de menuiseries %>

<!-- CARTE 8: PORTES & FENÊTRES (PRIME G) -->
<div class="col-12 col-md-6 col-lg-4">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium"
       data-controller="bruxelles-simulation-card"
       data-bruxelles-simulation-card-slug-value="bruxelles_prime_g_global"
       data-statut-compatible='["residentiel", "mixte"]'>

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/remplacement_chassis_lrszxo'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-window fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Prime G - Portes et fenêtres</h6>
          <small class="opacity-90">Remplacement, réparation</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-primary bg-opacity-20 text-primary rounded-pill px-3">
            <i class="bi bi-window me-1"></i>Châssis
          </span>
          <small class="text-muted">
            <i class="bi bi-eye text-primary me-1"></i>Luminosité & isolation
          </small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Remplacement fenêtres bois -->
        <div class="col-md-6">
          <label class="form-label small">G1 - Fenêtres bois :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputFenetresBois"
                   data-slug="bruxelles_remplacement_fenetres_bois"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-simulation-card-target="resultFenetresBois">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_remplacement_fenetres_bois") %>
          <% conseil_text = conseil_prime("bruxelles_remplacement_fenetres_bois") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Remplacement fenêtres PVC/alu -->
        <div class="col-md-6">
          <label class="form-label small">G1 - Fenêtres PVC/alu :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputFenetresPvcAlu"
                   data-slug="bruxelles_remplacement_fenetres_pvc_alu"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-simulation-card-target="resultFenetresPvcAlu">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_remplacement_fenetres_pvc_alu") %>
          <% conseil_text = conseil_prime("bruxelles_remplacement_fenetres_pvc_alu") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Réparation fenêtres -->
        <div class="col-md-6">
          <label class="form-label small">G2 - Réparation fenêtres :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputReparationFenetres"
                   data-slug="bruxelles_reparation_fenetres"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-simulation-card-target="resultReparationFenetres">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_reparation_fenetres") %>
          <% conseil_text = conseil_prime("bruxelles_reparation_fenetres") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Réparation portes -->
        <div class="col-md-6">
          <label class="form-label small">G3 - Réparation portes :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-simulation-card-target="inputReparationPortes"
                   data-slug="bruxelles_reparation_portes"
                   data-action="input->bruxelles-simulation-card#calculate">
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-simulation-card-target="resultReparationPortes">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_reparation_portes") %>
          <% conseil_text = conseil_prime("bruxelles_reparation_portes") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Total Portes & Fenêtres -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-primary">Total Menuiseries :</strong>
          <span class="badge bg-primary fs-6" data-bruxelles-simulation-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
