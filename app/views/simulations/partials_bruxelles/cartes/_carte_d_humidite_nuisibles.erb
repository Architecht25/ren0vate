<%# Carte D - Prime Humidité et nuisibles %>
<%# Traitement humidité, problèmes fongiques et d'insectes %>

<!-- CARTE 4: SALUBRITÉ (PRIME D) -->
<div class="col-12 col-md-6 col-lg-3">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium"
       data-controller="bruxelles-prime-card"
       data-bruxelles-prime-card-slug-value="bruxelles_prime_d_global"
       data-statut-compatible='["residentiel"]'>

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/Le-poisson-dargent-un-indicateur-dhumidite-dans-votre-maison_tvf1wz'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-shield-check fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Prime D - Humidité et nuisibles</h6>
          <small class="opacity-90">Humidité, traitement</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-danger bg-opacity-20 text-danger rounded-pill px-3">
            <i class="bi bi-shield-check me-1"></i>Salubrité
          </span>
          <small class="text-muted">
            <i class="bi bi-droplet-half text-danger me-1"></i>Humidité & nuisibles
          </small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Traitement humidité sol -->
        <div class="col-md-12">
          <label class="form-label small">D1 - Problème d'humidité :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Montant €"
                   data-bruxelles-prime-card-target="inputTraitementHumiditeSol"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-danger text-white"
                  data-bruxelles-prime-card-target="resultTraitementHumiditeSol">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_traitement_humidite_sol") %>
          <% conseil_text = conseil_prime("bruxelles_traitement_humidite_sol") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Traitement fongique/insectes -->
        <div class="col-md-12">
          <label class="form-label small">D2 - Champignons et insectes :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Montant €"
                   data-bruxelles-prime-card-target="inputTraitementFongiqueInsectes"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-danger text-white"
                  data-bruxelles-prime-card-target="resultTraitementFongiqueInsectes">0 €</span>
          </div>
          <!-- Informations de la prime -->
          <% condition_text = condition_prime("bruxelles_traitement_fongique_insectes") %>
          <% conseil_text = conseil_prime("bruxelles_traitement_fongique_insectes") %>
          <% if condition_text.present? || conseil_text.present? %>
            <div class="mt-1">
              <% if condition_text.present? %>
                <div class="mb-1">
                  <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    <%= condition_text %>
                  </small>
                </div>
              <% end %>
              <% if conseil_text.present? %>
                <div>
                  <small class="text-success">
                    <i class="bi bi-lightbulb me-1"></i>
                    <%= conseil_text %>
                  </small>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Total Salubrité -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-danger">Total Salubrité :</strong>
          <span class="badge bg-danger fs-6" data-bruxelles-prime-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
