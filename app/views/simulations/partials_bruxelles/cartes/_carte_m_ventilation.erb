        <!-- CARTE 12: VENTILATION (PRIME M) -->
        <div class="col-12 col-md-6 col-lg-3">
          <div class="card border-0 shadow h-100 overflow-hidden card-premium"
               data-controller="bruxelles-simulation-card"
               data-bruxelles-simulation-card-slug-value="bruxelles_prime_m_global"
               data-statut-compatible='["residentiel", "mixte"]'>

            <!-- Image de fond avec overlay -->
            <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/Housing-Ventilation-Shutterstock-16-9-1920x1080px_uxckrq'); background-size: cover; background-position: center;">
              <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
                <div class="text-center text-white">
                  <i class="bi bi-wind fs-3 mb-2 drop-shadow"></i>
                  <h6 class="fw-bold mb-0 drop-shadow">Prime M - Ventilation</h6>
                  <small class="opacity-90">VMC, système C et D</small>
                </div>
              </div>
            </div>

            <div class="card-body">
              <!-- Badge informatif -->
              <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between">
                  <span class="badge bg-success bg-opacity-20 text-success rounded-pill px-3">
                    <i class="bi bi-wind me-1"></i>Ventilation
                  </span>
                  <small class="text-muted">
                    <i class="bi bi-arrow-repeat text-success me-1"></i>Air sain & économies
                  </small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Ventilation système C -->
                <div class="col-md-12">
                  <label class="form-label small">M1 - Ventilation système C :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-simulation-card-target="inputVentilationC"
                            data-slug="bruxelles_ventilation_systeme_c"
                            data-action="change->bruxelles-simulation-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-simulation-card-target="resultVentilationC">0 €</span>
                  </div>
                  <!-- Informations de la prime -->
                  <% condition_text = condition_prime("bruxelles_ventilation_systeme_c") %>
                  <% conseil_text = conseil_prime("bruxelles_ventilation_systeme_c") %>
                  <% if condition_text.present? || conseil_text.present? %>
                    <div class="mt-1">
                      <% if condition_text.present? %>
                        <div class="mb-1">
                          <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <%= condition_text %>
                          </small>
                        </div>
                      <% end %>
                      <% if conseil_text.present? %>
                        <div>
                          <small class="text-success">
                            <i class="bi bi-lightbulb me-1"></i>
                            <%= conseil_text %>
                          </small>
                        </div>
                      <% end %>
                    </div>
                  <% end %>

                </div>

                <!-- Ventilation système D -->
                <div class="col-md-12">
                  <label class="form-label small">M2 - Ventilation système D :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-simulation-card-target="inputVentilationD"
                            data-slug="bruxelles_ventilation_systeme_d"
                            data-action="change->bruxelles-simulation-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-simulation-card-target="resultVentilationD">0 €</span>
                  </div>
                  <!-- Informations de la prime -->
                  <% condition_text = condition_prime("bruxelles_ventilation_systeme_d") %>
                  <% conseil_text = conseil_prime("bruxelles_ventilation_systeme_d") %>
                  <% if condition_text.present? || conseil_text.present? %>
                    <div class="mt-1">
                      <% if condition_text.present? %>
                        <div class="mb-1">
                          <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <%= condition_text %>
                          </small>
                        </div>
                      <% end %>
                      <% if conseil_text.present? %>
                        <div>
                          <small class="text-success">
                            <i class="bi bi-lightbulb me-1"></i>
                            <%= conseil_text %>
                          </small>
                        </div>
                      <% end %>
                    </div>
                  <% end %>

                </div>
              </div>

              <!-- Total Ventilation -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-success">Total Ventilation :</strong>
                  <span class="badge bg-success fs-6" data-bruxelles-simulation-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
