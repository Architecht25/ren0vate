              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-clipboard-data fs-5 text-primary"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Prime A - Études et audits</h6>
                  <small class="text-muted">Audits, études, suivi</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Audit énergétique maison -->
                <div class="col-md-2">
                  <label class="form-label small">A1 - Audit énergétique :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-prime-card-target="inputAuditMaison"
                            data-action="change->bruxelles-prime-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultAuditMaison">0 €</span>
                  </div>
                  <!-- Informations de la prime -->
                  <% condition_text = condition_prime("bruxelles_audit_energetique_maison") %>
                  <% conseil_text = conseil_prime("bruxelles_audit_energetique_maison") %>
                  <% if condition_text.present? || conseil_text.present? %>
                    <div class="mt-1">
                      <% if condition_text.present? %>
                        <div class="mb-1">
                          <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            <%= condition_text %>
                          </small>
                        </div>
                      <% end %>
                      <% if conseil_text.present? %>
                        <div>
                          <small class="text-success">
                            <i class="bi bi-lightbulb me-1"></i>
                            <%= conseil_text %>
                          </small>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>

                <!-- Audit énergétique bâtiment -->
