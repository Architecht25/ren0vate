<div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
    <div class="card-body d-flex flex-column align-items-center gap-3">
      <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
        <i class="bi bi-bank fs-5 text-info"></i>
      </div>
      <h6 class="card-title mb-2">Vérifier si le bien est classé</h6>
      <p class="small text-muted mb-0">Monuments &amp; Sites — Région de Bruxelles-Capitale</p>

      <div class="w-100" style="max-width: 360px;">

        <!-- Champs adresse -->
        <div class="row g-2 mb-2 text-start">
          <div class="col-8">
            <label class="form-label small mb-1">Rue</label>
            <input type="text" class="form-control form-control-sm" id="mon_rue_bruxelles" placeholder="ex: Rue de la Loi">
          </div>
          <div class="col-4">
            <label class="form-label small mb-1">Numéro</label>
            <input type="text" class="form-control form-control-sm" id="mon_numero_bruxelles" placeholder="ex: 16">
          </div>
          <div class="col-4">
            <label class="form-label small mb-1">Code postal</label>
            <input type="text" class="form-control form-control-sm" id="mon_cp_bruxelles" placeholder="1000" maxlength="4">
          </div>
          <div class="col-8">
            <label class="form-label small mb-1">Commune</label>
            <input type="text" class="form-control form-control-sm" id="mon_commune_bruxelles" placeholder="ex: Bruxelles">
          </div>
        </div>

        <!-- Bouton de vérification -->
        <button type="button" id="btn-verif-monuments-bruxelles"
                class="btn btn-info btn-sm w-100 rounded-3 mb-3">
          <i class="bi bi-search me-1"></i>Vérifier le statut patrimonial
        </button>

        <!-- Loader -->
        <div id="mon-loading-bruxelles" class="d-none mb-3">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <div class="spinner-border spinner-border-sm text-info" role="status"></div>
            <small class="text-muted">Recherche en cours…</small>
          </div>
        </div>

        <!-- Résultat -->
        <div id="mon-result-bruxelles" class="d-none mb-2 p-3 rounded-3 text-start">
          <div class="d-flex align-items-start gap-2">
            <i id="mon-result-icon" class="bi fs-5 mt-1"></i>
            <div>
              <p id="mon-result-title" class="fw-bold mb-1 small"></p>
              <p id="mon-result-detail" class="mb-0 small text-muted"></p>
            </div>
          </div>
        </div>

        <!-- Lien externe -->
        <a href="https://monument.heritage.brussels/fr/recherche/" target="_blank" rel="noopener"
           class="btn btn-outline-secondary btn-sm w-100 rounded-3">
          <i class="bi bi-box-arrow-up-right me-1"></i>Consulter la carte officielle
        </a>
      </div>
    </div>
  </div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {
  var btn = document.getElementById('btn-verif-monuments-bruxelles');
  if (!btn) return;

  btn.addEventListener('click', function() {
    var rue    = (document.getElementById('mon_rue_bruxelles').value || '').trim();
    var num    = (document.getElementById('mon_numero_bruxelles').value || '').trim();
    var cp     = (document.getElementById('mon_cp_bruxelles').value || '').trim();
    var commune = (document.getElementById('mon_commune_bruxelles').value || '').trim();

    if (!rue || !cp) {
      alert('Veuillez au minimum renseigner la rue et le code postal.');
      return;
    }

    var loader = document.getElementById('mon-loading-bruxelles');
    var result = document.getElementById('mon-result-bruxelles');
    var icon   = document.getElementById('mon-result-icon');
    var title  = document.getElementById('mon-result-title');
    var detail = document.getElementById('mon-result-detail');

    loader.classList.remove('d-none');
    result.classList.add('d-none');
    btn.disabled = true;

    // Étape 1 : géocodage via Nominatim
    var query = encodeURIComponent([num, rue, cp, commune, 'Belgique'].filter(Boolean).join(' '));
    fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + query, {
      headers: { 'Accept-Language': 'fr', 'User-Agent': 'Ren0vate/1.0' }
    })
    .then(function(r) { return r.json(); })
    .then(function(geo) {
      if (!geo || !geo.length) throw new Error('Adresse introuvable. Vérifiez les champs.');
      var lat = parseFloat(geo[0].lat);
      var lon = parseFloat(geo[0].lon);

      // Étape 2 : proxy Rails → Brussels Heritage ArcGIS (évite CORS)
      return fetch('/properties/check_heritage?lat=' + lat + '&lon=' + lon, {
        headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
      }).then(function(r) { return r.json(); });
    })
    .then(function(data) {
      loader.classList.add('d-none');
      btn.disabled = false;
      result.classList.remove('d-none');

      if (data.features && data.features.length > 0) {
        var f = data.features[0].attributes;
        icon.className = 'bi bi-shield-fill-check fs-5 mt-1 text-success';
        result.style.background = '#d4edda';
        result.style.borderLeft = '4px solid #28a745';
        title.textContent = 'Bien classé ou protégé';
        detail.textContent = (f.DENOMINATION || 'Monument répertorié')
          + (f.DATE_ARRETE ? ' — Arrêté : ' + f.DATE_ARRETE : '')
          + (f.STATUT ? ' (' + f.STATUT + ')' : '');
      } else {
        icon.className = 'bi bi-shield-x fs-5 mt-1 text-secondary';
        result.style.background = '#f8f9fa';
        result.style.borderLeft = '4px solid #6c757d';
        title.textContent = 'Non classé';
        detail.textContent = 'Aucun bien classé ou protégé trouvé à cette adresse dans la base Brussels Heritage.';
      }
    })
    .catch(function(err) {
      loader.classList.add('d-none');
      btn.disabled = false;
      result.classList.remove('d-none');
      icon.className = 'bi bi-exclamation-triangle fs-5 mt-1 text-warning';
      result.style.background = '#fff3cd';
      result.style.borderLeft = '4px solid #ffc107';
      title.textContent = 'Vérification impossible';
      detail.textContent = err.message || 'Erreur lors de la requête. Consultez la carte officielle.';
    });
  });
})();
</script>
