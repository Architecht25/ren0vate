<div class="card shadow-sm border-0 rounded-4 overflow-hidden h-100">

  <%# En-tête ardoise %>
  <div class="p-3 text-white" style="background: linear-gradient(135deg, #475569 0%, #334155 100%);">
    <div class="d-flex align-items-center gap-2">
      <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
           style="width:40px;height:40px;flex-shrink:0;">
        <i class="bi bi-calendar-x fs-5"></i>
      </div>
      <div>
        <div class="fw-bold">Renolution</div>
        <div class="small opacity-75">Programme terminé</div>
      </div>
    </div>
  </div>

  <div class="card-body d-flex flex-column gap-3 p-3">

    <%# Badge statut %>
    <div class="d-flex align-items-center gap-2 p-2 rounded-3"
         style="background:#f1f5f9; border-left:3px solid #64748b;">
      <i class="bi bi-slash-circle text-secondary flex-shrink-0"></i>
      <div>
        <p class="fw-semibold mb-0 small">Programme terminé depuis janvier 2025</p>
        <p class="text-muted mb-0" style="font-size:0.75rem;">
          Les primes Renolution ne sont plus disponibles à Bruxelles-Capitale.
        </p>
      </div>
    </div>

    <%# Alternatives %>
    <div>
      <p class="small fw-semibold text-muted mb-2">Alternatives disponibles :</p>
      <div class="d-flex flex-column gap-2">
        <div class="d-flex align-items-center gap-2 p-2 rounded-3 border" style="background:#eff6ff;">
          <i class="bi bi-bank text-primary flex-shrink-0"></i>
          <span class="small"><strong>Monuments &amp; Sites</strong> — biens classés ou protégés</span>
        </div>
        <div class="d-flex align-items-center gap-2 p-2 rounded-3 border" style="background:#faf5ff;">
          <i class="bi bi-gem flex-shrink-0" style="color:#7c3aed;"></i>
          <span class="small"><strong>Petit Patrimoine</strong> — éléments architecturaux</span>
        </div>
        <div class="d-flex align-items-center gap-2 p-2 rounded-3 border" style="background:#fff7ed;">
          <i class="bi bi-building text-orange flex-shrink-0" style="color:#ea580c;"></i>
          <span class="small"><strong>Primes Communales</strong> — selon votre commune</span>
        </div>
        <div class="d-flex align-items-center gap-2 p-2 rounded-3 border" style="background:#f0fdf4;">
          <i class="bi bi-percent text-success flex-shrink-0"></i>
          <span class="small"><strong>Prêts à taux 0%</strong> — financement avantageux</span>
        </div>
      </div>
    </div>

    <%# CTA %>
    <div class="mt-auto">
      <a href="https://environnement.brussels/citoyen/mes-primes-et-incitants"
         target="_blank" rel="noopener"
         class="btn btn-outline-secondary btn-sm w-100 rounded-3">
        <i class="bi bi-box-arrow-up-right me-1"></i>Toutes les primes Bruxelles
      </a>
    </div>

  </div>
</div>
