<!-- ÉTAPE 1: Test d'éligibilité Bruxelles -->
<div class="card border-0 shadow-sm mb-4 h-100" id="eligibility-step">
  <div class="card-body p-4 d-flex flex-column">
    <h5 class="card-title text-primary-custom mb-3">
      <i class="bi bi-shield-check me-2"></i>Étape 1 : Test d'éligibilité (Bruxelles-Capitale)
    </h5>

    <div id="eligibility-status">
      <% if @simulation.respond_to?(:eligible) && @simulation.eligible? %>
        <div class="alert alert-success d-flex align-items-center" role="alert">
          <i class="bi bi-check-circle-fill me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">✅ Votre demande est éligible !</h6>
            <p class="mb-0">Vous remplissez les conditions pour bénéficier des primes RENOLUTION de Bruxelles-Capitale.</p>
            <% if @simulation.respond_to?(:category_description) && @simulation.category_description.present? %>
              <small class="text-muted">Détails : <%= @simulation.category_description %></small>
            <% end %>
          </div>
        </div>
      <% elsif @simulation.respond_to?(:eligible) && !@simulation.eligible? %>
        <div class="alert alert-danger d-flex align-items-center" role="alert">
          <i class="bi bi-x-circle-fill me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">❌ Votre demande n'est pas éligible</h6>
            <p class="mb-0">Certaines conditions ne sont pas remplies pour les primes RENOLUTION Bruxelles.</p>
            <% if @simulation.respond_to?(:ineligibility_reason) && @simulation.ineligibility_reason.present? %>
              <small class="text-muted">Raison : <%= @simulation.ineligibility_reason %></small>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="alert alert-info d-flex align-items-center" role="alert">
          <i class="bi bi-hourglass-split me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">🔄 Test d'éligibilité prêt</h6>
            <p class="mb-0">Cliquez sur le bouton ci-dessous pour vérifier l'éligibilité de votre demande RENOLUTION Bruxelles.</p>
          </div>
        </div>
      <% end %>
    </div>

    <% unless @simulation.respond_to?(:eligible) && @simulation.eligible? %>
      <div class="mt-3">
        <button id="check-eligibility-btn-bruxelles" class="btn btn-primary-custom">
          <i class="bi bi-shield-check me-2"></i>Vérifier l'éligibilité Bruxelles
        </button>
      </div>
    <% else %>
      <div class="mt-3">
        <button id="update-eligibility-btn-bruxelles" class="btn btn-outline-primary">
          <i class="bi bi-arrow-clockwise me-2"></i>Mettre à jour le test d'éligibilité
        </button>
      </div>
    <% end %>

    <!-- Informations spécifiques à Bruxelles -->
    <div class="mt-3 p-3 bg-light rounded">
      <h6 class="text-primary-custom mb-2">
        <i class="bi bi-info-circle me-2"></i>Spécificités RENOLUTION Bruxelles
      </h6>
      <ul class="small text-muted mb-0">
        <li>Logement situé en Région de Bruxelles-Capitale (19 communes)</li>
        <li>Bâtiment âgé d'au moins 10 ans</li>
        <li>Travaux réalisés par un professionnel agréé BCE</li>
        <li>3 catégories de revenus selon le système RENOLUTION</li>
      </ul>
    </div>
  </div>
</div>
