<%
  # Helpers pour accéder aux données de conditions et conseils depuis la base de données
  def condition_prime(slug)
    prime = Prime.find_by(slug: slug)
    prime&.condition || ""
  end

  def conseil_prime(slug)
    prime = Prime.find_by(slug: slug)
    prime&.conseil || ""
  end
%>

<!-- Section Primes Bruxelles RENOLUTION - 13 cartes principales par catégorie -->

  <!-- Injection des données de primes depuis la base de données -->
  <script id="bruxelles-primes-data" type="application/json">
    <%= raw Prime.where(region: "bruxelles").map { |prime|
      [prime.slug, {
        nom: prime.titre,
        valeurs_par_categorie: {
          "bruxelles_cat1" => prime.valeurs_par_categorie&.dig("bruxelles_cat1") || {},
          "bruxelles_cat2" => prime.valeurs_par_categorie&.dig("bruxelles_cat2") || {},
          "bruxelles_cat3" => prime.valeurs_par_categorie&.dig("bruxelles_cat3") || {}
        }
      }]
    }.to_h.to_json %>
  </script>

  <!-- Styles pour les cartes améliorées -->
  <style>
    .drop-shadow {
      text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }

    .card-premium {
      transition: all 0.3s ease;
    }

    .card-premium:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }

    .image-overlay {
      background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));
      backdrop-filter: blur(1px);
    }

    .updated {
      animation: updateHighlight 0.6s ease;
    }

    @keyframes updateHighlight {
      0% { background-color: rgba(40, 167, 69, 0.2); }
      100% { background-color: transparent; }
    }
  </style>

  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-success bg-opacity-10">
      <h4 class="card-title mb-0">
        <i class="bi bi-calculator text-success me-2"></i>
        <span data-bruxelles-simulation-target="sectionTitle">
          Vos primes RENOLUTION Bruxelles - Catégorie I à III
        </span>
      </h4>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <p class="text-muted small mb-0">
          💡 Les montants s'ajustent automatiquement selon votre catégorie de revenus
        </p>
        <h5 class="text-success mb-0">
          Total: <span data-bruxelles-simulation-target="totalGeneral">0,00 €</span>
        </h5>
      </div>
    </div>
  </div>
