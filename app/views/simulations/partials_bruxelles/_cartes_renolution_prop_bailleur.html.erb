                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-prime-card-target="inputVentilation"
                            data-action="change->bruxelles-prime-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultVentilation">0 €</span>
                  </div>

                  <!-- Informations contextuelles depuis la base de données -->
                  <div class="mt-2">
                    <small class="text-muted d-block">
                      <i class="bi bi-info-circle me-1"></i>
                      Conditions : <%= condition_prime("bruxelles_ventilation_systeme_c") %>
                    </small>
                    <small class="text-success d-block mt-1">
                      <i class="bi bi-lightbulb me-1"></i>
                      Conseil : <%= conseil_prime("bruxelles_ventilation_systeme_c") %>
                    </small>
                  </div>
                </div>
              </div>

              <!-- Total -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-secondary">Total :</strong>
                  <span class="badge bg-secondary fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Résultats Bruxelles -->
      <div class="mt-4">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-3">

            <div class="row align-items-center">
                            <!-- Colonne milieu: Total principal -->
              <div class="col-md-3 text-center">
                <div class="p-3 bg-light rounded">
                  <h6 class="text-muted mb-2">
                    <i class="bi bi-calculator me-1"></i>
                    Total estimé
                  </h6>
                  <h3 class="text-primary mb-2" data-bruxelles-prime-calcul-target="totalGeneral">0 €</h3>
                  <small class="text-muted">
                    <span data-bruxelles-prime-calcul-target="currentCategory">Catégorie non définie</span><br>
                    Simulation du <%= Date.current.strftime("%d/%m/%Y") %>
                  </small>
                </div>
              </div>

            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
