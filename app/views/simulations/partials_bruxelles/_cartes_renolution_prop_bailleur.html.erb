<!-- Section Primes Bruxelles RENOLUTION - 13 cartes principales par catégorie -->
<div class="primes-section-bruxelles" data-controller="bruxelles-prime-calcul">

  <!-- Injection enrichie des données de primes depuis la base de données -->
  <script id="bruxelles-primes-data" type="application/json">
    <%= raw Prime.where(region: "bruxelles").map { |prime|
      [prime.slug, {
        nom: prime.titre,
        condition: prime.condition,
        conseil: prime.conseil,
        valeurs_par_categorie: {
          "bruxelles_cat1" => prime.valeurs_par_categorie&.dig("bruxelles_cat1") || {},
          "bruxelles_cat2" => prime.valeurs_par_categorie&.dig("bruxelles_cat2") || {},
          "bruxelles_cat3" => prime.valeurs_par_categorie&.dig("bruxelles_cat3") || {}
        }
      }]
    }.to_h.to_json %>
  </script>

  <%
    # Helper pour récupérer la condition d'une prime
    def condition_prime(slug)
      prime = Prime.find_by(slug: slug)
      prime&.condition || "Conditions en cours de chargement..."
    end

    # Helper pour récupérer le conseil d'une prime
    def conseil_prime(slug)
      prime = Prime.find_by(slug: slug)
      prime&.conseil || "Conseil en cours de chargement..."
    end
  %>

  <div class="card border-0 shadow mb-4">
    <div class="card-header bg-success bg-opacity-10">
      <h4 class="card-title mb-0">
        <i class="bi bi-calculator text-success me-2"></i>
        <span data-bruxelles-prime-calcul-target="sectionTitle">
          Vos primes RENOLUTION Bruxelles - Catégorie I à III
        </span>
      </h4>
      <p class="text-muted small mb-0 mt-1">
        💡 Les montants s'ajustent automatiquement selon votre catégorie de revenus
      </p>
    </div>
    <div class="card-body">

      <div class="row g-3">

        <!-- CARTE 2: E3 - ISOLATION THERMIQUE TOITURE -->
        <div class="col-2">
          <div class="card border-0 shadow h-100"
               data-controller="bruxelles-prime-card"
               data-bruxelles-prime-card-slug-value="bruxelles_prime_e_global"
               data-statut-compatible='["residentiel", "mixte"]'>
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-house-up fs-5 text-success"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">E3 - Isolation toiture</h6>
                  <small class="text-muted">Isolation thermique</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Isolation thermique toiture -->
                <div class="col-md-12">
                  <label class="form-label small">E3 - Isolation thermique :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationThermiqueToiture"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-prime-card-target="resultIsolationThermiqueToiture">0 €</span>
                  </div>

                  <!-- Informations contextuelles depuis la base de données -->
                  <div class="mt-2">
                    <small class="text-muted d-block">
                      <i class="bi bi-info-circle me-1"></i>
                      Conditions : <%= condition_prime("bruxelles_isolation_toiture_etancheite") %>
                    </small>
                    <small class="text-success d-block mt-1">
                      <i class="bi bi-lightbulb me-1"></i>
                      Conseil : <%= conseil_prime("bruxelles_isolation_toiture_etancheite") %>
                    </small>
                  </div>
                </div>
              </div>

              <!-- Total -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-success">Total :</strong>
                  <span class="badge bg-success fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

