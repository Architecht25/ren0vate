<script nonce="<%= content_security_policy_nonce %>">
console.log('🎯 Script de simulation chargé !');
document.addEventListener('DOMContentLoaded', function() {
  console.log('🚀 DOMContentLoaded - Script de simulation démarré !');
  console.log('📅 Timestamp:', new Date().toISOString());
  console.log('🔧 Version avec améliorations automatiques v2.0');

  const simulationId = '<%= @simulation.id %>';
  console.log('📋 Simulation ID:', simulationId);

  // Bouton pour vérifier l'éligibilité
  const checkEligibilityBtn = document.getElementById('check-eligibility-btn');
  if (checkEligibilityBtn) {
    checkEligibilityBtn.addEventListener('click', function() {
      this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Vérification en cours...';
      this.disabled = true;

      fetch(`/simulations/${simulationId}/check_eligibility`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Mettre à jour l'UI sans recharger
          this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Éligibilité vérifiée';
          this.disabled = true;
          this.classList.remove('btn-primary');
          this.classList.add('btn-success');

          // Déclencher automatiquement la détermination de catégorie
          console.log('🎯 Éligibilité confirmée, déclenchement automatique de la catégorie...');
          setTimeout(() => triggerCategoryDetermination(), 500);
        } else {
          console.error('Erreur lors de la vérification:', data);
          this.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Erreur - Réessayer';
          this.disabled = false;
        }
      })
      .catch(error => {
        console.error('Erreur réseau:', error);
        this.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Erreur - Réessayer';
        this.disabled = false;
      });
    });
  }

  // Bouton pour déterminer la catégorie
  const determineCategoryBtn = document.getElementById('determine-category-btn');
  if (determineCategoryBtn) {
    determineCategoryBtn.addEventListener('click', function() {
      this.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Analyse en cours...';
      this.disabled = true;

      fetch(`/simulations/${simulationId}/calculate_category`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
          'Accept': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Mettre à jour l'UI sans recharger
          this.innerHTML = '<i class="bi bi-check-circle me-2"></i>Catégorie déterminée';
          this.disabled = true;
          this.classList.remove('btn-primary');
          this.classList.add('btn-success');

          // Déclencher automatiquement le calcul des primes
          console.log('🎯 Catégorie confirmée, déclenchement automatique du calcul des primes...');
          setTimeout(() => triggerPrimesCalculation(), 500);
        } else {
          console.error('Erreur lors de la détermination:', data);
          this.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Erreur - Réessayer';
          this.disabled = false;
        }
      })
      .catch(error => {
        console.error('Erreur réseau:', error);
        this.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i>Erreur - Réessayer';
        this.disabled = false;
      });
    });
  }

  // Fonction pour déclencher automatiquement la détermination de catégorie
  function triggerCategoryDetermination() {
    console.log('🔄 triggerCategoryDetermination appelée !');
    const determineCategoryBtn = document.getElementById('determine-category-btn');
    console.log('🔍 Bouton déterminer catégorie:', determineCategoryBtn);
    if (determineCategoryBtn && !determineCategoryBtn.disabled) {
      console.log('✅ Déclenchement automatique de la détermination de catégorie');
      determineCategoryBtn.click();
    } else {
      console.log('❌ Catégorie déjà déterminée ou bouton non trouvé');
    }
  }

  // Fonction pour déclencher automatiquement le calcul des primes
  function triggerPrimesCalculation() {
    console.log('🔄 triggerPrimesCalculation appelée !');
    console.log('🎯 Déclenchement automatique du calcul des primes');

    fetch(`/simulations/${simulationId}/calculate_primes`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
        'Accept': 'application/json'
      }
    })
    .then(response => {
      console.log('📡 Réponse reçue du calcul primes:', response.status);
      return response.json();
    })
    .then(data => {
      console.log('📊 Données du calcul primes:', data);
      if (data.success) {
        console.log('✅ Calcul des primes réussi, rechargement de la page pour afficher les résultats');
        window.location.reload(); // Seulement pour cette étape finale
      } else {
        console.error('❌ Erreur lors du calcul des primes:', data);
      }
    })
    .catch(error => {
      console.error('❌ Erreur réseau lors du calcul des primes:', error);
    });
  }

  // Système de gestion des primes - Version optimisée
  function setupPrimeInputListeners() {
    if (window.primeListenersInitialized) {
      console.log('Prime listeners already initialized, skipping...');
      return;
    }

    console.log('Setting up prime input listeners...');
    const primeContainer = document.getElementById('prime-cards-container');
    if (!primeContainer) {
      console.log('Prime container not found');
      return;
    }

    // Gestionnaire unifié pour tous les types d'inputs
    primeContainer.addEventListener('change', function(event) {
      if (event.target.classList.contains('prime-input')) {
        console.log('Prime input changed:', event.target.dataset.primeSlug);
        // Mise à jour immédiate pour le feedback visuel
        const value = event.target.type === 'checkbox' ? (event.target.checked ? 1 : 0) : parseFloat(event.target.value) || 0;
        updatePrimeDisplayImmediate(event.target.dataset.primeSlug, value, event.target.getAttribute('data-input-type'));
        debouncedUpdate();
      }
    });

    primeContainer.addEventListener('input', function(event) {
      if (event.target.classList.contains('prime-input') && event.target.type !== 'checkbox') {
        console.log('Prime input typing:', event.target.dataset.primeSlug);
        // Mise à jour immédiate pour le feedback visuel
        const value = parseFloat(event.target.value) || 0;
        updatePrimeDisplayImmediate(event.target.dataset.primeSlug, value, event.target.getAttribute('data-input-type'));
        debouncedUpdate();
      }
    });

    // Gestionnaire pour la touche Enter
    primeContainer.addEventListener('keydown', function(event) {
      if (event.key === 'Enter' && event.target.classList.contains('prime-input')) {
        console.log('Enter pressed on:', event.target.dataset.primeSlug);
        event.preventDefault(); // Empêche la soumission du formulaire

        // Force la mise à jour immédiate
        if (event.target.type !== 'checkbox') {
          const value = parseFloat(event.target.value) || 0;
          updatePrimeDisplayImmediate(event.target.dataset.primeSlug, value, event.target.getAttribute('data-input-type'));
        }

        // Déclenche la mise à jour sans délai
        clearTimeout(debounceTimer);
        updateAllPrimes();

        // Déplace le focus au prochain input
        const inputs = Array.from(primeContainer.querySelectorAll('.prime-input'));
        const currentIndex = inputs.indexOf(event.target);
        if (currentIndex < inputs.length - 1) {
          inputs[currentIndex + 1].focus();
        }
      }
    });

    // Marquer comme initialisé
    window.primeListenersInitialized = true;
    console.log('Prime listeners successfully initialized');
  }

  // Fonction debounced pour éviter trop d'appels
  const debouncedUpdate = (function() {
    let timeoutId;
    return function() {
      clearTimeout(timeoutId);
      timeoutId = setTimeout(() => {
        updatePrimeInputs();
      }, 100); // Réduit à 100ms pour une réactivité maximale
    };
  })();

  // Mise à jour immédiate de l'affichage (sans attendre le serveur)
  function updatePrimeDisplayImmediate(primeSlug, value, inputType = null) {
    const primeCard = document.querySelector(`[data-prime-slug="${primeSlug}"]`);
    if (!primeCard) return;

    // Chercher l'élément d'affichage du montant (plusieurs classes possibles)
    const amountElement = primeCard.querySelector('.calculated-amount, .calculated-result, .prime-result');
    if (!amountElement) {
      console.log('Aucun élément de résultat trouvé pour:', primeSlug);
      return;
    }

    // Calcul d'estimation immédiate côté client
    let estimatedAmount = 0;

    if (value > 0) {
      // Estimation simple basée sur des règles générales Flandre
      if (primeSlug.includes('isolation')) {
        estimatedAmount = Math.min(value * 0.5, 5000); // 50% jusqu'à 5000€
      } else if (primeSlug === 'ramen_deuren') {
        estimatedAmount = Math.min(value * 0.5, 2500); // Châssis/portes
      } else if (primeSlug === 'warmtepompboiler') {
        estimatedAmount = 1200; // Forfait fixe
      } else {
        estimatedAmount = Math.min(value * 0.4, 3000); // Estimation générale
      }
    }

    // Mise à jour immédiate de l'affichage
    amountElement.textContent = `${estimatedAmount.toLocaleString('fr-BE')} €`;
    amountElement.classList.add('updating');
    amountElement.style.background = 'linear-gradient(45deg, #e8f5e8, #d4edda)';
    amountElement.style.transition = 'all 0.3s ease';

    // Retirer l'indicateur après la vraie mise à jour serveur
    setTimeout(() => {
      amountElement.classList.remove('updating');
      amountElement.style.background = '';
    }, 2000);

    // Mettre à jour le total immédiatement aussi
    updateTotalImmediate();
  }

  // Mise à jour immédiate du total
  function updateTotalImmediate() {
    // Chercher tous les éléments de montants (plusieurs classes possibles)
    const amountElements = document.querySelectorAll('.calculated-amount, .calculated-result, .prime-result');
    let total = 0;

    amountElements.forEach(element => {
      const value = parseFloat(element.textContent.replace(/[^\d,]/g, '').replace(',', '.')) || 0;
      total += value;
    });

    // Chercher l'élément total (plusieurs sélecteurs possibles)
    const totalElement = document.querySelector('#total-simule-amount, .total-amount, [data-total-amount]');
    if (totalElement) {
      totalElement.textContent = `${total.toLocaleString('fr-BE')} €`;
      totalElement.style.background = 'linear-gradient(45deg, #e8f5e8, #d4edda)';
      totalElement.style.transition = 'all 0.3s ease';

      setTimeout(() => {
        totalElement.style.background = '';
      }, 2000);

      console.log('💰 Total mis à jour:', total, '€');
    } else {
      console.log('❌ Élément total non trouvé');
    }
  }

  function updatePrimeInputs() {
    console.log('updatePrimeInputs called - optimized version');

    // Vérifier si une mise à jour est déjà en cours
    if (window.updateInProgress) {
      console.log('Update already in progress, skipping...');
      return;
    }
    window.updateInProgress = true;

    // Collecter toutes les saisies de manière optimisée
    const userInputs = {};
    const primeInputs = document.querySelectorAll('#prime-cards-container .prime-input');

    console.log(`Found ${primeInputs.length} prime inputs`);

    primeInputs.forEach(input => {
      const slug = input.dataset.primeSlug;
      if (!slug) return;

      if (input.type === 'checkbox') {
        userInputs[slug] = input.checked ? 1 : 0;
      } else {
        const value = parseFloat(input.value) || 0;
        userInputs[slug] = value;
      }
    });

    console.log('Collected user inputs:', Object.keys(userInputs).length, 'items');

    // Afficher un indicateur de chargement
    showLoadingIndicator();

    // Envoyer les saisies au serveur avec gestion d'erreur améliorée
    fetch(`/simulations/${simulationId}/update_prime_inputs`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
        'Accept': 'application/json'
      },
      body: JSON.stringify({ user_inputs: userInputs })
    })
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('Server response received:', data);
      if (data.success) {
        updatePrimeCards(data.updated_cards);
        updateTotalAmount(data.total_amount);
        console.log('UI updated successfully');
      } else {
        console.error('Server returned error:', data);
      }
    })
    .catch(error => {
      console.error('Erreur lors de la mise à jour:', error);
      showErrorIndicator();
    })
    .finally(() => {
      hideLoadingIndicator();
      window.updateInProgress = false;
    });
  }

  function updatePrimeCards(updatedCards) {
    console.log('Updating prime cards - optimized version');
    if (!updatedCards) {
      console.log('No updated cards data received');
      return;
    }

    // Utiliser un fragment de document pour les mises à jour en lot
    const updates = [];

    Object.keys(updatedCards).forEach(categoryName => {
      const categoryData = updatedCards[categoryName];
      if (categoryData.primes) {
        categoryData.primes.forEach(prime => {
          const primeCard = document.querySelector(`[data-prime-slug="${prime.slug}"]`);
          if (primeCard) {
            const amountElement = primeCard.querySelector('.calculated-amount');
            if (amountElement) {
              const newAmount = formatCurrency(prime.calculated_amount);
              if (amountElement.textContent !== newAmount) {
                updates.push({
                  element: amountElement,
                  newValue: newAmount,
                  primeSlug: prime.slug
                });
              }
            }
          }
        });

        // Mettre à jour le total de la catégorie
        updateCategoryTotal(categoryName, categoryData);
      }
    });

    // Appliquer toutes les mises à jour en une fois
    console.log(`Applying ${updates.length} UI updates`);
    updates.forEach(update => {
      // Supprimer l'indicateur de mise à jour immédiate
      update.element.classList.remove('updating');
      update.element.style.opacity = '1';

      update.element.textContent = update.newValue;
      // Ajouter un effet visuel léger pour indiquer le changement
      update.element.classList.add('amount-updated');
      setTimeout(() => {
        update.element.classList.remove('amount-updated');
      }, 1500);
    });

    console.log('Prime cards updated successfully');
  }

  // Fonctions d'indicateurs visuels
  function showLoadingIndicator() {
    const totalElement = document.getElementById('total-amount-sidebar');
    if (totalElement) {
      totalElement.style.opacity = '0.6';
      totalElement.style.pointerEvents = 'none';
    }
  }

  function hideLoadingIndicator() {
    const totalElement = document.getElementById('total-amount-sidebar');
    if (totalElement) {
      totalElement.style.opacity = '1';
      totalElement.style.pointerEvents = 'auto';
    }
  }

  function showErrorIndicator() {
    // Afficher brièvement une indication d'erreur
    const totalElement = document.getElementById('total-amount-sidebar');
    if (totalElement) {
      const originalColor = totalElement.style.color;
      totalElement.style.color = '#dc3545';
      setTimeout(() => {
        totalElement.style.color = originalColor;
      }, 2000);
    }
  }

  function updateCategoryTotal(categoryName, categoryData) {
    const categoryTotal = categoryData.total || 0;
    const formattedTotal = formatCurrency(categoryTotal);

    console.log(`Updating category total for ${categoryName}: ${formattedTotal}`);

    // Mettre à jour le total dans l'en-tête de la carte de catégorie
    const categoryCard = document.querySelector(`[data-category="${categoryName}"]`);
    if (categoryCard) {
      const categoryTotalElement = categoryCard.querySelector('.category-total');
      if (categoryTotalElement) {
        categoryTotalElement.textContent = formattedTotal;
        console.log(`Updated category header total for ${categoryName}`);
      }
    }

    // Mettre à jour le total dans la sidebar
    const sidebarCategoryElement = document.querySelector(`[data-sidebar-category="${categoryName}"]`);
    if (sidebarCategoryElement) {
      const sidebarTotalElement = sidebarCategoryElement.querySelector('.sidebar-category-total');
      if (sidebarTotalElement) {
        sidebarTotalElement.textContent = formattedTotal;
        console.log(`Updated sidebar total for ${categoryName}`);
      }
    }
  }

  function updateTotalAmount(totalAmount) {
    const totalElement = document.getElementById('total-amount');
    const totalSidebarElement = document.getElementById('total-amount-sidebar');

    const formattedAmount = formatCurrency(totalAmount);

    if (totalElement) {
      totalElement.textContent = formattedAmount;
    }
    if (totalSidebarElement) {
      totalSidebarElement.textContent = formattedAmount;
    }
  }

  function formatCurrency(amount) {
    return new Intl.NumberFormat('fr-BE', {
      style: 'currency',
      currency: 'EUR',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(amount || 0);
  }

  // Calcul initial du total
  function calculateInitialTotal() {
    const primeCards = document.querySelectorAll('.prime-card');
    let total = 0;

    primeCards.forEach(card => {
      const amountElement = card.querySelector('.calculated-amount');
      if (amountElement) {
        // Extrait le montant en gérant le format français (ex: "20 000,00 €")
        const amountText = amountElement.textContent
          .replace(/€/g, '')                    // Enlever le symbole €
          .replace(/\s/g, '')                   // Enlever les espaces
          .replace(/,/g, '.');                  // Remplacer virgule par point
        const amount = parseFloat(amountText) || 0;
        total += amount;
      }
    });

    updateTotalAmount(total);
  }

  // Styles CSS pour les indicateurs visuels
  if (!document.getElementById('prime-styles')) {
    const primeStyles = document.createElement('style');
    primeStyles.id = 'prime-styles';
    primeStyles.textContent = `
      .amount-updated {
        background-color: rgba(40, 167, 69, 0.1);
        border-radius: 4px;
        transition: background-color 0.3s ease;
      }

      .prime-input:focus {
        border-color: #007bff;
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
      }

      #total-amount-sidebar {
        transition: opacity 0.3s ease, color 0.3s ease;
      }
    `;
    document.head.appendChild(primeStyles);
  }

  // ==========================================
  // GESTION ÉLIGIBILITÉ BRUXELLES
  // ==========================================
  <% if @simulation.region&.downcase == 'bruxelles' %>
    const checkEligibilityBtnBruxelles = document.getElementById('check-eligibility-btn-bruxelles');
    const eligibilityStatusBruxelles = document.getElementById('eligibility-status');

    if (checkEligibilityBtnBruxelles) {
      checkEligibilityBtnBruxelles.addEventListener('click', function() {
        console.log('🎯 Vérification éligibilité Bruxelles lancée');
        checkBruxellesEligibility();
      });
    }

    function checkBruxellesEligibility() {
      // Désactiver le bouton pendant la vérification
      checkEligibilityBtnBruxelles.disabled = true;
      checkEligibilityBtnBruxelles.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Vérification en cours...';

      // Récupérer l'ID de la simulation
      const simulationId = '<%= @simulation.id %>';

      // Appel Ajax au service d'éligibilité Rails
      fetch(`/simulations/${simulationId}/check_eligibility`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          region: 'bruxelles'
        })
      })
      .then(response => response.json())
      .then(data => {
        console.log('📋 Résultat éligibilité Bruxelles:', data);
        displayBruxellesEligibilityResult(data);
      })
      .catch(error => {
        console.error('❌ Erreur lors de la vérification:', error);
        displayBruxellesErrorResult();
      })
      .finally(() => {
        // Réactiver le bouton
        checkEligibilityBtnBruxelles.disabled = false;
        checkEligibilityBtnBruxelles.innerHTML = '<i class="bi bi-shield-check me-2"></i>Vérifier l\'éligibilité Bruxelles';
      });
    }

    function displayBruxellesEligibilityResult(data) {
      let alertClass, iconClass, title, description;

      if (data.eligible) {
        alertClass = 'alert-success';
        iconClass = 'bi-check-circle-fill';
        title = '✅ Votre demande est éligible !';
        description = 'Vous remplissez les conditions pour bénéficier des primes RENOLUTION de Bruxelles-Capitale.';

        // Masquer le bouton si éligible
        checkEligibilityBtnBruxelles.style.display = 'none';

        // Déclencher automatiquement l'étape suivante si définie
        if (data.next_step) {
          setTimeout(() => {
            console.log('🎯 Déclenchement automatique étape suivante:', data.next_step);
            triggerBruxellesNextStep(data.next_step);
          }, 2000);
        }
      } else {
        alertClass = 'alert-danger';
        iconClass = 'bi-x-circle-fill';
        title = '❌ Votre demande n\'est pas éligible';
        description = 'Certaines conditions ne sont pas remplies pour les primes RENOLUTION Bruxelles.';
      }

      // Construire le HTML du résultat
      const resultHTML = `
        <div class="alert ${alertClass} d-flex align-items-center" role="alert">
          <i class="bi ${iconClass} me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">${title}</h6>
            <p class="mb-0">${description}</p>
            ${data.message ? `<small class="text-muted">Détails : ${data.message}</small>` : ''}
          </div>
        </div>
      `;

      // Mettre à jour le DOM
      eligibilityStatusBruxelles.innerHTML = resultHTML;

      // Animation d'apparition
      eligibilityStatusBruxelles.style.opacity = '0';
      setTimeout(() => {
        eligibilityStatusBruxelles.style.transition = 'opacity 0.5s';
        eligibilityStatusBruxelles.style.opacity = '1';
      }, 100);
    }

    function displayBruxellesErrorResult() {
      const errorHTML = `
        <div class="alert alert-warning d-flex align-items-center" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">⚠️ Erreur technique</h6>
            <p class="mb-0">Une erreur s'est produite lors de la vérification. Veuillez réessayer.</p>
          </div>
        </div>
      `;

      eligibilityStatusBruxelles.innerHTML = errorHTML;
    }

    function triggerBruxellesNextStep(step) {
      // Déclencher l'étape suivante selon le résultat
      if (step === 'category') {
        // Appel pour calculer la catégorie automatiquement
        fetch(`/simulations/${simulationId}/calculate_category`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
            'Accept': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          console.log('📊 Catégorie calculée:', data);
          // Actualiser la page pour afficher les résultats
          setTimeout(() => {
            window.location.reload();
          }, 1000);
        })
        .catch(error => {
          console.error('❌ Erreur calcul catégorie:', error);
        });
      }
    }
  <% end %>

});
</script>

<style>
/* Styles pour les indicateurs de mise à jour */
.calculated-amount.updating {
  transition: opacity 0.3s ease;
}

.calculated-amount.amount-updated {
  animation: highlight 1.5s ease;
}

@keyframes highlight {
  0% { background-color: #e3f2fd; }
  50% { background-color: #bbdefb; }
  100% { background-color: transparent; }
}

/* Indicateur de chargement pour les primes */
.loading-indicator {
  opacity: 0.6;
  pointer-events: none;
}

.loading-indicator::after {
  content: "⏳";
  position: absolute;
  top: 50%;
  right: 10px;
  transform: translateY(-50%);
}
</style>
