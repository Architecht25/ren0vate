<div class="container-fluid px-4 py-4">
  <!-- Header avec actions -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-calculator"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal"><%= @simulation.titre %></h1>
    </div>
    <div>
      <%= link_to edit_simulation_path(@simulation), class: "btn btn-outline-primary-custom me-2" do %>
        <i class="bi bi-pencil me-2"></i>Modifier
      <% end %>
      <%= link_to simulations_path, class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Colonne principale -->
    <div class="col-lg-8">
      <!-- Récapitulatif simulation -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-info-circle me-2"></i>Détails de la simulation
          </h5>

          <div class="row mb-3">
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label text-muted-custom small">Titre</label>
                <p class="mb-0 fs-5"><%= @simulation.titre %></p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="mb-3">
                <label class="form-label text-muted-custom small">Région</label>
                <p class="mb-0"><%= @simulation.region.capitalize if @simulation.region.present? %></p>
              </div>
            </div>
          </div>

          <% if @simulation.property.present? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Bien associé</label>
              <div class="d-flex align-items-center">
                <div class="icon-circle me-3" style="width: 32px; height: 32px; font-size: 14px;">
                  <i class="bi bi-house-door"></i>
                </div>
                <div>
                  <p class="mb-0"><%= @simulation.property.respond_to?(:address) ? @simulation.property.address : "#{@simulation.property.rue} #{@simulation.property.numero}" %></p>
                </div>
              </div>
            </div>
          <% end %>

          <% if @simulation.parameters.present? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Paramètres</label>
              <p class="mb-0"><%= @simulation.parameters %></p>
            </div>
          <% end %>

          <% if @simulation.result.present? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Résultat</label>
              <p class="mb-0"><%= @simulation.result %></p>
            </div>
          <% end %>

          <% if @simulation.source.present? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom small">Source</label>
              <p class="mb-0"><%= @simulation.source %></p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Liste des primes -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-cash-coin me-2"></i>Primes éligibles
          </h5>

          <% if @simulation.simulation_prime_cards.any? %>
            <div class="list-group mb-3">
              <% @simulation.simulation_prime_cards.each do |prime_card| %>
                <div class="list-group-item border-0 bg-light-custom mb-3 rounded">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <h6 class="mb-1"><%= prime_card.prime.nom if prime_card.prime.respond_to?(:nom) %></h6>
                      <p class="text-muted-custom mb-2 small"><%= prime_card.prime.description if prime_card.prime.respond_to?(:description) %></p>
                    </div>
                    <span class="badge bg-primary-custom rounded-pill px-3 py-2 fs-6">
                      <%= number_to_currency(prime_card.montant, unit: "€", separator: ",", delimiter: " ", format: "%n %u") if prime_card.respond_to?(:montant) %>
                    </span>
                  </div>
                  <% if prime_card.prime.respond_to?(:conditions) && prime_card.prime.conditions.present? %>
                    <div class="mt-2 pt-2 border-top">
                      <p class="mb-0 small"><i class="bi bi-info-circle me-2"></i><%= prime_card.prime.conditions %></p>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>

            <!-- Total -->
            <div class="bg-light-custom p-3 rounded">
              <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Total des primes</h5>
                <% total = @simulation.simulation_prime_cards.sum(&:montant) rescue 0 %>
                <h4 class="text-primary-custom mb-0">
                  <%= number_to_currency(total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                </h4>
              </div>
            </div>
          <% else %>
            <div class="text-center py-4">
              <p class="text-muted-custom mb-0">Aucune prime calculée pour cette simulation</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Colonne latérale -->
    <div class="col-lg-4">
      <!-- Documents -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="card-title text-primary-custom mb-0">
              <i class="bi bi-file-earmark-text me-2"></i>Documents
            </h5>
            <%= link_to "#", class: "btn btn-sm btn-primary-custom" do %>
              <i class="bi bi-upload me-1"></i>Ajouter
            <% end %>
          </div>

          <% if @simulation.documents.present? && @simulation.documents.any? %>
            <div class="list-group">
              <% @simulation.documents.each do |doc| %>
                <a href="#" class="list-group-item list-group-item-action d-flex align-items-center">
                  <i class="bi bi-file-earmark me-3"></i>
                  <div>
                    <h6 class="mb-1"><%= doc.name if doc.respond_to?(:name) %></h6>
                    <p class="text-muted-custom mb-0 small"><%= doc.created_at.strftime("%d/%m/%Y") if doc.respond_to?(:created_at) %></p>
                  </div>
                </a>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-3">
              <p class="text-muted-custom mb-0">Aucun document ajouté</p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Actions rapides -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-lightning-charge me-2"></i>Actions rapides
          </h5>
          <div class="d-grid gap-2">
            <%= link_to "#", class: "btn btn-outline-primary-custom mb-2" do %>
              <i class="bi bi-file-earmark-pdf me-2"></i>Exporter en PDF
            <% end %>
            <% if @simulation.request.nil? %>
              <%= link_to "#", class: "btn btn-primary-custom mb-2" do %>
                <i class="bi bi-check-circle me-2"></i>Faire une demande
              <% end %>
            <% else %>
              <%= link_to "#", class: "btn btn-outline-success mb-2" do %>
                <i class="bi bi-eye me-2"></i>Voir ma demande
              <% end %>
            <% end %>
            <%= link_to "#", class: "btn btn-outline-primary-custom" do %>
              <i class="bi bi-share me-2"></i>Partager par email
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
