      </div>
    <% when 'bruxelles' %>
      <%
        # Détecter si c'est une simulation d'entreprise
        is_enterprise_simulation = @simulation.project&.investment? ||
                                 params[:type] == 'entreprise'
      %>

      <% if is_enterprise_simulation %>
