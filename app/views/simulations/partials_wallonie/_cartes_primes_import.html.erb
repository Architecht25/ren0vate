<!-- Section Primes Wallonie - 10 cartes permanentes -->
<div data-controller="wallonie-prime-calcul">
  <h4 class="mb-3">
    <i class="bi bi-calculator text-primary me-2"></i>
    <span data-wallonie-prime-calcul-target="sectionTitle">
      Vos primes Wallonie - Toutes catégories R1 à R5
    </span>
  </h4>
  <p class="text-muted small mb-4">
    💡 Les montants s'ajustent automatiquement selon votre catégorie de revenus
  </p>

  <div class="row g-3">
        <!-- CARTE 1: AUDIT - Simple (1 input) -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <div class="card border-0 shadow h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_realisation_audit_logement">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-search fs-5 text-info"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Audit énergétique</h6>
                  <small class="text-muted">Forfaitaire</small>
                </div>
              </div>

              <!-- Input simple: Oui/Non (0 ou 1) -->
              <div class="mb-3">
                <label class="form-label small">Réalisation d'un audit :</label>
                <select class="form-select"
                        data-wallonie-prime-card-target="inputAudit"
                        data-action="change->wallonie-prime-card#calculateAudit">
                  <option value="0">Non</option>
                  <option value="1">Oui</option>
                </select>
              </div>

              <!-- Résultat -->
              <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">Prime calculée :</span>
                <span class="badge bg-info fs-6" data-wallonie-prime-card-target="resultAudit">
                  0 €
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- CARTE 2: TOITURE - Complexe (5 inputs) -->
