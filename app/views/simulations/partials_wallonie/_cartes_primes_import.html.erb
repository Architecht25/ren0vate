                  <i class="bi bi-house-door fs-5 text-warning"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Travaux Toiture</h6>
                  <small class="text-muted">5 types de primes</small>
                </div>
              </div>

              <div class="row g-3">
                <!-- Remplacement couverture -->
                <div class="col-md-6">
                  <label class="form-label small">Remplacement couverture (m²) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number"
                           class="form-control"
                           placeholder="Surface m²"
                           data-wallonie-prime-card-target="inputCouverture"
                           data-action="input->wallonie-prime-card#calculateToiture">
                    <span class="input-group-text bg-warning text-white"
                          data-wallonie-prime-card-target="resultCouverture">0 €</span>
                  </div>
                </div>

                <!-- Appropriation charpente -->
                <div class="col-md-6">
                  <label class="form-label small">Appropriation charpente :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-wallonie-prime-card-target="inputCharpente"
                            data-action="change->wallonie-prime-card#calculateToiture">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-warning text-white"
                          data-wallonie-prime-card-target="resultCharpente">0 €</span>
                  </div>
                </div>

                <!-- Évacuation eaux pluviales -->
                <div class="col-md-6">
                  <label class="form-label small">Évacuation eaux pluviales :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-wallonie-prime-card-target="inputEvacuation"
                            data-action="change->wallonie-prime-card#calculateToiture">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-warning text-white"
                          data-wallonie-prime-card-target="resultEvacuation">0 €</span>
                  </div>
                </div>

                <!-- Isolation thermique -->
                <div class="col-md-6">
                  <label class="form-label small">Isolation thermique (m²) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number"
                           class="form-control"
                           placeholder="Surface m²"
                           data-wallonie-prime-card-target="inputIsolationThermique"
                           data-action="input->wallonie-prime-card#calculateToiture">
                    <span class="input-group-text bg-warning text-white"
                          data-wallonie-prime-card-target="resultIsolationThermique">0 €</span>
                  </div>
                </div>

                <!-- Isolation biosourcée -->
                <div class="col-md-12">
                  <label class="form-label small">Isolation biosourcée (m²) :</label>
                  <div class="input-group input-group-sm">
                    <input type="number"
                           class="form-control"
                           placeholder="Surface m²"
                           data-wallonie-prime-card-target="inputIsolationBiosource"
                           data-action="input->wallonie-prime-card#calculateToiture">
                    <span class="input-group-text bg-warning text-white"
                          data-wallonie-prime-card-target="resultIsolationBiosource">0 €</span>
                  </div>
                </div>
              </div>

              <!-- Total Toiture -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-warning">Total Toiture :</strong>
                  <span class="badge bg-warning fs-5" data-wallonie-prime-card-target="totalToiture">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

