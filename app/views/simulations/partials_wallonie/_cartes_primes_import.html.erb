          <div class="card border-0 shadow h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_realisation_audit_logement">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-search fs-5 text-info"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Audit énergétique</h6>
                  <small class="text-muted">Forfaitaire</small>
                </div>
              </div>

              <!-- Input simple: Oui/Non (0 ou 1) -->
              <div class="mb-3">
                <label class="form-label small">Réalisation d'un audit :</label>
                <select class="form-select"
                        data-wallonie-prime-card-target="inputAudit"
                        data-action="change->wallonie-prime-card#calculateAudit">
                  <option value="0">Non</option>
                  <option value="1">Oui</option>
                </select>
              </div>
                <!-- Informations de la prime -->
                <% condition_text = condition_prime("wallonie_realisation_audit_logement") %>
                <% conseil_text = conseil_prime("wallonie_realisation_audit_logement") %>
                <% if condition_text.present? || conseil_text.present? %>
                  <div class="mt-1">
                    <% if condition_text.present? %>
                      <div class="mb-1">
                        <small class="text-muted">
                          <i class="bi bi-info-circle me-1"></i>
                          <%= condition_text %>
                        </small>
                      </div>
                    <% end %>
                    <% if conseil_text.present? %>
                      <div>
                        <small class="text-success">
                          <i class="bi bi-lightbulb me-1"></i>
                          <%= conseil_text %>
                        </small>
                      </div>
                    <% end %>
                  </div>
                <% end %>


