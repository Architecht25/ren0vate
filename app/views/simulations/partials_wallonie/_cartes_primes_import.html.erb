<%
# Helpers pour accéder aux informations des primes Wallonie
def condition_prime(slug)
  prime = Prime.find_by(slug: slug)
  prime&.condition || ""
end

def conseil_prime(slug)
  prime = Prime.find_by(slug: slug)
  prime&.conseil || ""
end
