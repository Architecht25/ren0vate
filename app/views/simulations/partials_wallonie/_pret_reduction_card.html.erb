<%# Nouveau régime wallon (dès le 01/10/2026) — réduction du solde d'un prêt bonifié
    (Rénopack/Rénoprêt), plus de calcul poste par poste. Voir Regions::Wallonie::PretReduction. %>
<% peb_label = @simulation.property&.peb_donnees&.avant_travaux&.order(created_at: :desc)&.first&.label_peb %>

<div class="card border-0 shadow mb-4" data-controller="wallonie-pret-reduction"
     data-wallonie-pret-reduction-simulation-id-value="<%= @simulation.id %>"
     style="<%= @simulation.eligible? ? '' : 'display: none;' %>">
  <div class="card-header" style="background-color: var(--ren0vate-background-light); border-bottom: 1px solid var(--ren0vate-border);">
    <h5 class="card-title mb-1">
      <i class="bi bi-bank2 me-2" style="color: var(--ren0vate-primary);"></i>
      Étape 3 : Réduction de votre prêt bonifié
    </h5>
    <p class="text-muted small mb-0">
      Depuis le 1er octobre 2026, les primes wallonnes prennent la forme d'une réduction du solde
      à rembourser sur un prêt Rénopack (0%) ou Rénoprêt, et non plus d'un versement direct.
    </p>
  </div>

  <div class="card-body p-4">
    <div class="alert alert-info d-flex align-items-start" role="alert">
      <i class="bi bi-info-circle me-3 fs-5"></i>
      <div>
        <strong>Label PEB actuel : <%= peb_label || "non renseigné" %></strong>
        <p class="mb-0 small">Ce montant est une réduction de dette, pas un versement sur votre compte.
          L'enveloppe budgétaire annuelle définitive n'est fixée qu'après le conclave budgétaire
          wallon de la rentrée 2026 — considérez ce calcul comme indicatif.</p>
      </div>
    </div>

    <div class="row g-3 align-items-end">
      <div class="col-md-6">
        <label for="montant_projet" class="form-label">Montant global du projet de rénovation</label>
        <div class="input-group">
          <input type="number" id="montant_projet" min="0" step="100" class="form-control"
                 placeholder="Ex: 35000"
                 value="<%= @simulation.montant_projet_saisi %>"
                 data-wallonie-pret-reduction-target="montantProjet"
                 data-action="input->wallonie-pret-reduction#montantChanged">
          <span class="input-group-text">€</span>
        </div>
        <% is_appartement = @simulation.property&.type_bien_wallonie == "appartement_studio" %>
        <small class="text-muted">
          Plafonné à <%= number_to_currency(@simulation.plafond_emprunt_saisi || (is_appartement ? 60_000 : 75_000), unit: '€', separator: ',', delimiter: ' ', precision: 0) %>
          pour <%= is_appartement ? "un appartement/studio" : "une maison unifamiliale" %>.
        </small>

        <div class="form-check mt-2">
          <input type="checkbox" class="form-check-input" id="ecomateriaux"
                 <%= "checked" if @simulation.ecomateriaux_saisi %>
                 data-wallonie-pret-reduction-target="ecomateriaux"
                 data-action="change->wallonie-pret-reduction#montantChanged">
          <label class="form-check-label small" for="ecomateriaux">
            Utilisation d'écomatériaux (+5 points de réduction sur le solde)
          </label>
        </div>
      </div>

      <div class="col-md-6">
        <div class="rounded-3 p-3 text-center" style="background-color: var(--ren0vate-background-light); border: 1px solid var(--ren0vate-border);">
          <h3 class="fw-bold mb-1" style="color: var(--ren0vate-primary);" data-wallonie-pret-reduction-target="reductionSolde">
            <%= number_to_currency(@simulation.total_simule || 0, unit: '€', separator: ',', delimiter: ' ', precision: 0) %>
          </h3>
          <p class="text-muted small mb-0">Réduction du solde à rembourser</p>
        </div>
      </div>
    </div>

    <div class="row g-3 mt-3 text-center">
      <div class="col-md-3">
        <div class="border rounded-3 p-2">
          <div class="text-muted small">Montant retenu (plafonné)</div>
          <div class="fw-bold" data-wallonie-pret-reduction-target="montantRetenu">
            <%= number_to_currency(@simulation.montant_projet_retenu_saisi, unit: '€', separator: ',', delimiter: ' ', precision: 0) %>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="border rounded-3 p-2">
          <div class="text-muted small">Plafond d'emprunt</div>
          <div class="fw-bold"><%= number_to_currency(@simulation.plafond_emprunt_saisi || 75_000, unit: '€', separator: ',', delimiter: ' ', precision: 0) %></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="border rounded-3 p-2">
          <div class="text-muted small">Taux de réduction</div>
          <div class="fw-bold" data-wallonie-pret-reduction-target="tauxReduction">
            <%= number_to_percentage((@simulation.taux_reduction_saisi || 0) * 100, precision: 0) %>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="border rounded-3 p-2">
          <div class="text-muted small">Taux d'intérêt du prêt</div>
          <div class="fw-bold" data-wallonie-pret-reduction-target="tauxInteret">
            <%= @simulation.taux_interet_label_saisi || "0%" %>
          </div>
        </div>
      </div>
    </div>
    <p class="text-muted small mt-2 mb-0">
      Taux de réduction indicatif : <%= number_to_percentage((@simulation.taux_reduction_base_saisi || 0) * 100, precision: 0) %>
      selon votre tranche de revenu<%= " + 5 points écomatériaux" if @simulation.ecomateriaux_saisi %>.
      Le taux d'intérêt réel du prêt (0% ou réduit) dépend de votre tranche de revenu et est fixé par la SWCS.
    </p>

    <% if @simulation.project.present? %>
      <hr class="my-3">
      <% if @simulation.project.pret_wallonie_dossier.present? %>
        <%= link_to "Suivre ma demande de prêt", project_pret_wallonie_dossier_path(@simulation.project), class: "btn btn-primary" %>
      <% else %>
        <%= button_to "Démarrer le suivi de ma demande", project_pret_wallonie_dossier_path(@simulation.project),
              method: :post, class: "btn btn-primary" %>
        <p class="text-muted small mt-1 mb-0">Passe à la préparation de ton dossier : pièces justificatives, dépôt auprès de la SWCS et suivi jusqu'à la clôture.</p>
      <% end %>
    <% end %>
  </div>
</div>
