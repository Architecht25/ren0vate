<!-- ÉTAPE 3: Cartes primes interactives Wallonie (seulement si catégorie définie) -->
<div class="card border-0 shadow-sm mb-4 wallonie-primes" id="primes-step" style="<%= @simulation.respond_to?(:category) && @simulation.category.present? ? '' : 'display: none;' %>">
  <div class="card-body p-4">
    <h5 class="card-title text-primary-custom mb-3">
      <i class="bi bi-credit-card me-2"></i>Étape 3 : Primes disponibles (Wallonie)
    </h5>

    <div id="primes-status">
      <%
        prime_cards = {}
        total_amount = 0
        if @simulation.parameters.present?
          begin
            parsed_params = JSON.parse(@simulation.parameters)
            prime_cards = parsed_params['prime_cards'] || {}
            total_amount = parsed_params['total_general'] || 0
          rescue JSON::ParserError
            prime_cards = {}
            total_amount = 0
          end
        end
      %>

      <% if prime_cards.any? %>
        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
          <i class="bi bi-check-circle-fill me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">✅ Primes Wallonie calculées !</h6>
            <p class="mb-0">Personnalisez vos travaux selon les critères Wallonie et voyez le montant des primes en temps réel.</p>
          </div>
        </div>

        <!-- Cartes de primes compactes - Design moderne -->
        <div id="prime-cards-container">
          <% prime_cards.each do |category_name, category_data| %>
            <% next unless category_data['primes']&.any? %>

            <!-- En-tête de catégorie subtil mais visible -->
            <div class="d-flex align-items-center justify-content-between mb-3 p-3 rounded-3"
                 data-group="<%= category_name %>"
                 style="background: linear-gradient(135deg, #f8f9fc 0%, #e9ecef 100%); border-left: 4px solid #dc3545;">
              <div class="d-flex align-items-center">
                <div class="me-3" style="width: 36px; height: 36px; border-radius: 10px; background: #dc3545; display: flex; align-items: center; justify-content: center;">
                  <i class="bi bi-<%= category_data['icon'] || 'house-gear' %>" style="color: white; font-size: 18px;"></i>
                </div>
                <div>
                  <h6 class="mb-0 fw-bold text-dark" style="font-size: 17px;"><%= category_data['title'] || category_name.humanize %></h6>
                  <small class="text-muted" style="font-size: 13px;"><%= category_data['primes'].count %> prime<%= 's' if category_data['primes'].count > 1 %> disponible<%= 's' if category_data['primes'].count > 1 %></small>
                </div>
              </div>
              <div class="text-end">
                <span class="badge bg-success text-white fw-bold group-total" style="font-size: 15px; padding: 10px 14px; border-radius: 8px;">
                  <%
                    category_total = category_data['primes'].sum { |p| p['calculated_amount'] || 0 }
                  %>
                  <%= number_to_currency(category_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                </span>
                <div class="mt-1">
                  <small class="text-muted fw-medium" style="font-size: 11px;">Total catégorie</small>
                </div>
              </div>
            </div>

            <!-- Grille de cartes primes compactes -->
            <div class="row g-3 mb-5">
              <% category_data['primes'].each_with_index do |prime, index| %>
                <div class="col-lg-4 col-md-6">
                  <%
                    # Couleurs pastels pour les icônes (couleurs Wallonie)
                    colors = [
                      { light: '#fef2f2', dark: '#dc3545' },  # rouge wallonie
                      { light: '#fffbeb', dark: '#f59e0b' },  # orange
                      { light: '#f0f9ff', dark: '#0ea5e9' },  # bleu
                      { light: '#f7fee7', dark: '#65a30d' },  # vert olive
                      { light: '#faf5ff', dark: '#8b5cf6' },  # violet
                      { light: '#f1f5f9', dark: '#64748b' }   # slate
                    ]
                    color = colors[index % colors.length]

                    # Icônes spécifiques par slug wallonie
                    icon = case prime['slug']
                           when /audit/ then 'search'
                           when /toiture/ then 'house-up'
                           when /mur/, /merule/, /radon/ then 'bricks'
                           when /sol/, /plancher/ then 'layers'
                           when /menuiserie/ then 'door-open'
                           when /electrique/ then 'lightning'
                           when /gaz/ then 'fire'
                           when /pac/, /chaudiere/, /chauffage/ then 'thermometer-half'
                           when /ventilation/, /vmc/ then 'wind'
                           when /ecs/ then 'droplet'
                           else 'house-gear'
                           end
                  %>

                  <div class="card border-0 shadow-sm h-100 prime-card"
                       data-prime-slug="<%= prime['slug'] %>"
                       data-calculated-amount="<%= prime['calculated_amount'] || 0 %>"
                       style="border-radius: 12px; transition: all 0.3s ease;">

                    <div class="card-body p-3">
                      <!-- Header horizontal avec icône colorée -->
                      <div class="d-flex align-items-center mb-3">
                        <div class="icon-container me-3"
                             style="width: 40px; height: 40px; border-radius: 8px;
                                    background: <%= color[:light] %>;
                                    display: flex; align-items: center; justify-content: center;">
                          <i class="bi bi-<%= icon %>"
                             style="color: <%= color[:dark] %>; font-size: 18px;"></i>
                        </div>
                        <div class="flex-grow-1">
                          <h6 class="mb-1 fw-semibold text-dark" style="font-size: 14px; line-height: 1.2;">
                            <%= prime['titre'] %>
                          </h6>
                          <span class="badge" style="background: <%= color[:light] %>;
                                                   color: <%= color[:dark] %>;
                                                   font-size: 10px;">WALLONIE</span>
                        </div>
                      </div>

                      <!-- Input section horizontale -->
                      <div class="d-flex align-items-center gap-2 mb-2">
                        <% case prime['input_type'] %>
                        <% when 'checkbox' %>
                          <div class="form-check form-switch flex-grow-1">
                            <input class="form-check-input prime-checkbox"
                                   type="checkbox"
                                   id="prime_<%= prime['slug'] %>"
                                   data-prime-slug="<%= prime['slug'] %>"
                                   data-input-type="checkbox"
                                   style="transform: scale(0.8);"
                                   <%= prime['user_input_value'] == 1 ? 'checked' : '' %>>
                            <label class="form-check-label" for="prime_<%= prime['slug'] %>" style="font-size: 12px;">
                              <%= prime['placeholder'] %>
                            </label>
                          </div>
                        <% when 'number' %>
                          <div class="flex-grow-1">
                            <input type="number"
                                   class="form-control form-control-sm prime-input"
                                   id="prime_<%= prime['slug'] %>"
                                   data-prime-slug="<%= prime['slug'] %>"
                                   data-input-type="number"
                                   placeholder="<%= prime['placeholder'] %>"
                                   value="<%= prime['user_input_value'] || 0 %>"
                                   min="0"
                                   step="any"
                                   style="border-radius: 6px; border: 1px solid #e3e6f0; font-size: 13px;">
                          </div>
                        <% else %>
                          <input type="text"
                                 class="form-control form-control-sm prime-input flex-grow-1"
                                 id="prime_<%= prime['slug'] %>"
                                 data-prime-slug="<%= prime['slug'] %>"
                                 data-input-type="text"
                                 placeholder="<%= prime['placeholder'] %>"
                                 value="<%= prime['user_input_value'] || '' %>"
                                 style="border-radius: 6px; border: 1px solid #e3e6f0; font-size: 13px;">
                        <% end %>

                        <!-- Résultat à droite -->
                        <div class="result-display">
                          <span class="badge bg-success calculated-result" style="font-size: 12px; min-width: 70px;">
                            <%= number_to_currency(prime['calculated_amount'] || 0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                          </span>
                        </div>
                      </div>

                      <!-- Détails de calcul (cachés par défaut) -->
                      <div class="calculation-details mt-2" style="display: none;">
                        <small class="text-muted"></small>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Récapitulatif par catégorie - Wallonie -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <h6 class="text-primary-custom mb-3">
              <i class="bi bi-list-check me-2"></i>Récapitulatif par catégorie (Wallonie)
            </h6>

            <div class="row g-3">
              <% prime_cards.each do |category_name, category_data| %>
                <% if category_data['primes']&.any? %>
                  <div class="col-sm-6" data-sidebar-category="<%= category_name %>">
                    <div class="d-flex justify-content-between align-items-center bg-light rounded px-3 py-2">
                      <span class="small text-muted">
                        <i class="bi bi-<%= category_data['icon'] || 'house-gear' %> me-1"></i>
                        <%= category_data['title'] || category_name.humanize %>
                      </span>
                      <span class="small fw-semibold text-primary sidebar-category-total">
                        <%
                          category_total = category_data['primes'].sum { |p| p['calculated_amount'] || 0 }
                        %>
                        <%= number_to_currency(category_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                      </span>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Total général final -->
        <div class="card border-0 mb-4" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);">
          <div class="card-body text-center text-white py-4">
            <h4 class="mb-2 fw-bold">
              <i class="bi bi-award me-2"></i>Total des primes Wallonie
            </h4>
            <h2 class="mb-0 total-amount fw-bold" style="font-size: 2.5rem;">
              <%= number_to_currency(total_amount, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
            </h2>
            <small class="text-white text-opacity-75 d-block mt-2">
              Montant estimatif des primes selon votre catégorie et vos travaux
            </small>
          </div>
        </div>

      <% else %>
        <div class="alert alert-warning d-flex align-items-center" role="alert">
          <i class="bi bi-exclamation-triangle me-3"></i>
          <div>
            <h6 class="alert-heading mb-1">⚠️ Primes Wallonie prêtes à calculer</h6>
            <p class="mb-0">Cliquez pour calculer les montants des primes disponibles selon votre catégorie Wallonie.</p>
            <small class="text-muted d-block mt-1">
              Calcul basé sur les tarifs et critères spécifiques à la région wallonne
            </small>
          </div>
        </div>

        <div class="mt-3">
          <button id="calculate-primes-btn" class="btn btn-primary-custom">
            <i class="bi bi-calculator me-2"></i>Calculer les primes Wallonie
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
