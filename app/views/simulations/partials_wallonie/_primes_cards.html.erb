<!-- ÉTAPE 3: Cartes primes interactives Wallonie (seulement si catégorie définie) -->
<div class="card border-0 shadow-sm mb-4" id="primes-step" style="<%= @simulation.respond_to?(:category) && @simulation.category.present? ? '' : 'display: none;' %>">
  <div class="card-body p-4">
    <h5 class="card-title text-primary-custom mb-3">
      <i class="bi bi-credit-card me-2"></i>Étape 3 : Primes disponibles (Wallonie)
    </h5>

    <div id="primes-status">
      <%
        prime_cards = {}
        total_amount = 0
        if @simulation.parameters.present?
          begin
            parsed_params = JSON.parse(@simulation.parameters)
            # Utiliser les nouvelles données prime_cards de notre implémentation Option A
            prime_cards = parsed_params['prime_cards'] || {}
            total_amount = parsed_params['total_general'] || 0
          rescue JSON::ParserError
            prime_cards = {}
            total_amount = 0
          end
        end
      %>

      <% if prime_cards.any? %>
        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
          <i class="bi bi-check-circle-fill me-3 fs-4"></i>
          <div>
            <h6 class="alert-heading mb-1">✅ Primes Wallonie calculées !</h6>
            <p class="mb-0">Personnalisez vos travaux et voyez le montant des primes en temps réel.</p>
          </div>
        </div>

        <!-- Cartes de primes organisées par catégorie -->
        <div id="prime-cards-container">
          <% prime_cards.each do |category_name, category_data| %>
            <% next unless category_data['primes']&.any? %>

            <div class="card border-0 shadow-sm mb-4 category-card" data-category="<%= category_name %>">
              <div class="card-header bg-gradient-primary text-white py-3 position-relative">
                <div class="d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center">
                    <div class="icon-circle me-3 bg-white bg-opacity-20">
                      <i class="bi bi-<%= category_data['icon'] || 'house-gear' %> text-white"></i>
                    </div>
                    <div>
                      <h5 class="mb-0 text-white fw-bold">
                        <%= category_data['title'] || category_name.humanize %>
                      </h5>
                      <small class="text-white text-opacity-75">
                        <%= category_data['primes'].count %> prime<%= 's' if category_data['primes'].count > 1 %> disponible<%= 's' if category_data['primes'].count > 1 %>
                      </small>
                    </div>
                  </div>
                  <div class="text-end">
                    <h4 class="mb-0 text-white fw-bold category-total">
                      <%
                        category_total = category_data['primes'].sum { |p| p['calculated_amount'] || 0 }
                      %>
                      <%= number_to_currency(category_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                    </h4>
                    <small class="text-white text-opacity-75">Total catégorie</small>
                  </div>
                </div>
              </div>
              <div class="card-body p-4">
                <div class="row g-4">
                  <% category_data['primes'].each_with_index do |prime, index| %>
                    <div class="col-lg-6">
                      <div class="prime-card card border h-100 position-relative overflow-hidden"
                           data-prime-slug="<%= prime['slug'] %>"
                           style="animation-delay: <%= (index * 0.1) %>s;">

                        <!-- Badge montant en position sticky -->
                        <div class="position-absolute top-0 end-0 m-3" style="z-index: 10;">
                          <span class="badge bg-success fs-6 px-3 py-2 calculated-amount shadow">
                            <%= number_to_currency(prime['calculated_amount'] || 0, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                          </span>
                        </div>

                        <div class="card-body p-4">
                          <!-- En-tête de la prime -->
                          <div class="mb-3">
                            <h6 class="text-primary fw-bold mb-2" style="padding-right: 80px;">
                              <%= prime['titre'] %>
                            </h6>
                            <% if prime['description'].present? %>
                              <p class="text-muted small mb-0">
                                <%= prime['description'] %>
                              </p>
                            <% end %>
                          </div>

                          <!-- Section d'input -->
                          <div class="prime-input-section mb-3">
                            <% case prime['input_type'] %>
                            <% when 'checkbox' %>
                              <div class="form-check form-switch">
                                <input class="form-check-input prime-input"
                                       type="checkbox"
                                       id="prime_<%= prime['slug'] %>"
                                       data-prime-slug="<%= prime['slug'] %>"
                                       <%= prime['user_input_value'] == 1 ? 'checked' : '' %>>
                                <label class="form-check-label fw-medium" for="prime_<%= prime['slug'] %>">
                                  <i class="bi bi-check-circle me-2 text-success"></i>
                                  Je réalise ces travaux
                                </label>
                              </div>
                            <% when 'number' %>
                              <div class="input-group">
                                <span class="input-group-text bg-light">
                                  <i class="bi bi-<%= prime['type'] == 'montant_m2' ? 'rulers' : 'currency-euro' %>"></i>
                                </span>
                                <input type="number"
                                       class="form-control prime-input"
                                       id="prime_<%= prime['slug'] %>"
                                       data-prime-slug="<%= prime['slug'] %>"
                                       placeholder="<%= prime['placeholder'] || 'Entrez la valeur' %>"
                                       value="<%= prime['user_input_value'] %>"
                                       step="0.01">
                                <% if prime['unite'].present? %>
                                  <span class="input-group-text bg-light text-muted">
                                    <%= prime['unite'] %>
                                  </span>
                                <% end %>
                              </div>
                              <div class="form-text">
                                <%= prime['type'] == 'montant_m2' ? 'Surface en m²' : 'Montant des travaux en €' %>
                              </div>
                            <% end %>
                          </div>

                          <!-- Conditions et conseils -->
                          <% if prime['conditions'].present? || prime['conseil'].present? %>
                            <div class="border-top pt-3">
                              <% if prime['conditions'].present? %>
                                <div class="alert alert-warning alert-sm py-2 mb-2">
                                  <i class="bi bi-exclamation-triangle me-2"></i>
                                  <small><strong>Conditions :</strong> <%= prime['conditions'] %></small>
                                </div>
                              <% end %>

                              <% if prime['conseil'].present? %>
                                <div class="alert alert-info alert-sm py-2 mb-0">
                                  <i class="bi bi-lightbulb me-2"></i>
                                  <small><strong>Conseil :</strong> <%= prime['conseil'] %></small>
                                </div>
                              <% end %>
                            </div>
                          <% end %>
                        </div>

                        <!-- Hover effect overlay -->
                        <div class="position-absolute top-0 start-0 w-100 h-100 bg-primary bg-opacity-10 opacity-0 transition-opacity"
                             style="transition: opacity 0.3s ease; pointer-events: none;"></div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Récapitulatif par catégorie -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <h6 class="text-primary-custom mb-3">
              <i class="bi bi-list-check me-2"></i>Récapitulatif par catégorie
            </h6>

            <div class="row g-3">
              <% prime_cards.each do |category_name, category_data| %>
                <% if category_data['primes']&.any? %>
                  <div class="col-sm-6" data-sidebar-category="<%= category_name %>">
                    <div class="d-flex justify-content-between align-items-center bg-light rounded px-3 py-2">
                      <span class="small text-muted">
                        <i class="bi bi-<%= category_data['icon'] || 'house-gear' %> me-1"></i>
                        <%= category_data['title'] || category_name.humanize %>
                      </span>
                      <span class="small fw-semibold text-primary sidebar-category-total">
                        <%
                          category_total = category_data['primes'].sum { |p| p['calculated_amount'] || 0 }
                        %>
                        <%= number_to_currency(category_total, unit: "€", separator: ",", delimiter: " ", format: "%n %u") %>
                      </span>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <div class="alert alert-warning d-flex align-items-center" role="alert">
          <i class="bi bi-exclamation-triangle me-3"></i>
          <div>
            <h6 class="alert-heading mb-1">⚠️ Primes Wallonie prêtes à calculer</h6>
            <p class="mb-0">Cliquez pour calculer les montants des primes disponibles selon votre catégorie.</p>
          </div>
        </div>

        <div class="mt-3">
          <button id="calculate-primes-btn" class="btn btn-primary-custom">
            <i class="bi bi-calculator me-2"></i>Calculer les primes Wallonie
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
