<!-- ÉTAPE 2: Catégorie (seulement si éligible) - Wallonie -->
<div class="card border-0 shadow-sm mb-4 h-100" id="category-step" style="<%= @simulation.respond_to?(:eligible) && @simulation.eligible? ? '' : 'display: none;' %>">
  <div class="card-body p-4 d-flex flex-column">
    <h5 class="card-title text-primary-custom mb-3">
      <i class="bi bi-tag me-2"></i>Étape 2 : Catégorie de primes
    </h5>

    <div id="category-status">
      <% if @simulation.respond_to?(:category) && @simulation.category.present? %>
        <div class="bg-light-custom p-3 rounded mb-3">
          <div class="d-flex align-items-center">
            <div class="icon-circle me-3 bg-primary-custom text-white">
              <i class="bi bi-bookmark-fill"></i>
            </div>
            <div>
              <h6 class="mb-1">Catégorie de revenus: <%= @simulation.category %></h6>
              <% if @simulation.respond_to?(:category_description) && @simulation.category_description.present? %>
                <p class="text-muted-custom small mb-0"><%= @simulation.category_description %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <% if @real_eligibility && !@real_eligibility[:eligible] %>
          <!-- Utilisateur inéligible selon ses revenus -->
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-x-circle me-3"></i>
            <div>
              <h6 class="alert-heading mb-1">❌ Non éligible aux primes Wallonie</h6>
              <p class="mb-0"><%= @real_eligibility[:reason] %></p>
              <small class="text-muted">Votre ménage dépasse le seuil maximal d'éligibilité pour les primes de rénovation en Wallonie.</small>
            </div>
          </div>
        <% else %>
          <!-- Utilisateur potentiellement éligible, catégorie à calculer -->
          <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle me-3"></i>
            <div>
              <h6 class="alert-heading mb-1">⚠️ Catégorie prête à calculer</h6>
              <p class="mb-0">Cliquez pour déterminer votre catégorie de revenus Wallonie et les primes applicables.</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <% unless @simulation.respond_to?(:category) && @simulation.category.present? %>
      <% if @real_eligibility && @real_eligibility[:eligible] %>
        <div class="mt-3">
          <button id="calculate-category-btn" class="btn btn-primary-custom">
            <i class="bi bi-calculator me-2"></i>Calculer la catégorie Wallonie
          </button>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
