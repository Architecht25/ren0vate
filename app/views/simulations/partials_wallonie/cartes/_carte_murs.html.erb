<!-- CARTE 3: MURS - Horizontal layout -->
<div class="col-12">
  <div class="card border-0 shadow overflow-hidden card-premium" data-controller="wallonie-simulation-card" data-wallonie-simulation-card-slug-value="wallonie_murs_global">
    <div class="d-flex">
      <div class="flex-shrink-0 position-relative" style="width: 140px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_280,h_200,q_auto,f_auto/renovation_murs_istlqj'); background-size: cover; background-position: center;">
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(51,65,85,0.65), rgba(51,65,85,0.45);">
          <i class="bi bi-bricks fs-3 text-white drop-shadow mb-1"></i>
          <span class="fw-bold text-white small text-center px-1 drop-shadow">Travaux Murs</span>
          <span class="badge bg-white bg-opacity-25 text-white mt-1">7 primes</span>
        </div>
      </div>
      <div class="flex-grow-1 p-3">
        <%# Ligne 1 : 6 premiers champs %>
        <div class="row g-2 align-items-end mb-2">
          <% [['wallonie_assechement_murs_infiltration','Assèchement infiltration (m²)','inputInfiltration','number','Surface m²','resultInfiltration','calculateMurs','input'],
              ['wallonie_assechement_murs_humidite','Assèchement humidité (m²)','inputHumidite','number','Surface m²','resultHumidite','calculateMurs','input'],
              ['wallonie_renforcement_murs','Renforcement murs (m²)','inputRenforcement','number','Surface m²','resultRenforcement','calculateMurs','input'],
              ['wallonie_elimination_merule','Élimination mérule','inputMerule',nil,nil,'resultMerule','calculateMurs','change'],
              ['wallonie_elimination_radon','Élimination radon','inputRadon',nil,nil,'resultRadon','calculateMurs','change']
          ].each do |slug, lbl, tgt, type, ph, res_tgt, action, evt| %>
          <div class="col-md-4 col-lg-2">
            <% cond = condition_prime(slug) %>
            <label class="form-label small fw-medium mb-1"><%= lbl %>
              <% if cond.present? %><i class="bi bi-info-circle text-info ms-1" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-content="<%= h(cond) %>" data-bs-placement="top"></i><% end %>
            </label>
            <div class="input-group input-group-sm">
              <% if type == 'number' %>
                <input type="number" class="form-control" placeholder="<%= ph %>"
                       data-wallonie-simulation-card-target="<%= tgt %>"
                       data-action="<%= evt %>->wallonie-simulation-card#<%= action %>"
                       data-slug="<%= slug %>">
              <% else %>
                <select class="form-control"
                        data-wallonie-simulation-card-target="<%= tgt %>"
                        data-action="<%= evt %>->wallonie-simulation-card#<%= action %>"
                        data-slug="<%= slug %>">
                  <option value="0">Non</option>
                  <option value="1">Oui</option>
                </select>
              <% end %>
              <span class="input-group-text text-white" style="background-color: var(--ren0vate-primary);" data-wallonie-simulation-card-target="<%= res_tgt %>">0 €</span>
            </div>
          </div>
          <% end %>
        </div>
        <%# Ligne 2 : isolation thermique + biosourcée + total %>
        <div class="row g-2 align-items-end">
          <div class="col-md-4 col-lg-2">
            <% cond = condition_prime('wallonie_isolation_murs') %>
            <label class="form-label small fw-medium mb-1">Isolation thermique (m²)
              <% if cond.present? %><i class="bi bi-info-circle text-info ms-1" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-content="<%= h(cond) %>" data-bs-placement="top"></i><% end %>
            </label>
            <div class="input-group input-group-sm">
              <input type="number" class="form-control" placeholder="Surface m²"
                     data-wallonie-simulation-card-target="inputIsolationThermique"
                     data-action="input->wallonie-simulation-card#calculateMurs"
                     data-slug="wallonie_isolation_murs">
              <span class="input-group-text text-white" style="background-color: var(--ren0vate-primary);" data-wallonie-simulation-card-target="resultIsolationThermique">0 €</span>
            </div>
          </div>
          <div class="col-md-4 col-lg-2">
            <% cond = condition_prime('wallonie_isolation_murs_biosource') %>
            <label class="form-label small fw-medium mb-1">Isolation biosourcée (m²)
              <% if cond.present? %><i class="bi bi-info-circle text-info ms-1" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-content="<%= h(cond) %>" data-bs-placement="top"></i><% end %>
            </label>
            <div class="input-group input-group-sm">
              <input type="number" class="form-control" placeholder="Surface m²"
                     data-wallonie-simulation-card-target="inputIsolationBiosource"
                     data-action="input->wallonie-simulation-card#calculateMurs"
                     data-slug="wallonie_isolation_murs_biosource">
              <span class="input-group-text text-white" style="background-color: var(--ren0vate-primary);" data-wallonie-simulation-card-target="resultIsolationBiosource">0 €</span>
            </div>
          </div>
          <div class="col-md-4 col-lg-2 ms-auto d-flex align-items-end justify-content-end">
            <div class="text-end">
              <strong class="small d-block fw-semibold" style="color: var(--ren0vate-accent);">Total Murs :</strong>
              <span class="badge fs-6" style="background-color: var(--ren0vate-accent); color: white;" data-wallonie-simulation-card-target="total">0 €</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
