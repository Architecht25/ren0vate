<!-- CARTE 5: VENTILATION - Complexe (4 inputs) -->
<div class="col-lg-3 col-md-4 col-sm-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_ventilation_global">

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/Housing-Ventilation-Shutterstock-16-9-1920x1080px_uxckrq'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.7), rgba(13, 110, 253, 0.4));">
        <div class="text-center text-white">
          <i class="bi bi-wind fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Ventilation</h6>
          <small class="opacity-90">4 types VMC</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-primary bg-opacity-20 text-primary rounded-pill px-3">
            <i class="bi bi-wind me-1"></i>Ventilation
          </span>
          <small class="text-muted">
            <i class="bi bi-tools me-1"></i>4 types VMC
          </small>
        </div>
      </div>

      <div class="row g-2">
        <!-- VMC simple flux complète -->
        <div class="col-12">
          <label class="form-label small">VMC simple flux (complète) :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputVmcSimpleComplete"
                    data-action="change->wallonie-prime-card#calculateVentilation">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-primary text-white"
                  data-wallonie-prime-card-target="resultVmcSimpleComplete">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_vmc_simple") %>
        <% conseil_text = conseil_prime("wallonie_vmc_simple") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>

        <!-- VMC double flux complète -->
        <div class="col-12">
          <label class="form-label small">VMC double flux (complète) :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputVmcDoubleComplete"
                    data-action="change->wallonie-prime-card#calculateVentilation">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-primary text-white"
                  data-wallonie-prime-card-target="resultVmcDoubleComplete">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_vmc_double") %>
        <% conseil_text = conseil_prime("wallonie_vmc_double") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>

        <!-- VMC simple flux partielle -->
        <div class="col-12">
          <label class="form-label small">VMC simple (partielle) :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputVmcSimplePartielle"
                    data-action="change->wallonie-prime-card#calculateVentilation">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-primary text-white"
                  data-wallonie-prime-card-target="resultVmcSimplePartielle">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_vmc_simple_partielle") %>
        <% conseil_text = conseil_prime("wallonie_vmc_simple_partielle") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>

        <!-- VMC double flux partielle -->
        <div class="col-12">
          <label class="form-label small">VMC double (partielle) :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputVmcDoublePartielle"
                    data-action="change->wallonie-prime-card#calculateVentilation">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-primary text-white"
                  data-wallonie-prime-card-target="resultVmcDoublePartielle">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_vmc_double_partielle") %>
        <% conseil_text = conseil_prime("wallonie_vmc_double_partielle") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>
      </div>

      <!-- Total Ventilation -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-primary">Total Ventilation :</strong>
          <span class="badge bg-primary fs-6" data-wallonie-prime-card-target="totalVentilation">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
