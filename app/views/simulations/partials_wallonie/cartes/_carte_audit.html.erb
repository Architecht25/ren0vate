<!-- CARTE 1: AUDIT - Simple (1 input) -->
<div class="col-lg-3 col-md-4 col-sm-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="wallonie-simulation-card" data-wallonie-simulation-card-slug-value="wallonie_realisation_audit_logement">

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/audit-logement_me3bcs'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(13, 110, 253, 0.7), rgba(13, 110, 253, 0.4));">
        <div class="text-center text-white">
          <i class="bi bi-search fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Audit énergétique</h6>
          <small class="opacity-90">Forfaitaire</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-info bg-opacity-20 text-info rounded-pill px-3">
            <i class="bi bi-search me-1"></i>Audit
          </span>
          <small class="text-muted">
            <i class="bi bi-house me-1"></i>Logement
          </small>
        </div>
      </div>

      <!-- Input simple: Oui/Non (0 ou 1) -->
      <div class="mb-3">
        <label class="form-label small">Réalisation d'un audit :</label>
        <select class="form-select"
                data-wallonie-simulation-card-target="inputAudit"
                data-action="change->wallonie-simulation-card#calculateAudit">
          <option value="0">Non</option>
          <option value="1">Oui</option>
        </select>
      </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_realisation_audit_logement") %>
        <% conseil_text = conseil_prime("wallonie_realisation_audit_logement") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>


      <!-- Résultat -->
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Prime calculée :</span>
        <span class="badge bg-info fs-6" data-wallonie-simulation-card-target="resultAudit">
          0 €
        </span>
      </div>
    </div>
  </div>
</div>
