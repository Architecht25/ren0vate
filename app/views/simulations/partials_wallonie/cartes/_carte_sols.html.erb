<!-- CARTE 4: SOLS - Complexe (4 inputs) -->
<div class="col-lg-3 col-md-4 col-sm-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="wallonie-simulation-card" data-wallonie-simulation-card-slug-value="wallonie_sols_global">
    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/Eurofloor_1_wah35y'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-layers fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Travaux Sols</h6>
          <small class="opacity-90">4 types de primes</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-secondary bg-opacity-20 text-secondary rounded-pill px-3">
            <i class="bi bi-layers me-1"></i>Sols
          </span>
          <small class="text-success">
            <i class="bi bi-tools me-1"></i>4 primes
          </small>
        </div>
      </div>

      <div class="row g-3">
        <!-- Isolation sols -->
        <div class="col-md-6">
          <label class="form-label small">Isolation sols (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-simulation-card-target="inputIsolationSols"
                   data-action="input->wallonie-simulation-card#calculateSols"
                   data-slug="wallonie_isolation_sols">
            <span class="input-group-text bg-secondary text-white"
                  data-wallonie-simulation-card-target="resultIsolationSols">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_isolation_sols") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>

        <!-- Isolation sols biosourcée -->
        <div class="col-md-6">
          <label class="form-label small">Isolation biosourcée (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-simulation-card-target="inputIsolationBiosource"
                   data-action="input->wallonie-simulation-card#calculateSols"
                   data-slug="wallonie_sols_isolation_biosource">
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-simulation-card-target="resultIsolationBiosource">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_sols_isolation_biosource") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>

        <!-- Remplacement supports -->
        <div class="col-md-6">
          <label class="form-label small">Remplacement supports (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-simulation-card-target="inputSupports"
                   data-action="input->wallonie-simulation-card#calculateSols"
                   data-slug="wallonie_remplacement_supports_circulation">
            <span class="input-group-text bg-secondary text-white"
                  data-wallonie-simulation-card-target="resultSupports">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_remplacement_supports_circulation") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>

        <!-- Isolation finition planchers (12€/m²) -->
        <div class="col-md-6">
          <label class="form-label small">Finition planchers (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-simulation-card-target="inputFinitionPlanchers"
                   data-action="input->wallonie-simulation-card#calculateSols"
                   data-slug="wallonie_isolation_finition_planchers">
            <span class="input-group-text bg-secondary text-white"
                  data-wallonie-simulation-card-target="resultFinitionPlanchers">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_isolation_finition_planchers") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>
      </div>

      <!-- Total Sols -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-secondary">Total Sols :</strong>
          <span class="badge bg-secondary fs-6" data-wallonie-simulation-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
