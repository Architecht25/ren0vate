<div class="col-12">
  <div class="card border-0 shadow overflow-hidden card-premium" data-controller="wallonie-simulation-card" data-wallonie-simulation-card-slug-value="wallonie_amelioration_chauffage_global">
    <div class="d-flex">
      <div class="flex-shrink-0 position-relative" style="width: 140px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_280,h_200,q_auto,f_auto/efficacite-energetique-batiment_mlgdaj'); background-size: cover; background-position: center;">
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(51,65,85,0.65), rgba(51,65,85,0.45);">
          <i class="bi bi-thermometer-sun fs-3 text-white drop-shadow mb-1"></i>
          <span class="fw-bold text-white small text-center px-1 drop-shadow">Amélioration chauffage</span>
          <span class="badge bg-white bg-opacity-25 text-white mt-1">10 primes</span>
        </div>
      </div>
      <div class="flex-grow-1 p-3">
        <%# Ligne 1 : 5 premiers champs %>
        <div class="row g-2 align-items-end mb-2">
          <% [["wallonie_chauffage_isol_conduites","Isol. conduites","inputIsolationConduites",nil,nil,"resultIsolationConduites","calculateAmeliorationChauffage","change"],
              ["wallonie_chauffage_isol_ballon_500","Isol. ballon ≤500l","inputIsolationBallon500",nil,nil,"resultIsolationBallon500","calculateAmeliorationChauffage","change"],
              ["wallonie_chauffage_isol_ballon_sup","Isol. ballon >500l","inputIsolationBallonPlus500",nil,nil,"resultIsolationBallonPlus500","calculateAmeliorationChauffage","change"],
              ["wallonie_chauffage_circ_3logt","Circ. max 3 logt.","inputCirculateurMax3Logements",nil,nil,"resultCirculateurMax3Logements","calculateAmeliorationChauffage","change"],
              ["wallonie_chauffage_circ_4logt","Circ. min 4 logt.","inputCirculateurMin4Logements",nil,nil,"resultCirculateurMin4Logements","calculateAmeliorationChauffage","change"]
          ].each do |slug, lbl, tgt, type, ph, res_tgt, action, evt| %>
          <div class="col-md-4 col-lg-2">
            <% cond = condition_prime(slug) %>
            <label class="form-label small fw-medium mb-1"><%= lbl %>
              <% if cond.present? %><i class="bi bi-info-circle text-info ms-1" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-content="<%= h(cond) %>" data-bs-placement="top"></i><% end %>
            </label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-simulation-card-target="<%= tgt %>"
                      data-action="<%= evt %>->wallonie-simulation-card#<%= action %>"
                      data-slug="<%= slug %>">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text text-white" style="background-color: var(--ren0vate-primary);" data-wallonie-simulation-card-target="<%= res_tgt %>">0 €</span>
            </div>
          </div>
          <% end %>
        </div>
        <%# Ligne 2 : 5 derniers champs + total à droite %>
        <div class="row g-2 align-items-end">
          <% [["wallonie_chauffage_ballon_500","Rempl. ballon ≤500l","inputRemplacementBallon500",nil,nil,"resultRemplacementBallon500","calculateAmeliorationChauffage","change"],
              ["wallonie_chauffage_ballon_sup","Rempl. ballon >500l","inputRemplacementBallonPlus500",nil,nil,"resultRemplacementBallonPlus500","calculateAmeliorationChauffage","change"],
              ["wallonie_chauffage_vannes_base","Min 5 vannes therm.","inputMin5VannesThermostatiques",nil,nil,"resultMin5VannesThermostatiques","calculateAmeliorationChauffage","change"],
              ["wallonie_chauffage_vannes_sup","Vannes supplémentaires","inputVannesSupplementaires","number","Nombre","resultVannesSupplementaires","calculateAmeliorationChauffage","input"],
              ["wallonie_chauffage_thermostat","Thermostat ambiance","inputThermostatAmbiance",nil,nil,"resultThermostatAmbiance","calculateAmeliorationChauffage","change"]
          ].each do |slug, lbl, tgt, type, ph, res_tgt, action, evt| %>
          <div class="col-md-4 col-lg-2">
            <% cond = condition_prime(slug) %>
            <label class="form-label small fw-medium mb-1"><%= lbl %>
              <% if cond.present? %><i class="bi bi-info-circle text-info ms-1" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-content="<%= h(cond) %>" data-bs-placement="top"></i><% end %>
            </label>
            <div class="input-group input-group-sm">
              <% if type == 'number' %>
                <input type="number" class="form-control" placeholder="<%= ph %>"
                       data-wallonie-simulation-card-target="<%= tgt %>"
                       data-action="<%= evt %>->wallonie-simulation-card#<%= action %>"
                       data-slug="<%= slug %>">
              <% else %>
                <select class="form-control"
                        data-wallonie-simulation-card-target="<%= tgt %>"
                        data-action="<%= evt %>->wallonie-simulation-card#<%= action %>"
                        data-slug="<%= slug %>">
                  <option value="0">Non</option>
                  <option value="1">Oui</option>
                </select>
              <% end %>
              <span class="input-group-text text-white" style="background-color: var(--ren0vate-primary);" data-wallonie-simulation-card-target="<%= res_tgt %>">0 €</span>
            </div>
          </div>
          <% end %>
          <div class="col-md-4 col-lg-2 ms-auto d-flex align-items-end justify-content-end">
            <div class="text-end">
              <strong class="small d-block fw-semibold" style="color: var(--ren0vate-accent);">Total Chauffage :</strong>
              <span class="badge fs-6" style="background-color: var(--ren0vate-accent); color: white;" data-wallonie-simulation-card-target="total">0 €</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
