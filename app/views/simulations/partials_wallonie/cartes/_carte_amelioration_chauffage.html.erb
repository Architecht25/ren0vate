<!-- CARTE 7: AMÉLIORATION CHAUFFAGE - Très complexe (9 inputs) -->
<div class="col-lg-6 col-md-4 col-sm-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_amelioration_chauffage_global">

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/efficacite-energetique-batiment_mlgdaj'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(255, 193, 7, 0.35), rgba(255, 193, 7, 0.2));">
        <div class="text-center text-white">
          <i class="bi bi-gear fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Améliorations</h6>
          <small class="opacity-90">9 améliorations</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill px-3">
            <i class="bi bi-gear me-1"></i>Améliorations
          </span>
          <small class="text-muted">
            <i class="bi bi-tools me-1"></i>9 types
          </small>
        </div>
      </div>

      <div class="row g-3">
