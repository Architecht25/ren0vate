            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-prime-card-target="inputIsolationConduites"
                      data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-warning text-white"
                    data-wallonie-prime-card-target="resultIsolationConduites">0 €</span>
            </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_chauffage_isol_conduites") %>
        <% conseil_text = conseil_prime("wallonie_chauffage_isol_conduites") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

          </div>

