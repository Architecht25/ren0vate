<!-- CARTE 2: TOITURE - Complexe (5 inputs) -->
<div class="col-lg-3 col-md-4 col-sm-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="wallonie-simulation-card" data-wallonie-simulation-card-slug-value="wallonie_toiture_global">
    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/renovation_toiture_guwknw'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(0,0,0,0.4), rgba(0,0,0,0.2));">
        <div class="text-center text-white">
          <i class="bi bi-house-door fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Travaux Toiture</h6>
          <small class="opacity-90">5 types de primes</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill px-3">
            <i class="bi bi-house-door me-1"></i>Toiture
          </span>
          <small class="text-muted">
            <i class="bi bi-tools me-1"></i>5 primes
          </small>
        </div>
      </div>

      <div class="row g-3">
        <!-- Remplacement couverture -->
        <div class="col-md-6">
          <label class="form-label small">Remplacement couverture (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-simulation-card-target="inputCouverture"
                   data-action="input->wallonie-simulation-card#calculateToiture"
                   data-slug="wallonie_toiture_remplacement_couverture">
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-simulation-card-target="resultCouverture">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_toiture_remplacement_couverture") %>
        <% conseil_text = conseil_prime("wallonie_toiture_remplacement_couverture") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>

        <!-- Appropriation charpente -->
        <div class="col-md-6">
          <label class="form-label small">Appropriation charpente :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-simulation-card-target="inputCharpente"
                    data-action="change->wallonie-simulation-card#calculateToiture"
                    data-slug="wallonie_toiture_appropriation_charpente">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-simulation-card-target="resultCharpente">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_toiture_appropriation_charpente") %>
        <% conseil_text = conseil_prime("wallonie_toiture_appropriation_charpente") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>

        <!-- Évacuation eaux pluviales -->
        <div class="col-md-6">
          <label class="form-label small">Évacuation eaux pluviales :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-simulation-card-target="inputEvacuation"
                    data-action="change->wallonie-simulation-card#calculateToiture"
                    data-slug="wallonie_toiture_evacuation_eaux_pluviales">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-simulation-card-target="resultEvacuation">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_toiture_evacuation_eaux_pluviales") %>
        <% conseil_text = conseil_prime("wallonie_toiture_evacuation_eaux_pluviales") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>

        <!-- Isolation thermique -->
        <div class="col-md-6">
          <label class="form-label small">Isolation thermique (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-simulation-card-target="inputIsolationThermique"
                   data-action="input->wallonie-simulation-card#calculateToiture"
                   data-slug="wallonie_toiture_isolation_thermique">
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-simulation-card-target="resultIsolationThermique">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_toiture_isolation_thermique") %>
        <% conseil_text = conseil_prime("wallonie_toiture_isolation_thermique") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>

        <!-- Isolation biosourcée -->
        <div class="col-md-12">
          <label class="form-label small">Isolation biosourcée (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-simulation-card-target="inputIsolationBiosource"
                   data-action="input->wallonie-simulation-card#calculateToiture"
                   data-slug="wallonie_toiture_isolation_biosource">
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-simulation-card-target="resultIsolationBiosource">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_toiture_isolation_biosource") %>
        <% conseil_text = conseil_prime("wallonie_toiture_isolation_biosource") %>
        <% if condition_text.present? || conseil_text.present? %>
          <div class="mt-1">
            <% if condition_text.present? %>
              <div class="mb-1">
                <small class="text-muted">
                  <i class="bi bi-info-circle me-1"></i>
                  <%= condition_text %>
                </small>
              </div>
            <% end %>
            <% if conseil_text.present? %>
              <div>
                <small class="text-success">
                  <i class="bi bi-lightbulb me-1"></i>
                  <%= conseil_text %>
                </small>
              </div>
            <% end %>
          </div>
        <% end %>

        </div>
      </div>

      <!-- Total Toiture -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-warning">Total Toiture :</strong>
          <span class="badge bg-warning fs-5" data-wallonie-simulation-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
