<!-- CARTE 8: EAU CHAUDE SANITAIRE - Complexe (6 inputs authentiques DB) -->
<div class="col-lg-3 col-md-4 col-sm-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="wallonie-simulation-card" data-wallonie-simulation-card-slug-value="wallonie_eau_chaude_sanitaire_global">

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/schema-production-eau-chaude-sanitaire-avec-stockage-scaled_kwbpig'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(13, 202, 240, 0.175), rgba(13, 202, 240, 0.1));">
        <div class="text-center text-white">
          <i class="bi bi-droplet fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Eau Chaude Sanitaire</h6>
          <small class="opacity-90">6 types d'équipements</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-info bg-opacity-20 text-info rounded-pill px-3">
            <i class="bi bi-droplet me-1"></i>Eau Chaude
          </span>
          <small class="text-success">
            <i class="bi bi-tools me-1"></i>6 équipements
          </small>
        </div>
      </div>

        <div class="row g-3">
          <!-- ECS - Remplacement ballon ≤500l -->
          <div class="col-md-4 col-sm-6">
            <label class="form-label small">Remplacement ballon ≤500l :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-simulation-card-target="inputRemplacementBallon500"
                      data-action="change->wallonie-simulation-card#calculateAmeliorationChauffage"
                      data-slug="wallonie_chauffage_ballon_500">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-simulation-card-target="resultRemplacementBallon500">0 €</span>
            </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_chauffage_ballon_500") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

          </div>

          <!-- ECS - Remplacement ballon >500l -->
          <div class="col-md-4 col-sm-6">
            <label class="form-label small">Remplacement ballon >500l :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-simulation-card-target="inputRemplacementBallonSup"
                      data-action="change->wallonie-simulation-card#calculateEauChaudeSanitaire"
                      data-slug="wallonie_ecs_ballon_sup">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-simulation-card-target="resultRemplacementBallonSup">0 €</span>
            </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_ecs_ballon_sup") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

          </div>

          <!-- ECS - Isolation conduites boucle circulation (collective) -->
          <div class="col-md-4 col-sm-6">
            <label class="form-label small">Isolation conduites collective :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-simulation-card-target="inputIsolationConduites"
                      data-action="change->wallonie-simulation-card#calculateAmeliorationChauffage"
                      data-slug="wallonie_chauffage_isol_conduites">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-simulation-card-target="resultIsolationConduites">0 €</span>
            </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_chauffage_isol_conduites") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

          </div>

          <!-- ECS - Isolation échangeur plaques externe -->
          <div class="col-md-4 col-sm-6">
            <label class="form-label small">Isolation échangeur plaques :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-simulation-card-target="inputEchangeurPlaques"
                      data-action="change->wallonie-simulation-card#calculateEauChaudeSanitaire"
                      data-slug="wallonie_ecs_echangeur">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-simulation-card-target="resultEchangeurPlaques">0 €</span>
            </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_ecs_echangeur") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

          </div>

          <!-- ECS - Isolation ballon ≤500l -->
          <div class="col-md-4 col-sm-6">
            <label class="form-label small">Isolation ballon ≤500l :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-simulation-card-target="inputIsolationBallon500"
                      data-action="change->wallonie-simulation-card#calculateAmeliorationChauffage"
                      data-slug="wallonie_chauffage_isol_ballon_500">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-simulation-card-target="resultIsolationBallon500">0 €</span>
            </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_chauffage_isol_ballon_500") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

          </div>

          <!-- ECS - Isolation ballon >500l -->
          <div class="col-md-4 col-sm-6">
            <label class="form-label small">Isolation ballon >500l :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-simulation-card-target="inputIsolationBallonSup"
                      data-action="change->wallonie-simulation-card#calculateEauChaudeSanitaire"
                      data-slug="wallonie_ecs_isol_ballon_sup">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-simulation-card-target="resultIsolationBallonSup">0 €</span>
            </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_ecs_isol_ballon_sup") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

          </div>
        </div>

        <!-- Total Eau Chaude Sanitaire -->
        <div class="mt-3 pt-2 border-top">
          <div class="d-flex justify-content-between align-items-center">
            <strong class="text-info">Total Eau Chaude Sanitaire :</strong>
            <span class="badge bg-info fs-5" data-wallonie-simulation-card-target="total">
              0 €
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
