<!-- CARTE 6: CHAUDIÈRE ET PAC - Horizontal layout -->
<div class="col-12">
  <div class="card border-0 shadow overflow-hidden card-premium" data-controller="wallonie-simulation-card" data-wallonie-simulation-card-slug-value="wallonie_chaudiere_global">
    <div class="d-flex">
      <!-- Bannière latérale -->
      <div class="flex-shrink-0 position-relative" style="width: 140px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_280,h_200,q_auto,f_auto/pac_hybride_ukmzp8'); background-size: cover; background-position: center;">
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(51,65,85,0.65), rgba(51,65,85,0.45);">
          <i class="bi bi-fire fs-3 text-white drop-shadow mb-1"></i>
          <span class="fw-bold text-white small text-center px-1 drop-shadow">Chaudière &amp; PAC</span>
          <span class="badge bg-white bg-opacity-25 text-white mt-1">5 primes</span>
        </div>
      </div>
      <!-- Contenu -->
      <div class="flex-grow-1 p-3">
        <div class="row g-2 align-items-end">
          <% [['wallonie_pac_eau_chaude','PAC eau chaude','inputPacEauChaude',nil,nil,'danger','resultPacEauChaude','calculateChaudiere','change'],
              ['wallonie_pac_chauffage','PAC chauffage/combinée','inputPacChauffage',nil,nil,'danger','resultPacChauffage','calculateChaudiere','change'],
              ['wallonie_chaudiere_biomasse','Chaudière biomasse','inputChaudiereBiomasse',nil,nil,'danger','resultChaudiereBiomasse','calculateChaudiere','change'],
              ['wallonie_poele_biomasse','Poêle biomasse','inputPoeleBiomasse',nil,nil,'danger','resultPoeleBiomasse','calculateChaudiere','change'],
              ['wallonie_chauffe_eau_solaire','Chauffe-eau solaire','inputChauffeEauSolaire',nil,nil,'warning','resultChauffeEauSolaire','calculateChaudiere','change']
          ].each do |slug, lbl, tgt, type, ph, color, res_tgt, action, evt| %>
          <div class="col-md-4 col-lg-2">
            <% cond = condition_prime(slug) %>
            <label class="form-label small fw-medium mb-1"><%= lbl %>
              <% if cond.present? %><i class="bi bi-info-circle text-info ms-1" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-content="<%= h(cond) %>" data-bs-placement="top"></i><% end %>
            </label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-simulation-card-target="<%= tgt %>"
                      data-action="<%= evt %>->wallonie-simulation-card#<%= action %>"
                      data-slug="<%= slug %>">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text text-white" style="background-color: var(--ren0vate-primary);" data-wallonie-simulation-card-target="<%= res_tgt %>">0 €</span>
            </div>
          </div>
          <% end %>
          <!-- Total -->
          <div class="col-md-4 col-lg-2 d-flex align-items-end justify-content-end">
            <div class="text-end">
              <strong class="small d-block fw-semibold" style="color: var(--ren0vate-accent);">Total Chaudière &amp; PAC :</strong>
              <span class="badge fs-6" style="background-color: var(--ren0vate-accent); color: white;" data-wallonie-simulation-card-target="total">0 €</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
