<!-- CARTE 6: CHAUDIÈRE - Complexe (5 inputs) -->
<div class="col-lg-3 col-md-4 col-sm-6">
  <div class="card border-0 shadow h-100 overflow-hidden card-premium" data-controller="wallonie-simulation-card" data-wallonie-simulation-card-slug-value="wallonie_chaudiere_global">

    <!-- Image de fond avec overlay -->
    <div class="position-relative image-overlay" style="height: 120px; background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_400,h_120,q_auto,f_auto/pac_hybride_ukmzp8'); background-size: cover; background-position: center;">
      <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, rgba(220, 53, 69, 0.35), rgba(220, 53, 69, 0.2));">
        <div class="text-center text-white">
          <i class="bi bi-thermometer fs-3 mb-2 drop-shadow"></i>
          <h6 class="fw-bold mb-0 drop-shadow">Systèmes Chauffage</h6>
          <small class="opacity-90">5 types de systèmes</small>
        </div>
      </div>
    </div>

    <div class="card-body">
      <!-- Badge informatif -->
      <div class="mb-3">
        <div class="d-flex align-items-center justify-content-between">
          <span class="badge bg-danger bg-opacity-20 text-danger rounded-pill px-3">
            <i class="bi bi-thermometer me-1"></i>Chauffage
          </span>
          <small class="text-success">
            <i class="bi bi-tools me-1"></i>5 systèmes
          </small>
        </div>
      </div>

      <div class="row g-3">
        <!-- PAC eau chaude -->
        <div class="col-md-6 col-sm-6">
          <label class="form-label small">PAC eau chaude :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-simulation-card-target="inputPacEauChaude"
                    data-action="change->wallonie-simulation-card#calculateChaudiere"
                    data-slug="wallonie_pac_eau_chaude">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-danger text-white"
                  data-wallonie-simulation-card-target="resultPacEauChaude">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_pac_eau_chaude") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>

        <!-- PAC chauffage -->
        <div class="col-md-6 col-sm-6">
          <label class="form-label small">PAC chauffage/combinée :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-simulation-card-target="inputPacChauffage"
                    data-action="change->wallonie-simulation-card#calculateChaudiere"
                    data-slug="wallonie_pac_chauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-danger text-white"
                  data-wallonie-simulation-card-target="resultPacChauffage">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_pac_chauffage") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>

        <!-- Chaudière biomasse -->
        <div class="col-md-6 col-sm-6">
          <label class="form-label small">Chaudière biomasse :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-simulation-card-target="inputChaudiereBiomasse"
                    data-action="change->wallonie-simulation-card#calculateChaudiere"
                    data-slug="wallonie_chaudiere_biomasse">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-danger text-white"
                  data-wallonie-simulation-card-target="resultChaudiereBiomasse">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_chaudiere_biomasse") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>

        <!-- Poêle biomasse -->
        <div class="col-md-6 col-sm-6">
          <label class="form-label small">Poêle biomasse :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-simulation-card-target="inputPoeleBiomasse"
                    data-action="change->wallonie-simulation-card#calculateChaudiere"
                    data-slug="wallonie_poele_biomasse">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-danger text-white"
                  data-wallonie-simulation-card-target="resultPoeleBiomasse">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_poele_biomasse") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>

        <!-- Chauffe-eau solaire -->
        <div class="col-12">
          <label class="form-label small">Chauffe-eau solaire :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-simulation-card-target="inputChauffeEauSolaire"
                    data-action="change->wallonie-simulation-card#calculateChaudiere"
                    data-slug="wallonie_chauffe_eau_solaire">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-danger text-white"
                  data-wallonie-simulation-card-target="resultChauffeEauSolaire">0 €</span>
          </div>
        <!-- Informations de la prime -->
        <% condition_text = condition_prime("wallonie_chauffe_eau_solaire") %>
        <% if condition_text.present? %>
          <div class="mt-1">
            <div class="mb-1">
              <small class="text-success">
                <i class="bi bi-info-circle me-1"></i>
                <%= condition_text %>
              </small>
            </div>
          </div>
        <% end %>

        </div>
      </div>

      <!-- Total Chaudière -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-danger">Total Chauffage :</strong>
          <span class="badge bg-danger fs-5" data-wallonie-simulation-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
