<div class="container-fluid px-4 py-4">
  <!-- Header avec actions -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-calculator"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Modifier la simulation</h1>
    </div>
    <div>
      <%= link_to simulation_path(@simulation), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-pencil-square me-2"></i>Informations de la simulation
          </h5>

          <%= form_with model: @simulation, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :titre, "Titre de la simulation", class: "form-label" %>
              <%= form.text_field :titre, class: "form-control", placeholder: "Ex: Simulation isolation maison" %>
            </div>

            <div class="mb-3">
              <%= form.label :region, "Région", class: "form-label" %>
              <%= form.text_field :region, class: "form-control", placeholder: "Ex: Île-de-France" %>
            </div>

            <% if @simulation.respond_to?(:parameters) %>
              <div class="mb-3">
                <%= form.label :parameters, "Paramètres", class: "form-label" %>
                <%= form.text_area :parameters, rows: 4, class: "form-control", placeholder: "Surface, matériaux, coefficients thermiques..." %>
              </div>
            <% end %>

            <% if @simulation.respond_to?(:result) %>
              <div class="mb-3">
                <%= form.label :result, "Résultat", class: "form-label" %>
                <%= form.text_field :result, class: "form-control", placeholder: "Résultat de la simulation" %>
              </div>
            <% end %>

            <% if @simulation.respond_to?(:property_id) && defined?(Property) %>
              <div class="mb-3">
                <%= form.label :property_id, "Bien associé", class: "form-label" %>
                <%= form.collection_select :property_id, Property.all, :id, :name, { include_blank: "Sélectionner un bien..." }, class: "form-select" %>
              </div>
            <% end %>

            <div class="d-flex justify-content-end mt-4">
              <%= link_to "Annuler", simulation_path(@simulation), class: "btn btn-outline-secondary me-2" %>
              <%= form.submit "Enregistrer les modifications", class: "btn btn-primary-custom" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-3">
            <i class="bi bi-info-circle me-2"></i>Aide
          </h5>
          <p class="text-muted-custom small mb-0">Cette simulation vous permet d'estimer les primes et aides financières auxquelles vous pourriez avoir droit pour vos travaux de rénovation énergétique.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
