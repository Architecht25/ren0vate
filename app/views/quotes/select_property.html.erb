<% content_for :title, "Choisir un bien — Estimateur de devis" %>

<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-calculator"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Choisir un bien</h1>
        <small class="text-muted-custom">Sélectionnez le bien auquel rattacher le devis estimatif</small>
      </div>
    </div>
    <%= link_to properties_path, class: "btn btn-outline-primary-custom" do %>
      <i class="bi bi-arrow-left me-2"></i>Mes biens
    <% end %>
  </div>

  <!-- Bandeau explicatif -->
  <div class="alert border-0 mb-4 p-0" style="background:transparent;">
    <div class="row g-3">
      <div class="col-md-4">
        <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100" style="background:#f5f3ff;">
          <i class="bi bi-hourglass-split fs-4 flex-shrink-0" style="color:#7c3aed;"></i>
          <div>
            <div class="fw-semibold small" style="color:#5b21b6;">En attente de devis ?</div>
            <div class="text-muted small mt-1">Estimez le coût de vos travaux avant même de contacter un entrepreneur. Obtenez une fourchette de prix réaliste pour planifier votre budget.</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100" style="background:#eff6ff;">
          <i class="bi bi-clipboard2-data fs-4 flex-shrink-0" style="color:#1d4ed8;"></i>
          <div>
            <div class="fw-semibold small" style="color:#1e40af;">Comparez les scénarios</div>
            <div class="text-muted small mt-1">Créez plusieurs devis pour comparer différents lots de travaux, prioriser vos interventions et évaluer l'impact sur vos primes.</div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="d-flex align-items-start gap-3 p-3 rounded-3 h-100" style="background:#f0fdf4;">
          <i class="bi bi-bank fs-4 flex-shrink-0" style="color:#059669;"></i>
          <div>
            <div class="fw-semibold small" style="color:#065f46;">Préparez votre financement</div>
            <div class="text-muted small mt-1">Le montant estimé peut servir de base pour simuler vos prêts et primes. Une bonne estimation maximise vos chances d'obtenir un financement adapté.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <h5 class="fw-normal mb-1">Sélectionnez le bien à estimer</h5>
    <p class="text-muted small mb-0">L'estimateur est rattaché à un bien spécifique pour tenir compte de ses caractéristiques.</p>
  </div>

  <div class="row g-3">
    <% @properties.each do |property| %>
      <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow h-100">
          <div class="card-body p-4 d-flex flex-column">
            <div class="d-flex align-items-start mb-3">
              <div class="icon-circle me-3">
                <i class="bi bi-house-door"></i>
              </div>
              <div class="flex-grow-1">
                <h5 class="card-title mb-1 fw-normal"><%= property.titre.presence || "Bien sans nom" %></h5>
                <small class="text-muted-custom">
                  <i class="bi bi-geo-alt me-1"></i>
                  <%= property.rue %> <%= property.numero %>, <%= property.code_postal %> <%= property.commune %>
                </small>
              </div>
            </div>

            <div class="mt-auto pt-3 border-top">
              <div class="d-grid">
                <%= link_to new_property_quote_path(property), class: "btn btn-primary-custom" do %>
                  <i class="bi bi-arrow-right-circle me-2"></i>Utiliser ce bien
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
