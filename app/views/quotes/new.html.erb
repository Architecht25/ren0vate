<% content_for :title, "Nouveau devis estimatif — #{@property.titre || @property.commune}" %>

<div class="container-fluid px-4 py-4" id="quote-calculator-root">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-calculator"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouveau devis estimatif</h1>
        <small class="text-muted-custom">
          <i class="bi bi-geo-alt me-1"></i>
          <%= @property.titre || [@property.rue, @property.numero, @property.code_postal, @property.commune].compact.join(', ') %>
        </small>
      </div>
    </div>
    <%= link_to dashboard_property_path(@property), class: "btn btn-outline-primary-custom" do %>
      <i class="bi bi-arrow-left me-2"></i>Retour au bien
    <% end %>
  </div>

  <% if flash[:alert] %>
    <div class="alert alert-danger border-0 mb-4">
      <i class="bi bi-exclamation-triangle me-2"></i><%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with url: property_quotes_path(@property), method: :post, local: true do |f| %>
    <%# ── ESTIMATION IA ──────────────────────────────────────────────────── %>
    <div class="card border-0 shadow mb-4" style="border-left: 4px solid #e87722 !important;">
      <div class="card-body p-4">
        <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
          <div>
            <h5 class="fw-normal mb-1">
              <i class="bi bi-robot text-primary-custom me-2"></i>Estimation IA
            </h5>
            <p class="text-muted-custom small mb-0">
              Pré-remplit automatiquement les travaux recommandés selon le PEB, l'année de construction et la surface du bien.
            </p>
          </div>
          <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <% if @projects.any? %>
              <select class="form-select form-select-sm" id="ia-project-select" style="min-width: 180px; max-width: 240px;">
                <option value="">Sans description projet</option>
                <% @projects.each do |proj| %>
                  <option value="<%= proj.id %>"><%= proj.nom.presence || "Projet ##{proj.id}" %></option>
                <% end %>
              </select>
            <% end %>
            <button type="button"
                    class="btn btn-primary-custom btn-sm text-nowrap"
                    id="btn-ia-estimate"
                    data-estimate-url="<%= estimate_property_quotes_path(@property) %>">
              <i class="bi bi-stars me-1"></i>Lancer l'estimation IA
            </button>
          </div>
        </div>
        <div class="mt-3">
          <label class="form-label small text-muted-custom mb-1" for="ia-description">
            <i class="bi bi-pencil me-1"></i>Description libre des travaux envisagés <span class="fw-normal">(optionnel)</span>
          </label>
          <textarea id="ia-description"
                    class="form-control form-control-sm"
                    rows="2"
                    placeholder="Ex : remplacement châssis, isolation toiture, nouvelle salle de bain, mise en conformité électrique…"></textarea>
        </div>

        <%# Zone résultats — masquée par défaut %>
        <div id="ia-result" class="mt-4" style="display:none;">
          <div id="ia-loading" class="text-center py-3" style="display:none;">
            <div class="spinner-border spinner-border-sm text-primary-custom me-2" role="status"></div>
            <span class="text-muted-custom small">Analyse en cours…</span>
          </div>

          <div id="ia-content" style="display:none;">
            <div class="d-flex align-items-center gap-3 mb-2 pb-2 border-bottom">
              <small class="text-muted-custom" id="ia-summary"></small>
              <span class="badge ms-auto" id="ia-confidence-badge"></span>
            </div>
            <p class="small mb-3 lh-base" id="ia-narrative" style="display:none;"></p>

            <div class="row g-2 mb-3" id="ia-suggestions-list"></div>

            <div class="d-flex justify-content-end gap-2">
              <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-ia-dismiss">
                <i class="bi bi-x me-1"></i>Ignorer
              </button>
              <button type="button" class="btn btn-primary-custom btn-sm" id="btn-ia-apply">
                <i class="bi bi-check2-all me-1"></i>Appliquer les suggestions
              </button>
            </div>
          </div>

          <div id="ia-error" class="alert alert-warning border-0 small mb-0 py-2" style="display:none;">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <span id="ia-error-msg">Une erreur est survenue.</span>
          </div>
        </div>
      </div>
    </div>

    <%# ── TEMPLATES QUALITÉ ──────────────────────────────────────────────── %>
    <div class="card border-0 shadow mb-4">
      <div class="card-body p-4">
        <h5 class="fw-normal mb-1"><i class="bi bi-lightning-charge text-primary-custom me-2"></i>Démarrer avec un template</h5>
        <p class="text-muted-custom small mb-3">Sélectionnez un projet type pour pré-remplir les travaux. Vous pourrez ensuite ajuster.</p>
        <div class="row g-2" id="quote-templates">
          <% [
            { id: 'tpl_toiture',   icon: 'bi-house-fill',       color: 'secondary', label: 'Toiture complète',        keys: %w[charpente_renovation couverture_toiture isolation_toiture etancheite_toiture collecte_eaux_pluie] },
            { id: 'tpl_energie',   icon: 'bi-thermometer-half', color: 'warning',   label: 'Package énergie',          keys: %w[pompe_chaleur_air_eau panneaux_solaires batterie_stockage ventilation_double_flux] },
            { id: 'tpl_enveloppe', icon: 'bi-bricks',           color: 'success',   label: 'Enveloppe thermique',      keys: %w[isolation_murs_ext chassis_pvc porte_entree isolation_plancher] },
            { id: 'tpl_lourde',    icon: 'bi-tools',            color: 'danger',    label: 'Rénovation globale',       keys: %w[toiture_remplacement isolation_murs_ext chassis_pvc pompe_chaleur_air_eau electricite_conformite plomberie_renovation] },
            { id: 'tpl_interieur', icon: 'bi-house-heart',      color: 'info',      label: 'Rénovation intérieure',    keys: %w[salle_de_bain cuisine_renovation peinture_int carrelage_sol parquet] },
            { id: 'tpl_soussol',   icon: 'bi-moisture',         color: 'dark',      label: 'Sous-sol & fondations',    keys: %w[sous_sol_assechement structure_sol enduit_murs_int] },
            { id: 'tpl_solaire',   icon: 'bi-sun',              color: 'primary',   label: 'Autonomie énergétique',    keys: %w[panneaux_solaires batterie_stockage chauffe_eau_thermodynamique ventilation_double_flux] }
          ].each do |tpl| %>
            <div class="col-6 col-md-4 col-lg-3">
              <button type="button"
                      class="btn btn-outline-<%= tpl[:color] %> btn-sm w-100 text-start quote-template-btn"
                      data-template-id="<%= tpl[:id] %>"
                      data-keys="<%= tpl[:keys].join(',') %>">
                <i class="bi <%= tpl[:icon] %> me-2"></i><%= tpl[:label] %>
                <span class="badge bg-light text-muted ms-1 fw-normal"><%= tpl[:keys].size %></span>
              </button>
            </div>
          <% end %>
          <div class="col-6 col-md-4 col-lg-3">
            <button type="button" class="btn btn-outline-secondary btn-sm w-100 text-start" id="btn-reset-template">
              <i class="bi bi-x-circle me-2"></i>Tout effacer
            </button>
          </div>
        </div>
      </div>
    </div>

    <%# ── SÉLECTION MANUELLE ─────────────────────────────────────────────── %>
    <div class="card border-0 shadow mb-4">
      <div class="card-body p-4">
        <h5 class="fw-normal mb-1">Sélectionnez vos travaux</h5>
        <p class="text-muted-custom small mb-4">
          Cochez les travaux envisagés et indiquez la surface ou la quantité concernée.
          <strong>Les prix affichés sont des fourchettes estimatives, TVA/IVA incluse (taux variable selon le poste).</strong>
        </p>

        <%# Compteur global de travaux sélectionnés %>
        <div class="d-flex align-items-center justify-content-between mb-3" id="selection-summary" style="display:none!important">
          <span class="text-muted-custom small" id="selection-count">0 travaux sélectionnés</span>
        </div>

        <div class="accordion" id="work-types-accordion">
          <% @work_types_by_category.each_with_index do |(category_name, work_types), idx| %>
            <% category_icons = {
              'Toiture' => 'bi-house-fill',
              'Murs & Façades' => 'bi-bricks',
              'Châssis & Ouvertures' => 'bi-window',
              'Sol & Structure' => 'bi-layers',
              'Énergie & Chauffage' => 'bi-thermometer-half',
              'Pièces de vie' => 'bi-house-heart',
              'Technique' => 'bi-tools'
            } %>
            <% cat_id = category_name.parameterize %>
            <div class="accordion-item border mb-2 rounded overflow-hidden">
              <h2 class="accordion-header">
                <button class="accordion-button <%= idx > 0 ? 'collapsed' : '' %> fw-medium py-3"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#cat-<%= cat_id %>"
                        aria-expanded="<%= idx == 0 ? 'true' : 'false' %>">
                  <i class="bi <%= category_icons[category_name] || 'bi-wrench' %> me-2 text-primary-custom"></i>
                  <%= category_name %>
                  <span class="badge bg-light text-muted-custom ms-2 fw-normal" id="badge-<%= cat_id %>"><%= work_types.size %></span>
                </button>
              </h2>
              <div id="cat-<%= cat_id %>" class="accordion-collapse collapse <%= idx == 0 ? 'show' : '' %>">
                <div class="accordion-body p-3">
                  <div class="row g-3">
                    <% work_types.each do |wt| %>
                      <div class="col-12 col-md-6 col-xl-4">
                        <div class="card border quote-work-card h-100" id="card-<%= wt.key %>">
                          <div class="card-body p-3 d-flex flex-column">
                            <div class="d-flex align-items-start gap-2 mb-2">
                              <input class="form-check-input flex-shrink-0 mt-1 work-type-checkbox"
                                     type="checkbox"
                                     name="items[<%= wt.key %>][selected]"
                                     value="1"
                                     id="check-<%= wt.key %>"
                                     data-key="<%= wt.key %>">
                              <label class="form-check-label fw-medium d-block lh-sm" for="check-<%= wt.key %>" style="cursor: pointer;">
                                <i class="bi <%= wt.icon %> me-1 text-primary-custom"></i>
                                <%= wt.name %>
                              </label>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-3">
                              <small class="text-muted-custom text-nowrap">
                                <i class="bi bi-currency-euro me-1"></i>
                                <% if wt.forfait? %>
                                  <%= number_to_currency(wt.price_min, unit: '', separator: '.', delimiter: '.', precision: 0) %> –
                                  <%= number_to_currency(wt.price_avg, unit: '', separator: '.', delimiter: '.', precision: 0) %> –
                                  <%= number_to_currency(wt.price_max, unit: '', separator: '.', delimiter: '.', precision: 0) %> €
                                <% else %>
                                  <%= wt.price_min %> – <strong><%= wt.price_avg %></strong> – <%= wt.price_max %> €/<%= wt.unit_label %>
                                <% end %>
                              </small>
                              <small class="text-muted-custom text-nowrap">
                                <i class="bi bi-clock me-1"></i><%= wt.duration_min %>–<%= wt.duration_max %> j
                              </small>
                            </div>

                            <div class="mt-auto">
                              <% if wt.forfait? %>
                                <input type="hidden" name="items[<%= wt.key %>][quantity]" value="1">
                                <div class="qty-display rounded p-2 text-center" style="background: #f8f9fa; border: 1px dashed #dee2e6;">
                                  <small class="text-muted-custom">
                                    <i class="bi bi-check2-circle me-1"></i>Prix au forfait
                                  </small>
                                </div>
                              <% else %>
                                <div class="input-group input-group-sm">
                                  <span class="input-group-text text-muted-custom bg-light">
                                    <i class="bi bi-rulers"></i>
                                  </span>
                                  <input type="number"
                                         class="form-control qty-input"
                                         name="items[<%= wt.key %>][quantity]"
                                         id="qty-input-<%= wt.key %>"
                                         placeholder="<%= wt.unit_label == 'pièce' ? 'Nombre' : 'Surface / quantité' %>"
                                         min="<%= wt.unit_label == 'pièce' ? '1' : '0.1' %>"
                                         step="<%= wt.unit_label == 'pièce' ? '1' : '0.1' %>"
                                         disabled>
                                  <span class="input-group-text"><%= wt.unit_label %></span>
                                </div>
                              <% end %>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="d-flex justify-content-end gap-3">
      <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-x-lg me-2"></i>Annuler
      <% end %>
      <%= f.submit "Calculer l'estimation →", class: "btn btn-primary-custom px-5" %>
    </div>
  <% end %>
</div>

<style>
  .quote-work-card {
    transition: border-color 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }
  .quote-work-card.selected {
    border-color: #e87722 !important;
    box-shadow: 0 0 0 0.15rem rgba(232, 119, 34, .15);
  }
  .work-type-checkbox {
    cursor: pointer;
  }
  .qty-input:disabled {
    background-color: #f8f9fa;
    color: #999;
    cursor: not-allowed;
  }
  .qty-input:not(:disabled) {
    background-color: #fff;
  }
</style>

<script nonce="<%= content_security_policy_nonce %>">
  (function () {
    function getCategoryId(checkbox) {
      var card = document.getElementById('card-' + checkbox.dataset.key);
      if (!card) return null;
      var accordionBody = card.closest('.accordion-collapse');
      return accordionBody ? accordionBody.id : null;
    }

    function updateBadge(catCollapseId) {
      if (!catCollapseId) return;
      var catId = catCollapseId.replace(/^cat-/, '');
      var badge = document.getElementById('badge-' + catId);
      if (!badge) return;
      var collapse = document.getElementById(catCollapseId);
      if (!collapse) return;
      var total = collapse.querySelectorAll('.work-type-checkbox').length;
      var checked = collapse.querySelectorAll('.work-type-checkbox:checked').length;
      badge.textContent = checked > 0 ? checked + '/' + total + ' sélectionné' + (checked > 1 ? 's' : '') : total;
      badge.classList.toggle('bg-primary-custom', checked > 0);
      badge.classList.toggle('text-white', checked > 0);
      badge.classList.toggle('bg-light', checked === 0);
      badge.classList.toggle('text-muted-custom', checked === 0);
    }

    function updateGlobalCount() {
      var total = document.querySelectorAll('.work-type-checkbox:checked').length;
      var summary = document.getElementById('selection-summary');
      var countEl = document.getElementById('selection-count');
      if (!summary || !countEl) return;
      if (total > 0) {
        summary.style.removeProperty('display');
        countEl.textContent = total + ' travaux sélectionné' + (total > 1 ? 's' : '');
      } else {
        summary.style.display = 'none';
      }
    }

    function toggleWorkType(checkbox, focusInput) {
      var key = checkbox.dataset.key;
      var card = document.getElementById('card-' + key);
      var input = document.getElementById('qty-input-' + key);

      if (!card) return;

      if (checkbox.checked) {
        card.classList.add('selected');
        if (input) {
          input.disabled = false;
          if (focusInput) input.focus();
        }
      } else {
        card.classList.remove('selected');
        if (input) {
          input.disabled = true;
          input.value = '';
        }
      }

      updateBadge(getCategoryId(checkbox));
      updateGlobalCount();
    }

    function initQuoteCalculator() {
      var root = document.getElementById('quote-calculator-root');
      if (!root || root.dataset.initialized === 'true') return;

      root.dataset.initialized = 'true';

      root.querySelectorAll('.work-type-checkbox').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
          toggleWorkType(this, true);
        });
        toggleWorkType(checkbox, false);
      });

      root.querySelectorAll('.quote-work-card').forEach(function (card) {
        card.addEventListener('click', function (e) {
          if (e.target.tagName === 'INPUT' || e.target.tagName === 'LABEL' || e.target.closest('label')) {
            return;
          }
          var checkbox = card.querySelector('.work-type-checkbox');
          if (!checkbox) return;
          checkbox.checked = !checkbox.checked;
          toggleWorkType(checkbox, true);
        });
      });

      // ── Templates qualité ──────────────────────────────────────────────
      root.querySelectorAll('.quote-template-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var keys = this.dataset.keys.split(',');
          var activeId = this.dataset.templateId;

          // Décocher tous d'abord
          root.querySelectorAll('.work-type-checkbox').forEach(function (cb) {
            cb.checked = false;
            toggleWorkType(cb, false);
          });

          // Cocher les travaux du template
          keys.forEach(function (key) {
            var cb = document.getElementById('check-' + key);
            if (cb) {
              cb.checked = true;
              toggleWorkType(cb, false);

              // Ouvrir la catégorie accordion correspondante
              var collapse = cb.closest('.accordion-collapse');
              if (collapse && !collapse.classList.contains('show')) {
                var bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapse, { toggle: false });
                bsCollapse.show();
              }
            }
          });

          // Mettre en avant le bouton actif
          root.querySelectorAll('.quote-template-btn').forEach(function (b) {
            b.classList.remove('active');
          });
          this.classList.add('active');
        });
      });

      // Bouton reset
      var resetBtn = document.getElementById('btn-reset-template');
      if (resetBtn) {
        resetBtn.addEventListener('click', function () {
          root.querySelectorAll('.work-type-checkbox').forEach(function (cb) {
            cb.checked = false;
            toggleWorkType(cb, false);
          });
          root.querySelectorAll('.quote-template-btn').forEach(function (b) {
            b.classList.remove('active');
          });
        });
      }
    }

    document.addEventListener('turbo:load', initQuoteCalculator);
    document.addEventListener('DOMContentLoaded', initQuoteCalculator);
  })();
</script>

<script nonce="<%= content_security_policy_nonce %>">
  // ── Estimation IA ──────────────────────────────────────────────────────────
  (function () {
    var _iaSuggestions = [];

    var CONFIDENCE_LABELS = {
      high:   { label: 'Confiance haute',   cls: 'bg-success' },
      medium: { label: 'Confiance moyenne', cls: 'bg-warning text-dark' },
      low:    { label: 'Confiance faible',  cls: 'bg-secondary' }
    };

    function initIaEstimator() {
      var btn = document.getElementById('btn-ia-estimate');
      if (!btn || btn.dataset.iaInitialized === 'true') return;
      btn.dataset.iaInitialized = 'true';

      btn.addEventListener('click', runEstimate);

      var applyBtn = document.getElementById('btn-ia-apply');
      if (applyBtn) applyBtn.addEventListener('click', applyIaSuggestions);

      var dismissBtn = document.getElementById('btn-ia-dismiss');
      if (dismissBtn) dismissBtn.addEventListener('click', function () {
        document.getElementById('ia-result').style.display = 'none';
        _iaSuggestions = [];
      });
    }

    function runEstimate() {
      var btn     = document.getElementById('btn-ia-estimate');
      var baseUrl = btn.dataset.estimateUrl;
      var select  = document.getElementById('ia-project-select');
      var textarea = document.getElementById('ia-description');
      var params  = new URLSearchParams();
      if (select && select.value) params.set('project_id', select.value);
      if (textarea && textarea.value.trim()) params.set('description', textarea.value.trim());
      var url = params.toString() ? baseUrl + '?' + params.toString() : baseUrl;

      showLoading(true);

      fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept':           'application/json',
          'X-CSRF-Token':     document.querySelector('meta[name="csrf-token"]')?.content || ''
        },
        credentials: 'same-origin'
      })
      .then(function (r) {
        if (!r.ok) throw new Error('Erreur serveur (' + r.status + ')');
        return r.json();
      })
      .then(function (data) {
        showLoading(false);
        renderIaResult(data);
      })
      .catch(function (err) {
        showLoading(false);
        showIaError("Impossible de contacter le serveur. Réessayez.");
      });
    }

    function showLoading(on) {
      var result  = document.getElementById('ia-result');
      var loading = document.getElementById('ia-loading');
      var content = document.getElementById('ia-content');
      var error   = document.getElementById('ia-error');

      result.style.display  = on ? '' : result.style.display;
      loading.style.display = on ? '' : 'none';
      if (on) {
        content.style.display = 'none';
        error.style.display   = 'none';
        result.style.display  = '';
      }
    }

    function renderIaResult(data) {
      _iaSuggestions = data.suggestions || [];

      // Badge confiance
      var conf = CONFIDENCE_LABELS[data.confidence] || CONFIDENCE_LABELS.low;
      var badge = document.getElementById('ia-confidence-badge');
      badge.textContent  = conf.label;
      badge.className    = 'badge ms-auto ' + conf.cls;

      // Résumé
      document.getElementById('ia-summary').textContent = data.summary || '';

      // Narrative
      var narrativeEl = document.getElementById('ia-narrative');
      if (narrativeEl) {
        if (data.narrative) {
          narrativeEl.textContent = data.narrative;
          narrativeEl.style.display = '';
        } else {
          narrativeEl.style.display = 'none';
        }
      }

      // Liste suggestions
      var list = document.getElementById('ia-suggestions-list');
      list.innerHTML = '';

      if (_iaSuggestions.length === 0) {
        list.innerHTML = '<div class="col-12"><p class="text-muted-custom small mb-0">Aucune suggestion disponible avec les données actuelles du bien.</p></div>';
      } else {
        _iaSuggestions.forEach(function (sug) {
          var col = document.createElement('div');
          col.className = 'col-12 col-md-6 col-xl-4';
          var isForFait = !document.getElementById('qty-input-' + sug.work_type_key);
          var qtyText = isForFait ? 'forfait' : (sug.quantity + ' ' + getUnit(sug.work_type_key));
          col.innerHTML =
            '<div class="d-flex align-items-start gap-2 p-2 rounded border bg-light-subtle">' +
              '<i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>' +
              '<div class="min-w-0">' +
                '<div class="small fw-medium text-truncate">' + escHtml(getWorkTypeName(sug.work_type_key)) + '</div>' +
                '<div class="small text-muted-custom">' + escHtml(qtyText) + ' — ' + escHtml(sug.reason) + '</div>' +
              '</div>' +
            '</div>';
          list.appendChild(col);
        });
      }

      var content = document.getElementById('ia-content');
      var result  = document.getElementById('ia-result');
      content.style.display = '';
      result.style.display  = '';
    }

    function applyIaSuggestions() {
      var root = document.getElementById('quote-calculator-root');
      if (!root || !_iaSuggestions.length) return;

      // Décocher tous d'abord
      root.querySelectorAll('.work-type-checkbox').forEach(function (cb) {
        cb.checked = false;
        applyToggle(cb, false);
      });

      _iaSuggestions.forEach(function (sug) {
        var cb    = document.getElementById('check-' + sug.work_type_key);
        var input = document.getElementById('qty-input-' + sug.work_type_key);

        if (cb) {
          cb.checked = true;
          applyToggle(cb, false);

          // Ouvrir l'onglet accordion de la catégorie
          var collapse = cb.closest('.accordion-collapse');
          if (collapse && !collapse.classList.contains('show')) {
            var bsCollapse = bootstrap.Collapse.getOrCreateInstance(collapse, { toggle: false });
            bsCollapse.show();
          }
        }

        // Remplir la quantité s'il y a un input (non-forfait)
        if (input && sug.quantity) {
          input.disabled = false;
          input.value    = sug.quantity;
        }
      });

      // Masquer la zone résultat
      document.getElementById('ia-result').style.display = 'none';

      // Scroll vers le formulaire de sélection
      var accordion = document.getElementById('work-types-accordion');
      if (accordion) accordion.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Réimplémentation locale de toggleWorkType (indépendante du 1er IIFE)
    function applyToggle(checkbox, focusInput) {
      var key   = checkbox.dataset.key;
      var card  = document.getElementById('card-' + key);
      var input = document.getElementById('qty-input-' + key);
      if (!card) return;
      if (checkbox.checked) {
        card.classList.add('selected');
        if (input) { input.disabled = false; if (focusInput) input.focus(); }
      } else {
        card.classList.remove('selected');
        if (input) { input.disabled = true; input.value = ''; }
      }
    }

    function showIaError(msg) {
      document.getElementById('ia-error-msg').textContent = msg;
      document.getElementById('ia-error').style.display  = '';
      document.getElementById('ia-result').style.display = '';
    }

    function getWorkTypeName(key) {
      var card = document.getElementById('card-' + key);
      if (!card) return key;
      var label = card.querySelector('.form-check-label');
      return label ? label.textContent.trim() : key;
    }

    function getUnit(key) {
      var card = document.getElementById('card-' + key);
      if (!card) return '';
      var span = card.querySelector('.input-group-text:last-child');
      return span ? span.textContent.trim() : '';
    }

    function escHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    document.addEventListener('turbo:load', initIaEstimator);
    document.addEventListener('DOMContentLoaded', initIaEstimator);
  })();
</script>
