<!-- Template pour email de notification d'économie -->
<div style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; padding: 20px; border-radius: 8px; margin: 20px 0;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td style="text-align: center; padding-bottom: 15px;">
        <h2 style="margin: 0; color: white;">💰 Vous économisez avec Ren0vate !</h2>
      </td>
    </tr>
    <tr>
      <td>
        <table width="100%" cellpadding="10" cellspacing="0">
          <tr>
            <td style="background: rgba(255,255,255,0.2); border-radius: 5px; text-align: center;">
              <strong>Chasseur de primes traditionnel</strong><br>
              <span style="text-decoration: line-through; opacity: 0.8;"><%= number_to_currency(@savings_data[:chasseur_cost], locale: :fr) %></span><br>
              <small>12,5% + TVA</small>
            </td>
            <td style="text-align: center; font-size: 24px;">
              VS
            </td>
            <td style="background: rgba(255,255,255,0.3); border-radius: 5px; text-align: center; border: 2px solid white;">
              <strong>Avec Ren0vate</strong><br>
              <span style="font-size: 18px;"><%= number_to_currency(@savings_data[:saas_cost], locale: :fr) %></span><br>
              <small><%= @savings_data[:subscription_details][:duration_months] %> mois</small>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    <tr>
      <td style="text-align: center; padding-top: 15px;">
        <div style="background: rgba(255,255,255,0.2); padding: 15px; border-radius: 5px;">
          <strong style="font-size: 20px;">Économie : <%= number_to_currency(@savings_data[:savings_amount], locale: :fr) %></strong><br>
          <small>soit <%= @savings_data[:savings_percentage] %>% d'économie</small>
        </div>
      </td>
    </tr>
    <tr>
      <td style="text-align: center; padding-top: 20px;">
        <a href="<%= pricing_url %>" style="background: white; color: #28a745; padding: 12px 24px; text-decoration: none; border-radius: 5px; font-weight: bold; display: inline-block;">
          🚀 Choisir mon abonnement
        </a>
      </td>
    </tr>
  </table>
</div>
