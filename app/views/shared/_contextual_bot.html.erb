<div id="contextual-bot"
     class="contextual-bot-widget"
     data-controller="contextual-bot"
     data-contextual-bot-current-page-value="<%= controller_name %>"
     style="position: fixed; bottom: 20px; right: 100px; z-index: 1050;">

  <!-- Bouton flottant pour ouvrir/fermer -->
  <div class="bot-toggle" data-bs-toggle="collapse" data-bs-target="#bot-chat-container" aria-expanded="false">
    <button class="btn btn-primary rounded-circle shadow-lg bot-toggle-btn"
            style="width: 60px; height: 60px; border: none;">
      <i class="bi bi-robot fs-4"></i>
    </button>
    <!-- Badge de notification (optionnel) -->
    <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill"
          style="font-size: 0.7rem; display: none;" id="bot-notification-badge">1</span>
  </div>

  <!-- Container du chat - AGRANDI -->
  <div class="collapse bot-chat-container bg-white rounded-3 shadow-lg position-absolute"
       id="bot-chat-container"
       style="bottom: 80px; right: 0; width: min(450px, calc(100vw - 1rem)); height: min(650px, 80vh); border: 1px solid #dee2e6;">

    <!-- Header du bot -->
    <div class="bot-header bg-primary text-white p-3 rounded-top-3 d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center">
        <i class="bi bi-robot me-2"></i>
        <span class="fw-bold">Assistant Ren0vate</span>
        <span data-contextual-bot-target="modeIndicator" class="badge bg-success ms-2">
          <i class="bi bi-compass me-1"></i>Guide
        </span>
      </div>
      <div class="d-flex align-items-center">
        <button data-contextual-bot-target="toggleMode"
                data-action="click->contextual-bot#toggleMode"
                class="btn btn-outline-light btn-sm me-1" title="Basculer mode">
          <i class="bi bi-brain me-1"></i>Mode Expert
        </button>
        <button data-action="click->contextual-bot#clearHistory"
                class="btn btn-outline-light btn-sm me-1" title="Nouvelle conversation">
          <i class="bi bi-arrow-counterclockwise"></i>
        </button>
        <button class="btn btn-link text-white p-0"
                data-bs-toggle="collapse"
                data-bs-target="#bot-chat-container">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
    </div>

    <!-- ═══ PANNEAU DE CONSENTEMENT (affiché avant la 1ère utilisation) ═══ -->
    <div data-contextual-bot-target="consentPanel"
         class="p-3 overflow-auto d-flex flex-column"
         style="height: calc(100% - 65px);">
      <div class="alert alert-warning border-0 mb-3">
        <strong><i class="bi bi-shield-lock me-2"></i>Transfert de données vers l'IA</strong>
      </div>
      <p class="small mb-2">
        L'assistant Ren0vate utilise <strong>Claude (Anthropic, États-Unis)</strong>.
        À chaque message, les données suivantes sont transmises de façon pseudonymisée :
      </p>
      <ul class="small mb-3">
        <li>Prénom, localisation (code postal + commune), région</li>
        <li>Situation familiale, composition du ménage, statut BIM/RIS</li>
        <li><strong>Tranche de revenus</strong> (pas le montant exact) issue de votre AER</li>
        <li>Données de vos biens : commune, PEB, type, travaux, simulations de primes</li>
      </ul>
      <p class="small mb-3 text-muted">
        Ces données <strong>ne servent pas à entraîner les modèles IA</strong> (API policy Anthropic).
        Le transfert est encadré par des Clauses Contractuelles Types (SCC — art. 46 RGPD).
        Vous pouvez retirer votre consentement à tout moment en fermant le chat.
      </p>
      <div class="mt-auto">
        <button data-action="click->contextual-bot#acceptConsent"
                class="btn btn-primary w-100 mb-2">
          <i class="bi bi-check-circle me-2"></i>J'accepte et j'active l'assistant
        </button>
        <button class="btn btn-outline-secondary w-100 btn-sm"
                data-bs-toggle="collapse"
                data-bs-target="#bot-chat-container">
          Annuler
        </button>
        <p class="text-center mt-2 mb-0">
          <a href="/politique-confidentialite" target="_blank" class="small text-muted">
            Politique de confidentialité
          </a>
        </p>
      </div>
    </div>

    <!-- ═══ INTERFACE CHAT (masquée avant consentement) ═══ -->
    <div data-contextual-bot-target="chatContent" class="d-none d-flex flex-column" style="height: calc(100% - 65px);">

    <!-- Zone des messages - AGRANDIE -->
    <div class="bot-messages-container p-3 overflow-auto flex-grow-1"
         data-contextual-bot-target="messages"
         style="background-color: #fafafa; min-height: 0;">
      <!-- Les messages seront ajoutés ici dynamiquement -->
    </div>

    <!-- Zone des suggestions -->
    <div class="bot-suggestions p-2 border-top bg-light flex-shrink-0" style="min-height: 50px;">
      <div class="small text-muted mb-1">Suggestions :</div>
      <div data-contextual-bot-target="suggestions" class="d-flex flex-wrap">
        <!-- Les suggestions seront ajoutées ici -->
      </div>
    </div>

    <!-- Zone de saisie -->
    <div class="bot-input-container p-3 border-top bg-white rounded-bottom-3 flex-shrink-0">
      <div class="input-group">
        <input type="text"
               class="form-control"
               placeholder="Tapez votre question..."
               data-contextual-bot-target="input"
               autocomplete="off">
        <button class="btn btn-primary"
                type="button"
                data-contextual-bot-target="sendButton"
                data-action="click->contextual-bot#sendMessage">
          <i class="bi bi-send"></i>
        </button>
      </div>
      <div class="form-text small mt-1">
        💡 <strong>Guide :</strong> Aide contextuelle |
        🧠 <strong>Expert :</strong> Questions générales
      </div>
    </div>

    </div><!-- /chatContent -->
  </div>
</div>

<style>
  .bot-toggle-btn {
    transition: all 0.3s ease;
  }

  .bot-toggle-btn:hover {
    transform: scale(1.1);
  }

  .bot-chat-container {
    transition: all 0.3s ease;
  }

  .bot-messages-container::-webkit-scrollbar {
    width: 6px;
  }

  .bot-messages-container::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
  }

  .bot-messages-container::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
  }

  .bot-messages-container::-webkit-scrollbar-thumb:hover {
    background: #a8a8a8;
  }

  .message-bubble {
    word-wrap: break-word;
    max-width: 350px;
  }

  .max-width-70 {
    max-width: 70%;
  }

  .bot-avatar {
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .bot-chat-container {
      width: 90vw !important;
      right: 5vw !important;
      left: 5vw !important;
    }

    .contextual-bot-widget {
      right: 10px !important;
      bottom: 10px !important;
    }
  }
</style>
