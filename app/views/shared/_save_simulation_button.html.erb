<!-- Bouton Enregistrer la simulation - À intégrer dans les vues de simulation -->

<div class="sticky-save-button">
  <button
    type="button"
    class="btn btn-success btn-lg shadow"
    id="save-simulation-btn"
    data-simulation-id="<%= @simulation&.id %>"
    onclick="saveSimulationManually()"
    style="position: fixed; bottom: 20px; right: 20px; z-index: 1000; border-radius: 50px; padding: 15px 25px;"
  >
    <i class="bi bi-floppy me-2"></i>
    <span class="save-text">Enregistrer ma simulation</span>
    <span class="spinner-border spinner-border-sm ms-2 d-none" role="status"></span>
  </button>
</div>

<script nonce="<%= content_security_policy_nonce %>">
function saveSimulationManually() {
  const button = document.getElementById('save-simulation-btn');
  const textSpan = button.querySelector('.save-text');
  const spinner = button.querySelector('.spinner-border');
  const simulationId = button.dataset.simulationId;

  if (!simulationId) {
    alert('Erreur: ID de simulation non trouvé');
    return;
  }

  // État de chargement
  button.disabled = true;
  textSpan.textContent = 'Sauvegarde...';
  spinner.classList.remove('d-none');

  // Collecter les données selon la région
  const userInputs = collectAllUserInputs();

  console.log('💾 Sauvegarde manuelle:', Object.keys(userInputs).length, 'saisies');

  // Envoyer la requête
  fetch(`/simulations/${simulationId}/update_prime_inputs`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
      'Accept': 'application/json'
    },
    body: JSON.stringify({ user_inputs: userInputs })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Succès
      button.className = 'btn btn-success btn-lg shadow';
      textSpan.textContent = 'Sauvegardé !';
      showSuccessMessage(data.total_amount);

      // Réinitialiser après 3 secondes
      setTimeout(() => {
        button.disabled = false;
        textSpan.textContent = 'Enregistrer ma simulation';
        spinner.classList.add('d-none');
      }, 3000);

    } else {
      // Erreur
      button.className = 'btn btn-danger btn-lg shadow';
      textSpan.textContent = 'Erreur !';
      console.error('Erreur sauvegarde:', data.error);
      alert('Erreur lors de la sauvegarde: ' + data.error);

      // Réinitialiser après 3 secondes
      setTimeout(() => {
        button.disabled = false;
        button.className = 'btn btn-success btn-lg shadow';
        textSpan.textContent = 'Enregistrer ma simulation';
        spinner.classList.add('d-none');
      }, 3000);
    }
  })
  .catch(error => {
    // Erreur réseau
    button.className = 'btn btn-danger btn-lg shadow';
    textSpan.textContent = 'Erreur réseau !';
    console.error('Erreur réseau:', error);
    alert('Erreur de connexion. Veuillez réessayer.');

    // Réinitialiser après 3 secondes
    setTimeout(() => {
      button.disabled = false;
      button.className = 'btn btn-success btn-lg shadow';
      textSpan.textContent = 'Enregistrer ma simulation';
      spinner.classList.add('d-none');
    }, 3000);
  });
}

function collectAllUserInputs() {
  const userInputs = {};

  // Wallonie
  document.querySelectorAll('[data-controller="wallonie-prime-card"]').forEach(card => {
    const inputs = card.querySelectorAll('input, select');
    inputs.forEach(input => {
      const primeSlug = input.closest('[data-wallonie-prime-card-slug-value]')?.getAttribute('data-wallonie-prime-card-slug-value');
      if (primeSlug) {
        let value = null;
        if (input.type === 'checkbox') {
          value = input.checked ? 1 : 0;
        } else if (input.type === 'number') {
          value = parseFloat(input.value) || 0;
        } else if (input.tagName === 'SELECT') {
          value = input.value;
        }
        if (value !== null) {
          userInputs[primeSlug] = value;
        }
      }
    });
  });

  // Flandre
  document.querySelectorAll('input[data-slug], select[data-slug]').forEach(input => {
    const slug = input.dataset.slug;
    if (slug && input.value && input.value !== '0' && input.value !== '') {
      userInputs[slug] = input.value;
    }
  });

  // Bruxelles (similaire à Flandre)
  document.querySelectorAll('[data-controller*="bruxelles"] input[data-slug], [data-controller*="bruxelles"] select[data-slug]').forEach(input => {
    const slug = input.dataset.slug;
    if (slug) {
      let value = null;
      if (input.type === 'checkbox') {
        value = input.checked ? 1 : 0;
      } else if (input.type === 'number') {
        value = parseFloat(input.value) || 0;
      } else {
        value = input.value;
      }
      if (value !== null && value !== '' && value !== '0') {
        userInputs[slug] = value;
      }
    }
  });

  // Entreprises Bruxelles - gestion spécifique
  document.querySelectorAll('[data-controller="bruxelles-entreprise-calcul"] input, [data-controller="bruxelles-entreprise-calcul"] select').forEach(input => {
    // Collecter les sélects de configuration entreprise
    if (input.matches('[data-bruxelles-entreprise-calcul-target="tailleEntreprise"], [data-bruxelles-entreprise-calcul-target="ageEntreprise"]')) {
      const fieldName = input.matches('[data-bruxelles-entreprise-calcul-target="tailleEntreprise"]') ? 'entreprise_taille' : 'entreprise_age';
      if (input.value) {
        userInputs[fieldName] = input.value;
      }
    }

    // Collecter les inputs avec data-slug (montants investis)
    if (input.dataset.slug && input.value && input.value !== '0' && input.value !== '') {
      userInputs[input.dataset.slug] = input.value;
    }

    // Collecter les inputs avec name (pour compatibilité)
    if (input.name && input.value && input.value !== '0' && input.value !== '' && !input.dataset.slug) {
      userInputs[`bruxelles_entreprise_${input.name}`] = input.value;
    }
  });

  return userInputs;
}

function showSuccessMessage(totalAmount) {
  // Créer une notification de succès
  const notification = document.createElement('div');
  notification.className = 'alert alert-success alert-dismissible fade show position-fixed';
  notification.style.cssText = 'top: 20px; left: 50%; transform: translateX(-50%); z-index: 9999; min-width: 300px;';
  notification.innerHTML = `
    <i class="bi bi-check-circle me-2"></i>
    <strong>Simulation sauvegardée !</strong><br>
    Total calculé: <strong>${totalAmount}€</strong>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  `;

  document.body.appendChild(notification);

  // Retirer après 5 secondes
  setTimeout(() => {
    if (notification.parentNode) {
      notification.remove();
    }
  }, 5000);
}

// Raccourci clavier Ctrl+S
document.addEventListener('keydown', function(e) {
  if ((e.ctrlKey || e.metaKey) && e.key === 's') {
    e.preventDefault();
    saveSimulationManually();
  }
});

// Indicateur de modifications non sauvegardées
let hasUnsavedChanges = false;

document.addEventListener('input', function(e) {
  if (e.target.matches('[data-controller*="prime-card"] input, [data-controller*="prime-card"] select')) {
    hasUnsavedChanges = true;
    const button = document.getElementById('save-simulation-btn');
    if (button && !button.disabled) {
      button.classList.add('btn-warning');
      button.classList.remove('btn-success');
      button.querySelector('.save-text').textContent = 'Modifications non sauvées';
    }
  }
});

// Avertissement avant de quitter la page
window.addEventListener('beforeunload', function(e) {
  if (hasUnsavedChanges) {
    e.preventDefault();
    e.returnValue = 'Vous avez des modifications non sauvegardées. Voulez-vous vraiment quitter ?';
    return e.returnValue;
  }
});
</script>

<style>
.sticky-save-button button:hover {
  transform: scale(1.05);
  transition: transform 0.2s ease;
}

.sticky-save-button .btn-warning {
  animation: pulse-warning 2s infinite;
}

@keyframes pulse-warning {
  0% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7); }
  70% { box-shadow: 0 0 0 10px rgba(255, 193, 7, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 193, 7, 0); }
}
</style>
