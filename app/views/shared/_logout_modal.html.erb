<!-- Modal de confirmation de déconnexion -->
<div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true"
     data-logout-modal-target="modal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <!-- Header -->
      <div class="modal-header border-0 pb-2">
        <h5 class="modal-title fw-bold text-dark" id="logoutModalLabel">
          <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
          Confirmer la déconnexion
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <!-- Body -->
      <div class="modal-body pt-2 pb-4">
        <p class="text-muted mb-0">
          Êtes-vous sûr de vouloir vous déconnecter de votre compte ?
        </p>
        <small class="text-muted">
          Vous devrez vous reconnecter pour accéder à vos simulations et documents.
        </small>
      </div>

      <!-- Footer -->
      <div class="modal-footer border-0 pt-0">
        <button type="button"
                class="btn btn-outline-secondary px-4"
                data-action="click->logout-modal#cancel">
          <i class="bi bi-x-circle me-1"></i>
          Annuler
        </button>
        <button type="button"
                class="btn btn-danger px-4"
                data-action="click->logout-modal#confirm">
          <i class="bi bi-box-arrow-right me-1"></i>
          Déconnexion
        </button>
      </div>
    </div>
  </div>
</div>
