<div class="rounded-3 mb-4 overflow-hidden border" style="border-color: var(--ren0vate-primary) !important;">
  <div class="d-flex align-items-center justify-content-between gap-3 px-4 py-3 flex-wrap" style="background: linear-gradient(135deg, #f0f4ff 0%, #e8effe 100%);">
    <div class="d-flex align-items-center gap-3">
      <div style="width:40px;height:40px;background:var(--ren0vate-primary);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <i class="bi bi-patch-check-fill text-white" style="font-size:1.1rem;"></i>
      </div>
      <div>
        <div class="fw-semibold" style="color:var(--ren0vate-primary);">Expert Subsides IA
          <% if user_signed_in? && current_user.region.present? %>
            <span class="badge rounded-pill ms-1" style="background:var(--ren0vate-primary);color:#fff;font-size:.7rem;font-weight:500;">
              <%= current_user.region.capitalize %>
            </span>
          <% end %>
        </div>
        <div class="text-muted small">Une question sur votre éligibilité, vos documents ou vos délais ? L'Expert vous répond maintenant.</div>
      </div>
    </div>
    <%= link_to subsidy_expert_path, class: "btn btn-primary btn-sm px-4 flex-shrink-0" do %>
      <i class="bi bi-chat-dots me-1"></i>Consulter l'Expert
    <% end %>
  </div>
</div>
