<!-- Widget de Support Flottant -->
<div id="support-widget" class="position-fixed" style="bottom: 20px; right: 20px; z-index: 1050; --fab-offset: 80px;">
  <!-- Bouton Principal -->
  <button id="support-toggle" class="btn btn-primary rounded-circle shadow-lg"
          style="width: 60px; height: 60px; border: none;"
          data-bs-toggle="collapse"
          data-bs-target="#support-menu"
          aria-expanded="false">
    <i class="bi bi-headset fs-4"></i>
  </button>

  <!-- Menu déroulant -->
  <div class="collapse" id="support-menu">
    <div class="card mt-2 shadow-lg" style="width: 280px; border: none;">
      <% if user_signed_in? && current_user.has_active_subscription? %>
      <div class="card-header text-white text-center" style="background:var(--ren0vate-primary-dark,#1e293b);">
        <h6 class="mb-0">
          <i class="bi bi-shield-check me-2 text-warning"></i>
          Support prioritaire 24h
        </h6>
      </div>
      <% else %>
      <div class="card-header bg-primary text-white text-center">
        <h6 class="mb-0">
          <i class="bi bi-headset me-2"></i>
          Besoin d'aide ?
        </h6>
      </div>
      <% end %>
      <div class="card-body p-3">
        <p class="small text-muted mb-3">
          <% if user_signed_in? && current_user.has_active_subscription? %>
            Votre plan inclut le support prioritaire &mdash; réponse garantie sous 24h.
          <% else %>
            Notre équipe est là pour vous accompagner dans vos démarches de rénovation.
          <% end %>
        </p>

        <!-- Options de contact -->
        <div class="d-grid gap-2">
          <% if user_signed_in? && current_user.has_active_subscription? %>
            <!-- Support prioritaire in-app -->
            <%= link_to new_support_ticket_path,
                  class: "btn btn-sm d-flex align-items-center text-white",
                  style: "background:var(--ren0vate-primary-dark,#1e293b);" do %>
              <i class="bi bi-ticket-detailed-fill me-2"></i>
              <div class="text-start">
                <div class="fw-semibold">Ouvrir un ticket</div>
                <small style="opacity:.8;">Réponse garantie 24h</small>
              </div>
            <% end %>
            <%= link_to support_tickets_path,
                  class: "btn btn-outline-secondary btn-sm d-flex align-items-center" do %>
              <i class="bi bi-list-check me-2"></i>
              <div class="text-start">
                <div class="fw-semibold">Mes demandes</div>
                <small class="text-muted">Historique &amp; suivi</small>
              </div>
            <% end %>
          <% else %>
            <!-- Téléphone -->
            <a href="tel:+32485043745"
               class="btn btn-outline-success btn-sm d-flex align-items-center">
              <i class="bi bi-telephone-fill me-2"></i>
              <div class="text-start">
                <div class="fw-semibold">Appeler maintenant</div>
                <small class="text-muted">0485 043 745</small>
              </div>
            </a>
            <!-- Email -->
            <a href="mailto:robin@architecht.be?subject=Support Ren0vate - Demande d'aide"
               class="btn btn-outline-primary btn-sm d-flex align-items-center">
              <i class="bi bi-envelope-fill me-2"></i>
              <div class="text-start">
                <div class="fw-semibold">Envoyer un email</div>
                <small class="text-muted">robin@architecht.be</small>
              </div>
            </a>
          <% end %>
        </div>

        <!-- Heures de disponibilité -->
        <div class="mt-3 pt-2 border-top">
          <small class="text-muted">
            <i class="bi bi-clock me-1"></i>
            <% if user_signed_in? && current_user.has_active_subscription? %>
              <strong>Plan <%= current_user.subscription_tier_name %></strong><br>
              Support prioritaire &mdash; Lun-Ven, réponse &lt; 24h
            <% else %>
              <strong>Disponibilité :</strong><br>
              Lun-Ven: 9h-17h &mdash; Réponse email &lt; 24h
            <% end %>
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Styles personnalisés -->
<style>
  #support-widget .btn-primary {
    background: linear-gradient(135deg, #007bff, #0056b3);
    animation: pulse-soft 2s infinite;
  }

  @keyframes pulse-soft {
    0% { box-shadow: 0 4px 15px rgba(0, 123, 255, 0.4); }
    50% { box-shadow: 0 6px 20px rgba(0, 123, 255, 0.6); }
    100% { box-shadow: 0 4px 15px rgba(0, 123, 255, 0.4); }
  }

  #support-menu .card {
    border-radius: 12px;
    border: none !important;
  }

  #support-menu .card-header {
    border-radius: 12px 12px 0 0 !important;
  }

  #support-widget .btn-outline-success:hover {
    background-color: #198754;
    border-color: #198754;
  }

  #support-widget .btn-outline-primary:hover {
    background-color: #0d6efd;
    border-color: #0d6efd;
  }

  #support-widget .btn-outline-info:hover {
    background-color: #0dcaf0;
    border-color: #0dcaf0;
  }

  @media (max-width: 768px) {
    #support-widget {
      bottom: 80px !important; /* Pour éviter les barres de navigation mobile */
      right: 15px !important;
    }

    #support-menu .card {
      width: 260px !important;
    }
  }
</style>

<!-- Script pour améliorer l'UX -->
<script nonce="<%= content_security_policy_nonce %>">
  document.addEventListener('DOMContentLoaded', function() {
    // Fermer le menu quand on clique ailleurs
    document.addEventListener('click', function(event) {
      const widget = document.getElementById('support-widget');
      const menu = document.getElementById('support-menu');
      const toggle = document.getElementById('support-toggle');

      if (widget && !widget.contains(event.target)) {
        if (menu && menu.classList.contains('show')) {
          toggle.click();
        }
      }
    });

    // Tracking des clics pour analytics (optionnel)
    document.querySelectorAll('#support-menu a').forEach(link => {
      link.addEventListener('click', function() {
        console.log('Support contact method used:', this.textContent.trim());
        // Ici vous pourriez ajouter du tracking analytics
      });
    });
  });
</script>
