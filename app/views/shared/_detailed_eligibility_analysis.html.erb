<div class="detailed-eligibility-analysis">
  <% if @eligibility_analysis[:error].present? %>
    <!-- Cas d'erreur système -->
    <div class="alert alert-danger">
      <i class="bi bi-exclamation-triangle me-2"></i>
      <%= @eligibility_analysis[:error] %>
    </div>
  <% else %>
    <!-- Résumé général -->
    <div class="card mb-4">
      <div class="card-header d-flex align-items-center">
        <% if @eligibility_analysis[:eligible] %>
          <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
          <h5 class="mb-0 text-success">Analyse d'éligibilité : ÉLIGIBLE</h5>
        <% else %>
          <i class="bi bi-x-circle-fill text-danger me-2 fs-5"></i>
          <h5 class="mb-0 text-danger">Analyse d'éligibilité : NON ÉLIGIBLE</h5>
        <% end %>
      </div>
      <div class="card-body">
        <p class="lead mb-0"><%= @eligibility_analysis[:summary] %></p>
      </div>
    </div>

    <!-- Analyse détaillée des critères -->
    <div class="card mb-4">
      <div class="card-header">
        <h5 class="mb-0">
          <i class="bi bi-list-check me-2"></i>
          Analyse détaillée des critères d'éligibilité
        </h5>
      </div>
      <div class="card-body p-0">
        <div class="list-group list-group-flush">
          <% @eligibility_analysis[:criteria].each_with_index do |criterion, index| %>
            <div class="list-group-item">
              <div class="d-flex align-items-start">
                <!-- Icône de statut -->
                <div class="me-3 mt-1">
                  <% case criterion[:status] %>
                  <% when :success %>
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                  <% when :error %>
                    <i class="bi bi-x-circle-fill text-danger fs-5"></i>
                  <% when :warning %>
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                  <% end %>
                </div>

                <div class="flex-grow-1">
                  <!-- Nom du critère -->
                  <h6 class="mb-1 fw-bold">
                    <%= criterion[:name] %>
                  </h6>

                  <!-- Description -->
                  <p class="mb-2 text-muted small">
                    <%= criterion[:description] %>
                  </p>

                  <!-- Valeurs actuelle vs attendue -->
                  <div class="row g-2 mb-2">
                    <div class="col-md-6">
                      <small class="text-muted d-block">Valeur actuelle :</small>
                      <span class="badge <%= criterion[:status] == :success ? 'bg-success' : (criterion[:status] == :error ? 'bg-danger' : 'bg-warning') %>">
                        <%= criterion[:value] %>
                      </span>
                    </div>
                    <div class="col-md-6">
                      <small class="text-muted d-block">Valeur attendue :</small>
                      <span class="text-dark fw-medium">
                        <%= criterion[:expected] %>
                      </span>
                    </div>
                  </div>

                  <!-- Action corrective si nécessaire -->
                  <% if criterion[:action].present? %>
                    <div class="alert alert-light border-start border-3 <%= criterion[:status] == :error ? 'border-danger' : 'border-warning' %> py-2 mb-0">
                      <small>
                        <i class="bi bi-lightbulb me-1"></i>
                        <strong>Action recommandée :</strong> <%= criterion[:action] %>
                      </small>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Plan d'action (si actions nécessaires) -->
    <% if @eligibility_analysis[:actions].present? %>
      <div class="card mb-4">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="bi bi-clipboard-check me-2"></i>
            Plan d'action prioritaire
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <% @eligibility_analysis[:actions].each_with_index do |action, index| %>
              <div class="col-12">
                <div class="d-flex align-items-start">
                  <span class="badge bg-primary rounded-pill me-3 mt-1"><%= index + 1 %></span>
                  <div class="flex-grow-1">
                    <h6 class="mb-1"><%= action[:criterion] %></h6>
                    <p class="mb-0 text-muted"><%= action[:action] %></p>
                  </div>
                  <% if action[:priority] == 1 %>
                    <span class="badge bg-danger ms-2">Urgent</span>
                  <% elsif action[:priority] == 2 %>
                    <span class="badge bg-warning">À clarifier</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Informations sur les aides disponibles (si éligible) -->
    <% if @eligibility_analysis[:eligible] && @eligibility_analysis[:subsidy_info].present? %>
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="bi bi-gift me-2"></i>
            Aides disponibles pour votre entreprise
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <% @eligibility_analysis[:subsidy_info].each do |category| %>
              <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                  <h6 class="text-primary"><%= category[:name] %></h6>
                  <p class="small text-muted mb-2"><%= category[:description] %></p>
                  <div class="text-success fw-bold">
                    <i class="bi bi-currency-euro me-1"></i>
                    Jusqu'à <%= category[:max_amount] %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Message d'encouragement pour les non-éligibles -->
    <% unless @eligibility_analysis[:eligible] %>
      <div class="card border-info">
        <div class="card-body text-center">
          <i class="bi bi-info-circle text-info fs-1 mb-3"></i>
          <h5 class="text-info">Ne perdez pas espoir !</h5>
          <p class="mb-3">
            Suivez les actions recommandées ci-dessus et revenez faire le test une fois les conditions remplies.
            Notre plateforme vous guidera à chaque étape.
          </p>
          <div class="row g-2 justify-content-center">
            <div class="col-auto">
              <a href="https://economie-emploi.brussels" target="_blank" class="btn btn-outline-info btn-sm">
                <i class="bi bi-arrow-up-right-square me-1"></i>
                Site officiel BEE
              </a>
            </div>
            <div class="col-auto">
              <button type="button" class="btn btn-info btn-sm" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>
                Imprimer cette analyse
              </button>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<!-- Styles personnalisés -->
<style>
.detailed-eligibility-analysis .list-group-item {
  border-left: none;
  border-right: none;
}

.detailed-eligibility-analysis .list-group-item:first-child {
  border-top: none;
}

.detailed-eligibility-analysis .list-group-item:last-child {
  border-bottom: none;
}

.detailed-eligibility-analysis .border-start.border-3 {
  border-width: 3px !important;
}

@media print {
  .detailed-eligibility-analysis .btn {
    display: none;
  }
}
</style>
