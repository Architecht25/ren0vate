<div id="cookie-banner"
     data-controller="cookie-consent"
     class="position-fixed bottom-0 start-0 end-0 bg-dark text-white py-3 px-4 d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2"
     style="z-index: 9999; font-size: 0.875rem;">
  <span>
    Ce site utilise des cookies strictement nécessaires (session, authentification) et des cookies de paiement (Stripe).
    <a href="<%= privacy_path %>#cookies" class="text-white-50 ms-1">En savoir plus</a>
  </span>
  <button data-action="cookie-consent#accept"
          class="btn btn-sm btn-light text-dark flex-shrink-0"
          style="min-width: 110px;">
    J'accepte
  </button>
</div>
