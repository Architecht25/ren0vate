<!-- Exemple d'utilisation dans une vue de prime -->
<div class="card prime-card">
  <div class="card-img-top" style="height: 120px; background-image: url('<%= prime_card_image_url(@prime) %>'); background-size: cover; background-position: center;">
    <div class="overlay-gradient"></div>
  </div>
  <div class="card-body">
    <h5 class="card-title"><%= @prime.nom %></h5>
    <p class="card-text"><%= truncate(@prime.description, length: 100) %></p>
    <div class="d-flex justify-content-between align-items-center">
      <span class="badge bg-primary"><%= @prime.region.capitalize %></span>
      <small class="text-muted">Jusqu'à <%= number_to_currency(@prime.montant_max) %></small>
    </div>
  </div>
</div>

<!-- Ou avec image directe -->
<img src="<%= prime_image_url('isolation') %>"
     alt="Prime isolation"
     class="img-fluid rounded"
     loading="lazy">

<!-- Header de page avec image hero -->
<div class="hero-section" style="background-image: url('<%= prime_hero_image_url(@prime) %>');">
  <div class="hero-content">
    <h1><%= @prime.nom %></h1>
    <p class="lead">Optimisez votre rénovation énergétique</p>
  </div>
</div>
