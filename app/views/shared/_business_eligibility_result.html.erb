<%
  # Déterminer les classes CSS en fonction de l'éligibilité
  alert_class = is_eligible ? "alert-success" : "alert-danger"
  icon_class = is_eligible ? "fas fa-check-circle" : "fas fa-times-circle"
  badge_class = is_eligible ? "success" : "danger"
%>

<div class="alert <%= alert_class %> border-0 shadow-sm">
  <div class="row align-items-start">
    <div class="col-1 text-center">
      <i class="<%= icon_class %> fa-2x"></i>
    </div>
    <div class="col-11">
      <div class="alert-content">
        <%= result.html_safe %>

        <% if is_eligible && defined?(subsidy_categories) && subsidy_categories.present? %>
          <div class="mt-4">
            <h5 class="text-success mb-3">
              <i class="fas fa-gift me-2"></i>
              Catégories d'aides disponibles pour votre entreprise
            </h5>
            <div class="row">
              <% subsidy_categories.each do |category| %>
                <div class="col-md-6 mb-3">
                  <div class="card border-success h-100">
                    <div class="card-body">
                      <h6 class="card-title text-success">
                        <i class="fas fa-check me-2"></i>
                        <%= category[:name] %>
                      </h6>
                      <p class="card-text small mb-2">
                        <%= category[:description] %>
                      </p>
                      <div class="row">
                        <div class="col-6">
                          <small class="text-muted">
                            <strong>Taux de base :</strong><br>
                            <span class="badge bg-info"><%= category[:taux_base] %></span>
                          </small>
                        </div>
                        <div class="col-6">
                          <small class="text-muted">
                            <strong>Plafond :</strong><br>
                            <span class="badge bg-secondary"><%= category[:plafond] %></span>
                          </small>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if recommendations.present? %>
          <div class="mt-3">
            <strong>
              <i class="fas fa-lightbulb me-2"></i>
              Recommandations :
            </strong>
            <ul class="mb-0 mt-2">
              <% recommendations.each do |recommendation| %>
                <li><%= recommendation %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% if is_eligible %>
          <div class="mt-4 p-3 bg-light rounded">
            <h6 class="text-primary mb-2">
              <i class="fas fa-arrow-right me-2"></i>
              Prochaines étapes
            </h6>
            <div class="row">
              <div class="col-md-6">
                <a href="https://economie-emploi.brussels/quels-subsides"
                   target="_blank"
                   class="btn btn-primary btn-sm mb-2 w-100">
                  <i class="fas fa-external-link-alt me-2"></i>
                  Outil officiel détaillé
                </a>
              </div>
              <div class="col-md-6">
                <a href="https://mybee.brussels"
                   target="_blank"
                   class="btn btn-outline-primary btn-sm mb-2 w-100">
                  <i class="fas fa-file-alt me-2"></i>
                  Plateforme MonBEE
                </a>
              </div>
            </div>
            <small class="text-muted">
              <i class="fas fa-info-circle me-1"></i>
              <strong>Important :</strong> Les demandes doivent être introduites AVANT le début des investissements ou missions.
            </small>
          </div>
        <% else %>
          <!-- Analyse détaillée pour les non-éligibles -->
          <div class="mt-4 p-3 bg-light rounded border-start border-3 border-info">
            <h6 class="text-info mb-2">
              <i class="bi bi-search me-2"></i>
              Voulez-vous savoir exactement pourquoi et comment corriger ?
            </h6>
            <p class="small text-muted mb-3">
              Notre analyse détaillée vous montre point par point les critères d'éligibilité
              et vous guide pour corriger les éléments manquants.
            </p>

            <!-- Contenant pour l'analyse détaillée -->
            <div id="detailed_result" class="mb-3"></div>

            <!-- Bouton pour lancer l'analyse détaillée -->
            <%= form_with url: detailed_business_eligibility_check_path, local: false, data: { turbo_frame: "detailed_result" } do |form| %>
              <% if params[:property_id].present? %>
                <%= form.hidden_field :property_id, value: params[:property_id] %>
              <% end %>
              <% if params[:project_id].present? %>
                <%= form.hidden_field :project_id, value: params[:project_id] %>
              <% end %>

              <div class="d-grid gap-2 d-md-flex">
                <%= form.submit "🔍 Lancer l'analyse détaillée",
                    class: "btn btn-info btn-sm me-md-2",
                    data: { turbo_method: :post } %>
                <a href="https://economie-emploi.brussels"
                   target="_blank"
                   class="btn btn-outline-info btn-sm">
                  <i class="bi bi-arrow-up-right-square me-1"></i>
                  Site officiel BEE
                </a>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
