<nav class="navbar navbar-expand-lg navbar-light bg-light px-4 py-3 shadow-sm">
  <div class="container-fluid">
    <!-- Logo -->
    <a class="navbar-brand d-flex align-items-center" href="/">
      <i class="bi bi-house-heart-fill me-2 text-primary-custom"></i>
      <span class="fw-semibold">Ren0vate</span>
    </a>

    <!-- Bouton hamburger pour mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
            aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Contenu de la navbar (collapsible) -->
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <% if user_signed_in? %>
          <!-- Liens de navigation -->
          <li class="nav-item">
            <%= link_to properties_path, class: "nav-link px-3 d-flex align-items-center" do %>
              <i class="bi bi-house me-2"></i> Mes biens
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to projects_path, class: "nav-link px-3 d-flex align-items-center" do %>
              <i class="bi bi-hammer me-2"></i> Mes chantiers
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to simulations_path, class: "nav-link px-3 d-flex align-items-center" do %>
              <i class="bi bi-calculator me-2"></i> Simulations
            <% end %>
          </li>

          <!-- Séparateur pour mobile -->
          <li class="d-lg-none"><hr class="dropdown-divider"></li>

          <!-- Notifications -->
          <li class="nav-item position-relative">
            <%= link_to notifications_path, class: "nav-link px-3 d-flex align-items-center" do %>
              <i class="bi bi-bell me-2"></i> Notifications
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                2
                <span class="visually-hidden">unread messages</span>
              </span>
            <% end %>
          </li>

          <!-- Profil - lien direct -->
          <li class="nav-item">
            <%= link_to profile_path, class: "nav-link px-3 d-flex align-items-center" do %>
              <i class="bi bi-person-circle me-2"></i>
              Mon profil
            <% end %>
          </li>

          <!-- Déconnexion -->
          <li class="nav-item">
            <%= button_to destroy_user_session_path, method: :delete,
                data: { turbo_confirm: "Êtes-vous sûr de vouloir vous déconnecter ?" },
                class: "nav-link text-danger d-flex align-items-center border-0 bg-transparent px-3" do %>
              <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
            <% end %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to new_user_session_path, class: "btn btn-primary-custom px-4" do %>
              <i class="bi bi-box-arrow-in-right me-2"></i> Connexion
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<!-- Style pour la navbar -->
<style>
  .navbar .nav-link:hover {
    color: var(--primary-custom);
  }

  .navbar .dropdown-item:active {
    background-color: var(--primary-custom);
  }

  @media (max-width: 992px) {
    .navbar .nav-link {
      padding: 0.75rem 1rem;
    }
  }
</style>
