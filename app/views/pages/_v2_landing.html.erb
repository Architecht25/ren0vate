<%# V2 Landing — Ren0vate %>
<% hc = local_assigns.fetch(:household_count, 0).to_i %>

<%# ═══════════════════════════════════════════════════════════ %>
<%# HERO — dark slate + dashboard mockup                        %>
<%# ═══════════════════════════════════════════════════════════ %>
<div class="ren-hero-dark">
  <nav class="ren-landing-nav">
    <div class="container d-flex justify-content-between align-items-center">
      <%= link_to root_path, class: "ren-landing-logo text-decoration-none d-flex align-items-center gap-2" do %>
        <span class="ren-logo-mark">R</span>
        <span class="ren-landing-logo-text">Ren0vate</span>
      <% end %>
      <div class="d-flex align-items-center gap-3">
        <%= link_to "Tarifs", pricing_path, class: "ren-nav-link" %>
        <%= link_to "Connexion", new_user_session_path, class: "ren-nav-link" %>
        <%= link_to new_user_registration_path, class: "btn btn-accent-ren0vate btn-sm" do %>
          <i class="bi bi-bar-chart-steps me-1"></i>Démarrer mon projet
        <% end %>
      </div>
    </div>
  </nav>

  <section class="py-5">
    <div class="container">
      <div class="row align-items-center g-5 py-4">

        <div class="col-lg-6">
          <span class="ren-eyebrow-on-dark mb-3 d-inline-block">
            <i class="bi bi-house-heart me-1"></i>Plateforme immobilière digitale
          </span>
          <h1 class="display-5 fw-bold mt-3 mb-3 text-white">
            Votre logement,<br>
            <em class="ren-em-accent">de bout en bout</em>.
          </h1>
          <p class="lead mb-4" style="color: rgba(241,237,231,.80);">
            Rénovation, primes, DIU, vente, gestion locative — Ren0vate est le seul endroit
            où toute la vie de votre bien immobilier est centralisée.
          </p>
          <ul class="ren-checks-on-dark list-unstyled mb-4">
            <li><i class="bi bi-check-circle-fill"></i>Chantier piloté lot par lot, devis comparés, primes calculées</li>
            <li><i class="bi bi-check-circle-fill"></i>DIU constitué automatiquement pendant les travaux</li>
            <li><i class="bi bi-check-circle-fill"></i>Vente ou location : votre dossier est prêt</li>
          </ul>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <%= link_to new_user_registration_path, class: "btn btn-accent-ren0vate btn-lg px-4" do %>
                <i class="bi bi-house-heart me-2"></i>Démarrer mon projet
              <% end %>
              <%= link_to pricing_path, class: "btn btn-ghost-on-dark btn-lg px-4" do %>
                <i class="bi bi-cash-coin me-2"></i>Calculer mon financement
              <% end %>
            </div>
            <div class="ren-trust ren-trust-on-dark">
              <i class="bi bi-shield-check"></i>
              <% if hc > 0 %>
                <span>Déjà <strong><%= number_with_delimiter(hc) %> biens</strong> gérés sur Ren0vate</span>
              <% else %>
                <span>Soyez parmi les premiers à centraliser votre bien ici</span>
              <% end %>
            </div>
        </div>

        <%# Dashboard mockup %>
        <div class="col-lg-6">
          <div class="ren-dash-frame">
            <div class="ren-dash-chrome">
              <span class="ren-dash-dot ren-dash-dot-r"></span>
              <span class="ren-dash-dot ren-dash-dot-y"></span>
              <span class="ren-dash-dot ren-dash-dot-g"></span>
              <div class="ren-dash-url">
                <i class="bi bi-lock-fill"></i>
                <span>app.ren0vate.be / chantier / maison-liege-1965</span>
              </div>
            </div>
            <div class="ren-dash-body">
              <div class="ren-dash-head">
                <div>
                  <div class="ren-dash-title">Maison Liège 1965 · Wallonie</div>
                  <div class="ren-dash-sub">Toiture · Isolation · Châssis · Électricité</div>
                </div>
                <div class="ren-dash-status">
                  <span class="ren-dash-status-dot"></span>Chantier en cours
                </div>
              </div>
              <div class="ren-dash-stats">
                <div class="ren-dash-stat ren-dash-stat-primary">
                  <i class="bi bi-bar-chart-steps ren-dash-stat-icon"></i>
                  <div class="ren-dash-stat-label">Avancement chantier</div>
                  <div class="ren-dash-stat-value">62 %</div>
                  <div class="ren-dash-stat-sub">5 lots sur 8 validés</div>
                </div>
                <div class="ren-dash-stat ren-dash-stat-accent">
                  <i class="bi bi-cash-coin ren-dash-stat-icon"></i>
                  <div class="ren-dash-stat-label">Prêt 0 % débloqué</div>
                  <div class="ren-dash-stat-value">18 200 €</div>
                  <div class="ren-dash-stat-sub">sur 32 400 € validés</div>
                </div>
                <div class="ren-dash-stat ren-dash-stat-neutral">
                  <i class="bi bi-folder2-open ren-dash-stat-icon"></i>
                  <div class="ren-dash-stat-label">Documents</div>
                  <div class="ren-dash-stat-value">47</div>
                  <div class="ren-dash-stat-sub">3 pièces manquantes</div>
                </div>
                <div class="ren-dash-stat ren-dash-stat-warning">
                  <i class="bi bi-bell ren-dash-stat-icon"></i>
                  <div class="ren-dash-stat-label">Prochaine échéance</div>
                  <div class="ren-dash-stat-value">12 j</div>
                  <div class="ren-dash-stat-sub">Tranche 3 · facture isolation</div>
                </div>
              </div>
              <div class="ren-dash-section">
                <div class="ren-dash-section-head">
                  <span class="ren-dash-section-title">Lots & avancement</span>
                  <span class="ren-dash-section-meta">4 lots</span>
                </div>
                <div class="ren-dash-lots">
                  <div class="ren-dash-lot">
                    <div class="ren-dash-lot-name">Toiture</div>
                    <div class="ren-dash-lot-bar"><div class="ren-dash-lot-fill ren-dash-lot-fill-success" style="width:100%"></div></div>
                    <div class="ren-dash-lot-status ren-dash-lot-status-success">Réceptionné</div>
                  </div>
                  <div class="ren-dash-lot">
                    <div class="ren-dash-lot-name">Isolation</div>
                    <div class="ren-dash-lot-bar"><div class="ren-dash-lot-fill ren-dash-lot-fill-primary" style="width:80%"></div></div>
                    <div class="ren-dash-lot-status ren-dash-lot-status-primary">En cours</div>
                  </div>
                  <div class="ren-dash-lot">
                    <div class="ren-dash-lot-name">Châssis</div>
                    <div class="ren-dash-lot-bar"><div class="ren-dash-lot-fill ren-dash-lot-fill-accent" style="width:45%"></div></div>
                    <div class="ren-dash-lot-status ren-dash-lot-status-accent">En cours</div>
                  </div>
                  <div class="ren-dash-lot">
                    <div class="ren-dash-lot-name">Électricité</div>
                    <div class="ren-dash-lot-bar"><div class="ren-dash-lot-fill ren-dash-lot-fill-muted" style="width:0%"></div></div>
                    <div class="ren-dash-lot-status ren-dash-lot-status-muted">Planifié</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</div>

<%# ═══════════════════════════════════════════════════════════ %>
<%# TROIS PHASES — cream background                             %>
<%# ═══════════════════════════════════════════════════════════ %>
<section class="py-5">
  <div class="container">
    <div class="row mb-5 justify-content-center text-center">
      <div class="col-lg-8">
        <span class="ren-eyebrow ren-eyebrow-accent">
          <i class="bi bi-diagram-3 me-1"></i>De la rénovation à la vente
        </span>
        <h2 class="mt-3 mb-2">Toute la vie de votre bien, en un seul endroit</h2>
        <p class="text-muted-ren0vate mb-0">
          Du premier devis jusqu'à la transmission du DIU — Ren0vate vous accompagne à chaque étape.
        </p>
      </div>
    </div>
    <div class="row g-4 ren-phases-row">

      <div class="col-lg-4">
        <div class="ren-phase ren-phase-primary">
          <div class="ren-phase-head">
            <div class="ren-phase-num"><i class="bi bi-pencil-square"></i></div>
            <div>
              <span class="ren-phase-eyebrow">01 · Préparation</span>
              <h3 class="ren-phase-title">Préparer le chantier</h3>
            </div>
          </div>
          <p class="ren-phase-body">Cadrer le projet, comparer les devis, sécuriser le financement.</p>
          <ul class="ren-phase-feats">
            <li class="ren-phase-feat">
              <i class="bi bi-clipboard-data"></i>
              <div>
                <p class="ren-phase-feat-title">Cahier des charges & lots</p>
                <p class="ren-phase-feat-body">Découpez en lots (toiture, isolation, électricité…) et fixez les priorités.</p>
              </div>
            </li>
            <li class="ren-phase-feat">
              <i class="bi bi-files"></i>
              <div>
                <p class="ren-phase-feat-title">Devis comparés</p>
                <p class="ren-phase-feat-body">Format normalisé, écarts visibles en un coup d'œil.</p>
              </div>
            </li>
            <li class="ren-phase-feat">
              <i class="bi bi-cash-coin"></i>
              <div>
                <p class="ren-phase-feat-title">Prêt à taux 0 + primes</p>
                <p class="ren-phase-feat-body">Rénopack, Mijn VerbouwLening, Prêt Vert — montant calculé, dossier prêt.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="ren-phase ren-phase-accent">
          <div class="ren-phase-head">
            <div class="ren-phase-num"><i class="bi bi-bar-chart-steps"></i></div>
            <div>
              <span class="ren-phase-eyebrow">02 · Suivi</span>
              <h3 class="ren-phase-title">Piloter & suivre</h3>
            </div>
          </div>
          <p class="ren-phase-body">Avancement par lot, échéances, factures, photos — tout en un seul endroit.</p>
          <ul class="ren-phase-feats">
            <li class="ren-phase-feat">
              <i class="bi bi-list-check"></i>
              <div>
                <p class="ren-phase-feat-title">Vue par lot</p>
                <p class="ren-phase-feat-body">Jalons, retards, dépendances entre corps de métier.</p>
              </div>
            </li>
            <li class="ren-phase-feat">
              <i class="bi bi-folder2-open"></i>
              <div>
                <p class="ren-phase-feat-title">Documents au fil</p>
                <p class="ren-phase-feat-body">Factures, photos, attestations classées par lot, alertes si une pièce manque.</p>
              </div>
            </li>
            <li class="ren-phase-feat">
              <i class="bi bi-bell"></i>
              <div>
                <p class="ren-phase-feat-title">Échéances & tranches</p>
                <p class="ren-phase-feat-body">Déblocages du prêt 0 % et factures synchronisés sur l'avancement.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="ren-phase ren-phase-success">
          <div class="ren-phase-head">
            <div class="ren-phase-num"><i class="bi bi-house-check"></i></div>
            <div>
              <span class="ren-phase-eyebrow">03 · Réception</span>
              <h3 class="ren-phase-title">Réceptionner & clôturer</h3>
            </div>
          </div>
          <p class="ren-phase-body">PV, garanties, factures finales, archivage du dossier.</p>
          <ul class="ren-phase-feats">
            <li class="ren-phase-feat">
              <i class="bi bi-clipboard-check"></i>
              <div>
                <p class="ren-phase-feat-title">Procès-verbal</p>
                <p class="ren-phase-feat-body">Génération du PV de réception lot par lot, signatures intégrées.</p>
              </div>
            </li>
            <li class="ren-phase-feat">
              <i class="bi bi-shield-check"></i>
              <div>
                <p class="ren-phase-feat-title">Garanties trackées</p>
                <p class="ren-phase-feat-body">Décennale, biennale, parfait achèvement — chaque garantie liée à son lot.</p>
              </div>
            </li>
            <li class="ren-phase-feat">
              <i class="bi bi-archive"></i>
              <div>
                <p class="ren-phase-feat-title">Dossier archivé</p>
                <p class="ren-phase-feat-body">Export PDF complet pour banque, assurance, ou revente future du bien.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</section>

