<%
  # Cette page liste les aides aux entreprises disponibles en Flandre
  # avec des liens vers les sites officiels flamands
%>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <!-- Header avec retour -->
      <div class="d-flex align-items-center mb-4">
        <%= link_to root_path, class: "btn btn-outline-secondary me-3" do %>
          <i class="fas fa-arrow-left"></i> Retour
        <% end %>
        <h1 class="mb-0">
          <i class="fas fa-building me-2"></i>
          Aides aux Entreprises - Flandre
        </h1>
      </div>

      <!-- Information générale -->
      <div class="alert alert-dark" role="alert">
        <h4 class="alert-heading">
          <i class="fas fa-info-circle me-2"></i>
          Information
        </h4>
        <p class="mb-0">
          Voici les principaux sites officiels flamands pour les aides aux entreprises.
          Cliquez sur les liens pour accéder directement aux informations et procédures.
        </p>
      </div>

      <!-- Liste des liens officiels -->
      <div class="card mb-4">
        <div class="card-header bg-dark text-white">
          <h3 class="mb-0">
            <i class="fas fa-link me-2"></i>
            Sites Officiels - Flandre
          </h3>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">VLAIO</h5>
                <p class="text-muted mb-3">Flanders Innovation & Entrepreneurship</p>
                <a href="#" class="btn btn-outline-dark btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  À compléter
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">Flanders Investment & Trade</h5>
                <p class="text-muted mb-3">Agence flamande d'investissement et commerce</p>
                <a href="#" class="btn btn-outline-dark btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  À compléter
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">Agentschap Innoveren & Ondernemen</h5>
                <p class="text-muted mb-3">Agence pour l'innovation et l'entrepreneuriat</p>
                <a href="#" class="btn btn-outline-dark btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  À compléter
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">Participatiemaatschappij Vlaanderen</h5>
                <p class="text-muted mb-3">Société de participation de la Flandre</p>
                <a href="#" class="btn btn-outline-dark btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  À compléter
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section informative -->
      <div class="card border-warning">
        <div class="card-body">
          <h5 class="card-title text-warning">
            <i class="fas fa-lightbulb me-2"></i>
            Recherche d'URLs en cours
          </h5>
          <p class="mb-0">
            Nous allons compléter ces liens avec les vraies URLs des sites officiels flamands.
            En attendant, vous pouvez rechercher directement "steun ondernemingen Vlaanderen" sur votre moteur de recherche préféré.
          </p>
        </div>
      </div>

      <!-- Call to action -->
      <div class="text-center mt-5 mb-4">
        <%= link_to root_path, class: "btn btn-dark btn-lg" do %>
          <i class="fas fa-home me-2"></i>
          Retour à l'accueil
        <% end %>
      </div>
    </div>
  </div>
</div>
