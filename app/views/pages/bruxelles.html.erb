<%
  seo_data = region_seo_data('bruxelles')
  set_seo_meta(
    title: seo_data[:title],
    description: seo_data[:description],
    keywords: seo_data[:keywords],
    canonical_url: canonical_url_for(bruxelles_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_service('bruxelles', 'particuliers') %>
  </script>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  // Initialisation automatique de la région Bruxelles dès que le DOM est prêt
  document.addEventListener('DOMContentLoaded', function() {
    localStorage.setItem("region", "bruxelles");
    console.log('🌍 Région Bruxelles initialisée dans localStorage');
  });

  // Données des primes Bruxelles
  window.primes = <%= raw(@primes.to_json(
    only: [:slug, :titre, :unite, :type_de_valeur, :valeurs_par_categorie, :placeholder, :condition, :conseil, :document, :eligible_categories]
  )) if @primes %>;
</script>

<div class="container-fluid py-4">
  <!-- Header moderne et cohérent -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-house-check text-primary fs-4"></i>
              </div>
              <div>
                <h1 class="h3 mb-1 text-primary">Bruxelles - Primes de Rénovation</h1>
                <p class="text-muted mb-0">Testez votre éligibilité et découvrez vos primes RENOLUTION</p>
              </div>
            </div>
            <%= link_to root_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-arrow-left me-2"></i>Retour à l'accueil
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Panneau d'avertissement - Situation gouvernementale Bruxelles -->
  <div class="row mb-4 justify-content-center">
    <div class="col-lg-10 col-xl-8">
      <div class="alert alert-warning border-warning shadow-sm" role="alert">
        <div class="text-center mb-4">
          <i class="bi bi-exclamation-triangle-fill text-warning fs-1 mb-2 d-block"></i>
          <h4 class="alert-heading mb-2">
            <i class="bi bi-building me-2"></i>
            Situation exceptionnelle - Primes RENOLUTION suspendues
          </h4>
        </div>

        <div class="d-flex flex-column gap-3">
          <div class="bg-light rounded p-4 border-start border-warning border-4">
            <h5 class="text-warning mb-3">
              <i class="bi bi-pause-circle me-2"></i>
              Programme 2025 inexistant
            </h5>
            <p class="mb-0">
              En raison de l'<strong>absence de gouvernement de plein droit</strong>,
              le programme RENOLUTION 2025 n'a pas été adopté.
              <strong>Aucune prime n'est disponible</strong> pour les travaux exécutés en 2025.
            </p>
          </div>

          <div class="bg-light rounded p-4 border-start border-warning border-4">
            <h5 class="text-warning mb-3">
              <i class="bi bi-question-circle me-2"></i>
              Perspectives 2026 incertaines
            </h5>
            <p class="mb-3">
              <strong>Aucune perspective claire</strong> n'est actuellement dessinée pour 2026.
              La reprise du programme RENOLUTION dépendra de la formation d'un nouveau gouvernement régional.
            </p>
            <div class="alert alert-light border mb-0">
              <p class="mb-2">
                <strong><i class="bi bi-lightbulb me-2"></i>Projection possible :</strong>
              </p>
              <p class="small mb-0">
                Le système à venir pourrait s'inspirer du modèle wallon en développement :
                <strong>prêts à taux 0%</strong> avec possibilité de <strong>réduction du montant à rembourser</strong>
                (assimilée à une prime) en échange de conditions liées à la performance énergétique et aux revenus.
              </p>
            </div>
          </div>

          <div class="bg-light rounded p-4 border-start border-info border-4">
            <h5 class="text-info mb-3">
              <i class="bi bi-info-circle me-2"></i>
              Recommandations
            </h5>
            <p class="mb-0">
              <strong>Reportez vos travaux</strong> si possible. Si vous réalisez vos travaux, tâcher de disposer de la facture de solde de l'entrepreneur quand une période de prime sera ouverte.
              Suivez l'actualité politique pour connaître l'évolution de la situation.
            </p>
          </div>
        </div>

        <div class="mt-4 pt-3 border-top text-center">
          <small class="text-muted">
            <i class="bi bi-calendar3 me-1"></i>
            Situation mise à jour en novembre 2025 - Consultez régulièrement <a href="https://renolution.brussels" target="_blank" class="text-decoration-none">renolution.brussels</a> pour les dernières nouvelles
          </small>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenu principal en deux colonnes - COMMENTÉ en attente d'un gouvernement -->
  <% if false %>
  <div class="row g-4">
    <!-- COLONNE GAUCHE : Test d'éligibilité -->
    <div class="col-lg-6">
      <div class="h-100">

        <%= render 'pages/partials_bruxelles/selection_profil' %>

        <!-- Contenu dynamique pour l'éligibilité -->
        <div id="eligibility_content">
          <div class="text-center text-muted mt-4">
            <i class="bi bi-arrow-up fs-1 mb-2 d-block"></i>
            <p>Sélectionnez votre type de profil ci-dessus pour commencer</p>
          </div>
        </div>

        <!-- Zone pour l'affinage de catégorie après test d'éligibilité -->
        <div id="affinage-categorie-bruxelles" style="display: none;">
          <%= render 'pages/partials_bruxelles/affinage_categorie_simple' %>
        </div>
      </div>
    </div> <!-- fin col-lg-6 colonne gauche -->

    <!-- COLONNE DROITE : Primes et simulateur -->
    <div class="col-lg-6">
      <div class="h-100">
       <!-- Informations complémentaires intégrées -->
            <div class="alert alert-info mb-3">
              <h6 class="alert-heading">
                <i class="bi bi-info-circle me-2"></i>
                Comment utiliser ce simulateur
              </h6>
              <ul class="mb-0 small">
                <li><strong>Saisie simple :</strong> Indiquez vos surfaces (m²) ou sélectionnez Oui/Non</li>
                <li><strong>Calcul automatique :</strong> Les montants s'ajustent selon votre catégorie de revenus </li>
                <li><strong>Les montants indiqués sont les montants optimaux des primes.</strong> les primes ne couvrent pas plus de 90% du montant facturés HTVA</li>
                <li><strong>Estimation :</strong> Vous êtes sur un simulateur. Les montants officiels sont calculés par l'administration en charge.</li>
              </ul>
            </div>
        <%= render 'pages/partials_bruxelles/cartes_primes' %>

        <!-- Autres aides disponibles -->
        <div class="card border-0 shadow-sm mt-3">
          <div class="card-header bg-light">
            <h5 class="card-title mb-0">
              <i class="bi bi-gift text-info me-2"></i>
              Autres aides disponibles
            </h5>
            <p class="text-muted small mb-0 mt-1">
              Aides complémentaires et informations pratiques
            </p>
          </div>
          <div class="card-body">


            <div class="row g-3">
              <%= render 'pages/partials_bruxelles/petit_patrimoine' %>
              <%= render 'pages/partials_bruxelles/primes_communales_card' %>
              <%= render 'pages/partials_bruxelles/monuments_et_sites_card' %>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
