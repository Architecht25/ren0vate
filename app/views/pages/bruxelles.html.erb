<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-buildings"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Bruxelles - L'odyssée de la rénovation</h1>
    </div>
    <%= link_to root_path, class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-house-door me-2"></i>Retour à l'accueil
    <% end %>
  </div>

  <!-- Contenu principal -->
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 bg-light-custom shadow-sm mb-4">
        <div class="card-body p-4 text-center">
          <div class="icon-circle-large mx-auto mb-4">
            <i class="bi bi-buildings"></i>
          </div>
          <h2 class="h4 text-primary-custom mb-3 fw-normal">L'odyssée de la rénovation</h2>
          <p class="text-muted-custom mb-4">Dans une quête pour un avenir durable, nous attendons le jour où un gouvernement se lèvera pour guider Bruxelles vers ses objectifs climatiques.</p>
          
          <!-- Statut -->
          <div class="mb-4">
            <h3 class="h5 text-primary-custom mb-3 fw-normal">Statut actuel</h3>
            <div class="alert alert-info border-0 bg-white shadow-sm">
              <i class="bi bi-hourglass-split me-2"></i>
              <strong>En attente de la lumière dans l'obscurité...</strong>
            </div>
          </div>

          <!-- Message d'espoir -->
          <div class="mb-4">
            <div class="alert alert-success border-0 bg-white shadow-sm">
              <i class="bi bi-star me-2"></i>
              <strong>Chaque jour est une étape vers l'espoir</strong>
              <br>
              <small class="text-muted-custom">Nous sommes prêts à agir dès que l'appel à l'aventure sera lancé.</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
