    <img src="/assets/bruxelles-aventure.jpg" alt="Bruxelles Aventure" class="img-fluid rounded shadow-lg">
  </div>
</div>

<!-- lien pour accéder à la home page -->
  <div class="text-center mb-5">
    <%= link_to "Retour à l'accueil", root_path, class: "btn btn-outline-secondary mt-3" %>
  </div>

