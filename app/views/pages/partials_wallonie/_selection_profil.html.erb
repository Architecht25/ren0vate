<!-- Sélection du profil - Version button_to -->
<div class="mb-4">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light">
      <h4 class="card-title mb-0">
        <i class="bi bi-person-circle text-primary me-2"></i>
        Quel est votre profil ?
      </h4>
    </div>
    <div class="card-body">
      <div class="row g-2">
        <div class="col-md-6">
          <%= button_to select_profile_wallonie_path, method: :post,
              params: { profile_type: "prive" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-house-door me-2"></i>Propriétaire occupant ou futur occupant
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_wallonie_path, method: :post,
              params: { profile_type: "entreprise" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-building me-2"></i>Entreprise
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_wallonie_path, method: :post,
              params: { profile_type: "syndic" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-buildings me-2"></i>Syndic de copropriété
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_wallonie_path, method: :post,
              params: { profile_type: "bailleur" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-house-heart me-2"></i>Bailleur social
          <% end %>
        </div>
        <div class="col-12">
          <%= button_to select_profile_wallonie_path, method: :post,
              params: { profile_type: "asbl" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-heart me-2"></i>ASBL/Coopérative
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
