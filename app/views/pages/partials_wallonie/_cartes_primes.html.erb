<!-- Section Primes Wallonie - 10 cartes permanentes -->
<div class="primes-section-wallonie"
     data-controller="wallonie-prime-calcul test-eligibilite-wallonie">

  <!-- Bandeau d'information réglementaire -->
  <div class="alert alert-info border-0 mb-3 d-flex align-items-center">
    <i class="bi bi-info-circle fs-5 text-info me-3"></i>
    <div>
      <small class="fw-medium">Données officielles</small>
      <div class="small">Les données utilisées pour cette simulation reposent sur la réglementation en vigueur en Wallonie depuis mars 2025 et valable jusque fin septembre 2026</div>
    </div>
  </div>

  <h5 class="mb-3">
    <i class="bi bi-award text-primary me-2"></i>
    <span data-wallonie-prime-calcul-target="sectionTitle">
      Vos primes Wallonie - Toutes catégories R1 à R5
    </span>
  </h5>
  <p class="text-muted small mb-3">
    💡 Les montants s'ajustent automatiquement selon votre catégorie de revenus
  </p>

  <div class="row g-3">
        <!-- CARTE 1: AUDIT -->
        <%= render 'pages/partials_wallonie/cartes/audit' %>

        <!-- CARTE 2: TOITURE -->
        <%= render 'pages/partials_wallonie/cartes/toiture' %>

        <!-- CARTE 3: MURS -->
        <%= render 'pages/partials_wallonie/cartes/murs' %>

        <!-- CARTE 4: SOLS -->
        <%= render 'pages/partials_wallonie/cartes/sols' %>

        <!-- CARTE 5: MENUISERIES -->
        <%= render 'pages/partials_wallonie/cartes/menuiseries' %>

        <!-- CARTE 6: VENTILATION -->
        <%= render 'pages/partials_wallonie/cartes/ventilation' %>

        <!-- CARTE 7: SYSTÈMES CHAUFFAGE -->
        <%= render 'pages/partials_wallonie/cartes/chaudiere' %>

        <!-- CARTE 8: AMÉLIORATION CHAUFFAGE -->
        <%= render 'pages/partials_wallonie/cartes/amelioration_chauffage' %>

        <!-- CARTE 9: EAU CHAUDE SANITAIRE -->
        <%= render 'pages/partials_wallonie/cartes/eau_chaude_sanitaire' %>

        <!-- CARTE 10A & 10B: INSTALLATIONS -->
        <%= render 'pages/partials_wallonie/cartes/installations' %>
      </div>

      <!-- TOTAL GÉNÉRAL -->
      <div class="row mt-3">
        <div class="col-12">
          <div class="card bg-primary bg-opacity-10 border-primary">
            <div class="card-body text-center">
              <h5 class="text-primary mb-2">
                <i class="bi bi-calculator me-2"></i>
                Total estimé de vos primes Wallonie
              </h5>
              <div class="display-6 text-primary fw-bold" data-wallonie-prime-calcul-target="grandTotal">
                0 €
              </div>
              <p class="text-muted small mb-0 mt-2">
                <span data-wallonie-prime-calcul-target="currentCategory">Catégorie non définie</span>
                • Estimation selon votre profil de revenus
              </p>
          </div>
        </div>
      </div>
    </div>
</div>
