<div class="col-lg-4 col-md-4 col-12">
  <div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
    <div class="card-body d-flex flex-column align-items-center gap-3">
      <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
        <i class="bi bi-bank fs-5 text-info"></i>
      </div>
      <h6 class="card-title mb-2">Monuments & Sites</h6>

      <!-- Formulaire de vérification -->
      <div class="w-100" style="max-width: 300px;">
        <div class="mb-2">
          <label for="rue_monuments" class="form-label text-start w-100 small">Nom de la rue</label>
          <input type="text"
                 class="form-control form-control-sm"
                 id="rue_monuments"
                 placeholder="ex: Rue de la Station">
        </div>

        <div class="row mb-2">
          <div class="col-6">
            <label for="numero_monuments" class="form-label text-start w-100 small">Numéro</label>
            <input type="text"
                   class="form-control form-control-sm"
                   id="numero_monuments"
                   placeholder="ex: 2">
          </div>
          <div class="col-6">
            <label for="boite_monuments" class="form-label text-start w-100 small">Boîte (opt.)</label>
            <input type="text"
                   class="form-control form-control-sm"
                   id="boite_monuments"
                   placeholder="ex: A">
          </div>
        </div>

        <div class="row mb-3">
          <div class="col-6">
            <label for="code_postal_monuments" class="form-label text-start w-100 small">Code postal</label>
            <input type="text"
                   class="form-control form-control-sm"
                   id="code_postal_monuments"
                   placeholder="ex: 5000"
                   pattern="[0-9]{4}"
                   maxlength="4">
          </div>
          <div class="col-6">
            <label for="commune_monuments" class="form-label text-start w-100 small">Commune</label>
            <input type="text"
                   class="form-control form-control-sm"
                   id="commune_monuments"
                   placeholder="ex: Namur">
          </div>
        </div>

        <!-- Aperçu de l'adresse complète -->
        <div class="mb-3">
          <small class="text-muted">Adresse complète:</small>
          <div class="p-2 bg-light rounded small" id="preview_adresse">
            <em>Remplissez les champs ci-dessus</em>
          </div>
        </div>

        <!-- Statut de vérification -->
        <div class="mb-3" id="status_monuments" style="display: none;">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <i id="status_icon" class="bi"></i>
            <small id="status_text" class="fw-bold"></small>
          </div>
        </div>

        <!-- Loading indicator -->
        <div class="mb-3" id="loading_monuments" style="display: none;">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <div class="spinner-border spinner-border-sm text-info" role="status"></div>
            <small class="text-muted">Vérification en cours...</small>
          </div>
        </div>

        <!-- Champ montant travaux (si éligible) -->
        <div class="mb-3" id="montant_section" style="display: none;">
          <label for="montant_travaux" class="form-label text-start w-100 small">Montant des travaux (€)</label>
          <input type="number"
                 class="form-control form-control-sm"
                 id="montant_travaux"
                 placeholder="0"
                 min="0"
                 step="0.01">
        </div>

        <!-- Résultat -->
        <div class="alert alert-info alert-sm mb-2" id="result_section" style="display: none;" role="alert">
          <small class="fw-bold">Prime estimée (40%) : </small>
          <span class="fw-bold prime-result" id="result_monuments">0.00 €</span>
        </div>

        <small class="text-muted d-block">
          Vérifiez si votre bien est classé ou situé dans une zone protégée en Wallonie
        </small>
      </div>
    </div>
  </div>
</div>
