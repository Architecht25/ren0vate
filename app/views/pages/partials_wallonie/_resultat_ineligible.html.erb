<!-- Résultat d'inéligibilité - Arrêt du test -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-danger">
    <h4 class="card-title mb-0 text-white">
      <i class="bi bi-x-circle me-2"></i>
      Test d'éligibilité - Non éligible
    </h4>
  </div>
  <div class="card-body text-center">
    <div class="alert alert-danger border-0 mb-4">
      <i class="bi bi-exclamation-triangle fs-1 mb-3 d-block"></i>
      <h5 class="mb-3">Malheureusement, vous n'êtes pas éligible</h5>
      <p class="mb-0"><strong><%= message %></strong></p>
    </div>

    <div class="mb-4">
      <p class="text-muted">
        Pour être éligible aux primes wallonnes, toutes les conditions doivent être remplies.
        Nous vous encourageons à vérifier votre situation ou à consulter un expert.
      </p>
    </div>

    <!-- Bouton pour recommencer -->
    <div class="d-flex gap-2 justify-content-center">
      <button type="button" class="btn btn-outline-primary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise me-2"></i>
        Recommencer le test
      </button>
      <a href="/wallonie" class="btn btn-primary">
        <i class="bi bi-house me-2"></i>
        Retour à l'accueil
      </a>
    </div>
  </div>
</div>
