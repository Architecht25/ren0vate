<!-- Résultat estimation de catégorie -->
<div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
  <h6 class="alert-heading">
    <i class="bi bi-calculator me-2"></i>Votre catégorie estimée
  </h6>

  <p class="mb-3">
    ✅ Sur base de vos réponses, vous êtes probablement en
    <span class="badge bg-<%= category_color %> fs-6">Catégorie <%= category %></span>
  </p>

  <% if defined?(category_details) && category_details.present? %>
    <small class="text-muted">
      <%= category_details %>
    </small>
  <% end %>

  <div class="mt-3">
    <small class="text-muted">
      Pour confirmer cette estimation, une vérification plus précise est possible dans votre espace personnel.
    </small>
  </div>

  <div class="mt-3 d-flex gap-2">
    <a href="#primes-section" class="btn btn-success btn-sm">
      <i class="bi bi-gift me-1"></i>Voir mes primes <%= category %>
    </a>
    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="location.reload()">
      <i class="bi bi-arrow-clockwise me-1"></i>Recommencer
    </button>
  </div>

  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
</div>
