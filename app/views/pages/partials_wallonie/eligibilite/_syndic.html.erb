<!-- Questionnaire d'éligibilité Wallonie - Syndic -->
<div id="eligibility-test-wallonie-syndic"
     data-controller="test-eligibilite-wallonie"
     data-wizard-mode="true">

  <!-- Barre de progression wizard -->
  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <small class="text-muted fw-medium" data-test-eligibilite-wallonie-target="questionCounter">Question 1 / 5</small>
      <small class="text-warning">
        <i class="bi bi-check-circle me-1"></i>Répondez à chaque question pour accéder aux primes
      </small>
    </div>
    <div class="progress" style="height: 6px;">
      <div class="progress-bar bg-warning"
           role="progressbar"
           style="width: 0%;"
           data-test-eligibilite-wallonie-target="progressBar"></div>
    </div>
  </div>

  <form id="eligibilityFormWallonieSyndic" name="eligibilityFormWallonieSyndic"
        data-test-eligibilite-wallonie-target="form">
    <input type="hidden" name="profile_type" value="syndic">

        <!-- Question 1: Localisation de l'immeuble -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-geo-alt text-warning me-2"></i>
            L'immeuble est-il situé en Wallonie (hors Communauté germanophone) ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="localisation" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="localisation_oui">
              <label class="form-check-label" for="localisation_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="localisation" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="localisation_non">
              <label class="form-check-label" for="localisation_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 2: Usage résidentiel -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-house-door text-warning me-2"></i>
            L'immeuble est-il principalement résidentiel (au moins 80% logement) ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="usage_residentiel" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="usage_residentiel_oui">
              <label class="form-check-label" for="usage_residentiel_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="usage_residentiel" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="usage_residentiel_non">
              <label class="form-check-label" for="usage_residentiel_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 3: Âge de l'immeuble -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-calendar text-warning me-2"></i>
            L'immeuble a-t-il plus de 15 ans ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="age_immeuble" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="age_immeuble_oui">
              <label class="form-check-label" for="age_immeuble_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="age_immeuble" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="age_immeuble_non">
              <label class="form-check-label" for="age_immeuble_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 4: Minimum d'unités -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-people text-warning me-2"></i>
            La copropriété compte-t-elle au moins 2 unités ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="minimum_unites" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="minimum_unites_oui">
              <label class="form-check-label" for="minimum_unites_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="minimum_unites" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="minimum_unites_non">
              <label class="form-check-label" for="minimum_unites_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 5: Entrepreneur agréé -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-tools text-warning me-2"></i>
            L'entrepreneur chargé des travaux est-il inscrit à la Banque Carrefour des Entreprises ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="entrepreneur" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="entrepreneur_oui">
              <label class="form-check-label" for="entrepreneur_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="entrepreneur" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieSyndic" id="entrepreneur_non">
              <label class="form-check-label" for="entrepreneur_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

    <!-- Navigation wizard -->
    <div class="mt-3">
      <button type="button" class="btn btn-outline-secondary btn-sm"
              data-action="click->test-eligibilite-wallonie#prevQuestion">
        <i class="bi bi-arrow-left me-1"></i>Question précédente
      </button>
    </div>

  </form>

  <!-- Bouton de validation du test -->
  <div class="text-center mt-4">
    <button type="button"
            class="btn btn-warning btn-lg"
            data-action="click->test-eligibilite-wallonie#validateTestWallonieSyndic"
            data-test-eligibilite-wallonie-target="validateButton"
            style="display: none;">
      <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
    </button>
  </div>

  <!-- Zone de résultat -->
  <div data-test-eligibilite-wallonie-target="result" class="mt-4"></div>
</div>
