<!-- Questionnaire d'éligibilité Wallonie - Bailleur social -->
<div id="eligibility-test-wallonie-bailleur"
     data-controller="test-eligibilite-wallonie"
     data-wizard-mode="true">

  <!-- Barre de progression wizard -->
  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <small class="text-muted fw-medium" data-test-eligibilite-wallonie-target="questionCounter">Question 1 / 5</small>
      <small class="text-info">
        <i class="bi bi-check-circle me-1"></i>Répondez à chaque question pour accéder aux primes
      </small>
    </div>
    <div class="progress" style="height: 6px;">
      <div class="progress-bar bg-info"
           role="progressbar"
           style="width: 0%;"
           data-test-eligibilite-wallonie-target="progressBar"></div>
    </div>
  </div>

  <form id="eligibilityFormWallonieBailleur" name="eligibilityFormWallonieBailleur"
        data-test-eligibilite-wallonie-target="form">
    <input type="hidden" name="profile_type" value="bailleur">

        <!-- Question 1: Localisation du bien -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-geo-alt text-info me-2"></i>
            Le logement est-il situé en Wallonie (hors Communauté germanophone) ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="localisation" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="localisation_oui">
              <label class="form-check-label" for="localisation_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="localisation" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="localisation_non">
              <label class="form-check-label" for="localisation_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 2: Statut de bailleur social -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-shield-check text-info me-2"></i>
            Êtes-vous reconnu comme bailleur social par la Région wallonne ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="statut_bailleur" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="statut_bailleur_oui">
              <label class="form-check-label" for="statut_bailleur_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="statut_bailleur" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="statut_bailleur_non">
              <label class="form-check-label" for="statut_bailleur_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 3: Destination du bien -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-house-door text-info me-2"></i>
            Le bien est-il destiné au logement social ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="destination_sociale" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="destination_sociale_oui">
              <label class="form-check-label" for="destination_sociale_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="destination_sociale" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="destination_sociale_non">
              <label class="form-check-label" for="destination_sociale_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 4: Âge du logement -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-calendar text-info me-2"></i>
            Le logement a-t-il été construit il y a plus de 15 ans ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="age_logement" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="age_logement_oui">
              <label class="form-check-label" for="age_logement_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="age_logement" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="age_logement_non">
              <label class="form-check-label" for="age_logement_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 5: Entrepreneur agréé -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-wallonie-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-tools text-info me-2"></i>
            L'entrepreneur chargé des travaux est-il inscrit à la Banque Carrefour des Entreprises ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="entrepreneur" value="oui"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="entrepreneur_oui">
              <label class="form-check-label" for="entrepreneur_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="entrepreneur" value="non"
                     data-action="click->test-eligibilite-wallonie#handleAnswerWallonieBailleur" id="entrepreneur_non">
              <label class="form-check-label" for="entrepreneur_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

    <!-- Navigation wizard -->
    <div class="mt-3">
      <button type="button" class="btn btn-outline-secondary btn-sm"
              data-action="click->test-eligibilite-wallonie#prevQuestion">
        <i class="bi bi-arrow-left me-1"></i>Question précédente
      </button>
    </div>

  </form>

  <!-- Bouton de validation du test -->
  <div class="text-center mt-4">
    <button type="button"
            class="btn btn-info btn-lg"
            data-action="click->test-eligibilite-wallonie#validateTestWallonieBailleur"
            data-test-eligibilite-wallonie-target="validateButton"
            style="display: none;">
      <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
    </button>
  </div>

  <!-- Zone de résultat -->
  <div data-test-eligibilite-wallonie-target="result" class="mt-4"></div>
</div>
