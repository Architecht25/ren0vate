<!-- CARTE 4: SOLS - Complexe (4 inputs) -->
<div class="col-lg-8 col-md-8">
  <div class="card border-0 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_sols_global">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-layers fs-5 text-secondary"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Travaux Sols</h6>
          <small class="text-muted">4 types de primes sols</small>
        </div>
      </div>

      <div class="row g-3">
        <!-- Isolation sols -->
        <div class="col-md-6">
          <label class="form-label small">Isolation sols (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputIsolationSols"
                   data-action="input->wallonie-prime-card#calculateSols">
            <span class="input-group-text bg-secondary text-white"
                  data-wallonie-prime-card-target="resultIsolationSols">0 €</span>
          </div>
        </div>

        <!-- Isolation sols biosourcée -->
        <div class="col-md-6">
          <label class="form-label small">Isolation biosourcée (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputIsolationBiosource"
                   data-action="input->wallonie-prime-card#calculateSols">
            <span class="input-group-text bg-secondary text-white"
                  data-wallonie-prime-card-target="resultIsolationBiosource">0 €</span>
          </div>
        </div>

        <!-- Remplacement supports -->
        <div class="col-md-6">
          <label class="form-label small">Remplacement supports (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputSupports"
                   data-action="input->wallonie-prime-card#calculateSols">
            <span class="input-group-text bg-secondary text-white"
                  data-wallonie-prime-card-target="resultSupports">0 €</span>
          </div>
        </div>

        <!-- Isolation finition planchers (12€/m²) -->
        <div class="col-md-6">
          <label class="form-label small">Finition planchers (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputFinitionPlanchers"
                   data-action="input->wallonie-prime-card#calculateSols">
            <span class="input-group-text bg-secondary text-white"
                  data-wallonie-prime-card-target="resultFinitionPlanchers">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Sols -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-secondary">Total Sols :</strong>
          <span class="badge bg-secondary fs-6" data-wallonie-prime-card-target="totalSols">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
