<!-- CARTE 9: MENUISERIES - Simple (1 input) -->
<div class="col-lg-4 col-md-4">
  <div class="card border-1 border-success border-opacity-50 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_menuiseries_global">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-window fs-5 text-success"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Menuiseries</h6>
          <small class="text-muted">Fenêtres + Vitrages</small>
        </div>
      </div>

      <!-- Input surface -->
      <div class="mb-3">
        <label class="form-label small">Surface vitrages (m²) :</label>
        <input type="number"
               class="form-control form-control-sm"
               placeholder="Surface m²"
               data-wallonie-prime-card-target="inputMenuiseries"
               data-action="input->wallonie-prime-card#calculateMenuiseries">
      </div>

      <!-- Résultat -->
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Prime calculée :</span>
        <span class="badge bg-success fs-6" data-wallonie-prime-card-target="resultMenuiseries">
          0 €
        </span>
      </div>

      <!-- Section conseil avec CTA connexion -->
      <div class="mt-2">
        <small class="text-success">
          <i class="bi bi-lightbulb me-1"></i>
          Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
        </small>
      </div>
    </div>
  </div>
</div>
