<!-- CARTE 3: MURS - Complexe (7 inputs) -->
<div class="col-lg-12">
  <div class="card border-0 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_murs_global">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-bricks fs-5 text-success"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Travaux Murs</h6>
          <small class="text-muted">7 types de primes murs</small>
        </div>
      </div>

      <div class="row g-3">
        <!-- 1. Assèchement infiltration (14,4€/m²) -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Assèchement infiltration (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputInfiltration"
                   data-action="input->wallonie-prime-card#calculateMurs">
            <span class="input-group-text bg-success text-white"
                  data-wallonie-prime-card-target="resultInfiltration">0 €</span>
          </div>
        </div>

        <!-- 2. Assèchement humidité ascensionnelle (19,2€/m²) -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Assèchement humidité (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputHumidite"
                   data-action="input->wallonie-prime-card#calculateMurs">
            <span class="input-group-text bg-success text-white"
                  data-wallonie-prime-card-target="resultHumidite">0 €</span>
          </div>
        </div>

        <!-- 3. Renforcement murs (19,2€/m²) -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Renforcement murs (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputRenforcement"
                   data-action="input->wallonie-prime-card#calculateMurs">
            <span class="input-group-text bg-success text-white"
                  data-wallonie-prime-card-target="resultRenforcement">0 €</span>
          </div>
        </div>

        <!-- 4. Élimination mérule (840€ forfait) -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Élimination mérule :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputMerule"
                    data-action="change->wallonie-prime-card#calculateMurs">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-success text-white"
                  data-wallonie-prime-card-target="resultMerule">0 €</span>
          </div>
        </div>

        <!-- 5. Élimination radon (840€ forfait) -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Élimination radon :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputRadon"
                    data-action="change->wallonie-prime-card#calculateMurs">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-success text-white"
                  data-wallonie-prime-card-target="resultRadon">0 €</span>
          </div>
        </div>

        <!-- 6. Isolation thermique murs (52,8€/m²) -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Isolation thermique (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputIsolationThermique"
                   data-action="input->wallonie-prime-card#calculateMurs">
            <span class="input-group-text bg-success text-white"
                  data-wallonie-prime-card-target="resultIsolationThermique">0 €</span>
          </div>
        </div>

        <!-- 7. Isolation biosourcée murs (72€/m²) -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Isolation biosourcée (m²) :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   placeholder="Surface m²"
                   data-wallonie-prime-card-target="inputIsolationBiosource"
                   data-action="input->wallonie-prime-card#calculateMurs">
            <span class="input-group-text bg-success text-white"
                  data-wallonie-prime-card-target="resultIsolationBiosource">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Murs -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-success">Total Murs :</strong>
          <span class="badge bg-success fs-5" data-wallonie-prime-card-target="totalMurs">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
