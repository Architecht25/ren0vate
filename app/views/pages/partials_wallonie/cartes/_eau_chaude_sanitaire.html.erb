<!-- CARTE 8: EAU CHAUDE SANITAIRE - Complexe (6 inputs authentiques DB) -->
<div class="col-lg-8 col-md-8">
  <div class="card border-0 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_eau_chaude_sanitaire_global">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-droplet fs-5 text-info"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Eau Chaude Sanitaire</h6>
          <small class="text-muted">6 types d'équipements</small>
        </div>
      </div>

        <div class="row g-3">
          <!-- ECS - Remplacement ballon ≤500l -->
          <div class="col-lg-4 col-md-6">
            <label class="form-label small">Remplacement ballon ≤500l :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-prime-card-target="inputRemplacementBallon500"
                      data-action="change->wallonie-prime-card#calculateEauChaudeSanitaire">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-prime-card-target="resultRemplacementBallon500">0 €</span>
            </div>
          </div>

          <!-- ECS - Remplacement ballon >500l -->
          <div class="col-lg-4 col-md-6">
            <label class="form-label small">Remplacement ballon >500l :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-prime-card-target="inputRemplacementBallonSup"
                      data-action="change->wallonie-prime-card#calculateEauChaudeSanitaire">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-prime-card-target="resultRemplacementBallonSup">0 €</span>
            </div>
          </div>

          <!-- ECS - Isolation conduites boucle circulation (collective) -->
          <div class="col-lg-4 col-md-6">
            <label class="form-label small">Isolation conduites collective :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-prime-card-target="inputIsolationConduites"
                      data-action="change->wallonie-prime-card#calculateEauChaudeSanitaire">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-prime-card-target="resultIsolationConduites">0 €</span>
            </div>
          </div>

          <!-- ECS - Isolation échangeur plaques externe -->
          <div class="col-lg-4 col-md-6">
            <label class="form-label small">Isolation échangeur plaques :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-prime-card-target="inputEchangeurPlaques"
                      data-action="change->wallonie-prime-card#calculateEauChaudeSanitaire">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-prime-card-target="resultEchangeurPlaques">0 €</span>
            </div>
          </div>

          <!-- ECS - Isolation ballon ≤500l -->
          <div class="col-lg-4 col-md-6">
            <label class="form-label small">Isolation ballon ≤500l :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-prime-card-target="inputIsolationBallon500"
                      data-action="change->wallonie-prime-card#calculateEauChaudeSanitaire">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-prime-card-target="resultIsolationBallon500">0 €</span>
            </div>
          </div>

          <!-- ECS - Isolation ballon >500l -->
          <div class="col-lg-4 col-md-6">
            <label class="form-label small">Isolation ballon >500l :</label>
            <div class="input-group input-group-sm">
              <select class="form-control"
                      data-wallonie-prime-card-target="inputIsolationBallonSup"
                      data-action="change->wallonie-prime-card#calculateEauChaudeSanitaire">
                <option value="0">Non</option>
                <option value="1">Oui</option>
              </select>
              <span class="input-group-text bg-info text-white"
                    data-wallonie-prime-card-target="resultIsolationBallonSup">0 €</span>
            </div>
          </div>
        </div>

        <!-- Total Eau Chaude Sanitaire -->
        <div class="mt-3 pt-2 border-top">
          <div class="d-flex justify-content-between align-items-center">
            <strong class="text-info">Total Eau Chaude Sanitaire :</strong>
            <span class="badge bg-info fs-5" data-wallonie-prime-card-target="totalEauChaudeSanitaire">
              0 €
            </span>
          </div>

          <!-- Section conseil avec CTA connexion -->
          <div class="mt-2">
            <small class="text-primary">
              <i class="bi bi-lightbulb me-1"></i>
              Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>
