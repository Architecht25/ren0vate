<!-- CARTE 1: AUDIT - Simple (1 input) -->
<div class="col-xl-3 col-lg-4 col-md-6">
  <div class="card border-1 border-info border-opacity-50 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_realisation_audit_logement">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-search fs-5 text-info"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Audit énergétique</h6>
          <small class="text-muted">Forfaitaire</small>
        </div>
      </div>

      <!-- Input simple: Oui/Non (0 ou 1) -->
      <div class="mb-3">
        <label class="form-label small">Réalisation d'un audit :</label>
        <select class="form-select"
                data-wallonie-prime-card-target="inputAudit"
                data-action="change->wallonie-prime-card#calculateAudit">
          <option value="0">Non</option>
          <option value="1">Oui</option>
        </select>
      </div>

      <!-- Résultat -->
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Prime calculée :</span>
        <span class="badge bg-info fs-6" data-wallonie-prime-card-target="resultAudit">
          0 €
        </span>
      </div>

      <!-- Section conseil avec CTA connexion -->
      <div class="mt-2">
        <small class="text-primary">
          <i class="bi bi-lightbulb me-1"></i>
          Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
        </small>
      </div>
    </div>
  </div>
</div>
