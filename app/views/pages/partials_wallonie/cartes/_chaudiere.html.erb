<!-- CARTE 6: CHAUDIÈRE - Complexe (5 inputs) -->
<div class="col-lg-4 col-md-8">
  <div class="card border-1 border-warning border-opacity-50 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_chaudiere_global">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-thermometer fs-5 text-warning"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Systèmes Chauffage</h6>
          <small class="text-muted">5 types de systèmes</small>
        </div>
      </div>

      <div class="row g-3">
        <!-- PAC eau chaude -->
        <div class="col-lg-6 col-md-6">
          <label class="form-label small">PAC eau chaude :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputPacEauChaude"
                    data-action="change->wallonie-prime-card#calculateChaudiere">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultPacEauChaude">0 €</span>
          </div>
        </div>

        <!-- PAC chauffage -->
        <div class="col-lg-6 col-md-6">
          <label class="form-label small">PAC ECS + Chauffage :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputPacChauffage"
                    data-action="change->wallonie-prime-card#calculateChaudiere">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultPacChauffage">0 €</span>
          </div>
        </div>

        <!-- Chaudière biomasse -->
        <div class="col-lg-6 col-md-6">
          <label class="form-label small">Chaudière biomasse :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputChaudiereBiomasse"
                    data-action="change->wallonie-prime-card#calculateChaudiere">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultChaudiereBiomasse">0 €</span>
          </div>
        </div>

        <!-- Poêle biomasse -->
        <div class="col-lg-6 col-md-6">
          <label class="form-label small">Poêle biomasse :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputPoeleBiomasse"
                    data-action="change->wallonie-prime-card#calculateChaudiere">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultPoeleBiomasse">0 €</span>
          </div>
        </div>

        <!-- Chauffe-eau solaire -->
        <div class="col-lg-12">
          <label class="form-label small">Chauffe-eau solaire :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputChauffeEauSolaire"
                    data-action="change->wallonie-prime-card#calculateChaudiere">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultChauffeEauSolaire">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Chaudière -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-warning">Total Chauffage :</strong>
          <span class="badge bg-warning fs-5" data-wallonie-prime-card-target="totalChaudiere">
            0 €
          </span>
        </div>

        <!-- Section conseil avec CTA connexion -->
        <div class="mt-2">
          <small class="text-primary">
            <i class="bi bi-lightbulb me-1"></i>
            Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
