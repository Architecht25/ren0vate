<!-- CARTE 7: AMÉLIORATION CHAUFFAGE - Très complexe (9 inputs) -->
<div class="col-lg-4 col-md-4">
  <div class="card border-1 border-warning border-opacity-50 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_amelioration_chauffage_global">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-gear fs-5 text-warning"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Améliorations</h6>
          <small class="text-muted">9 améliorations</small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Isolation conduites de chauffage -->
        <div class="col-12">
          <label class="form-label small">Isolation conduites de chauffage :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputIsolationConduites"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultIsolationConduites">0 €</span>
          </div>
        </div>

        <!-- Isolation ballon ≤500l -->
        <div class="col-12">
          <label class="form-label small">Isolation ballon ≤500l :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputIsolationBallon500"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultIsolationBallon500">0 €</span>
          </div>
        </div>

        <!-- Isolation ballon >500l -->
        <div class="col-12">
          <label class="form-label small">Isolation ballon >500l :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputIsolationBallonPlus500"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultIsolationBallonPlus500">0 €</span>
          </div>
        </div>

        <!-- Circulateur max 3 logements -->
        <div class="col-12">
          <label class="form-label small">Circulateur (max 3 logements) :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputCirculateurMax3Logements"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultCirculateurMax3Logements">0 €</span>
          </div>
        </div>

        <!-- Circulateur min 4 logements -->
        <div class="col-12">
          <label class="form-label small">Circulateur (min 4 logements) :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputCirculateurMin4Logements"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultCirculateurMin4Logements">0 €</span>
          </div>
        </div>

        <!-- Remplacement ballon ≤500l -->
        <div class="col-12">
          <label class="form-label small">Remplacement ballon ≤500l :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputRemplacementBallon500"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultRemplacementBallon500">0 €</span>
          </div>
        </div>

        <!-- Remplacement ballon >500l -->
        <div class="col-12">
          <label class="form-label small">Remplacement ballon >500l :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputRemplacementBallonPlus500"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultRemplacementBallonPlus500">0 €</span>
          </div>
        </div>

        <!-- Minimum 5 vannes thermostatiques -->
        <div class="col-12">
          <label class="form-label small">Min 5 vannes thermostatiques :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputMin5VannesThermostatiques"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultMin5VannesThermostatiques">0 €</span>
          </div>
        </div>

        <!-- Vannes supplémentaires -->
        <div class="col-12">
          <label class="form-label small">Vannes supplémentaires :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   min="0"
                   class="form-control"
                   placeholder="Nombre"
                   data-wallonie-prime-card-target="inputVannesSupplementaires"
                   data-action="input->wallonie-prime-card#calculateAmeliorationChauffage">
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultVannesSupplementaires">0 €</span>
          </div>
        </div>

        <!-- Thermostat d'ambiance -->
        <div class="col-12">
          <label class="form-label small">Thermostat d'ambiance :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-wallonie-prime-card-target="inputThermostatAmbiance"
                    data-action="change->wallonie-prime-card#calculateAmeliorationChauffage">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-wallonie-prime-card-target="resultThermostatAmbiance">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Amélioration Chauffage -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-warning">Total Améliorations :</strong>
          <span class="badge bg-warning fs-6" data-wallonie-prime-card-target="totalAmeliorationChauffage">
            0 €
          </span>
        </div>

        <!-- Section conseil avec CTA connexion -->
        <div class="mt-2">
          <small class="text-primary">
            <i class="bi bi-lightbulb me-1"></i>
            Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
