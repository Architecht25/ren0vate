<!-- CARTE 10: INSTALLATIONS - Simples (2 inputs) -->
<div class="row mt-3">
  <div class="col-lg-6 col-md-6">
    <div class="card border-0 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_installation_electrique">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
            <i class="bi bi-lightning fs-5 text-warning"></i>
          </div>
            <div>
              <h6 class="card-title mb-1">Installation électrique</h6>
              <small class="text-muted">Remise en conformité</small>
            </div>
          </div>

          <!-- Input oui/non -->
          <div class="mb-3">
            <label class="form-label small">Remise en conformité :</label>
            <select class="form-select form-select-sm"
                    data-wallonie-prime-card-target="inputElectricite"
                    data-action="change->wallonie-prime-card#calculateElectricite">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
          </div>

          <!-- Résultat -->
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">Prime calculée :</span>
            <span class="badge bg-warning fs-6" data-wallonie-prime-card-target="resultElectricite">
              0 €
            </span>
          </div>

          <!-- Section conseil avec CTA connexion -->
          <div class="mt-2">
            <small class="text-primary">
              <i class="bi bi-lightbulb me-1"></i>
              Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
            </small>
          </div>

        </div>
      </div>
    </div>

    <div class="col-lg-6 col-md-6">
      <div class="card border-0 shadow-sm h-100" data-controller="wallonie-prime-card" data-wallonie-prime-card-slug-value="wallonie_installation_gaz">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
              <i class="bi bi-fire fs-5 text-danger"></i>
            </div>
            <div>
              <h6 class="card-title mb-1">Installation gaz</h6>
              <small class="text-muted">Remise en conformité</small>
            </div>
          </div>

          <!-- Input oui/non -->
          <div class="mb-3">
            <label class="form-label small">Remise en conformité :</label>
            <select class="form-select form-select-sm"
                    data-wallonie-prime-card-target="inputGaz"
                    data-action="change->wallonie-prime-card#calculateGaz">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
          </div>

          <!-- Résultat -->
          <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">Prime calculée :</span>
            <span class="badge bg-danger fs-6" data-wallonie-prime-card-target="resultGaz">
              0 €
            </span>
          </div>

          <!-- Section conseil avec CTA connexion -->
          <div class="mt-2">
            <small class="text-primary">
              <i class="bi bi-lightbulb me-1"></i>
              Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
            </small>
          </div>
        </div>
      </div>
    </div>
</div>
