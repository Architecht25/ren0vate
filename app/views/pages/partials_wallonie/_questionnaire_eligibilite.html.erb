<!-- Dispatcher pour les questionnaires d'éligibilité Wallonie par profil -->
<% case profile_type %>
<% when "particulier" %>
  <%= render "pages/partials_wallonie/eligibilite/particulier" %>
<% when "entreprise" %>
  <%= render "pages/partials_wallonie/eligibilite/entreprise" %>
<% when "syndic" %>
  <%= render "pages/partials_wallonie/eligibilite/syndic" %>
<% when "asbl" %>
  <%= render "pages/partials_wallonie/eligibilite/asbl" %>
<% when "bailleur" %>
  <%= render "pages/partials_wallonie/eligibilite/bailleur" %>
<% else %>
  <!-- Fallback si le profil n'est pas reconnu -->
  <div class="alert alert-warning">
    <h6 class="alert-heading">
      <i class="bi bi-exclamation-triangle me-1"></i>
      Profil non reconnu
    </h6>
    <p class="mb-0">
      Le profil sélectionné (<%= profile_type %>) n'est pas reconnu. Veuillez recommencer la sélection.
    </p>
    <button type="button" class="btn btn-outline-secondary mt-2" onclick="location.reload()">
      <i class="bi bi-arrow-clockwise me-1"></i>Recommencer
    </button>
  </div>
<% end %>

<!-- Bouton de validation du test -->
<div class="text-center mt-4">
  <button type="button"
          class="btn btn-success btn-lg"
          data-action="click->test-eligibilite-wallonie#validateTestWallonie"
          data-test-eligibilite-wallonie-target="validateButton"
          style="display: none;">
    <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
  </button>
</div>

<!-- Zone de résultat -->
<div data-test-eligibilite-wallonie-target="result" class="mt-4"></div>

<!-- Information complémentaire Wallonie -->
<div class="alert alert-info mt-3 mb-0">
  <h6 class="alert-heading">
    <i class="bi bi-info-circle me-1"></i>
    À savoir - Primes Wallonie
  </h6>
  <ul class="mb-0 small">
    <li><strong>Éligibilité :</strong> Toutes les conditions doivent être respectées</li>
    <li><strong>Région :</strong> Spécifique à la Wallonie (hors Communauté germanophone)</li>
    <li><strong>Professionnel :</strong> Entrepreneur inscrit BCE obligatoire</li>
    <li><strong>Âge logement :</strong> Minimum 15 ans pour la plupart des primes</li>
    <li><strong>Audit :</strong> Recommandé pour maximiser les primes</li>
  </ul>
</div>
