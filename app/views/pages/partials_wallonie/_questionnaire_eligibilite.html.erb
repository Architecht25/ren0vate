<!-- Test d'éligibilité Wallonie -->
<div id="eligibility-test-wallonie" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light">
      <h4 class="card-title mb-0">
        <i class="bi bi-check-circle text-success me-2"></i>
        Test d'éligibilité Wallonie
      </h4>
    </div>
    <div class="card-body">
      <form id="eligibilityFormWallonie" name="eligibilityFormWallonie" data-test-eligibilite-target="form">
        <% steps = {
          "localisation" => "Le logement est-il situé en Wallonie (hors Communauté germanophone) ?",
          "destination" => "Le bien est-il destiné à être habité à min 50% ?",
          "propriete" => "Êtes-vous propriétaire du logement (plein propriétaire, nu-propriétaire ou usufruitier ou co-propriétaire) ?",
          "residence_principale" => "Le logement sera-t-il occupé à titre de résidence principale dans les 24 mois suivant l'introduction de la demande des primes travaux ?",
          "age_logement" => "Le logement a-t-il été construit il y a plus de 15 ans (par rapport à la date de la demande) ?",
          "audit" => "Avez-vous effectué un audit (/!\) pas un PEB par un auditeur agréé ou prévoyez-vous d'en faire un ?",
          "entrepreneur" => "L'entrepreneur chargé des travaux est-il inscrit à la Banque Carrefour des Entreprises ?",
          "revenus" => "Après déduction de 5.000 € par enfant à charge, grossesse en cours ou personne de plus de 60 ans figurant sur les compositions de ménage concernées, le total des revenus imposables cumulés (y compris ceux des copropriétaires éventuels) dépasse-t-il 114.400 € ?",
          "factures_anciennes" => "Les travaux pour lesquels vous sollicitez une prime ont-ils des factures de solde émises il y a deux ans ou plus ?",
          "travaux_toiture" => "Prévoyez-vous uniquement de réaliser des travaux liés à l'isolation de votre toiture ?"
        } %>

        <% steps.each do |key, question| %>
          <div class="mb-3 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
            <h6 class="mb-3 text-dark"><%= question %></h6>
            <div class="d-flex gap-3">
              <div class="form-check">
                <input type="radio" class="form-check-input" name="<%= key %>" value="oui" data-action="click->test-eligibilite#handleAnswerWallonie" id="<%= key %>_oui">
                <label class="form-check-label" for="<%= key %>_oui">
                  <i class="bi bi-check-circle text-success me-1"></i>Oui
                </label>
              </div>
              <div class="form-check">
                <input type="radio" class="form-check-input" name="<%= key %>" value="non" data-action="click->test-eligibilite#handleAnswerWallonie" id="<%= key %>_non">
                <label class="form-check-label" for="<%= key %>_non">
                  <i class="bi bi-x-circle text-danger me-1"></i>Non
                </label>
              </div>
            </div>
          </div>
        <% end %>
      </form>

      <!-- Bouton de validation du test -->
      <div class="text-center mt-4">
        <button type="button"
                class="btn btn-success btn-lg"
                data-action="click->test-eligibilite#validateTestWallonie"
                data-test-eligibilite-target="validateButton"
                style="display: none;">
          <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
        </button>
      </div>

      <!-- Zone de résultat -->
      <div data-test-eligibilite-target="result" class="mt-4"></div>
    </div>
  </div>
</div>
