<div class="card shadow-lg border-0 mb-4">
  <div class="card-header bg-info text-white py-4">
    <h4 class="card-title mb-0 text-center">
      <i class="fas fa-question-circle me-3"></i>
      Questions complémentaires
    </h4>
  </div>
  <div class="card-body p-4">
    <p class="text-muted mb-4">
      Ces informations nous permettront d'affiner votre éligibilité et de personnaliser les recommandations d'aides.
    </p>

    <!-- Question 1: Première création d'entreprise -->
    <div class="mb-4">
      <label class="form-label fw-bold text-info">
        <i class="fas fa-rocket me-2"></i>
        S'agit-il de votre première création d'entreprise ?
      </label>
      <div class="d-flex gap-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="premiere_creation" id="premiere_creation_oui" value="oui">
          <label class="form-check-label" for="premiere_creation_oui">
            <i class="fas fa-check text-success me-1"></i> Oui
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="premiere_creation" id="premiere_creation_non" value="non">
          <label class="form-check-label" for="premiere_creation_non">
            <i class="fas fa-times text-danger me-1"></i> Non
          </label>
        </div>
      </div>
    </div>

    <!-- Question 2: Projet d'expansion -->
    <div class="mb-4">
      <label class="form-label fw-bold text-info">
        <i class="fas fa-expand-arrows-alt me-2"></i>
        Avez-vous un projet d'expansion ou de développement dans les 12 prochains mois ?
      </label>
      <div class="d-flex gap-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="projet_expansion" id="projet_expansion_oui" value="oui">
          <label class="form-check-label" for="projet_expansion_oui">
            <i class="fas fa-check text-success me-1"></i> Oui
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="projet_expansion" id="projet_expansion_non" value="non">
          <label class="form-check-label" for="projet_expansion_non">
            <i class="fas fa-times text-danger me-1"></i> Non
          </label>
        </div>
      </div>
    </div>

    <!-- Question 3: Transition numérique -->
    <div class="mb-4">
      <label class="form-label fw-bold text-info">
        <i class="fas fa-digital-tachograph me-2"></i>
        Planifiez-vous des investissements dans la transition numérique/digitale ?
      </label>
      <div class="d-flex gap-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="transition_numerique" id="transition_numerique_oui" value="oui">
          <label class="form-check-label" for="transition_numerique_oui">
            <i class="fas fa-check text-success me-1"></i> Oui
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="transition_numerique" id="transition_numerique_non" value="non">
          <label class="form-check-label" for="transition_numerique_non">
            <i class="fas fa-times text-danger me-1"></i> Non
          </label>
        </div>
      </div>
    </div>

    <!-- Question 4: Objectifs environnementaux -->
    <div class="mb-4">
      <label class="form-label fw-bold text-info">
        <i class="fas fa-leaf me-2"></i>
        Votre entreprise a-t-elle des objectifs de durabilité environnementale ?
      </label>
      <div class="d-flex gap-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="objectifs_environnementaux" id="objectifs_environnementaux_oui" value="oui">
          <label class="form-check-label" for="objectifs_environnementaux_oui">
            <i class="fas fa-check text-success me-1"></i> Oui
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="objectifs_environnementaux" id="objectifs_environnementaux_non" value="non">
          <label class="form-check-label" for="objectifs_environnementaux_non">
            <i class="fas fa-times text-danger me-1"></i> Non
          </label>
        </div>
      </div>
    </div>

    <!-- Question 5: Recrutement prévu -->
    <div class="mb-4">
      <label class="form-label fw-bold text-info">
        <i class="fas fa-user-plus me-2"></i>
        Prévoyez-vous d'embaucher du personnel dans les 18 prochains mois ?
      </label>
      <div class="d-flex gap-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="recrutement_prevu" id="recrutement_prevu_oui" value="oui">
          <label class="form-check-label" for="recrutement_prevu_oui">
            <i class="fas fa-check text-success me-1"></i> Oui
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="recrutement_prevu" id="recrutement_prevu_non" value="non">
          <label class="form-check-label" for="recrutement_prevu_non">
            <i class="fas fa-times text-danger me-1"></i> Non
          </label>
        </div>
      </div>
    </div>

    <!-- Question 6: Formation du personnel -->
    <div class="mb-4">
      <label class="form-label fw-bold text-info">
        <i class="fas fa-graduation-cap me-2"></i>
        Avez-vous des besoins de formation pour votre personnel actuel ?
      </label>
      <div class="d-flex gap-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="formation_personnel" id="formation_personnel_oui" value="oui">
          <label class="form-check-label" for="formation_personnel_oui">
            <i class="fas fa-check text-success me-1"></i> Oui
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="formation_personnel" id="formation_personnel_non" value="non">
          <label class="form-check-label" for="formation_personnel_non">
            <i class="fas fa-times text-danger me-1"></i> Non
          </label>
        </div>
      </div>
    </div>

    <!-- Question 7: Projet à l'international -->
    <div class="mb-4">
      <label class="form-label fw-bold text-info">
        <i class="fas fa-globe-americas me-2"></i>
        Votre entreprise a-t-elle des projets de développement à l'international ?
      </label>
      <div class="d-flex gap-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="projet_international" id="projet_international_oui" value="oui">
          <label class="form-check-label" for="projet_international_oui">
            <i class="fas fa-check text-success me-1"></i> Oui
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="projet_international" id="projet_international_non" value="non">
          <label class="form-check-label" for="projet_international_non">
            <i class="fas fa-times text-danger me-1"></i> Non
          </label>
        </div>
      </div>
    </div>

    <!-- Question 8: Besoin d'accompagnement -->
    <div class="mb-4">
      <label class="form-label fw-bold text-info">
        <i class="fas fa-handshake me-2"></i>
        Avez-vous besoin d'un accompagnement par des consultants externes ?
      </label>
      <div class="d-flex gap-3">
        <div class="form-check">
          <input class="form-check-input" type="radio" name="accompagnement_consultant" id="accompagnement_consultant_oui" value="oui">
          <label class="form-check-label" for="accompagnement_consultant_oui">
            <i class="fas fa-check text-success me-1"></i> Oui
          </label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="accompagnement_consultant" id="accompagnement_consultant_non" value="non">
          <label class="form-check-label" for="accompagnement_consultant_non">
            <i class="fas fa-times text-danger me-1"></i> Non
          </label>
        </div>
      </div>
    </div>

    <!-- Bouton de validation -->
    <div class="text-center mt-4">
      <button type="button" class="btn btn-info btn-lg px-5">
        <i class="fas fa-check-circle me-2"></i>
        Valider les réponses
      </button>
    </div>
  </div>
</div>
