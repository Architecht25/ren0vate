<div class="card shadow-lg border-0" id="simulation-results" style="display: none;" data-controller="simulation-results">
  <div class="card-header bg-success text-white py-3">
    <h4 class="card-title mb-0">
      <i class="fas fa-chart-line me-2"></i>
      Résultats de Simulation
    </h4>
  </div>
  <div class="card-body p-4">
    <!-- Statut global d'éligibilité -->
    <div class="mb-4 text-center">
      <div class="eligibility-status" data-simulation-results-target="globalStatus">
        <div class="alert alert-success d-flex align-items-center" style="display: none;" data-status="eligible">
          <i class="fas fa-check-circle me-2 fs-4"></i>
          <div>
            <strong>Entreprise éligible</strong>
            <br><small>Vous pouvez prétendre à plusieurs aides</small>
          </div>
        </div>
        <div class="alert alert-warning d-flex align-items-center" style="display: none;" data-status="partially-eligible">
          <i class="fas fa-exclamation-triangle me-2 fs-4"></i>
          <div>
            <strong>Éligibilité partielle</strong>
            <br><small>Certaines aides vous sont accessibles</small>
          </div>
        </div>
        <div class="alert alert-danger d-flex align-items-center" style="display: none;" data-status="not-eligible">
          <i class="fas fa-times-circle me-2 fs-4"></i>
          <div>
            <strong>Non éligible</strong>
            <br><small>Aucune aide disponible actuellement</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Taux d'éligibilité par catégorie -->
    <div class="category-eligibility">
      <h6 class="fw-bold mb-3 text-success">
        <i class="fas fa-percentage me-2"></i>
        Taux d'éligibilité par catégorie
      </h6>

      <!-- Transition économique -->
      <div class="mb-3" data-category="transition_economique">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-bold">
            <i class="fas fa-seedling me-2 text-success"></i>
            Transition économique
          </span>
          <span class="badge bg-success eligibility-rate" data-simulation-results-target="transitionRate">0%</span>
        </div>
        <div class="progress" style="height: 8px;">
          <div class="progress-bar bg-success" data-simulation-results-target="transitionProgress" style="width: 0%"></div>
        </div>
      </div>

      <!-- Investissements -->
      <div class="mb-3" data-category="investissements">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-bold">
            <i class="fas fa-hammer me-2 text-primary"></i>
            Investissements
          </span>
          <span class="badge bg-primary eligibility-rate" data-simulation-results-target="investissementsRate">0%</span>
        </div>
        <div class="progress" style="height: 8px;">
          <div class="progress-bar bg-primary" data-simulation-results-target="investissementsProgress" style="width: 0%"></div>
        </div>
      </div>

      <!-- Recrutement & Formation -->
      <div class="mb-3" data-category="recrutement_formation">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-bold">
            <i class="fas fa-user-plus me-2 text-info"></i>
            Recrutement & Formation
          </span>
          <span class="badge bg-info eligibility-rate" data-simulation-results-target="recrutementRate">0%</span>
        </div>
        <div class="progress" style="height: 8px;">
          <div class="progress-bar bg-info" data-simulation-results-target="recrutementProgress" style="width: 0%"></div>
        </div>
      </div>

      <!-- Expertise & Services -->
      <div class="mb-3" data-category="expertise_services">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-bold">
            <i class="fas fa-user-tie me-2 text-warning"></i>
            Expertise & Services
          </span>
          <span class="badge bg-warning text-dark eligibility-rate" data-simulation-results-target="expertiseRate">0%</span>
        </div>
        <div class="progress" style="height: 8px;">
          <div class="progress-bar bg-warning" data-simulation-results-target="expertiseProgress" style="width: 0%"></div>
        </div>
      </div>

      <!-- Nuisances chantier -->
      <div class="mb-3" data-category="nuisances_chantier">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-bold">
            <i class="fas fa-construction me-2 text-danger"></i>
            Nuisances chantier
          </span>
          <span class="badge bg-danger eligibility-rate" data-simulation-results-target="nuisancesRate">0%</span>
        </div>
        <div class="progress" style="height: 8px;">
          <div class="progress-bar bg-danger" data-simulation-results-target="nuisancesProgress" style="width: 0%"></div>
        </div>
      </div>

      <!-- Exportation -->
      <div class="mb-3" data-category="exportation">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-bold text-muted">
            <i class="fas fa-globe me-2 text-secondary"></i>
            Exportation
          </span>
          <span class="badge bg-secondary eligibility-rate">Suspendue</span>
        </div>
        <div class="progress" style="height: 8px;">
          <div class="progress-bar bg-secondary" style="width: 100%; opacity: 0.3;"></div>
        </div>
      </div>
    </div>

    <!-- Score global -->
    <div class="mt-4 p-3 bg-light rounded text-center">
      <h5 class="mb-2 text-success">Score d'éligibilité global</h5>
      <div class="d-flex align-items-center justify-content-center">
        <div class="me-3">
          <span class="fs-2 fw-bold text-success" data-simulation-results-target="globalScore">0%</span>
        </div>
        <div class="progress flex-grow-1" style="height: 20px; max-width: 200px;">
          <div class="progress-bar bg-success" data-simulation-results-target="globalProgress" style="width: 0%"></div>
        </div>
      </div>
      <small class="text-muted">Basé sur vos réponses aux critères d'éligibilité</small>
    </div>

    <!-- Actions recommandées -->
    <div class="mt-4">
      <h6 class="fw-bold text-success mb-3">
        <i class="fas fa-lightbulb me-2"></i>
        Recommandations
      </h6>
      <div class="recommendations" data-simulation-results-target="recommendations">
        <!-- Les recommandations apparaîtront ici dynamiquement -->
      </div>
    </div>
  </div>
</div>
