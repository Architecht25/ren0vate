<div class="card border-primary" data-workflow-target="step2">
  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">
      <i class="fas fa-check-circle me-2"></i>
      Vérification d'Éligibilité
    </h5>
  </div>
  <div class="card-body">
    <!-- Spinner de chargement -->
    <div class="text-center my-4" id="eligibility-loading">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Vérification en cours...</span>
      </div>
      <p class="mt-2">Analyse de votre éligibilité aux aides...</p>
    </div>

    <!-- Résultats d'éligibilité -->
    <div id="eligibility-results" style="display: none;">

      <!-- Toutes les aides -->
      <div class="mb-4">
        <h6 class="text-primary">
          <i class="fas fa-list me-2"></i>
          Toutes les Aides Disponibles (<span id="eligible-count">0</span>)
        </h6>
        <div id="eligible-aids" class="row">
          <!-- Contenu dynamique -->
        </div>
      </div>

      <!-- Actions -->
      <div class="text-center mt-4">
        <button type="button"
                class="btn btn-outline-secondary me-2"
                data-action="click->workflow#previousStep">
          <i class="fas fa-arrow-left me-2"></i>
          Modifier l'Entreprise
        </button>
        <button type="button"
                class="btn btn-success btn-lg"
                data-action="click->workflow#nextStep"
                id="proceed-to-calculator">
          <i class="fas fa-calculator me-2"></i>
          Calculer mes Aides
        </button>
      </div>
    </div>
  </div>
</div>
