<div class="card border-0 shadow-sm">
  <div class="card-body py-3">
    <div class="row align-items-center">
      <div class="col">
        <div class="progress-workflow d-flex justify-content-between align-items-center">
          <!-- Étape 1: Test d'éligibilité -->
          <div class="step-item" data-step="1">
            <div class="step-circle bg-primary text-white d-flex align-items-center justify-content-center">
              <i class="bi bi-shield-check"></i>
            </div>
            <div class="step-label mt-2">
              <small class="fw-bold">Éligibilité</small><br>
              <small class="text-muted">5 questions</small>
            </div>
          </div>

          <!-- Connecteur -->
          <div class="step-connector">
            <div class="connector-line bg-secondary"></div>
          </div>

          <!-- Étape 2: Simulation -->
          <div class="step-item" data-step="2">
            <div class="step-circle bg-secondary text-white d-flex align-items-center justify-content-center">
              <i class="bi bi-calculator"></i>
            </div>
            <div class="step-label mt-2">
              <small class="fw-bold">Simulation</small><br>
              <small class="text-muted">14 aides</small>
            </div>
          </div>

          <!-- Connecteur -->
          <div class="step-connector">
            <div class="connector-line bg-secondary"></div>
          </div>

          <!-- Étape 3: Application -->
          <div class="step-item" data-step="3">
            <div class="step-circle bg-secondary text-white d-flex align-items-center justify-content-center">
              <i class="bi bi-rocket-takeoff"></i>
            </div>
            <div class="step-label mt-2">
              <small class="fw-bold">Application</small><br>
              <small class="text-muted">Démarches</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.progress-workflow {
  position: relative;
}

.step-item {
  text-align: center;
  position: relative;
  z-index: 2;
}

.step-circle {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  margin: 0 auto;
  font-size: 18px;
  transition: all 0.3s ease;
}

.step-circle.active {
  transform: scale(1.1);
  box-shadow: 0 0 15px rgba(0,123,255,0.3);
}

.step-label {
  min-width: 80px;
}

.step-connector {
  flex: 1;
  position: relative;
  z-index: 1;
}

.connector-line {
  height: 3px;
  width: 100%;
  margin: 0 15px;
  transition: all 0.3s ease;
}

.connector-line.completed {
  background-color: #28a745 !important;
}
</style>
