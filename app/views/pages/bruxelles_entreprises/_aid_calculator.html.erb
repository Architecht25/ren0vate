<div class="card border-info" data-workflow-target="step3">
  <div class="card-header bg-info text-white">
    <h5 class="mb-0">
      <i class="fas fa-calculator me-2"></i>
      Calculateur d'Aides
    </h5>
  </div>
  <div class="card-body">

    <!-- Formulaire d'investissements -->
    <div id="investment-form">
      <div class="row">
        <div class="col-md-6">
          <h6 class="text-info mb-3">
            <i class="fas fa-euro-sign me-2"></i>
            Vos Investissements par Aide
          </h6>

          <!-- Les 14 aides de Bruxelles -->
          <div class="mb-3">
            <label for="investment-aid-25" class="form-label">
              Prime Transition Consultance
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-25" min="0" step="100" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-26" class="form-label">
              Prime Investissements Transition Économique
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-26" min="0" step="500" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-27" class="form-label">
              Prime Mobilité - Vélo-cargo
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-27" min="0" step="100" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-28" class="form-label">
              Prime Mobilité - Utilitaire électrique
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-28" min="0" step="1000" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-29" class="form-label">
              Prime Mobilité - Utilitaire rétrofit
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-29" min="0" step="1000" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-30" class="form-label">
              Prime Matériel ou Travaux
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-30" min="0" step="500" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-31" class="form-label">
              Prime Immobilier
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-31" min="0" step="1000" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-32" class="form-label">
              Prime Conformité aux normes
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-32" min="0" step="500" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-33" class="form-label">
              Prime Sécurisation de l'entreprise
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-33" min="0" step="500" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-34" class="form-label">
              Prime Accessibilité
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-34" min="0" step="500" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-35" class="form-label">
              Prime Formation
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-35" min="0" step="100" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-36" class="form-label">
              Prime Recrutement
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-36" min="0" step="100" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-37" class="form-label">
              Prime Consultance
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-37" min="0" step="100" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>

          <div class="mb-3">
            <label for="investment-aid-38" class="form-label">
              Prime Digitalisation
              <small class="text-muted">(€)</small>
            </label>
            <input type="number" class="form-control" id="investment-aid-38" min="0" step="100" placeholder="0" data-action="input->aid-calculator#calculateAids">
          </div>
        </div>

        <div class="col-md-6">
          <h6 class="text-success mb-3">
            <i class="fas fa-chart-pie me-2"></i>
            Estimation des Aides
          </h6>

          <!-- Résumé des investissements -->
          <div class="card bg-light mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between">
                <span>Total Investissements :</span>
                <strong id="total-investment" data-aid-calculator-target="totalInvestment">0 €</strong>
              </div>
            </div>
          </div>

          <!-- Calculs d'aides -->
          <div id="aid-calculations" data-aid-calculator-target="aidCalculations">
            <!-- Contenu dynamique généré par JavaScript -->
          </div>

          <!-- Total des aides -->
          <div class="card border-success mt-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center">
                <span class="h6 text-success mb-0">Total Aides Estimées :</span>
                <span class="h4 text-success mb-0" id="total-aids" data-aid-calculator-target="totalAids">0 €</span>
              </div>
              <small class="text-muted">
                Montant indicatif sous réserve d'acceptation des dossiers
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Résultats détaillés -->
    <div class="mt-4" id="detailed-results" data-aid-calculator-target="detailedResults" style="display: none;">
      <hr>
      <h6 class="text-info mb-3">
        <i class="fas fa-file-contract me-2"></i>
        Détail par Aide
      </h6>
      <div id="detailed-calculations">
        <!-- Contenu dynamique -->
      </div>
    </div>

    <!-- Actions finales -->
    <div class="text-center mt-4">
      <button type="button"
              class="btn btn-outline-secondary me-2"
              data-action="click->workflow#previousStep">
        <i class="fas fa-arrow-left me-2"></i>
        Revoir l'Éligibilité
      </button>
      <button type="button"
              class="btn btn-primary"
              data-action="click->aid-calculator#generateSummary">
        <i class="fas fa-file-pdf me-2"></i>
        Générer un Résumé
      </button>
      <button type="button"
              class="btn btn-success"
              data-action="click->aid-calculator#startApplications">
        <i class="fas fa-paper-plane me-2"></i>
        Commencer les Demandes
      </button>
    </div>
  </div>
</div>
