  <!-- Message d'information sur les majorations -->
  <div class="row mt-4 mb-4">
    <div class="col-12">
      <div class="alert alert-info border-0 shadow-sm">
        <div class="row align-items-center">
          <div class="col-md-8">
            <div class="d-flex align-items-center">
              <div class="me-3">
                <i class="bi bi-info-circle-fill text-info" style="font-size: 2rem;"></i>
              </div>
              <div>
                <h6 class="alert-heading mb-1 fw-bold">Estimation de base</h6>
                <p class="mb-0">
                  <strong>Ce simulateur affiche les taux de base.</strong> Votre entreprise peut bénéficier de majorations importantes selon :
                </p>
                <ul class="mb-0 mt-2 small">
                  <li><strong>Statut Starter</strong> : +10% à +15% pour les entreprises de moins de 4 ans</li>
                  <li><strong>Exemplarité</strong> : bonus pour projets innovants ou durables</li>
                  <li><strong>Zone géographique</strong> : majorations selon la localisation</li>
                  <li><strong>Cumuls optimisés</strong> : combinaisons intelligentes d'aides</li>
                </ul>
              </div>
            </div>
          </div>
          <div class="col-md-4 text-center">
            <div class="d-grid gap-2">
              <%= link_to new_user_session_path, class: "btn btn-primary btn-lg shadow-sm text-decoration-none" do %>
                <i class="bi bi-box-arrow-in-right me-2"></i>
                <strong>Se connecter</strong>
              <% end %>
              <%= link_to new_user_registration_path, class: "btn btn-success btn-lg shadow-sm text-decoration-none mt-2" do %>
                <i class="bi bi-person-plus me-2"></i>
                <strong>Créer un compte</strong>
              <% end %>
              <small class="text-muted mt-2 d-block">
