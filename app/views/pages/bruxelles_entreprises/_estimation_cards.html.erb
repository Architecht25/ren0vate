        <!-- Consultance transition -->
        <div class="mb-3">
          <label class="form-label fw-bold">Consultance transition</label>
          <div class="input-group">
            <span class="input-group-text">€</span>
            <input type="number" class="form-control" placeholder="0" min="0"
                   data-action="input->bruxelles-aides-estimation#calculateEstimate"
                   data-subcategory="consultance_transition">
          </div>
          <small class="text-muted">Taux: 75% • Plafond: 25.000€</small>
        </div>

        <!-- Investissements transition -->
        <div class="mb-3">
          <label class="form-label fw-bold">Investissements transition</label>
          <div class="input-group">
            <span class="input-group-text">€</span>
            <input type="number" class="form-control" placeholder="0" min="0"
                   data-action="input->bruxelles-aides-estimation#calculateEstimate"
                   data-subcategory="investissements_transition">
          </div>
          <small class="text-muted">Taux: 25% • Plafond: 200.000€</small>
        </div>

          <!-- Mobilité basses émissions -->
        <div class="mb-3">
          <label class="form-label fw-bold">Mobilité basses émissions</label>
          <div class="input-group">
            <span class="input-group-text">€</span>
            <input type="number" class="form-control" placeholder="0" min="0"
                   data-action="input->bruxelles-aides-estimation#calculateEstimate"
                   data-subcategory="mobilite_basses_emissions">
          </div>
          <small class="text-muted">Taux: 40% • Plafond: 4.000€</small>
        </div>


          <!-- Accessibilité des lieux -->
        <div class="mb-3">
          <label class="form-label fw-bold">Accessibilité des lieux</label>
          <div class="input-group">
            <span class="input-group-text">€</span>
            <input type="number" class="form-control" placeholder="0" min="0"
                   data-action="input->bruxelles-aides-estimation#calculateEstimate"
                   data-subcategory="accessibilite_lieux">
          </div>
          <small class="text-muted">Taux: 40% • Plafond: 4.000€</small>
        </div>


        <div class="estimation-result bg-light p-3 rounded mt-3" style="display: none;">
          <strong>Estimation totale: <span class="text-success estimation-amount">0€</span></strong>
        </div>
      </div>
    </div>
  </div>

