<!-- Étape 3: Accès à l'Application -->
<div class="card shadow-lg border-0">
  <div class="card-header bg-warning text-dark py-4">
    <div class="text-center">
      <h4 class="mb-1">
        <span class="badge bg-dark text-warning rounded-circle me-2">3</span>
        Accès à l'Application
      </h4>
      <p class="mb-0 opacity-75">Finalisez vos demandes d'aides avec notre plateforme intégrée</p>
    </div>
  </div>

  <div class="card-body p-5">
    <!-- Résumé des étapes précédentes -->
    <div class="row mb-4">
      <div class="col-md-6">
        <div class="card bg-light h-100">
          <div class="card-body text-center">
            <i class="bi bi-check-circle-fill text-success fs-2 mb-2"></i>
            <h6 class="text-success">Éligibilité Confirmée</h6>
            <p class="small text-muted mb-0">Votre entreprise répond aux critères</p>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card bg-light h-100">
          <div class="card-body text-center">
            <i class="bi bi-calculator-fill text-primary fs-2 mb-2"></i>
            <h6 class="text-primary">Simulation Complétée</h6>
            <p class="small text-muted mb-0" data-simulation-cards-target="summaryText">
              Aides estimées calculées
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Récapitulatif financier -->
    <div class="card border-success mb-4">
      <div class="card-header bg-success text-white">
        <h6 class="mb-0">
          <i class="bi bi-graph-up me-2"></i>
          Récapitulatif de votre Simulation
        </h6>
      </div>
      <div class="card-body">
        <div class="row text-center">
          <div class="col-md-4">
            <div class="p-3">
              <h5 class="text-primary mb-1" data-simulation-cards-target="finalTotalInvestment">0 €</h5>
              <small class="text-muted">Total Investissements</small>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-3 border-start border-end">
              <h5 class="text-success mb-1" data-simulation-cards-target="finalTotalAids">0 €</h5>
              <small class="text-muted">Total Aides Estimées</small>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-3">
              <h5 class="text-info mb-1" data-simulation-cards-target="finalSavings">0%</h5>
              <small class="text-muted">Économie Réalisée</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Options d'action -->
    <div class="row g-4 mb-4">

      <!-- Option 1: Plateforme complète -->
      <div class="col-md-6">
        <div class="card border-primary h-100">
          <div class="card-header bg-primary text-white">
            <h6 class="mb-0">
              <i class="bi bi-rocket-takeoff me-2"></i>
              Plateforme Complète
            </h6>
          </div>
          <div class="card-body d-flex flex-column">
            <p class="mb-3">
              Accédez à notre plateforme intégrée pour gérer toutes vos demandes d'aides avec accompagnement personnalisé.
            </p>
            <ul class="list-unstyled mb-4 flex-grow-1">
              <li><i class="bi bi-check text-success me-2"></i> Dossiers de demande pré-remplis</li>
              <li><i class="bi bi-check text-success me-2"></i> Suivi en temps réel</li>
              <li><i class="bi bi-check text-success me-2"></i> Support expert dédié</li>
              <li><i class="bi bi-check text-success me-2"></i> Documents automatisés</li>
            </ul>
            <button class="btn btn-primary btn-lg w-100"
                    data-action="click->application-access#goToFullPlatform">
              <i class="bi bi-arrow-right me-2"></i>
              Créer mon Compte
            </button>
          </div>
        </div>
      </div>

      <!-- Option 2: Téléchargement PDF -->
      <div class="col-md-6">
        <div class="card border-secondary h-100">
          <div class="card-header bg-secondary text-white">
            <h6 class="mb-0">
              <i class="bi bi-file-pdf me-2"></i>
              Rapport PDF
            </h6>
          </div>
          <div class="card-body d-flex flex-column">
            <p class="mb-3">
              Téléchargez un rapport détaillé de votre simulation pour préparer vos demandes en autonomie.
            </p>
            <ul class="list-unstyled mb-4 flex-grow-1">
              <li><i class="bi bi-check text-success me-2"></i> Résultats détaillés</li>
              <li><i class="bi bi-check text-success me-2"></i> Conditions d'éligibilité</li>
              <li><i class="bi bi-check text-success me-2"></i> Contacts utiles</li>
              <li><i class="bi bi-check text-success me-2"></i> Calendrier des démarches</li>
            </ul>
            <button class="btn btn-secondary btn-lg w-100"
                    data-action="click->application-access#downloadPDF">
              <i class="bi bi-download me-2"></i>
              Télécharger le PDF
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Informations complémentaires -->
    <div class="card bg-light">
      <div class="card-body">
        <h6 class="text-primary mb-3">
          <i class="bi bi-info-circle me-2"></i>
          Prochaines Étapes
        </h6>
        <div class="row">
          <div class="col-md-6">
            <ul class="list-unstyled mb-0">
              <li class="mb-2"><i class="bi bi-1-circle text-primary me-2"></i> <strong>Préparer vos documents</strong> (statuts, bilans, devis...)</li>
              <li class="mb-2"><i class="bi bi-2-circle text-primary me-2"></i> <strong>Déposer vos demandes</strong> avant le début des travaux</li>
              <li class="mb-2"><i class="bi bi-3-circle text-primary me-2"></i> <strong>Suivre l'instruction</strong> de vos dossiers</li>
            </ul>
          </div>
          <div class="col-md-6">
            <div class="text-center">
              <p class="small text-muted mb-2">Besoin d'aide ?</p>
              <a href="mailto:aides@economie-emploi.brussels" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-envelope me-1"></i>
                Contacter le Support
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Boutons de navigation -->
    <div class="d-flex justify-content-between mt-4">
      <button type="button" class="btn btn-outline-secondary"
              data-action="click->entreprise-workflow#backToSimulation">
        <i class="bi bi-arrow-left me-2"></i>
        Retour à la Simulation
      </button>

      <div>
        <button type="button" class="btn btn-outline-primary me-2"
                data-action="click->application-access#shareResults">
          <i class="bi bi-share me-2"></i>
          Partager
        </button>

        <button type="button" class="btn btn-outline-success"
                data-action="click->application-access#saveSimulation">
          <i class="bi bi-bookmark me-2"></i>
          Sauvegarder
        </button>
      </div>
    </div>
  </div>
</div>

