<div class="hero-section position-relative text-center text-white" style="background-image: url('<%= asset_path("renovation.jpg") %>'); background-size: cover; background-position: center; height: 100vh;">
  <div class="overlay position-absolute w-100 h-100" style="background: rgba(0, 0, 0, 0.5);"></div>
  <div class="container position-relative d-flex flex-column justify-content-center align-items-center h-100">
    <h1 class="display-4 mb-3">Estimez vos aides à la rénovation</h1>
    <p class="lead mb-4">Testez gratuitement votre éligibilité aux primes et subventions</p>

    <!-- Simulateurs Particuliers -->
    <h3 class="mb-3">Pour les particuliers</h3>
    <div class="btn-group d-flex flex-wrap justify-content-center gap-3 mb-4" role="group">
      <%= link_to "Flandre", flandre_path, class: "btn btn-outline-light btn-lg" %>
      <%= link_to "Wallonie", wallonie_path, class: "btn btn-outline-light btn-lg" %>
      <%= link_to "Bruxelles", bruxelles_path, class: "btn btn-outline-light btn-lg" %>
    </div>

    <!-- Simulateurs Entreprises -->
    <h3 class="mb-3">Pour les entreprises</h3>
    <div class="d-flex justify-content-center">
      <%= link_to bruxelles_entreprises_path, class: "btn btn-warning btn-lg" do %>
        <i class="fas fa-building me-2"></i>
        Aides aux Entreprises Bruxelles
        <span class="badge bg-light text-dark ms-2">NOUVEAU</span>
      <% end %>
    </div>
  </div>
</div>

<div class="reassurance-section text-center py-4 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <p class="mb-0"><strong>🕒 En 5 minutes</strong></p>
        <p>Testez votre éligibilité</p>
      </div>
      <div class="col-md-4">
        <p class="mb-0"><strong>🧾 Jusqu’à 35 000 €</strong></p>
        <p>De primes accessibles</p>
      </div>
      <div class="col-md-4">
        <p class="mb-0"><strong>🛡️ Aucun engagement</strong></p>
        <p>Modèle ‘no cure, no pay’</p>
      </div>
    </div>
  </div>
</div>

<footer class="text-center py-3 bg-dark text-white">
  <p class="mb-0">© 2025 Ren0vate</p>
  <p class="mb-0">
    <%= link_to "Mentions légales", legal_path, class: "text-white" %> |
    <%= link_to "Politique de confidentialité", privacy_path, class: "text-white" %>
  </p>
</footer>
