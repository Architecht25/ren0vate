<%
  set_seo_meta(
    title: "Ren0vate - Estimez gratuitement vos aides à la rénovation en Belgique",
    description: "Simulateurs gratuits pour estimer vos primes et aides à la rénovation énergétique. Pour particuliers et entreprises en Flandre, Bruxelles et Wallonie. Testez votre éligibilité en 2 minutes.",
    keywords: "primes rénovation belgique, aides énergétiques, isolation, chauffage, simulateur gratuit, flandre, bruxelles, wallonie, entreprises, particuliers",
    canonical_url: canonical_url_for(root_path),
    og_image: asset_url("renovation.jpg")
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_organization %>
  </script>
<% end %>

<div class="hero-section position-relative text-center text-white d-flex" style="background-image: url('<%= asset_path("renovation.jpg") %>'); background-size: cover; background-position: center; min-height: 100vh;">
  <div class="overlay position-absolute w-100 h-100" style="background: rgba(0, 0, 0, 0.5);"></div>
  <div class="container position-relative d-flex flex-column justify-content-center align-items-center h-100 py-5">
    <div class="text-center">
      <h1 class="display-5 display-md-4 mb-4 px-2 px-md-3">Calculez, gérez et introduisez vos Primes et Aides à la Rénovation</h1>
      <p class="lead mb-4 mb-md-5 px-2 px-md-3">Avant de vous connecter, testez votre éligibilité aux primes, estimez votre catégorie de revenus et calculez rapidement les primes et aides auxquelles vous pourriez prétendre en Flandre, à Bruxelles ainsi qu'en Wallonie.</p>

      <!-- Simulateurs Particuliers -->
      <h2 class="mb-3 mb-md-4 fs-4 fs-md-3">Simulateurs pour Particuliers</h2>
      <div class="d-flex flex-column flex-md-row justify-content-center gap-2 gap-md-3 mb-4 mb-md-5">
        <%= link_to "Primes Flandre", flandre_path, class: "btn btn-dark btn-lg text-white mx-1" %>
        <%= link_to "Primes Bruxelles", bruxelles_path, class: "btn btn-warning btn-lg text-dark mx-1" %>
        <%= link_to "Primes Wallonie", wallonie_path, class: "btn btn-danger btn-lg text-white mx-1" %>
      </div>

      <!-- Simulateurs Entreprises -->
      <h2 class="mb-3 mb-md-4 fs-4 fs-md-3">Simulateurs pour Entreprises</h2>
      <div class="d-flex flex-column flex-md-row justify-content-center gap-2 gap-md-3">
        <%= link_to "Aides Flandre", flandre_entreprises_path, class: "btn btn-dark btn-lg text-white mx-1" %>
        <%= link_to bruxelles_entreprises_path, class: "btn btn-warning btn-lg text-dark mx-1" do %>
          Aides Bruxelles
          <span class="badge bg-dark text-white ms-2">NOUVEAU</span>
        <% end %>
        <%= link_to "Aides Wallonie", wallonie_entreprises_path, class: "btn btn-danger btn-lg text-white mx-1" %>
      </div>
    </div>
  </div>
</div>

<!-- Section explicative SEO -->
<div class="py-5 bg-white">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 mx-auto text-center">
        <h2 class="mb-4">Primes et Aides à la Rénovation Énergétique en Belgique</h2>
        <p class="lead mb-4">
          Découvrez toutes les aides financières disponibles pour vos projets de rénovation énergétique.
          Isolation, chauffage, ventilation, toiture : nos simulateurs vous aident à estimer vos primes
          selon votre région et votre profil.
        </p>

        <div class="row mt-5">
          <div class="col-md-4 mb-4">
            <h3>Isolation Thermique</h3>
            <p>Murs, toiture, sols : de 2 000€ à 15 000€ de primes en moyenne selon votre région, bien immobilier et profil.</p>
          </div>
          <div class="col-md-4 mb-4">
            <h3>Systèmes de Chauffage</h3>
            <p>Pompes à chaleur, chaudières à condensation, chauffage au bois : bénéficiez d'aides substantielles.</p>
          </div>
          <div class="col-md-4 mb-4">
            <h3>Audit Énergétique</h3>
            <p>Première étape de votre rénovation : l'audit énergétique vous donne droit à des primes spécifiques.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="reassurance-section text-center py-4 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-md-4">
        <p class="mb-0"><strong>🕒 En 5 minutes</strong></p>
        <p>Testez votre éligibilité</p>
      </div>
      <div class="col-md-4">
        <p class="mb-0"><strong>💰 Primes moyennes</strong></p>
        <p>Particuliers: 10-35k€ | Entreprises: 5-20k€</p>
      </div>
      <div class="col-md-4">
        <p class="mb-0"><strong>🎯 Service SaaS</strong></p>
        <p>Accompagnement personnalisé</p>
      </div>
    </div>
  </div>
</div>

<footer class="bg-dark text-white py-4">
  <div class="container">
    <div class="row">
      <!-- Informations principales -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-house-heart-fill me-2"></i>
          Ren0vate
        </h6>
        <p class="small mb-2">
          Plateforme SaaS d'accompagnement complet pour vos primes à la rénovation énergétique en Belgique.
        </p>
        <p class="small text-muted mb-0">© 2025 Ren0vate</p>
      </div>

      <!-- Support & Contact -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-headset me-2"></i>
          Support & Contact
        </h6>
        <div class="small">
          <p class="mb-2">
            <i class="bi bi-telephone-fill me-2 text-success"></i>
            <a href="tel:+32485043745" class="text-white text-decoration-none">
              0485 043 745
            </a>
          </p>
          <p class="mb-2">
            <i class="bi bi-envelope-fill me-2 text-primary"></i>
            <a href="mailto:robin@architecht.eu" class="text-white text-decoration-none">
              robin@architecht.eu
            </a>
          </p>
          <p class="small text-muted mb-0">
            Lun-Ven: 9h-17h | Réponse < 24h
          </p>
        </div>
      </div>

      <!-- Liens légaux -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-shield-check me-2"></i>
          Informations légales
        </h6>
        <div class="small">
          <p class="mb-2">
            <a href="<%= legal_path %>" class="text-white text-decoration-none">
              <i class="bi bi-file-text me-2"></i>
              Mentions légales
            </a>
          </p>
          <p class="mb-0">
            <a href="<%= privacy_path %>" class="text-white text-decoration-none">
              <i class="bi bi-lock me-2"></i>
              Politique de confidentialité
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Séparateur -->
    <hr class="my-3 opacity-25">

    <!-- Liens sources officielles -->
    <div class="row">
      <div class="col-12 text-center">
        <p class="small text-muted mb-2">Sources officielles pour vérification :</p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
          <a href="https://renolution.brussels" target="_blank"
             class="text-white-50 text-decoration-none small">
            <i class="bi bi-link-45deg me-1"></i>Bruxelles
          </a>
          <a href="https://www.vlaanderen.be" target="_blank"
             class="text-white-50 text-decoration-none small">
            <i class="bi bi-link-45deg me-1"></i>Flandre
          </a>
          <a href="https://energie.wallonie.be" target="_blank"
             class="text-white-50 text-decoration-none small">
            <i class="bi bi-link-45deg me-1"></i>Wallonie
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
