<%
  set_seo_meta(
    title: "Ren0vate - Plateforme de gestion de chantiers de rénovation en Belgique",
    description: "Planifiez, coordonnez et suivez vos chantiers de rénovation de A à Z. Gestion des intervenants, suivi budgétaire, documents et planning. Pour propriétaires en Flandre, Bruxelles et Wallonie.",
    keywords: "gestion chantier rénovation belgique, suivi travaux, planification chantier, budget rénovation, entrepreneurs, architectes, flandre, bruxelles, wallonie, propriétaires",
    canonical_url: canonical_url_for(root_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_organization %>
  </script>
<% end %>

<!-- Hero Section - Style Carnet d'Architecte -->
<div class="architectural-hero position-relative d-flex min-vh-100"
     data-controller="architectural-parallax"
     data-architectural-parallax-hero-target="hero">

  <!-- Image de fond directe -->
  <img src="<%= asset_path('arcliine.jpg') %>"
       alt="Architectural watercolor background"
       class="architectural-bg-image"
       style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.2; z-index: 0;">

  <!-- Overlay léger pour la lisibilité -->
  <div class="architectural-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255, 255, 255, 0.3); z-index: 1;"></div>

  <!-- Sketch Overlay avec effet parallax -->
  <div class="sketch-overlay position-absolute w-100 h-100" style="top: 0; left: 0; z-index: 2;">
    <div class="blueprint-grid"></div>
    <div class="technical-lines"></div>
  </div>

  <div class="container position-relative d-flex flex-column justify-content-center align-items-center h-100 py-5" style="z-index: 3;">
    <div class="architectural-content text-center">
      <!-- Annotation principale -->
      <div class="architect-annotation mb-4">
        <span class="annotation-line"></span>
        <span class="annotation-text">PROJET RÉNOVATION</span>
      </div>

      <h1 class="architectural-title display-4 mb-4">Ren<span class="highlight-watercolor">0</span>vate</h1>
      <div class="subtitle-sketch mb-4">
        <p class="architect-subtitle">Plateforme complète de gestion de chantiers de rénovation<br>Planifiez, coordonnez et suivez vos travaux de A à Z</p>
        <div class="sketch-underline"></div>
        <div class="evolution-badge mt-3">
          <span class="badge bg-arch-orange text-white px-3 py-2">
            <i class="bi bi-tools me-1"></i>
            Gestion intégrée de vos chantiers de rénovation
          </span>
        </div>
      </div>

      <!-- Positionnement -->
      <div class="evolution-announcement mb-4">
        <div class="description-box bg-white border border-arch-orange">
          <div class="handwritten-note text-arch-orange mb-2">
            <i class="bi bi-building me-2"></i>
            <strong>Votre chantier, piloté de A à Z</strong>
          </div>
          <p class="text-ink small mb-0">
            Ren0vate centralise tout ce dont vous avez besoin pour gérer vos projets de rénovation :
            <strong>planification, intervenants, budget, documents et suivi des travaux</strong>.
            <br>
            <span class="text-muted">Une seule plateforme pour coordonner propriétaires, entrepreneurs et architectes en Belgique.</span>
          </p>
        </div>
      </div>

      <!-- Fonctionnalités clés avec style architectural -->
      <div class="annotated-section mb-5">
        <div class="architect-annotation mb-3">
          <span class="annotation-line"></span>
          <span class="annotation-text">FONCTIONNALITÉS</span>
        </div>

        <h2 class="h4 mb-4 text-ink">Tout pour gérer votre chantier</h2>
        <div class="row g-3 text-start">
          <div class="col-md-4">
            <div class="choice-box h-100">
              <div class="handwritten-note text-arch-blue mb-2">
                <i class="bi bi-calendar3 me-2"></i><strong>Planification</strong>
              </div>
              <small class="text-muted">Créez votre planning de travaux, définissez les jalons et suivez l'avancement en temps réel.</small>
            </div>
          </div>
          <div class="col-md-4">
            <div class="choice-box h-100">
              <div class="handwritten-note text-arch-orange mb-2">
                <i class="bi bi-people me-2"></i><strong>Intervenants</strong>
              </div>
              <small class="text-muted">Gérez vos entrepreneurs, architectes et fournisseurs depuis un seul endroit.</small>
            </div>
          </div>
          <div class="col-md-4">
            <div class="choice-box h-100">
              <div class="handwritten-note text-arch-green mb-2">
                <i class="bi bi-wallet2 me-2"></i><strong>Budget & Documents</strong>
              </div>
              <small class="text-muted">Suivez votre budget, centralisez devis, factures, contrats et photos de chantier.</small>
            </div>
          </div>
        </div>
      </div>

      <!-- Simulateurs Primes avec style architectural -->
      <div class="annotated-section mb-5">
        <div class="architect-annotation mb-3">
          <span class="annotation-line"></span>
          <span class="annotation-text">SIMULATEURS DE PRIMES</span>
        </div>

        <h2 class="h4 mb-4 text-ink">Simulateurs pour Particuliers</h2>
        <div class="region-buttons mb-4">
          <%= link_to "Primes Flandre", flandre_path,
              class: "btn-region-flandre",
              data: { region: "VL" } %>
          <%= link_to "Primes Bruxelles", bruxelles_path,
              class: "btn-region-bruxelles",
              data: { region: "BXL" } %>
          <%= link_to "Primes Wallonie", wallonie_path,
              class: "btn-region-wallonie",
              data: { region: "WAL" } %>
        </div>
      </div>
    </div>
  </div>
</div>

<footer class="bg-dark text-white py-4">
  <div class="container">
    <div class="row">
      <!-- Informations principales -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-house-heart-fill me-2"></i>
          Ren0vate
        </h6>
        <p class="small mb-2">
          Plateforme de gestion de chantiers de rénovation pour propriétaires, entrepreneurs et architectes en Belgique.
        </p>
        <p class="small text-muted mb-0">© 2026 Ren0vate</p>
      </div>

      <!-- Support & Contact -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-headset me-2"></i>
          Support & Contact
        </h6>
        <div class="small">
          <p class="mb-2">
            <i class="bi bi-telephone-fill me-2 text-success"></i>
            <a href="tel:+32485043745" class="text-white text-decoration-none">
              0485 043 745
            </a>
          </p>
          <p class="mb-2">
            <i class="bi bi-envelope-fill me-2 text-primary"></i>
            <a href="mailto:robin@architecht.be" class="text-white text-decoration-none">
              robin@architecht.be
            </a>
          </p>
          <p class="small text-muted mb-0">
            Lun-Ven: 9h-17h | Réponse < 24h
          </p>
        </div>
      </div>

      <!-- Liens légaux -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-shield-check me-2"></i>
          Informations légales
        </h6>
        <div class="small">
          <p class="mb-2">
            <a href="<%= legal_path %>" class="text-white text-decoration-none">
              <i class="bi bi-file-text me-2"></i>
              Mentions légales
            </a>
          </p>
          <p class="mb-0">
            <a href="<%= privacy_path %>" class="text-white text-decoration-none">
              <i class="bi bi-lock me-2"></i>
              Politique de confidentialité
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Séparateur -->
    <hr class="my-3 opacity-25">

    <!-- Couverture régionale -->
    <div class="row">
      <div class="col-12 text-center">
        <p class="small text-muted mb-2">Disponible dans les trois régions de Belgique :</p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
          <span class="text-white-50 small">
            <i class="bi bi-geo-alt me-1"></i>Bruxelles-Capitale
          </span>
          <span class="text-white-50 small">
            <i class="bi bi-geo-alt me-1"></i>Flandre
          </span>
          <span class="text-white-50 small">
            <i class="bi bi-geo-alt me-1"></i>Wallonie
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>
