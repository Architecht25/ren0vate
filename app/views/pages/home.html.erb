<%
  set_seo_meta(
    title: "Ren0vate - Plateforme de gestion de chantiers de rénovation en Belgique",
    description: "Planifiez, coordonnez et suivez vos chantiers de rénovation de A à Z. Gestion des intervenants, suivi budgétaire, documents et planning. Pour propriétaires en Flandre, Bruxelles et Wallonie.",
    keywords: "gestion chantier rénovation belgique, suivi travaux, planification chantier, budget rénovation, entrepreneurs, architectes, flandre, bruxelles, wallonie, propriétaires",
    canonical_url: canonical_url_for(root_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_organization %>
  </script>
<% end %>

<!-- ═══════════════════════════════════════════════════════ -->
<!--  WRAPPER GLOBAL (image de fond commune)                 -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="home-bg-wrapper">

  <!-- Image de fond couvrant hero + fonctionnalités + CTA -->
  <img src="<%= asset_path('arcliine.jpg') %>"
       alt="Rénovation architecturale"
       class="home-hero-bg"
       style="pointer-events:none;">

  <!-- Overlay dégradé -->
  <div class="home-hero-overlay" style="pointer-events:none;"></div>

  <!-- Grille blueprint déco -->
  <div class="home-hero-grid" style="pointer-events:none;"></div>

<!-- ═══════════════════════════════════════════════════════ -->
<!--  HERO                                                   -->
<!-- ═══════════════════════════════════════════════════════ -->
<div class="home-hero">

  <div class="container position-relative py-5" style="z-index:4;">
    <div class="row align-items-center g-5 py-4">

      <!-- Colonne texte -->
      <div class="col-lg-6">
        <div class="architect-annotation mb-4">
          <span class="annotation-line"></span>
          <span class="annotation-text">PROJET RÉNOVATION · BELGIQUE</span>
          <span class="annotation-line"></span>
        </div>

        <h1 class="architectural-title display-3 mb-3">
          Ren<span class="highlight-watercolor">0</span>vate
        </h1>

        <p class="home-hero-lead mb-4">
          Planifiez, coordonnez et suivez vos travaux de rénovation de A&nbsp;à&nbsp;Z.
          Une seule plateforme pour propriétaires, entrepreneurs et architectes en Belgique.
        </p>

        <div class="d-flex flex-wrap gap-3 mb-5">
          <%= link_to new_user_registration_path, class: "btn btn-accent btn-lg shadow-sm fw-semibold" do %>
            <i class="bi bi-person-plus me-2"></i>Créer mon espace gratuit
          <% end %>
          <%= link_to new_user_session_path, class: "btn btn-outline-primary btn-lg" do %>
            <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
          <% end %>
        </div>

        <!-- Preuves sociales mini -->
        <div class="d-flex flex-wrap gap-4 home-trust-badges">
          <span><i class="bi bi-shield-check text-accent me-1"></i>Sans engagement</span>
          <span><i class="bi bi-geo-alt text-accent me-1"></i>3 régions couvertes</span>
          <span><i class="bi bi-gift text-accent me-1"></i>Simulateur gratuit</span>
        </div>
      </div>

      <!-- Colonne simulateurs — mise en avant -->
      <div class="col-lg-6">
        <div class="home-sim-card">
          <div class="home-sim-card-header">
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="home-sim-badge">
                <i class="bi bi-stars me-1"></i>100% Gratuit
              </span>
            </div>
            <h2 class="h4 fw-bold mb-1" style="color:var(--ren0vate-text);">
              Simulateurs de primes régionaux
            </h2>
            <p class="small text-muted mb-0">
              Testez votre éligibilité et estimez vos montants en 2 minutes — sans inscription.
            </p>
          </div>

          <div class="home-sim-regions">

            <!-- Flandre -->
            <div class="home-sim-region home-sim-flandre">
              <div class="d-flex align-items-center gap-3 mb-2">
                <div class="home-sim-region-icon" style="background:rgba(0,97,184,0.12);color:#0061b8;">
                  <i class="bi bi-house-heart-fill"></i>
                </div>
                <div>
                  <div class="fw-semibold" style="color:var(--ren0vate-text);">Flandre</div>
                  <div class="small text-muted">Mijn VerbouwPremie · jusqu'à 8 000 €/mesure</div>
                </div>
              </div>
              <%= link_to flandre_path, class: "btn btn-flandre btn-sm w-100" do %>
                Simuler mes primes Flandre <i class="bi bi-arrow-right ms-1"></i>
              <% end %>
            </div>

            <!-- Bruxelles -->
            <div class="home-sim-region home-sim-bruxelles">
              <div class="d-flex align-items-center gap-3 mb-2">
                <div class="home-sim-region-icon" style="background:rgba(110,40,130,0.1);color:#6e2882;">
                  <i class="bi bi-buildings-fill"></i>
                </div>
                <div>
                  <div class="fw-semibold" style="color:var(--ren0vate-text);">Bruxelles</div>
                  <div class="small text-muted">Renolution · primes énergie & rénovation</div>
                </div>
              </div>
              <%= link_to bruxelles_path, class: "btn btn-bruxelles btn-sm w-100" do %>
                Simuler mes primes Bruxelles <i class="bi bi-arrow-right ms-1"></i>
              <% end %>
            </div>

            <!-- Wallonie -->
            <div class="home-sim-region home-sim-wallonie">
              <div class="d-flex align-items-center gap-3 mb-2">
                <div class="home-sim-region-icon" style="background:rgba(46,125,50,0.12);color:#2e7d32;">
                  <i class="bi bi-tree-fill"></i>
                </div>
                <div>
                  <div class="fw-semibold" style="color:var(--ren0vate-text);">Wallonie</div>
                  <div class="small text-muted">Primes habitation · catégories R1–R5</div>
                </div>
              </div>
              <%= link_to wallonie_path, class: "btn btn-wallonie btn-sm w-100" do %>
                Simuler mes primes Wallonie <i class="bi bi-arrow-right ms-1"></i>
              <% end %>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Vague bas -->
  <div class="home-hero-wave" style="pointer-events:none;"></div>
</div><!-- end .home-hero -->

<!-- ═══════════════════════════════════════════════════════ -->
<!--  FONCTIONNALITÉS PLATEFORME                             -->
<!-- ═══════════════════════════════════════════════════════ -->
<section class="home-features-section py-5">
  <div class="container">

    <div class="text-center mb-5">
      <div class="architect-annotation mb-3">
        <span class="annotation-line"></span>
        <span class="annotation-text">PLATEFORME DE GESTION</span>
        <span class="annotation-line"></span>
      </div>
      <h2 class="h3 fw-bold" style="color:var(--ren0vate-text);">Tout pour piloter votre chantier</h2>
      <p class="text-muted">De la demande de primes à la réception des travaux</p>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="home-feature-card h-100">
          <div class="home-feature-icon" style="background:rgba(51,65,85,0.08);color:var(--ren0vate-primary);">
            <i class="bi bi-kanban-fill fs-3"></i>
          </div>
          <h3 class="h5 fw-bold mt-3 mb-2">Planification</h3>
          <p class="text-muted small mb-0">
            Créez votre planning de travaux, définissez les jalons et suivez l'avancement en temps réel.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="home-feature-card h-100">
          <div class="home-feature-icon" style="background:rgba(217,119,6,0.1);color:var(--ren0vate-accent);">
            <i class="bi bi-people-fill fs-3"></i>
          </div>
          <h3 class="h5 fw-bold mt-3 mb-2">Intervenants</h3>
          <p class="text-muted small mb-0">
            Gérez vos entrepreneurs, architectes et fournisseurs depuis un seul endroit.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="home-feature-card h-100">
          <div class="home-feature-icon" style="background:rgba(132,169,140,0.15);color:var(--ren0vate-success-dark);">
            <i class="bi bi-wallet2 fs-3"></i>
          </div>
          <h3 class="h5 fw-bold mt-3 mb-2">Budget & Documents</h3>
          <p class="text-muted small mb-0">
            Centralisez devis, factures, contrats et photos. Suivez votre budget en un coup d'œil.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="home-feature-card h-100">
          <div class="home-feature-icon" style="background:rgba(51,65,85,0.08);color:var(--ren0vate-primary);">
            <i class="bi bi-file-earmark-check-fill fs-3"></i>
          </div>
          <h3 class="h5 fw-bold mt-3 mb-2">Dossiers de primes</h3>
          <p class="text-muted small mb-0">
            Formulaires pré-remplis, délais et documents requis pour chaque prime régionale.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="home-feature-card h-100">
          <div class="home-feature-icon" style="background:rgba(217,119,6,0.1);color:var(--ren0vate-accent);">
            <i class="bi bi-graph-up-arrow fs-3"></i>
          </div>
          <h3 class="h5 fw-bold mt-3 mb-2">Valorisation</h3>
          <p class="text-muted small mb-0">
            Estimez l'impact de vos travaux sur la valeur de votre bien et le label PEB.
          </p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="home-feature-card h-100">
          <div class="home-feature-icon" style="background:rgba(132,169,140,0.15);color:var(--ren0vate-success-dark);">
            <i class="bi bi-bell-fill fs-3"></i>
          </div>
          <h3 class="h5 fw-bold mt-3 mb-2">Alertes & Échéances</h3>
          <p class="text-muted small mb-0">
            Rappels automatiques pour vos délais de dépôt de dossiers et fin des régimes en vigueur.
          </p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════ -->
<!--  CTA BAS DE PAGE                                        -->
<!-- ═══════════════════════════════════════════════════════ -->
<section class="home-cta-section py-5">
  <div class="container">
    <div class="home-cta-box text-center">
      <h2 class="h3 fw-bold mb-3">Prêt à démarrer votre rénovation ?</h2>
      <p class="text-muted mb-4">
        Créez votre espace gratuit et commencez par simuler vos primes régionales.
      </p>
      <div class="d-flex flex-wrap justify-content-center gap-3">
        <%= link_to new_user_registration_path, class: "btn btn-accent btn-lg shadow-sm fw-semibold" do %>
          <i class="bi bi-person-plus me-2"></i>Créer mon espace gratuit
        <% end %>
        <%= link_to flandre_path, class: "btn btn-outline-primary btn-lg" do %>
          <i class="bi bi-calculator me-2"></i>Simuler mes primes
        <% end %>
      </div>
    </div>
  </div>
</section>

</div><!-- end .home-bg-wrapper -->

<footer class="bg-dark text-white py-4">
  <div class="container">
    <div class="row">
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3 text-arch-orange">
          <i class="bi bi-house-heart-fill me-2"></i>Ren0vate
        </h6>
        <p class="small mb-2">
          Plateforme de gestion de chantiers de rénovation pour propriétaires, entrepreneurs et architectes en Belgique.
        </p>
        <p class="small text-white-50 mb-0">© 2026 Ren0vate — ArchiTecht SRL</p>
      </div>
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3 text-arch-orange">
          <i class="bi bi-headset me-2"></i>Support & Contact
        </h6>
        <div class="small">
          <p class="mb-2">
            <i class="bi bi-telephone-fill me-2 text-success"></i>
            <a href="tel:+32485043745" class="text-white text-decoration-none">0485 043 745</a>
          </p>
          <p class="mb-2">
            <i class="bi bi-envelope-fill me-2 text-primary"></i>
            <a href="mailto:robin@architecht.be" class="text-white text-decoration-none">robin@architecht.be</a>
          </p>
          <p class="small text-light mb-0">Lun-Ven: 9h-17h | Réponse &lt; 24h</p>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3 text-arch-orange">
          <i class="bi bi-shield-check me-2"></i>Informations légales
        </h6>
        <div class="small">
          <p class="mb-2">
            <a href="<%= legal_path %>" class="text-white text-decoration-none">
              <i class="bi bi-file-text me-2"></i>Mentions légales
            </a>
          </p>
          <p class="mb-2">
            <a href="<%= privacy_path %>" class="text-white text-decoration-none">
              <i class="bi bi-lock me-2"></i>Politique de confidentialité
            </a>
          </p>
          <p class="mb-0">
            <a href="<%= terms_path %>" class="text-white text-decoration-none">
              <i class="bi bi-file-earmark-text me-2"></i>Conditions générales de vente
            </a>
          </p>
        </div>
      </div>
    </div>
    <hr class="my-3 opacity-25">
    <div class="row">
      <div class="col-12 text-center">
        <p class="small text-light mb-2">Disponible dans les trois régions de Belgique :</p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
          <span class="text-white small"><i class="bi bi-geo-alt me-1"></i>Bruxelles-Capitale</span>
          <span class="text-white small"><i class="bi bi-geo-alt me-1"></i>Flandre</span>
          <span class="text-white small"><i class="bi bi-geo-alt me-1"></i>Wallonie</span>
        </div>
      </div>
    </div>
  </div>
</footer>
