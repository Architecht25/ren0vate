<%
  set_seo_meta(
    title: "Ren0vate - Estimez gratuitement vos aides à la rénovation en Belgique",
    description: "Simulateurs gratuits pour estimer vos primes et aides à la rénovation énergétique. Pour particuliers et entreprises en Flandre, Bruxelles et Wallonie. Testez votre éligibilité en 2 minutes.",
    keywords: "primes rénovation belgique, aides énergétiques, isolation, chauffage, simulateur gratuit, flandre, bruxelles, wallonie, entreprises, particuliers",
    canonical_url: canonical_url_for(root_path),
    og_image: asset_url("renovation.jpg")
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_organization %>
  </script>
<% end %>

<!-- Hero Section - Style Carnet d'Architecte -->
<div class="architectural-hero position-relative d-flex min-vh-100"
     data-controller="architectural-parallax"
     data-architectural-parallax-hero-target="hero">

  <!-- Image de fond directe -->
  <img src="<%= asset_path('arcliine.jpg') %>"
       alt="Architectural watercolor background"
       class="architectural-bg-image">

  <!-- Overlay léger pour la lisibilité -->
  <div class="architectural-overlay"></div>

  <!-- Sketch Overlay avec effet parallax -->
  <div class="sketch-overlay position-absolute w-100 h-100">
    <div class="blueprint-grid"></div>
    <div class="technical-lines"></div>
  </div>

  <div class="container position-relative d-flex flex-column justify-content-center align-items-center h-100 py-5">
    <div class="architectural-content text-center">
      <!-- Annotation principale -->
      <div class="architect-annotation mb-4">
        <span class="annotation-line"></span>
        <span class="annotation-text">PROJET RÉNOVATION</span>
      </div>

      <h1 class="architectural-title display-4 mb-4">Ren<span class="highlight-watercolor">0</span>vate</h1>
      <div class="subtitle-sketch mb-4">
        <p class="architect-subtitle">Calculez, gérez, introduisez et suivez vos<br>Primes et Aides à la Rénovation partout en Belgique</p>
        <div class="sketch-underline"></div>
      </div>

      <!-- Description avec style annotation et choix de parcours -->
      <div class="architect-description mb-5">
        <div class="description-box">
          <!-- Options de parcours -->
          <div class="architect-choices mt-3">
            <div class="choice-annotation mb-2">
              <span class="annotation-line-small"></span>
              <span class="annotation-text-small">DEUX OPTIONS</span>
            </div>

            <div class="row g-2 text-center">
              <div class="col-md-6">
                <div class="choice-box">
                  <div class="handwritten-note small text-arch-blue mb-2">
                    <i class="bi bi-person-check me-1"></i>
                    <strong>Utilisez directement l'application et toutes ses fonctionnalités</strong>
                  </div>
                  <div class="choice-buttons">
                    <%= link_to new_user_session_path,
                        class: "btn-choice-primary me-2" do %>
                      <small>Se connecter</small>
                    <% end %>
                    <%= link_to new_user_registration_path,
                        class: "btn-choice-secondary" do %>
                      <small>Créer un compte</small>
                    <% end %>
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="choice-box">
                  <div class="handwritten-note small text-arch-green mb-2">
                    <i class="bi bi-calculator me-1"></i>
                    <strong>Faites un test rapide d'éligibilité avant de vous connecter</strong>
                  </div>
                  <div class="choice-scroll">
                    <small class="text-pencil">
                      <i class="bi bi-arrow-down me-1"></i>
                      Simulateurs ci-dessous
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Simulateurs Particuliers avec style architectural -->
      <div class="annotated-section mb-5">
        <div class="architect-annotation mb-3">
          <span class="annotation-line"></span>
          <span class="annotation-text">PARTICULIERS</span>
        </div>

        <h2 class="h4 mb-4 text-ink">Simulateurs pour Particuliers</h2>
        <div class="region-buttons mb-4">
          <%= link_to "Primes Flandre", flandre_path,
              class: "btn-region-flandre",
              data: { region: "VL" } %>
          <%= link_to "Primes Bruxelles", bruxelles_path,
              class: "btn-region-bruxelles",
              data: { region: "BXL" } %>
          <%= link_to "Primes Wallonie", wallonie_path,
              class: "btn-region-wallonie",
              data: { region: "WAL" } %>
        </div>
      </div>

      <!-- Simulateurs Entreprises avec style architectural -->
      <div class="annotated-section">
        <div class="architect-annotation mb-3">
          <span class="annotation-line"></span>
          <span class="annotation-text">ENTREPRISES</span>
        </div>

        <h2 class="h4 mb-4 text-ink">Simulateurs pour Entreprises</h2>
        <div class="region-buttons">
          <%= link_to "Aides Flandre", flandre_entreprises_path,
              class: "btn-region-flandre",
              data: { region: "VL-ENT" } %>
          <%= link_to bruxelles_entreprises_path,
              class: "btn-region-bruxelles",
              data: { region: "BXL-ENT" } do %>
            Aides Bruxelles
            <span class="badge bg-arch-orange text-white ms-2">NOUVEAU</span>
          <% end %>
          <%= link_to "Aides Wallonie", wallonie_entreprises_path,
              class: "btn-region-wallonie",
              data: { region: "WAL-ENT" } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Section explicative avec style carnet d'architecte -->
<div class="py-5 bg-paper paper-texture">
  <div class="container">
    <div class="row">
      <div class="col-lg-8 mx-auto">
        <!-- Titre avec annotation -->
        <div class="architect-annotation text-center mb-4">
          <span class="annotation-line"></span>
          <span class="annotation-text">GUIDE TECHNIQUE</span>
        </div>

        <h2 class="architectural-title text-center mb-4">Primes et Aides à la Rénovation Énergétique</h2>
        <div class="description-box mb-5">
          <p class="handwritten-note text-center">
            Découvrez toutes les aides financières disponibles pour vos projets de rénovation énergétique.<br>
            <strong>Isolation • Chauffage • Ventilation • Toiture</strong><br>
            Nos simulateurs vous aident à estimer vos primes selon votre région et votre profil.
          </p>
        </div>

        <div class="row mt-5">
          <div class="col-md-4 mb-4 position-relative">
            <div class="margin-note">Note 01</div>
            <div class="annotated-section">
              <h3 class="h5 text-arch-blue">Isolation Thermique</h3>
              <p class="small text-pencil">Murs, toiture, sols : de 2 000€ à 15 000€ de primes en moyenne selon votre région, bien immobilier et profil.</p>
            </div>
          </div>
          <div class="col-md-4 mb-4 position-relative">
            <div class="margin-note">Note 02</div>
            <div class="annotated-section">
              <h3 class="h5 text-arch-green">Systèmes de Chauffage</h3>
              <p class="small text-pencil">Pompes à chaleur, chaudières à condensation, chauffage au bois : bénéficiez d'aides substantielles.</p>
            </div>
          </div>
          <div class="col-md-4 mb-4 position-relative">
            <div class="margin-note">Note 03</div>
            <div class="annotated-section">
              <h3 class="h5 text-arch-ochre">Audit Énergétique</h3>
              <p class="small text-pencil">Première étape de votre rénovation : l'audit énergétique vous donne droit à des primes spécifiques.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Section de confiance avec style architectural -->
<div class="reassurance-section py-4 bg-arch-blue-light paper-texture">
  <div class="container">
    <div class="architect-annotation text-center mb-3">
      <span class="annotation-line"></span>
      <span class="annotation-text">SPÉCIFICATIONS</span>
    </div>

    <div class="row text-center">
      <div class="col-md-4 mb-3">
        <div class="d-flex align-items-center justify-content-center mb-2">
          <div class="architectural-icon me-2">⏱</div>
          <strong class="text-ink">En 5 minutes</strong>
        </div>
        <p class="small text-pencil mb-0">Testez votre éligibilité</p>
      </div>
      <div class="col-md-4 mb-3">
        <div class="d-flex align-items-center justify-content-center mb-2">
          <div class="architectural-icon me-2">💰</div>
          <strong class="text-ink">Primes moyennes</strong>
        </div>
        <p class="small text-pencil mb-0">Particuliers: 10-35k€ | Entreprises: 5-20k€</p>
      </div>
      <div class="col-md-4 mb-3">
        <div class="d-flex align-items-center justify-content-center mb-2">
          <div class="architectural-icon me-2">🎯</div>
          <strong class="text-ink">Service SaaS</strong>
        </div>
        <p class="small text-pencil mb-0">Accompagnement personnalisé</p>
      </div>
    </div>
  </div>
</div>

<footer class="bg-dark text-white py-4">
  <div class="container">
    <div class="row">
      <!-- Informations principales -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-house-heart-fill me-2"></i>
          Ren0vate
        </h6>
        <p class="small mb-2">
          Plateforme SaaS d'accompagnement complet pour vos primes à la rénovation énergétique en Belgique.
        </p>
        <p class="small text-muted mb-0">© 2025 Ren0vate</p>
      </div>

      <!-- Support & Contact -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-headset me-2"></i>
          Support & Contact
        </h6>
        <div class="small">
          <p class="mb-2">
            <i class="bi bi-telephone-fill me-2 text-success"></i>
            <a href="tel:+32485043745" class="text-white text-decoration-none">
              0485 043 745
            </a>
          </p>
          <p class="mb-2">
            <i class="bi bi-envelope-fill me-2 text-primary"></i>
            <a href="mailto:robin@architecht.be" class="text-white text-decoration-none">
              robin@architecht.be
            </a>
          </p>
          <p class="small text-muted mb-0">
            Lun-Ven: 9h-17h | Réponse < 24h
          </p>
        </div>
      </div>

      <!-- Liens légaux -->
      <div class="col-md-4 mb-3">
        <h6 class="fw-semibold mb-3">
          <i class="bi bi-shield-check me-2"></i>
          Informations légales
        </h6>
        <div class="small">
          <p class="mb-2">
            <a href="<%= legal_path %>" class="text-white text-decoration-none">
              <i class="bi bi-file-text me-2"></i>
              Mentions légales
            </a>
          </p>
          <p class="mb-0">
            <a href="<%= privacy_path %>" class="text-white text-decoration-none">
              <i class="bi bi-lock me-2"></i>
              Politique de confidentialité
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Séparateur -->
    <hr class="my-3 opacity-25">

    <!-- Liens sources officielles -->
    <div class="row">
      <div class="col-12 text-center">
        <p class="small text-muted mb-2">Sources officielles pour vérification :</p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
          <a href="https://renolution.brussels" target="_blank"
             class="text-white-50 text-decoration-none small">
            <i class="bi bi-link-45deg me-1"></i>Bruxelles
          </a>
          <a href="https://www.vlaanderen.be" target="_blank"
             class="text-white-50 text-decoration-none small">
            <i class="bi bi-link-45deg me-1"></i>Flandre
          </a>
          <a href="https://energie.wallonie.be" target="_blank"
             class="text-white-50 text-decoration-none small">
            <i class="bi bi-link-45deg me-1"></i>Wallonie
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
