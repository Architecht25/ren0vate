<% content_for :title, "Centre d'aide | Ren0vate" %>
<% content_for :meta_description, "Centre d'aide Ren0vate : guides pas à pas, tutoriels et ressources pour piloter vos chantiers de rénovation." %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-xl-10">

      <div class="text-center mb-5">
        <h1 class="fw-bold">Centre d'aide</h1>
        <p class="text-muted lead">Guides, tutoriels et ressources pour maîtriser Ren0vate.</p>
      </div>

      <!-- Recherche rapide (décorative pour l'instant) -->
      <div class="row justify-content-center mb-5">
        <div class="col-md-6">
          <div class="input-group shadow-sm">
            <span class="input-group-text bg-white border-end-0">
              <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" class="form-control border-start-0 ps-0"
                   placeholder="Rechercher un article…"
                   disabled>
            <span class="input-group-text bg-white border-start-0 text-muted" style="font-size:12px;">Bientôt disponible</span>
          </div>
        </div>
      </div>

      <!-- Catégories -->
      <div class="row g-4 mb-5">
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100 text-center p-3">
            <div class="card-body">
              <div class="fs-1 mb-3">🚀</div>
              <h5 class="fw-bold">Démarrage rapide</h5>
              <p class="text-muted small">Créer votre compte, ajouter un bien et lancer votre premier projet en 5 minutes.</p>
              <a href="#getting-started" class="btn btn-sm btn-outline-primary mt-2">Voir les guides</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100 text-center p-3">
            <div class="card-body">
              <div class="fs-1 mb-3">💶</div>
              <h5 class="fw-bold">Primes & subventions</h5>
              <p class="text-muted small">Simuler, comprendre et déposer vos demandes de primes régionales.</p>
              <a href="#primes" class="btn btn-sm btn-outline-primary mt-2">Voir les guides</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100 text-center p-3">
            <div class="card-body">
              <div class="fs-1 mb-3">👷</div>
              <h5 class="fw-bold">Collaboration pro</h5>
              <p class="text-muted small">Inviter et gérer vos architectes, entrepreneurs et intermédiaires.</p>
              <a href="#collaboration" class="btn btn-sm btn-outline-primary mt-2">Voir les guides</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100 text-center p-3">
            <div class="card-body">
              <div class="fs-1 mb-3">📄</div>
              <h5 class="fw-bold">Documents & OCR</h5>
              <p class="text-muted small">Uploader et analyser vos factures, devis et PV de réception.</p>
              <a href="#documents" class="btn btn-sm btn-outline-primary mt-2">Voir les guides</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100 text-center p-3">
            <div class="card-body">
              <div class="fs-1 mb-3">💳</div>
              <h5 class="fw-bold">Abonnement & facturation</h5>
              <p class="text-muted small">Gérer votre plan, vos paiements et vos factures Ren0vate.</p>
              <a href="#billing" class="btn btn-sm btn-outline-primary mt-2">Voir les guides</a>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100 text-center p-3">
            <div class="card-body">
              <div class="fs-1 mb-3">🔒</div>
              <h5 class="fw-bold">Sécurité & confidentialité</h5>
              <p class="text-muted small">Chiffrement, RGPD, données personnelles et bonnes pratiques.</p>
              <a href="#security" class="btn btn-sm btn-outline-primary mt-2">Voir les guides</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Démarrage rapide -->
      <h4 id="getting-started" class="fw-bold border-bottom pb-3 mb-4">
        <i class="bi bi-rocket-takeoff text-primary me-2"></i>Démarrage rapide
      </h4>

      <div class="row g-3 mb-5">
        <% [
          { icon: '🏠', title: 'Créer votre premier bien immobilier', time: '2 min', desc: 'Ajoutez l\'adresse, le type de bâtiment et la superficie de votre bien.' },
          { icon: '🔨', title: 'Lancer un projet de travaux', time: '3 min', desc: 'Définissez le type de travaux, les dates et le budget prévisionnel.' },
          { icon: '📱', title: 'Installer l\'application mobile', time: '1 min', desc: 'Ren0vate fonctionne comme une app mobile (PWA) sur iOS et Android.' },
          { icon: '📧', title: 'Configurer vos notifications', time: '2 min', desc: 'Choisissez les alertes que vous souhaitez recevoir par email.' },
        ].each do |article| %>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm p-3 h-100">
              <div class="d-flex gap-3 align-items-start">
                <span class="fs-4"><%= article[:icon] %></span>
                <div>
                  <h6 class="fw-semibold mb-1"><%= article[:title] %></h6>
                  <p class="text-muted small mb-1"><%= article[:desc] %></p>
                  <span class="badge bg-light text-muted border"><i class="bi bi-clock me-1"></i><%= article[:time] %></span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Section Primes -->
      <h4 id="primes" class="fw-bold border-bottom pb-3 mb-4">
        <i class="bi bi-cash-coin text-success me-2"></i>Primes & subventions
      </h4>

      <div class="row g-3 mb-5">
        <% [
          { icon: '🟢', title: 'Simuler vos primes en Wallonie', time: '5 min', desc: 'Utiliser le simulateur Wallonie pour estimer vos primes énergie et Renolution.' },
          { icon: '🟡', title: 'Simuler vos primes en Flandre', time: '5 min', desc: 'Calculer vos primes Mijn VerbouwPremie avec le simulateur Flandre.' },
          { icon: '📋', title: 'Déposer une demande de prime', time: '10 min', desc: 'Guide pas à pas pour compléter et soumettre un dossier de prime.' },
          { icon: '📁', title: 'Préparer vos pièces justificatives', time: '3 min', desc: 'Liste des documents requis selon le type de travaux et la région.' },
        ].each do |article| %>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm p-3 h-100">
              <div class="d-flex gap-3 align-items-start">
                <span class="fs-4"><%= article[:icon] %></span>
                <div>
                  <h6 class="fw-semibold mb-1"><%= article[:title] %></h6>
                  <p class="text-muted small mb-1"><%= article[:desc] %></p>
                  <span class="badge bg-light text-muted border"><i class="bi bi-clock me-1"></i><%= article[:time] %></span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Section Collaboration -->
      <h4 id="collaboration" class="fw-bold border-bottom pb-3 mb-4">
        <i class="bi bi-people text-info me-2"></i>Collaboration professionnelle
      </h4>

      <div class="row g-3 mb-5">
        <% [
          { icon: '🏛️', title: 'Inviter votre architecte', time: '2 min', desc: 'Envoyer une invitation à votre architecte pour qu\'il accède à votre projet.' },
          { icon: '🔧', title: 'Ajouter un entrepreneur', time: '2 min', desc: 'Lier un entrepreneur à votre projet et gérer ses accès.' },
          { icon: '📨', title: 'Gérer les invitations en attente', time: '2 min', desc: 'Suivre et relancer les invitations non acceptées.' },
          { icon: '👔', title: 'Guide pour les professionnels', time: '3 min', desc: 'Comment accéder aux projets de vos clients en tant que professionnel.' },
        ].each do |article| %>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm p-3 h-100">
              <div class="d-flex gap-3 align-items-start">
                <span class="fs-4"><%= article[:icon] %></span>
                <div>
                  <h6 class="fw-semibold mb-1"><%= article[:title] %></h6>
                  <p class="text-muted small mb-1"><%= article[:desc] %></p>
                  <span class="badge bg-light text-muted border"><i class="bi bi-clock me-1"></i><%= article[:time] %></span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- CTA Support -->
      <div class="text-center p-5 bg-primary bg-opacity-10 rounded-3 mt-4">
        <h4 class="fw-bold">Besoin d'aide personnalisée ?</h4>
        <p class="text-muted">Consultez la FAQ ou contactez notre équipe support.</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap mt-3">
          <%= link_to faq_path, class: "btn btn-outline-primary" do %>
            <i class="bi bi-question-circle me-2"></i>Voir la FAQ
          <% end %>
          <% if user_signed_in? && current_user.has_active_subscription? %>
            <%= link_to new_support_ticket_path, class: "btn btn-primary" do %>
              <i class="bi bi-headset me-2"></i>Support prioritaire 24h
            <% end %>
          <% else %>
            <a href="mailto:support@ren0vate.be" class="btn btn-primary">
              <i class="bi bi-envelope me-2"></i>Nous écrire
            </a>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
