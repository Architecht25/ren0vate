<% content_for :title, "Guide d'utilisation | Ren0vate" %>
<% content_for :meta_description, "Comment fonctionne Ren0vate selon votre profil : particulier, architecte, entrepreneur ou intermédiaire." %>
<% guide_profil = @guide_profil || 'proprietaire' %>

<%
  guide_steps = {
    'proprietaire' => [
      { icon: 'bi-person-circle', title: 'Mon profil', desc: "Indiquez votre région (Wallonie, Flandre, Bruxelles) : les règles de primes et tout le parcours en dépendent.", cta: ['Accéder à mon profil', :profile_path] },
      { icon: 'bi-house', title: 'Mes biens', desc: "Ajoutez votre bien immobilier (adresse, type de bien). C'est le point de départ obligatoire avant de créer un chantier.", cta: ['Voir mes biens', :properties_path] },
      { icon: 'bi-sliders', title: 'Mes chantiers', desc: "Créez votre premier chantier à partir d'un bien : vous atterrissez directement sur son onglet « Préparation ».", cta: ['Voir mes chantiers', :projects_path] },
      { icon: 'bi-piggy-bank', title: 'Financer mes travaux', desc: "En parallèle du chantier, chiffrez vos travaux et simulez les primes régionales et prêts disponibles.", cta: ['Financer mes travaux', :financement_path] },
      { icon: 'bi-robot', title: 'Mon chat IA', desc: "À tout moment, posez vos questions à l'assistant IA : il connaît déjà votre dossier et peut vous orienter.", cta: ['Ouvrir mon chat IA', :expert_decision_hub_index_path] },
    ],
    'architecte' => [
      { icon: 'bi-person-circle', title: 'Mon profil pro', desc: "Dès l'inscription, vous renseignez votre cabinet (nom, n° BCE) — pas de bien à ajouter, votre espace est tourné vers vos clients.", cta: ['Mon profil', :profile_path] },
      { icon: 'bi-person-plus', title: 'Inviter un client', desc: "Votre tableau de bord démarre vide : partagez votre lien personnel pour que vos clients s'inscrivent via vous.", cta: ['Inviter un client', :pro_referral_path] },
      { icon: 'bi-house', title: 'Le client crée son chantier', desc: "Une fois inscrit via votre lien, le client ajoute son bien et crée son chantier. Vous recevez un accès « en attente ».", cta: nil },
      { icon: 'bi-check2-circle', title: 'Accès confirmé', desc: "Le client confirme votre accès : vous rejoignez officiellement le chantier et pouvez y collaborer.", cta: nil },
      { icon: 'bi-briefcase', title: 'Mes projets', desc: "Vous suivez votre portefeuille de chantiers clients : documents, avancement des travaux, collaboration.", cta: ['Voir mes projets', :member_projects_path] },
    ],
    'entrepreneur' => [
      { icon: 'bi-person-circle', title: 'Mon profil pro', desc: "Inscription et sélection du profil Entrepreneur — pas de bien à ajouter, votre espace est tourné vers les chantiers sur lesquels vous intervenez.", cta: ['Mon profil', :profile_path] },
      { icon: 'bi-link-45deg', title: 'Rejoindre un chantier', desc: "Utilisez un lien d'invitation reçu (d'un client ou d'un autre professionnel) pour rejoindre un chantier existant — ou passez cette étape.", cta: nil },
      { icon: 'bi-person-plus', title: 'Inviter vos propres clients', desc: "Vous disposez aussi de votre lien personnel, si vous préférez inviter directement vos propres clients.", cta: ['Inviter un client', :pro_referral_path] },
      { icon: 'bi-briefcase', title: 'Mes projets', desc: "Retrouvez les chantiers sur lesquels vous êtes actif : documents, avancement des travaux.", cta: ['Voir mes projets', :member_projects_path] },
      { icon: 'bi-hammer', title: 'Faire remonter l\'avancement', desc: "Mettez à jour l'avancement des travaux au fil du chantier (bordereaux d'avancement).", cta: nil },
    ],
    'intermediaire' => [
      { icon: 'bi-person-circle', title: 'Ma structure', desc: "Dès l'inscription, vous renseignez votre structure (nom, n° BCE) — votre espace est tourné vers vos clients mis en relation.", cta: ['Mon profil', :profile_path] },
      { icon: 'bi-person-plus', title: 'Inviter un client', desc: "Votre tableau de bord démarre vide : partagez votre lien personnel pour mettre vos clients en relation avec Ren0vate.", cta: ['Inviter un client', :pro_referral_path] },
      { icon: 'bi-briefcase', title: 'Mes projets', desc: "Vous suivez votre portefeuille de clients mis en relation et l'avancement de leurs chantiers.", cta: ['Voir mes projets', :member_projects_path] },
    ],
  }

  resolve_path = ->(path) { path.is_a?(Symbol) ? send(path) : path }
%>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-xl-10">

      <div class="text-center mb-5">
        <h1 class="fw-bold">Guide d'utilisation</h1>
        <p class="text-muted lead">Comment fonctionne Ren0vate, selon votre profil.</p>
      </div>

      <!-- Sélecteur de profil -->
      <ul class="nav nav-pills justify-content-center gap-2 mb-5 tabs-scroll-x" id="guideProfilTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link<%= ' active' if guide_profil == 'proprietaire' %>" id="tab-proprietaire-btn" data-bs-toggle="pill" data-bs-target="#tab-proprietaire" type="button" role="tab">
            <i class="bi bi-house me-1"></i>Particulier
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link<%= ' active' if guide_profil == 'architecte' %>" id="tab-architecte-btn" data-bs-toggle="pill" data-bs-target="#tab-architecte" type="button" role="tab">
            <i class="bi bi-rulers me-1"></i>Architecte
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link<%= ' active' if guide_profil == 'entrepreneur' %>" id="tab-entrepreneur-btn" data-bs-toggle="pill" data-bs-target="#tab-entrepreneur" type="button" role="tab">
            <i class="bi bi-tools me-1"></i>Entrepreneur
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link<%= ' active' if guide_profil == 'intermediaire' %>" id="tab-intermediaire-btn" data-bs-toggle="pill" data-bs-target="#tab-intermediaire" type="button" role="tab">
            <i class="bi bi-people me-1"></i>Intermédiaire
          </button>
        </li>
      </ul>

      <div class="tab-content mb-5">
        <% guide_steps.each do |profil_key, steps| %>
          <div class="tab-pane fade<%= ' show active' if guide_profil == profil_key %>" id="tab-<%= profil_key %>" role="tabpanel">
            <h5 class="fw-bold mb-4"><i class="bi bi-signpost-2 text-success me-2"></i>Votre flux de progression</h5>
            <div class="timeline-container">
              <% steps.each do |step| %>
                <div class="timeline-phase active">
                  <div class="phase-header">
                    <div class="phase-number"><i class="bi <%= step[:icon] %>"></i></div>
                    <div class="phase-info">
                      <span class="phase-name"><%= step[:title] %></span>
                      <span class="phase-duration"><%= step[:desc] %></span>
                    </div>
                  </div>
                  <% if step[:cta] %>
                    <div class="phase-actions">
                      <%= link_to step[:cta][0], resolve_path.call(step[:cta][1]), class: "btn btn-sm btn-outline-primary" %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Espaces communs -->
      <h4 class="fw-bold border-bottom pb-3 mb-4">
        <i class="bi bi-grid-fill text-primary me-2"></i>Les espaces communs à tous les profils
      </h4>

      <div class="row g-4 mb-5">
        <div class="col-12 col-md-6">
          <div class="card border-0 shadow-sm h-100 p-3">
            <div class="card-body">
              <div class="fs-1 mb-2">📄</div>
              <h5 class="fw-bold">Mes documents</h5>
              <p class="text-muted small">Consultation des factures, devis et PV liés à vos biens ou chantiers.</p>
              <%= link_to "Voir mes documents →", documents_path, class: "small fw-semibold" %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="card border-0 shadow-sm h-100 p-3">
            <div class="card-body">
              <div class="fs-1 mb-2">🔔</div>
              <h5 class="fw-bold">Notifications</h5>
              <p class="text-muted small">Les alertes qui vous concernent : échéances, documents à traiter, mises à jour de dossier.</p>
              <%= link_to "Voir mes notifications →", notifications_path, class: "small fw-semibold" %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="card border-0 shadow-sm h-100 p-3">
            <div class="card-body">
              <div class="fs-1 mb-2">📰</div>
              <h5 class="fw-bold">Blog</h5>
              <p class="text-muted small">Articles d'actualité sur la rénovation, les primes et la réglementation.</p>
              <%= link_to "Lire le blog →", blog_index_path, class: "small fw-semibold" %>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-6">
          <div class="card border-0 shadow-sm h-100 p-3">
            <div class="card-body">
              <div class="fs-1 mb-2">🎧</div>
              <h5 class="fw-bold">Aide & support</h5>
              <p class="text-muted small">Un système de tickets pour contacter l'équipe en cas de question ou de blocage.</p>
              <%= link_to "Contacter le support →", support_tickets_path, class: "small fw-semibold" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Arc du chantier -->
      <h4 class="fw-bold border-bottom pb-3 mb-4">
        <i class="bi bi-flag text-success me-2"></i>Le parcours d'un chantier
      </h4>
      <p class="text-muted mb-4">Une fois le chantier créé, il traverse trois grandes étapes — visibles directement dans ses onglets.</p>

      <div class="row g-3 mb-5">
        <div class="col-12 col-md-4">
          <div class="card border-0 shadow-sm h-100 p-3 text-center">
            <div class="card-body">
              <i class="bi bi-clipboard-check fs-2 text-primary"></i>
              <h6 class="fw-semibold mt-2 mb-1">Préparation</h6>
              <p class="text-muted small mb-0">Cadrage du projet, choix de l'entrepreneur, devis.</p>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card border-0 shadow-sm h-100 p-3 text-center">
            <div class="card-body">
              <i class="bi bi-hammer fs-2 text-primary"></i>
              <h6 class="fw-semibold mt-2 mb-1">Suivi</h6>
              <p class="text-muted small mb-0">Avancement des travaux (démolition, installation, finitions) et documents liés.</p>
            </div>
          </div>
        </div>
        <div class="col-12 col-md-4">
          <div class="card border-0 shadow-sm h-100 p-3 text-center">
            <div class="card-body">
              <i class="bi bi-file-earmark-check fs-2 text-primary"></i>
              <h6 class="fw-semibold mt-2 mb-1">Clôture</h6>
              <p class="text-muted small mb-0">Réception des travaux, PV et documents finaux.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA Support -->
      <div class="text-center p-5 bg-primary bg-opacity-10 rounded-3 mt-4">
        <h4 class="fw-bold">Besoin d'aide personnalisée ?</h4>
        <p class="text-muted">Consultez la FAQ ou contactez notre équipe support.</p>
        <div class="d-flex gap-3 justify-content-center flex-wrap mt-3">
          <%= link_to faq_path, class: "btn btn-outline-primary" do %>
            <i class="bi bi-question-circle me-2"></i>Voir la FAQ
          <% end %>
          <% if user_signed_in? && current_user.has_active_subscription? %>
            <%= link_to new_support_ticket_path, class: "btn btn-primary" do %>
              <i class="bi bi-headset me-2"></i>Support prioritaire 24h
            <% end %>
          <% else %>
            <a href="mailto:robin@architecht.be" class="btn btn-primary">
              <i class="bi bi-envelope me-2"></i>Nous écrire
            </a>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
