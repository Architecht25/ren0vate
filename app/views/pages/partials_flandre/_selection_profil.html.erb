<!-- Sélection du profil — cartes visuelles -->
<div data-region-display-target="flandre" data-controller="user_type">
  <div class="row g-3 justify-content-center">
    <% [
      ["prive",      "bi-house-heart-fill", "primary",   "Propriétaire occupant",      "ou futur occupant — usage principal"],
      ["bailleur",   "bi-key-fill",         "info",      "Bailleur social",            "logement mis en location"],
      ["syndic",     "bi-people-fill",      "warning",   "Syndic de copropriété",      "parties communes d'un immeuble"],
      ["asbl",       "bi-shield-check",     "success",   "ASBL / Coopérative",         "entité sans but lucratif"],
      ["entreprise", "bi-building-fill",    "secondary", "Entreprise",                 "usage professionnel — non éligible"]
    ].each do |user, icon, color, label, sub| %>
      <div class="col-sm-6 col-lg-4">
        <button class="btn btn-outline-<%= color %> profile-card-btn w-100 text-start p-3 h-100"
                data-action="click->user_type#select"
                data-user="<%= user %>">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-<%= color %>-subtle rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:48px;height:48px;">
              <i class="bi <%= icon %> text-<%= color %> fs-4"></i>
            </div>
            <div>
              <div class="fw-semibold"><%= label %></div>
              <div class="text-muted small"><%= sub %></div>
            </div>
          </div>
        </button>
      </div>
    <% end %>
  </div>
</div>
