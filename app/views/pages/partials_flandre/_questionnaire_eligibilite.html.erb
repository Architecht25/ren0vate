<!-- Test d'éligibilité — mode wizard (une question à la fois) -->
<div id="eligibility-test"
     data-controller="test-eligibilite-flandre"
     data-wizard-mode="true">

  <%# Progress bar questions %>
  <div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <span class="small fw-semibold text-muted" data-test-eligibilite-flandre-target="questionCounter">Question 1 / 14</span>
      <span class="small text-muted">Répondez par Oui ou Non</span>
    </div>
    <div class="progress" style="height:6px;">
      <div class="progress-bar bg-info"
           role="progressbar"
           style="width:0%;transition:width .4s ease;"
           data-test-eligibilite-flandre-target="progressBar"></div>
    </div>
  </div>

  <form id="eligibilityForm" name="eligibilityForm" data-test-eligibilite-flandre-target="form">
    <% steps = {
      "usage"                 => { q: "Le bien est-il destiné à être habité ?", icon: "house-check" },
      "propriétaire"          => { q: "Êtes-vous propriétaire du bien (min 1%) ?", icon: "person-check" },
      "autre_bien"            => { q: "Possédez-vous un autre bien en pleine propriété (Belgique ou étranger) ?", icon: "buildings" },
      "annee"                 => { q: "Le bien a-t-il été construit avant le 1er janvier 2006 ?", icon: "calendar2-check" },
      "appartement"           => { q: "Le bien est-il un appartement individuel (hors copropriété VMA) ?", icon: "building-up" },
      "appartement-copro"     => { q: "Le bien est-il un appartement soumis à copropriété (VMA) ?", icon: "building-fill-gear" },
      "immeuble-appartements" => { q: "Le bien est-il un immeuble à appartements destinés au logement ?", icon: "building-fill" },
      "type"                  => { q: "Le bien est-il une maison ?", icon: "house-fill" },
      "facture_solde"         => { q: "La facture de solde des travaux date-t-elle de plus de 2 ans ?", icon: "receipt-cutoff" },
      "peb"                   => { q: "Le certificat PEB avant travaux indique-t-il un label E ou F ?", icon: "thermometer-sun" },
      "domicile"              => { q: "Serez-vous domicilié dans le bien rénové ?", icon: "geo-alt-fill" },
      "demolition"            => { q: "Le bien est-il une reconstruction après démolition (TVA 6%) ?", icon: "hammer" },
      "travaux"               => { q: "Prévoyez-vous des travaux d'isolation ou de chauffage ?", icon: "tools" },
      "protege"               => { q: "Êtes-vous un client protégé (tarif social énergie) ?", icon: "shield-fill-check" }
    } %>

    <% steps.each_with_index do |(key, data), idx| %>
      <div class="<%= idx == 0 ? 'question-active' : 'd-none' %> border rounded-3 p-4 mb-2 bg-white shadow-sm"
           data-test-eligibilite-flandre-target="formCard">
        <div class="d-flex gap-3 align-items-start mb-3">
          <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
               style="width:40px;height:40px;">
            <i class="bi bi-<%= data[:icon] %> text-info"></i>
          </div>
          <h6 class="mb-0 mt-2 text-dark fw-semibold"><%= data[:q] %></h6>
        </div>
        <div class="d-flex gap-3">
          <label class="flex-fill">
            <input type="radio" class="d-none" name="<%= key %>" value="oui"
                   data-action="click->test-eligibilite-flandre#handleAnswer"
                   id="<%= key %>_oui">
            <div class="btn btn-outline-success w-100 oui-btn" style="cursor:pointer;">
              <i class="bi bi-check-circle me-2"></i>Oui
            </div>
          </label>
          <label class="flex-fill">
            <input type="radio" class="d-none" name="<%= key %>" value="non"
                   data-action="click->test-eligibilite-flandre#handleAnswer"
                   id="<%= key %>_non">
            <div class="btn btn-outline-danger w-100 non-btn" style="cursor:pointer;">
              <i class="bi bi-x-circle me-2"></i>Non
            </div>
          </label>
        </div>
      </div>
    <% end %>
  </form>

  <%# Bouton retour question précédente %>
  <div class="text-start mt-3">
    <button type="button"
            class="btn btn-sm btn-outline-secondary"
            data-action="click->test-eligibilite-flandre#prevQuestion">
      <i class="bi bi-arrow-left me-1"></i>Question précédente
    </button>
  </div>

  <%# Bouton de validation (mode non-wizard fallback) %>
  <div class="text-center mt-4">
    <button type="button"
            class="btn btn-success btn-lg"
            data-action="click->test-eligibilite-flandre#validateTest"
            data-test-eligibilite-flandre-target="validateButton"
            style="display: none;">
      <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
    </button>
  </div>

  <div id="result"
       data-test-eligibilite-flandre-target="result"
       class="alert alert-info mt-4 text-center"
       style="display: none;"></div>

</div><%# fin test-eligibilite controller %>

  <form id="eligibilityForm" name="eligibilityForm" data-test-eligibilite-flandre-target="form">
