<!-- Message d'info initial -->
<div id="primes-placeholder" class="card border-0 shadow-sm text-center" style="display: none;">
  <div class="card-body py-5">
    <div class="text-primary mb-3">
      <i class="bi bi-info-circle fs-1"></i>
    </div>
    <h5 class="text-primary">Complétez le test d'éligibilité</h5>
    <p class="text-muted mb-0">Vos primes personnalisées apparaîtront ici selon votre catégorie.</p>
  </div>
</div>

<%
  # Helper pour récupérer la condition d'une prime
  def condition_prime(slug)
    prime = Prime.find_by(slug: slug)
    prime&.condition || "Conditions en cours de chargement..."
  end

  # Helper pour récupérer le conseil d'une prime
  def conseil_prime(slug)
    prime = Prime.find_by(slug: slug)
    prime&.conseil || "Conseil en cours de chargement..."
  end
%>

<!-- Simulation des primes -->
<div class="primes-section" data-controller="prime-calcul">
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-light">
      <h4 class="card-title mb-0">
        <i class="bi bi-calculator text-success me-2"></i>
        Vos primes éligibles - Catégorie <%= @categorie_id || '1' %>
      </h4>
    </div>
    <div class="card-body">
      <div class="row g-3">
    <% @primes.each do |prime| %>
      <% current_categorie = @categorie_id || '1' %>
      <% if prime.eligible_categories.include?(current_categorie.to_s) %>
        <div class="col-lg-4 col-md-6 col-12" data-controller="prime-card" data-slug="<%= prime.slug %>">
          <div class="card shadow-sm border-0 p-3 mb-3 h-100">
            <div class="card-body p-2">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-<%= prime.icon_name %> fs-5 text-success"></i>
                </div>
                <h6 class="card-title mb-0 flex-grow-1"><%= prime.titre %></h6>
              </div>

              <% if prime.slug == "isolation_murs_cat12" %>
                <!-- Carte spéciale : isolation murs cat 1-2 -->
                <div class="d-flex justify-content-between align-items-center gap-2"
                      data-controller="prime-card"
                      data-slug="<%= prime.slug %>">
                  <select class="form-select w-50 select-type-mur"
                          data-prime-card-target="select"
                          data-action="change->prime-card#update"
                          data-slug="<%= prime.slug %>">
                    <option value="0">Choisissez</option>
                    <option value="facades">façades</option>
                    <option value="murs_creux">murs creux</option>
                    <option value="murs_interieurs">murs intérieurs</option>
                  </select>
                  <input type="number"
                          class="form-control w-25 prime-input"
                          data-prime-card-target="input"
                          data-action="input->prime-card#update"
                          data-slug="<%= prime.slug %>"
                          placeholder="<%= placeholder_prime_flandre(prime, @category) %>">
                  <span class="input-group-text bg-success text-white prime-result"
                        data-slug="<%= prime.slug %>">
                    0 €
                  </span>
                </div>

                <!-- Informations contextuelles depuis la base de données -->
                <div class="mt-2">
                  <small class="text-muted d-block">
                    <i class="bi bi-info-circle me-1"></i>
                    Conditions : <%= condition_prime(prime.slug) %>
                  </small>
                  <small class="text-success d-block mt-1">
                    <i class="bi bi-lightbulb me-1"></i>
                    Conseil : <%= conseil_prime(prime.slug) %>
                  </small>
                </div>

              <% elsif prime.slug == "warmtepomp" %>

                <div class="d-flex justify-content-between align-items-center gap-2">
                  <!-- Sélecteur -->
                  <select class="form-select w-75"
                          data-action="change->prime-card#update"
                          data-prime-card-target="select">
                    <option value="0">Choisissez le type de pompe</option>
                    <option value="geothermique">geothermique</option>
                    <option value="air_eau">air eau</option>
                    <option value="air_air">air air</option>
                    <option value="hybride">hybride</option>
                  </select>

                  <!-- Montant -->
                  <span class="input-group-text bg-success text-white prime-result w-25 text-center"
                        data-slug="<%= prime.slug %>">
                    0 €
                  </span>
                </div>

                <!-- Informations contextuelles depuis la base de données -->
                <div class="mt-2">
                  <small class="text-muted d-block">
                    <i class="bi bi-info-circle me-1"></i>
                    Conditions : <%= condition_prime(prime.slug) %>
                  </small>
                  <small class="text-success d-block mt-1">
                    <i class="bi bi-lightbulb me-1"></i>
                    Conseil : <%= conseil_prime(prime.slug) %>
                  </small>
                </div>

              <% else %>
                <!-- Logique générale pour les autres primes -->
                <div class="d-flex justify-content-between align-items-center gap-2">
                  <input type="number"
                        class="form-control w-75 prime-input"
                        data-prime-card-target="input"
                        data-action="input->prime-card#update"
                        data-slug="<%= prime.slug %>"
                        placeholder="<%= placeholder_prime_flandre(prime, @category) %>">

                  <span class="input-group-text bg-success text-white prime-result"
                        data-slug="<%= prime.slug %>">
                    0 €
                  </span>
                </div>

                <!-- Informations contextuelles depuis la base de données -->
                <div class="mt-2">
                  <small class="text-muted d-block">
                    <i class="bi bi-info-circle me-1"></i>
                    Conditions : <%= condition_prime(prime.slug) %>
                  </small>
                  <small class="text-success d-block mt-1">
                    <i class="bi bi-lightbulb me-1"></i>
                    Conseil : <%= conseil_prime(prime.slug) %>
                  </small>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
      </div>

      <!-- Total estimé -->
      <div class="mt-4 p-3 bg-success bg-opacity-10 rounded">
        <div class="d-flex justify-content-between align-items-center">
          <h5 class="text-success mb-0">
            <i class="bi bi-calculator me-2"></i>
            Total estimé des primes :
          </h5>
          <span class="h4 text-success mb-0" id="total-primes-affiche">0.00 €</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Autres aides disponibles -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-light">
    <h5 class="card-title mb-0">
      <i class="bi bi-gift text-info me-2"></i>
      Autres aides disponibles
    </h5>
  </div>
  <div class="card-body">
    <div class="row g-3">
    <!-- Carte PEB Interactive -->
    <% if defined?(@prime_peb) %>
      <%= render 'shared/primes/prime_peb_card', prime_peb: @prime_peb %>
    <% else %>
      <%= render 'shared/primes/prime_peb_card', prime_peb: nil %>
    <% end %>

    <%= render 'pages/partials_flandre/primes_communales_card' %>

    <%= render 'pages/partials_flandre/prime_amiante_card' %>

    <%= render 'pages/partials_flandre/monuments_et_sites_card' %>    </div>
    </div>
  </div>
</div>
