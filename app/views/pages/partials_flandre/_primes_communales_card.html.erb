function calculateCommunales() {
  const selectElement = document.getElementById('prime_communale_select');
  const montantSection = document.getElementById('montant_section_communales');
  const resultSection = document.getElementById('result_section_communales');
  const selectedOption = selectElement.selectedOptions[0];

  if (!selectedOption || !selectedOption.value) {
    selectedPrime = null;
    montantSection.style.display = 'none';
    resultSection.style.display = 'none';
    updateCommunalesTotal();
    return;
  }

  // Récupérer les données de la prime sélectionnée
  selectedPrime = JSON.parse(selectedOption.dataset.primeData);
  console.log("Prime sélectionnée:", selectedPrime);

  // Afficher le champ montant
  montantSection.style.display = 'block';
  resultSection.style.display = 'block';

  // Calculer la prime
  const montantTravaux = parseFloat(document.getElementById('montant_travaux_communales').value) || 0;
  let primeCalculee = 0;
  let details = '';

  if (selectedPrime.type === 'api_externe') {
    // Prime venant de l'API Premiezoeker.be
    if (montantTravaux > 0) {
      // Tentative d'extraction du montant depuis les données API
      const sourceData = selectedPrime.sourceData;
      const bedragText = sourceData.bedrag || '';

      // Parser différents formats de montants
      if (bedragText.includes('€') && bedragText.includes('/m²')) {
        // Format: "€ 20/m²"
        const match = bedragText.match(/€\s*(\d+)/);
        if (match) {
          const euroParM2 = parseFloat(match[1]);
          const m2Estime = Math.floor(montantTravaux / 100); // Estimation 10m² pour 1000€
          primeCalculee = m2Estime * euroParM2;
          details = `(${m2Estime} m² estimés à ${euroParM2}€/m²)`;
        }
      } else if (bedragText.includes('%')) {
        // Format: "30% du montant"
        const match = bedragText.match(/(\d+)%/);
        if (match) {
          const pourcentage = parseFloat(match[1]) / 100;
          primeCalculee = montantTravaux * pourcentage;
          details = `(${match[1]}% du montant)`;
        }
      } else if (bedragText.includes('€') && !bedragText.includes('/')) {
        // Format: "€ 2000" (forfait)
        const match = bedragText.match(/€\s*(\d+)/);
        if (match) {
          primeCalculee = parseFloat(match[1]);
          details = '(montant forfaitaire)';
        }
      } else {
        // Format non reconnu, estimation par défaut
        primeCalculee = montantTravaux * 0.20; // 20% par défaut
        details = '(estimation 20% - voir détails officiels)';
      }
    }

    // Ajouter le lien vers les détails officiels
    if (selectedPrime.link) {
      details += ` - Détails: ${selectedPrime.link}`;
    }

  } else {
    // Prime de notre base locale (logique existante)
    if (montantTravaux > 0) {
      switch (selectedPrime.type) {
        case 'pourcentage':
          primeCalculee = montantTravaux * selectedPrime.valeur;
          if (selectedPrime.plafond && primeCalculee > selectedPrime.plafond) {
            primeCalculee = selectedPrime.plafond;
            details = `(plafond ${selectedPrime.plafond.toLocaleString()}€ atteint)`;
          }
          break;

        case 'forfait':
          primeCalculee = selectedPrime.valeur;
          details = '(montant forfaitaire)';
          break;

        case 'par_kw':
          // Pour les panneaux solaires, on estime 1kW pour 1000€ de travaux
          const kwEstime = Math.floor(montantTravaux / 1000);
          primeCalculee = kwEstime * selectedPrime.valeur;
          if (selectedPrime.plafond && primeCalculee > selectedPrime.plafond) {
            primeCalculee = selectedPrime.plafond;
            details = `(plafond ${selectedPrime.plafond.toLocaleString()}€ atteint)`;
          } else {
            details = `(${kwEstime} kW estimés)`;
          }
          break;

        case 'par_m2':
          // Pour les toitures vertes, on estime 10m² pour 1000€ de travaux
          const m2Estime = Math.floor(montantTravaux / 100);
          primeCalculee = m2Estime * selectedPrime.valeur;
          if (selectedPrime.plafond && primeCalculee > selectedPrime.plafond) {
            primeCalculee = selectedPrime.plafond;
            details = `(plafond ${selectedPrime.plafond.toLocaleString()}€ atteint)`;
          } else {
            details = `(${m2Estime} m² estimés)`;
          }
          break;
      }
    }
  }

  console.log("Calcul communales:", {
    prime: selectedPrime.nom,
    type: selectedPrime.type,
    montantTravaux,
    primeCalculee: primeCalculee.toFixed(2),
    details
  });

  // Afficher le résultat
  const resultElement = document.getElementById('result_communales');
  const detailsElement = document.getElementById('prime_details_communales');

  resultElement.textContent = primeCalculee.toFixed(2) + " €";
  detailsElement.innerHTML = details; // Utiliser innerHTML pour les liens

  // Couleur selon la source
  const alertDiv = resultElement.closest('.alert');
  if (selectedPrime.type === 'api_externe') {
    alertDiv.classList.remove('alert-warning');
    alertDiv.classList.add('alert-success');
  } else {
    alertDiv.classList.remove('alert-success');
    alertDiv.classList.add('alert-warning');
  }

  // Animation du résultat
  if (primeCalculee > 0) {
    resultElement.classList.add('text-success');
    resultElement.classList.remove('text-muted');
  } else {
    resultElement.classList.remove('text-success');
    resultElement.classList.add('text-muted');
  }

  updateCommunalesTotal();
}

function updateCommunalesTotal() {
  // Mettre à jour le total global via le système PEB existant
  const pebController = document.querySelector('[data-controller="peb"]');
  if (pebController && window.Stimulus) {
    const controller = window.Stimulus.getControllerForElementAndIdentifier(pebController, 'peb');
    if (controller && controller.mettreAJourTotalPrimes) {
      controller.mettreAJourTotalPrimes();
    }
  }
}

// Initialisation
document.addEventListener('DOMContentLoaded', function() {
  console.log("DOM chargé, initialisation primes communales");
});
</script>
