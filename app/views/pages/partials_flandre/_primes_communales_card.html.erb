<div class="col-lg-4 col-md-4 col-12">
  <div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
    <div class="card-body d-flex flex-column align-items-center gap-3">
      <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
        <i class="bi bi-building fs-5 text-warning"></i>
      </div>
      <h6 class="card-title mb-2">Primes Communales</h6>

      <!-- Formulaire de vérification -->
      <div class="w-100" style="max-width: 300px;">
        <div class="mb-3">
          <label for="code_postal_communales" class="form-label text-start w-100 small">Code postal</label>
          <input type="text"
                 class="form-control form-control-sm"
                 id="code_postal_communales"
                 placeholder="ex: 9000"
                 pattern="[0-9]{4}"
                 maxlength="4"
                 oninput="checkCommunalesPrimes()">
          <small class="text-muted">Saisissez votre code postal pour découvrir les primes disponibles</small>
        </div>

        <!-- Loading indicator -->
        <div class="mb-3" id="loading_communales" style="display: none;">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
            <small class="text-muted">Recherche en cours...</small>
          </div>
        </div>

        <!-- Statut de vérification -->
        <div class="mb-3" id="status_communales" style="display: none;">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <i id="status_icon_communales" class="bi"></i>
            <small id="status_text_communales" class="fw-bold"></small>
          </div>
        </div>

        <!-- Sélection des primes (si disponibles) -->
        <div class="mb-3" id="primes_selection" style="display: none;">
          <label for="prime_communale_select" class="form-label text-start w-100 small">Sélectionnez une prime</label>
          <select class="form-select form-select-sm" id="prime_communale_select" onchange="calculateCommunales()">
            <option value="">Choisir une prime...</option>
          </select>
        </div>

        <!-- Champ montant travaux (si prime sélectionnée) -->
        <div class="mb-3" id="montant_section_communales" style="display: none;">
          <label for="montant_travaux_communales" class="form-label text-start w-100 small">Montant des travaux (€)</label>
          <input type="number"
                 class="form-control form-control-sm"
                 id="montant_travaux_communales"
                 placeholder="0"
                 min="0"
                 step="0.01"
                 oninput="calculateCommunales()">
        </div>

        <!-- Résultat -->
        <div class="alert alert-warning alert-sm mb-2" id="result_section_communales" style="display: none;" role="alert">
          <small class="fw-bold">Prime estimée : </small>
          <span class="fw-bold prime-result" id="result_communales">0.00 €</span>
          <div class="mt-1">
            <small id="prime_details_communales" class="text-muted"></small>
          </div>
        </div>

        <small class="text-muted d-block">
          Les primes communales varient selon votre commune et le type de travaux
        </small>
      </div>
    </div>
  </div>
</div>

