function checkCommunalesPrimes() {
  const codePostal = document.getElementById('code_postal_communales').value.trim();
  const statusDiv = document.getElementById('status_communales');
  const loadingDiv = document.getElementById('loading_communales');
  const statusIcon = document.getElementById('status_icon_communales');
  const statusText = document.getElementById('status_text_communales');
  const primesSelection = document.getElementById('primes_selection');
  const montantSection = document.getElementById('montant_section_communales');
  const resultSection = document.getElementById('result_section_communales');

  // Reset
  clearTimeout(communalesDebounceTimer);

  // Validation code postal
  if (!codePostal) {
    statusDiv.style.display = 'none';
    primesSelection.style.display = 'none';
    montantSection.style.display = 'none';
    resultSection.style.display = 'none';
    updateCommunalesTotal();
    return;
  }

  if (!/^\d{4}$/.test(codePostal)) {
    statusDiv.style.display = 'block';
    loadingDiv.style.display = 'none';
    statusIcon.className = 'bi bi-exclamation-triangle-fill text-warning';
    statusText.textContent = 'Code postal invalide (4 chiffres)';
    statusText.className = 'fw-bold text-warning';
    primesSelection.style.display = 'none';
    montantSection.style.display = 'none';
    resultSection.style.display = 'none';
    updateCommunalesTotal();
    return;
  }

  console.log("Vérification primes communales pour:", codePostal);

  // Debounce pour éviter trop d'appels
  communalesDebounceTimer = setTimeout(() => {
    searchCommunalesPrimes(codePostal);
  }, 800);
}

async function searchCommunalesPrimes(codePostal) {
  const statusDiv = document.getElementById('status_communales');
  const loadingDiv = document.getElementById('loading_communales');
  const statusIcon = document.getElementById('status_icon_communales');
  const statusText = document.getElementById('status_text_communales');
  const primesSelection = document.getElementById('primes_selection');
  const montantSection = document.getElementById('montant_section_communales');
  const resultSection = document.getElementById('result_section_communales');

  // Afficher loading
  loadingDiv.style.display = 'block';
  statusDiv.style.display = 'none';

  try {
    // D'abord essayer l'API Premiezoeker.be avec les données réelles
    console.log("🔌 Appel API Premiezoeker.be pour:", codePostal);

    // Récupérer les détails de la commune pour construire l'URL
    const communeDetails = await getCommuneDetailsByPostalCode(codePostal);

    if (communeDetails && communeDetails.gemeente) {
      try {
        // Construire l'URL API Premiezoeker.be
        const apiUrl = `https://www.premiezoeker.be/api/v1/premies?gemeente=${encodeURIComponent(communeDetails.gemeente)}&postcode=${codePostal}&straat=&huisnummer=`;

        console.log("📞 URL API complète:", apiUrl);
        console.log("🏛️ Commune détectée:", communeDetails.gemeente);

        const response = await fetch(apiUrl, {
          method: 'GET',
          headers: {
            'Accept': 'application/json',
            'User-Agent': 'Mozilla/5.0 (compatible; RenovateApp/1.0)',
            'Origin': 'https://www.premiezoeker.be'
          },
          mode: 'cors'
        });

        console.log("📡 Réponse API:", response.status, response.statusText);
        console.log("📋 Headers réponse:", [...response.headers.entries()]);

        if (response.ok) {
          const primesData = await response.json();
          console.log("✅ Données API reçues:", primesData);
          console.log("📊 Nombre d'éléments:", primesData ? primesData.length : 0);

          if (primesData && Array.isArray(primesData) && primesData.length > 0) {
            console.log("🔍 Analyse des sources:", primesData.map(p => ({ titel: p.titel, bron: p.bron })));

            // Filtrer les primes communales uniquement
            const primesCommunales = primesData.filter(prime =>
              prime.bron && prime.bron.toLowerCase().includes('gemeente')
            );

            console.log("🏛️ Primes communales filtrées:", primesCommunales);

            if (primesCommunales.length > 0) {
              // Primes réelles trouvées via API
              statusIcon.className = 'bi bi-check-circle-fill text-success';
              statusText.textContent = `${communeDetails.gemeente} : ${primesCommunales.length} prime(s) officielle(s) disponible(s)`;
              statusText.className = 'fw-bold text-success';

              // Remplir le select avec les primes réelles
              const selectElement = document.getElementById('prime_communale_select');
              selectElement.innerHTML = '<option value="">Choisir une prime...</option>';

              primesCommunales.forEach((prime, index) => {
                const option = document.createElement('option');
                option.value = `api_${index}`;
                option.textContent = `${prime.titel} - ${prime.bedrag || 'Montant variable'}`;

                // Convertir la structure API vers notre format interne
                const primeFormatted = {
                  id: `api_${index}`,
                  nom: prime.titel,
                  type: 'api_externe',
                  description: prime.omschrijving || prime.bedrag || 'Prime communale officielle',
                  link: prime.link,
                  sourceData: prime
                };

                option.dataset.primeData = JSON.stringify(primeFormatted);
                selectElement.appendChild(option);
              });

              primesSelection.style.display = 'block';
              loadingDiv.style.display = 'none';
              statusDiv.style.display = 'block';
              return; // Succès avec API réelle
            } else {
              console.log("ℹ️ API a répondu mais aucune prime communale trouvée");
            }
          } else {
            console.log("ℹ️ API a répondu mais données vides ou incorrectes");
          }
        } else {
          console.log("❌ API a répondu avec erreur:", response.status, response.statusText);
        }

      } catch (apiError) {
        console.log("⚠️ Erreur API Premiezoeker.be:", apiError.message);
        console.log("🔧 Type d'erreur:", apiError.name);
        console.log("📍 Stack:", apiError.stack);
      }
    } else {
      console.log("❌ Commune non trouvée dans le mapping pour:", codePostal);
    }

    // Fallback : charger les données depuis le fichier JSON
    console.log("🔄 Fallback vers fichier JSON des primes communales");

    try {
      const jsonResponse = await fetch('/data/primes_communales.json', {
        method: 'GET',
        headers: {
          'Accept': 'application/json'
        }
      });

      if (jsonResponse.ok) {
        const primesJsonData = await jsonResponse.json();
        console.log("📄 Données JSON chargées:", primesJsonData.metadata);

        // Cacher loading
        loadingDiv.style.display = 'none';
        statusDiv.style.display = 'block';

        // Vérifier les données pour cette commune
        const communeData = primesJsonData.communes[codePostal];

        if (communeData && communeData.primes.length > 0) {
          // Primes trouvées dans le JSON
          statusIcon.className = 'bi bi-check-circle-fill text-warning';
          statusText.textContent = `${communeData.commune} : ${communeData.primes.length} prime(s) disponible(s) (base de données locale)`;
          statusText.className = 'fw-bold text-warning';

          // Remplir le select avec les primes du JSON
          const selectElement = document.getElementById('prime_communale_select');
          selectElement.innerHTML = '<option value="">Choisir une prime...</option>';

          communeData.primes.forEach(prime => {
            const option = document.createElement('option');
            option.value = prime.id;
            option.textContent = `${prime.nom} - ${prime.description}`;
            option.dataset.primeData = JSON.stringify(prime);
            selectElement.appendChild(option);
          });

          primesSelection.style.display = 'block';

        } else {
          // Fallback vers la base locale JavaScript si pas dans JSON
          console.log("🔄 Double fallback vers base JavaScript locale");

          const communeDataJS = communalesPrimesData[codePostal];

          if (communeDataJS && communeDataJS.primes.length > 0) {
            statusIcon.className = 'bi bi-check-circle-fill text-warning';
            statusText.textContent = `${communeDataJS.commune} : ${communeDataJS.primes.length} prime(s) référencée(s) (base de secours)`;
            statusText.className = 'fw-bold text-warning';

            const selectElement = document.getElementById('prime_communale_select');
            selectElement.innerHTML = '<option value="">Choisir une prime...</option>';

            communeDataJS.primes.forEach(prime => {
              const option = document.createElement('option');
              option.value = prime.id;
              option.textContent = `${prime.nom} - ${prime.description}`;
              option.dataset.primeData = JSON.stringify(prime);
              selectElement.appendChild(option);
            });

            primesSelection.style.display = 'block';
          } else {
            // Aucune prime trouvée
            statusIcon.className = 'bi bi-info-circle-fill text-info';
            statusText.textContent = 'Aucune prime communale trouvée pour ce code postal';
            statusText.className = 'fw-bold text-info';
            primesSelection.style.display = 'none';
            montantSection.style.display = 'none';
            resultSection.style.display = 'none';
            updateCommunalesTotal();
          }
        }

      } else {
        console.log("❌ Erreur chargement JSON:", jsonResponse.status);
        throw new Error("Impossible de charger le fichier JSON");
      }

    } catch (jsonError) {
      console.log("⚠️ Erreur chargement JSON, fallback JS:", jsonError.message);

      // Triple fallback vers la base JavaScript locale
      loadingDiv.style.display = 'none';
      statusDiv.style.display = 'block';

      const communeData = communalesPrimesData[codePostal];

      if (communeData && communeData.primes.length > 0) {
        statusIcon.className = 'bi bi-check-circle-fill text-warning';
        statusText.textContent = `${communeData.commune} : ${communeData.primes.length} prime(s) référencée(s) (base de secours)`;
        statusText.className = 'fw-bold text-warning';

        const selectElement = document.getElementById('prime_communale_select');
        selectElement.innerHTML = '<option value="">Choisir une prime...</option>';

        communeData.primes.forEach(prime => {
          const option = document.createElement('option');
          option.value = prime.id;
          option.textContent = `${prime.nom} - ${prime.description}`;
          option.dataset.primeData = JSON.stringify(prime);
          selectElement.appendChild(option);
        });

        primesSelection.style.display = 'block';

      } else {
        statusIcon.className = 'bi bi-info-circle-fill text-info';
        statusText.textContent = 'Aucune prime communale trouvée pour ce code postal';
        statusText.className = 'fw-bold text-info';
        primesSelection.style.display = 'none';
        montantSection.style.display = 'none';
        resultSection.style.display = 'none';
        updateCommunalesTotal();
      }
    }

  } catch (error) {
    console.error("❌ Erreur générale recherche primes:", error);

    loadingDiv.style.display = 'none';
    statusDiv.style.display = 'block';
    statusIcon.className = 'bi bi-exclamation-triangle-fill text-warning';
    statusText.textContent = 'Erreur de recherche';
    statusText.className = 'fw-bold text-warning';
    primesSelection.style.display = 'none';
    montantSection.style.display = 'none';
    resultSection.style.display = 'none';
    updateCommunalesTotal();
  }
}

