<%
  seo_data = region_seo_data('wallonie')
  set_seo_meta(
    title: seo_data[:title],
    description: seo_data[:description],
    keywords: seo_data[:keywords],
    canonical_url: canonical_url_for(wallonie_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_service('wallonie', 'particuliers') %>
  </script>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  // Initialisation automatique de la région Wallonie dès que le DOM est prêt
  document.addEventListener('DOMContentLoaded', function() {
    localStorage.setItem("region", "wallonie");
    console.log('🌍 Région Wallonie initialisée dans localStorage');
  });

  // Données des primes Wallonie
  window.primes = <%= raw(@primes.to_json(
    only: [:slug, :titre, :unite, :type_de_valeur, :valeurs_par_categorie, :placeholder, :condition, :conseil, :document, :eligible_categories]
  )) if @primes %>;
</script>

<!-- Données pour le calcul des primes Wallonie -->
<script type="application/json" id="wallonie-primes-data">
  <%= raw(@primes.each_with_object({}) { |prime, hash|
    hash[prime.slug] = {
      titre: prime.titre,
      valeurs_par_categorie: prime.valeurs_par_categorie || {},
      eligible_categories: prime.eligible_categories || []
    }
  }.to_json) if @primes %>
</script>

<div class="container-fluid py-4">
  <!-- Header moderne et cohérent -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-house-check text-primary fs-4"></i>
              </div>
              <div>
                <h1 class="h3 mb-1 text-primary">Wallonie - Primes de Rénovation</h1>
                <p class="text-muted mb-0">Testez votre éligibilité et découvrez vos primes</p>
              </div>
            </div>
            <%= link_to root_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-arrow-left me-2"></i>Retour à l'accueil
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- COLONNE GAUCHE : Test d'éligibilité -->
    <div class="col-lg-6">
      <div class="h-100">

        <%= render 'pages/partials_wallonie/selection_profil' %>

        <!-- Contenu dynamique pour l'éligibilité -->
        <%= turbo_frame_tag "eligibility_content" do %>
          <div class="text-center text-muted mt-4">
            <i class="bi bi-arrow-up fs-1 mb-2 d-block"></i>
            <p>Sélectionnez votre type de profil ci-dessus pour commencer</p>
          </div>
        <% end %>

        <!-- Affinage de catégorie Wallonie (masqué par défaut) -->
        <div id="affinage-categorie-wallonie" style="display: none;">
          <%= render 'pages/partials_wallonie/affinage_categorie' %>
        </div>
      </div>
    </div> <!-- fin col-lg-6 colonne gauche -->

    <!-- COLONNE DROITE : Primes et simulateur -->
    <div class="col-lg-6">
      <div class="h-100">

        <%= render 'pages/partials_wallonie/cartes_primes' %>

        <!-- Autres aides disponibles -->
        <div class="card border-0 shadow-sm mt-3">
          <div class="card-header bg-light">
            <h5 class="card-title mb-0">
              <i class="bi bi-gift text-info me-2"></i>
              Autres aides disponibles
            </h5>
            <p class="text-muted small mb-0 mt-1">
              Aides complémentaires et informations pratiques
            </p>
          </div>
          <div class="card-body">
            <!-- Informations complémentaires intégrées -->
            <div class="alert alert-info mb-3">
              <h6 class="alert-heading">
                <i class="bi bi-info-circle me-2"></i>
                Comment utiliser ce simulateur
              </h6>
              <ul class="mb-0 small">
                <li><strong>Saisie simple :</strong> Indiquez vos surfaces (m²) ou sélectionnez Oui/Non</li>
                <li><strong>Calcul automatique :</strong> Les montants s'ajustent selon votre catégorie de revenus (R1 à R5)</li>
                <li><strong>Cumul possible :</strong> Toutes les primes peuvent se cumuler selon vos travaux</li>
                <li><strong>Estimation :</strong> Montants indicatifs, demande officielle requise pour confirmation</li>
              </ul>
            </div>

            <div class="row g-3">

              <div class="col-2">
                <%= render 'pages/partials_wallonie/primes_communales_card' %>
              </div>
              <div class="col-2">
                <%= render 'pages/partials_wallonie/monuments_et_sites' %>
              </div>
              <div class="col-4">
                <!-- CARTE RÉNOPACK - Financement complémentaire -->
                <div class="alert alert-success border-success h-100 mb-0">
                  <h6 class="alert-heading mb-2">
                    <i class="bi bi-bank me-2"></i>
                    Rénopack Wallonie
                  </h6>
                  <p class="mb-2 small">Prêt à 0% jusqu'à 60 000€ pour vos travaux de rénovation énergétique.</p>

                  <!-- Intégration de la carte Rénopack -->
                  <%= render 'pages/partials_wallonie/carte_renopack' %>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Export PDF Section pour Wallonie -->
  <div class="row mt-4">
    <div class="col-12">
      <%= render 'shared/pdf_export_buttons' %>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
