<%
  seo_data = region_seo_data('wallonie')
  set_seo_meta(
    title: seo_data[:title],
    description: seo_data[:description],
    keywords: seo_data[:keywords],
    canonical_url: canonical_url_for(wallonie_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_service('wallonie') %>
  </script>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  // Initialisation automatique de la région Wallonie dès que le DOM est prêt
  document.addEventListener('DOMContentLoaded', function() {
    localStorage.setItem("region", "wallonie");
    console.log('🌍 Région Wallonie initialisée dans localStorage');
  });

  // Données des primes Wallonie
  window.primes = <%= raw(@primes.to_json(
    only: [:slug, :titre, :unite, :type_de_valeur, :valeurs_par_categorie, :placeholder, :condition, :conseil, :document, :eligible_categories]
  )) if @primes %>;
</script>

<!-- Données pour le calcul des primes Wallonie -->
<script type="application/json" id="wallonie-primes-data">
  <%= raw(@primes.each_with_object({}) { |prime, hash|
    hash[prime.slug] = {
      titre: prime.titre,
      valeurs_par_categorie: prime.valeurs_par_categorie || {},
      eligible_categories: prime.eligible_categories || []
    }
  }.to_json) if @primes %>
</script>

<div class="container-fluid py-4">
  <!-- Header moderne et cohérent -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-house-check text-primary fs-4"></i>
              </div>
              <div>
                <h1 class="h3 mb-1 text-primary">Wallonie - Primes de Rénovation</h1>
                <p class="text-muted mb-0">Testez votre éligibilité et découvrez vos primes</p>
              </div>
            </div>
            <%= link_to root_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-arrow-left me-2"></i>Retour à l'accueil
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Panneau d'avertissement - Arrêt progressif des primes Wallonie -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-warning border-warning shadow-sm" role="alert">
        <div class="d-flex align-items-start">
          <div class="alert-icon me-3 mt-1">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <h4 class="alert-heading mb-3">
              <i class="bi bi-hourglass-split me-2"></i>
              Arrêt progressif des primes à la rénovation en Wallonie
            </h4>

            <div class="row g-3">
              <div class="col-md-6">
                <div class="bg-light rounded p-3 h-100 border-start border-danger border-4">
                  <h6 class="text-danger mb-2">
                    <i class="bi bi-calendar-x me-2"></i>
                    Fin du régime actuel : 30 septembre 2026
                  </h6>
                  <p class="small mb-2">
                    <strong>Le régime actuel de primes Habitation prendra fin le 30 septembre 2026.</strong>
                    Après cette date, les demandes de primes ne seront plus acceptées.
                  </p>
                  <div class="alert alert-light border-0 mb-0 py-2 px-3">
                    <small class="text-danger">
                      <i class="bi bi-exclamation-triangle me-1"></i>
                      <strong>Action requise :</strong> Si vos travaux sont prêts, déposez votre <strong>demande de prime complète</strong> avant cette date
                    pour bénéficier des primes actuelles..
                    </small>
                  </div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="bg-light rounded p-3 h-100 border-start border-success border-4">
                  <h6 class="text-success mb-2">
                    <i class="bi bi-arrow-right-circle me-2"></i>
                    Nouveau système à partir du 1er octobre 2026
                  </h6>
                  <p class="small mb-2">
                    Un <strong>nouveau système de prêts à taux 0%</strong> remplacera les primes actuelles :
                  </p>
                  <ul class="small mb-2 ps-3">
                    <li>💰 <strong>Prêts à 0%</strong> jusqu'à <strong>XXXXX €</strong> remboursables sur <strong>YYYYY ans</strong></li>
                    <li>🎁 <strong>Réduction du montant à rembourser</strong> (assimilée à une prime) pour les projets avec <strong>"saut de label"</strong> de performance énergétique</li>
                    <li>📊 Réduction calculée selon la <strong>catégorie de revenus</strong> - priorité au public qui en a le plus besoin</li>
                    <li>🏗️ Aide appliquée sur l'<strong>investissement global</strong> (non plus poste par poste)</li>
                    <li>✅ <strong>Garantis par la Région</strong> (sans garantie hypothécaire)</li>
                    <li>🏠 Mécanisme ouvert aux <strong>propriétaires bailleurs</strong></li>
                  </ul>
                  <div class="alert alert-info border-0 mb-0 py-2 px-3">
                    <small>
                      <i class="bi bi-clipboard-check me-1"></i>
                      <strong>Obligations :</strong> Audit énergétique + travaux de salubrité + amélioration énergétique
                    </small>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-3 pt-2 border-top">
              <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                  <i class="bi bi-calendar3 me-1"></i>
                  Informations mises à jour le 6 avril 2026 - Consultez <a href="https://energie.wallonie.be" target="_blank" class="text-decoration-none">energie.wallonie.be</a>
                </small>
                <span class="badge bg-warning text-dark">
                  <i class="bi bi-clock me-1"></i>
                  Temps restant : ~6 mois
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- ÉTAPES DU PROCESSUS -->
    <div class="col-12 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h2 class="h4 mb-4 text-center">
            <i class="bi bi-list-check text-primary me-2"></i>
            Processus en 4 étapes simples
          </h2>
          <div class="row g-3">
            <div class="col-md-3 text-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                <span class="text-primary fw-bold">1</span>
              </div>
              <h6 class="text-primary mb-1">Sélection du profil</h6>
              <small class="text-muted">Définissez votre situation</small>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                <span class="text-info fw-bold">2</span>
              </div>
              <h6 class="text-info mb-1">Test d'éligibilité</h6>
              <small class="text-muted">Calculez votre catégorie</small>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                <span class="text-success fw-bold">3</span>
              </div>
              <h6 class="text-success mb-1">Primes éligibles</h6>
              <small class="text-muted">Découvrez vos montants</small>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                <span class="text-warning fw-bold">4</span>
              </div>
              <h6 class="text-warning mb-1">Connectez-vous</h6>
              <small class="text-muted">Accès complet</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- COLONNE GAUCHE : Étapes 1 & 2 -->
    <div class="col-lg-6">
      <div class="h-100">
        <!-- ÉTAPE 1 : Sélection du profil -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-primary bg-opacity-10">
            <h3 class="h5 mb-0 text-primary">
              <span class="badge bg-primary me-2">1</span>
              Sélection du profil
            </h3>
          </div>
          <div class="card-body">
            <%= render 'pages/partials_wallonie/selection_profil' %>
          </div>
        </div>

        <!-- ÉTAPE 2 : Test d'éligibilité -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-info bg-opacity-10">
            <h3 class="h5 mb-0 text-info">
              <span class="badge bg-info me-2">2</span>
              Test d'éligibilité et catégorie de primes
            </h3>
          </div>
          <div class="card-body">
            <!-- Contenu dynamique pour l'éligibilité -->
            <%= turbo_frame_tag "eligibility_content" do %>
              <div class="text-center text-muted">
                <i class="bi bi-arrow-up fs-1 mb-2 d-block"></i>
                <p>Sélectionnez votre type de profil ci-dessus pour commencer</p>
              </div>
            <% end %>

            <!-- Affinage de catégorie Wallonie (masqué par défaut) -->
            <div id="affinage-categorie-wallonie" style="display: none;">
              <%= render 'pages/partials_wallonie/affinage_categorie' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- COLONNE DROITE : Étape 3 -->
    <div class="col-lg-6">
      <div class="h-100">
        <!-- ÉTAPE 3 : Primes éligibles -->
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-header bg-success bg-opacity-10">
            <h3 class="h5 mb-0 text-success">
              <span class="badge bg-success me-2">3</span>
              Vos primes éligibles - Catégorie R<%= @categorie_id || '1' %>
            </h3>
          </div>
          <div class="card-body">
            <%= render 'pages/partials_wallonie/cartes_primes' %>
          </div>
        </div>

        <!-- Autres aides disponibles -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-light">
            <h5 class="card-title mb-0">
              <i class="bi bi-gift text-info me-2"></i>
              Autres aides disponibles
            </h5>
            <p class="text-muted small mb-0 mt-1">
              Aides complémentaires et informations pratiques
            </p>
          </div>
          <div class="card-body">
            <!-- Informations complémentaires intégrées -->
            <div class="alert alert-info mb-3">
              <h6 class="alert-heading">
                <i class="bi bi-info-circle me-2"></i>
                Comment utiliser ce simulateur
              </h6>
              <ul class="mb-0 small">
                <li><strong>Saisie simple :</strong> Indiquez vos surfaces (m²) ou sélectionnez Oui/Non</li>
                <li><strong>Calcul automatique :</strong> Les montants s'ajustent selon votre catégorie de revenus (R1 à R5)</li>
                <li><strong>Cumul possible :</strong> Toutes les primes peuvent se cumuler selon vos travaux</li>
                <li><strong>Estimation :</strong> Montants indicatifs, demande officielle requise pour confirmation</li>
              </ul>
            </div>

            <div class="row g-3">
              <div class="col-md-4">
                <%= render 'pages/partials_wallonie/primes_communales_card' %>
              </div>
              <div class="col-md-4">
                <%= render 'pages/partials_wallonie/monuments_et_sites' %>
              </div>
              <div class="col-md-4">
                <!-- CARTE RÉNOPACK - Financement complémentaire -->
                <div class="alert alert-success border-success h-100 mb-0">
                  <h6 class="alert-heading mb-2">
                    <i class="bi bi-bank me-2"></i>
                    Rénopack Wallonie
                  </h6>
                  <p class="mb-2 small">Prêt à 0% jusqu'à 60 000€ pour vos travaux de rénovation énergétique.</p>

                  <!-- Intégration de la carte Rénopack -->
                  <%= render 'pages/partials_wallonie/carte_renopack' %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ÉTAPE 4 : CTA Principal pour connexion -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-warning text-dark">
          <h3 class="h4 mb-0 text-center">
            <span class="badge bg-dark me-2">4</span>
            🚀 Connectez-vous pour aller plus loin !
          </h3>
        </div>
        <div class="card-body text-center py-4">
          <div class="row align-items-center">
            <div class="col-md-8 mb-3 mb-md-0">
              <h4 class="text-primary mb-3">Débloquez toutes les fonctionnalités de l'application</h4>
              <div class="row g-3 text-start">
                <div class="col-md-6">
                  <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Démarches détaillées</strong> pour chaque prime</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Conseils d'expert</strong> personnalisés</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Documents officiels</strong> à télécharger</li>
                  </ul>
                </div>
                <div class="col-md-6">
                  <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Suivi de vos projets</strong> de rénovation</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Alertes</strong> sur les nouvelles primes</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Support expert</strong> inclus</li>
                  </ul>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="d-grid gap-2">
                <%= link_to new_user_session_path, class: "btn btn-primary btn-lg shadow" do %>
                  <i class="bi bi-box-arrow-in-right me-2"></i>
                  Se connecter
                <% end %>
                <%= link_to new_user_registration_path, class: "btn btn-success btn-lg shadow" do %>
                  <i class="bi bi-person-plus me-2"></i>
                  Créer un compte gratuit
                <% end %>
                <small class="text-muted mt-2 d-block">
                  <i class="bi bi-shield-check me-1"></i>
                  Gratuit • Sans engagement • Sécurisé
                </small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
