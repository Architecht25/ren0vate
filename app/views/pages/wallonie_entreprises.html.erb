<%
  # Cette page liste les aides aux entreprises disponibles en Wallonie
  # avec des liens vers les sites officiels wallons
%>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <!-- Header avec retour -->
      <div class="d-flex align-items-center mb-4">
        <%= link_to root_path, class: "btn btn-outline-secondary me-3" do %>
          <i class="fas fa-arrow-left"></i> Retour
        <% end %>
        <h1 class="mb-0">
          <i class="fas fa-building me-2"></i>
          Aides aux Entreprises - Wallonie
        </h1>
      </div>

      <!-- Information générale -->
      <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">
          <i class="fas fa-info-circle me-2"></i>
          Information
        </h4>
        <p class="mb-0">
          Voici les principaux sites officiels wallons pour les aides aux entreprises.
          Cliquez sur les liens pour accéder directement aux informations et procédures.
        </p>
      </div>

      <!-- Liste des liens officiels -->
      <div class="card mb-4">
        <div class="card-header bg-danger text-white">
          <h3 class="mb-0">
            <i class="fas fa-link me-2"></i>
            Sites Officiels - Wallonie
          </h3>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">SPW Économie</h5>
                <p class="text-muted mb-3">Service Public de Wallonie - Aides aux entreprises</p>
                <a href="#" class="btn btn-outline-danger btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  À compléter
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">SOWALFIN</h5>
                <p class="text-muted mb-3">Société wallonne de financement et de garantie</p>
                <a href="#" class="btn btn-outline-danger btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  À compléter
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">AWEX</h5>
                <p class="text-muted mb-3">Agence wallonne à l'exportation</p>
                <a href="#" class="btn btn-outline-danger btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  À compléter
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">Invest in Wallonia</h5>
                <p class="text-muted mb-3">Agence wallonne d'investissement</p>
                <a href="#" class="btn btn-outline-danger btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  À compléter
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section informative -->
      <div class="card border-warning">
        <div class="card-body">
          <h5 class="card-title text-warning">
            <i class="fas fa-lightbulb me-2"></i>
            Recherche d'URLs en cours
          </h5>
          <p class="mb-0">
            Nous allons compléter ces liens avec les vraies URLs des sites officiels wallons.
            En attendant, vous pouvez rechercher directement "aides entreprises Wallonie" sur votre moteur de recherche préféré.
          </p>
        </div>
      </div>

      <!-- Call to action -->
      <div class="text-center mt-5 mb-4">
        <%= link_to root_path, class: "btn btn-danger btn-lg" do %>
          <i class="fas fa-home me-2"></i>
          Retour à l'accueil
        <% end %>
      </div>
    </div>
  </div>
</div>
