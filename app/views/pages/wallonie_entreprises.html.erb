<%
  # Cette page liste les aides aux entreprises disponibles en Wallonie
  # avec des liens vers les sites officiels wallons

  seo_data = enterprise_seo_data('wallonie')
  set_seo_meta(
    title: seo_data[:title],
    description: seo_data[:description],
    keywords: seo_data[:keywords],
    canonical_url: canonical_url_for(wallonie_entreprises_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_service('wallonie', 'entreprises') %>
  </script>
<% end %>

<div class="container mt-4">
  <div class="row">
    <div class="col-12">
      <!-- Header avec retour -->
      <div class="d-flex align-items-center mb-4">
        <%= link_to root_path, class: "btn btn-outline-secondary me-3" do %>
          <i class="fas fa-arrow-left"></i> Retour
        <% end %>
        <h1 class="mb-0">
          <i class="fas fa-building me-2"></i>
          Aides aux Entreprises - Wallonie
        </h1>
      </div>

      <!-- Information générale -->
      <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">
          <i class="fas fa-info-circle me-2"></i>
          Information
        </h4>
        <p class="mb-0">
          Voici les principaux sites officiels wallons pour les aides aux entreprises.
          Cliquez sur les liens pour accéder directement aux informations et procédures.
        </p>
      </div>

      <!-- Liste des liens officiels -->
      <div class="card mb-4">
        <div class="card-header bg-danger text-white">
          <h3 class="mb-0">
            <i class="fas fa-link me-2"></i>
            Sites Officiels - Wallonie
          </h3>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">SPW Économie</h5>
                <p class="text-muted mb-3">Aides à l'investissement </p>
                <a href="https://economie.wallonie.be/investir" class="btn btn-outline-danger btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  Guide des aides à l'investissement
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">SPW Énergie</h5>
                <p class="text-muted mb-3">Aides AMURE, UREBA & Conventions Carbone</p>
                <a href="https://energie.wallonie.be/fr/02-02-2024-reforme-des-subventions-amure-et-ureba-conventions-carbone.html?IDD=174976&IDC=8234" class="btn btn-outline-danger btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  Informations à venir
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">Chèques-entreprises</h5>
                <p class="text-muted mb-3">Aides pour soutenir la création d’activité, l’innovation, l’économie circulaire et la croissance des entreprises wallonnes</p>
                <a href="https://www.cheques-entreprises.be/" class="btn btn-outline-danger btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  Guide des Chèques-entreprises
                </a>
              </div>
            </div>

            <div class="col-md-6 mb-3">
              <div class="border rounded p-3 h-100">
                <h5 class="text-primary">AWEX</h5>
                <p class="text-muted mb-3">Agence wallonne à l'exportation</p>
                <a href="https://www.awex.be/" class="btn btn-outline-danger btn-sm" target="_blank" rel="noopener">
                  <i class="fas fa-external-link-alt me-1"></i>
                  Guide AWEX
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Call to action -->
      <div class="text-center mt-5 mb-4">
        <%= link_to root_path, class: "btn btn-danger btn-lg" do %>
          <i class="fas fa-home me-2"></i>
          Retour à l'accueil
        <% end %>
      </div>
    </div>
  </div>
</div>
