<!-- Page de test pour l'export PDF -->
<div class="container mt-5">
  <h1>🧪 Test Export PDF</h1>

  <div class="row">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Simulation de données</h5>
        </div>
        <div class="card-body">
          <p>Cliquez sur les boutons ci-dessous pour simuler des données dans localStorage :</p>

          <button type="button" class="btn btn-outline-primary btn-sm mb-2" onclick="simulateFlandreData()">
            🟦 Simuler données Flandre
          </button>
          <br>
          <button type="button" class="btn btn-outline-success btn-sm mb-2" onclick="simulateBruxellesData()">
            🟩 Simuler données Bruxelles
          </button>
          <br>
          <button type="button" class="btn btn-outline-warning btn-sm mb-2" onclick="simulateWallonieData()">
            🟨 Simuler données Wallonie
          </button>
          <br>
          <button type="button" class="btn btn-outline-danger btn-sm mb-2" onclick="clearAllData()">
            🗑️ Vider toutes les données
          </button>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5>Export PDF</h5>
        </div>
        <div class="card-body">
          <%= render 'shared/pdf_export_buttons' %>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <h3>État du localStorage</h3>
    <pre id="localStorageState" class="bg-light p-3 rounded">
      <!-- Sera rempli par JavaScript -->
    </pre>
  </div>
</div>

<script>
function simulateFlandreData() {
  const flandreData = {
    usage: "oui",
    proprietaire: "oui",
    annee: "oui",
    "appartement-copro": "non",
    locataire_social: "non",
    revenus_trop_eleves: "non",
    revenus_menage: "45000",
    composition_familiale: "couple_2_enfants",
    result: "✅ Vous êtes éligible aux primes de rénovation en Flandre",
    eligible: true
  }

  localStorage.setItem('eligibiliteRenovate', JSON.stringify(flandreData))
  localStorage.setItem('total_primes', '15000')
  localStorage.setItem('details_primes', JSON.stringify([
    { nom: "Prime isolation toiture", montant: 8000 },
    { nom: "Prime châssis", montant: 4000 },
    { nom: "Prime audit énergétique", montant: 3000 }
  ]))

  updateLocalStorageDisplay()
  alert('✅ Données Flandre simulées !')
}

function simulateBruxellesData() {
  const bruxellesData = {
    localisation: "oui",
    age_logement: "oui",
    destination: "oui",
    entrepreneur: "oui",
    proprietaire_appartement: "non",
    independant: "non",
    revenus_bruts_imposables: "35000",
    demandeur_principal: "1",
    enfants_mineurs: "2",
    result: "✅ Vous êtes éligible aux primes de rénovation à Bruxelles - Catégorie 2",
    eligible: true
  }

  localStorage.setItem('eligibiliteBruxellesParticulier', JSON.stringify(bruxellesData))
  localStorage.setItem('selectedBruxellesCategory', 'cat2')
  localStorage.setItem('bruxellesCategorieEstimee', '2')
  localStorage.setItem('total_primes', '12500')
  localStorage.setItem('details_primes', JSON.stringify([
    { nom: "Prime isolation murs", montant: 6000 },
    { nom: "Prime ventilation", montant: 3500 },
    { nom: "Prime pompe à chaleur", montant: 3000 }
  ]))

  updateLocalStorageDisplay()
  alert('✅ Données Bruxelles simulées !')
}

function simulateWallonieData() {
  const wallonieData = {
    localisation: "oui",
    destination: "oui",
    propriete: "oui",
    residence_principale: "oui",
    age_logement: "oui",
    factures_anciennes: "non",
    revenus_r5: "non",
    revenu_reference: "42000",
    nombre_personnes_charge: "3",
    situation_particuliere: "non",
    result: "✅ Vous êtes éligible aux primes de rénovation en Wallonie - Catégorie R3",
    eligible: true
  }

  localStorage.setItem('eligibiliteWallonieParticulier', JSON.stringify(wallonieData))
  localStorage.setItem('selectedWallonieCategory', 'wallonie_r3')
  localStorage.setItem('wallonie_categorie', 'R3')
  localStorage.setItem('total_primes', '18000')
  localStorage.setItem('details_primes', JSON.stringify([
    { nom: "Prime isolation sol", montant: 7000 },
    { nom: "Prime chaudière condensation", montant: 6000 },
    { nom: "Prime panneaux solaires", montant: 5000 }
  ]))

  updateLocalStorageDisplay()
  alert('✅ Données Wallonie simulées !')
}

function clearAllData() {
  // Vider toutes les données d'éligibilité
  const keys = [
    'eligibiliteRenovate',
    'eligibiliteBruxelles',
    'eligibiliteBruxellesParticulier',
    'eligibiliteWallonieParticulier',
    'eligibiliteWallonieEntreprise',
    'eligibiliteWallonieSyndic',
    'eligibiliteWallonieAsbl',
    'eligibiliteWallonieBailleur',
    'selectedBruxellesCategory',
    'bruxellesCategorieEstimee',
    'selectedWallonieCategory',
    'wallonie_categorie',
    'total_primes',
    'details_primes'
  ]

  keys.forEach(key => localStorage.removeItem(key))

  updateLocalStorageDisplay()
  alert('🗑️ Toutes les données ont été supprimées !')
}

function updateLocalStorageDisplay() {
  const relevantKeys = [
    'eligibiliteRenovate',
    'eligibiliteBruxelles',
    'eligibiliteBruxellesParticulier',
    'eligibiliteWallonieParticulier',
    'total_primes',
    'details_primes'
  ]

  let output = ''
  relevantKeys.forEach(key => {
    const value = localStorage.getItem(key)
    if (value) {
      output += `${key}: ${value}\n\n`
    }
  })

  document.getElementById('localStorageState').textContent = output || 'Aucune donnée trouvée'
}

// Initialiser l'affichage au chargement
document.addEventListener('DOMContentLoaded', updateLocalStorageDisplay)
</script>
