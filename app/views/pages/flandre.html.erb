<%
  seo_data = region_seo_data('flandre')
  set_seo_meta(
    title: seo_data[:title],
    description: seo_data[:description],
    keywords: seo_data[:keywords],
    canonical_url: canonical_url_for(flandre_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_service('flandre') %>
  </script>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  // Initialisation automatique de la région Flandre dès que le DOM est prêt
  document.addEventListener('DOMContentLoaded', function() {
    localStorage.setItem("region", "flandre");
    console.log('🌍 Région Flandre initialisée dans localStorage');

    // Afficher les cartes par défaut pour la catégorie 1 si aucune catégorie n'est définie
    const categorieId = "<%= @categorie_id %>" || "1";
    console.log('📊 Catégorie affichée:', categorieId);

    // Afficher les cartes par défaut
    const primesSection = document.querySelector('.primes-section');
    const primesPlaceholder = document.querySelector('#primes-placeholder');

    if (primesSection && primesPlaceholder) {
      primesSection.style.display = '';
      primesPlaceholder.style.display = 'none';
    }
  });

  window.primes = <%= raw(@primes.to_json(
    only: [:slug, :titre, :unite, :type_de_valeur, :valeurs_par_categorie, :placeholder, :condition, :conseil, :document, :eligible_categories]
  )) %>;

  window.categorieId = "<%= @categorie_id || '1' %>";
  window.plafondsParCategorie = <%= raw(@plafonds_par_categorie.to_json) %>;
  window.groupesPlafond = <%= raw(@groupes_plafond.to_json) %>;
</script>


<div class="container-fluid py-4">
  <!-- Header moderne et cohérent -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-house-check text-primary fs-4"></i>
              </div>
              <div>
                <h1 class="h3 mb-1 text-primary">Flandre - Primes de Rénovation</h1>
                <p class="text-muted mb-0">Testez votre éligibilité et découvrez vos primes</p>
              </div>
            </div>
            <%= link_to root_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-arrow-left me-2"></i>Retour à l'accueil
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Panneau d'avertissement - Modifications réglementaires -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-warning border-warning shadow-sm" role="alert">
        <div class="d-flex align-items-start">
          <div class="alert-icon me-3 mt-1">
            <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <h4 class="alert-heading mb-3">
              <i class="bi bi-info-circle me-2"></i>
              Modifications réglementaires récentes en Flandre
            </h4>

            <div class="row g-3">
              <div class="col-md-4">
                <div class="bg-light rounded p-3 h-100">
                  <h6 class="text-primary mb-2">
                    <i class="bi bi-clock me-2"></i>
                    Délais prolongé pour Mijn VerbouwPremie
                  </h6>
                  <p class="small mb-0">
                    Pour les <strong>groupes de revenus les plus élevés (Catégorie de revenus 1 et sans doute 2 aussi) </strong> : facture finale acceptée jusqu'au <strong>28 février 2026</strong>.
                    Factures de 2 ans maximum acceptées. Pour les revenus les plus bas, rien ne change.
                  </p>
                </div>
              </div>

              <div class="col-md-4">
                <div class="bg-light rounded p-3 h-100">
                  <h6 class="text-primary mb-2">
                    <i class="bi bi-award me-2"></i>
                    Délai prolongé pour Mijn EPC-labelpremie
                  </h6>
                  <p class="small mb-0">
                    La suppression de la <strong>Prime Mon Label PEB</strong> est reportée.
                    Vous avez jusqu'au <strong>30 juin 2026</strong> pour en bénéficier (labels E/F → C/B/A).
                  </p>
                </div>
              </div>

              <div class="col-md-4">
                <div class="bg-light rounded p-3 h-100">
                  <h6 class="text-primary mb-2">
                    <i class="bi bi-thermometer me-2"></i>
                    Prime maintenue pour les pompes à chaleur
                  </h6>
                  <p class="small mb-0">
                    Prime conservée pour les <strong>revenus élevés</strong> mais réduite :
                    pompe à chaleur air-eau passe de <strong>2.250€ à 1.500€</strong>.
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-3 pt-2 border-top">
              <small class="text-muted">
                <i class="bi bi-calendar3 me-1"></i>
                Informations mises à jour en novembre 2025 - Vérifiez toujours les conditions actuelles
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- ÉTAPES DU PROCESSUS -->
    <div class="col-12 mb-4">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h2 class="h4 mb-4 text-center">
            <i class="bi bi-list-check text-primary me-2"></i>
            Processus en 4 étapes simples
          </h2>
          <div class="row g-3">
            <div class="col-md-3 text-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                <span class="text-primary fw-bold">1</span>
              </div>
              <h6 class="text-primary mb-1">Sélection du profil</h6>
              <small class="text-muted">Définissez votre situation</small>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                <span class="text-info fw-bold">2</span>
              </div>
              <h6 class="text-info mb-1">Test d'éligibilité</h6>
              <small class="text-muted">Calculez votre catégorie</small>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                <span class="text-success fw-bold">3</span>
              </div>
              <h6 class="text-success mb-1">Primes éligibles</h6>
              <small class="text-muted">Découvrez vos montants</small>
            </div>
            <div class="col-md-3 text-center">
              <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 50px; height: 50px;">
                <span class="text-warning fw-bold">4</span>
              </div>
              <h6 class="text-warning mb-1">Connectez-vous</h6>
              <small class="text-muted">Accès complet</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- COLONNE GAUCHE : Étapes 1 & 2 -->
    <div class="col-lg-6">
      <div class="h-100">
        <!-- ÉTAPE 1 : Sélection du profil -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-primary bg-opacity-10">
            <h3 class="h5 mb-0 text-primary">
              <span class="badge bg-primary me-2">1</span>
              Sélection du profil
            </h3>
          </div>
          <div class="card-body">
            <%= render 'pages/partials_flandre/selection_profil' %>
          </div>
        </div>

        <!-- ÉTAPE 2 : Test d'éligibilité -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-info bg-opacity-10">
            <h3 class="h5 mb-0 text-info">
              <span class="badge bg-info me-2">2</span>
              Test d'éligibilité et catégorie de primes
            </h3>
          </div>
          <div class="card-body">
            <%= render 'pages/partials_flandre/questionnaire_eligibilite' %>
          </div>
        </div>
      </div>
    </div>

    <!-- COLONNE DROITE : Étape 3 -->
    <div class="col-lg-6">
      <div class="h-100">
        <!-- ÉTAPE 3 : Primes éligibles -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-success bg-opacity-10">
            <h3 class="h5 mb-0 text-success">
              <span class="badge bg-success me-2">3</span>
              Vos primes éligibles - Catégorie <%= @categorie_id || '1' %>
            </h3>
          </div>
          <div class="card-body">
            <%= render 'pages/partials_flandre/cartes_primes' %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ÉTAPE 4 : CTA Principal pour connexion -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-warning shadow-lg">
        <div class="card-header bg-warning text-dark">
          <h3 class="h4 mb-0 text-center">
            <span class="badge bg-dark me-2">4</span>
            🚀 Connectez-vous pour aller plus loin !
          </h3>
        </div>
        <div class="card-body text-center py-4">
          <div class="row align-items-center">
            <div class="col-md-8 mb-3 mb-md-0">
              <h4 class="text-primary mb-3">Débloquez toutes les fonctionnalités de l'application</h4>
              <div class="row g-3 text-start">
                <div class="col-md-6">
                  <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Démarches détaillées</strong> pour chaque prime</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Conseils d'expert</strong> personnalisés</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Documents officiels</strong> à télécharger</li>
                  </ul>
                </div>
                <div class="col-md-6">
                  <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Suivi de vos projets</strong> de rénovation</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Alertes</strong> sur les nouvelles primes</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Support expert</strong> inclus</li>
                  </ul>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="d-grid gap-2">
                <%= link_to new_user_session_path, class: "btn btn-primary btn-lg shadow" do %>
                  <i class="bi bi-box-arrow-in-right me-2"></i>
                  Se connecter
                <% end %>
                <%= link_to new_user_registration_path, class: "btn btn-success btn-lg shadow" do %>
                  <i class="bi bi-person-plus me-2"></i>
                  Créer un compte gratuit
                <% end %>
                <small class="text-muted mt-2 d-block">
                  <i class="bi bi-shield-check me-1"></i>
                  Gratuit • Sans engagement • Sécurisé
                </small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

