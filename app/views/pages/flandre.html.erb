<%
  seo_data = region_seo_data('flandre')
  set_seo_meta(
    title: seo_data[:title],
    description: seo_data[:description],
    keywords: seo_data[:keywords],
    canonical_url: canonical_url_for(flandre_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_service('flandre') %>
  </script>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  document.addEventListener('DOMContentLoaded', function() {
    localStorage.setItem("region", "flandre");
    const primesSection = document.querySelector('.primes-section');
    const primesPlaceholder = document.querySelector('#primes-placeholder');
    if (primesSection && primesPlaceholder) {
      primesSection.style.display = '';
      primesPlaceholder.style.display = 'none';
    }
  });
  window.primes = <%= raw(@primes.to_json(
    only: [:slug, :titre, :unite, :type_de_valeur, :valeurs_par_categorie, :placeholder, :condition, :conseil, :document, :eligible_categories]
  )) %>;
  window.categorieId = "<%= @categorie_id || '1' %>";
  window.plafondsParCategorie = <%= raw(@plafonds_par_categorie.to_json) %>;
  window.groupesPlafond = <%= raw(@groupes_plafond.to_json) %>;
</script>

<style nonce="<%= content_security_policy_nonce %>">
  .flandre-hero { background: linear-gradient(135deg, #0d47a1 0%, #1565c0 45%, #1b5e20 100%); }
  .wizard-panel-enter { animation: wizardFadeIn 0.35s ease; }
  @keyframes wizardFadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  .wizard-nav-bubble { transition: all 0.3s ease; border: 2px solid transparent; }
  .wizard-nav-bubble.bg-light { border-color: #dee2e6 !important; }
  .question-active { animation: wizardFadeIn 0.3s ease; }
  .question-answered { border-left: 4px solid #198754 !important; background: #f8fff9 !important; }
  .profile-card-btn { transition: all 0.2s ease; border-width: 2px; }
  .profile-card-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(13,110,253,.15); }
  .profile-card-btn.selected { border-color: #0d6efd !important; background: #e7f1ff !important; }
</style>

<%# ── HERO ── %>
<section class="flandre-hero text-white pt-5 pb-5 position-relative overflow-hidden" style="padding-bottom:4rem!important;">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-8">
        <div class="d-flex align-items-center gap-2 mb-3">
          <span class="badge bg-white text-primary px-3 py-2">
            <i class="bi bi-geo-alt-fill me-1"></i>Flandre
          </span>
          <span class="text-white-50 small">Mijn VerbouwPremie · 2025</span>
        </div>
        <h1 class="display-5 fw-bold mb-3 lh-sm">
          Découvrez vos primes<br>de rénovation
        </h1>
        <p class="lead text-white-75 mb-4">
          Simulation gratuite et sans inscription — résultat en moins de 2 minutes
        </p>
        <div class="d-flex flex-wrap gap-3 small">
          <span class="bg-white bg-opacity-10 rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2">
            <i class="bi bi-clock text-warning"></i> ~2 min
          </span>
          <span class="bg-white bg-opacity-10 rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-warning"></i> Sans inscription
          </span>
          <span class="bg-white bg-opacity-10 rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2">
            <i class="bi bi-database-check text-warning"></i> Données officielles
          </span>
          <span class="bg-white bg-opacity-10 rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-up-circle text-warning"></i> Jusqu'à <strong>8.000 €</strong>/mesure
          </span>
        </div>
      </div>
      <div class="col-lg-4 d-none d-lg-block text-end">
        <%= link_to root_path, class: "btn btn-outline-light btn-sm" do %>
          <i class="bi bi-arrow-left me-1"></i>Accueil
        <% end %>
      </div>
    </div>
  </div>
  <div class="position-absolute bottom-0 start-0 end-0" style="height:24px;background:#f8f9fa;clip-path:ellipse(55% 100% at 50% 100%);"></div>
</section>

<%# ── WIZARD ── %>
<div class="bg-light pb-5" data-controller="flandre-wizard" id="flandre-wizard">
  <div class="container pt-4">

    <%# Progress nav %>
    <div class="row justify-content-center mb-4">
      <div class="col-xl-9">
        <div class="d-flex align-items-start position-relative" style="padding: 0 5%;">
          <%# Progress bar line %>
          <div style="position:absolute;top:20px;left:12%;right:12%;height:2px;background:#dee2e6;z-index:0;">
            <div data-flandre-wizard-target="progressFill"
                 style="height:100%;width:0%;background:#0d6efd;transition:width .5s ease;"></div>
          </div>

          <% [["1","bi-person-circle","Profil"], ["2","bi-clipboard-check","Éligibilité"], ["3","bi-cash-coin","Revenus"], ["4","bi-gift","Primes"]].each_with_index do |(num, icon, label), idx| %>
            <div class="text-center" style="flex:1;z-index:1;"
                 data-step="<%= num %>" data-flandre-wizard-target="navStep">
              <div class="wizard-nav-bubble mx-auto d-flex align-items-center justify-content-center rounded-circle fw-bold
                          <%= idx == 0 ? 'bg-primary text-white' : 'bg-light text-muted' %>"
                   style="width:40px;height:40px;font-size:13px;<%= idx == 0 ? 'border:2px solid #0d6efd;' : 'border:2px solid #dee2e6;' %>"
                   data-action="click->flandre-wizard#jumpToStep"
                   data-step-number="<%= num %>">
                <%= num %>
              </div>
              <div class="wizard-nav-label mt-1 d-none d-md-block small fw-semibold
                          <%= idx == 0 ? 'text-primary' : 'text-muted' %>">
                <i class="bi <%= icon %> me-1"></i><%= label %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Steps 1–3 : colonne centrée étroite %>
    <div class="row justify-content-center" id="wizard-narrow-row">
      <div class="col-xl-9 col-12">

        <%# ─ ÉTAPE 1 : Profil ─ %>
        <div class="wizard-panel" data-wizard-step="1" data-flandre-wizard-target="panel">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
              <div class="text-center mb-4">
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-3">Étape 1 / 4</span>
                <h2 class="h4 mb-1 fw-bold">Quel est votre profil ?</h2>
                <p class="text-muted small">La sélection passe automatiquement à l'étape suivante</p>
              </div>
              <%= render 'pages/partials_flandre/selection_profil' %>
            </div>
          </div>
        </div>

        <%# ─ ÉTAPE 2 : Questionnaire ─ %>
        <div class="wizard-panel d-none" data-wizard-step="2" data-flandre-wizard-target="panel">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
              <div class="d-flex align-items-center mb-4 gap-3">
                <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                        data-action="click->flandre-wizard#prevStep">
                  <i class="bi bi-arrow-left me-1"></i>Retour
                </button>
                <div class="flex-grow-1 text-center">
                  <span class="badge bg-info-subtle text-info rounded-pill px-3 py-2 mb-1">Étape 2 / 4</span>
                  <h2 class="h4 mb-0 fw-bold">Test d'éligibilité</h2>
                </div>
                <div style="width:70px;"></div>
              </div>
              <%= render 'pages/partials_flandre/questionnaire_eligibilite' %>
            </div>
          </div>
        </div>

        <%# ─ ÉTAPE 3 : Affinage revenus ─ %>
        <div class="wizard-panel d-none" data-wizard-step="3" data-flandre-wizard-target="panel">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
              <div class="d-flex align-items-center mb-4 gap-3">
                <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                        data-action="click->flandre-wizard#prevStep">
                  <i class="bi bi-arrow-left me-1"></i>Retour
                </button>
                <div class="flex-grow-1 text-center">
                  <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-2 mb-1">Étape 3 / 4</span>
                  <h2 class="h4 mb-0 fw-bold">Affinez votre catégorie de primes</h2>
                </div>
                <div style="width:70px;"></div>
              </div>

              <%# Affinage catégorie (extrait du questionnaire) %>
              <div data-controller="categorie-estimation">
                <p class="text-muted small text-center mb-4">
                  Votre situation familiale et vos revenus déterminent votre catégorie de primes.<br>
                  <strong>Catégorie 4</strong> = revenus les plus bas, primes les plus élevées.
                </p>

                <%# Grille catégories visuelles %>
                <div class="row g-3 mb-4">
                  <% [["4","success","Bas revenus","Jusqu'à 24.230 €","50% plafonnée","bi-star-fill"],
                      ["3","primary","Revenus modérés","24.231 – 42.340 €","35% plafonnée","bi-star-half"],
                      ["2","info","Revenus moyens","42.341 – 53.880 €","25% plafonnée","bi-star"],
                      ["1","secondary","Revenus élevés","+ de 53.881 €","Forfait fixe","bi-dash-circle"]].each do |cat, color, label, range, aide, icon| %>
                    <div class="col-6 col-md-3">
                      <div class="card border-<%= color %> border-opacity-50 text-center p-3 h-100">
                        <i class="bi <%= icon %> text-<%= color %> fs-4 mb-2"></i>
                        <div class="badge bg-<%= color %>-subtle text-<%= color %> mb-1">Cat. <%= cat %></div>
                        <div class="fw-semibold small mb-1"><%= label %></div>
                        <div class="text-muted" style="font-size:11px;"><%= range %></div>
                        <div class="mt-1 small text-<%= color %> fw-semibold"><%= aide %></div>
                      </div>
                    </div>
                  <% end %>
                </div>

                <div class="card border-warning border-opacity-50">
                  <div class="card-header bg-warning-subtle">
                    <h5 class="card-title mb-0 small fw-semibold">
                      <i class="bi bi-sliders text-warning me-2"></i>Calculez votre catégorie
                    </h5>
                  </div>
                  <div class="card-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <label for="statut-familial" class="form-label small fw-semibold">Situation familiale</label>
                        <select id="statut-familial" class="form-select form-select-sm">
                          <option value="">Sélectionnez</option>
                          <option value="isolé">Isolé / Célibataire</option>
                          <option value="isolé-enfant">Isolé avec enfant à charge</option>
                          <option value="couple">Couple sans enfants</option>
                          <option value="couple-enfant">Couple avec enfants</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label for="personnes-charge" class="form-label small fw-semibold">Personnes à charge</label>
                        <select id="personnes-charge" class="form-select form-select-sm">
                          <option value="0">0</option>
                          <option value="1">1</option>
                          <option value="2">2</option>
                          <option value="3">3</option>
                          <option value="4">4+</option>
                        </select>
                      </div>
                      <div class="col-md-4">
                        <label for="revenu-net" class="form-label small fw-semibold">Revenu imposable du ménage</label>
                        <select id="revenu-net" class="form-select form-select-sm">
                          <option value="">Sélectionnez une tranche</option>
                          <option value="-24320">Moins de 24.230 €</option>
                          <option value="24231-42340">24.231 € – 42.340 €</option>
                          <option value="42341-53880">42.341 € – 53.880 €</option>
                          <option value="53881+">Plus de 53.881 €</option>
                        </select>
                      </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                      <button class="btn btn-warning"
                              data-action="click->categorie-estimation#estimerCategorie">
                        <i class="bi bi-calculator me-2"></i>Calculer ma catégorie
                      </button>
                    </div>
                    <div id="result-affinage"
                         data-categorie-estimation-target="resultAffinage"
                         class="alert alert-secondary mt-3 text-center"
                         style="display:none;"></div>
                    <button id="go-simulateur" style="display:none;" class="btn btn-success mt-3"
                            data-action="click->categorie-estimation#goToSimulateur">
                      <i class="bi bi-arrow-right-circle me-2"></i>Voir mes primes
                    </button>
                    <p class="text-muted small mt-3 mb-0">
                      <i class="bi bi-info-circle me-1"></i>
                      Pour un calcul précis, connectez-vous à votre espace personnel.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div><%# /col-xl-9 — fin steps 1-3 %>
    </div><%# /row narrow %>

    <%# Step 4 : pleine largeur %>
    <div class="row">
      <div class="col-12">
        <div class="wizard-panel d-none" data-wizard-step="4" data-flandre-wizard-target="panel">

          <%# Header étape 4 %>
          <div class="d-flex align-items-center mb-4 gap-3">
            <button class="btn btn-sm btn-outline-secondary flex-shrink-0"
                    data-action="click->flandre-wizard#prevStep">
              <i class="bi bi-arrow-left me-1"></i>Retour
            </button>
            <div class="flex-grow-1 text-center">
              <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 mb-1">Étape 4 / 4 — Résultats</span>
              <h2 class="h4 mb-0 fw-bold">Vos primes éligibles</h2>
              <p class="text-muted small mb-0" id="primes-categorie-label">Catégorie <%= @categorie_id || '1' %> — simulation indicative</p>
            </div>
            <div style="width:80px;"></div>
          </div>

          <%# Cartes primes — pleine largeur %>
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
              <%= render 'pages/partials_flandre/cartes_primes' %>
            </div>
          </div>

          <%# CTA Gestion de chantier %>
          <div class="rounded-4 overflow-hidden shadow-lg mb-2"
               style="background: linear-gradient(135deg, #0a2e6e 0%, #0d47a1 40%, #1b5e20 100%);">
            <div class="p-4 p-md-5">
              <div class="row align-items-center g-5">

                <%# Colonne gauche : pitch %>
                <div class="col-lg-5">
                  <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-10 rounded-pill px-3 py-1 mb-3 small text-white">
                    <i class="bi bi-stars text-warning"></i> Plateforme de gestion de rénovation
                  </div>
                  <h2 class="text-white fw-bold mb-3" style="font-size:1.75rem;line-height:1.3;">
                    Pilotez votre chantier<br>de A à Z avec Ren0vate
                  </h2>
                  <p class="text-white mb-4" style="font-size:.95rem;opacity:.85;">
                    De la simulation des primes jusqu'à la réception des travaux — un seul outil pour suivre chaque étape, coordonner vos entrepreneurs et maximiser vos aides.
                  </p>
                  <div class="d-flex flex-wrap gap-2">
                    <%= link_to new_user_session_path, class: "btn btn-warning btn-lg fw-bold px-4" do %>
                      <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
                    <% end %>
                    <%= link_to new_user_registration_path, class: "btn btn-outline-light btn-lg px-4" do %>
                      <i class="bi bi-person-plus me-2"></i>Créer un compte gratuit
                    <% end %>
                  </div>
                  <p class="text-white-50 small mt-3 mb-0">
                    <i class="bi bi-shield-check me-1"></i>Gratuit · Sans engagement · Conforme RGPD
                  </p>
                </div>

                <%# Colonne droite : features gestion de chantier %>
                <div class="col-lg-7">
                  <div class="row g-3">
                    <% [
                      ["bi-kanban-fill",       "warning",  "Tableau de bord chantier",       "Vision en temps réel de l'avancement de chaque corps de métier"],
                      ["bi-people-fill",        "info",     "Coordination entrepreneurs",      "Comparez les devis, assignez les tâches et suivez les interventions"],
                      ["bi-calendar2-check",    "success",  "Calendrier & jalons",             "Planifiez les étapes, visualisez les délais et anticipez les retards"],
                      ["bi-file-earmark-text",  "primary",  "Documents & attestations",        "Centralisez factures, PV de réception, devis et attestations d'entrepreneur"],
                      ["bi-cash-coin",          "warning",  "Suivi des primes & remboursements","Dépôt de dossiers guidé étape par étape, alertes délais de soumission"],
                      ["bi-graph-up-arrow",     "success",  "ROI & financement",               "Simulez le retour sur investissement et les options de financement disponibles"]
                    ].each do |icon, color, title, desc| %>
                      <div class="col-sm-6">
                        <div class="d-flex gap-3 align-items-start bg-white bg-opacity-10 rounded-3 p-3 h-100">
                          <div class="bg-<%= color %> bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                               style="width:40px;height:40px;">
                            <i class="bi <%= icon %> text-white"></i>
                          </div>
                          <div>
                            <div class="text-white fw-semibold small mb-1"><%= title %></div>
                            <div class="text-white-50" style="font-size:11.5px;"><%= desc %></div>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>

              </div>
            </div>
          </div><%# /CTA %>

        </div><%# /wizard-panel step 4 %>
      </div><%# /col-12 %>
    </div><%# /row step 4 %>

    <%# ─ Accordion réglementation récente ─ %>
    <div class="row justify-content-center mt-4">
      <div class="col-xl-9">
        <div class="accordion" id="regulatoryAccordion">
          <div class="accordion-item border-warning border-opacity-50">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed bg-warning-subtle text-dark" type="button"
                      data-bs-toggle="collapse" data-bs-target="#regulatoryInfo">
                <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                <strong>Modifications réglementaires récentes en Flandre</strong>
                <span class="badge bg-warning text-dark ms-2 small">nov. 2025</span>
              </button>
            </h2>
            <div id="regulatoryInfo" class="accordion-collapse collapse">
              <div class="accordion-body">
                <div class="row g-3">
                  <div class="col-md-4">
                    <div class="d-flex gap-3">
                      <div class="flex-shrink-0 bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                        <i class="bi bi-clock text-primary"></i>
                      </div>
                      <div>
                        <h6 class="mb-1 text-primary small fw-bold">Mijn VerbouwPremie prolongé</h6>
                        <p class="small mb-0">Catégories 1 et 2 : facture finale acceptée jusqu'au <strong>28 fév. 2026</strong>. Factures de 2 ans maximum.</p>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="d-flex gap-3">
                      <div class="flex-shrink-0 bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                        <i class="bi bi-award text-success"></i>
                      </div>
                      <div>
                        <h6 class="mb-1 text-success small fw-bold">Mijn EPC-labelpremie prolongé</h6>
                        <p class="small mb-0">Labels E/F → C/B/A : jusqu'au <strong>30 juin 2026</strong>.</p>
                      </div>
                    </div>
                  </div>
                  <div class="col-md-4">
                    <div class="d-flex gap-3">
                      <div class="flex-shrink-0 bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                        <i class="bi bi-thermometer text-warning"></i>
                      </div>
                      <div>
                        <h6 class="mb-1 text-warning small fw-bold">PAC air-eau</h6>
                        <p class="small mb-0">Revenus élevés : réduite de <strong>2.250€ → 1.500€</strong>.</p>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="mt-3 pt-2 border-top small text-muted">
                  <i class="bi bi-calendar3 me-1"></i>Informations mises à jour en novembre 2025 — vérifiez toujours les conditions actuelles.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div><%# /accordion row %>

  </div><%# /container %>
</div><%# /bg-light %>


<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_service('flandre') %>
  </script>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  // Initialisation automatique de la région Flandre dès que le DOM est prêt
  document.addEventListener('DOMContentLoaded', function() {
    localStorage.setItem("region", "flandre");
    console.log('🌍 Région Flandre initialisée dans localStorage');

    // Afficher les cartes par défaut pour la catégorie 1 si aucune catégorie n'est définie
    const categorieId = "<%= @categorie_id %>" || "1";
    console.log('📊 Catégorie affichée:', categorieId);

    // Afficher les cartes par défaut
    const primesSection = document.querySelector('.primes-section');
    const primesPlaceholder = document.querySelector('#primes-placeholder');

    if (primesSection && primesPlaceholder) {
      primesSection.style.display = '';
      primesPlaceholder.style.display = 'none';
    }
  });

  window.primes = <%= raw(@primes.to_json(
    only: [:slug, :titre, :unite, :type_de_valeur, :valeurs_par_categorie, :placeholder, :condition, :conseil, :document, :eligible_categories]
  )) %>;

  window.categorieId = "<%= @categorie_id || '1' %>";
  window.plafondsParCategorie = <%= raw(@plafonds_par_categorie.to_json) %>;
  window.groupesPlafond = <%= raw(@groupes_plafond.to_json) %>;
</script>
