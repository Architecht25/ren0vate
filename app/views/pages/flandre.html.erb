<script>
  // Initialisation automatique de la région Flandre dès que le DOM est prêt
  document.addEventListener('DOMContentLoaded', function() {
    localStorage.setItem("region", "flandre");
    console.log('🌍 Région Flandre initialisée dans localStorage');

    // Afficher les cartes par défaut pour la catégorie 1 si aucune catégorie n'est définie
    const categorieId = "<%= @categorie_id %>" || "1";
    console.log('📊 Catégorie affichée:', categorieId);

    // Afficher les cartes par défaut
    const primesSection = document.querySelector('.primes-section');
    const primesPlaceholder = document.querySelector('#primes-placeholder');

    if (primesSection && primesPlaceholder) {
      primesSection.style.display = '';
      primesPlaceholder.style.display = 'none';
    }
  });

  window.primes = <%= raw(@primes.to_json(
    only: [:slug, :titre, :unite, :type_de_valeur, :valeurs_par_categorie, :placeholder, :condition, :conseil, :document, :eligible_categories]
  )) %>;

  window.categorieId = "<%= @categorie_id || '1' %>";
  window.plafondsParCategorie = <%= raw(@plafonds_par_categorie.to_json) %>;
  window.groupesPlafond = <%= raw(@groupes_plafond.to_json) %>;
</script>


<div class="container-fluid my-5">

  <div class="text-center mb-4">
    <h1 class="display-4">Ren0vate</h1>
    <p class="lead text-muted">Commençons par le début et testez votre éligibilité ✏️</p>
  </div>

  <div class="row">
    <!-- COLONNE GAUCHE : Test d'éligibilité -->
    <div class="col-lg-6 mb-4" style="background-color: #ffffff; border-right: 1px solid #dee2e6;">
      <div class="pe-lg-3">

      <!-- Affichage des profils -->
      <div data-region-display-target="flandre" class="text-center" data-controller="user_type">
        <div class="card shadow-sm mb-4">
          <div class="card-body text-center">
            <h4 class="mb-3">Flandre – Quel est votre profil ?</h4>
              <div class="btn-group flex-wrap" role="group">
                <button class="btn btn-outline-success m-1" data-action="click->user_type#select" data-user="prive">Particulier</button>
                <button class="btn btn-outline-success m-1" data-action="click->user_type#select" data-user="entreprise">Entreprise</button>
                <button class="btn btn-outline-success m-1" data-action="click->user_type#select" data-user="syndic">Syndic de Copropriété</button>
                <button class="btn btn-outline-success m-1" data-action="click->user_type#select" data-user="bailleur">Bailleur social</button>
                <button class="btn btn-outline-success m-1" data-action="click->user_type#select" data-user="asbl">ASBL / Coopérative</button>
              </div>
          </div>
        </div>
      </div>

      <!-- Test d’éligibilité -->
      <div id="eligibility-test" data-controller="test-eligibilite" class="">
        <div class="card shadow-sm">
          <div class="card-body">
            <h3 class="mb-4">Test d’éligibilité</h3>
            <form id="eligibilityForm" name="eligibilityForm" data-test-eligibilite-target="form">
              <%# Répète cette structure pour chaque step %>
              <% steps = {
                "usage" => "Le bien est-il destiné à être habité ?",
                "propriétaire" => "Êtes-vous propriétaire du bien (min 1%)?",
                "autre_bien" => "Possédez-vous un autre bien/appartement/terrain ?",
                "annee" => "Le logement a-t-il été construit avant le 1er janvier 2006 ?",
                "appartement" => "Le logement est-il un appartement non soumis à copropriété (vma)?",
                "appartement-copro" => "Logement est-il un appartement soumis à copropriété (vma)?",
                "immeuble-appartements" => "Le bien est-il un immeuble à appartements destinés au logement?",
                "type" => "Le logement est-il une maison?",
                "peb" => "Le certificat PEB indique-t-il un label E ou F ?",
                "domicile" => "Êtes-vous ou serez-vous domicilié dans ce logement ?",
                "demolition" => "Le logement est-il un bâtiment qui a été démoli mais en gardant des résidus pour bénéficier de la TVA à 6% ?",
                "travaux" => "Prévoyez-vous des travaux d’isolation ou de chauffage ?",
                "protege" => "Êtes-vous un client protégé ?"
              } %>

              <% steps.each do |key, question| %>
                <div class="form-card mb-4" data-test-eligibilite-target="formCard">
                  <h5><%= question %></h5>
                  <div class="form-check">
                    <input type="radio" class="form-check-input" name="<%= key %>" value="oui" data-action="click->test-eligibilite#handleAnswer" id="<%= key %>_oui">
                    <label class="form-check-label" for="<%= key %>_oui">Oui</label>
                  </div>
                  <div class="form-check">
                    <input type="radio" class="form-check-input" name="<%= key %>" value="non" data-action="click->test-eligibilite#handleAnswer" id="<%= key %>_non">
                    <label class="form-check-label" for="<%= key %>_non">Non</label>
                  </div>
                </div>
              <% end %>
            </form>

            <!-- Bouton de validation du test -->
            <div class="text-center mt-4">
              <button type="button"
                      class="btn btn-success btn-lg"
                      data-action="click->test-eligibilite#validateTest"
                      data-test-eligibilite-target="validateButton"
                      style="display: none;">
                📝 Valider mon test d'éligibilité
              </button>
            </div>

            <div id="result"
              data-test-eligibilite-target="result"
              class="alert alert-info mt-4 text-center"
              style="display: none;">
            </div>

            <!-- Bouton pour recalculer l'éligibilité -->
            <div id="affinage-categorie" data-controller="categorie-estimation" class="mt-4 p-3 border rounded bg-light" style="display: none;">
              <h5 class="mb-3">Affinez votre catégorie en précisant ces éléments :</h5>

              <!-- Statut du ménage -->
              <div class="mb-3">
                <label for="statut-familial" class="form-label">Situation familiale</label>
                <select id="statut-familial" class="form-select" required>
                  <option value="">Sélectionnez une option</option>
                  <option value="isolé">Isolé / Célibataire</option>
                  <option value="isolé-enfant">Isolé avec enfant à charge</option>
                  <option value="couple">Couple sans enfants"</option>
                  <option value="couple-enfant">Couple avec enfants à charge</option>
                </select>
              </div>

              <!-- Nombre de personnes à charge -->
              <div class="mb-3">
                <label for="personnes-charge" class="form-label">Nombre de personnes à charge</label>
                <select id="personnes-charge" class="form-select" required>
                  <option value="">Sélectionnez</option>
                  <option value="0">0</option>
                  <option value="1">1</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                  <option value="4">4</option>
                </select>
              </div>

              <!-- Revenu imposable net -->
              <div class="mb-3">
                <label for="revenu-net" class="form-label">Revenu imposable globablement du ménage</label>
                <select id="revenu-net" class="form-select" required>
                  <option value="">Sélectionnez une tranche</option>
                  <option value="-24320">Moins de 24.230 €</option>
                  <option value="24231-42340">24.231 € – 42.340 €</option>
                  <option value="42341-53880">42.341 € – 53.880 €</option>
                  <option value="53881+">Plus de 53.881 €</option>
                </select>
                <p class="mt-3 text-muted small">
                  💡 Pour un calcul précis basé sur vos documents fiscaux, créez un compte ou connectez-vous à votre espace personnel.
                </p>
              </div>

              <button id="valider-affinage"
                      class="btn btn-success mt-2"
                      data-action="click->categorie-estimation#estimerCategorie">
                Valider et recalculer ma catégorie
              </button>


              <!-- Résultat de l'estimation -->
              <div id="result-affinage"
                  data-categorie-estimation-target="resultAffinage"
                  class="alert alert-secondary mt-3 text-center"
                  style="display: none;">
              </div>

              <button id="go-simulateur" style="display: none;" class="btn btn-primary mt-3">
                🎯 Accéder au simulateur
              </button>

            </div>
          </div>
        </div>
        </div> <!-- fin pe-lg-3 -->
      </div> <!-- fin col-lg-6 colonne gauche -->
    </div> <!-- fin col-lg-6 mb-4 -->

    <!-- COLONNE DROITE : Cartes de primes -->
    <div class="col-lg-6" style="background-color: #f8f9fa; min-height: 400px;">
      <div class="ps-lg-4">

        <!-- Message d'info initial -->
        <div id="primes-placeholder" class="text-center py-5" style="display: none;">
          <div class="alert alert-info">
            <i class="bi bi-info-circle fs-3 mb-3 d-block"></i>
            <h5>Complétez le test d'éligibilité</h5>
            <p class="mb-0">Vos primes personnalisées apparaîtront ici selon votre catégorie.</p>
          </div>
        </div>

        <!-- Simulation préalable des primes via les mini cartes primes -->
        <div class="primes-section" data-controller="prime-calcul" style="">
          <h4 class="mb-4">Vos primes éligibles - Catégorie <%= @categorie_id || '1' %></h4>
          <div class="row g-3">
            <% @primes.each do |prime| %>
              <% current_categorie = @categorie_id || '1' %>
              <% if prime.eligible_categories.include?(current_categorie.to_s) %>
                <div class="col-lg-4 col-md-6 col-12" data-controller="prime-card" data-slug="<%= prime.slug %>">
                  <div class="card shadow-sm border-0 p-3 mb-3 h-100">
                    <div class="card-body p-2">
                      <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                          <i class="bi bi-<%= prime.icon_name %> fs-5 text-success"></i>
                        </div>
                        <h6 class="card-title mb-0 flex-grow-1"><%= prime.titre %></h6>
                      </div>

                      <% if prime.slug == "isolation_murs_cat12" %>
                        <!-- Carte spéciale : isolation murs cat 1-2 -->
                        <div class="d-flex justify-content-between align-items-center gap-2"
                              data-controller="prime-card"
                              data-slug="<%= prime.slug %>">
                          <select class="form-select w-50 select-type-mur"
                                  data-prime-card-target="select"
                                  data-action="change->prime-card#update"
                                  data-slug="<%= prime.slug %>">
                            <option value="0">Choisissez</option>
                            <option value="facades">façades</option>
                            <option value="murs_creux">murs creux</option>
                            <option value="murs_interieurs">murs intérieurs</option>
                          </select>
                          <input type="number"
                                  class="form-control w-25 prime-input"
                                  data-prime-card-target="input"
                                  data-action="input->prime-card#update"
                                  data-slug="<%= prime.slug %>"
                                  placeholder="<%= prime.placeholder %>">
                          <span class="input-group-text bg-success text-white prime-result"
                                data-slug="<%= prime.slug %>">
                            0 €
                          </span>
                        </div>

                      <% elsif prime.slug == "warmtepomp" %>

                        <div class="d-flex justify-content-between align-items-center gap-2">
                          <!-- Sélecteur -->
                          <select class="form-select w-75"
                                  data-action="change->prime-card#update"
                                  data-prime-card-target="select">
                            <option value="0">Choisissez le type de pompe</option>
                            <option value="geothermique">geothermique</option>
                            <option value="air_eau">air eau</option>
                            <option value="air_air">air air</option>
                            <option value="hybride">hybride</option>
                          </select>

                          <!-- Montant -->
                          <span class="input-group-text bg-success text-white prime-result w-25 text-center"
                                data-slug="<%= prime.slug %>">
                            0 €
                          </span>
                        </div>

                      <% else %>
                        <!-- Logique générale pour les autres primes -->
                        <div class="d-flex justify-content-between align-items-center gap-2">
                          <input type="number"
                                class="form-control w-75 prime-input"
                                data-prime-card-target="input"
                                data-action="input->prime-card#update"
                                data-slug="<%= prime.slug %>"
                                placeholder="<%= prime.placeholder %>">

                          <span class="input-group-text bg-success text-white prime-result"
                                data-slug="<%= prime.slug %>">
                            0 €
                          </span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>

            <!-- Cartes statiques en bas -->
            <div class="col-lg-4 col-md-6 col-12">
              <div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
                <div class="card-body d-flex flex-column align-items-center gap-3">
                  <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-award fs-5 text-primary"></i>
                  </div>
                  <h6 class="card-title mb-2">Label PEB</h6>
                  <p class="mb-3 text-sm">Bénéficiez d'aides pour la certification énergétique.</p>
                  <a href="<%= "#" %>" class="btn btn-outline-primary btn-sm mt-auto">Se connecter</a>
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12">
              <div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
                <div class="card-body d-flex flex-column align-items-center gap-3">
                  <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-building fs-5 text-warning"></i>
                  </div>
                  <h6 class="card-title mb-2">Primes communales</h6>
                  <p class="mb-3 text-sm">Découvrez les aides de votre commune.</p>
                  <a href="<%= "#" %>" class="btn btn-outline-warning btn-sm mt-auto">Se connecter</a>
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-6 col-12">
              <div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
                <div class="card-body d-flex flex-column align-items-center gap-3">
                  <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-bank fs-5 text-info"></i>
                  </div>
                  <h6 class="card-title mb-2">Monuments & Sites</h6>
                  <p class="mb-3 text-sm">Aides pour bâtiments classés.</p>
                  <a href="<%= "#" %>" class="btn btn-outline-info btn-sm mt-auto">Se connecter</a>
                </div>
              </div>
            </div>
          </div>
        </div>

          <div class="text-end mt-4 fw-bold fs-5">
            Total estimé des primes : <span id="total-primes-affiche">0.00 €</span>
          </div>
        </div>
     <!-- fin col-lg-6 colonne droite -->
      </div> <!-- fin ps-lg-4 -->

  </div> <!-- fin row -->

  <!-- lien vers la liste des primes en flandre -->
  <div class="text-center mb-5 d-flex flex-wrap justify-content-center gap-3">
    <%= link_to "Voir la liste des primes en Flandre", primes_path, class: "btn btn-outline-danger" %>
    <%= link_to "Voir la liste des catégories de revenus en Flandre", categories_path, class: "btn btn-outline-danger" %>
    <%= link_to "Retour à l'accueil", root_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Surveiller le localStorage", localstorage_path, class: "btn btn-outline-info" %>
  </div>

</div>
