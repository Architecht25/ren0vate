<script>
  // Initialisation automatique de la région Flandre dès que le DOM est prêt
  document.addEventListener('DOMContentLoaded', function() {
    localStorage.setItem("region", "flandre");
    console.log('🌍 Région Flandre initialisée dans localStorage');

    // Afficher les cartes par défaut pour la catégorie 1 si aucune catégorie n'est définie
    const categorieId = "<%= @categorie_id %>" || "1";
    console.log('📊 Catégorie affichée:', categorieId);

    // Afficher les cartes par défaut
    const primesSection = document.querySelector('.primes-section');
    const primesPlaceholder = document.querySelector('#primes-placeholder');

    if (primesSection && primesPlaceholder) {
      primesSection.style.display = '';
      primesPlaceholder.style.display = 'none';
    }
  });

  window.primes = <%= raw(@primes.to_json(
    only: [:slug, :titre, :unite, :type_de_valeur, :valeurs_par_categorie, :placeholder, :condition, :conseil, :document, :eligible_categories]
  )) %>;

  window.categorieId = "<%= @categorie_id || '1' %>";
  window.plafondsParCategorie = <%= raw(@plafonds_par_categorie.to_json) %>;
  window.groupesPlafond = <%= raw(@groupes_plafond.to_json) %>;
</script>


<div class="container-fluid py-4">
  <!-- Header moderne et cohérent -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-house-check text-primary fs-4"></i>
              </div>
              <div>
                <h1 class="h3 mb-1 text-primary">Flandre - Primes de Rénovation</h1>
                <p class="text-muted mb-0">Testez votre éligibilité et découvrez vos primes</p>
              </div>
            </div>
            <%= link_to root_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-arrow-left me-2"></i>Retour à l'accueil
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- COLONNE GAUCHE : Test d'éligibilité -->
    <div class="col-lg-6">
      <div class="h-100">

        <!-- Sélection du profil -->
        <div data-region-display-target="flandre" data-controller="user_type" class="mb-4">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h4 class="card-title mb-0">
                <i class="bi bi-person-circle text-primary me-2"></i>
                Quel est votre profil ?
              </h4>
            </div>
            <div class="card-body">
              <div class="row g-2">
                <div class="col-md-6">
                  <button class="btn btn-outline-primary w-100" data-action="click->user_type#select" data-user="prive">
                    <i class="bi bi-house me-2"></i>Particulier
                  </button>
                </div>
                <div class="col-md-6">
                  <button class="btn btn-outline-primary w-100" data-action="click->user_type#select" data-user="entreprise">
                    <i class="bi bi-building me-2"></i>Entreprise
                  </button>
                </div>
                <div class="col-md-6">
                  <button class="btn btn-outline-primary w-100" data-action="click->user_type#select" data-user="syndic">
                    <i class="bi bi-people me-2"></i>Syndic
                  </button>
                </div>
                <div class="col-md-6">
                  <button class="btn btn-outline-primary w-100" data-action="click->user_type#select" data-user="bailleur">
                    <i class="bi bi-key me-2"></i>Bailleur social
                  </button>
                </div>
                <div class="col-12">
                  <button class="btn btn-outline-primary w-100" data-action="click->user_type#select" data-user="asbl">
                    <i class="bi bi-shield-check me-2"></i>ASBL / Coopérative
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

      <!-- Test d’éligibilité -->
      <div id="eligibility-test" data-controller="test-eligibilite">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-light">
            <h4 class="card-title mb-0">
              <i class="bi bi-check-circle text-success me-2"></i>
              Test d'éligibilité
            </h4>
          </div>
          <div class="card-body">
            <form id="eligibilityForm" name="eligibilityForm" data-test-eligibilite-target="form">
              <%# Répète cette structure pour chaque step %>
              <% steps = {
                "usage" => "Le bien est-il destiné à être habité ?",
                "propriétaire" => "Êtes-vous propriétaire du bien (min 1%)?",
                "autre_bien" => "Possédez-vous un autre bien/appartement/terrain, autre que le bien rénové?",
                "annee" => "Le bien rénové a-t-il été construit avant le 1er janvier 2006 ?",
                "appartement" => "Le bien rénové est-il un appartement non soumis à copropriété (vma)?",
                "appartement-copro" => "Le bien rénové est-il un appartement soumis à copropriété (vma)?",
                "immeuble-appartements" => "Le bien rénové est-il un immeuble à appartements destinés au logement?",
                "type" => "Le bien rénové est-il une maison?",
                "facture_solde" => "La facture de solde des travaux de rénovation est-t-elle datée de plus de 2 ans ?",
                "peb" => "Le certificat PEB avant travaux de rénovation indique-t-il un label E, F ou G ?",
                "domicile" => "Êtes-vous ou serez-vous domicilié une fois le bien rénové?",
                "demolition" => "Le bien rénové est-il en réalité une reconstruction après démolition, destinée à bénéficier du taux réduit de TVA à 6 % ?",
                "travaux" => "Prévoyez-vous des travaux d’isolation ou de chauffage ?",
                "protege" => "Êtes-vous un client protégé, à savoir: une personne qui remplit certaines conditions sociales ou financières, déterminées par l'État fédéral ou la Région flamande, et qui a droit au tarif social pour l’énergie ?"
              } %>

              <% steps.each do |key, question| %>
                <div class="mb-3 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
                  <h6 class="mb-3 text-dark"><%= question %></h6>
                  <div class="d-flex gap-3">
                    <div class="form-check">
                      <input type="radio" class="form-check-input" name="<%= key %>" value="oui" data-action="click->test-eligibilite#handleAnswer" id="<%= key %>_oui">
                      <label class="form-check-label" for="<%= key %>_oui">
                        <i class="bi bi-check-circle text-success me-1"></i>Oui
                      </label>
                    </div>
                    <div class="form-check">
                      <input type="radio" class="form-check-input" name="<%= key %>" value="non" data-action="click->test-eligibilite#handleAnswer" id="<%= key %>_non">
                      <label class="form-check-label" for="<%= key %>_non">
                        <i class="bi bi-x-circle text-danger me-1"></i>Non
                      </label>
                    </div>
                  </div>
                </div>
              <% end %>
            </form>

            <!-- Bouton de validation du test -->
            <div class="text-center mt-4">
              <button type="button"
                      class="btn btn-success btn-lg"
                      data-action="click->test-eligibilite#validateTest"
                      data-test-eligibilite-target="validateButton"
                      style="display: none;">
                <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
              </button>
            </div>

            <div id="result"
              data-test-eligibilite-target="result"
              class="alert alert-info mt-4 text-center"
              style="display: none;">
            </div>

            <!-- Section d'affinage de catégorie améliorée -->
            <div id="affinage-categorie" data-controller="categorie-estimation" class="mt-4" style="display: none;">
              <div class="card border-warning">
                <div class="card-header bg-warning bg-opacity-10">
                  <h5 class="card-title mb-0">
                    <i class="bi bi-gear text-warning me-2"></i>
                    Affinez votre catégorie
                  </h5>
                </div>
                <div class="card-body">
                  <!-- Statut du ménage -->
                  <div class="mb-3">
                    <label for="statut-familial" class="form-label">Situation familiale</label>
                    <select id="statut-familial" class="form-select" required>
                      <option value="">Sélectionnez une option</option>
                      <option value="isolé">Isolé / Célibataire</option>
                      <option value="isolé-enfant">Isolé avec enfant à charge</option>
                      <option value="couple">Couple sans enfants"</option>
                      <option value="couple-enfant">Couple avec enfants à charge</option>
                    </select>
                  </div>

                  <!-- Nombre de personnes à charge -->
                  <div class="mb-3">
                    <label for="personnes-charge" class="form-label">Nombre de personnes à charge</label>
                    <select id="personnes-charge" class="form-select" required>
                      <option value="">Sélectionnez</option>
                      <option value="0">0</option>
                      <option value="1">1</option>
                      <option value="2">2</option>
                      <option value="3">3</option>
                      <option value="4">4</option>
                    </select>
                  </div>

                  <!-- Revenu imposable net -->
                  <div class="mb-3">
                    <label for="revenu-net" class="form-label">Revenu imposable globablement du ménage</label>
                    <select id="revenu-net" class="form-select" required>
                      <option value="">Sélectionnez une tranche</option>
                      <option value="-24320">Moins de 24.230 €</option>
                      <option value="24231-42340">24.231 € – 42.340 €</option>
                      <option value="42341-53880">42.341 € – 53.880 €</option>
                      <option value="53881+">Plus de 53.881 €</option>
                    </select>
                    <p class="mt-3 text-muted small">
                      💡 Pour un calcul précis basé sur vos documents fiscaux, créez un compte ou connectez-vous à votre espace personnel.
                    </p>
                  </div>

                  <button id="valider-affinage"
                          class="btn btn-success mt-2"
                          data-action="click->categorie-estimation#estimerCategorie">
                    Valider et recalculer ma catégorie
                  </button>


                  <!-- Résultat de l'estimation -->
                  <div id="result-affinage"
                      data-categorie-estimation-target="resultAffinage"
                      class="alert alert-secondary mt-3 text-center"
                      style="display: none;">
                  </div>

                  <button id="go-simulateur" style="display: none;" class="btn btn-primary mt-3">
                    🎯 Accéder au simulateur
                  </button>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div> <!-- fin test-eligibilite controller -->
      </div> <!-- fin pe-lg-3 -->
    </div> <!-- fin col-lg-6 colonne gauche -->

    <!-- COLONNE DROITE : Primes et simulateur -->
    <div class="col-lg-6">
      <div class="h-100">

        <!-- Message d'info initial -->
        <div id="primes-placeholder" class="card border-0 shadow-sm text-center" style="display: none;">
          <div class="card-body py-5">
            <div class="text-primary mb-3">
              <i class="bi bi-info-circle fs-1"></i>
            </div>
            <h5 class="text-primary">Complétez le test d'éligibilité</h5>
            <p class="text-muted mb-0">Vos primes personnalisées apparaîtront ici selon votre catégorie.</p>
          </div>
        </div>

        <!-- Simulation des primes -->
        <div class="primes-section" data-controller="prime-calcul">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h4 class="card-title mb-0">
                <i class="bi bi-calculator text-success me-2"></i>
                Vos primes éligibles - Catégorie <%= @categorie_id || '1' %>
              </h4>
            </div>
            <div class="card-body">
              <div class="row g-3">
            <% @primes.each do |prime| %>
              <% current_categorie = @categorie_id || '1' %>
              <% if prime.eligible_categories.include?(current_categorie.to_s) %>
                <div class="col-lg-4 col-md-6 col-12" data-controller="prime-card" data-slug="<%= prime.slug %>">
                  <div class="card shadow-sm border-0 p-3 mb-3 h-100">
                    <div class="card-body p-2">
                      <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                          <i class="bi bi-<%= prime.icon_name %> fs-5 text-success"></i>
                        </div>
                        <h6 class="card-title mb-0 flex-grow-1"><%= prime.titre %></h6>
                      </div>

                      <% if prime.slug == "isolation_murs_cat12" %>
                        <!-- Carte spéciale : isolation murs cat 1-2 -->
                        <div class="d-flex justify-content-between align-items-center gap-2"
                              data-controller="prime-card"
                              data-slug="<%= prime.slug %>">
                          <select class="form-select w-50 select-type-mur"
                                  data-prime-card-target="select"
                                  data-action="change->prime-card#update"
                                  data-slug="<%= prime.slug %>">
                            <option value="0">Choisissez</option>
                            <option value="facades">façades</option>
                            <option value="murs_creux">murs creux</option>
                            <option value="murs_interieurs">murs intérieurs</option>
                          </select>
                          <input type="number"
                                  class="form-control w-25 prime-input"
                                  data-prime-card-target="input"
                                  data-action="input->prime-card#update"
                                  data-slug="<%= prime.slug %>"
                                  placeholder="<%= prime.placeholder %>">
                          <span class="input-group-text bg-success text-white prime-result"
                                data-slug="<%= prime.slug %>">
                            0 €
                          </span>
                        </div>

                      <% elsif prime.slug == "warmtepomp" %>

                        <div class="d-flex justify-content-between align-items-center gap-2">
                          <!-- Sélecteur -->
                          <select class="form-select w-75"
                                  data-action="change->prime-card#update"
                                  data-prime-card-target="select">
                            <option value="0">Choisissez le type de pompe</option>
                            <option value="geothermique">geothermique</option>
                            <option value="air_eau">air eau</option>
                            <option value="air_air">air air</option>
                            <option value="hybride">hybride</option>
                          </select>

                          <!-- Montant -->
                          <span class="input-group-text bg-success text-white prime-result w-25 text-center"
                                data-slug="<%= prime.slug %>">
                            0 €
                          </span>
                        </div>

                      <% else %>
                        <!-- Logique générale pour les autres primes -->
                        <div class="d-flex justify-content-between align-items-center gap-2">
                          <input type="number"
                                class="form-control w-75 prime-input"
                                data-prime-card-target="input"
                                data-action="input->prime-card#update"
                                data-slug="<%= prime.slug %>"
                                placeholder="<%= prime.placeholder %>">

                          <span class="input-group-text bg-success text-white prime-result"
                                data-slug="<%= prime.slug %>">
                            0 €
                          </span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
              </div>

              <!-- Total estimé -->
              <div class="mt-4 p-3 bg-success bg-opacity-10 rounded">
                <div class="d-flex justify-content-between align-items-center">
                  <h5 class="text-success mb-0">
                    <i class="bi bi-calculator me-2"></i>
                    Total estimé des primes :
                  </h5>
                  <span class="h4 text-success mb-0" id="total-primes-affiche">0.00 €</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Autres aides disponibles -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-light">
            <h5 class="card-title mb-0">
              <i class="bi bi-gift text-info me-2"></i>
              Autres aides disponibles
            </h5>
          </div>
          <div class="card-body">
            <div class="row g-3">
            <!-- Carte PEB Interactive -->
            <% if defined?(@prime_peb) %>
              <%= render 'shared/primes/prime_peb_card', prime_peb: @prime_peb %>
            <% else %>
              <%= render 'shared/primes/prime_peb_card', prime_peb: nil %>
            <% end %>

            <div class="col-lg-4 col-md-4 col-12">
              <div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
                <div class="card-body d-flex flex-column align-items-center gap-3">
                  <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-building fs-5 text-warning"></i>
                  </div>
                  <h6 class="card-title mb-2">Primes communales</h6>
                  <p class="mb-3 text-sm">Découvrez les aides de votre commune.</p>
                  <a href="<%= "#" %>" class="btn btn-outline-warning btn-sm mt-auto">Se connecter</a>
                </div>
              </div>
            </div>

            <div class="col-lg-4 col-md-4 col-12">
              <div class="card shadow-sm border-0 p-3 text-center mb-3 h-100">
                <div class="card-body d-flex flex-column align-items-center gap-3">
                  <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-bank fs-5 text-info"></i>
                  </div>
                  <h6 class="card-title mb-2">Monuments & Sites</h6>
                  <p class="mb-3 text-sm">Aides pour bâtiments classés.</p>
                  <a href="<%= "#" %>" class="btn btn-outline-info btn-sm mt-auto">Se connecter</a>
                </div>
              </div>
            </div>              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Actions et liens utiles -->
  <div class="row mt-5">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="row g-3 align-items-center">
            <div class="col-md-8">
              <h5 class="mb-1">
                <i class="bi bi-link-45deg text-primary me-2"></i>
                Liens utiles
              </h5>
              <p class="text-muted mb-0">Accédez aux informations détaillées sur les primes en Flandre</p>
            </div>
            <div class="col-md-4">
              <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                <%= link_to primes_path, class: "btn btn-outline-primary btn-sm" do %>
                  <i class="bi bi-list-ul me-1"></i>Primes
                <% end %>
                <%= link_to categories_path, class: "btn btn-outline-secondary btn-sm" do %>
                  <i class="bi bi-diagram-3 me-1"></i>Catégories
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
