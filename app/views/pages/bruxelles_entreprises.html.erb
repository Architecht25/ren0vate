<% content_for :title, "Aides aux Entreprises Bruxelles" %>
<% content_for :description, "Simulateur d'éligibilité aux aides et primes pour les entreprises de la Région de Bruxelles-Capitale" %>

<div class="hero-section bg-gradient-primary text-white py-5">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <h1 class="display-4 fw-bold mb-3">
          <i class="fas fa-building me-3"></i>
          Aides aux Entreprises Bruxelles
        </h1>
        <p class="lead mb-4">
          Découvrez en quelques clics les aides et primes auxquelles votre entreprise a droit en Région de Bruxelles-Capitale.
          Transition économique, investissements, recrutement, expertise... Un accompagnement financier adapté à vos projets.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <div class="badge bg-light text-dark fs-6 px-3 py-2">
            <i class="fas fa-check-circle me-2"></i>6 catégories d'aides
          </div>
          <div class="badge bg-light text-dark fs-6 px-3 py-2">
            <i class="fas fa-percent me-2"></i>Jusqu'à 80% de subvention
          </div>
          <div class="badge bg-light text-dark fs-6 px-3 py-2">
            <i class="fas fa-euro-sign me-2"></i>Plafonds avantageux
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container py-5">
  <!-- Section Info Rapide -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="alert alert-info border-0 shadow-sm">
        <div class="row align-items-center">
          <div class="col-md-8">
            <h5 class="alert-heading mb-2">
              <i class="fas fa-lightbulb me-2"></i>
              Basé sur l'outil officiel de la Région
            </h5>
            <p class="mb-0">
              Ce simulateur s'appuie sur les données officielles de
              <strong>Bruxelles Economie et Emploi</strong>. Pour une analyse détaillée avec votre numéro d'entreprise,
              utilisez également l'outil officiel.
            </p>
          </div>
          <div class="col-md-4 text-end">
            <a href="https://economie-emploi.brussels/quels-subsides" target="_blank" class="btn btn-outline-primary">
              <i class="fas fa-external-link-alt me-2"></i>
              Outil officiel
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Formulaire de Test d'Éligibilité -->
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <!-- Section Recherche BCE -->
      <div class="card shadow-lg border-0 mb-4">
        <div class="card-header bg-success text-white py-4">
          <h3 class="card-title mb-0 text-center">
            <i class="fas fa-search me-3"></i>
            Recherche d'informations entreprise (BCE)
          </h3>
        </div>
        <div class="card-body p-4" data-controller="bce-search">
          <div class="row">
            <div class="col-md-8">
              <label class="form-label fw-bold text-success">
                <i class="fas fa-building me-2"></i>
                Numéro d'entreprise BCE
              </label>
              <div class="input-group">
                <input type="text"
                       id="numero_entreprise_bce"
                       class="form-control form-control-lg"
                       placeholder="Ex: 0833618097"
                       pattern="[0-9]{10}"
                       maxlength="10"
                       data-bce-search-target="input">
                <button type="button"
                        class="btn btn-success"
                        data-bce-search-target="searchButton"
                        data-action="click->bce-search#rechercher">
                  <i class="fas fa-search me-2"></i>
                  Rechercher
                </button>
              </div>
              <div class="form-text">
                Saisissez le numéro d'entreprise à 10 chiffres (sans espaces ni points)
              </div>
            </div>
            <div class="col-md-4 d-flex align-items-end">
              <div class="text-muted small">
                <i class="fas fa-info-circle me-2"></i>
                Les informations seront récupérées automatiquement depuis la Banque-Carrefour des Entreprises
              </div>
            </div>
          </div>

          <!-- Zone d'affichage des résultats BCE -->
          <div id="bce-results"
               data-bce-search-target="results"
               class="mt-4"
               style="display: none;">
            <div class="alert alert-success border-0">
              <h5 class="alert-heading">
                <i class="fas fa-check-circle me-2"></i>
                Informations entreprise trouvées
              </h5>
              <div class="row mt-3">
                <div class="col-md-6">
                  <p class="mb-2">
                    <strong>Numéro d'entreprise:</strong>
                    <span data-bce-search-target="numeroEntreprise">-</span>
                  </p>
                  <p class="mb-2">
                    <strong>Forme légale:</strong>
                    <span data-bce-search-target="formeLegale">-</span>
                  </p>
                  <p class="mb-2">
                    <strong>Taille de l'entreprise:</strong>
                    <span data-bce-search-target="tailleEntreprise">-</span>
                  </p>
                </div>
                <div class="col-md-6">
                  <p class="mb-2">
                    <strong>Date d'inscription BCE:</strong>
                    <span data-bce-search-target="dateInscription">-</span>
                  </p>
                  <p class="mb-2">
                    <strong>Codes NACE TVA:</strong>
                    <span data-bce-search-target="codesNace">-</span>
                  </p>
                </div>
              </div>
              <div class="mt-3">
                <p class="mb-2"><strong>Adresses des unités d'établissement:</strong></p>
                <ul data-bce-search-target="adresses" class="list-unstyled ms-3">
                  <!-- Les adresses seront ajoutées ici -->
                </ul>
              </div>
            </div>
          </div>

          <!-- Zone d'erreur -->
          <div id="bce-error"
               data-bce-search-target="error"
               class="mt-4"
               style="display: none;">
            <div class="alert alert-warning border-0">
              <h6 class="alert-heading">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Entreprise non trouvée
              </h6>
              <p class="mb-0">
                Vérifiez le numéro d'entreprise saisi. Il doit contenir exactement 10 chiffres.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulaire d'éligibilité principal -->
      <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white py-4">
          <h3 class="card-title mb-0 text-center">
            <i class="fas fa-clipboard-check me-3"></i>
            Test d'Éligibilité aux Aides Entreprises
          </h3>
        </div>
        <div class="card-body p-4">
          <%= form_with url: test_eligibility_bruxelles_entreprises_path,
                        method: :post,
                        local: false,
                        data: {
                          controller: "test-eligibilite-entreprises",
                          test_eligibilite_entreprises_target: "form"
                        },
                        class: "needs-validation",
                        novalidate: true do |form| %>

            <!-- Questions d'éligibilité de base -->
            <div class="row">
              <!-- Localisation -->
              <div class="col-md-6 mb-4">
                <label class="form-label fw-bold text-primary">
                  <i class="fas fa-map-marker-alt me-2"></i>
                  Siège d'exploitation en Région de Bruxelles-Capitale ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :localisation, "oui", false,
                          id: "localisation_oui",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="localisation_oui">
                      Oui, siège d'exploitation en RBC
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :localisation, "non", false,
                          id: "localisation_non",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="localisation_non">
                      Non, pas de siège en RBC
                    </label>
                  </div>
                </div>
              </div>

              <!-- Taille d'entreprise -->
              <div class="col-md-6 mb-4">
                <label class="form-label fw-bold text-primary">
                  <i class="fas fa-users me-2"></i>
                  Taille de votre entreprise ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :taille_entreprise, "micro", false,
                          id: "taille_micro",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="taille_micro">
                      <strong>Micro-entreprise</strong> (< 10 employés)
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :taille_entreprise, "petite", false,
                          id: "taille_petite",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="taille_petite">
                      <strong>Petite entreprise</strong> (< 50 employés)
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :taille_entreprise, "moyenne", false,
                          id: "taille_moyenne",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="taille_moyenne">
                      <strong>Moyenne entreprise</strong> (< 250 employés)
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :taille_entreprise, "grande", false,
                          id: "taille_grande",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="taille_grande">
                      <strong>Grande entreprise</strong> (≥ 250 employés)
                    </label>
                  </div>
                </div>
              </div>

              <!-- Secteur éligible -->
              <div class="col-md-6 mb-4">
                <label class="form-label fw-bold text-primary">
                  <i class="fas fa-industry me-2"></i>
                  Secteur d'activité éligible ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :secteur_eligible, "oui", false,
                          id: "secteur_oui",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="secteur_oui">
                      Oui, secteur soutenu par la Région
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :secteur_eligible, "non", false,
                          id: "secteur_non",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="secteur_non">
                      Non, secteur non soutenu
                    </label>
                  </div>
                </div>
              </div>

              <!-- Finalité économique -->
              <div class="col-md-6 mb-4">
                <label class="form-label fw-bold text-primary">
                  <i class="fas fa-chart-line me-2"></i>
                  Finalité économique et non publique ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :finalite_economique, "oui", false,
                          id: "finalite_oui",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="finalite_oui">
                      Oui, entreprise à finalité économique
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :finalite_economique, "non", false,
                          id: "finalite_non",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="finalite_non">
                      Non, entreprise publique ou autres
                    </label>
                  </div>
                </div>
              </div>

              <!-- De minimis -->
              <div class="col-md-6 mb-4">
                <label class="form-label fw-bold text-primary">
                  <i class="fas fa-euro-sign me-2"></i>
                  Plus de 300.000€ d'aides de minimis sur 3 ans ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :de_minimis, "non", false,
                          id: "de_minimis_non",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="de_minimis_non">
                      Non, moins de 300.000€ reçus
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :de_minimis, "oui", false,
                          id: "de_minimis_oui",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="de_minimis_oui">
                      Oui, plus de 300.000€ reçus
                    </label>
                  </div>
                </div>
              </div>

              <!-- Numéro BCE -->
              <div class="col-md-6 mb-4">
                <label class="form-label fw-bold text-primary">
                  <i class="fas fa-id-card me-2"></i>
                  Numéro d'entreprise BCE valide ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :numero_bce, "oui", false,
                          id: "bce_oui",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="bce_oui">
                      Oui, inscrit à la BCE
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :numero_bce, "non", false,
                          id: "bce_non",
                          class: "form-check-input",
                          required: true,
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="bce_non">
                      Non, pas d'inscription BCE
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <!-- Section Majorations -->
            <div class="row mt-4">
              <div class="col-12">
                <h5 class="text-primary border-bottom pb-2 mb-3">
                  <i class="fas fa-star me-2"></i>
                  Majorations possibles (optionnel)
                </h5>
              </div>

              <div class="col-md-4 mb-3">
                <label class="form-label fw-bold">
                  <i class="fas fa-rocket me-2"></i>
                  Entreprise starter ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :entreprise_starter, "oui", false,
                          id: "starter_oui",
                          class: "form-check-input",
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="starter_oui">
                      Oui (+15%)
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :entreprise_starter, "non", false,
                          id: "starter_non",
                          class: "form-check-input",
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="starter_non">
                      Non
                    </label>
                  </div>
                </div>
              </div>

              <div class="col-md-4 mb-3">
                <label class="form-label fw-bold">
                  <i class="fas fa-leaf me-2"></i>
                  Exemplaire environnemental ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :exemplaire_environnemental, "oui", false,
                          id: "env_oui",
                          class: "form-check-input",
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="env_oui">
                      Oui (+15%)
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :exemplaire_environnemental, "non", false,
                          id: "env_non",
                          class: "form-check-input",
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="env_non">
                      Non
                    </label>
                  </div>
                </div>
              </div>

              <div class="col-md-4 mb-3">
                <label class="form-label fw-bold">
                  <i class="fas fa-heart me-2"></i>
                  Exemplaire social ?
                </label>
                <div class="mt-2">
                  <div class="form-check">
                    <%= radio_button_tag :exemplaire_social, "oui", false,
                          id: "social_oui",
                          class: "form-check-input",
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="social_oui">
                      Oui (+15%)
                    </label>
                  </div>
                  <div class="form-check">
                    <%= radio_button_tag :exemplaire_social, "non", false,
                          id: "social_non",
                          class: "form-check-input",
                          data: { action: "change->test-eligibilite-entreprises#handleAnswer" } %>
                    <label class="form-check-label" for="social_non">
                      Non
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bouton de validation -->
            <div class="text-center mt-4">
              <button type="submit"
                      class="btn btn-primary btn-lg px-5 py-3"
                      data-test_eligibilite_entreprises_target="validateButton"
                      style="display: none;">
                <i class="fas fa-search me-2"></i>
                Vérifier mon éligibilité
              </button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Zone de résultats -->
  <div class="row justify-content-center mt-4">
    <div class="col-lg-10">
      <div id="result" data-test_eligibilite_entreprises_target="result">
        <!-- Les résultats apparaîtront ici -->
      </div>
    </div>
  </div>

  <!-- Informations sur les catégories d'aides -->
  <div class="row mt-5">
    <div class="col-12">
      <h3 class="text-center mb-4">
        <i class="fas fa-info-circle me-2"></i>
        Les 6 catégories d'aides disponibles
      </h3>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center">
          <i class="fas fa-seedling text-success fa-3x mb-3"></i>
          <h5 class="card-title text-success">Transition économique</h5>
          <p class="card-text small">Consultance et investissements pour la transition sociale/environnementale</p>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center">
          <i class="fas fa-hammer text-primary fa-3x mb-3"></i>
          <h5 class="card-title text-primary">Investissements</h5>
          <p class="card-text small">Matériels, travaux, immobilier, conformité, sécurisation</p>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center">
          <i class="fas fa-user-plus text-info fa-3x mb-3"></i>
          <h5 class="card-title text-info">Recrutement & Formation</h5>
          <p class="card-text small">Aides à l'embauche et formation du personnel</p>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center">
          <i class="fas fa-user-tie text-warning fa-3x mb-3"></i>
          <h5 class="card-title text-warning">Expertise & Services</h5>
          <p class="card-text small">Consultance générale, études, audits externes</p>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center">
          <i class="fas fa-construction text-danger fa-3x mb-3"></i>
          <h5 class="card-title text-danger">Nuisances chantier</h5>
          <p class="card-text small">Dédommagement pour impact de chantiers publics</p>
        </div>
      </div>
    </div>

    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center">
          <i class="fas fa-globe text-secondary fa-3x mb-3"></i>
          <h5 class="card-title text-secondary">Exportation</h5>
          <p class="card-text small">Primes temporairement suspendues</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.hero-section {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
}

.bg-gradient-primary {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
}

/* Styles pour la recherche BCE */
#numero_entreprise_bce {
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 1px;
}

#bce-results .alert-success {
  border-left: 4px solid #28a745;
}

#bce-error .alert-warning {
  border-left: 4px solid #ffc107;
}

.bce-info-item {
  padding: 0.5rem 0;
  border-bottom: 1px solid rgba(0,0,0,0.1);
}

.bce-info-item:last-child {
  border-bottom: none;
}
</style>
