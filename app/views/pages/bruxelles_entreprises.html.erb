<% content_for :title, "Aides aux Entreprises Bruxelles" %>
<% content_for :description, "Simulateur d'éligibilité aux aides et primes pour les entreprises de la Région de Bruxelles-Capitale" %>

<%= render 'pages/bruxelles_entreprises/hero_section' %>

<!-- Section Info Rapide -->
<div class="container py-3">
  <div class="row mb-4">
    <div class="col-12">
      <%= render 'pages/bruxelles_entreprises/info_section' %>
    </div>
  </div>
</div>

<!-- Layout principal: 3 colonnes pleine largeur -->
<div class="container-fluid px-4 py-3">
  <div class="row">
    <!-- Colonne 1: BCE + Éligibilité (30%) -->
    <div class="col-lg-4">
      <!-- Recherche BCE -->
      <div class="mb-4">
        <%= render 'pages/bruxelles_entreprises/bce_search' %>
      </div>
    </div>

    <!-- Colonne 2: Questions + Résultats (30%) -->
    <div class="col-lg-4">
      <!-- Questions supplémentaires -->
      <div class="mb-4">
        <%= render 'pages/bruxelles_entreprises/eligibility_form' %>
      </div>

      <!-- Résultats de simulation -->
      <div class="mb-4">
        <%= render 'pages/bruxelles_entreprises/simulation_results' %>
      </div>

      <!-- Zone de résultats d'éligibilité -->
      <div id="result" data-test_eligibilite_entreprises_target="result">
        <!-- Les résultats d'éligibilité apparaîtront ici -->
      </div>
    </div>

    <!-- Colonne 3: Cartes d'estimation des aides (40%) -->
    <div class="col-lg-4">
      <%= render 'pages/bruxelles_entreprises/estimation_cards' %>
    </div>
  </div>
</div>

<style>
.hero-section {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
}

.bg-gradient-primary {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
}

/* Styles pour la recherche BCE */
#numero_entreprise_bce {
  font-family: 'Courier New', monospace;
  font-weight: bold;
  letter-spacing: 1px;
}

#bce-results .alert-success {
  border-left: 4px solid #28a745;
}

#bce-error .alert-warning {
  border-left: 4px solid #ffc107;
}

.bce-info-item {
  padding: 0.5rem 0;
  border-bottom: 1px solid rgba(0,0,0,0.1);
}

.bce-info-item:last-child {
  border-bottom: none;
}
</style>
