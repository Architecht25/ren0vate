<%
  seo_data = enterprise_seo_data('bruxelles')
  set_seo_meta(
    title: seo_data[:title],
    description: seo_data[:description],
    keywords: seo_data[:keywords],
    canonical_url: canonical_url_for(bruxelles_entreprises_path)
  )
%>

<% content_for :head do %>
  <script type="application/ld+json">
    <%= structured_data_service('bruxelles', 'entreprises') %>
  </script>
<% end %>
<% content_for :description, "Simulateur d'éligibilité aux aides et primes pour les entreprises de la Région de Bruxelles-Capitale" %>

<%= render 'pages/bruxelles_entreprises/hero_section' %>

<!-- Simulateur en 3 étapes inspiré des simulateurs des 3 régions -->
<div class="container-fluid px-4 py-3" data-controller="entreprise-workflow">
  <!-- Indicateur de progression -->
  <div class="row mb-4">
    <div class="col-12">
      <%= render 'pages/bruxelles_entreprises/workflow_progress' %>
    </div>
  </div>

  <!-- ÉTAPE 1: Test d'éligibilité (colonne gauche) + Simulation par calcul (colonne droite) -->
  <div class="row" id="step-1-2" data-entreprise-workflow-target="step12">
    <!-- Colonne gauche: Test d'éligibilité -->
    <div class="col-lg-6" data-entreprise-workflow-target="step1">
      <div class="card shadow-lg border-0 mb-4 h-100">
        <div class="card-header bg-primary text-white py-3">
          <h4 class="mb-0">
            <span class="badge bg-light text-primary rounded-circle me-2">1</span>
            Test d'Éligibilité
          </h4>
          <small class="d-block mt-1 opacity-75">5 questions simples pour vérifier votre éligibilité</small>
        </div>
        <div class="card-body">
          <%= render 'pages/bruxelles_entreprises/eligibility_test' %>
        </div>
      </div>
    </div>

    <!-- Colonne droite: Simulation par calcul -->
    <div class="col-lg-6" data-entreprise-workflow-target="step2">
      <div class="card shadow-lg border-0 mb-4 h-100">
        <div class="card-header bg-success text-white py-3">
          <h4 class="mb-0">
            <span class="badge bg-light text-success rounded-circle me-2">2</span>
            Simulation par Calcul
          </h4>
          <small class="d-block mt-1 opacity-75">14 aides avec descriptifs et calculs automatiques</small>
        </div>
        <div class="card-body">
          <%= render 'pages/bruxelles_entreprises/simulation_cards' %>
        </div>
      </div>
    </div>
  </div>

  <!-- ÉTAPE 3: Accès à l'application -->
  <div class="row mt-4" id="step-3" style="display: none;" data-entreprise-workflow-target="step3">
    <div class="col-12">
      <%= render 'pages/bruxelles_entreprises/application_access' %>
    </div>
  </div>

  <!-- ÉTAPE FINALE : CTA Principal pour connexion -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-warning shadow-lg">
        <div class="card-header bg-warning text-dark">
          <h3 class="h4 mb-0 text-center">
            <span class="badge bg-dark me-2">3</span>
            🚀 Connectez-vous pour aller plus loin !
          </h3>
        </div>
        <div class="card-body text-center py-4">
          <div class="row align-items-center">
            <div class="col-md-8 mb-3 mb-md-0">
              <h4 class="text-primary mb-3">Débloquez toutes les fonctionnalités de l'application</h4>
              <div class="row g-3 text-start">
                <div class="col-md-6">
                  <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Démarches détaillées</strong> pour chaque prime</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Conseils d'expert</strong> personnalisés</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Documents officiels</strong> à télécharger</li>
                  </ul>
                </div>
                <div class="col-md-6">
                  <ul class="list-unstyled">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Suivi de vos projets</strong> de rénovation</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Alertes</strong> sur les nouvelles primes</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Support expert</strong> inclus</li>
                  </ul>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="d-grid gap-2">
                <% if user_signed_in? %>
                  <a href="<%= dashboard_path %>" class="btn btn-primary btn-lg shadow">
                    <i class="bi bi-speedometer2 me-2"></i>
                    Accéder au Dashboard
                  </a>
                <% else %>
                  <a href="<%= new_user_session_path %>" class="btn btn-primary btn-lg shadow">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Se connecter
                  </a>
                  <a href="<%= new_user_registration_path %>" class="btn btn-success btn-lg shadow">
                    <i class="bi bi-person-plus me-2"></i>
                    Créer un compte gratuit
                  </a>
                <% end %>
                <small class="text-muted mt-2 d-block">
                  <i class="bi bi-shield-check me-1"></i>
                  Gratuit • Sans engagement • Sécurisé
                </small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<style>
.hero-section {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
}

.bg-gradient-primary {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
}

/* Styles pour le workflow d'entreprise */
.step-disabled {
  opacity: 0.4;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.step-disabled .card {
  background-color: #f8f9fa !important;
}

.step-disabled .card-header {
  background-color: #6c757d !important;
}

.step-active {
  opacity: 1;
  transition: opacity 0.3s ease;
  animation: stepActivate 0.5s ease-in-out;
}

@keyframes stepActivate {
  0% {
    transform: scale(0.98);
    opacity: 0.7;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* Styles pour les cartes de simulation */
.simulation-cards-container {
  max-height: 80vh;
  overflow-y: auto;
  padding-right: 10px;
}

.simulation-cards-container::-webkit-scrollbar {
  width: 6px;
}

.simulation-cards-container::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10px;
}

.simulation-cards-container::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 10px;
}

.simulation-cards-container::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}

/* Responsive design */
@media (max-width: 768px) {
  .col-lg-6 {
    margin-bottom: 1rem;
  }

  .simulation-cards-container {
    max-height: 60vh;
  }
}
</style>
