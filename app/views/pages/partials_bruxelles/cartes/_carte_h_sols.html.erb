<%# CARTE 8: SOLS & PLANCHERS (PRIME H) %>
<div class="col-lg-4 col-md-6">
  <div class="card border-0 shadow-sm h-100"
       data-controller="bruxelles-prime-card"
       data-bruxelles-prime-card-slug-value="bruxelles_prime_h_global"
       data-statut-compatible='["residentiel", "mixte"]'>
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-dark bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-square fs-5 text-dark"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Sols & planchers</h6>
          <small class="text-muted">Isolation thermique, acoustique</small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Isolation thermique sols -->
        <div class="col-md-12">
          <label class="form-label small">Isolation thermique sols :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputIsolationThermiqueSols"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-dark text-white"
                  data-bruxelles-prime-card-target="resultIsolationThermiqueSols">0 €</span>
          </div>
        </div>

        <!-- Isolation acoustique sols -->
        <div class="col-md-12">
          <label class="form-label small">Isolation acoustique sols :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputIsolationAcoustiqueSols"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-dark text-white"
                  data-bruxelles-prime-card-target="resultIsolationAcoustiqueSols">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Sols -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-secondary">Total Sols :</strong>
          <span class="badge bg-secondary fs-6" data-bruxelles-prime-card-target="total">
            0 €
          </span>
        </div>

        <!-- Section conseil avec CTA connexion -->
        <div class="mt-2">
          <small class="text-primary">
            <i class="bi bi-lightbulb me-1"></i>
            Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
