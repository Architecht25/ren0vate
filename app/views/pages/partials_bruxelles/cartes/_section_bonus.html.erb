<%# SECTION BONUS Z1-Z10 %>
<div class="card border-0 shadow-sm mb-4 mt-4">
  <div class="card-header bg-warning bg-opacity-10">
    <h4 class="card-title mb-0">
      <i class="bi bi-star text-warning me-2"></i>
      Bonus supplémentaires Z1-Z10
    </h4>
    <p class="text-muted small mb-0 mt-1">
      💫 Bonus pour matériaux durables, réemploi et travaux combinés
    </p>
  </div>
  <div class="card-body">
    <div class="row g-3">

      <!-- CARTE Z1: ISOLATION DURABLE -->
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100"
             data-controller="bruxelles-prime-card"
             data-bruxelles-prime-card-slug-value="bruxelles_bonus_z1"
             data-statut-compatible='["residentiel"]'>
          <div class="card-body">
            <div class="d-flex align-items-center gap-3 mb-3">
              <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-shield-check fs-6 text-warning"></i>
              </div>
              <div>
                <h6 class="card-title mb-1">Z1 - Isolation durable</h6>
                <small class="text-muted">10€/m² - Matériaux biosourcés</small>
              </div>
            </div>
            <div class="input-group input-group-sm">
              <input type="number" class="form-control" placeholder="Surface en m²"
                     data-bruxelles-prime-card-target="inputSurface"
                     data-action="input->bruxelles-prime-card#calculate">
              <span class="input-group-text bg-warning text-white"
                    data-bruxelles-prime-card-target="total">0 €</span>
            </div>
          </div>
        </div>
      </div>

