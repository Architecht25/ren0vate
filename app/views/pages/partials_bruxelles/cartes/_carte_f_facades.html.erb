<%# CARTE 6: FAÇADES (PRIME F) %>
<div class="col-lg-6 col-md-6">
  <div class="card border-1 border-info border-opacity-50 shadow-sm h-100"
       data-controller="bruxelles-prime-card"
       data-bruxelles-prime-card-slug-value="bruxelles_prime_f_global"
       data-statut-compatible='["residentiel", "mixte"]'>
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-house fs-5 text-secondary"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Façades</h6>
          <small class="text-muted">Isolation, bardage, embellissement</small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Isolation intérieure façade -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Isol. intérieure :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputIsolationInterieure"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-prime-card-target="resultIsolationInterieure">0 €</span>
          </div>
        </div>

        <!-- Isolation extérieure façade -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Isol. extérieure :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputIsolationExterieure"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-prime-card-target="resultIsolationExterieure">0 €</span>
          </div>
        </div>

        <!-- Isolation coulisse -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Isol. coulisse :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputIsolationCoulisse"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-prime-card-target="resultIsolationCoulisse">0 €</span>
          </div>
        </div>

        <!-- Bardage façade -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Bardage façade :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m² (max 100)"
                   data-bruxelles-prime-card-target="inputBardageFacade"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-prime-card-target="resultBardageFacade">0 €</span>
          </div>
        </div>

        <!-- Enduit façade -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Enduit façade :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m² (max 100)"
                   data-bruxelles-prime-card-target="inputEnduitFacade"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-prime-card-target="resultEnduitFacade">0 €</span>
          </div>
        </div>

        <!-- Embellissement façade avant -->
        <div class="col-lg-4 col-md-6">
          <label class="form-label small">Embellissement avant :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputEmbellissementAvant"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-prime-card-target="resultEmbellissementAvant">0 €</span>
          </div>
        </div>

        <!-- Façades arrière/latérales -->
        <div class="col-lg-6 col-md-6">
          <label class="form-label small">Façades arrière/latérales :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputFacadesArriere"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-prime-card-target="resultFacadesArriere">0 €</span>
          </div>
        </div>

        <!-- Isolation acoustique murs -->
        <div class="col-lg-6 col-md-6">
          <label class="form-label small">Isolation acoustique murs :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputIsolationAcoustique"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-secondary text-white"
                  data-bruxelles-prime-card-target="resultIsolationAcoustique">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Façades -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-secondary">Total Façades :</strong>
          <span class="badge bg-secondary fs-6" data-bruxelles-prime-card-target="total">
            0 €
          </span>
        </div>

        <!-- Section conseil avec CTA connexion -->
        <div class="mt-2">
          <small class="text-primary">
            <i class="bi bi-lightbulb me-1"></i>
            Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
