<%# CARTE 13: VENTILATION (PRIME M) %>
<div class="col-lg-4 col-md-6">
  <div class="card border-1 border-success border-opacity-50 shadow-sm h-100"
       data-controller="bruxelles-prime-card"
       data-bruxelles-prime-card-slug-value="bruxelles_prime_m_global"
       data-statut-compatible='["residentiel", "mixte"]'>
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-wind fs-5 text-success"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Ventilation</h6>
          <small class="text-muted">VMC, système C et D</small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Ventilation système C -->
        <div class="col-md-12">
          <label class="form-label small">Ventilation système C :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-bruxelles-prime-card-target="inputVentilationC"
                    data-action="change->bruxelles-prime-card#calculate">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-success text-white"
                  data-bruxelles-prime-card-target="resultVentilationC">0 €</span>
          </div>
        </div>

        <!-- Ventilation système D -->
        <div class="col-md-12">
          <label class="form-label small">Ventilation système D :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-bruxelles-prime-card-target="inputVentilationD"
                    data-action="change->bruxelles-prime-card#calculate">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-success text-white"
                  data-bruxelles-prime-card-target="resultVentilationD">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Ventilation -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-success">Total Ventilation :</strong>
          <span class="badge bg-success fs-6" data-bruxelles-prime-card-target="total">
            0 €
          </span>
        </div>

        <!-- Section conseil avec CTA connexion -->
        <div class="mt-2">
          <small class="text-primary">
            <i class="bi bi-lightbulb me-1"></i>
            Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
