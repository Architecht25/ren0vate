<%# CARTE 7: PORTES & FENÊTRES (PRIME G) %>
<div class="col-lg-4 col-md-6">
  <div class="card border-0 shadow-sm h-100"
       data-controller="bruxelles-prime-card"
       data-bruxelles-prime-card-slug-value="bruxelles_prime_g_global"
       data-statut-compatible='["residentiel", "mixte"]'>
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-window fs-5 text-primary"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Portes & fenêtres</h6>
          <small class="text-muted">Remplacement, réparation</small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Remplacement fenêtres bois -->
        <div class="col-md-6">
          <label class="form-label small">Fenêtres bois :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputFenetresBois"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-prime-card-target="resultFenetresBois">0 €</span>
          </div>
        </div>

        <!-- Remplacement fenêtres PVC/alu -->
        <div class="col-md-6">
          <label class="form-label small">Fenêtres PVC/alu :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputFenetresPvcAlu"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-prime-card-target="resultFenetresPvcAlu">0 €</span>
          </div>
        </div>

        <!-- Réparation fenêtres -->
        <div class="col-md-6">
          <label class="form-label small">Réparation fenêtres :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputReparationFenetres"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-prime-card-target="resultReparationFenetres">0 €</span>
          </div>
        </div>

        <!-- Réparation portes -->
        <div class="col-md-6">
          <label class="form-label small">Réparation portes :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputReparationPortes"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-primary text-white"
                  data-bruxelles-prime-card-target="resultReparationPortes">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Portes & Fenêtres -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-dark">Total Portes & Fenêtres :</strong>
          <span class="badge bg-dark fs-6" data-bruxelles-prime-card-target="total">
            0 €
          </span>
        </div>

        <!-- Section conseil avec CTA connexion -->
        <div class="mt-2">
          <small class="text-primary">
            <i class="bi bi-lightbulb me-1"></i>
            Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
