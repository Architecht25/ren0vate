<%# CARTE 3: GROS-ŒUVRE & GESTION DE L'EAU (PRIME C) %>
<div class="col-lg-6 col-md-6">
  <div class="card border-0 shadow-sm h-100"
       data-controller="bruxelles-prime-card"
       data-bruxelles-prime-card-slug-value="bruxelles_prime_c_global"
       data-statut-compatible='["residentiel"]'>
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-columns fs-5 text-info"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Gros-œuvre & eau</h6>
          <small class="text-muted">Structure, égouts, récupération</small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Structures portantes -->
        <div class="col-md-6">
          <label class="form-label small">Structure portante :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Montant €"
                   data-bruxelles-prime-card-target="inputStructurePortante"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-info text-white"
                  data-bruxelles-prime-card-target="resultStructurePortante">0 €</span>
          </div>
        </div>

        <!-- Gestion égouts -->
        <div class="col-md-12">
          <label class="form-label small">Gestion égouts :</label>
          <div class="row g-2">
            <div class="col-6">
              <input type="number" class="form-control form-control-sm" placeholder="Mètres tuyauterie"
                     data-bruxelles-prime-card-target="inputGestionEgouts"
                     data-action="input->bruxelles-prime-card#calculate">
            </div>
            <div class="col-6">
              <input type="number" class="form-control form-control-sm" placeholder="Chambres visite"
                     data-bruxelles-prime-card-target="inputGestionEgouts"
                     data-action="input->bruxelles-prime-card#calculate">
            </div>
          </div>
          <div class="row g-2 mt-1">
            <div class="col-6">
              <input type="number" class="form-control form-control-sm" placeholder="Avaloirs"
                     data-bruxelles-prime-card-target="inputGestionEgouts"
                     data-action="input->bruxelles-prime-card#calculate">
            </div>
            <div class="col-6">
              <input type="number" class="form-control form-control-sm" placeholder="Raccordements"
                     data-bruxelles-prime-card-target="inputGestionEgouts"
                     data-action="input->bruxelles-prime-card#calculate">
            </div>
          </div>
          <div class="mt-2">
            <span class="input-group-text bg-info text-white d-inline-block"
                  data-bruxelles-prime-card-target="resultGestionEgouts">0 €</span>
          </div>
        </div>

        <!-- Récupération eau de pluie -->
        <div class="col-md-6">
          <label class="form-label small">Récup. eau pluie :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-bruxelles-prime-card-target="inputRecuperationEauPluie"
                    data-action="change->bruxelles-prime-card#calculate">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-info text-white"
                  data-bruxelles-prime-card-target="resultRecuperationEauPluie">0 €</span>
          </div>
        </div>

        <!-- Démolition perméabilisation -->
        <div class="col-md-6">
          <label class="form-label small">Démol. perméabil. :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="m²"
                   data-bruxelles-prime-card-target="inputDemolitionPermeabilisation"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-info text-white"
                  data-bruxelles-prime-card-target="resultDemolitionPermeabilisation">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Gros-œuvre -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-info">Total Gros-œuvre :</strong>
          <span class="badge bg-info fs-6" data-bruxelles-prime-card-target="total">
            0 €
          </span>
        </div>
      </div>
    </div>
  </div>
</div>
