<%# CARTE 9: AMÉNAGEMENT INTÉRIEUR (PRIME I) %>
<div class="col-lg-4 col-md-6">
  <div class="card border-1 border-warning border-opacity-50 shadow-sm h-100"
       data-controller="bruxelles-prime-card"
       data-bruxelles-prime-card-slug-value="bruxelles_prime_i_global"
       data-statut-compatible='["residentiel"]'>
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-bicycle fs-5 text-warning"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Aménagement intérieur</h6>
          <small class="text-muted">Vélos, protection incendie</small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Escaliers -->
        <div class="col-md-6">
          <label class="form-label small">Escaliers :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Nb marches"
                   data-bruxelles-prime-card-target="inputEscaliers"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-warning text-white"
                  data-bruxelles-prime-card-target="resultEscaliers">0 €</span>
          </div>
        </div>

        <!-- Emplacement vélo -->
        <div class="col-md-6">
          <label class="form-label small">Emplacement vélo :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Nb empl. (max 2)"
                   data-bruxelles-prime-card-target="inputEmplacementVelo"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-warning text-white"
                  data-bruxelles-prime-card-target="resultEmplacementVelo">0 €</span>
          </div>
        </div>

        <!-- Protection incendie -->
        <div class="col-md-6">
          <label class="form-label small">Protection incendie :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Montant €"
                   data-bruxelles-prime-card-target="inputProtectionIncendie"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-warning text-white"
                  data-bruxelles-prime-card-target="resultProtectionIncendie">0 €</span>
          </div>
        </div>

        <!-- Aménagement PMR -->
        <div class="col-md-6">
          <label class="form-label small">Aménagement PMR :</label>
          <div class="input-group input-group-sm">
            <select class="form-control"
                    data-bruxelles-prime-card-target="inputAmenagementPmr"
                    data-action="change->bruxelles-prime-card#calculate">
              <option value="0">Non</option>
              <option value="1">Oui</option>
            </select>
            <span class="input-group-text bg-warning text-white"
                  data-bruxelles-prime-card-target="resultAmenagementPmr">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Aménagement -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-warning">Total Aménagement :</strong>
          <span class="badge bg-warning fs-6" data-bruxelles-prime-card-target="total">
            0 €
          </span>
        </div>

        <!-- Section conseil avec CTA connexion -->
        <div class="mt-2">
          <small class="text-primary">
            <i class="bi bi-lightbulb me-1"></i>
            Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
