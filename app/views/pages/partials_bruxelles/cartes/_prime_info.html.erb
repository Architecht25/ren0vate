<%# Partial pour afficher les conditions et conseils d'une prime %>
<%# Paramètres attendus: prime_slug %>

<% condition_text = condition_prime(prime_slug) %>
<% conseil_text = conseil_prime(prime_slug) %>

<% if condition_text.present? || conseil_text.present? %>
  <div class="mt-1">
    <% if condition_text.present? %>
      <div class="mb-1">
        <small class="text-muted">
          <i class="bi bi-info-circle me-1"></i>
          <%= condition_text %>
        </small>
      </div>
    <% end %>
    <% if conseil_text.present? %>
      <div>
        <small class="text-success">
          <i class="bi bi-lightbulb me-1"></i>
          <%= conseil_text %>
        </small>
      </div>
    <% end %>
  </div>
<% end %>
