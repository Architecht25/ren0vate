<%# CARTE 11: SANITAIRES & ÉLECTRICITÉ (PRIMES K+L) %>
<div class="col-lg-4 col-md-6">
  <div class="card border-1 border-info border-opacity-50 shadow-sm h-100"
       data-controller="bruxelles-prime-card"
       data-bruxelles-prime-card-slug-value="bruxelles_prime_kl_global"
       data-statut-compatible='["residentiel"]'>
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
          <i class="bi bi-lightning fs-5 text-info"></i>
        </div>
        <div>
          <h6 class="card-title mb-1">Sanitaires & électricité</h6>
          <small class="text-muted">Équipements, mise aux normes</small>
        </div>
      </div>

      <div class="row g-2">
        <!-- Appareil sanitaire -->
        <div class="col-md-12">
          <label class="form-label small">Appareil sanitaire :</label>
          <div class="input-group input-group-sm">
            <input type="number" class="form-control" placeholder="Nombre"
                   data-bruxelles-prime-card-target="inputAppareilSanitaire"
                   data-action="input->bruxelles-prime-card#calculate">
            <span class="input-group-text bg-info text-white"
                  data-bruxelles-prime-card-target="resultAppareilSanitaire">0 €</span>
          </div>
        </div>

        <!-- Mise aux normes électriques -->
        <div class="col-md-12">
          <label class="form-label small">Mise aux normes électriques :</label>
          <div class="input-group input-group-sm">
            <input type="number"
                   class="form-control"
                   data-bruxelles-prime-card-target="inputMiseNormesElecGaz"
                   data-action="input->bruxelles-prime-card#calculate"
                   placeholder="Montant travaux électricité"
                   min="0"
                   step="0.01">
            <span class="input-group-text">€</span>
            <span class="input-group-text bg-info text-white"
                  data-bruxelles-prime-card-target="resultMiseNormesElecGaz">0 €</span>
          </div>
        </div>
      </div>

      <!-- Total Sanitaires -->
      <div class="mt-3 pt-2 border-top">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="text-info">Total Sanitaires :</strong>
          <span class="badge bg-info fs-6" data-bruxelles-prime-card-target="total">
            0 €
          </span>
        </div>

        <!-- Section conseil avec CTA connexion -->
        <div class="mt-2">
          <small class="text-primary">
            <i class="bi bi-lightbulb me-1"></i>
            Explications détaillées, démarches et conseils d'expert disponibles dans l'application. <%= link_to 'Se connecter', new_user_session_path, class: 'text-decoration-none fw-bold' %> ou <%= link_to 'créer un compte', new_user_registration_path, class: 'text-decoration-none fw-bold' %>.
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
