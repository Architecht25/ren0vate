<!-- Sélection du profil - Version button_to -->
<div class="mb-4">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light">
      <h4 class="card-title mb-0">
        <i class="bi bi-person-circle text-primary me-2"></i>
        Quel est votre profil ?
      </h4>
    </div>
    <div class="card-body">
      <div class="row g-2">
        <!-- Profils particuliers -->
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "prive" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-house me-2"></i>Particulier
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "coproprietaire" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-share me-2"></i>Copropriétaire
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "emphytheote" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-file-earmark-text me-2"></i>Emphythéote
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "locataire" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-person-check me-2"></i>Locataire
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "particulier_bailleur" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-house-door me-2"></i>Particulier bailleur
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "particulier_indivision" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-diagram-3 me-2"></i>Particulier indivision
          <% end %>
        </div>

        <!-- Profils professionnels -->
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "entreprise" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-building me-2"></i>Entreprise
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "syndic" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-people me-2"></i>Syndic de copropriété
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "bailleur" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-key me-2"></i>Bailleur social (AIS)
          <% end %>
        </div>
        <div class="col-md-6">
          <%= button_to select_profile_bruxelles_path, method: :post,
              params: { profile_type: "asbl" },
              class: "btn btn-outline-primary w-100",
              data: { turbo_frame: "eligibility_content", disable_with: "Sélection..." } do %>
            <i class="bi bi-shield-check me-2"></i>ASBL
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
