<div class="col-lg-4 col-md-4 col-12">
  <div class="card shadow-sm border-0 p-3 text-center mb-3 h-100"
       data-controller="primes-communales-bruxelles"
       data-primes-communales-bruxelles-api-base-url-value="/api/primes_communales_bruxelles"
       data-primes-communales-bruxelles-debounce-delay-value="800">

    <div class="card-body d-flex flex-column align-items-center gap-3">
      <!-- Icône et titre -->
      <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
        <i class="bi bi-building fs-5 text-warning"></i>
      </div>
      <h6 class="card-title mb-2">Primes Communales</h6>

      <!-- Formulaire de vérification -->
      <div class="w-100" style="max-width: 300px;">

        <!-- Code postal -->
        <div class="mb-3">
          <label for="code_postal_communales_bruxelles" class="form-label text-start w-100 small">Code postal</label>
          <input type="text"
                 class="form-control form-control-sm"
                 id="code_postal_communales_bruxelles"
                 data-primes-communales-bruxelles-target="codePostal"
                 data-action="input->primes-communales-bruxelles#checkPrimes"
                 placeholder="ex: 1000, 1050, 1180..."
                 pattern="[0-9]{4}"
                 maxlength="4">
          <small class="text-muted">Saisissez votre code postal bruxellois pour découvrir les primes disponibles</small>
        </div>

        <!-- Loading indicator -->
        <div class="mb-3"
             data-primes-communales-bruxelles-target="loading"
             style="display: none;">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
            <small class="text-muted">Recherche en cours...</small>
          </div>
        </div>

        <!-- Statut de vérification -->
        <div class="mb-3"
             data-primes-communales-bruxelles-target="status"
             style="display: none;">
          <div class="d-flex align-items-center justify-content-center gap-2">
            <i data-primes-communales-bruxelles-target="statusIcon" class="bi"></i>
            <small data-primes-communales-bruxelles-target="statusText" class="fw-bold"></small>
          </div>
        </div>

        <!-- Sélection des primes (si disponibles) -->
        <div class="mb-3"
             data-primes-communales-bruxelles-target="primesSelection"
             style="display: none;">
          <label for="prime_communale_select_bruxelles" class="form-label text-start w-100 small">Sélectionnez une prime</label>
          <select class="form-select form-select-sm"
                  id="prime_communale_select_bruxelles"
                  data-primes-communales-bruxelles-target="primeSelect"
                  data-action="change->primes-communales-bruxelles#selectPrime">
            <option value="">Choisir une prime...</option>
          </select>
        </div>

        <!-- Champ montant travaux (si prime sélectionnée) -->
        <div class="mb-3"
             data-primes-communales-bruxelles-target="montantSection"
             style="display: none;">
          <label for="montant_travaux_communales_bruxelles" class="form-label text-start w-100 small">Montant des travaux (€)</label>
          <input type="number"
                 class="form-control form-control-sm"
                 id="montant_travaux_communales_bruxelles"
                 data-primes-communales-bruxelles-target="montantInput"
                 data-action="input->primes-communales-bruxelles#calculatePrime"
                 placeholder="0"
                 min="0"
                 step="0.01">
        </div>

        <!-- Résultat -->
        <div class="alert alert-warning alert-sm mb-2"
             data-primes-communales-bruxelles-target="resultSection"
             style="display: none;"
             role="alert">
          <small class="fw-bold">Prime estimée : </small>
          <span class="fw-bold prime-result"
                data-primes-communales-bruxelles-target="result">0.00 €</span>
          <div class="mt-1">
            <small data-primes-communales-bruxelles-target="details"
                   class="text-muted"></small>
          </div>
        </div>

        <small class="text-muted d-block">
          Les primes communales varient selon votre commune bruxelloise et le type de travaux
        </small>
      </div>
    </div>
  </div>
</div>
