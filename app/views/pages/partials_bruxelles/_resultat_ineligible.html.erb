<!-- Résultat d'inéligibilité pour Bruxelles -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-danger">
    <h4 class="card-title mb-0 text-white">
      <i class="bi bi-x-circle me-2"></i>
      Test d'éligibilité - Non éligible
    </h4>
  </div>
  <div class="card-body">
    <div class="alert alert-danger border-0 mb-4">
      <i class="bi bi-exclamation-triangle fs-1 mb-3 d-block text-center"></i>
      <h5 class="mb-3 text-center">Malheureusement, vous n'êtes pas éligible</h5>
      <p class="mb-3">
        <strong>
          <%= message.present? ? message : "Une ou plusieurs conditions d'éligibilité ne sont pas remplies." %>
        </strong>
      </p>

      <% if defined?(reasons) && reasons.present? %>
        <div class="mt-3">
          <h6 class="fw-bold">Raisons de l'inéligibilité :</h6>
          <ul class="mb-0">
            <% reasons.each do |reason| %>
              <li><%= reason %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>

    <div class="mb-4">
      <p class="text-muted">
        Pour être éligible aux primes RENOLUTION Bruxelles, toutes les conditions doivent être remplies.
        Nous vous encourageons à vérifier votre situation ou à consulter un expert.
      </p>

      <div class="alert alert-info mt-3">
        <h6 class="alert-heading">
          <i class="bi bi-lightbulb me-1"></i>
          Alternatives possibles
        </h6>
        <ul class="mb-0 text-start">
          <li>Primes fédérales pour l'efficacité énergétique</li>
          <li>Primes communales (variable selon la commune)</li>
          <li>Réduction d'impôt pour économies d'énergie</li>
          <li>Subventions européennes ou autres dispositifs</li>
        </ul>
      </div>
    </div>

    <!-- Boutons d'action -->
    <div class="d-flex gap-2 justify-content-center flex-wrap">
      <button type="button" class="btn btn-outline-primary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise me-2"></i>
        Recommencer le test
      </button>

      <a href="/bruxelles" class="btn btn-primary">
        <i class="bi bi-house me-2"></i>
        Retour à l'accueil
      </a>

      <a href="https://renolution.brussels" target="_blank" class="btn btn-outline-success">
        <i class="bi bi-box-arrow-up-right me-1"></i>
        Site officiel RENOLUTION
      </a>
    </div>
  </div>
</div>
