<!-- Section Primes Bruxelles RENOLUTION - 13 cartes principales par catégorie -->
<div class="primes-section-bruxelles" data-controller="bruxelles-prime-calcul">

  <!-- Injection des données de primes depuis la base de données -->
  <script id="bruxelles-primes-data" type="application/json">
    <%= raw Prime.where(region: "bruxelles").map { |prime|
      [prime.slug, {
        nom: prime.titre,
        valeurs_par_categorie: {
          "bruxelles_cat1" => prime.valeurs_par_categorie&.dig("bruxelles_cat1") || {},
          "bruxelles_cat2" => prime.valeurs_par_categorie&.dig("bruxelles_cat2") || {},
          "bruxelles_cat3" => prime.valeurs_par_categorie&.dig("bruxelles_cat3") || {}
        }
      }]
    }.to_h.to_json %>
  </script>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-success bg-opacity-10">
      <h4 class="card-title mb-0">
        <i class="bi bi-calculator text-success me-2"></i>
        <span data-bruxelles-prime-calcul-target="sectionTitle">
          Vos primes RENOLUTION Bruxelles - Catégorie I à III
        </span>
      </h4>
      <p class="text-muted small mb-0 mt-1">
        💡 Les montants s'ajustent automatiquement selon votre catégorie de revenus
      </p>
    </div>
    <div class="card-body">

      <div class="row g-3">

        <!-- CARTE 1: SERVICES ET ÉTUDES PRÉALABLES (PRIME A) - Seule sur sa ligne -->
        <div class="col-12">
          <div class="card border-0 shadow-sm h-100"
               data-controller="bruxelles-prime-card"
               data-bruxelles-prime-card-slug-value="bruxelles_prime_a_global">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-clipboard-data fs-5 text-primary"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Services et études</h6>
                  <small class="text-muted">Audits, études, suivi</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Audit énergétique maison -->
                <div class="col-md-2">
                  <label class="form-label small">Audit maison :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-prime-card-target="inputAuditMaison"
                            data-action="change->bruxelles-prime-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultAuditMaison">0 €</span>
                  </div>
                </div>

                <!-- Audit énergétique bâtiment -->
                <div class="col-md-2">
                  <label class="form-label small">Audit bâtiment :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-prime-card-target="inputAuditBatiment"
                            data-action="change->bruxelles-prime-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultAuditBatiment">0 €</span>
                  </div>
                </div>

                <!-- Certificat PEB -->
                <div class="col-md-2">
                  <label class="form-label small">Certificat PEB :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-prime-card-target="inputCertificatPeb"
                            data-action="change->bruxelles-prime-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultCertificatPeb">0 €</span>
                  </div>
                </div>

                <!-- Étude acoustique -->
                <div class="col-md-2">
                  <label class="form-label small">Étude acoustique :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Montant travaux isolation acoustique"
                           data-bruxelles-prime-card-target="inputEtudeAcoustique"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultEtudeAcoustique">0 €</span>
                  </div>
                </div>

                <!-- Étude TOTEM -->
                <div class="col-md-2">
                  <label class="form-label small">Étude TOTEM :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-prime-card-target="inputEtudeTotem"
                            data-action="change->bruxelles-prime-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultEtudeTotem">0 €</span>
                  </div>
                </div>

                <!-- Suivi architecte -->
                <div class="col-md-2">
                  <label class="form-label small">Suivi architecte :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Honoraires €"
                           data-bruxelles-prime-card-target="inputSuiviArchitecte"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultSuiviArchitecte">0 €</span>
                  </div>
                </div>

                <!-- Suivi ingénieur stabilité -->
                <div class="col-md-2">
                  <label class="form-label small">Suivi ingénieur :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Honoraires €"
                           data-bruxelles-prime-card-target="inputSuiviIngenieur"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultSuiviIngenieur">0 €</span>
                  </div>
                </div>

                <!-- Suivi expert façade -->
                <div class="col-md-2">
                  <label class="form-label small">Suivi expert façade :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Honoraires €"
                           data-bruxelles-prime-card-target="inputSuiviExpertFacade"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-primary text-white"
                          data-bruxelles-prime-card-target="resultSuiviExpertFacade">0 €</span>
                  </div>
                </div>
              </div>

              <!-- Total Services et études -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-primary">Total Services :</strong>
                  <span class="badge bg-primary fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Deuxième ligne : Installations, Gros-œuvre, Salubrité -->
      <div class="row g-3 mt-1">

        <!-- CARTE 2: INSTALLATIONS DE CHANTIER (PRIME B) -->
        <div class="col-lg-3 col-md-6">
          <div class="card border-0 shadow-sm h-100"
               data-controller="bruxelles-prime-card"
               data-bruxelles-prime-card-slug-value="bruxelles_prime_b_global">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-ladder fs-5 text-warning"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Installations de chantier</h6>
                  <small class="text-muted">Échafaudages, protection</small>
                </div>
              </div>

              <!-- Protection/échafaudages -->
              <div class="mb-3">
                <label class="form-label small">Protection/échafaudages (m²) :</label>
                <div class="input-group input-group-sm">
                  <input type="number" class="form-control" placeholder="Surface m²"
                         data-bruxelles-prime-card-target="inputProtectionEchafaudages"
                         data-action="input->bruxelles-prime-card#calculate">
                  <span class="input-group-text bg-warning text-white"
                        data-bruxelles-prime-card-target="resultProtectionEchafaudages">0 €</span>
                </div>
              </div>

              <!-- Total Installations -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-warning">Total Installations :</strong>
                  <span class="badge bg-warning fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CARTE 3: GROS-ŒUVRE & GESTION DE L'EAU (PRIME C) - Plus d'espace -->
        <div class="col-lg-6 col-md-6">
          <div class="card border-0 shadow-sm h-100"
               data-controller="bruxelles-prime-card"
               data-bruxelles-prime-card-slug-value="bruxelles_prime_c_global">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-columns fs-5 text-info"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Gros-œuvre & eau</h6>
                  <small class="text-muted">Structure, égouts, récupération</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Structures portantes -->
                <div class="col-md-6">
                  <label class="form-label small">Structure portante :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Montant €"
                           data-bruxelles-prime-card-target="inputStructurePortante"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-info text-white"
                          data-bruxelles-prime-card-target="resultStructurePortante">0 €</span>
                  </div>
                </div>

                <!-- Gestion égouts -->
                <div class="col-md-12">
                  <label class="form-label small">Gestion égouts :</label>
                  <div class="row g-2">
                    <div class="col-6">
                      <input type="number" class="form-control form-control-sm" placeholder="Mètres tuyauterie"
                             data-bruxelles-prime-card-target="inputGestionEgouts"
                             data-action="input->bruxelles-prime-card#calculate">
                    </div>
                    <div class="col-6">
                      <input type="number" class="form-control form-control-sm" placeholder="Chambres visite"
                             data-bruxelles-prime-card-target="inputGestionEgouts"
                             data-action="input->bruxelles-prime-card#calculate">
                    </div>
                  </div>
                  <div class="row g-2 mt-1">
                    <div class="col-6">
                      <input type="number" class="form-control form-control-sm" placeholder="Avaloirs"
                             data-bruxelles-prime-card-target="inputGestionEgouts"
                             data-action="input->bruxelles-prime-card#calculate">
                    </div>
                    <div class="col-6">
                      <input type="number" class="form-control form-control-sm" placeholder="Raccordements"
                             data-bruxelles-prime-card-target="inputGestionEgouts"
                             data-action="input->bruxelles-prime-card#calculate">
                    </div>
                  </div>
                  <div class="mt-2">
                    <span class="input-group-text bg-info text-white d-inline-block"
                          data-bruxelles-prime-card-target="resultGestionEgouts">0 €</span>
                  </div>
                </div>

                <!-- Récupération eau de pluie -->
                <div class="col-md-6">
                  <label class="form-label small">Récup. eau pluie :</label>
                  <div class="input-group input-group-sm">
                    <select class="form-control"
                            data-bruxelles-prime-card-target="inputRecuperationEauPluie"
                            data-action="change->bruxelles-prime-card#calculate">
                      <option value="0">Non</option>
                      <option value="1">Oui</option>
                    </select>
                    <span class="input-group-text bg-info text-white"
                          data-bruxelles-prime-card-target="resultRecuperationEauPluie">0 €</span>
                  </div>
                </div>

                <!-- Démolition perméabilisation -->
                <div class="col-md-6">
                  <label class="form-label small">Démol. perméabil. :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputDemolitionPermeabilisation"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-info text-white"
                          data-bruxelles-prime-card-target="resultDemolitionPermeabilisation">0 €</span>
                  </div>
                </div>
              </div>

              <!-- Total Gros-œuvre -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-info">Total Gros-œuvre :</strong>
                  <span class="badge bg-info fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CARTE 4: SALUBRITÉ (PRIME D) -->
        <div class="col-lg-3 col-md-6">
          <div class="card border-0 shadow-sm h-100"
               data-controller="bruxelles-prime-card"
               data-bruxelles-prime-card-slug-value="bruxelles_prime_d_global">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-shield-check fs-5 text-danger"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Salubrité</h6>
                  <small class="text-muted">Humidité, traitement</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Traitement humidité sol -->
                <div class="col-md-12">
                  <label class="form-label small">Traitement humidité sol :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Montant €"
                           data-bruxelles-prime-card-target="inputTraitementHumiditeSol"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-danger text-white"
                          data-bruxelles-prime-card-target="resultTraitementHumiditeSol">0 €</span>
                  </div>
                </div>

                <!-- Traitement fongique/insectes -->
                <div class="col-md-12">
                  <label class="form-label small">Traitement champignons/insectes :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Montant €"
                           data-bruxelles-prime-card-target="inputTraitementFongiqueInsectes"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-danger text-white"
                          data-bruxelles-prime-card-target="resultTraitementFongiqueInsectes">0 €</span>
                  </div>
                </div>
              </div>

              <!-- Total Salubrité -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-danger">Total Salubrité :</strong>
                  <span class="badge bg-danger fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Troisième ligne : Toiture, Façades -->
      <div class="row g-3 mt-1">

        <!-- CARTE 5: TOITURE (PRIME E) -->
        <div class="col-lg-6 col-md-6">
          <div class="card border-0 shadow-sm h-100"
               data-controller="bruxelles-prime-card"
               data-bruxelles-prime-card-slug-value="bruxelles_prime_e_global">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-house-up fs-5 text-success"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Toiture</h6>
                  <small class="text-muted">Isolation, structure, végétale</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Structure toiture -->
                <div class="col-md-6">
                  <label class="form-label small">Structure toiture :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Montant €"
                           data-bruxelles-prime-card-target="inputStructureToiture"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-prime-card-target="resultStructureToiture">0 €</span>
                  </div>
                </div>

                <!-- Isolation toiture/étanchéité -->
                <div class="col-md-6">
                  <label class="form-label small">Isolation/étanchéité :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationToitureEtancheite"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-prime-card-target="resultIsolationToitureEtancheite">0 €</span>
                  </div>
                </div>

                <!-- Isolation thermique toiture -->
                <div class="col-md-6">
                  <label class="form-label small">Isolation thermique :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationThermiqueToiture"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-prime-card-target="resultIsolationThermiqueToiture">0 €</span>
                  </div>
                </div>

                <!-- Accessoires toiture -->
                <div class="col-md-6">
                  <label class="form-label small">Accessoires :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="Montant €"
                           data-bruxelles-prime-card-target="inputAccessoiresToiture"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-prime-card-target="resultAccessoiresToiture">0 €</span>
                  </div>
                </div>

                <!-- Toiture végétale -->
                <div class="col-md-12">
                  <label class="form-label small">Toiture végétale :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputToitureVegetale"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-success text-white"
                          data-bruxelles-prime-card-target="resultToitureVegetale">0 €</span>
                  </div>
                </div>
              </div>

              <!-- Total Toiture -->
              <div class="mt-3 pt-2 border-top">
                <div class="d-flex justify-content-between align-items-center">
                  <strong class="text-success">Total Toiture :</strong>
                  <span class="badge bg-success fs-6" data-bruxelles-prime-card-target="total">
                    0 €
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CARTE 6: FAÇADES (PRIME F) -->
        <div class="col-lg-6 col-md-6">
          <div class="card border-0 shadow-sm h-100"
               data-controller="bruxelles-prime-card"
               data-bruxelles-prime-card-slug-value="bruxelles_prime_f_global">
            <div class="card-body">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                  <i class="bi bi-house fs-5 text-secondary"></i>
                </div>
                <div>
                  <h6 class="card-title mb-1">Façades</h6>
                  <small class="text-muted">Isolation, bardage, embellissement</small>
                </div>
              </div>

              <div class="row g-2">
                <!-- Isolation intérieure façade -->
                <div class="col-lg-4 col-md-6">
                  <label class="form-label small">Isol. intérieure :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationInterieure"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultIsolationInterieure">0 €</span>
                  </div>
                </div>

                <!-- Isolation extérieure façade -->
                <div class="col-lg-4 col-md-6">
                  <label class="form-label small">Isol. extérieure :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationExterieure"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultIsolationExterieure">0 €</span>
                  </div>
                </div>

                <!-- Isolation coulisse -->
                <div class="col-lg-4 col-md-6">
                  <label class="form-label small">Isol. coulisse :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m²"
                           data-bruxelles-prime-card-target="inputIsolationCoulisse"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultIsolationCoulisse">0 €</span>
                  </div>
                </div>

                <!-- Bardage façade -->
                <div class="col-lg-4 col-md-6">
                  <label class="form-label small">Bardage façade :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m² (max 100)"
                           data-bruxelles-prime-card-target="inputBardageFacade"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultBardageFacade">0 €</span>
                  </div>
                </div>

                <!-- Enduit façade -->
                <div class="col-lg-4 col-md-6">
                  <label class="form-label small">Enduit façade :</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" placeholder="m² (max 100)"
                           data-bruxelles-prime-card-target="inputEnduitFacade"
                           data-action="input->bruxelles-prime-card#calculate">
                    <span class="input-group-text bg-secondary text-white"
                          data-bruxelles-prime-card-target="resultEnduitFacade">0 €</span>
                  </div>
                </div>

                <!-- Embellissement façade avant -->
                <div class="col-lg-4 col-md-6">
