                  <small class="text-muted">Audits, études, suivi</small>
                </div>
              </div>

              <!-- Audit énergétique maison -->
              <div class="mb-2">
                <label class="form-label small">Audit énergétique maison :</label>
                <select class="form-select form-select-sm"
                        data-bruxelles-prime-card-target="auditMaison"
                        data-action="change->bruxelles-prime-card#calculate">
                  <option value="0">Non</option>
                  <option value="1">Oui</option>
                </select>
              </div>

              <!-- Audit énergétique bâtiment -->
              <div class="mb-2">
                <label class="form-label small">Audit énergétique bâtiment :</label>
                <select class="form-select form-select-sm"
                        data-bruxelles-prime-card-target="auditBatiment"
                        data-action="change->bruxelles-prime-card#calculate">
