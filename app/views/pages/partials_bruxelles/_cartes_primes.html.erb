<!-- Section Primes Bruxelles RENOLUTION - Refactorisée avec partiels modulaires -->
<div class="primes-section-bruxelles" data-controller="bruxelles-prime-calcul">

  <!-- Injection des données de primes depuis la base de données -->
  <script id="bruxelles-primes-data" type="application/json">
    <%= raw bruxelles_primes_data_json %>
  </script>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-success bg-opacity-10">
      <h4 class="card-title mb-0">
        <i class="bi bi-calculator text-success me-2"></i>
        <span data-bruxelles-prime-calcul-target="sectionTitle">
          Vos primes RENOLUTION Bruxelles - Catégorie I à III
        </span>
      </h4>
      <p class="text-muted small mb-0 mt-1">
        💡 Les montants s'ajustent automatiquement selon votre catégorie de revenus
      </p>
    </div>
    <div class="card-body">

      <div class="row g-3">
        <!-- CARTE A: SERVICES ET ÉTUDES PRÉALABLES - Seule sur sa ligne -->
        <%= render "pages/partials_bruxelles/cartes/carte_a_services" %>
      </div>

      <!-- Deuxième ligne : Installations, Gros-œuvre, Salubrité -->
      <div class="row g-3 mt-1">
        <%= render "pages/partials_bruxelles/cartes/carte_b_installations" %>
        <%= render "pages/partials_bruxelles/cartes/carte_c_gros_oeuvre" %>
        <%= render "pages/partials_bruxelles/cartes/carte_d_salubrite" %>
      </div>

      <!-- Troisième ligne : Toiture, Façades -->
      <div class="row g-3 mt-1">
        <%= render "pages/partials_bruxelles/cartes/carte_e_toiture" %>
        <%= render "pages/partials_bruxelles/cartes/carte_f_facades" %>
      </div>

      <!-- Quatrième ligne : Sols, Portes & Fenêtres, Aménagement -->
      <div class="row g-3 mt-1">
        <%= render "pages/partials_bruxelles/cartes/carte_h_sols" %>
        <%= render "pages/partials_bruxelles/cartes/carte_g_portes_fenetres" %>
        <%= render "pages/partials_bruxelles/cartes/carte_i_amenagement" %>
      </div>

      <!-- Cinquième ligne : Chauffage, Sanitaires, Ventilation -->
      <div class="row g-3 mt-1">
        <%= render "pages/partials_bruxelles/cartes/carte_j_chauffage" %>
        <%= render "pages/partials_bruxelles/cartes/carte_kl_sanitaires" %>
        <%= render "pages/partials_bruxelles/cartes/carte_m_ventilation" %>
      </div>

      <!-- Section Bonus Z1-Z10 -->
      <%= render "pages/partials_bruxelles/cartes/section_bonus" %>

      <!-- Total général des primes -->
      <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <span class="fw-bold">
          <i class="bi bi-calculator-fill me-2"></i>
          Total estimé de vos primes Bruxelles :
        </span>
        <span class="badge bg-primary fs-5" data-bruxelles-prime-calcul-target="totalGeneral">
          0 €
        </span>
      </div>
    </div>
  </div>
</div>
