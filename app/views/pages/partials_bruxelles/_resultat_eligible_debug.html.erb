<!-- Test simple pour debug -->
<div class="alert alert-success">
  <h5>✅ TEST DEBUG - Résultat reçu !</h5>
  <p><strong>Profile:</strong> <%= profile %></p>
  <p><strong>Message:</strong> <%= message %></p>
  <p><strong>Needs refinement:</strong> <%= needs_refinement %></p>
  <p><strong>Auto category:</strong> <%= auto_category %></p>

  <% if needs_refinement %>
