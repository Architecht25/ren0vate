<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - Particulier Indivision -->
<div id="eligibility-test-bruxelles-particulier-indivision" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-diagram-3 me-2"></i>
        Test d'éligibilité - Particulier Indivision
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez vos critères d'éligibilité aux primes RENOLUTION Bruxelles
      </p>
    </div>

    <div class="card-body">
      <form id="eligibilityFormBruxellesParticulierIndivision" name="eligibilityFormBruxellesParticulierIndivision"
            data-test-eligibilite-target="form">
        <input type="hidden" name="profile_type" value="particulier_indivision">

        <!-- Question 1: Localisation du bien -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-geo-alt text-primary me-2"></i>
            Le bien concerné par la demande est-il situé en Région de Bruxelles-Capitale ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="localisation" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="localisation_oui">
              <label class="form-check-label" for="localisation_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="localisation" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="localisation_non">
              <label class="form-check-label" for="localisation_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 2: Âge du bâtiment -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-calendar text-primary me-2"></i>
            Le bâtiment est-il âgé d'au moins 10 ans ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="age_batiment" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="age_batiment_oui">
              <label class="form-check-label" for="age_batiment_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="age_batiment" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="age_batiment_non">
              <label class="form-check-label" for="age_batiment_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 3: Professionnel agréé -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-person-badge text-primary me-2"></i>
            Les travaux sont-ils réalisés par un professionnel inscrit à la Banque Carrefour des Entreprises qui dispose de l'accès réglementé à la profession ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="professionnel_agree" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="professionnel_agree_oui">
              <label class="form-check-label" for="professionnel_agree_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="professionnel_agree" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="professionnel_agree_non">
              <label class="form-check-label" for="professionnel_agree_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 4: Nouvelle construction -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-building text-primary me-2"></i>
            S'agit-il d'une nouvelle construction ou d'un ajout considéré comme nouvelle construction ?
          </h6>
          <p class="text-muted small mb-3">
            Exemple : une maison construite sur un terrain vierge, l'ajout d'une unité de logement en toiture d'un immeuble...
          </p>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="nouvelle_construction" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="nouvelle_construction_oui">
              <label class="form-check-label" for="nouvelle_construction_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="nouvelle_construction" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="nouvelle_construction_non">
              <label class="form-check-label" for="nouvelle_construction_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 5: Compte bancaire belge -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-bank text-primary me-2"></i>
            Possédez-vous un compte bancaire belge pour le virement de la prime ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="compte_bancaire_belge" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="compte_bancaire_belge_oui">
              <label class="form-check-label" for="compte_bancaire_belge_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="compte_bancaire_belge" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="compte_bancaire_belge_non">
              <label class="form-check-label" for="compte_bancaire_belge_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 6: Travaux réalisés -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-tools text-primary me-2"></i>
            Les travaux ont-ils été réalisés, avec une facture de solde émise dans les 12 mois précédant la demande ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="travaux_realises" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="travaux_realises_oui">
              <label class="form-check-label" for="travaux_realises_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="travaux_realises" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="travaux_realises_non">
              <label class="form-check-label" for="travaux_realises_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 7: Primes antérieures -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-award text-primary me-2"></i>
            J'ai introduit et reçu des primes pour le bien concerné
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="primes_anterieures" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="primes_anterieures_oui">
              <label class="form-check-label" for="primes_anterieures_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="primes_anterieures" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="primes_anterieures_non">
              <label class="form-check-label" for="primes_anterieures_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
          <!-- Alert pour primes antérieures -->
          <div id="primes_anterieures_info" class="alert alert-warning mt-3" style="display: none;">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Important :</strong> Des travaux identiques dans un même bien ne bénéficient d'une prime qu'une fois par période de 10 ans.
          </div>
        </div>

        <!-- Zone de résultat -->
        <div id="resultBruxellesParticulierIndivision" class="mt-4" style="display: none;">
          <div class="alert alert-info">
            <h5 class="alert-heading">
              <i class="bi bi-info-circle me-2"></i>Résultat du test d'éligibilité
            </h5>
            <div id="resultContentBruxellesParticulierIndivision"></div>
          </div>
        </div>

        <!-- Bouton de validation -->
        <div class="d-grid gap-2 mt-4">
          <button type="button" class="btn btn-primary btn-lg"
                  data-action="click->test-eligibilite#validateTestBruxellesParticulierIndivision">
            <i class="bi bi-check-circle me-2"></i>
            Valider le test d'éligibilité
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Gestion des alertes informatives
  document.addEventListener('DOMContentLoaded', function() {
    // Gestion de l'alerte pour primes antérieures
    const primesAnterieureBtns = document.querySelectorAll('input[name="primes_anterieures"]');
    const primesAnterieureInfo = document.getElementById('primes_anterieures_info');

    primesAnterieureBtns.forEach(btn => {
      btn.addEventListener('change', function() {
        if (this.value === 'oui') {
          primesAnterieureInfo.style.display = 'block';
        } else {
          primesAnterieureInfo.style.display = 'none';
        }
      });
    });
  });
</script>
