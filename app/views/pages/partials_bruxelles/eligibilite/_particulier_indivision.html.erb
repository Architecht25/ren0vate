<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - Particulier Indivision -->
<div id="eligibility-test-bruxelles-particulier-indivision" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-diagram-3 me-2"></i>
        Test d'éligibilité - Particulier Indivision
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez vos critères d'éligibilité aux primes RENOLUTION Bruxelles
      </p>
    </div>

    <div class="card-body">
      <form id="eligibilityFormBruxellesParticulierIndivision" name="eligibilityFormBruxellesParticulierIndivision"
            data-test-eligibilite-target="form">
        <input type="hidden" name="profile_type" value="particulier_indivision">

        <!-- Question 1: Localisation du bien -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-geo-alt text-primary me-2"></i>
            Le bien concerné par la demande est-il situé en Région de Bruxelles-Capitale ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="localisation" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="localisation_oui">
              <label class="form-check-label" for="localisation_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="localisation" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="localisation_non">
              <label class="form-check-label" for="localisation_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 2: Âge du bâtiment -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-calendar text-primary me-2"></i>
            Le bâtiment est-il âgé d'au moins 10 ans ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="age_batiment" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="age_batiment_oui">
              <label class="form-check-label" for="age_batiment_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="age_batiment" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="age_batiment_non">
              <label class="form-check-label" for="age_batiment_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 3: Professionnel agréé -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-person-badge text-primary me-2"></i>
            Les travaux sont-ils réalisés par un professionnel inscrit à la Banque Carrefour des Entreprises qui dispose de l'accès réglementé à la profession ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="professionnel_agree" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="professionnel_agree_oui">
              <label class="form-check-label" for="professionnel_agree_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="professionnel_agree" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="professionnel_agree_non">
              <label class="form-check-label" for="professionnel_agree_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 4: Nouvelle construction -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-building text-primary me-2"></i>
            S'agit-il d'une nouvelle construction ou d'un ajout considéré comme nouvelle construction ?
          </h6>
          <p class="text-muted small mb-3">
            Exemple : une maison construite sur un terrain vierge, l'ajout d'une unité de logement en toiture d'un immeuble...
          </p>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="nouvelle_construction" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="nouvelle_construction_oui">
              <label class="form-check-label" for="nouvelle_construction_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="nouvelle_construction" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="nouvelle_construction_non">
              <label class="form-check-label" for="nouvelle_construction_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 5: Compte bancaire belge -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-bank text-primary me-2"></i>
            Possédez-vous un compte bancaire belge pour le virement de la prime ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="compte_bancaire_belge" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="compte_bancaire_belge_oui">
              <label class="form-check-label" for="compte_bancaire_belge_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="compte_bancaire_belge" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="compte_bancaire_belge_non">
              <label class="form-check-label" for="compte_bancaire_belge_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 6: Travaux réalisés -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-tools text-primary me-2"></i>
            Les travaux ont-ils été réalisés, avec une facture de solde émise dans les 12 mois précédant la demande ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="travaux_realises" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="travaux_realises_oui">
              <label class="form-check-label" for="travaux_realises_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="travaux_realises" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="travaux_realises_non">
              <label class="form-check-label" for="travaux_realises_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 7: Primes antérieures -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-award text-primary me-2"></i>
            J'ai introduit et reçu des primes pour le bien concerné
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="primes_anterieures" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="primes_anterieures_oui">
              <label class="form-check-label" for="primes_anterieures_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="primes_anterieures" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="primes_anterieures_non">
              <label class="form-check-label" for="primes_anterieures_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
          <!-- Alert pour primes antérieures -->
          <div id="primes_anterieures_info" class="alert alert-warning mt-3" style="display: none;">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Important :</strong> Des travaux identiques dans un même bien ne bénéficient d'une prime qu'une fois par période de 10 ans.
          </div>
        </div>

        <!-- Question 8: Type de propriété -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-house-gear text-primary me-2"></i>
            Quel type de bien possédez-vous ?
          </h6>
          <div class="row">
            <div class="col-12 mb-2">
              <div class="form-check">
                <input type="radio" class="form-check-input" name="type_propriete" value="immeuble_complet"
                       data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="type_propriete_immeuble">
                <label class="form-check-label" for="type_propriete_immeuble">
                  <i class="bi bi-building me-1"></i>Je suis propriétaire de tout l'immeuble
                </label>
              </div>
            </div>
            <div class="col-12 mb-2">
              <div class="form-check">
                <input type="radio" class="form-check-input" name="type_propriete" value="appartement"
                       data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="type_propriete_appartement">
                <label class="form-check-label" for="type_propriete_appartement">
                  <i class="bi bi-door-open me-1"></i>Je suis propriétaire d'un appartement résidentiel
                </label>
              </div>
            </div>
            <div class="col-12 mb-2">
              <div class="form-check">
                <input type="radio" class="form-check-input" name="type_propriete" value="maison"
                       data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="type_propriete_maison">
                <label class="form-check-label" for="type_propriete_maison">
                  <i class="bi bi-house me-1"></i>Je suis propriétaire d'une maison
                </label>
              </div>
            </div>
          </div>

          <!-- Sous-questions pour immeuble complet -->
          <div id="immeuble_details" style="display: none;" class="mt-3 p-3 bg-white border rounded">
            <h6 class="mb-3">Détails de l'immeuble</h6>
            <div class="mb-3">
              <label for="nb_appartements" class="form-label">Quantité d'appartements :</label>
              <input type="number" class="form-control" id="nb_appartements" name="nb_appartements" min="1">
            </div>
            <div class="mb-3">
              <label class="form-label">Composition de l'immeuble :</label>
              <div class="form-check">
                <input type="radio" class="form-check-input" name="composition_immeuble" value="80_plus_logement" id="composition_80_plus">
                <label class="form-check-label" for="composition_80_plus">
                  Avec au moins 80% de logement
                </label>
              </div>
              <div class="form-check">
                <input type="radio" class="form-check-input" name="composition_immeuble" value="80_moins_logement" id="composition_80_moins">
                <label class="form-check-label" for="composition_80_moins">
                  Avec moins de 80% de logement
                </label>
              </div>
              <div class="form-check">
                <input type="radio" class="form-check-input" name="composition_immeuble" value="sans_logement" id="composition_sans">
                <label class="form-check-label" for="composition_sans">
                  Sans logement
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Question 9: Indépendant -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-briefcase text-primary me-2"></i>
            Êtes-vous un indépendant ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="independant" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="independant_oui">
              <label class="form-check-label" for="independant_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="independant" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="independant_non">
              <label class="form-check-label" for="independant_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>

          <!-- Sous-question TVA -->
          <div id="tva_question" style="display: none;" class="mt-3 p-3 bg-white border rounded">
            <h6 class="mb-3">Déduisez-vous la TVA pour les travaux concernés par votre demande ?</h6>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="tva_deduite" value="oui" id="tva_deduite_oui">
              <label class="form-check-label" for="tva_deduite_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="tva_deduite" value="non" id="tva_deduite_non">
              <label class="form-check-label" for="tva_deduite_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 10: Activité professionnelle -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-house-gear text-primary me-2"></i>
            Une partie de votre logement est-elle utilisée pour l'exercice d'une activité professionnelle ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="activite_professionnelle" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="activite_professionnelle_oui">
              <label class="form-check-label" for="activite_professionnelle_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="activite_professionnelle" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="activite_professionnelle_non">
              <label class="form-check-label" for="activite_professionnelle_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>

          <!-- Sous-questions superficie -->
          <div id="superficie_details" style="display: none;" class="mt-3 p-3 bg-white border rounded">
            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="superficie_totale" class="form-label">Nombre de m² total du logement concerné :</label>
                <input type="number" class="form-control" id="superficie_totale" name="superficie_totale" min="1">
              </div>
              <div class="col-md-6 mb-3">
                <label for="superficie_professionnelle" class="form-label">Nombre de m² utilisés pour votre activité professionnelle :</label>
                <input type="number" class="form-control" id="superficie_professionnelle" name="superficie_professionnelle" min="1">
              </div>
            </div>
          </div>
        </div>

        <!-- Question 11: Permis d'urbanisme -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-file-earmark-check text-primary me-2"></i>
            J'ai un permis d'urbanisme octroyé par ma commune
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="permis_urbanisme" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="permis_urbanisme_oui">
              <label class="form-check-label" for="permis_urbanisme_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="permis_urbanisme" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="permis_urbanisme_non">
              <label class="form-check-label" for="permis_urbanisme_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
          <!-- Alert pour permis d'urbanisme -->
          <div id="permis_urbanisme_info" class="alert alert-warning mt-3" style="display: none;">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Information :</strong> Certains travaux nécessitent un permis d'urbanisme, nous vous invitons à consulter le service urbanisme de votre commune.
          </div>
        </div>

        <!-- Question 12: Bien classé -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-star text-primary me-2"></i>
            Ce bien est-il classé ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="bien_classe" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="bien_classe_oui">
              <label class="form-check-label" for="bien_classe_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="bien_classe" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="bien_classe_non">
              <label class="form-check-label" for="bien_classe_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 13: Petit patrimoine -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-building-check text-primary me-2"></i>
            La façade du bâtiment comporte-t-elle des éléments qui appartiennent au "Petit patrimoine" ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="petit_patrimoine" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="petit_patrimoine_oui">
              <label class="form-check-label" for="petit_patrimoine_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="petit_patrimoine" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="petit_patrimoine_non">
              <label class="form-check-label" for="petit_patrimoine_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Question 14: Mandat indivisaires -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-file-earmark-person text-primary me-2"></i>
            J'ai un mandat signé par tous les autres indivisaires, qui m'autorise à représenter l'indivision dans le cadre de la demande de primes, à réaliser les travaux, à recevoir la prime
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="mandat_indivisaires" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="mandat_indivisaires_oui">
              <label class="form-check-label" for="mandat_indivisaires_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="mandat_indivisaires" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="mandat_indivisaires_non">
              <label class="form-check-label" for="mandat_indivisaires_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
          <!-- Alert pour mandat indivisaires -->
          <div id="mandat_indivisaires_info" class="alert alert-danger mt-3" style="display: none;">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Attention :</strong> Le mandat signé par tous les indivisaires est obligatoire pour représenter l'indivision dans la demande de primes.
          </div>
        </div>

        <!-- Question 15: Consentement visites et contrôles -->
        <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
          <h6 class="mb-3 text-dark">
            <i class="bi bi-eye text-primary me-2"></i>
            Vous consentez aux visites et contrôles des membres de l'administration
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="consentement_controles" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="consentement_controles_oui">
              <label class="form-check-label" for="consentement_controles_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="consentement_controles" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulierIndivision" id="consentement_controles_non">
              <label class="form-check-label" for="consentement_controles_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
        </div>

        <!-- Zone de résultat -->
        <div id="resultBruxellesParticulierIndivision" class="mt-4" style="display: none;">
          <div class="alert alert-info">
            <h5 class="alert-heading">
              <i class="bi bi-info-circle me-2"></i>Résultat du test d'éligibilité
            </h5>
            <div id="resultContentBruxellesParticulierIndivision"></div>
          </div>
        </div>

        <!-- Bouton de validation -->
        <div class="d-grid gap-2 mt-4">
          <button type="button" class="btn btn-primary btn-lg"
                  data-test-eligibilite-target="validateButton"
                  data-action="click->test-eligibilite#validateTestBruxellesParticulierIndivision"
                  style="display: none;">
            <i class="bi bi-check-circle me-2"></i>
            Valider le test d'éligibilité
          </button>
        </div>
      </form>

      <!-- Section résultat -->
      <div data-test-eligibilite-target="result" class="mt-4"></div>
    </div>
  </div>
</div>

<script>
  // Gestion des sous-questions dynamiques
  document.addEventListener('DOMContentLoaded', function() {
    // Gestion du type de propriété
    const typeProprieteBtns = document.querySelectorAll('input[name="type_propriete"]');
    const immeubleDetails = document.getElementById('immeuble_details');

    typeProprieteBtns.forEach(btn => {
      btn.addEventListener('change', function() {
        if (this.value === 'immeuble_complet') {
          immeubleDetails.style.display = 'block';
        } else {
          immeubleDetails.style.display = 'none';
        }
      });
    });

    // Gestion indépendant -> TVA
    const independantBtns = document.querySelectorAll('input[name="independant"]');
    const tvaQuestion = document.getElementById('tva_question');

    independantBtns.forEach(btn => {
      btn.addEventListener('change', function() {
        if (this.value === 'oui') {
          tvaQuestion.style.display = 'block';
        } else {
          tvaQuestion.style.display = 'none';
        }
      });
    });

    // Gestion activité professionnelle -> superficie
    const activiteBtns = document.querySelectorAll('input[name="activite_professionnelle"]');
    const superficieDetails = document.getElementById('superficie_details');

    activiteBtns.forEach(btn => {
      btn.addEventListener('change', function() {
        if (this.value === 'oui') {
          superficieDetails.style.display = 'block';
        } else {
          superficieDetails.style.display = 'none';
        }
      });
    });

    // Gestion des alertes informatives
    const showAlertOnYes = [
      { name: 'primes_anterieures', alertId: 'primes_anterieures_info' }
    ];

    const showAlertOnNo = [
      { name: 'permis_urbanisme', alertId: 'permis_urbanisme_info' },
      { name: 'mandat_indivisaires', alertId: 'mandat_indivisaires_info' }
    ];

    showAlertOnYes.forEach(item => {
      const btns = document.querySelectorAll(`input[name="${item.name}"]`);
      const alert = document.getElementById(item.alertId);
      btns.forEach(btn => {
        btn.addEventListener('change', function() {
          if (this.value === 'oui') {
            alert.style.display = 'block';
          } else {
            alert.style.display = 'none';
          }
        });
      });
    });

    showAlertOnNo.forEach(item => {
      const btns = document.querySelectorAll(`input[name="${item.name}"]`);
      const alert = document.getElementById(item.alertId);
      btns.forEach(btn => {
        btn.addEventListener('change', function() {
          if (this.value === 'non') {
            alert.style.display = 'block';
          } else {
            alert.style.display = 'none';
          }
        });
      });
    });
  });
</script>
