<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - Particuliers -->
<div id="eligibility-test-bruxelles-particulier" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-house me-2"></i>
        Test d'éligibilité - Particuliers
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez vos critères d'éligibilité aux primes RENOLUTION Bruxelles
      </p>
    </div>

    <div class="card-body">
      <form id="eligibilityFormBruxellesParticulier" name="eligibilityFormBruxellesParticulier"
            data-test-eligibilite-target="form">
        <input type="hidden" name="profile_type" value="prive">
      <!-- Question 1: Localisation du bien -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-geo-alt text-primary me-2"></i>
          Votre logement est-il situé en Région de Bruxelles-Capitale ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="localisation_oui">
            <label class="form-check-label" for="localisation_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="localisation_non">
            <label class="form-check-label" for="localisation_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 2: Propriété du logement -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-key text-primary me-2"></i>
          Êtes-vous propriétaire du logement ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="proprietaire_oui">
            <label class="form-check-label" for="proprietaire_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="proprietaire_non">
            <label class="form-check-label" for="proprietaire_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 3: Résidence principale -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-person-check text-primary me-2"></i>
          Le logement est-il votre résidence principale ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="residence_principale" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="residence_principale_oui">
            <label class="form-check-label" for="residence_principale_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="residence_principale" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="residence_principale_non">
            <label class="form-check-label" for="residence_principale_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 4: Âge du logement -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-calendar text-primary me-2"></i>
          Le bâtiment a-t-il été construit il y a plus de 10 ans ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="age_batiment" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="age_batiment_oui">
            <label class="form-check-label" for="age_batiment_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="age_batiment" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="age_batiment_non">
            <label class="form-check-label" for="age_batiment_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 5: Compte bancaire belge -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-bank text-primary me-2"></i>
          Possédez-vous un compte bancaire belge ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="compte_belge" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="compte_belge_oui">
            <label class="form-check-label" for="compte_belge_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="compte_belge" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="compte_belge_non">
            <label class="form-check-label" for="compte_belge_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>
      </form>

      <!-- Bouton de validation du test -->
      <div class="text-center mt-4">
        <button type="button"
                class="btn btn-success btn-lg"
                data-action="click->test-eligibilite#validateTestBruxellesParticulier"
                data-test-eligibilite-target="validateButton"
                style="display: none;">
          <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
        </button>
      </div>

      <!-- Zone de résultat -->
      <div data-test-eligibilite-target="result" class="mt-4"></div>
    </div>
  </div>
</div>
