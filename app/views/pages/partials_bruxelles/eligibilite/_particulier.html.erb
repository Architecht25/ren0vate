<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - Particuliers -->
<div id="eligibility-test-bruxelles-particulier" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-house me-2"></i>
        Test d'éligibilité - Particuliers
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez vos critères d'éligibilité aux primes RENOLUTION Bruxelles
      </p>
    </div>

    <div class="card-body">
      <form id="eligibilityFormBruxellesParticulier" name="eligibilityFormBruxellesParticulier"
            data-test-eligibilite-target="form">
        <input type="hidden" name="profile_type" value="prive">
      <!-- Question 1: Localisation du bien -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-geo-alt text-primary me-2"></i>
          Le bien concerné par la demande est-il situé en Région de Bruxelles-Capitale ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="localisation_oui">
            <label class="form-check-label" for="localisation_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="localisation_non">
            <label class="form-check-label" for="localisation_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 2: Âge du bâtiment -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-calendar text-primary me-2"></i>
          Le bâtiment est-il âgé d'au moins 10 ans ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="age_batiment" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="age_batiment_oui">
            <label class="form-check-label" for="age_batiment_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="age_batiment" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="age_batiment_non">
            <label class="form-check-label" for="age_batiment_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 3: Professionnel agréé -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-tools text-primary me-2"></i>
          Les travaux sont-ils réalisés par un professionnel inscrit à la Banque Carrefour des Entreprises qui dispose de l'accès réglementé à la profession ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="professionnel_agree" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="professionnel_agree_oui">
            <label class="form-check-label" for="professionnel_agree_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="professionnel_agree" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="professionnel_agree_non">
            <label class="form-check-label" for="professionnel_agree_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 4: Nouvelle construction -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-hammer text-primary me-2"></i>
          S'agit-il d'une nouvelle construction ou d'un ajout considéré comme nouvelle construction ?
        </h6>
        <p class="text-muted small mb-3">
          <i class="bi bi-info-circle me-1"></i>
          Exemple : une maison construite sur un terrain vierge, l'ajout d'une unité de logement en toiture d'un immeuble...
        </p>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="nouvelle_construction" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="nouvelle_construction_oui">
            <label class="form-check-label" for="nouvelle_construction_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="nouvelle_construction" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="nouvelle_construction_non">
            <label class="form-check-label" for="nouvelle_construction_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 5: Compte bancaire belge -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-bank text-primary me-2"></i>
          Possédez-vous un compte bancaire belge pour le virement de la prime ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="compte_belge" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="compte_belge_oui">
            <label class="form-check-label" for="compte_belge_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="compte_belge" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="compte_belge_non">
            <label class="form-check-label" for="compte_belge_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 6: Travaux réalisés avec facture -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-receipt text-primary me-2"></i>
          Les travaux ont-ils été réalisés, avec une facture de solde émise dans les 12 mois précédant la demande ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="travaux_realises" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="travaux_realises_oui">
            <label class="form-check-label" for="travaux_realises_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="travaux_realises" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="travaux_realises_non">
            <label class="form-check-label" for="travaux_realises_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 7: Primes déjà reçues -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-award text-primary me-2"></i>
          J'ai introduit et reçu des primes pour le bien concerné
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="primes_recues" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="primes_recues_oui">
            <label class="form-check-label" for="primes_recues_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="primes_recues" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="primes_recues_non">
            <label class="form-check-label" for="primes_recues_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
        <div class="alert alert-warning mt-2" style="display: none;" id="primes_recues_warning">
          <small><i class="bi bi-exclamation-triangle me-1"></i>
          Des travaux identiques dans un même bien ne bénéficient d'une prime qu'une fois par période de 10 ans</small>
        </div>
      </div>

      <!-- Question 8: Type de propriété -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-building text-primary me-2"></i>
          Je suis propriétaire d'un appartement
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_appartement" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="proprietaire_appartement_oui">
            <label class="form-check-label" for="proprietaire_appartement_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_appartement" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="proprietaire_appartement_non">
            <label class="form-check-label" for="proprietaire_appartement_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>

        <!-- Sous-question conditionnelle pour appartement -->
        <div class="mt-3 ps-3 border-start border-warning" style="display: none;" id="appartement_parties_communes">
          <h6 class="mb-2 text-warning">
            <i class="bi bi-arrow-right me-2"></i>
            Les travaux concernent-ils les parties communes de l'immeuble ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="parties_communes" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="parties_communes_oui">
              <label class="form-check-label" for="parties_communes_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="parties_communes" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="parties_communes_non">
              <label class="form-check-label" for="parties_communes_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>
          <div class="alert alert-danger mt-2" style="display: none;" id="parties_communes_warning">
            <small><i class="bi bi-exclamation-triangle me-1"></i>
            Pas éligible - merci de faire la demande au nom de l'ACP</small>
          </div>
        </div>
      </div>

      <!-- Question 9: Propriétaire maison -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-house text-primary me-2"></i>
          Je suis propriétaire d'une maison
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_maison" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="proprietaire_maison_oui">
            <label class="form-check-label" for="proprietaire_maison_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_maison" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="proprietaire_maison_non">
            <label class="form-check-label" for="proprietaire_maison_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 10: BIM -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-heart text-primary me-2"></i>
          Bénéficiez-vous de l'intervention majorée (BIM) ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="bim" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="bim_oui">
            <label class="form-check-label" for="bim_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="bim" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="bim_non">
            <label class="form-check-label" for="bim_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
        <div class="alert alert-success mt-2" style="display: none;" id="bim_info">
          <small><i class="bi bi-info-circle me-1"></i>
          Le statut BIM est octroyé par votre mutuelle et permet d'accéder au montant de primes le plus élevé</small>
        </div>
      </div>

      <!-- Question 11: RIS -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-shield-check text-primary me-2"></i>
          Bénéficiez-vous d'un revenu d'intégration sociale (RIS) ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="ris" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="ris_oui">
            <label class="form-check-label" for="ris_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="ris" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="ris_non">
            <label class="form-check-label" for="ris_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
        <div class="alert alert-success mt-2" style="display: none;" id="ris_info">
          <small><i class="bi bi-info-circle me-1"></i>
          Le droit au RIS est déterminé par votre CPAS et permet d'accéder au montant de primes le plus élevé</small>
        </div>
      </div>

      <!-- Question 12: Client protégé -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-shield text-primary me-2"></i>
          Êtes-vous un client protégé de la Région de Bruxelles-Capitale ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="client_protege" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="client_protege_oui">
            <label class="form-check-label" for="client_protege_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="client_protege" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="client_protege_non">
            <label class="form-check-label" for="client_protege_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
        <div class="alert alert-success mt-2" style="display: none;" id="client_protege_info">
          <small><i class="bi bi-info-circle me-1"></i>
          Le statut de client protégé régional est octroyé par Sibelga, par votre CPAS ou par Brugel, et permet d'accéder aux montants de prime les plus élevés</small>
        </div>
      </div>

      <!-- Question 13: Indépendant -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-briefcase text-primary me-2"></i>
          Êtes-vous un indépendant ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="independant" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="independant_oui">
            <label class="form-check-label" for="independant_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="independant" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="independant_non">
            <label class="form-check-label" for="independant_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>

        <!-- Sous-questions conditionnelles pour indépendant -->
        <div class="mt-3 ps-3 border-start border-warning" style="display: none;" id="independant_details">
          <h6 class="mb-2 text-warning">
            <i class="bi bi-arrow-right me-2"></i>
            Déduisez-vous la TVA pour les travaux concernés par votre demande ?
          </h6>
          <div class="d-flex gap-3 mb-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="tva_deductible" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="tva_deductible_oui">
              <label class="form-check-label" for="tva_deductible_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="tva_deductible" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="tva_deductible_non">
              <label class="form-check-label" for="tva_deductible_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>

          <h6 class="mb-2 text-warning">
            <i class="bi bi-arrow-right me-2"></i>
            Une partie de votre logement est-elle utilisée pour l'exercice d'une activité professionnelle ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="usage_professionnel" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="usage_professionnel_oui">
              <label class="form-check-label" for="usage_professionnel_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="usage_professionnel" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="usage_professionnel_non">
              <label class="form-check-label" for="usage_professionnel_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>

          <!-- Sous-sous-questions pour usage professionnel -->
          <div class="mt-3 ps-3 border-start border-info" style="display: none;" id="usage_professionnel_details">
            <div class="mb-3">
              <label for="surface_totale" class="form-label text-info">
                <i class="bi bi-house-door me-1"></i>Nombre de m² total du logement concerné :
              </label>
              <input type="number" class="form-control" id="surface_totale" name="surface_totale"
                     placeholder="ex: 120" min="1" max="1000">
            </div>
            <div class="mb-3">
              <label for="surface_professionnelle" class="form-label text-info">
                <i class="bi bi-briefcase me-1"></i>Nombre de m² utilisés pour votre activité professionnelle :
              </label>
              <input type="number" class="form-control" id="surface_professionnelle" name="surface_professionnelle"
                     placeholder="ex: 20" min="1" max="1000">
            </div>
          </div>
        </div>
      </div>

      <!-- Question 14: Domiciliation -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-person-vcard text-primary me-2"></i>
          Êtes-vous domicilié à l'adresse du chantier ou comptez-vous le faire après les travaux ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="domiciliation" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="domiciliation_oui">
            <label class="form-check-label" for="domiciliation_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="domiciliation" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="domiciliation_non">
            <label class="form-check-label" for="domiciliation_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 15: Vente du bien -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-house-exclamation text-primary me-2"></i>
          Comptez-vous vendre/échanger/donner le bien en question dans les 5 ans suivant la demande de primes ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="vente_bien" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesParticulier" id="vente_bien_oui">
