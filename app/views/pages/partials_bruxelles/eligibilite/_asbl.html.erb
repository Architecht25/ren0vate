<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - ASBL -->
<div id="eligibility-test-bruxelles-asbl" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-heart me-2"></i>
        Test d'éligibilité - ASBL
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez l'éligibilité de votre ASBL aux primes RENOLUTION Bruxelles
      </p>
    </div>

    <div class="card-body">
      <form id="eligibilityFormBruxellesAsbl" name="eligibilityFormBruxellesAsbl" 
            data-test-eligibilite-target="form">
        <input type="hidden" name="profile_type" value="asbl">

      <!-- Question 1: Localisation -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-geo-alt text-primary me-2"></i>
          L'ASBL et le bâtiment sont-ils situés en Région de Bruxelles-Capitale ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="oui" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="localisation_oui">
            <label class="form-check-label" for="localisation_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="non" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="localisation_non">
            <label class="form-check-label" for="localisation_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 2: Secteur éligible -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-briefcase text-primary me-2"></i>
          L'ASBL exerce-t-elle ses activités dans le secteur social, culturel ou d'intérêt général ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="secteur_eligible" value="oui" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="secteur_eligible_oui">
            <label class="form-check-label" for="secteur_eligible_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="secteur_eligible" value="non" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="secteur_eligible_non">
            <label class="form-check-label" for="secteur_eligible_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 3: Autorisation travaux -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-key text-primary me-2"></i>
          Êtes-vous propriétaire du bâtiment ou avez-vous l'autorisation du propriétaire ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="autorisation_travaux" value="oui" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="autorisation_travaux_oui">
            <label class="form-check-label" for="autorisation_travaux_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="autorisation_travaux" value="non" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="autorisation_travaux_non">
            <label class="form-check-label" for="autorisation_travaux_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 4: Usage ASBL -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-building text-primary me-2"></i>
          Le bâtiment est-il destiné aux activités de l'ASBL (pas résidentiel) ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="usage_asbl" value="oui" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="usage_asbl_oui">
            <label class="form-check-label" for="usage_asbl_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="usage_asbl" value="non" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="usage_asbl_non">
            <label class="form-check-label" for="usage_asbl_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 5: Accueil public -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-people text-primary me-2"></i>
          L'ASBL accueille-t-elle régulièrement du public ou des bénéficiaires ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="accueil_public" value="oui" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="accueil_public_oui">
            <label class="form-check-label" for="accueil_public_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="accueil_public" value="non" 
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="accueil_public_non">
            <label class="form-check-label" for="accueil_public_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>
      </form>

      <!-- Bouton de validation du test -->
      <div class="text-center mt-4">
        <button type="button"
                class="btn btn-success btn-lg"
                data-action="click->test-eligibilite#validateTestBruxellesAsbl"
                data-test-eligibilite-target="validateButton"
                style="display: none;">
          <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
        </button>
      </div>

      <!-- Zone de résultat -->
      <div data-test-eligibilite-target="result" class="mt-4"></div>
    </div>
  </div>
</div>
