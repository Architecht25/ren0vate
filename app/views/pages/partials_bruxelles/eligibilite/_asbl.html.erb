<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - ASBL -->
<div id="eligibility-test-bruxelles-asbl" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-heart me-2"></i>
        Test d'éligibilité - ASBL
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez l'éligibilité de votre ASBL aux primes RENOLUTION Bruxelles
      </p>
    </div>

    <div class="card-body">
      <form id="eligibilityFormBruxellesAsbl" name="eligibilityFormBruxellesAsbl"
            data-test-eligibilite-target="form">
        <input type="hidden" name="profile_type" value="asbl">

      <!-- Question 1: Localisation -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-geo-alt text-primary me-2"></i>
          L'ASBL et le bâtiment sont-ils situés en Région de Bruxelles-Capitale ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_localisation_oui">
            <label class="form-check-label" for="asbl_localisation_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_localisation_non">
            <label class="form-check-label" for="asbl_localisation_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 2: L'ASBL prévoit-elle d'autres primes dans ce même bâtiment ? -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-award text-primary me-2"></i>
          L'ASBL prévoit-elle de demander d'autres primes d'énergie dans ce même bâtiment ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="autres_primes" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_autres_primes_non">
            <label class="form-check-label" for="asbl_autres_primes_non">
              <i class="bi bi-check-circle text-success me-1"></i>Non
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="autres_primes" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_autres_primes_oui">
            <label class="form-check-label" for="asbl_autres_primes_oui">
              <i class="bi bi-x-circle text-danger me-1"></i>Oui
            </label>
          </div>
        </div>
      </div>

      <!-- Question 3: Usage collectivité -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-people-fill text-primary me-2"></i>
          Ce bâtiment est-il utilisé par une collectivité ou une administration publique ?
          <small class="text-muted d-block">Communes, services publics, institutions publiques</small>
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="usage_collectivite" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_usage_collectivite_non">
            <label class="form-check-label" for="asbl_usage_collectivite_non">
              <i class="bi bi-check-circle text-success me-1"></i>Non
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="usage_collectivite" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_usage_collectivite_oui">
            <label class="form-check-label" for="asbl_usage_collectivite_oui">
              <i class="bi bi-x-circle text-danger me-1"></i>Oui
            </label>
          </div>
        </div>
      </div>

      <!-- Question 4: Enregistrement BCE -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-building-check text-primary me-2"></i>
          L'ASBL est-elle enregistrée à la BCE (Banque Carrefour des Entreprises) ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="enregistrement_bce" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_enregistrement_bce_oui">
            <label class="form-check-label" for="asbl_enregistrement_bce_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="enregistrement_bce" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_enregistrement_bce_non">
            <label class="form-check-label" for="asbl_enregistrement_bce_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 5: Type de bâtiment -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-building text-primary me-2"></i>
          Quel est le type de votre bâtiment ?
        </h6>
        <div class="d-flex flex-column gap-2">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="type_batiment" value="bureau"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_type_batiment_bureau">
            <label class="form-check-label" for="asbl_type_batiment_bureau">
              <i class="bi bi-briefcase me-1"></i>Bureau ou local administratif
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="type_batiment" value="centre_activites"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_type_batiment_centre_activites">
            <label class="form-check-label" for="asbl_type_batiment_centre_activites">
              <i class="bi bi-people me-1"></i>Centre d'activités ou accueil du public
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="type_batiment" value="local_technique"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_type_batiment_local_technique">
            <label class="form-check-label" for="asbl_type_batiment_local_technique">
              <i class="bi bi-tools me-1"></i>Local technique ou stockage
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="type_batiment" value="mixte"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_type_batiment_mixte">
            <label class="form-check-label" for="asbl_type_batiment_mixte">
              <i class="bi bi-layers me-1"></i>Usage mixte
            </label>
          </div>
        </div>
      </div>

      <!-- Question 6: Autorisation travaux -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-key text-primary me-2"></i>
          Êtes-vous propriétaire du bâtiment ou avez-vous l'autorisation du propriétaire pour réaliser les travaux ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="autorisation_travaux" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_autorisation_travaux_oui">
            <label class="form-check-label" for="asbl_autorisation_travaux_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="autorisation_travaux" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_autorisation_travaux_non">
            <label class="form-check-label" for="asbl_autorisation_travaux_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 7: Travaux commencés -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-calendar-check text-primary me-2"></i>
          Les travaux ont-ils déjà commencé ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="travaux_commences" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_travaux_commences_non">
            <label class="form-check-label" for="asbl_travaux_commences_non">
              <i class="bi bi-check-circle text-success me-1"></i>Non
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="travaux_commences" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_travaux_commences_oui">
            <label class="form-check-label" for="asbl_travaux_commences_oui">
              <i class="bi bi-x-circle text-danger me-1"></i>Oui
            </label>
          </div>
        </div>
      </div>

      <!-- Question 8: Numéro TVA -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-receipt text-primary me-2"></i>
          L'ASBL a-t-elle un numéro de TVA ?
          <small class="text-muted d-block">Certaines ASBL peuvent être assujetties à la TVA selon leurs activités</small>
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="numero_tva" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_numero_tva_non">
            <label class="form-check-label" for="asbl_numero_tva_non">
              <i class="bi bi-check-circle text-success me-1"></i>Non
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="numero_tva" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_numero_tva_oui">
            <label class="form-check-label" for="asbl_numero_tva_oui">
              <i class="bi bi-info-circle text-warning me-1"></i>Oui
            </label>
          </div>
        </div>
      </div>

      <!-- Section conditionnelle pour déduction TVA -->
      <div id="asbl_tva_deduction_section" style="display: none;" class="mb-4 p-3 border rounded bg-warning-subtle">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-calculator text-warning me-2"></i>
          L'ASBL peut-elle déduire la TVA sur les travaux d'amélioration énergétique ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="tva_deduction" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_tva_deduction_non">
            <label class="form-check-label" for="asbl_tva_deduction_non">
              <i class="bi bi-check-circle text-success me-1"></i>Non, pas de déduction
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="tva_deduction" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_tva_deduction_oui">
            <label class="form-check-label" for="asbl_tva_deduction_oui">
              <i class="bi bi-x-circle text-danger me-1"></i>Oui, déduction possible
            </label>
          </div>
        </div>
      </div>

      <!-- Question 9: Activités d'intérêt général -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-heart text-primary me-2"></i>
          L'ASBL exerce-t-elle des activités d'intérêt général reconnues ?
          <small class="text-muted d-block">Social, culturel, éducatif, sportif, environnemental, humanitaire</small>
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="activites_interet_general" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_activites_interet_general_oui">
            <label class="form-check-label" for="asbl_activites_interet_general_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="activites_interet_general" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_activites_interet_general_non">
            <label class="form-check-label" for="asbl_activites_interet_general_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 10: Secteur d'activité -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-diagram-3 text-primary me-2"></i>
          Dans quel secteur principal l'ASBL exerce-t-elle ses activités ?
        </h6>
        <div class="d-flex flex-column gap-2">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="secteur_activite" value="social"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_secteur_activite_social">
            <label class="form-check-label" for="asbl_secteur_activite_social">
              <i class="bi bi-people-fill me-1"></i>Social et aide aux personnes
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="secteur_activite" value="culturel"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_secteur_activite_culturel">
            <label class="form-check-label" for="asbl_secteur_activite_culturel">
              <i class="bi bi-palette me-1"></i>Culturel et artistique
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="secteur_activite" value="educatif"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_secteur_activite_educatif">
            <label class="form-check-label" for="asbl_secteur_activite_educatif">
              <i class="bi bi-book me-1"></i>Éducatif et formation
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="secteur_activite" value="sportif"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_secteur_activite_sportif">
            <label class="form-check-label" for="asbl_secteur_activite_sportif">
              <i class="bi bi-trophy me-1"></i>Sportif et loisirs
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="secteur_activite" value="environnemental"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_secteur_activite_environnemental">
            <label class="form-check-label" for="asbl_secteur_activite_environnemental">
              <i class="bi bi-tree me-1"></i>Environnemental et écologique
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="secteur_activite" value="autre"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_secteur_activite_autre">
            <label class="form-check-label" for="asbl_secteur_activite_autre">
              <i class="bi bi-question-circle me-1"></i>Autre secteur d'intérêt général
            </label>
          </div>
        </div>
      </div>

      <!-- Question 11: Bénéficiaires -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-people text-primary me-2"></i>
          L'ASBL accueille-t-elle régulièrement des bénéficiaires ou du public dans ce bâtiment ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="accueil_beneficiaires" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_accueil_beneficiaires_oui">
            <label class="form-check-label" for="asbl_accueil_beneficiaires_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="accueil_beneficiaires" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_accueil_beneficiaires_non">
            <label class="form-check-label" for="asbl_accueil_beneficiaires_non">
              <i class="bi bi-info-circle text-warning me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 12: Personnel permanent -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-person-badge text-primary me-2"></i>
          L'ASBL emploie-t-elle du personnel permanent dans ce bâtiment ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="personnel_permanent" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_personnel_permanent_oui">
            <label class="form-check-label" for="asbl_personnel_permanent_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="personnel_permanent" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_personnel_permanent_non">
            <label class="form-check-label" for="asbl_personnel_permanent_non">
              <i class="bi bi-info-circle text-warning me-1"></i>Non (bénévoles uniquement)
            </label>
          </div>
        </div>
      </div>

      <!-- Question 13: Utilisation du bâtiment -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-clock text-primary me-2"></i>
          Le bâtiment est-il utilisé de manière régulière et continue pour les activités de l'ASBL ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="utilisation_reguliere" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_utilisation_reguliere_oui">
            <label class="form-check-label" for="asbl_utilisation_reguliere_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="utilisation_reguliere" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_utilisation_reguliere_non">
            <label class="form-check-label" for="asbl_utilisation_reguliere_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non (usage occasionnel)
            </label>
          </div>
        </div>
      </div>

      <!-- Question 14: Budget annuel -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-cash text-primary me-2"></i>
          Quel est le budget annuel approximatif de l'ASBL ?
        </h6>
        <div class="d-flex flex-column gap-2">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="budget_annuel" value="moins_25k"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_budget_annuel_moins_25k">
            <label class="form-check-label" for="asbl_budget_annuel_moins_25k">
              <i class="bi bi-coin me-1"></i>Moins de 25 000€
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="budget_annuel" value="25k_100k"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_budget_annuel_25k_100k">
            <label class="form-check-label" for="asbl_budget_annuel_25k_100k">
              <i class="bi bi-cash-coin me-1"></i>Entre 25 000€ et 100 000€
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="budget_annuel" value="100k_500k"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_budget_annuel_100k_500k">
            <label class="form-check-label" for="asbl_budget_annuel_100k_500k">
              <i class="bi bi-bank me-1"></i>Entre 100 000€ et 500 000€
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="budget_annuel" value="plus_500k"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_budget_annuel_plus_500k">
            <label class="form-check-label" for="asbl_budget_annuel_plus_500k">
              <i class="bi bi-building me-1"></i>Plus de 500 000€
            </label>
          </div>
        </div>
      </div>

      <!-- Question 15: Règlement de minimis -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-shield-check text-primary me-2"></i>
          L'ASBL a-t-elle déjà reçu plus de 200 000€ d'aides publiques au cours des 3 dernières années ?
          <small class="text-muted d-block">Règlement européen de minimis pour les aides d'État</small>
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="reglement_de_minimis" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_reglement_de_minimis_non">
            <label class="form-check-label" for="asbl_reglement_de_minimis_non">
              <i class="bi bi-check-circle text-success me-1"></i>Non
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="reglement_de_minimis" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_reglement_de_minimis_oui">
            <label class="form-check-label" for="asbl_reglement_de_minimis_oui">
              <i class="bi bi-exclamation-triangle text-warning me-1"></i>Oui
            </label>
          </div>
        </div>
      </div>

      <!-- Question 16: Bâtiment conforme -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-check2-square text-primary me-2"></i>
          Le bâtiment est-il conforme à la réglementation en vigueur ?
          <small class="text-muted d-block">Permis d'urbanisme, normes de sécurité, accessibilité</small>
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="batiment_conforme" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_batiment_conforme_oui">
            <label class="form-check-label" for="asbl_batiment_conforme_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="batiment_conforme" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesAsbl" id="asbl_batiment_conforme_non">
            <label class="form-check-label" for="asbl_batiment_conforme_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      </form>

      <!-- Bouton de validation du test -->
      <div class="text-center mt-4">
        <button type="button"
                class="btn btn-success btn-lg"
                data-action="click->test-eligibilite#validateTestBruxellesAsbl"
                data-test-eligibilite-target="validateButton"
                style="display: none;">
          <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
        </button>
      </div>

      <!-- Zone de résultat -->
      <div data-test-eligibilite-target="result" class="mt-4"></div>
    </div>
  </div>
</div>
