<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - Entreprises -->
<div id="eligibility-test-bruxelles-entreprise" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-building me-2"></i>
        Test d'éligibilité - Entreprises
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez vos critères d'éligibilité aux primes RENOLUTION Bruxelles pour entreprises
      </p>
    </div>

    <div class="card-body">
      <form id="eligibilityFormBruxellesEntreprise" name="eligibilityFormBruxellesEntreprise"
            data-test-eligibilite-target="form">
        <input type="hidden" name="profile_type" value="entreprise">
      <!-- Question 1: Localisation du bien -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-geo-alt text-primary me-2"></i>
          Le bien concerné par la demande est-il situé en Région de Bruxelles-Capitale ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="localisation_oui">
            <label class="form-check-label" for="localisation_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="localisation_non">
            <label class="form-check-label" for="localisation_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 2: Âge du bâtiment -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-calendar text-primary me-2"></i>
          Le bâtiment est-il âgé d'au moins 10 ans ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="age_batiment" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="age_batiment_oui">
            <label class="form-check-label" for="age_batiment_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="age_batiment" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="age_batiment_non">
            <label class="form-check-label" for="age_batiment_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 3: Professionnel agréé -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-tools text-primary me-2"></i>
          Les travaux sont-ils réalisés par un professionnel inscrit à la Banque Carrefour des Entreprises qui dispose de l'accès réglementé à la profession ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="professionnel_agree" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="professionnel_agree_oui">
            <label class="form-check-label" for="professionnel_agree_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="professionnel_agree" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="professionnel_agree_non">
            <label class="form-check-label" for="professionnel_agree_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 4: Nouvelle construction -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-hammer text-primary me-2"></i>
          S'agit-il d'une nouvelle construction ou d'un ajout considéré comme nouvelle construction ?
        </h6>
        <p class="text-muted small mb-3">
          <i class="bi bi-info-circle me-1"></i>
          Exemple : une maison construite sur un terrain vierge, l'ajout d'une unité de logement en toiture d'un immeuble...
        </p>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="nouvelle_construction" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="nouvelle_construction_oui">
            <label class="form-check-label" for="nouvelle_construction_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="nouvelle_construction" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="nouvelle_construction_non">
            <label class="form-check-label" for="nouvelle_construction_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 5: Compte bancaire belge -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-bank text-primary me-2"></i>
          Possédez-vous un compte bancaire belge pour le virement de la prime ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="compte_belge" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="compte_belge_oui">
            <label class="form-check-label" for="compte_belge_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="compte_belge" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="compte_belge_non">
            <label class="form-check-label" for="compte_belge_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 6: Travaux réalisés avec facture -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-receipt text-primary me-2"></i>
          Les travaux ont-ils été réalisés, avec une facture de solde émise dans les 12 mois précédant la demande ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="travaux_realises" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="travaux_realises_oui">
            <label class="form-check-label" for="travaux_realises_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="travaux_realises" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="travaux_realises_non">
            <label class="form-check-label" for="travaux_realises_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 7: Primes déjà reçues -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-award text-primary me-2"></i>
          J'ai introduit et reçu des primes pour le bien concerné
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="primes_recues" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="primes_recues_oui">
            <label class="form-check-label" for="primes_recues_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="primes_recues" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="primes_recues_non">
            <label class="form-check-label" for="primes_recues_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
        <div class="alert alert-warning mt-2" style="display: none;" id="primes_recues_warning">
          <small><i class="bi bi-exclamation-triangle me-1"></i>
          Des travaux identiques dans un même bien ne bénéficient d'une prime qu'une fois par période de 10 ans</small>
        </div>
      </div>

      <!-- Question 8: Propriété de tout l'immeuble -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-building text-primary me-2"></i>
          La société est propriétaire de tout l'immeuble
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_immeuble" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="proprietaire_immeuble_oui">
            <label class="form-check-label" for="proprietaire_immeuble_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_immeuble" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="proprietaire_immeuble_non">
            <label class="form-check-label" for="proprietaire_immeuble_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
        
        <!-- Sous-questions conditionnelles pour immeuble -->
        <div class="mt-3 ps-3 border-start border-warning" style="display: none;" id="immeuble_details">
          <div class="mb-3">
            <label for="quantite_appartements" class="form-label text-warning">
              <i class="bi bi-building-fill me-1"></i>Quantité d'appartements :
            </label>
            <input type="number" class="form-control" id="quantite_appartements" name="quantite_appartements" 
                   placeholder="ex: 12" min="1" max="500">
          </div>

          <h6 class="mb-2 text-warning">
            <i class="bi bi-arrow-right me-2"></i>
            Avec au moins 80% de logement ?
          </h6>
          <div class="d-flex gap-3 mb-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="logement_80_pourcent" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="logement_80_pourcent_oui">
              <label class="form-check-label" for="logement_80_pourcent_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="logement_80_pourcent" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="logement_80_pourcent_non">
              <label class="form-check-label" for="logement_80_pourcent_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non (moins de 80%)
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="logement_80_pourcent" value="sans"
                     data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="logement_80_pourcent_sans">
              <label class="form-check-label" for="logement_80_pourcent_sans">
                <i class="bi bi-x-circle text-warning me-1"></i>Sans logement
              </label>
            </div>
          </div>

          <h6 class="mb-2 text-warning">
            <i class="bi bi-arrow-right me-2"></i>
            Le bâtiment ou l'unité est-il utilisé par une collectivité ?
          </h6>
          <div class="d-flex gap-3">
            <div class="form-check">
              <input type="radio" class="form-check-input" name="usage_collectivite" value="oui"
                     data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="usage_collectivite_oui">
              <label class="form-check-label" for="usage_collectivite_oui">
                <i class="bi bi-check-circle text-success me-1"></i>Oui
              </label>
            </div>
            <div class="form-check">
              <input type="radio" class="form-check-input" name="usage_collectivite" value="non"
                     data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="usage_collectivite_non">
              <label class="form-check-label" for="usage_collectivite_non">
                <i class="bi bi-x-circle text-danger me-1"></i>Non
              </label>
            </div>
          </div>

          <!-- Sous-sous-questions pour collectivité -->
          <div class="mt-3 ps-3 border-start border-info" style="display: none;" id="collectivite_details">
            <div class="mb-3">
              <label for="nom_collectivite" class="form-label text-info">
                <i class="bi bi-people me-1"></i>Nom de la collectivité :
              </label>
              <input type="text" class="form-control" id="nom_collectivite" name="nom_collectivite" 
                     placeholder="ex: Centre culturel municipal">
            </div>
            <div class="mb-3">
              <label for="code_nacebel" class="form-label text-info">
                <i class="bi bi-card-text me-1"></i>Code Nacebel de l'activité de la collectivité :
              </label>
              <input type="text" class="form-control" id="code_nacebel" name="code_nacebel" 
                     placeholder="ex: 90.04">
            </div>
          </div>
        </div>
      </div>

      <!-- Question 9: Propriétaire appartement résidentiel -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-house-door text-primary me-2"></i>
          La société est propriétaire d'un appartement résidentiel
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_appartement" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="proprietaire_appartement_oui">
            <label class="form-check-label" for="proprietaire_appartement_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_appartement" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="proprietaire_appartement_non">
            <label class="form-check-label" for="proprietaire_appartement_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 10: Propriétaire maison -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-house text-primary me-2"></i>
          La société est propriétaire d'une maison
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_maison" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="proprietaire_maison_oui">
            <label class="form-check-label" for="proprietaire_maison_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="proprietaire_maison" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="proprietaire_maison_non">
            <label class="form-check-label" for="proprietaire_maison_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 11: Enregistrement BCE -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-card-checklist text-primary me-2"></i>
          La société est-elle enregistrée à la BCE ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="enregistrement_bce" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="enregistrement_bce_oui">
            <label class="form-check-label" for="enregistrement_bce_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="enregistrement_bce" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="enregistrement_bce_non">
            <label class="form-check-label" for="enregistrement_bce_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 12: Bail AIS -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-file-earmark-text text-primary me-2"></i>
          Je loue mon bien via un bail AIS (Agence Immobilière Sociale)
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="bail_ais" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="bail_ais_oui">
            <label class="form-check-label" for="bail_ais_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="bail_ais" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="bail_ais_non">
            <label class="form-check-label" for="bail_ais_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 13: TVA déductible -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-percent text-primary me-2"></i>
          Déduisez-vous la TVA pour les travaux concernés par votre demande ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="tva_deductible" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="tva_deductible_oui">
            <label class="form-check-label" for="tva_deductible_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="tva_deductible" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="tva_deductible_non">
            <label class="form-check-label" for="tva_deductible_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
        
        <!-- Sous-question pour pourcentage TVA -->
        <div class="mt-3 ps-3 border-start border-warning" style="display: none;" id="tva_pourcentage">
          <div class="mb-3">
            <label for="pourcentage_tva" class="form-label text-warning">
              <i class="bi bi-calculator me-1"></i>À quel pourcentage ?
            </label>
            <input type="number" class="form-control" id="pourcentage_tva" name="pourcentage_tva" 
                   placeholder="ex: 100" min="0" max="100">
            <div class="form-text">
              Si vous récupérez la totalité de la TVA, veuillez encoder 100%. 
              Si vous ne récupérez qu'une partie de la TVA (ex: 50%), veuillez encoder ce pourcentage.
            </div>
          </div>
        </div>
      </div>

      <!-- Question 14: De minimis -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-euro text-primary me-2"></i>
          Exercez-vous une activité économique qui tombe sous la réglementation européenne dite de minimis ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="de_minimis" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="de_minimis_oui">
            <label class="form-check-label" for="de_minimis_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="de_minimis" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="de_minimis_non">
            <label class="form-check-label" for="de_minimis_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 15: Bien classé -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-building-gear text-primary me-2"></i>
          Ce bien est-il classé ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="bien_classe" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="bien_classe_oui">
            <label class="form-check-label" for="bien_classe_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="bien_classe" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="bien_classe_non">
            <label class="form-check-label" for="bien_classe_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 16: Petit patrimoine -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-gem text-primary me-2"></i>
          La façade du bâtiment comporte-t-elle des éléments qui appartiennent au "Petit patrimoine" ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="petit_patrimoine" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="petit_patrimoine_oui">
            <label class="form-check-label" for="petit_patrimoine_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="petit_patrimoine" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="petit_patrimoine_non">
            <label class="form-check-label" for="petit_patrimoine_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>
      </form>

      <!-- Bouton de validation du test -->
      <div class="text-center mt-4">
        <button type="button"
                class="btn btn-success btn-lg"
                data-action="click->test-eligibilite#validateTestBruxellesEntreprise"
                data-test-eligibilite-target="validateButton"
                style="display: none;">
          <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
        </button>
      </div>

      <!-- Zone de résultat -->
      <div data-test-eligibilite-target="result" class="mt-4"></div>
    </div>
  </div>
</div>
