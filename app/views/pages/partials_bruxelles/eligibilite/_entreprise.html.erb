<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - Entreprises -->
<div id="eligibility-test-bruxelles-entreprise" data-controller="test-eligibilite">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-building me-2"></i>
        Test d'éligibilité - Entreprises
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez vos critères d'éligibilité aux primes RENOLUTION Bruxelles pour entreprises
      </p>
    </div>

    <div class="card-body">
      <form id="eligibilityFormBruxellesEntreprise" name="eligibilityFormBruxellesEntreprise"
            data-test-eligibilite-target="form">
        <input type="hidden" name="profile_type" value="entreprise">
      <!-- Question 1: Localisation -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-geo-alt text-primary me-2"></i>
          Votre entreprise et le bâtiment sont-ils situés en Région de Bruxelles-Capitale ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="localisation_oui">
            <label class="form-check-label" for="localisation_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="localisation" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="localisation_non">
            <label class="form-check-label" for="localisation_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 2: PME -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-briefcase text-primary me-2"></i>
          Votre entreprise est-elle une PME (moins de 250 employés) ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="est_pme" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="est_pme_oui">
            <label class="form-check-label" for="est_pme_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="est_pme" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="est_pme_non">
            <label class="form-check-label" for="est_pme_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 3: Propriété du bâtiment -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-key text-primary me-2"></i>
          Êtes-vous propriétaire du bâtiment ou avez-vous l'autorisation du propriétaire ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="autorisation_travaux" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="autorisation_travaux_oui">
            <label class="form-check-label" for="autorisation_travaux_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="autorisation_travaux" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="autorisation_travaux_non">
            <label class="form-check-label" for="autorisation_travaux_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 4: Usage professionnel -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-building text-primary me-2"></i>
          Le bâtiment est-il destiné exclusivement à l'activité professionnelle ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="usage_professionnel" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="usage_professionnel_oui">
            <label class="form-check-label" for="usage_professionnel_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="usage_professionnel" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="usage_professionnel_non">
            <label class="form-check-label" for="usage_professionnel_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>

      <!-- Question 5: Compte bancaire belge -->
      <div class="mb-4 p-3 border rounded bg-light" data-test-eligibilite-target="formCard">
        <h6 class="mb-3 text-dark">
          <i class="bi bi-bank text-primary me-2"></i>
          L'entreprise possède-t-elle un compte bancaire belge ?
        </h6>
        <div class="d-flex gap-3">
          <div class="form-check">
            <input type="radio" class="form-check-input" name="compte_belge" value="oui"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="compte_belge_oui">
            <label class="form-check-label" for="compte_belge_oui">
              <i class="bi bi-check-circle text-success me-1"></i>Oui
            </label>
          </div>
          <div class="form-check">
            <input type="radio" class="form-check-input" name="compte_belge" value="non"
                   data-action="click->test-eligibilite#handleAnswerBruxellesEntreprise" id="compte_belge_non">
            <label class="form-check-label" for="compte_belge_non">
              <i class="bi bi-x-circle text-danger me-1"></i>Non
            </label>
          </div>
        </div>
      </div>
      </form>

      <!-- Bouton de validation du test -->
      <div class="text-center mt-4">
        <button type="button"
                class="btn btn-success btn-lg"
                data-action="click->test-eligibilite#validateTestBruxellesEntreprise"
                data-test-eligibilite-target="validateButton"
                style="display: none;">
          <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
        </button>
      </div>

      <!-- Zone de résultat -->
      <div data-test-eligibilite-target="result" class="mt-4"></div>
    </div>
  </div>
</div>
