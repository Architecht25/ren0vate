<!-- Questionnaire d'éligibilité RENOLUTION Bruxelles - Bailleurs sociaux (AIS) -->
<%= form_with url: test_eligibility_bruxelles_path, method: :post, local: false,
    data: { turbo_frame: "eligibility_content" }, class: "eligibility-form" do |f| %>

  <%= hidden_field_tag :profile_type, "bailleur" %>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-primary bg-opacity-10">
      <h5 class="card-title mb-0 text-primary">
        <i class="bi bi-key me-2"></i>
        Test d'éligibilité - Bailleurs sociaux (AIS)
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Vérifiez l'éligibilité de vos logements aux primes RENOLUTION Bruxelles
      </p>
    </div>

    <div class="card-body">
      <div class="mb-4">
        <label class="form-label fw-bold">
          <i class="bi bi-award text-primary me-2"></i>
          Êtes-vous agréé comme Agence Immobilière Sociale (AIS) ?
        </label>
        <div class="form-check">
          <%= f.radio_button :agrement_ais, "oui", class: "form-check-input", required: true %>
          <%= f.label :agrement_ais_oui, "Oui", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= f.radio_button :agrement_ais, "non", class: "form-check-input" %>
          <%= f.label :agrement_ais_non, "Non", class: "form-check-label" %>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label fw-bold">
          <i class="bi bi-geo-alt text-primary me-2"></i>
          Les logements sont-ils situés en Région de Bruxelles-Capitale ?
        </label>
        <div class="form-check">
          <%= f.radio_button :localisation, "oui", class: "form-check-input", required: true %>
          <%= f.label :localisation_oui, "Oui", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= f.radio_button :localisation, "non", class: "form-check-input" %>
          <%= f.label :localisation_non, "Non", class: "form-check-label" %>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label fw-bold">
          <i class="bi bi-house text-primary me-2"></i>
          Gérez-vous au moins un logement destiné au logement social ?
        </label>
        <div class="form-check">
          <%= f.radio_button :logement_social, "oui", class: "form-check-input", required: true %>
          <%= f.label :logement_social_oui, "Oui", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= f.radio_button :logement_social, "non", class: "form-check-input" %>
          <%= f.label :logement_social_non, "Non", class: "form-check-label" %>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label fw-bold">
          <i class="bi bi-bank text-primary me-2"></i>
          Possédez-vous un compte bancaire belge ?
        </label>
        <div class="form-check">
          <%= f.radio_button :compte_belge, "oui", class: "form-check-input", required: true %>
          <%= f.label :compte_belge_oui, "Oui", class: "form-check-label" %>
        </div>
        <div class="form-check">
          <%= f.radio_button :compte_belge, "non", class: "form-check-input" %>
          <%= f.label :compte_belge_non, "Non", class: "form-check-label" %>
        </div>
      </div>
    </div>

    <div class="card-footer bg-light">
      <div class="d-flex gap-2">
        <%= f.submit "Vérifier l'éligibilité", class: "btn btn-primary",
            data: { disable_with: "Vérification..." } %>
        <button type="button" class="btn btn-outline-secondary" onclick="location.reload()">
          <i class="bi bi-arrow-clockwise me-1"></i>Recommencer
        </button>
      </div>
    </div>
  </div>
<% end %>
