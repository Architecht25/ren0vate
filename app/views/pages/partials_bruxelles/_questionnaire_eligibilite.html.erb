<!-- Dispatcher pour les questionnaires d'éligibilité par profil -->
<% case profile_type %>
<% when "prive" %>
  <%= render "pages/partials_bruxelles/eligibilite/particulier" %>
<% when "entreprise" %>
  <%= render "pages/partials_bruxelles/eligibilite/entreprise" %>
<% when "syndic" %>
  <%= render "pages/partials_bruxelles/eligibilite/syndic" %>
<% when "bailleur" %>
  <%= render "pages/partials_bruxelles/eligibilite/bailleur" %>
<% when "asbl" %>
  <%= render "pages/partials_bruxelles/eligibilite/asbl" %>
<% when "coproprietaire" %>
  <%= render "pages/partials_bruxelles/eligibilite/coproprietaire" %>
<% when "emphytheote" %>
  <%= render "pages/partials_bruxelles/eligibilite/emphyteote" %>
<% when "locataire" %>
  <%= render "pages/partials_bruxelles/eligibilite/locataire" %>
<% when "particulier_bailleur" %>
  <%= render "pages/partials_bruxelles/eligibilite/particulier_bailleur" %>
<% when "particulier_indivision" %>
  <%= render "pages/partials_bruxelles/eligibilite/particulier_indivision" %>
<% else %>
  <!-- Fallback si le profil n'est pas reconnu -->
  <div class="alert alert-warning">
    <h6 class="alert-heading">
      <i class="bi bi-exclamation-triangle me-1"></i>
      Profil non reconnu
    </h6>
    <p class="mb-0">
      Le profil sélectionné (<%= profile_type %>) n'est pas reconnu. Veuillez recommencer la sélection.
    </p>
    <button type="button" class="btn btn-outline-secondary mt-2" onclick="location.reload()">
      <i class="bi bi-arrow-clockwise me-1"></i>Recommencer
    </button>
  </div>
<% end %>


    <!-- Bouton de validation du test -->
    <div class="text-center mt-4">
      <button type="button"
              class="btn btn-success btn-lg"
              data-action="click->test-eligibilite#validateTestBruxelles"
              data-test-eligibilite-target="validateButton"
              style="display: none;">
        <i class="bi bi-check2-circle me-2"></i>Valider mon test d'éligibilité
      </button>
    </div>

    <!-- Zone de résultat -->
    <div data-test-eligibilite-target="result" class="mt-4"></div>

    <!-- Information complémentaire -->
    <div class="alert alert-info mt-3 mb-0">
      <h6 class="alert-heading">
        <i class="bi bi-info-circle me-1"></i>
        À savoir
      </h6>
      <ul class="mb-0 small">
        <li><strong>Éligibilité :</strong> Toutes les conditions doivent être respectées</li>
        <li><strong>Région :</strong> Spécifique à la Région de Bruxelles-Capitale</li>
        <li><strong>Professionnel :</strong> Obligatoire pour obtenir les primes</li>
        <li><strong>Délais :</strong> Demande avant le début des travaux recommandée</li>
      </ul>
    </div>

  </div>
</div>
