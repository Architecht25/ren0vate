<% content_for :title, "Demande ##{@ticket.id} — Support" %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-xl-8">

      <!-- En-tête ticket -->
      <div class="d-flex align-items-center justify-content-between mb-3">
        <%= link_to support_tickets_path, class: "btn btn-sm btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Mes demandes
        <% end %>
        <div class="d-flex gap-2">
          <span class="badge bg-<%= @ticket.status_color %> fs-6"><%= @ticket.status_label %></span>
          <% if @ticket.priority == 'urgent' %>
            <span class="badge bg-danger fs-6">Urgent</span>
          <% end %>
        </div>
      </div>

      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-light">
          <h5 class="mb-0 fw-bold"><%= @ticket.subject %></h5>
          <small class="text-muted">
            Ticket #<%= @ticket.id %> · ouvert le <%= @ticket.created_at.strftime('%d/%m/%Y à %Hh%M') %>
            <% if @ticket.responded_at %>
              · première réponse le <%= @ticket.responded_at.strftime('%d/%m à %Hh%M') %>
            <% elsif @ticket.status == 'open' %>
              · <strong class="<%= @ticket.within_sla? ? 'text-success' : 'text-danger' %>">
                <%= @ticket.within_sla? ? "#{@ticket.sla_remaining_hours}h restantes (SLA 24h)" : "SLA dépassé" %>
              </strong>
            <% end %>
          </small>
        </div>

        <!-- Fil de messages -->
        <div class="card-body p-3">
          <% @messages.each do |msg| %>
            <% is_admin = msg.is_admin_reply? %>
            <div class="d-flex gap-3 mb-4 <%= 'flex-row-reverse' if is_admin %>">
              <div class="flex-shrink-0">
                <div class="rounded-circle d-flex align-items-center justify-content-center
                            <%= is_admin ? 'bg-primary' : 'bg-success' %> text-white"
                     style="width:38px;height:38px;font-size:14px;">
                  <%= is_admin ? 'R' : current_user.email.first.upcase %>
                </div>
              </div>
              <div class="flex-grow-1">
                <div class="small text-muted mb-1 <%= 'text-end' if is_admin %>">
                  <strong><%= is_admin ? 'Équipe Ren0vate' : current_user.email %></strong>
                  · <%= msg.created_at.strftime('%d/%m à %Hh%M') %>
                </div>
                <div class="p-3 rounded-3 <%= is_admin ? 'bg-primary bg-opacity-10' : 'bg-light' %>"
                     style="white-space: pre-wrap; font-size: 0.9rem;">
                  <%= msg.body %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Formulaire de réponse (si pas fermé) -->
      <% unless %w[resolved closed].include?(@ticket.status) %>
        <div class="card border-0 shadow-sm mb-3">
          <div class="card-body p-3">
            <%= form_with url: reply_support_ticket_path(@ticket), method: :post do |f| %>
              <label class="form-label fw-semibold small">Votre réponse</label>
              <%= f.text_area :body,
                    name: "support_message[body]",
                    rows: 4,
                    class: "form-control mb-2",
                    placeholder: "Ajoutez des précisions ou répondez à l'équipe..." %>
              <div class="d-flex justify-content-between align-items-center">
                <%= f.submit "Envoyer", class: "btn btn-primary" %>
                <%= link_to close_support_ticket_path(@ticket), method: :patch,
                      class: "btn btn-outline-secondary btn-sm",
                      data: { confirm: "Marquer ce ticket comme résolu ?" } do %>
                  <i class="bi bi-check2-circle me-1"></i>Marquer résolu
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <div class="alert alert-success">
          <i class="bi bi-check-circle me-2"></i>Cette demande est marquée comme <%= @ticket.status_label.downcase %>.
          <%= link_to "Ouvrir une nouvelle demande", new_support_ticket_path, class: "alert-link" %>
        </div>
      <% end %>

    </div>
  </div>
</div>
