<% content_for :title, "Mon support — Ren0vate" %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-xl-8">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h4 fw-bold mb-0">
          <i class="bi bi-headset me-2 text-primary"></i>Support prioritaire
        </h1>
        <%= link_to new_support_ticket_path, class: "btn btn-primary" do %>
          <i class="bi bi-plus-circle me-1"></i>Nouvelle demande
        <% end %>
      </div>

      <% if @tickets.empty? %>
        <div class="text-center py-5 bg-white rounded-3 shadow-sm">
          <i class="bi bi-chat-dots fs-1 text-muted"></i>
          <p class="mt-3 text-muted">Vous n'avez aucune demande de support.</p>
          <%= link_to new_support_ticket_path, class: "btn btn-primary mt-2" do %>
            <i class="bi bi-plus-circle me-1"></i>Créer ma première demande
          <% end %>
        </div>
      <% else %>
        <div class="list-group shadow-sm">
          <% @tickets.each do |ticket| %>
            <%= link_to support_ticket_path(ticket), class: "list-group-item list-group-item-action py-3" do %>
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <span class="fw-semibold"><%= ticket.subject %></span>
                  <div class="mt-1 small text-muted">
                    #<%= ticket.id %> · créé le <%= ticket.created_at.strftime('%d/%m/%Y à %Hh%M') %>
                    · <%= ticket.support_messages.count %> message(s)
                  </div>
                </div>
                <div class="d-flex flex-column align-items-end gap-1">
                  <span class="badge bg-<%= ticket.status_color %>"><%= ticket.status_label %></span>
                  <% unless ticket.within_sla? || ticket.responded_at %>
                    <span class="badge bg-danger">SLA dépassé</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div class="mt-4 p-3 bg-white rounded-3 shadow-sm small text-muted">
        <i class="bi bi-clock me-1"></i>
        <strong>Support prioritaire 24h</strong> — notre équipe répond dans les 24 heures (jours ouvrables).
      </div>
    </div>
  </div>
</div>
