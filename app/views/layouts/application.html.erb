<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ren0vate — Passeport numérique de votre logement en Belgique" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Ren0vate">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#1e3a5f">

    <!-- Meta Description -->
    <meta name="description" content="<%= content_for(:meta_description) || "Ren0vate centralise toute la vie de votre logement : rénovation, primes, DIU, vente et gestion locative — en un seul endroit, pour propriétaires belges." %>">

    <!-- Balises canoniques pour le multi-langue -->
    <% if content_for?(:canonical_url) %>
      <link rel="canonical" href="<%= content_for(:canonical_url) %>">
    <% end %>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for(:og_title) || content_for(:title) || "Ren0vate — Passeport numérique de votre logement" %>">
    <meta property="og:description" content="<%= content_for(:og_description) || content_for(:meta_description) || "Rénovation, primes, DIU, vente et gestion locative — Ren0vate centralise toute la vie de votre logement." %>">
    <meta property="og:url" content="<%= content_for(:og_url) || request.original_url %>">
    <% if content_for?(:og_image) %><meta property="og:image" content="<%= content_for(:og_image) %>"><% end %>
    <meta property="og:site_name" content="Ren0vate">
    <meta property="og:locale" content="<%= I18n.locale == :fr ? "fr_BE" : I18n.locale == :nl ? "nl_BE" : I18n.locale == :es ? "es_ES" : "en_US" %>">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for(:twitter_title) || content_for(:og_title) || content_for(:title) || "Ren0vate" %>">
    <meta name="twitter:description" content="<%= content_for(:twitter_description) || content_for(:og_description) || content_for(:meta_description) || "Rénovation, primes, DIU, vente, location — le passeport numérique de votre logement belge." %>">
    <% if content_for?(:twitter_image) || content_for?(:og_image) %><meta name="twitter:image" content="<%= content_for(:twitter_image) || content_for(:og_image) %>"><% end %>

    <!-- Keywords -->
    <meta name="keywords" content="<%= content_for(:keywords) || "gestion immobilière belgique, passeport logement, DIU dossier intervention ultérieure, rénovation belgique, gestion locative, vente immobilière belgique, primes rénovation, flandre bruxelles wallonie" %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Empêcher Turbo de cacher les pages authentifiées (évite les données cross-user) %>
    <meta name="turbo-cache-control" content="no-store">

    <%= yield :head %>

    <%# PWA manifest %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path %>

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <%# Bootstrap CSS via CDN %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <%# Bootstrap Icons %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <%# FontAwesome %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%# SweetAlert2 CSS %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <%# AOS animations CSS %>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "sidebar", media: "all", "data-turbo-track": "reload" %>
    <%# SweetAlert2 JS before importmap %>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js" nonce="<%= content_security_policy_nonce %>"></script>
    <%# Bootstrap JS Bundle (includes Popper) %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" nonce="<%= content_security_policy_nonce %>"></script>
    <%# Shim ES module / ImportMap pour Firefox < 108 et Safari < 16.4 %>
    <script async src="https://cdn.jsdelivr.net/npm/es-module-shims@1.10.0/dist/es-module-shims.js" nonce="<%= content_security_policy_nonce %>"></script>
    <%# Avertissement navigateur obsolète — nomodule s'exécute uniquement sur IE11 / vieux Edge %>
    <%# Les navigateurs modernes (Chrome, Firefox, Edge, Safari) ignorent ce bloc %>
    <script nomodule nonce="<%= content_security_policy_nonce %>">
      document.addEventListener('DOMContentLoaded', function() {
        var banner = document.createElement('div');
        banner.style.cssText = 'position:fixed;top:0;left:0;right:0;padding:16px 24px;background:#c0392b;color:#fff;text-align:center;z-index:99999;font-family:sans-serif;font-size:15px;line-height:1.5';
        banner.innerHTML = '⚠️ Votre navigateur n\'est pas compatible avec Ren0vate. Veuillez utiliser <strong>Chrome</strong>, <strong>Firefox</strong>, <strong>Edge</strong> ou <strong>Safari</strong> dans une version récente (2022 ou plus récent).';
        document.body.insertBefore(banner, document.body.firstChild);
      });
    </script>
    <%= javascript_importmap_tags %>

    <%# Plausible Analytics — cookieless, aucun consentement requis (production uniquement) %>
    <% if Rails.env.production? %>
      <script defer data-domain="ren0vate.be"
              src="https://plausible.io/js/script.js"
              nonce="<%= content_security_policy_nonce %>"></script>
    <% end %>
  </head>

  <body>
    <% if user_signed_in? %>
      <%= render 'shared/sidebar' %>
    <% end %>

    <div class="main-content<%= ' no-sidebar' unless user_signed_in? %><%= ' p-0' if content_for?(:full_width_page) %>">
      <%# Guide premiers pas — 7 jours post-inscription %>
      <%= render 'shared/first_steps_guide' %>
      <% if content_for?(:full_width_page) %>
        <div class="px-2"><%= render "shared/flashes" %></div>
      <% else %>
        <%= render "shared/flashes" %>
      <% end %>
      <%= yield %>
    </div>

    <!-- Widget de Support (toujours visible) -->
    <%= render 'shared/support_widget' %>

    <%# Modale NPS — feedback utilisateur (J+14) %>
    <%= render 'shared/nps_modal' %>

    <%# Bottom navigation bar — mobile PWA (d-md-none) %>
    <%= render 'shared/bottom_nav' %>

    <%# Bannière d'installation PWA (Android + iOS) %>
    <% if user_signed_in? %>
      <%= render 'shared/pwa_install_banner' %>
    <% end %>

    <%# Bandeau consentement cookies (RGPD — ePrivacy) %>
    <%= render 'shared/cookie_banner' %>

    <!-- Script pour gérer la sidebar mobile -->
    <script nonce="<%= content_security_policy_nonce %>">
      document.addEventListener('turbo:load', function() {
        const sidebar = document.getElementById('mainSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const mobileTrigger = document.getElementById('mobileSidebarTrigger');
        const sidebarToggle = document.getElementById('sidebarToggle');

        function openSidebar() {
          sidebar.classList.add('active');
          overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
          sidebar.classList.remove('active');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        }

        if (mobileTrigger) {
          mobileTrigger.addEventListener('click', openSidebar);
        }

        if (sidebarToggle) {
          sidebarToggle.addEventListener('click', closeSidebar);
        }

        if (overlay) {
          overlay.addEventListener('click', closeSidebar);
        }

        // Fermer la sidebar lors du clic sur un lien (mobile)
        if (window.innerWidth < 768) {
          const navLinks = sidebar.querySelectorAll('.nav-link:not(.disabled)');
          navLinks.forEach(link => {
            link.addEventListener('click', closeSidebar);
          });
        }
      });
    </script>
    <%# Enregistrement du Service Worker PWA — production uniquement.
        En dev, son cache-first sur les assets JS/CSS sert des versions périmées à
        chaque modification de code, ce qui rend le débogage impossible (symptômes
        fantômes, correctifs qui "ne s'appliquent jamais"). On le désenregistre et on
        vide son cache hors production pour que le navigateur reparte propre. %>
    <script nonce="<%= content_security_policy_nonce %>">
      if ('serviceWorker' in navigator) {
        <% if Rails.env.production? %>
          window.addEventListener('load', function() {
            navigator.serviceWorker.register('/service-worker', { scope: '/' })
              .catch(function(err) {
                console.warn('Service Worker registration failed:', err);
              });
          });
        <% else %>
          navigator.serviceWorker.getRegistrations().then(function(regs) {
            regs.forEach(function(reg) { reg.unregister(); });
          });
          if ('caches' in window) {
            caches.keys().then(function(names) {
              names.forEach(function(name) { caches.delete(name); });
            });
          }
        <% end %>
      }
    </script>
    <script nonce="<%= content_security_policy_nonce %>">
      function initPasswordToggles() {
        document.querySelectorAll('.password-toggle-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var input = btn.closest('.input-group').querySelector('input');
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
              input.type = 'text';
              icon.classList.remove('bi-eye');
              icon.classList.add('bi-eye-slash');
            } else {
              input.type = 'password';
              icon.classList.remove('bi-eye-slash');
              icon.classList.add('bi-eye');
            }
          });
        });
      }
      document.addEventListener('DOMContentLoaded', initPasswordToggles);
      document.addEventListener('turbo:load', initPasswordToggles);
    </script>
    <%# AOS.js animations %>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" nonce="<%= content_security_policy_nonce %>"></script>
    <script nonce="<%= content_security_policy_nonce %>">
      function initAOS() {
        if (typeof AOS !== 'undefined') {
          AOS.init({ duration: 600, once: true, offset: 80 });
        }
      }
      document.addEventListener('DOMContentLoaded', initAOS);
      document.addEventListener('turbo:load', initAOS);
      // Navbar glassmorphism au scroll
      (function() {
        var scrollHandler = function() {
          var navbar = document.querySelector('.navbar');
          if (navbar) navbar.classList.toggle('scrolled', window.scrollY > 50);
        };
        window.addEventListener('scroll', scrollHandler, { passive: true });
      })();
    </script>
  </body>
</html>
