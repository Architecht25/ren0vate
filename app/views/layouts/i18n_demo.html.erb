<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t('navigation.home') %> - Ren0vate</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="csrf-token" content="<%= csrf_token %>">
    <meta name="user-signed-in" content="<%= user_signed_in? %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="language">
    <!-- Navigation avec sélecteur de langue -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand" do %>
          🏠 Ren0vate
        <% end %>

        <div class="navbar-nav ms-auto d-flex align-items-center">
          <!-- Sélecteur de langue -->
          <%= render 'shared/language_selector' %>
        </div>
      </div>
    </nav>

    <!-- Contenu principal avec traductions -->
    <main class="container my-4">
      <!-- Messages flash avec traductions -->
      <% if notice %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if alert %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Footer avec informations sur la langue -->
    <footer class="bg-light py-3 mt-5">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-md-6">
            <small class="text-muted">
              🌍 <%= t('common.current_language') %>: <%= current_locale_name %>
            </small>
          </div>
          <div class="col-md-6 text-end">
            <small class="text-muted">
              <%= t('common.powered_by') %> Rails I18n
            </small>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
