<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; color: #222; background: #f5f7fa; margin: 0; padding: 0; }
    .wrapper { max-width: 600px; margin: 32px auto; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .header { background: #1e3a5f; color: #fff; padding: 28px 32px; }
    .header .label { font-size: 11px; opacity: .7; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 6px; }
    .header h1 { font-size: 20px; margin: 0 0 4px; }
    .header .sub { font-size: 13px; opacity: .8; }
    .body { padding: 28px 32px; }
    .info-box { background: #f8f9fa; border-radius: 8px; padding: 16px 20px; margin: 20px 0; font-size: 14px; }
    .info-box .row { display: flex; gap: 8px; margin-bottom: 6px; }
    .info-box .label { color: #6c757d; min-width: 120px; }
    .cta { display: block; background: #1e3a5f; color: #fff !important; text-decoration: none; text-align: center;
           padding: 14px 28px; border-radius: 8px; font-size: 15px; font-weight: 600; margin: 24px 0; }
    .footer { font-size: 11px; color: #aaa; text-align: center; padding: 16px 32px; border-top: 1px solid #f0f0f0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <div class="label">Ren0vate · Document de suivi</div>
      <h1>PV de visite de chantier</h1>
      <div class="sub">Projet : <strong><%= @project.nom %></strong></div>
    </div>
    <div class="body">
      <p>Bonjour<% if @nom.present? %> <strong><%= @nom %></strong><% end %>,</p>
      <p>
        <strong><%= @auteur_nom %></strong> (architecte du projet) vient de rédiger un procès-verbal
        de visite de chantier et vous le partage en tant que <strong><%= @role_label %></strong>.
      </p>

      <div class="info-box">
        <div class="row">
          <span class="label">Projet</span>
          <span><%= @project.nom %></span>
        </div>
        <div class="row">
          <span class="label">Visite</span>
          <span><%= @pv_visite.titre %></span>
        </div>
        <% if @pv_visite.presents.present? %>
          <div class="row">
            <span class="label">Présents</span>
            <span><%= @pv_visite.presents %></span>
          </div>
        <% end %>
        <div class="row">
          <span class="label">Points constatés</span>
          <span><%= @pv_visite.points_liste.size %> point<%= 's' if @pv_visite.points_liste.size != 1 %></span>
        </div>
      </div>

      <p>Cliquez ci-dessous pour consulter le PV de visite :</p>

      <a href="<%= @view_url %>" class="cta">
        Consulter le PV de visite de chantier →
      </a>

      <p style="font-size:13px;color:#6c757d;">
        Ce lien est personnel et vous permet de consulter et télécharger le document.
        Il est valable sans connexion.
      </p>
    </div>
    <div class="footer">
      Ren0vate · Gestion numérique de projets de rénovation · Belgique
    </div>
  </div>
</body>
</html>
