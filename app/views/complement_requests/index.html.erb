<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-file-earmark-plus"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Demandes de Complément</h1>
        <small class="text-muted">Gestion centralisée des demandes de complément administratif</small>
      </div>
    </div>
    <div class="text-muted">
      <i class="bi bi-file-earmark-text me-1"></i>
      <span id="total-complements"><%= @complement_requests.count %></span> demande(s)
    </div>
  </div>

  <!-- Filtres et statistiques -->
  <div class="row mb-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <%= form_with url: complement_requests_path, method: :get, local: true, class: "row g-3" do |form| %>
            <div class="col-md-3">
              <%= form.select :status,
                              options_for_select([
                                ['Tous les statuts', ''],
                                ['En attente', 'pending'],
                                ['Complété', 'completed'],
                                ['Approuvé', 'approved'],
                                ['Rejeté', 'rejected'],
                                ['Expiré', 'expired']
                              ], params[:status]),
                              {}, { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <%= form.select :complement_type,
                              options_for_select([
                                ['Tous les types', ''],
                                ['Documents manquants', 'documents_manquants'],
                                ['Informations techniques', 'informations_techniques'],
                                ['Clarifications administratives', 'clarifications_administratives'],
                                ['Conformité réglementaire', 'conformite_reglementaire'],
                                ['Vérification d\'éligibilité', 'verification_eligibilite']
                              ], params[:complement_type]),
                              {}, { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <%= form.select :priority,
                              options_for_select([
                                ['Toutes priorités', ''],
                                ['Urgente', 'urgent'],
                                ['Haute', 'high'],
                                ['Normale', 'normal']
                              ], params[:priority]),
                              {}, { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <div class="d-flex gap-2">
                <%= form.submit "Filtrer", class: "btn btn-primary flex-grow-1" %>
                <%= link_to complement_requests_path, class: "btn btn-outline-secondary" do %>
                  <i class="bi bi-arrow-clockwise"></i>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body text-center">
          <div class="row g-3">
            <div class="col-3">
              <div class="text-warning">
                <i class="bi bi-clock-history fs-3"></i>
                <div class="mt-1">
                  <strong><%= @complement_requests.where(status: 'pending').count %></strong>
                  <br><small>En attente</small>
                </div>
              </div>
            </div>
            <div class="col-3">
              <div class="text-info">
                <i class="bi bi-check-square fs-3"></i>
                <div class="mt-1">
                  <strong><%= @complement_requests.where(status: 'completed').count %></strong>
                  <br><small>Complétées</small>
                </div>
              </div>
            </div>
            <div class="col-3">
              <div class="text-success">
                <i class="bi bi-check-circle fs-3"></i>
                <div class="mt-1">
                  <strong><%= @complement_requests.where(status: 'approved').count %></strong>
                  <br><small>Approuvées</small>
                </div>
              </div>
            </div>
            <div class="col-3">
              <div class="text-danger">
                <i class="bi bi-x-circle fs-3"></i>
                <div class="mt-1">
                  <strong><%= @complement_requests.where(status: 'rejected').count %></strong>
                  <br><small>Rejetées</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Liste des demandes de complément -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h6 class="mb-0">Demandes de complément administratif</h6>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" onclick="location.reload()">
          <i class="bi bi-arrow-clockwise me-1"></i>Actualiser
        </button>
      </div>
    </div>
    <div class="card-body p-0">
      <% if @complement_requests.any? %>
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Demandeur</th>
                <th>Type de complément</th>
                <th>Description</th>
                <th>Priorité</th>
                <th>Statut</th>
                <th>Délais</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @complement_requests.each do |complement| %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center">
                      <i class="bi bi-person-circle me-2 text-muted"></i>
                      <div>
                        <strong><%= complement.request_progress.request.user.full_name %></strong>
                        <br><small class="text-muted">
                          <i class="bi bi-file-earmark-text me-1"></i><%= truncate(complement.request_progress.request.title, length: 25) %>
                        </small>
                        <br><small class="text-muted">
                          <i class="bi bi-geo-alt me-1"></i><%= truncate(complement.request_progress.request.property.address, length: 30) %>
                        </small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-info mb-1">
                      <%= t("complement_requests.types.#{complement.complement_type}", default: complement.complement_type.humanize) %>
                    </span>
                    <br><small class="text-muted">
                      <%= l(complement.created_at.to_date) %>
                    </small>
                  </td>
                  <td>
                    <div style="max-width: 200px;">
                      <%= truncate(complement.request_details, length: 80) %>
                      <% if complement.specific_requirements.present? %>
                        <br><small class="text-muted">
                          <strong>Exigences :</strong> <%= truncate(complement.specific_requirements, length: 50) %>
                        </small>
                      <% end %>
                    </div>
                  </td>
                  <td>
                    <% priority_colors = { 'urgent' => 'danger', 'high' => 'warning', 'normal' => 'secondary' } %>
                    <span class="badge bg-<%= priority_colors[complement.priority] || 'secondary' %>">
                      <%= complement.priority&.humanize || 'Normal' %>
                    </span>
                  </td>
                  <td>
                    <% status_colors = { 'pending' => 'warning', 'completed' => 'info', 'approved' => 'success', 'rejected' => 'danger', 'expired' => 'secondary' } %>
                    <span class="badge bg-<%= status_colors[complement.status] || 'secondary' %>">
                      <%= t("complement_requests.statuses.#{complement.status}", default: complement.status.humanize) %>
                    </span>
                    <% if complement.response_user_id && complement.status == 'completed' %>
                      <br><small class="text-muted">
                        Répondu par <%= User.find(complement.response_user_id).full_name rescue 'Utilisateur' %>
                      </small>
                    <% end %>
                  </td>
                  <td>
                    <div>
                      <% if complement.deadline %>
                        <small>
                          <strong>Échéance :</strong> <%= l(complement.deadline) %>
                          <% days_remaining = (complement.deadline - Date.current).to_i %>
                          <% if days_remaining < 0 %>
                            <br><span class="text-danger">
                              <i class="bi bi-exclamation-triangle me-1"></i>Expiré il y a <%= pluralize(-days_remaining, 'jour') %>
                            </span>
                          <% elsif days_remaining <= 3 %>
                            <br><span class="text-warning">
                              <i class="bi bi-clock me-1"></i><%= pluralize(days_remaining, 'jour') %> restant<%= 's' if days_remaining > 1 %>
                            </span>
                          <% else %>
                            <br><span class="text-muted">
                              <i class="bi bi-calendar me-1"></i><%= pluralize(days_remaining, 'jour') %> restant<%= 's' if days_remaining > 1 %>
                            </span>
                          <% end %>
                        </small>
                      <% else %>
                        <span class="text-muted">Pas de délai</span>
                      <% end %>
                    </div>
                  </td>
                  <td>
                    <div class="btn-group btn-group-sm">
                      <%= link_to request_progress_complement_request_path(complement.request_progress, complement),
                                  class: "btn btn-outline-primary btn-sm",
                                  title: "Voir les détails" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>

                      <% if complement.status == 'completed' && current_user&.admin? %>
                        <%= link_to request_progress_complement_request_path(complement.request_progress, complement, status: 'approved'),
                                    method: :patch,
                                    class: "btn btn-outline-success btn-sm",
                                    title: "Approuver",
                                    data: {
                                      confirm: "Êtes-vous sûr de vouloir approuver ce complément ?"
                                    } do %>
                          <i class="bi bi-check"></i>
                        <% end %>
                      <% end %>

                      <% if complement.status == 'completed' && current_user&.admin? %>
                        <%= link_to request_progress_complement_request_path(complement.request_progress, complement, status: 'rejected'),
                                    method: :patch,
                                    class: "btn btn-outline-danger btn-sm",
                                    title: "Rejeter",
                                    data: {
                                      confirm: "Êtes-vous sûr de vouloir rejeter ce complément ?"
                                    } do %>
                          <i class="bi bi-x"></i>
                        <% end %>
                      <% end %>

                      <%= link_to request_progress_path(complement.request_progress),
                                  class: "btn btn-outline-info btn-sm",
                                  title: "Voir le dossier" do %>
                        <i class="bi bi-folder"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Pagination si nécessaire -->
        <% if @complement_requests.respond_to?(:total_pages) && @complement_requests.total_pages > 1 %>
          <div class="card-footer">
            <%= paginate @complement_requests %>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-5">
          <i class="bi bi-file-earmark-plus display-1 text-muted"></i>
          <h5 class="mt-3 text-muted">Aucune demande de complément</h5>
          <p class="text-muted">
            <% if params[:status].present? || params[:complement_type].present? || params[:priority].present? %>
              Aucune demande ne correspond aux critères sélectionnés.
            <% else %>
              Toutes les demandes de complément apparaîtront ici.
            <% end %>
          </p>
          <% if params[:status].present? || params[:complement_type].present? || params[:priority].present? %>
            <%= link_to complement_requests_path, class: "btn btn-outline-primary" do %>
              <i class="bi bi-arrow-clockwise me-2"></i>Voir toutes les demandes
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Notifications pour les échéances -->
<% urgent_complements = @complement_requests.where(status: 'pending').where('deadline <= ?', 3.days.from_now) if @complement_requests.respond_to?(:where) %>
<% if urgent_complements&.any? %>
  <div class="position-fixed top-0 end-0 p-3" style="z-index: 1050;">
    <div class="toast show" role="alert">
      <div class="toast-header bg-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong class="me-auto">Échéances proches</strong>
        <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
      </div>
      <div class="toast-body">
        <%= urgent_complements.count %> demande(s) de complément expire(nt) dans les 3 prochains jours.
      </div>
    </div>
  </div>
<% end %>

<script>
// Auto-refresh toutes les 60 secondes pour les demandes urgentes
setInterval(function() {
  const urgentCount = document.querySelectorAll('tbody tr .text-warning, tbody tr .text-danger').length;
  if (urgentCount > 0) {
    // Optionnel : actualisation automatique uniquement s'il y a des demandes urgentes
    // location.reload();
  }
}, 60000);

// Masquer automatiquement les toasts après 10 secondes
setTimeout(function() {
  const toasts = document.querySelectorAll('.toast');
  toasts.forEach(toast => {
    const bsToast = new bootstrap.Toast(toast);
    bsToast.hide();
  });
}, 10000);
</script>
