<%
  set_seo_meta(
    title: "#{@article.title} — Blog Ren0vate",
    description: @article.meta_description.presence || @article.excerpt,
    canonical_url: canonical_url_for(blog_show_path(slug: @article.slug))
  )
%>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">

      <%# Breadcrumb %>
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Blog", blog_index_path %></li>
          <li class="breadcrumb-item"><%= link_to @article.category_label, blog_index_path(category: @article.category) %></li>
          <li class="breadcrumb-item active" aria-current="page"><%= truncate(@article.title, length: 40) %></li>
        </ol>
      </nav>

      <%# Header article %>
      <header class="mb-5">
        <span class="badge rounded-pill mb-3" style="background: var(--ren0vate-accent);">
          <%= @article.category_label %>
        </span>
        <h1 class="fw-bold mb-3" style="color: var(--ren0vate-primary); line-height: 1.3;">
          <%= @article.title %>
        </h1>
        <p class="lead text-muted mb-4"><%= @article.excerpt %></p>
        <div class="d-flex align-items-center gap-3 text-muted" style="font-size: 0.875rem;">
          <span><i class="bi bi-person me-1"></i><%= @article.author %></span>
          <span><i class="bi bi-calendar3 me-1"></i><%= @article.published_at.strftime("%-d %B %Y") %></span>
          <span><i class="bi bi-clock me-1"></i><%= @article.reading_time_minutes %> min</span>
        </div>
      </header>

      <hr class="mb-5">

      <%# Contenu Markdown rendu %>
      <div class="blog-content">
        <%= MarkdownHelper.render(@article.content) %>
      </div>

      <hr class="mt-5 mb-4">

      <%# CTA bas d'article %>
      <div class="card border-0 p-4 text-center" style="background: var(--ren0vate-background); border-radius: 12px;">
        <h3 class="h5 fw-semibold mb-2" style="color: var(--ren0vate-primary);">
          Gérez vos chantiers avec Ren0vate
        </h3>
        <p class="text-muted small mb-3">
          Suivi de chantier, primes, devis, permis — tout en un seul endroit.
        </p>
        <%= link_to "Créer un compte gratuit", new_user_registration_path(locale: I18n.locale),
            class: "btn btn-primary" %>
      </div>

      <%# Navigation articles %>
      <div class="mt-4 text-center">
        <%= link_to "← Tous les articles", blog_index_path, class: "text-muted text-decoration-none small" %>
      </div>

    </div>
  </div>
</div>
