<% content_for :title, "Suivi de demande ##{@request_progress.id}" %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <!-- En-tête -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-1">Suivi de demande #<%= @request_progress.id %></h1>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item">
                <%= link_to "Propriétés", properties_path %>
              </li>
              <% if @request.property %>
              <li class="breadcrumb-item">
                <%= link_to @request.property.address, @request.property %>
              </li>
              <% end %>
              <li class="breadcrumb-item">
                <% if @request.property %>
                  <%= link_to "Demandes", property_requests_path(@request.property) %>
                <% else %>
                  <%= link_to "Demandes", requests_path %>
                <% end %>
              </li>
              <li class="breadcrumb-item">
                <%= link_to "Suivis", request_request_progresses_path(@request) %>
              </li>
              <li class="breadcrumb-item active" aria-current="page">
                Suivi #<%= @request_progress.id %>
              </li>
            </ol>
          </nav>
        </div>
        <div class="btn-group">
          <%= link_to "Modifier", edit_request_progress_path(@request_progress),
                      class: "btn btn-outline-primary" %>
          <%= link_to "Retour", request_request_progresses_path(@request),
                      class: "btn btn-outline-secondary" %>
        </div>
      </div>

      <div class="row">
        <!-- Informations principales -->
        <div class="col-lg-8">
          <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h5 class="mb-0">Détails du suivi</h5>
              <span class="badge bg-<%= @request_progress.status_administratif == 'accorde' ? 'success' :
                                      @request_progress.status_administratif == 'refuse' ? 'danger' :
                                      @request_progress.status_administratif == 'en_cours' ? 'warning' : 'secondary' %> fs-6">
                <%= t("request_progress.status.#{@request_progress.status_administratif}") %>
              </span>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <h6 class="text-muted">Informations de base</h6>
                  <table class="table table-borderless table-sm">
                    <% if @request_progress.form_type.present? %>
                    <tr>
                      <td class="fw-bold">Formulaire :</td>
                      <td>
                        <div class="d-flex align-items-center">
                          <i class="bi bi-file-earmark-text text-primary me-2"></i>
                          <div>
                            <div><%= @request_progress.form_name || @request_progress.form_type.humanize %></div>
                            <small class="text-muted">Type: <%= @request_progress.form_type.humanize %></small>
                          </div>
                        </div>
                      </td>
                    </tr>
                    <% elsif @prime %>
                    <tr>
                      <td class="fw-bold">Prime :</td>
                      <td>
                        <div class="d-flex align-items-center">
                          <i class="bi bi-award text-warning me-2"></i>
                          <%= @prime&.titre || @prime&.name || "Prime non spécifiée" %>
                        </div>
                      </td>
                    </tr>
                    <tr>
                      <td class="fw-bold">Région :</td>
                      <td><%= @prime&.region&.capitalize || "Région non spécifiée" %></td>
                    </tr>
                    <% end %>
                    <tr>
                      <td class="fw-bold">Étape :</td>
                      <td><%= @request_progress.step %></td>
                    </tr>
                    <tr>
                      <td class="fw-bold">Email de suivi :</td>
                      <td>
                        <code><%= @request_progress.email_suivi %></code>
                        <%= link_to "Copier", "#",
                            onclick: "navigator.clipboard.writeText('#{@request_progress.email_suivi}'); this.textContent='Copié!'; setTimeout(() => this.textContent='Copier', 2000);",
                            class: "btn btn-outline-secondary btn-sm ms-2" %>
                      </td>
                    </tr>
                    <% if @request_progress.numero_dossier.present? %>
                      <tr>
                        <td class="fw-bold">N° dossier admin :</td>
                        <td><%= @request_progress.numero_dossier %></td>
                      </tr>
                    <% end %>
                  </table>
                </div>
                <div class="col-md-6">
                  <h6 class="text-muted">Progression</h6>
                  <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                      <span>Avancement</span>
                      <span><%= @request_progress.pourcentage %>%</span>
                    </div>
                    <div class="progress">
                      <div class="progress-bar"
                           role="progressbar"
                           style="width: <%= @request_progress.pourcentage %>%"
                           aria-valuenow="<%= @request_progress.pourcentage %>"
                           aria-valuemin="0"
                           aria-valuemax="100">
                      </div>
                    </div>
                  </div>

                  <table class="table table-borderless table-sm">
                    <% if @request_progress.date_soumission %>
                      <tr>
                        <td class="fw-bold">Date soumission :</td>
                        <td><%= l(@request_progress.date_soumission, format: :long) %></td>
                      </tr>
                      <tr>
                        <td class="fw-bold">Date limite réponse :</td>
                        <td>
                          <% if @request_progress.date_limite_reponse %>
                            <%= l(@request_progress.date_limite_reponse, format: :long) %>
                          <% else %>
                            <em>Non calculable</em>
                          <% end %>
                        </td>
                      </tr>
                      <tr>
                        <td class="fw-bold">Temps restant :</td>
                        <td>
                          <span class="<%= @request_progress.classe_css_delai %>">
                            <%= @request_progress.temps_restant_humanise %>
                          </span>
                          <% if @request_progress.statut_delai == :depasse %>
                            <i class="fas fa-exclamation-triangle ms-1" title="Délai dépassé"></i>
                          <% elsif @request_progress.statut_delai == :urgent %>
                            <i class="fas fa-clock ms-1" title="Urgent"></i>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                    <% if @request_progress.date_derniere_maj %>
                      <tr>
                        <td class="fw-bold">Dernière MAJ :</td>
                        <td><%= l(@request_progress.date_derniere_maj, format: :long) %></td>
                      </tr>
                    <% end %>
                  </table>
                </div>
              </div>

              <% if @request_progress.commentaires_admin.present? %>
                <hr>
                <h6 class="text-muted">Commentaire administratif</h6>
                <div class="alert alert-info">
                  <%= simple_format(@request_progress.commentaires_admin) %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Montants -->
          <div class="card mb-4">
            <div class="card-header">
              <h5 class="mb-0">Montants</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-md-4">
                  <div class="border rounded p-3">
                    <h4 class="text-primary mb-1">
                      <%= number_to_currency(@request_progress.montant_demande || 0, unit: "€", delimiter: ".", separator: ",", format: "%n %u") %>
                    </h4>
                    <small class="text-muted">Montant demandé</small>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="border rounded p-3">
                    <h4 class="text-success mb-1">
                      <%= number_to_currency(@request_progress.montant_accorde || 0, unit: "€", delimiter: ".", separator: ",", format: "%n %u") %>
                    </h4>
                    <small class="text-muted">Montant accordé</small>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="border rounded p-3">
                    <h4 class="text-info mb-1">
                      <%= @request_progress.taux_octroi %>%
                    </h4>
                    <small class="text-muted">Taux d'octroi</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Demandes de complément -->
          <% if @request_progress.complement_requests.any? %>
            <div class="card mb-4">
              <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                  <i class="bi bi-clipboard-plus me-2"></i>Demandes de complément
                </h5>
                <% if current_user.can_access_admin? %>
                  <%= link_to new_request_progress_complement_request_path(@request_progress),
                              class: "btn btn-sm btn-outline-primary" do %>
                    <i class="bi bi-plus"></i> Nouvelle demande
                  <% end %>
                <% end %>
              </div>
              <div class="card-body">
                <% @request_progress.complement_requests.order(created_at: :desc).limit(3).each do |complement| %>
                  <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <div>
                        <h6 class="mb-1">
                          <span class="badge bg-<%= complement.pending? ? 'warning' :
                                                     complement.completed? ? 'success' :
                                                     complement.expired? ? 'danger' : 'secondary' %> me-2">
                            <%= complement.status.humanize %>
                          </span>
                          <%= complement.complement_type.humanize %>
                        </h6>
                        <small class="text-muted">
                          Créé le <%= complement.created_at.strftime("%d/%m/%Y") %> •
                          Échéance : <%= complement.deadline.strftime("%d/%m/%Y") %>
                          <% if complement.days_remaining > 0 %>
                            (<%= complement.days_remaining %> jours restants)
                          <% elsif complement.expired? %>
                            (Expiré)
                          <% end %>
                        </small>
                      </div>
                      <%= link_to complement, class: "btn btn-sm btn-outline-primary" do %>
                        <i class="bi bi-eye"></i>
                      <% end %>
                    </div>

                    <div class="mb-2">
                      <strong>Message administratif :</strong>
                      <p class="mb-0 text-muted"><%= truncate(complement.admin_message, length: 150) %></p>
                    </div>

                    <% if complement.client_response.present? %>
                      <div class="bg-light-subtle rounded p-2">
                        <strong>Réponse du client :</strong>
                        <p class="mb-0 small"><%= truncate(complement.client_response, length: 100) %></p>
                      </div>
                    <% end %>

                    <% if complement.response_documents.any? %>
                      <div class="mt-2">
                        <small class="text-muted">
                          <i class="bi bi-paperclip me-1"></i>
                          <%= complement.response_documents.count %> document(s) fourni(s)
                        </small>
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <% if @request_progress.complement_requests.count > 3 %>
                  <div class="text-center">
                    <%= link_to request_progress_complement_requests_path(@request_progress),
                                class: "btn btn-outline-secondary btn-sm" do %>
                      <i class="bi bi-list me-1"></i>Voir tous les compléments (<%= @request_progress.complement_requests.count %>)
                    <% end %>
                  </div>
                <% end %>

                <% if @request_progress.has_pending_complements? %>
                  <div class="alert alert-warning mt-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Action requise :</strong> Des compléments d'information sont en attente de votre réponse.
                  </div>
                <% end %>
              </div>
            </div>
          <% else %>
            <% if current_user.can_access_admin? %>
              <div class="card mb-4">
                <div class="card-body text-center py-4">
                  <i class="bi bi-clipboard-plus display-5 text-muted mb-3"></i>
                  <h6 class="text-muted mb-3">Aucune demande de complément</h6>
                  <p class="text-muted mb-3">Créez une demande si des informations supplémentaires sont nécessaires.</p>
                  <%= link_to new_request_progress_complement_request_path(@request_progress),
                              class: "btn btn-outline-primary" do %>
                    <i class="bi bi-plus me-2"></i>Créer une demande de complément
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <!-- Documents -->
          <div class="card">
            <div class="card-header">
              <h5 class="mb-0">Documents de suivi</h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <h6>Document PDF administratif</h6>
                  <% if @request_progress.document_suivi_pdf.attached? %>
                    <div class="d-flex align-items-center">
                      <i class="fas fa-file-pdf text-danger me-2"></i>
                      <%= link_to @request_progress.document_suivi_pdf.filename,
                                  @request_progress.document_suivi_pdf,
                                  target: "_blank",
                                  class: "text-decoration-none" %>
                      <small class="text-muted ms-2">
                        (<%= number_to_human_size(@request_progress.document_suivi_pdf.byte_size) %>)
                      </small>
                    </div>
                  <% else %>
                    <p class="text-muted">Aucun document PDF</p>
                    <%= form_with model: @request_progress,
                                  url: upload_document_request_progress_path(@request_progress),
                                  method: :patch,
                                  local: true,
                                  multipart: true,
                                  class: "mt-2" do |form| %>
                      <%= form.hidden_field :document_type, value: 'suivi_pdf' %>
                      <div class="input-group">
                        <%= form.file_field :document_suivi_pdf,
                                            accept: ".pdf",
                                            class: "form-control form-control-sm" %>
                        <%= form.submit "Uploader", class: "btn btn-outline-primary btn-sm" %>
                      </div>
                    <% end %>
                  <% end %>
                </div>
                <div class="col-md-6">
                  <h6>Photo du courrier</h6>
                  <% if @request_progress.document_suivi_photo.attached? %>
                    <div class="d-flex align-items-center">
                      <i class="fas fa-image text-primary me-2"></i>
                      <%= link_to @request_progress.document_suivi_photo.filename,
                                  @request_progress.document_suivi_photo,
                                  target: "_blank",
                                  class: "text-decoration-none" %>
                      <small class="text-muted ms-2">
                        (<%= number_to_human_size(@request_progress.document_suivi_photo.byte_size) %>)
                      </small>
                    </div>
                  <% else %>
                    <p class="text-muted">Aucune photo</p>
                    <%= form_with model: @request_progress,
                                  url: upload_document_request_progress_path(@request_progress),
                                  method: :patch,
                                  local: true,
                                  multipart: true,
                                  class: "mt-2" do |form| %>
                      <%= form.hidden_field :document_type, value: 'suivi_photo' %>
                      <div class="input-group">
                        <%= form.file_field :document_suivi_photo,
                                            accept: "image/*",
                                            class: "form-control form-control-sm" %>
                        <%= form.submit "Uploader", class: "btn btn-outline-primary btn-sm" %>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
          <!-- Informations de la demande -->
          <div class="card mb-4">
            <div class="card-header">
              <h6 class="mb-0">Demande associée</h6>
            </div>
            <div class="card-body">
              <p class="mb-2">
                <strong>Propriété :</strong><br>
                <% if @request.property %>
                  <%= @request.property.address %>
                <% else %>
                  <em>Aucune propriété associée</em>
                <% end %>
              </p>
              <% if @request.project %>
                <p class="mb-2">
                  <strong>Projet :</strong><br>
                  <%= @request.project.nom %>
                </p>
              <% end %>
              <div class="d-grid">
                <%= link_to "Voir la demande", @request, class: "btn btn-outline-primary btn-sm" %>
              </div>
            </div>
          </div>

          <!-- Actions rapides -->
          <div class="card">
            <div class="card-header">
              <h6 class="mb-0">Actions rapides</h6>
            </div>
            <div class="card-body">
              <div class="d-grid gap-2">
                <%= link_to "Modifier le suivi",
                            edit_request_progress_path(@request_progress),
                            class: "btn btn-outline-primary btn-sm" %>

                <% if @request_progress.en_attente? %>
                  <%= form_with model: @request_progress,
                                local: true,
                                class: "d-grid" do |form| %>
                    <%= form.hidden_field :status_administratif, value: 'complet' %>
                    <%= form.submit "Marquer comme complet",
                                    class: "btn btn-outline-success btn-sm",
                                    data: { confirm: "Êtes-vous sûr ?" } %>
                  <% end %>
                <% end %>

                <%= link_to "Supprimer",
                            @request_progress,
                            method: :delete,
                            data: { confirm: "Êtes-vous sûr de vouloir supprimer ce suivi ?" },
                            class: "btn btn-outline-danger btn-sm" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
