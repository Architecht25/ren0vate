<% content_for :title, "Nouveau suivi de demande" %>

<div class="container-fluid px-4 py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
          <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouveau suivi</h1>
          <% if @request&.property %>
            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i><%= @request.property.address %></small>
          <% end %>
        </div>
        <%= link_to @request ? request_request_progresses_path(@request) : request_progresses_path,
              class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-arrow-left me-1"></i>Retour
        <% end %>
      </div>

      <%= render 'shared/expert_subsides_banner' %>

      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

          <%= form_with model: @request ? [@request, @request_progress] : @request_progress, local: true do |form| %>
            <% if @request_progress.errors.any? %>
              <div class="alert alert-danger py-2 mb-3">
                <ul class="mb-0 small">
                  <% @request_progress.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%# Sélection demande (si pas de @request) %>
            <% unless @request %>
              <div class="mb-3">
                <%= form.label :request_id, "Demande associée", class: "form-label small fw-semibold" %>
                <%= form.select :request_id,
                                options_from_collection_for_select(@user_requests, :id,
                                  ->(r) { "#{r.property&.name || 'Bien non spécifié'} — #{r.project&.nom || r.title || 'Projet non défini'}" },
                                  @request_progress.request_id),
                                { prompt: "Sélectionnez une demande" },
                                { class: "form-select form-select-sm", required: true } %>
              </div>
            <% end %>

            <%# Ligne 1 : Type formulaire + Date soumission %>
            <div class="row g-3 mb-3">
              <div class="col-md-8">
                <%= form.label :form_type, "Type de formulaire", class: "form-label small fw-semibold" %>
                <%= form.select :form_type,
                                options_for_select(@available_forms.map { |f| [f[:name], f[:id]] }, @request_progress.form_type),
                                { prompt: "Sélectionnez un formulaire" },
                                { class: "form-select form-select-sm", required: true } %>
              </div>
              <div class="col-md-4">
                <%= form.label :date_soumission, "Date de soumission", class: "form-label small fw-semibold" %>
                <%= form.date_field :date_soumission,
                                    class: "form-control form-control-sm",
                                    value: @request_progress.date_soumission || Date.current %>
              </div>
            </div>

            <%# Ligne 2 : Nom du suivi + N° dossier %>
            <div class="row g-3 mb-3">
              <div class="col-md-8">
                <%= form.label :form_name, "Nom du suivi", class: "form-label small fw-semibold" %>
                <%= form.text_field :form_name,
                                    class: "form-control form-control-sm",
                                    placeholder: "ex : Rénovation toiture 2026",
                                    required: true %>
              </div>
              <div class="col-md-4">
                <%= form.label :numero_dossier, "N° de dossier", class: "form-label small fw-semibold" %>
                <%= form.text_field :numero_dossier,
                                    class: "form-control form-control-sm",
                                    placeholder: "ex : 2026/12345" %>
              </div>
            </div>

            <%# Ligne 3 : Étape + Montants %>
            <div class="row g-3 mb-3">
              <div class="col-md-4">
                <%= form.label :step, "Étape", class: "form-label small fw-semibold" %>
                <%= form.text_field :step,
                                    class: "form-control form-control-sm",
                                    placeholder: "ex : Dépôt initial" %>
              </div>
              <div class="col-md-4">
                <%= form.label :montant_demande, "Montant demandé", class: "form-label small fw-semibold" %>
                <div class="input-group input-group-sm">
                  <span class="input-group-text">€</span>
                  <%= form.number_field :montant_demande,
                                        class: "form-control",
                                        min: 0, step: 1,
                                        placeholder: "0" %>
                </div>
              </div>
              <div class="col-md-4">
                <%= form.label :montant_accorde, "Montant accordé", class: "form-label small fw-semibold" %>
                <div class="input-group input-group-sm">
                  <span class="input-group-text">€</span>
                  <%= form.number_field :montant_accorde,
                                        class: "form-control",
                                        min: 0, step: 1,
                                        placeholder: "—" %>
                </div>
              </div>
            </div>

            <%# Notes %>
            <div class="mb-3">
              <%= form.label :commentaires_admin, "Notes / observations", class: "form-label small fw-semibold" %>
              <%= form.text_area :commentaires_admin,
                                 class: "form-control form-control-sm",
                                 rows: 2,
                                 placeholder: "Commentaires, remarques, conditions…" %>
            </div>

            <%# Documents %>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :document_suivi_pdf, "Document PDF", class: "form-label small fw-semibold" %>
                <%= form.file_field :document_suivi_pdf,
                                    class: "form-control form-control-sm",
                                    accept: ".pdf" %>
                <div class="form-text" style="font-size:0.72rem;">PDF reçu de l'administration</div>
              </div>
              <div class="col-md-6">
                <%= form.label :document_suivi_photo, "Photo du courrier", class: "form-label small fw-semibold" %>
                <%= form.file_field :document_suivi_photo,
                                    class: "form-control form-control-sm",
                                    accept: "image/*" %>
                <div class="form-text" style="font-size:0.72rem;">Photo du courrier papier</div>
              </div>
            </div>

            <%# Checkbox document reçu %>
            <div class="mb-4">
              <div class="form-check">
                <%= form.check_box :document_recu, class: "form-check-input" %>
                <%= form.label :document_recu, "Document de suivi reçu", class: "form-check-label small" %>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
              <%= link_to "Annuler",
                    @request ? request_request_progresses_path(@request) : request_progresses_path,
                    class: "btn btn-outline-secondary btn-sm" %>
              <%= form.submit "Créer le suivi", class: "btn btn-primary-custom btn-sm px-4" %>
            </div>

          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
