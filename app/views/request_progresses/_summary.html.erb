<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h6 class="mb-0">
      <i class="bi bi-clipboard-check me-2"></i>Suivis de demandes
    </h6>
    <%= link_to "Voir tous", request_request_progresses_path(request),
                class: "btn btn-outline-primary btn-sm" %>
  </div>
  <div class="card-body">
    <% if request.request_progresses.any? %>
      <% request.request_progresses.includes(:prime).limit(3).each do |progress| %>
        <div class="d-flex justify-content-between align-items-center py-2 <%= 'border-bottom' unless progress == request.request_progresses.limit(3).last %>">
          <div>
            <div class="fw-bold small">
              <%= progress.prime&.titre || "Prime non spécifiée" %>
            </div>
            <div class="text-muted small">
              <%= t("request_progress.status.#{progress.status_administratif}") %>
              <% if progress.pourcentage > 0 %>
                - <%= progress.pourcentage %>%
              <% end %>
            </div>
          </div>
          <div class="text-end">
            <span class="badge bg-<%= progress.status_administratif == 'accorde' ? 'success' :
                                    progress.status_administratif == 'refuse' ? 'danger' :
                                    progress.status_administratif == 'en_cours' ? 'warning' : 'secondary' %>">
              <%= progress.status_administratif.humanize %>
            </span>
            <% if progress.montant_accorde&.positive? %>
              <div class="small text-success mt-1">
                <%= number_to_currency(progress.montant_accorde) %>
              </div>
            <% elsif progress.montant_demande&.positive? %>
              <div class="small text-muted mt-1">
                <%= number_to_currency(progress.montant_demande) %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if request.request_progresses.count > 3 %>
        <div class="text-center mt-3">
          <small class="text-muted">
            ... et <%= request.request_progresses.count - 3 %> autre(s) suivi(s)
          </small>
        </div>
      <% end %>
    <% else %>
      <div class="text-center text-muted py-3">
        <i class="bi bi-clipboard me-2"></i>
        Aucun suivi créé
        <div class="mt-2">
          <%= link_to "Créer un suivi", new_request_request_progress_path(request),
                      class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
