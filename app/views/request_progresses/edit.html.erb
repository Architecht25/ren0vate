<% content_for :title, "Modifier le suivi" %>

<div class="container-fluid px-4 py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <!-- Header -->
      <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
          <h1 class="h3 text-primary-custom mb-0 fw-normal">Modifier le suivi</h1>
          <small class="text-muted">
            <% if @request.property %>
              <i class="bi bi-geo-alt me-1"></i><%= @request.property.address %>
            <% end %>
            <% if @request_progress.form_type.present? %>
              &nbsp;·&nbsp;<%= @request_progress.form_type.humanize %>
            <% end %>
          </small>
        </div>
        <%= link_to @request_progress, class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-arrow-left me-1"></i>Retour
        <% end %>
      </div>

      <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

          <%= form_with model: @request_progress, local: true do |form| %>
            <% if @request_progress.errors.any? %>
              <div class="alert alert-danger py-2 mb-3">
                <ul class="mb-0 small">
                  <% @request_progress.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <%# Type de suivi : formulaire ou prime individuelle %>
            <div class="mb-3 p-3 rounded-3 border bg-light">
              <p class="small fw-semibold mb-2">Type de suivi</p>
              <div class="d-flex gap-4">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="suivi_type" id="suivi_formulaire" value="formulaire"
                         <%= @request_progress.form_type.present? ? 'checked' : '' %>>
                  <label class="form-check-label small" for="suivi_formulaire">
                    Formulaire de primes <span class="text-muted">(recommandé)</span>
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="suivi_type" id="suivi_prime" value="prime"
                         <%= @request_progress.prime_id.present? ? 'checked' : '' %>>
                  <label class="form-check-label small" for="suivi_prime">Prime individuelle</label>
                </div>
              </div>
            </div>

            <%# Section formulaire %>
            <div id="formulaire_section" style="<%= @request_progress.form_type.present? ? '' : 'display:none;' %>">
              <div class="row g-3 mb-3">
                <div class="col-md-6">
                  <%= form.label :form_type, "Formulaire", class: "form-label small fw-semibold" %>
                  <%= form.select :form_type,
                                  options_for_select(@available_forms.map { |f| [f[:name], f[:id]] }, @request_progress.form_type),
                                  { prompt: "Sélectionnez un formulaire" },
                                  { class: "form-select form-select-sm", id: "form_type_select" } %>
                </div>
                <div class="col-md-6">
                  <%= form.label :form_name, "Nom du suivi", class: "form-label small fw-semibold" %>
                  <%= form.text_field :form_name,
                                      class: "form-control form-control-sm",
                                      placeholder: "ex : Rénovation complète 2026",
                                      id: "form_name_input" %>
                </div>
              </div>
            </div>

            <%# Section prime individuelle %>
            <div id="prime_section" class="mb-3" style="<%= @request_progress.prime_id.present? ? '' : 'display:none;' %>">
              <%= form.label :prime_id, "Prime", class: "form-label small fw-semibold" %>
              <%= form.select :prime_id,
                              options_from_collection_for_select(@primes, :id, :titre, @request_progress.prime_id),
                              { prompt: "Sélectionnez une prime" },
                              { class: "form-select form-select-sm" } %>
            </div>

            <%# Ligne : Date soumission + N° dossier %>
            <div class="row g-3 mb-3">
              <div class="col-md-4">
                <%= form.label :date_soumission, "Date de soumission", class: "form-label small fw-semibold" %>
                <%= form.date_field :date_soumission, class: "form-control form-control-sm" %>
              </div>
              <div class="col-md-4">
                <%= form.label :numero_dossier, "N° de dossier", class: "form-label small fw-semibold" %>
                <%= form.text_field :numero_dossier,
                                    class: "form-control form-control-sm",
                                    placeholder: "ex : 2026/12345" %>
              </div>
              <div class="col-md-4">
                <%= form.label :step, "Étape", class: "form-label small fw-semibold" %>
                <%= form.text_field :step,
                                    class: "form-control form-control-sm",
                                    placeholder: "ex : Instruction" %>
              </div>
            </div>

            <%# Montants %>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :montant_demande, "Montant demandé", class: "form-label small fw-semibold" %>
                <div class="input-group input-group-sm">
                  <span class="input-group-text">€</span>
                  <%= form.number_field :montant_demande, class: "form-control", min: 0, step: 1, placeholder: "0" %>
                </div>
              </div>
              <div class="col-md-6">
                <%= form.label :montant_accorde, "Montant accordé", class: "form-label small fw-semibold" %>
                <div class="input-group input-group-sm">
                  <span class="input-group-text">€</span>
                  <%= form.number_field :montant_accorde, class: "form-control", min: 0, step: 1, placeholder: "—" %>
                </div>
              </div>
            </div>

            <%# Notes %>
            <div class="mb-3">
              <%= form.label :commentaires_admin, "Notes / observations", class: "form-label small fw-semibold" %>
              <%= form.text_area :commentaires_admin,
                                 class: "form-control form-control-sm",
                                 rows: 2,
                                 placeholder: "Commentaires, remarques, conditions…" %>
            </div>

            <%# Documents %>
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= form.label :document_suivi_pdf, "Document PDF", class: "form-label small fw-semibold" %>
                <% if @request_progress.document_suivi_pdf.attached? %>
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-file-earmark-pdf text-danger"></i>
                    <%= link_to @request_progress.document_suivi_pdf.filename,
                                rails_blob_path(@request_progress.document_suivi_pdf, disposition: :attachment),
                                target: "_blank", class: "small text-truncate" %>
                  </div>
                <% end %>
                <%= form.file_field :document_suivi_pdf, class: "form-control form-control-sm", accept: ".pdf" %>
                <div class="form-text" style="font-size:0.72rem;">Laisser vide pour conserver</div>
              </div>
              <div class="col-md-6">
                <%= form.label :document_suivi_photo, "Photo du courrier", class: "form-label small fw-semibold" %>
                <% if @request_progress.document_suivi_photo.attached? %>
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-image text-primary"></i>
                    <%= link_to @request_progress.document_suivi_photo.filename,
                                rails_blob_path(@request_progress.document_suivi_photo, disposition: :attachment),
                                target: "_blank", class: "small text-truncate" %>
                  </div>
                <% end %>
                <%= form.file_field :document_suivi_photo, class: "form-control form-control-sm", accept: "image/*" %>
                <div class="form-text" style="font-size:0.72rem;">Laisser vide pour conserver</div>
              </div>
            </div>

            <%# Checkbox %>
            <div class="mb-3">
              <div class="form-check">
                <%= form.check_box :document_recu, class: "form-check-input" %>
                <%= form.label :document_recu, "Document de suivi reçu", class: "form-check-label small" %>
              </div>
            </div>

            <%# Méta-infos discrètes %>
            <div class="text-muted mb-4" style="font-size:0.75rem;">
              <i class="bi bi-clock me-1"></i>Créé le <%= l(@request_progress.created_at, format: :short) %>
              <% if @request_progress.date_derniere_maj %>
                &nbsp;·&nbsp;Mis à jour le <%= l(@request_progress.date_derniere_maj, format: :short) %>
              <% end %>
              <% if @request_progress.email_suivi.present? %>
                &nbsp;·&nbsp;<i class="bi bi-envelope me-1"></i><code style="font-size:0.7rem;"><%= @request_progress.email_suivi %></code>
              <% end %>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
              <%= link_to "Annuler", @request_progress, class: "btn btn-outline-secondary btn-sm" %>
              <%= form.submit "Enregistrer", class: "btn btn-primary-custom btn-sm px-4" %>
            </div>

          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('DOMContentLoaded', function() {
  const radioFormulaire = document.getElementById('suivi_formulaire');
  const radioPrime      = document.getElementById('suivi_prime');
  const formulaireSection = document.getElementById('formulaire_section');
  const primeSection      = document.getElementById('prime_section');
  if (!radioFormulaire) return;

  function toggle() {
    const isFormulaire = radioFormulaire.checked;
    formulaireSection.style.display = isFormulaire ? 'block' : 'none';
    primeSection.style.display      = isFormulaire ? 'none'  : 'block';
    if (isFormulaire) {
      const sel = document.getElementById('request_progress_prime_id');
      if (sel) sel.value = '';
    } else {
      const fts = document.getElementById('form_type_select');
      const fni = document.getElementById('form_name_input');
      if (fts) fts.value = '';
      if (fni) fni.value = '';
    }
  }

  radioFormulaire.addEventListener('change', toggle);
  radioPrime.addEventListener('change', toggle);
});
</script>
