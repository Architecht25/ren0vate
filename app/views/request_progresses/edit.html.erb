<% content_for :title, "Modifier le suivi" %>

<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card">
        <div class="card-header">
          <h4 class="mb-0">Modifier le suivi #<%= @request_progress.id %></h4>
          <p class="text-muted mb-0">
            Demande pour :
            <% if @request.property %>
              <%= @request.property.address %>
            <% else %>
              <em>Aucune propriété associée</em>
            <% end %> -
            <% if @request_progress.prime %>
              Prime : <%= @request_progress.prime&.titre || @request_progress.prime&.name || "Prime non spécifiée" %>
            <% elsif @request_progress.form_type.present? %>
              Formulaire : <%= @request_progress.form_type.humanize %>
            <% else %>
              <em>Type non défini</em>
            <% end %>
          </p>
        </div>
        <div class="card-body">
          <%= form_with model: @request_progress, local: true do |form| %>
            <% if @request_progress.errors.any? %>
              <div class="alert alert-danger">
                <h6>Erreurs détectées :</h6>
                <ul class="mb-0">
                  <% @request_progress.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row">
              <!-- Sélection du type de suivi -->
              <div class="col-12">
                <div class="mb-3">
                  <label class="form-label">Type de suivi</label>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="suivi_type" id="suivi_formulaire" value="formulaire" <%= @request_progress.form_type.present? ? 'checked' : '' %>>
                    <label class="form-check-label" for="suivi_formulaire">
                      <strong>Formulaire de primes</strong> <small class="text-muted">(recommandé)</small>
                    </label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="suivi_type" id="suivi_prime" value="prime" <%= @request_progress.prime_id.present? ? 'checked' : '' %>>
                    <label class="form-check-label" for="suivi_prime">
                      Prime individuelle
                    </label>
                  </div>
                </div>
              </div>

              <!-- Sélection du formulaire -->
              <div class="col-12" id="formulaire_section" style="<%= @request_progress.form_type.present? ? '' : 'display: none;' %>">
                <div class="row">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :form_type, "Formulaire de primes", class: "form-label" %>
                      <%= form.select :form_type,
                                      options_for_select(@available_forms.map { |f| [f[:name], f[:id]] }, @request_progress.form_type),
                                      { prompt: "Sélectionnez un formulaire" },
                                      { class: "form-select", id: "form_type_select" } %>
                      <div class="form-text">
                        Choisissez le type de formulaire qui regroupe plusieurs primes.
                      </div>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :form_name, "Nom du formulaire", class: "form-label" %>
                      <%= form.text_field :form_name,
                                          class: "form-control",
                                          placeholder: "Ex: Rénovation complète 2024",
                                          id: "form_name_input" %>
                      <div class="form-text">
                        Donnez un nom personnalisé à ce formulaire pour le retrouver facilement.
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Sélection de prime individuelle -->
              <div class="col-md-6" id="prime_section" style="<%= @request_progress.prime_id.present? ? '' : 'display: none;' %>">
                <div class="mb-3">
                  <%= form.label :prime_id, "Prime", class: "form-label" %>
                  <%= form.select :prime_id,
                                  options_from_collection_for_select(@primes, :id, :titre, @request_progress.prime_id),
                                  { prompt: "Sélectionnez une prime" },
                                  { class: "form-select" } %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :status_administratif, "Statut administratif", class: "form-label" %>
                  <%= form.select :status_administratif,
                                  options_from_collection_for_select(
                                    RequestProgress.status_administratifs.keys.map { |k| [k, t("request_progress.status.#{k}")] },
                                    :first, :second, @request_progress.status_administratif
                                  ),
                                  { prompt: "Sélectionnez un statut" },
                                  { class: "form-select", required: true } %>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :step, "Étape", class: "form-label" %>
                  <%= form.text_field :step,
                                      class: "form-control",
                                      placeholder: "Ex: Dépôt initial, Instruction, Décision..." %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :pourcentage, "Pourcentage d'avancement", class: "form-label" %>
                  <div class="input-group">
                    <%= form.number_field :pourcentage,
                                          class: "form-control",
                                          min: 0,
                                          max: 100,
                                          step: 5 %>
                    <span class="input-group-text">%</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :montant_demande, "Montant demandé", class: "form-label" %>
                  <div class="input-group">
                    <span class="input-group-text">€</span>
                    <%= form.number_field :montant_demande,
                                          class: "form-control",
                                          min: 0,
                                          step: 0.01,
                                          placeholder: "0.00" %>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :montant_accorde, "Montant accordé", class: "form-label" %>
                  <div class="input-group">
                    <span class="input-group-text">€</span>
                    <%= form.number_field :montant_accorde,
                                          class: "form-control",
                                          min: 0,
                                          step: 0.01,
                                          placeholder: "0.00" %>
                  </div>
                  <div class="form-text">Laisser vide si pas encore connu</div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :date_soumission, "Date de soumission", class: "form-label" %>
                  <%= form.date_field :date_soumission, class: "form-control" %>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :numero_dossier, "N° de dossier administratif", class: "form-label" %>
                  <%= form.text_field :numero_dossier,
                                      class: "form-control",
                                      placeholder: "Ex: 2024/12345" %>
                  <div class="form-text">Optionnel - à remplir quand reçu de l'administration</div>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <%= form.label :commentaires_admin, "Commentaire administratif", class: "form-label" %>
              <%= form.text_area :commentaires_admin,
                                 class: "form-control",
                                 rows: 4,
                                 placeholder: "Commentaires, observations, notes..." %>
            </div>

            <div class="mb-3">
              <div class="form-check">
                <%= form.check_box :document_recu, class: "form-check-input" %>
                <%= form.label :document_recu, "Document de suivi reçu", class: "form-check-label" %>
              </div>
            </div>

            <!-- Affichage des documents existants -->
            <div class="row mb-4">
              <div class="col-md-6">
                <h6>Document PDF actuel</h6>
                <% if @request_progress.document_suivi_pdf.attached? %>
                  <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-file-pdf text-danger me-2"></i>
                    <%= link_to @request_progress.document_suivi_pdf.filename,
                                @request_progress.document_suivi_pdf,
                                target: "_blank",
                                class: "text-decoration-none" %>
                  </div>
                <% end %>
                <%= form.label :document_suivi_pdf, "Nouveau document PDF", class: "form-label" %>
                <%= form.file_field :document_suivi_pdf,
                                    class: "form-control",
                                    accept: ".pdf" %>
                <div class="form-text">Laissez vide pour conserver le document actuel</div>
              </div>
              <div class="col-md-6">
                <h6>Photo actuelle</h6>
                <% if @request_progress.document_suivi_photo.attached? %>
                  <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-image text-primary me-2"></i>
                    <%= link_to @request_progress.document_suivi_photo.filename,
                                @request_progress.document_suivi_photo,
                                target: "_blank",
                                class: "text-decoration-none" %>
                  </div>
                <% end %>
                <%= form.label :document_suivi_photo, "Nouvelle photo", class: "form-label" %>
                <%= form.file_field :document_suivi_photo,
                                    class: "form-control",
                                    accept: "image/*" %>
                <div class="form-text">Laissez vide pour conserver la photo actuelle</div>
              </div>
            </div>

            <!-- Informations de suivi automatique -->
            <div class="alert alert-info">
              <h6><i class="fas fa-info-circle"></i> Informations de suivi</h6>
              <p class="mb-1"><strong>Email de suivi :</strong> <code><%= @request_progress.email_suivi %></code></p>
              <p class="mb-1"><strong>Créé le :</strong> <%= l(@request_progress.created_at, format: :long) %></p>
              <% if @request_progress.date_derniere_maj %>
                <p class="mb-0"><strong>Dernière modification :</strong> <%= l(@request_progress.date_derniere_maj, format: :long) %></p>
              <% end %>
            </div>

            <hr>

            <div class="d-flex justify-content-between">
              <%= link_to "Annuler",
                          @request_progress,
                          class: "btn btn-outline-secondary" %>
              <%= form.submit "Mettre à jour",
                              class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
// Gestion du type de suivi (formulaire vs prime)
document.addEventListener('DOMContentLoaded', function() {
  const suiviFormulaireRadio = document.getElementById('suivi_formulaire');
  const suiviPrimeRadio = document.getElementById('suivi_prime');
  const formulaireSection = document.getElementById('formulaire_section');
  const primeSection = document.getElementById('prime_section');

  function toggleSections() {
    if (suiviFormulaireRadio.checked) {
      formulaireSection.style.display = 'block';
      primeSection.style.display = 'none';
      // Vider les champs prime
      const primeSelect = document.getElementById('request_progress_prime_id');
      if (primeSelect) primeSelect.value = '';
    } else if (suiviPrimeRadio.checked) {
      formulaireSection.style.display = 'none';
      primeSection.style.display = 'block';
      // Vider les champs formulaire
      const formTypeSelect = document.getElementById('form_type_select');
      const formNameInput = document.getElementById('form_name_input');
      if (formTypeSelect) formTypeSelect.value = '';
      if (formNameInput) formNameInput.value = '';
    }
  }

  suiviFormulaireRadio.addEventListener('change', toggleSections);
  suiviPrimeRadio.addEventListener('change', toggleSections);
});

// Auto-calcul du pourcentage basé sur le statut
document.getElementById('request_progress_status_administratif').addEventListener('change', function() {
  const status = this.value;
  const pourcentageField = document.getElementById('request_progress_pourcentage');

  const statusPercentages = {
    'en_preparation': 10,
    'soumis': 25,
    'en_cours': 50,
    'complet': 75,
    'incomplet': 40,
    'accorde': 100,
    'refuse': 100,
    'annule': 0
  };

  if (statusPercentages[status] !== undefined && pourcentageField.value == '') {
    pourcentageField.value = statusPercentages[status];
  }
});
</script>
