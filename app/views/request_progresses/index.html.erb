<% content_for :title, t('request_progress.index_title') %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
          <%= t('request_progress.index_title') %>
          <% if @request && @request.property %>
            - <%= @request.property.address %>
          <% end %>
        </h1>

        <div class="d-flex align-items-center gap-2">
          <% if @property %>
            <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary" do %>
              <i class="bi bi-arrow-left me-1"></i>Dashboard bien
            <% end %>
          <% end %>
          <%= link_to properties_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-arrow-left me-1"></i>Mes biens
          <% end %>
          <% if @request %>
            <%= link_to t('request_progress.new'),
                        new_request_request_progress_path(@request),
                        class: "btn btn-primary" %>
          <% else %>
            <%= link_to new_request_progress_path, class: "btn btn-primary" do %>
              <i class="bi bi-plus-lg me-2"></i><%= t('request_progress.new') %>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Statistiques -->
      <div class="row mb-4">
        <div class="col-md-2">
          <div class="card text-center h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <h5 class="card-title text-primary"><%= @stats[:total] %></h5>
              <p class="card-text small">Total</p>
            </div>
          </div>
        </div>
        <div class="col-md-2">
          <div class="card text-center h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <h5 class="card-title text-warning"><%= @stats[:en_attente] %></h5>
              <p class="card-text small">En attente</p>
            </div>
          </div>
        </div>
        <div class="col-md-2">
          <div class="card text-center h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <h5 class="card-title text-success"><%= @stats[:accordees] %></h5>
              <p class="card-text small">Accordées</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <h5 class="card-title text-info"><%= number_to_currency(@stats[:montant_total_demande], unit: "€", precision: 0, delimiter: ".", format: "%n %u") %></h5>
              <p class="card-text small">Montant demandé</p>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card text-center h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <h5 class="card-title text-success"><%= number_to_currency(@stats[:montant_total_accorde], unit: "€", precision: 0, delimiter: ".", format: "%n %u") %></h5>
              <p class="card-text small">Montant accordé</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Statistiques de délais -->
      <div class="row mb-4">
        <div class="col-md-2">
          <div class="card text-center border-danger h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <h5 class="card-title text-danger">
                <i class="fas fa-exclamation-triangle me-1"></i>
                <%= @stats[:delais_depasses] %>
              </h5>
              <p class="card-text small">Délais dépassés</p>
            </div>
          </div>
        </div>
        <div class="col-md-2">
          <div class="card text-center border-warning h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <h5 class="card-title text-warning">
                <i class="fas fa-clock me-1"></i>
                <%= @stats[:delais_urgents] %>
              </h5>
              <p class="card-text small">Délais urgents</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100">
            <div class="card-body d-flex flex-column justify-content-center">
              <h6 class="card-title">Délais moyen de réponse de l'administration</h6>
              <div class="row text-center">
                <div class="col">
                  <strong>Flandre</strong><br>
                  <span class="text-muted">5 mois</span>
                </div>
                <div class="col">
                  <strong>Bruxelles</strong><br>
                  <span class="text-muted">4 mois</span>
                </div>
                <div class="col">
                  <strong>Wallonie</strong><br>
                  <span class="text-muted">18 mois</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card h-100 border-info">
            <div class="card-body d-flex flex-column justify-content-center">
              <h6 class="card-title text-info">
                <i class="fas fa-info-circle me-1"></i>
                Délais officiels Wallonie
              </h6>
              <p class="small mb-0">
                Vous pouvez consulter nos délais de traitement en cliquant sur le lien suivant :
                <a href="https://logement.wallonie.be/fr/page/aides-liees-a-la-realisation-de-travaux-de-renovation-et-economies-d-energie#delais"
                   target="_blank" class="text-info fw-bold">
                  délais officiels
                  <i class="fas fa-external-link-alt ms-1"></i>
                </a>
                <span class="text-muted">(mis à jour tous les mois)</span>
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Filtres -->
      <div class="card mb-4">
        <div class="card-body">
          <%= form_with url: request.path, method: :get, local: true, class: "row g-3" do |form| %>
            <div class="col-md-3">
              <%= form.select :status,
                              options_from_collection_for_select(
                                RequestProgress.status_administratifs.keys.map { |k| [k, t("request_progress.status.#{k}")] },
                                :first, :second, params[:status]
                              ),
                              { prompt: "Tous les statuts" },
                              { class: "form-select" } %>
            </div>
            <div class="col-md-3">
              <%= form.select :region,
                              options_for_select([
                                ['Wallonie', 'wallonie'],
                                ['Bruxelles', 'bruxelles'],
                                ['Flandre', 'flandre']
                              ], params[:region]),
                              { prompt: "Toutes les régions" },
                              { class: "form-select" } %>
            </div>
            <div class="col-md-2">
              <%= form.submit "Filtrer", class: "btn btn-outline-primary" %>
            </div>
            <div class="col-md-2">
              <%= link_to "Réinitialiser", request.path, class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Liste des suivis -->
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">Suivis des demandes de primes</h5>
        </div>
        <div class="card-body p-0">
          <% if @request_progresses.any? %>
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th>Propriété</th>
                    <th>Prime / Formulaire</th>
                    <th>Statut</th>
                    <th>Progression</th>
                    <th>Temps restant</th>
                    <th>Montant demandé</th>
                    <th>Montant accordé</th>
                    <th>Dernière MAJ</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @request_progresses.each do |progress| %>
                    <tr>
                      <td>
                        <div class="d-flex flex-column">
                          <span class="fw-bold"><%= progress.property&.address || "Adresse non renseignée" %></span>
                          <small class="text-muted"><%= progress.region&.capitalize || "Région non spécifiée" %></small>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex flex-column">
                          <% if progress.form_type.present? %>
                            <span>
                              <i class="bi bi-file-earmark-text text-primary me-1"></i>
                              <%= progress.form_name || progress.form_type.humanize %>
                            </span>
                            <small class="text-muted">Formulaire: <%= progress.form_type.humanize %></small>
                          <% elsif progress.prime %>
                            <span>
                              <i class="bi bi-award text-warning me-1"></i>
                              <%= progress.prime&.titre || progress.prime&.name || "Prime non spécifiée" %>
                            </span>
                            <small class="text-muted"><%= progress.prime&.region&.capitalize || "Région non spécifiée" %></small>
                          <% else %>
                            <span class="text-muted">
                              <i class="bi bi-question-circle me-1"></i>
                              Non défini
                            </span>
                          <% end %>
                        </div>
                      </td>
                      <td>
                        <span class="badge bg-<%= progress.status_administratif == 'accorde' ? 'success' :
                                                  progress.status_administratif == 'refuse' ? 'danger' :
                                                  progress.status_administratif == 'en_cours' ? 'warning' : 'secondary' %>">
                          <%= t("request_progress.status.#{progress.status_administratif}") %>
                        </span>
                      </td>
                      <td>
                        <div class="progress" style="height: 8px;">
                          <div class="progress-bar"
                               role="progressbar"
                               style="width: <%= progress.pourcentage %>%"
                               aria-valuenow="<%= progress.pourcentage %>"
                               aria-valuemin="0"
                               aria-valuemax="100">
                          </div>
                        </div>
                        <small class="text-muted"><%= progress.pourcentage %>%</small>
                      </td>
                      <td>
                        <div class="d-flex flex-column">
                          <span class="<%= progress.classe_css_delai %>">
                            <% case progress.statut_delai %>
                            <% when :depasse %>
                              <i class="fas fa-exclamation-triangle me-1" title="Délai dépassé"></i>
                            <% when :urgent %>
                              <i class="fas fa-clock me-1" title="Urgent - moins de 30 jours"></i>
                            <% when :proche %>
                              <i class="fas fa-hourglass-half me-1" title="Délai proche - moins de 3 mois"></i>
                            <% else %>
                              <i class="fas fa-check-circle me-1" title="Dans les temps"></i>
                            <% end %>
                            <%= progress.temps_restant_humanise %>
                          </span>
                          <% if progress.date_limite_reponse %>
                            <small class="text-muted">
                              <i class="fas fa-calendar-alt me-1"></i>
                              <%= l(progress.date_limite_reponse, format: :short) %>
                            </small>
                          <% end %>
                        </div>
                      </td>
                      <td>
                        <%= number_to_currency(progress.montant_demande, unit: "€", delimiter: ".", separator: ",", format: "%n %u") if progress.montant_demande %>
                      </td>
                      <td>
                        <%= number_to_currency(progress.montant_accorde, unit: "€", delimiter: ".", separator: ",", format: "%n %u") if progress.montant_accorde %>
                        <% if progress.montant_demande&.positive? && progress.montant_accorde %>
                          <br><small class="text-muted">(<%= progress.taux_octroi %>%)</small>
                        <% end %>
                      </td>
                      <td>
                        <%= l(progress.date_derniere_maj, format: :short) if progress.date_derniere_maj %>
                      </td>
                      <td>
                        <div class="btn-group btn-group-sm">
                          <%= link_to "Voir", progress, class: "btn btn-outline-primary btn-sm" %>
                          <%= link_to t('common.edit'), edit_request_progress_path(progress), class: "btn btn-outline-secondary btn-sm" %>
                          <%= link_to t('common.delete'), progress,
                                      data: {
                                        "turbo-method": :delete,
                                        "turbo-confirm": t('common.confirm')
                                      },
                                      class: "btn btn-outline-danger btn-sm" %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center">
              <div class="text-muted">
                Affichage de <%= (@offset + 1) %> à <%= [@offset + @per_page, @total_count].min %> sur <%= @total_count %> résultats
              </div>
              <% if @total_count > @per_page %>
                <nav>
                  <ul class="pagination pagination-sm mb-0">
                    <% if @page > 1 %>
                      <li class="page-item">
                        <%= link_to "Précédent", request.params.merge(page: @page - 1), class: "page-link" %>
                      </li>
                    <% end %>

                    <% total_pages = (@total_count.to_f / @per_page).ceil %>
                    <% if total_pages > 1 %>
                      <% [1, @page - 2, @page - 1, @page, @page + 1, @page + 2, total_pages].uniq.select { |p| p > 0 && p <= total_pages }.each do |page_num| %>
                        <li class="page-item <%= 'active' if page_num == @page %>">
                          <%= link_to page_num, request.params.merge(page: page_num), class: "page-link" %>
                        </li>
                      <% end %>
                    <% end %>

                    <% if @page < total_pages %>
                      <li class="page-item">
                        <%= link_to "Suivant", request.params.merge(page: @page + 1), class: "page-link" %>
                      </li>
                    <% end %>
                  </ul>
                </nav>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <div class="mb-3">
                <i class="fas fa-clipboard-list fa-3x text-muted"></i>
              </div>
              <h5 class="text-muted">Aucun suivi de demande</h5>
              <p class="text-muted">
                <% if @request %>
                  Aucun suivi n'a encore été créé pour cette demande.
                <% else %>
                  Aucun suivi de demande n'a encore été créé.
                <% end %>
              </p>
              <% if @request %>
                <%= link_to t('request_progress.new'),
                            new_request_request_progress_path(@request),
                            class: "btn btn-primary btn-lg" %>
              <% else %>
                <%= link_to new_request_progress_path, class: "btn btn-primary btn-lg" do %>
                  <i class="bi bi-plus-lg me-2"></i><%= t('request_progress.new') %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
