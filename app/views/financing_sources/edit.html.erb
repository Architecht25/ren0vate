<% content_for :title, "Modifier la source de financement" %>

<div class="container py-4" style="max-width: 700px;">
  <div class="d-flex align-items-center mb-4">
    <%= link_to project_path(@project, tab: "preparation"), class: "btn btn-outline-secondary btn-sm me-3" do %>
      <i class="bi bi-arrow-left"></i>
    <% end %>
    <div style="min-width: 0;">
      <h3 class="mb-0 text-truncate">Modifier la source de financement</h3>
      <p class="text-muted small mb-0 text-truncate"><%= @project.nom %></p>
    </div>
  </div>

  <%= render "form" %>
</div>
