<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: "Résultat de la simulation", subtitle: @subsidy_case.region.humanize } do %><% end %>

  <% if @results.empty? %>
    <div class="alert alert-info">
      Aucune prime active trouvée pour cette région à la date d'aujourd'hui.
    </div>
  <% else %>
    <div class="row g-3">
      <% @results.each do |result| %>
        <div class="col-12 col-md-6">
          <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h3 class="h6 mb-0"><%= result.subsidy_rule.label %></h3>
                <span class="badge bg-<%= result.eligible? ? 'success' : 'secondary' %>">
                  <%= result.eligible? ? "Éligible" : "Non éligible" %>
                </span>
              </div>
              <% if result.eligible? %>
                <div class="fw-bold fs-5"><%= number_to_currency(result.amount_estimated, unit: "€", format: "%n %u") %></div>
              <% else %>
                <ul class="small text-muted mb-0">
                  <% result.reasons.each do |reason| %>
                    <li><%= reason["field"] %> <%= reason["operator"] %> <%= reason["value"] %></li>
                  <% end %>
                </ul>
              <% end %>
              <div class="text-muted small mt-2">
                Règle en vigueur depuis le <%= result.subsidy_rule.valid_from.strftime("%d/%m/%Y") %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <p class="text-muted small mt-4">
      Simulation indicative sur la base des règles en vigueur à ce jour. Le montant définitif relève de l'administration compétente.
    </p>
  <% end %>
</div>
