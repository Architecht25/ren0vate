<div class="section">
  <div class="section-title">
    💰 Calcul des Primes
  </div>

  <% if @export_data['user_inputs'] && @export_data['user_inputs'].any? %>
    <h3>Données saisies</h3>
    <table class="data-table">
      <thead>
        <tr>
          <th>Type de travaux / Surface</th>
          <th>Valeur saisie</th>
        </tr>
      </thead>
      <tbody>
        <% @export_data['user_inputs'].each do |key, value| %>
          <tr>
            <td><%= format_question_label(key) %></td>
            <td><%= format_field_value(key, value, @region) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if @export_data['individual_primes'] && @export_data['individual_primes'].any? %>
    <h3>Détail des primes calculées</h3>
    <table class="data-table">
      <thead>
        <tr>
          <th>Section</th>
          <th>Type de prime</th>
          <th>Valeur saisie</th>
          <th>Montant calculé</th>
        </tr>
      </thead>
      <tbody>
        <% @export_data['individual_primes'].each do |prime| %>
          <tr>
            <td><%= prime['section'] %></td>
            <td><%= prime['label'] %></td>
            <td>
              <% if prime['input_value'] == 'Oui' || prime['input_value'] == 'Non' %>
                <%= prime['input_value'] %>
              <% elsif prime['input_value'].match?(/^\d+$/) %>
                <%= prime['input_value'] %> m²
              <% else %>
                <%= prime['input_value'] %>
              <% end %>
            </td>
            <td><%= prime['result_value'] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if @export_data['section_totals'] && @export_data['section_totals'].any? %>
    <h3>Totaux par section</h3>
    <% @export_data['section_totals'].each do |section, total| %>
      <div class="prime-item">
        <div class="prime-title"><%= section %></div>
        <div class="prime-amount"><%= total %></div>
      </div>
    <% end %>
  <% end %>

  <% if @export_data['total_primes'] %>
    <div class="total-box">
      <div>Total général des primes</div>
      <div class="total-amount"><%= @export_data['total_primes'] %> €</div>
    </div>
  <% end %>
</div>

<% if @export_data['categories'] %>
  <div class="section">
    <div class="section-title">
      📊 Catégories et Revenus
    </div>
    <table class="data-table">
      <tbody>
        <% if @export_data['categories']['selected_category'] %>
          <tr>
            <td><strong>Catégorie sélectionnée</strong></td>
            <td><%= @export_data['categories']['selected_category'] %></td>
          </tr>
        <% end %>
        <% if @export_data['categories']['revenue_range'] %>
          <tr>
            <td><strong>Tranche de revenus</strong></td>
            <td><%= @export_data['categories']['revenue_range'] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
