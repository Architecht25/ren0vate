<div class="section">
  <div class="section-title">
    📋 Résultats du Test d'Éligibilité
    <% if @region %>
      - <%= format_region_name(@region) %>
    <% end %>
    <% if @export_data['_profile_type'] %>
      (<%= @export_data['_profile_type'].humanize %>)
    <% end %>
  </div>

  <% if @export_data.any? %>
    <!-- Section Éligibilité de base -->
    <h3>✅ Critères d'éligibilité</h3>
    <table class="data-table">
      <thead>
        <tr>
          <th>Question</th>
          <th>Réponse</th>
        </tr>
      </thead>
      <tbody>
        <% @export_data.each do |key, value| %>
          <% next if key == 'result' || key == 'eligible' || key.start_with?('_') %>
          <% next if key.include?('categorie') || key.include?('enfants') || key.include?('statut_familial') || key.include?('revenus') || key.include?('revenu_tranche') || key.include?('personnes') %>
          <tr>
            <td><%= format_question_label(key) %></td>
            <td><%= format_field_value(key, value, @region) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Section Affinage (Revenus et Situation familiale) -->
    <% affinage_keys = @export_data.select { |key, value| key.include?('categorie') || key.include?('enfants') || key.include?('statut_familial') || key.include?('revenu_tranche') || key.include?('personnes') } %>
    <% if affinage_keys.any? %>
      <h3>💰 Affinage - Situation financière et familiale</h3>
      <table class="data-table">
        <thead>
          <tr>
            <th>Critère</th>
            <th>Valeur</th>
          </tr>
        </thead>
        <tbody>
          <% affinage_keys.each do |key, value| %>
            <tr>
              <td><%= format_question_label(key) %></td>
              <td><%= format_field_value(key, value, @region) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

  <% end %>

  <% if @export_data['result'] %>
    <div class="result-box <%= @export_data['eligible'] == true ? '' : 'error' %>">
      <div class="result-title">
        <%= @export_data['eligible'] == true ? '✅ Résultat' : '❌ Résultat' %>
      </div>
      <%= @export_data['result'] %>
    </div>
  <% end %>
</div>

<% if @export_data['additional_info'] %>
  <div class="section">
    <div class="section-title">
      ℹ️ Informations Complémentaires
    </div>
    <p><%= @export_data['additional_info'] %></p>
  </div>
<% end %>
