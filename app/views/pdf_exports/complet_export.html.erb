<div class="section">
  <div class="section-title">
    📋 Test d'Éligibilité - <%= format_region_name(@region) %>
  </div>

  <% if @eligibilite_data.any? %>
    <!-- Section Éligibilité de base -->
    <h3>✅ Critères d'éligibilité</h3>
    <table class="data-table">
      <thead>
        <tr>
          <th>Question</th>
          <th>Réponse</th>
        </tr>
      </thead>
      <tbody>
        <% @eligibilite_data.each do |key, value| %>
          <% next if key == 'result' || key == 'eligible' || key.start_with?('_') %>
          <% next if key.include?('categorie') || key.include?('enfants') || key.include?('statut_familial') || key.include?('revenus') || key.include?('revenu') || key.include?('personnes') %>
          <tr>
            <td><%= format_question_label(key) %></td>
            <td><%= format_field_value(key, value, @region) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Section Affinage (Revenus et Situation familiale) -->
    <% affinage_keys = @eligibilite_data.select { |key, value| key.include?('categorie') || key.include?('enfants') || key.include?('statut_familial') || key.include?('revenus') || key.include?('revenu') || key.include?('personnes') } %>
    <% if affinage_keys.any? %>
      <h3>💰 Affinage - Situation financière et familiale</h3>
      <table class="data-table">
        <thead>
          <tr>
            <th>Critère</th>
            <th>Valeur</th>
          </tr>
        </thead>
        <tbody>
          <% affinage_keys.each do |key, value| %>
            <tr>
              <td><%= format_question_label(key) %></td>
              <td><%= format_field_value(key, value, @region) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <% if @eligibilite_data['result'] %>
    <div class="result-box <%= @eligibilite_data['eligible'] == true ? '' : 'error' %>">
      <div class="result-title">
        <%= @eligibilite_data['eligible'] == true ? '✅ Résultat d\'éligibilité' : '❌ Résultat d\'éligibilité' %>
      </div>
      <%= @eligibilite_data['result'] %>
    </div>
  <% end %>
</div>

<div class="section">
  <div class="section-title">
    💰 Calcul des Primes
  </div>

  <!-- Détail des primes individuelles -->
  <% if @primes_data['individual_primes'] && @primes_data['individual_primes'].any? %>
    <h3>Détail des primes calculées</h3>
    <table class="data-table">
      <thead>
        <tr>
          <th>Section</th>
          <th>Type de prime</th>
          <th>Valeur saisie</th>
          <th>Montant calculé</th>
        </tr>
      </thead>
      <tbody>
        <% @primes_data['individual_primes'].each do |prime| %>
          <tr>
            <td><%= prime['section'] %></td>
            <td><%= prime['label'] %></td>
            <td>
              <% if prime['input_value'] == 'Oui' || prime['input_value'] == 'Non' %>
                <%= prime['input_value'] %>
              <% elsif prime['input_value'].match?(/^\d+$/) %>
                <%= prime['input_value'] %> m²
              <% else %>
                <%= prime['input_value'] %>
              <% end %>
            </td>
            <td><%= prime['result_value'] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <!-- Totaux par section (optionnel, plus compact) -->
  <% if @primes_data['section_totals'] && @primes_data['section_totals'].any? %>
    <h3>Résumé par section</h3>
    <table class="data-table">
      <thead>
        <tr>
          <th>Section</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% @primes_data['section_totals'].each do |section, total| %>
          <tr>
            <td><%= section %></td>
            <td><strong><%= total %></strong></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <!-- Total général -->
  <% if @primes_data['total_primes'] %>
    <div class="total-amount">
      <strong>💰 Total des primes éligibles : <%= @primes_data['total_primes'] %> €</strong>
    </div>
  <% end %>
</div>

<% if @primes_data['categories'] %>
  <div class="section">
    <div class="section-title">
      📊 Profil et Catégorie
    </div>
    <table class="data-table">
      <thead>
        <tr>
          <th>Critère</th>
          <th>Valeur</th>
        </tr>
      </thead>
      <tbody>
        <% if @primes_data['categories']['selected_category'] %>
          <tr>
            <td><strong>Catégorie de revenus</strong></td>
            <td><%= @primes_data['categories']['selected_category'] %></td>
          </tr>
        <% end %>
        <% if @primes_data['categories']['wallonie_category'] %>
          <tr>
            <td><strong>Catégorie Wallonie</strong></td>
            <td><%= @primes_data['categories']['wallonie_category'] %></td>
          </tr>
        <% end %>
        <% if @primes_data['categories']['revenue_range'] %>
          <tr>
            <td><strong>Tranche de revenus</strong></td>
            <td><%= @primes_data['categories']['revenue_range'] %></td>
          </tr>
        <% end %>
        <% if @eligibilite_data['wallonie_revenu_tranche'] %>
          <tr>
            <td><strong>Revenus annuels estimés</strong></td>
            <td><%= @eligibilite_data['wallonie_revenu_tranche'] %></td>
          </tr>
        <% end %>
        <% if @eligibilite_data['wallonie_statut_familial'] %>
          <tr>
            <td><strong>Statut familial</strong></td>
            <td><%= format_field_value('wallonie_statut_familial', @eligibilite_data['wallonie_statut_familial'], @region) %></td>
          </tr>
        <% end %>
        <% if @eligibilite_data['wallonie_enfants_charge'] %>
          <tr>
            <td><strong>Enfants à charge</strong></td>
            <td><%= @eligibilite_data['wallonie_enfants_charge'] %> enfant(s)</td>
          </tr>
        <% end %>
        <% if @eligibilite_data['wallonie_personnes_agees_charge'] %>
          <tr>
            <td><strong>Personnes âgées à charge</strong></td>
            <td><%= @eligibilite_data['wallonie_personnes_agees_charge'] %> personne(s)</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
