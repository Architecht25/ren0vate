<%= simple_form_for [@property, @tenant, @lease, @rent_payment] do |f| %>
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-transparent border-bottom py-3">
      <h6 class="mb-0 fw-semibold">
        <i class="bi bi-cash-coin me-2"></i>
        <%= @rent_payment.new_record? ? 'Enregistrer un paiement' : 'Modifier le paiement' %>
      </h6>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <div class="col-md-6">
          <%= f.input :due_date, label: "Date d'échéance", as: :string,
              input_html: { class: 'form-control', type: 'date', value: @rent_payment.due_date&.strftime('%Y-%m-%d') } %>
        </div>
        <div class="col-md-6">
          <%= f.input :amount, label: 'Montant (€)',
              hint: "Loyer + charges : #{number_to_currency(@lease.loyer_total, unit: '€', format: '%n %u')}",
              input_html: { class: 'form-control', step: '0.01' } %>
        </div>
        <div class="col-md-6">
          <%= f.input :status, label: 'Statut', as: :select,
              collection: [['En attente', 'pending'], ['Payé', 'paid'], ['En retard', 'late'], ['Partiel', 'partial']],
              input_html: { class: 'form-select' } %>
        </div>
        <div class="col-md-6">
          <%= f.input :paid_date, label: 'Date de paiement effectif', as: :string, required: false,
              input_html: { class: 'form-control', type: 'date', value: @rent_payment.paid_date&.strftime('%Y-%m-%d') } %>
        </div>
        <div class="col-md-6">
          <%= f.input :payment_method, label: 'Mode de paiement', as: :select, required: false,
              collection: ['Virement bancaire', 'Domiciliation', 'Espèces', 'Chèque', 'Autre'],
              include_blank: '— Sélectionner —',
              input_html: { class: 'form-select' } %>
        </div>
        <div class="col-12">
          <%= f.input :notes, label: 'Notes', required: false, input_html: { class: 'form-control', rows: 2 } %>
        </div>
      </div>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
      <%= link_to 'Annuler', property_tenant_lease_path(@property, @tenant, @lease), class: 'btn btn-outline-secondary' %>
      <%= f.submit @rent_payment.new_record? ? 'Enregistrer' : 'Mettre à jour', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
