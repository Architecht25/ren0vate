<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= @title %></title>
    <style>
      body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; background: #f5f5f5; }
      .wrapper { background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
      .header { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); color: white; padding: 28px 30px; }
      .header .logo { font-size: 1.1em; font-weight: bold; letter-spacing: 0.05em; opacity: 0.9; margin-bottom: 4px; }
      .content { padding: 30px; }
      .notification-card { border-left: 4px solid <%= @priority_color %>; background: #f8f9fa; border-radius: 0 8px 8px 0; padding: 18px 20px; margin: 20px 0; }
      .notification-card .notif-title { font-weight: bold; font-size: 1.05em; margin-bottom: 8px; color: #1a1a2e; }
      .notification-card .notif-message { color: #444; font-size: 0.95em; }
      .btn { display: inline-block; padding: 12px 24px; background-color: #0d6efd; color: white !important; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 20px; font-size: 0.95em; }
      .footer { text-align: center; margin-top: 24px; padding: 16px 30px; font-size: 0.8em; color: #999; border-top: 1px solid #eee; }
      .greeting { color: #555; margin-bottom: 6px; }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <div class="logo">🏗️ Ren0vate</div>
        <div style="font-size:0.85em;opacity:0.7;">Plateforme de rénovation en Belgique</div>
      </div>

      <div class="content">
        <p class="greeting">Bonjour <%= @user.first_name.presence || @user.email %>,</p>
        <p style="color:#555;font-size:0.9em;">Vous avez reçu une nouvelle notification sur votre espace Ren0vate :</p>

        <div class="notification-card">
          <div class="notif-title"><%= @title %></div>
          <div class="notif-message"><%= @message %></div>
        </div>

        <% if @action_url.present? %>
          <a href="<%= @action_url %>" class="btn">Voir les détails →</a>
        <% end %>
      </div>

      <div class="footer">
        Vous recevez cet email car vous êtes inscrit sur <strong>Ren0vate</strong>.<br>
        Pour gérer vos préférences, connectez-vous à votre espace personnel.
      </div>
    </div>
  </body>
</html>
