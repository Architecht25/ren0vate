<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: "Modifier le lot", subtitle: @lot.project.nom } do %><% end %>

  <div class="row">
    <div class="col-12 col-lg-6">
      <%= simple_form_for @lot do |f| %>
        <%= f.error_notification %>
        <%= f.input :name, label: "Nom du lot" %>
        <%= f.input :key, label: "Clé technique (sans espace, ex: toiture)", hint: "Utilisée par la classification automatique des documents." %>
        <%= f.button :submit, "Enregistrer", class: "btn btn-primary-custom" %>
      <% end %>
    </div>
  </div>
</div>
