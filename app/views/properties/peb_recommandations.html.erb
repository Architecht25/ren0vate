<%
  region_config = {
    'wallonie'  => { label: 'Wallonie',   color: 'warning',   bg: '#fff8e1' },
    'bruxelles' => { label: 'Bruxelles',  color: 'primary',   bg: '#e8f0fe' },
    'flandre'   => { label: 'Flandre',    color: 'success',   bg: '#e8f5e9' }
  }

  total_recs = @peb_donnees.sum { |p|
    recos = p.donnees_extraites['recommandations'] || []
    recos.is_a?(Array) ? recos.count { |r| r.is_a?(Hash) && r['has_recommandation'] } : 0
  }
%>

<div class="container-fluid px-4 py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-lightbulb"></i>
      </div>
      <div>
        <div class="d-flex align-items-center gap-2">
          <h1 class="h3 text-primary-custom mb-0 fw-normal">Recommandations PEB</h1>
          <% if total_recs > 0 %>
            <span class="badge bg-warning text-dark"><%= total_recs %> recommandation<%= total_recs > 1 ? 's' : '' %></span>
          <% end %>
        </div>
        <small class="text-muted-custom">
          <i class="bi bi-house me-1"></i>
          <%= @property.titre || "Bien sans nom" %> ·
          <%= @property.rue %> <%= @property.numero %>, <%= @property.code_postal %> <%= @property.commune %>
        </small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to dashboard_property_path(@property), class: "btn btn-outline-primary-custom" do %>
        <i class="bi bi-arrow-left me-2"></i>Dashboard
      <% end %>
    </div>
  </div>

  <% if @peb_donnees.none? %>
    <!-- État vide -->
    <div class="card border-0 shadow rounded-4">
      <div class="card-body text-center py-5">
        <i class="bi bi-file-earmark-plus fs-1 text-muted mb-3 d-block"></i>
        <h5 class="fw-normal text-muted">Aucun certificat PEB scanné</h5>
        <p class="text-muted small mb-4">
          Scannez votre certificat PEB depuis la gestion des documents pour obtenir des recommandations d'amélioration énergétique.
        </p>
        <%= link_to new_property_document_path(@property), class: "btn btn-outline-primary-custom" do %>
          <i class="bi bi-upload me-2"></i>Ajouter un certificat PEB
        <% end %>
      </div>
    </div>

  <% else %>

    <!-- Synthèse globale -->
    <% if total_recs > 0 %>
      <div class="card border-0 shadow rounded-4 mb-4">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-bar-chart-line"></i>
            </div>
            <div>
              <h5 class="mb-0 fw-normal">Synthèse des améliorations</h5>
              <small class="text-muted-custom">Basée sur <%= @peb_donnees.count %> certificat<%= @peb_donnees.count > 1 ? 's' : '' %> PEB analysé<%= @peb_donnees.count > 1 ? 's' : '' %></small>
            </div>
          </div>
          <%
            postes_avec_reco = @peb_donnees.flat_map { |p|
              recos = p.donnees_extraites['recommandations'] || []
              recos.is_a?(Array) ? recos.select { |r| r.is_a?(Hash) && r['has_recommandation'] } : []
            }.uniq { |r| r['cle'] }
          %>
          <div class="d-flex flex-wrap gap-2">
            <% postes_avec_reco.each do |r| %>
              <span class="badge bg-warning text-dark border border-warning-subtle px-3 py-2">
                <i class="<%= r['icone'] %> me-1"></i><%= r['poste'] %>
              </span>
            <% end %>
            <% if postes_avec_reco.empty? %>
              <span class="text-muted small">Aucun poste à améliorer identifié</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Certificats PEB avec leurs recommandations -->
    <% @peb_donnees.each_with_index do |peb, idx| %>
      <% cfg = region_config[peb.region] || { label: peb.region&.capitalize || 'Région inconnue', color: 'secondary', bg: '#f8f9fa' } %>
      <% postes = peb.donnees_extraites['recommandations'] || [] %>
      <% postes_structures = postes.is_a?(Array) && postes.first.is_a?(Hash) && postes.first.key?('poste') %>

      <div class="card border-0 shadow rounded-4 mb-4">

        <!-- En-tête certificat -->
        <div class="card-header bg-white border-0 rounded-4 py-3 px-4">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
              <span class="badge bg-<%= cfg[:color] %> fs-6 px-3">
                <i class="bi bi-geo-alt me-1"></i><%= cfg[:label] %>
              </span>
              <% if peb.label_peb.present? %>
                <span class="badge bg-<%= peb.couleur_bootstrap %> fs-6 px-3">
                  Classe <%= peb.label_peb %>
                </span>
              <% end %>
              <% if peb.score_ep.present? %>
                <span class="text-muted small">
                  <i class="bi bi-lightning me-1"></i><%= peb.score_ep_formate %>
                </span>
              <% end %>
            </div>
            <div class="d-flex align-items-center gap-3">
              <% if peb.date_certificat.present? %>
                <small class="text-muted">
                  <i class="bi bi-calendar me-1"></i>Établi le <%= peb.date_certificat.strftime('%d/%m/%Y') %>
                </small>
              <% end %>
              <% if peb.perime? %>
                <span class="badge bg-danger">
                  <i class="bi bi-exclamation-triangle me-1"></i>Expiré
                </span>
              <% elsif peb.date_validite.present? %>
                <small class="text-muted">
                  <i class="bi bi-shield-check me-1"></i>Valide jusqu'au <%= peb.date_validite.strftime('%d/%m/%Y') %>
                </small>
              <% end %>
              <% if peb.document.present? %>
                <%= link_to document_path(peb.document), class: "btn btn-outline-secondary btn-sm", title: "Voir le document" do %>
                  <i class="bi bi-file-earmark-pdf me-1"></i>Document
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <div class="card-body px-4 pb-4">

          <% if postes_structures %>
            <div class="row g-3">
              <% postes.each do |poste| %>
                <div class="col-md-6 col-xl-4">
                  <%
                    card_bg = if !poste['detecte']
                                '#f8f9fa'
                              elsif poste['has_recommandation']
                                '#fff3cd'
                              else
                                '#d4edda'
                              end
                    badge_class = if !poste['detecte']
                                    'bg-light text-muted border'
                                  elsif poste['has_recommandation']
                                    'bg-warning text-dark'
                                  else
                                    'bg-success'
                                  end
                    icon_class = if !poste['detecte']
                                   'text-muted'
                                 elsif poste['has_recommandation']
                                   'text-warning'
                                 else
                                   'text-success'
                                 end
                  %>
                  <div class="rounded-3 p-3 h-100" style="background: <%= card_bg %>;">
                    <div class="d-flex align-items-start gap-2 mb-2">
                      <i class="<%= poste['icone'] %> <%= icon_class %> fs-5 mt-1 flex-shrink-0"></i>
                      <span class="fw-medium small flex-grow-1" style="line-height: 1.3;"><%= poste['poste'] %></span>
                      <span class="badge <%= badge_class %> flex-shrink-0 ms-1" style="font-size: 0.65rem; white-space: nowrap;">
                        <% if !poste['detecte'] %>
                          Non détecté
                        <% elsif poste['has_recommandation'] %>
                          <i class="bi bi-exclamation-circle me-1"></i>Reco
                        <% else %>
                          <i class="bi bi-check-circle me-1"></i>OK
                        <% end %>
                      </span>
                    </div>

                    <% if poste['has_recommandation'] && poste['recommandation'].present? %>
                      <p class="small text-dark mb-2 ps-1" style="line-height: 1.4; font-size: 0.8rem;">
                        <i class="bi bi-arrow-right-short me-1 text-warning"></i><%= poste['recommandation'] %>
                      </p>
                    <% end %>

                    <% if (elems = poste['elements'])&.any? %>
                      <div class="mt-2 border-top pt-2">
                        <small class="text-muted d-block mb-1" style="font-size: 0.7rem;">Éléments concernés :</small>
                        <% elems.each do |elem| %>
                          <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                            <div class="d-flex align-items-center gap-1 min-w-0">
                              <span class="badge bg-secondary rounded-1 flex-shrink-0" style="font-size: 0.6rem;"><%= elem['id'] %></span>
                              <span class="small text-dark text-truncate" style="font-size: 0.75rem;" title="<%= elem['denomination'] %>"><%= elem['denomination'] %></span>
                            </div>
                            <span class="badge bg-light text-dark border ms-2 flex-shrink-0" style="font-size: 0.65rem;"><%= elem['surface'] %></span>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>

          <% elsif postes.any? %>
            <div class="d-flex align-items-center mb-2 text-muted">
              <i class="bi bi-info-circle me-2"></i>
              <small>Format hérité — re-scannez le document pour bénéficier de l'analyse structurée.</small>
            </div>
            <div class="row g-3">
              <% postes.each do |reco| %>
                <div class="col-md-6">
                  <div class="d-flex align-items-start p-3 rounded-3" style="background: <%= cfg[:bg] %>;">
                    <i class="bi bi-wrench me-2 mt-1 text-warning flex-shrink-0"></i>
                    <p class="mb-0 small text-dark" style="line-height: 1.5;"><%= reco %></p>
                  </div>
                </div>
              <% end %>
            </div>

          <% else %>
            <div class="text-center py-4 text-muted">
              <i class="bi bi-info-circle fs-4 mb-2 d-block"></i>
              <% if peb.texte_ocr_brut.present? %>
                <p class="mb-0 small">Aucune section de recommandations détectée dans ce certificat.</p>
                <small>Le texte OCR peut être incomplet ou le certificat ne contient pas de mesures d'amélioration explicites.</small>
              <% else %>
                <p class="mb-0 small">Certificat sans texte OCR — re-scannez le document pour extraire les recommandations.</p>
              <% end %>
            </div>
          <% end %>

        </div>
      </div>
    <% end %>

    <!-- Lien vers ajout d'un nouveau PEB -->
    <div class="text-center mt-2">
      <%= link_to new_property_document_path(@property), class: "btn btn-outline-primary-custom" do %>
        <i class="bi bi-upload me-2"></i>Ajouter un autre certificat PEB
      <% end %>
    </div>

  <% end %>

</div>
