<div class="container-fluid px-4 py-4">
  <!-- Header avec actions -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-house-door"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Modifier un bien</h1>
        <small class="text-muted-custom">
          <%= @property.full_address %>
        </small>
      </div>
    </div>
    <div>
      <%= link_to property_path(@property), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-2"></i>Retour
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-10 mx-auto">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-pencil-square me-2"></i>Informations du bien
            <span class="badge bg-primary-custom ms-2"><%= @property.region&.humanize || 'Région non définie' %></span>
          </h5>

          <!-- Utiliser les formulaires spécifiques par région comme pour la création -->
          <% normalized_region = @property.region&.downcase&.strip %>
          <% case normalized_region %>
          <% when "bruxelles" %>
            <%= render partial: "form_bruxelles", locals: { property: @property } %>
          <% when "wallonie" %>
            <%= render partial: "form_wallonie", locals: { property: @property } %>
          <% when "flandre" %>
            <%= render partial: "form_flandre", locals: { property: @property } %>
          <% else %>
            <div class="alert alert-warning">
              <i class="bi bi-exclamation-triangle me-2"></i>
              Région non définie ou non reconnue : "<%= @property.region %>"<br>
              <small>Régions supportées : Bruxelles, Wallonie, Flandre</small>
            </div>

            <!-- Formulaire de secours pour définir la région -->
            <%= form_with model: @property, local: true, class: "mt-3" do |form| %>
              <div class="mb-3">
                <%= form.label :region, "Sélectionner la région :", class: "form-label" %>
                <%= form.select :region,
                    [["Bruxelles", "bruxelles"], ["Wallonie", "wallonie"], ["Flandre", "flandre"]],
                    { prompt: "-- Choisir une région --" },
                    { class: "form-select" } %>
              </div>
              <%= form.submit "Mettre à jour la région", class: "btn btn-primary" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
