<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-house-door"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Nouveau Bien Immobilier</h1>
    </div>
    <%= link_to properties_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à la liste
    <% end %>
  </div>

  <!-- Sélection de la région -->
  <% if params[:region].blank? %>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <h5 class="card-title text-primary-custom mb-4">
              <i class="bi bi-geo-alt-fill me-2"></i>Choisissez votre région
            </h5>
            <p class="text-muted-custom mb-4">Le formulaire d'ajout de bien immobilier est adapté en fonction de votre région pour vous permettre de bénéficier des primes et avantages spécifiques.</p>

            <div class="row g-4 mt-2">
              <!-- Carte pour Bruxelles -->
              <div class="col-md-4">
                <%= link_to new_property_path(region: "bruxelles"), class: "text-decoration-none" do %>
                  <div class="card h-100 region-card">
                    <div class="card-body text-center p-4">
                      <div class="icon-circle-large mx-auto mb-3">
                        <i class="bi bi-buildings"></i>
                      </div>
                      <h5 class="card-title mb-2">Bruxelles</h5>
                      <p class="text-muted-custom small mb-0">Formulaire adapté aux primes bruxelloises et aux spécificités de la région.</p>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Carte pour la Wallonie -->
              <div class="col-md-4">
                <%= link_to new_property_path(region: "wallonie"), class: "text-decoration-none" do %>
                  <div class="card h-100 region-card">
                    <div class="card-body text-center p-4">
                      <div class="icon-circle-large mx-auto mb-3">
                        <i class="bi bi-house-heart"></i>
                      </div>
                      <h5 class="card-title mb-2">Wallonie</h5>
                      <p class="text-muted-custom small mb-0">Formulaire adapté aux primes wallonnes et aux spécificités de la région.</p>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Carte pour la Flandre -->
              <div class="col-md-4">
                <%= link_to new_property_path(region: "flandre"), class: "text-decoration-none" do %>
                  <div class="card h-100 region-card">
                    <div class="card-body text-center p-4">
                      <div class="icon-circle-large mx-auto mb-3">
                        <i class="bi bi-house-check"></i>
                      </div>
                      <h5 class="card-title mb-2">Flandre</h5>
                      <p class="text-muted-custom small mb-0">Formulaire adapté aux primes flamandes et aux spécificités de la région.</p>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Formulaire spécifique à la région sélectionnée -->
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card border-0 bg-light-custom">
          <div class="card-body p-4">
            <% case params[:region] %>
            <% when "bruxelles" %>
              <%= render partial: "form_bruxelles" %>
            <% when "wallonie" %>
              <%= render partial: "form_wallonie" %>
            <% when "flandre" %>
              <%= render partial: "form_flandre" %>
            <% else %>
              <div class="alert alert-warning">
                Région non reconnue. <%= link_to "Retour à la sélection", new_property_path %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body p-4">
            <h5 class="card-title text-primary-custom mb-3">
              <i class="bi bi-lightbulb me-2"></i>Primes disponibles
            </h5>

            <% case params[:region] %>
            <% when "bruxelles" %>
              <ul class="text-muted-custom small mb-0 ps-3">
                <li class="mb-2">Prime Rénolution pour la rénovation énergétique</li>
                <li class="mb-2">Prime à l'embellissement des façades</li>
                <li class="mb-2">Prêt vert bruxellois à taux réduit</li>
                <li>Primes pour l'installation de panneaux photovoltaïques</li>
              </ul>
            <% when "wallonie" %>
              <ul class="text-muted-custom small mb-0 ps-3">
                <li class="mb-2">Prime Habitation pour la rénovation énergétique</li>
                <li class="mb-2">Rénopack & Rénoprêt à 0%</li>
                <li class="mb-2">Prime QUALIWATT pour les panneaux photovoltaïques</li>
                <li>Primes communales spécifiques</li>
              </ul>
            <% when "flandre" %>
              <ul class="text-muted-custom small mb-0 ps-3">
                <li class="mb-2">Premie voor energiebesparende maatregelen</li>
                <li class="mb-2">EPC-labelpremie voor woningen en appartementen</li>
                <li class="mb-2">Renteloos renovatiekrediet</li>
                <li>Sloop- en heropbouwpremie</li>
              </ul>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Styles pour les cartes de région -->
<style>
  .region-card {
    transition: all 0.2s ease;
    border-radius: 8px;
    border: 1px solid var(--border-custom);
  }

  .region-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(44, 82, 130, 0.15);
    border-color: var(--primary-custom);
  }

  .icon-circle-large {
    width: 80px;
    height: 80px;
    background-color: var(--light-custom);
    border: 2px solid var(--border-custom);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-custom);
    font-size: 32px;
    transition: all 0.2s ease;
  }

  .region-card:hover .icon-circle-large {
    background-color: var(--primary-custom);
    border-color: var(--primary-custom);
    color: white;
    transform: scale(1.05);
  }

  .card-title {
    color: var(--text-primary-custom);
    font-weight: 500;
  }
</style>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
