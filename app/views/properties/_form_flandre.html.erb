<% property ||= @property %>
<%= simple_form_for property, local: true do |f| %>
  <!-- Champ caché pour la région -->
  <%= f.hidden_field :region, value: "flandre" %>

  <!-- Section Nom du bien -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-tag me-2"></i>
      Naam van de woning
    </h5>

    <%= f.input :titre,
        label: "Naam of titel van de woning",
        placeholder: "ex. Mijn huis Vlaanderen, Appartement Gent, Gezinswoning...",
        hint: "Geef een naam aan uw woning om deze gemakkelijk terug te vinden",
        wrapper_html: { class: "mb-3" },
        input_html: { class: "form-control-custom" } %>
  </div>

  <!-- Section Adresse -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-geo-alt me-2"></i>
      Informations sur le bien à rénover
    </h5>

    <%= f.input :rue,
        label: "Rue*",
        placeholder: "ex. Rue de l'Énergie",
        wrapper_html: { class: "mb-3" },
        input_html: { class: "form-control-custom" } %>

    <div class="row g-3">
      <div class="col-md-3">
        <%= f.input :numero,
            label: "Numéro*",
            placeholder: "ex. 24",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>

      <div class="col-md-3">
        <%= f.input :code_postal,
            label: "Code postal*",
            placeholder: "ex. 9000",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>

      <div class="col-md-4">
        <%= f.input :commune,
            label: "Commune*",
            placeholder: "ex. Gand",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Type de bien -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-building me-2"></i>
      Type de logement
    </h5>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :type_bien_flandre,
            label: "Type de bien (Flandre)*",
            as: :select,
            collection: [
              ["Maison unifamiliale", "maison"],
              ["Appartement en copropriété", "appartement_copro"],
              ["Appartement non en copropriété", "appartement"],
              ["Immeuble à plusieurs unités d'habitation", "immeuble_appartements"],
              ["Non logement", "non_logement"]
            ],
            prompt: "-- Sélectionnez le type de bien --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :usage_flandre,
            label: "Usage (Flandre)*",
            as: :select,
            collection: [
              ["Résidence principale", "residence_principale"],
              ["Logement loué", "location"],
              ["Autre", "autre"]
            ],
            prompt: "-- Sélectionnez l'usage --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Informations d'achat -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-credit-card me-2"></i>
      Informations d'achat
    </h5>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :valeur_achat,
            label: "Valeur d'achat (€)",
            placeholder: "ex. 250000",
            hint: "Prix d'achat du bien en euros",
            wrapper_html: { class: "mb-0" },
            input_html: {
              class: "form-control-custom",
              type: "number",
              step: "0.01",
              min: "0"
            } %>
      </div>
      <div class="col-md-6">
        <%= f.input :date_achat,
            label: "Date d'achat",
            hint: "Date d'acquisition du bien",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" },
            as: :date %>
      </div>
    </div>
  </div>

  <!-- Section Type de bien (suite) -->
  <div class="form-section mb-4">
    <!-- Nouvelle section : Statut de propriété -->
    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :type_propriete_flandre,
            label: "Statut de propriété (Flandre)*",
            as: :select,
            collection: [
              ["Propriétaire occupant", "eigenaar_bewoner"],
              ["Plein propriétaire", "volle_eigenaar"],
              ["Copropriétaire", "mede_eigenaar"],
              ["Usufruitier", "vruchtgebruiker"],
              ["Nu-propriétaire", "naakte_eigenaar"],
              ["Locataire", "huurder"],
              ["Autre", "andere"]
            ],
            prompt: "-- Sélectionnez votre statut --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :pourcentage_propriete,
            label: "Votre part de propriété (%)*",
            placeholder: "ex. 100",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number", min: "1", max: "100" } %>
        <small class="form-text text-muted">
          <i class="bi bi-info-circle me-1"></i>
          De quel % du bien êtes-vous propriétaire ? (Min. 1% requis)
        </small>
      </div>
    </div>

    <!-- Nouvelle section : Habitation et domiciliation -->
    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :habitation_percentage,
            label: "Usage habitation du bien (%)*",
            placeholder: "ex. 100",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number", min: "1", max: "100" } %>
        <small class="form-text text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Quel % du bien est destiné au logement vs commercial ? (Flandre: généralement 100%)
        </small>
      </div>
      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Serez-vous domicilié sur ce bien après rénovation?</h6>
        <%= f.input :domicilie_flandre,
            label: false,
            as: :radio_buttons,
            collection: [['Oui', true], ['Non', false]],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
        <small class="form-text text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Obligatoire pour l'éligibilité aux primes Flandre
        </small>
      </div>
    </div>
  </div>

  <!-- Section Caractéristiques spécifiques à la Flandre -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-info-circle me-2"></i>
      Caractéristiques spécifiques à la Flandre
    </h5>

    <div class="row g-3">
      <div class="col-md-4">
        <%= f.input :annee_construction,
            label: "Année de construction*",
            placeholder: "ex. 1985",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :date_raccordement_electrique,
            label: "Date de raccordement électrique*",
            placeholder: "Année avant 2006",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :chauffage_post_renovation_flandre,
            label: "Système de chauffage (Flandre)",
            placeholder: "ex. Pompe à chaleur",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :ean_flandre,
            label: "Numéro EAN (Flandre)*",
            placeholder: "ex. 5412345678901",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" },
            hint: "Code EAN de votre compteur électrique (obligatoire pour les primes Flandre)" %>
      </div>
      <div class="col-md-6">
        <%= f.input :parcelle_flandre,
            label: "Numéro de parcelle cadastrale (Flandre)",
            placeholder: "ex. 136E",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" },
            hint: "Numéro de parcelle visible sur votre extrait cadastral" %>
      </div>
    </div>

    <div class="row g-3 mt-3">
      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Possédez-vous encore un autre logement/appartement/terrain en pleine propriété?</h6>
        <%= f.input :autre_bien,
            label: false,
            as: :radio_buttons,
            collection: [['Oui', 'oui'], ['Non', 'non']],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>

      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Êtes-vous un client protégé (tarif social énergie)?</h6>
        <%= f.input :client_protege_flandre,
            label: false,
            as: :radio_buttons,
            collection: [['Oui', true], ['Non', false]],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
        <small class="form-text text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Client protégé = catégorie 4 automatique (primes maximales)
        </small>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Le certificat PEB indique-t-il un label E, F ou inférieur (G) avant rénovation?</h6>
        <%= f.input :peb,
            label: false,
            as: :radio_buttons,
            collection: [['Oui', 'efg'], ['Non', 'autre']],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>

      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Le logement est-il un bâtiment qui a été démoli mais en gardant des résidus pour bénéficier de la TVA à 6% ?</h6>
        <%= f.input :reconstruit,
            label: false,
            as: :radio_buttons,
            collection: [['Oui', 'oui'], ['Non', 'non']],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
    </div>

    <!-- Section dates PEB -->
    <div class="row g-3 mt-3">
      <div class="col-md-6">
        <%= f.input :date_peb_avant_travaux,
            label: "Date de production du certificat PEB avant travaux*",
            placeholder: "ex. 01/01/2020",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "date" } %>
        <small class="form-text text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Les certificats établis avant le 1er janvier 2019 ne sont plus valables pour la demande de prime PEB
        </small>
      </div>

      <div class="col-md-6">
        <%= f.input :date_peb_apres_travaux,
            label: "Date de production du certificat PEB après travaux",
            placeholder: "ex. 01/01/2024",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "date" } %>
      </div>
    </div>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex justify-content-end mt-4">
    <%= link_to "Annuler", properties_path, class: "btn btn-outline-secondary me-2" %>
    <%= f.submit "Ajouter la propriété", class: "btn btn-primary-custom" %>
  </div>
<% end %>
