<% property ||= @property %>
<div class="container-fluid px-0">
  <%= simple_form_for property, local: true, html: { class: "needs-validation", novalidate: true } do |f| %>
    <!-- Style CSS renforcé pour les champs obligatoires -->
    <style>
      /* Cibler tous les types de champs avec required */
      input[required],
      select[required],
      textarea[required],
      .form-control[required],
      .form-select[required],
      input.form-control[required],
      select.form-select[required] {
        border: 3px solid #8fbc8f !important;
        border-color: #8fbc8f !important;
        box-shadow: 0 0 0 0.2rem rgba(143, 188, 143, 0.15) !important;
        background-color: #f7faf7 !important;
      }

      /* État focus pour les champs obligatoires */
      input[required]:focus,
      select[required]:focus,
      textarea[required]:focus,
      .form-control[required]:focus,
      .form-select[required]:focus,
      input.form-control[required]:focus,
      select.form-select[required]:focus {
        border: 3px solid #8fbc8f !important;
        border-color: #8fbc8f !important;
        box-shadow: 0 0 0 0.3rem rgba(143, 188, 143, 0.25) !important;
        outline: none !important;
      }

      /* Test avec une classe spécifique */
      .required-field {
        border: 4px solid #a2c5a2 !important;
        background-color: #f0f8f0 !important;
      }
      /* Année de la date d'achat — largeur minimale pour ne pas tronquer l'année */
      select[id$="_date_achat_1i"] {
        min-width: 78px;
      }
    </style>

    <!-- Champ caché pour la région -->
    <%= f.hidden_field :region, value: "flandre" %>

    <!-- Première rangée: Nom du bien et Adresse -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 1: Nom du bien -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-tag text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Nom du bien</h5>
                    <p class="text-muted small mb-0">Identification de votre propriété</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :titre,
                        label: '<i class="bi bi-tag me-2 text-primary"></i>Nom ou titre du bien'.html_safe,
                        placeholder: "ex. Ma maison Flandre, Appartement Gand...",
                        hint: '<i class="bi bi-info-circle me-1"></i>Donnez un nom à votre bien pour le retrouver facilement'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>

                  <!-- Photo du bien -->
                  <div class="col-12" data-controller="image-preview">
                    <%= f.input :photo,
                        as: :file,
                        label: '<i class="bi bi-camera me-2 text-primary"></i>Photo du bien'.html_safe,
                        hint: '<i class="bi bi-info-circle me-1"></i>Ajoutez une photo de votre bien (JPG, PNG, max 5 Mo)'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          accept: "image/*",
                          data: {
                            image_preview_target: "input",
                            action: "change->image-preview#previewImage"
                          }
                        } %>

                    <!-- Zone de prévisualisation -->
                    <div data-image-preview-target="preview" class="mt-2" style="display: none;">
                      <img data-image-preview-target="previewImg" src="" alt="Aperçu" class="img-thumbnail" style="max-width: 200px; max-height: 150px;">
                    </div>

                    <!-- Photo existante -->
                    <% if property.photo.attached? %>
                      <div class="mt-2 position-relative d-inline-block">
                        <%= image_tag property.photo, class: "img-thumbnail", style: "max-width: 200px; max-height: 150px; display: block;" %>
                        <% if property.persisted? %>
                          <%= link_to purge_photo_property_path(property),
                              data: { turbo_method: :delete, turbo_confirm: "Supprimer cette photo ?" },
                              class: "btn btn-danger btn-sm position-absolute top-0 end-0 m-1 p-1 lh-1",
                              title: "Supprimer la photo",
                              style: "width: 26px; height: 26px;" do %>
                            <i class="bi bi-trash3" style="font-size: 0.75rem;"></i>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 2: Adresse -->
          <div class="col-lg-8">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-geo-alt text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Adresse du bien</h5>
                    <p class="text-muted small mb-0">Localisation de votre propriété</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-md-8">
                    <%= f.input :rue,
                        label: '<i class="bi bi-signpost me-2 text-success"></i>Rue'.html_safe,
                        placeholder: "ex. Rue de l'Énergie",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :numero,
                        label: '<i class="bi bi-hash me-2 text-success"></i>Numéro'.html_safe,
                        placeholder: "ex. 24",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :code_postal,
                        label: '<i class="bi bi-mailbox me-2 text-success"></i>Code postal'.html_safe,
                        placeholder: "ex. 9000",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-8">
                    <%= f.input :commune,
                        label: '<i class="bi bi-building me-2 text-success"></i>Commune'.html_safe,
                        placeholder: "ex. Gand",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                    <%= f.input :numero_cadastre,
                        label: '<i class="bi bi-map me-2 text-success"></i>Référence cadastrale'.html_safe,
                        placeholder: "ex. A 0123/00",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Deuxième rangée: Classification du bien et Statut de propriété -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 3: Type de bien, usage et profil -->
          <div class="col-lg-6">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-house text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Type de bien & Occupation</h5>
                    <p class="text-muted small mb-0">Classification et usage de votre bien</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :type_bien_flandre,
                        label: '<i class="bi bi-house me-2 text-warning"></i>Type de bien'.html_safe,
                        as: :select,
                        collection: [
                          ["Maison unifamiliale", "maison"],
                          ["Appartement en copropriété", "appartement_copro"],
                          ["Appartement non en copropriété", "appartement"],
                          ["Immeuble à plusieurs unités d'habitation", "immeuble_appartements"],
                          ["Non logement", "non_logement"]
                        ],
                        prompt: "-- Sélectionnez le type de bien --",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-12">
                    <%= f.input :usage_flandre,
                        label: '<i class="bi bi-key me-2 text-warning"></i>Usage du bien'.html_safe,
                        as: :select,
                        collection: [
                          ["Résidence principale", "residence_principale"],
                          ["Logement loué", "location"],
                          ["Autre", "autre"]
                        ],
                        prompt: "-- Sélectionnez l'usage --",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-12">
                    <%= f.input :profil_demandeur,
                        label: '<i class="bi bi-person-check me-2 text-warning"></i>Profil du demandeur'.html_safe,
                        as: :select,
                        collection: [
                          ["Propriétaire occupant ou futur occupant", "proprietaire_occupant_ou_futur_occupant"],
                          ["ASBL/Coopérative", "asbl_cooperative"],
                        ],
                        prompt: "-- Sélectionnez le profil --",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 4: Statut de propriété, part et usage habitation -->
          <div class="col-lg-6">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background: linear-gradient(45deg, #6f42c1, #8b5cf6);">
                    <i class="bi bi-person-badge text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Statut de propriété</h5>
                    <p class="text-muted small mb-0">Votre relation au bien</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :type_propriete_flandre,
                        label: '<i class="bi bi-shield-check me-2" style="color: #6f42c1;"></i>Statut de propriété'.html_safe,
                        as: :select,
                        collection: [
                          ["Propriétaire occupant", "eigenaar_bewoner"],
                          ["Plein propriétaire", "volle_eigenaar"],
                          ["Copropriétaire", "mede_eigenaar"],
                          ["Usufruitier", "vruchtgebruiker"],
                          ["Nu-propriétaire", "naakte_eigenaar"],
                          ["Locataire", "huurder"],
                          ["Autre", "andere"]
                        ],
                        prompt: "-- Sélectionnez votre statut --",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-6">
                    <%= f.input :pourcentage_propriete,
                        label: '<i class="bi bi-percent me-2" style="color: #6f42c1;"></i>Part de propriété (%)'.html_safe,
                        placeholder: "ex. 100",
                        hint: '<i class="bi bi-info-circle me-1"></i>Min. 1% requis'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          min: "1",
                          max: "100",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-6">
                    <%= f.input :habitation_percentage,
                        label: '<i class="bi bi-house-door me-2" style="color: #6f42c1;"></i>Usage habitation (%)'.html_safe,
                        placeholder: "ex. 100",
                        hint: '<i class="bi bi-info-circle me-1"></i>Part du bien utilisée comme logement'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          min: "1",
                          max: "100",
                          required: true
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Troisième rangée: Informations d'achat et Domiciliation -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 5: Informations d'achat -->
          <div class="col-lg-6">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-info bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-credit-card text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Informations d'achat</h5>
                    <p class="text-muted small mb-0">Détails financiers du bien</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-md-6">
                    <%= f.input :valeur_achat,
                        label: '<i class="bi bi-currency-euro me-2 text-info"></i>Valeur d\'achat (€)'.html_safe,
                        placeholder: "ex. 250000",
                        hint: '<i class="bi bi-info-circle me-1"></i>Prix d\'achat du bien en euros'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          step: "0.01",
                          min: "0"
                        } %>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <label class="form-label text-dark fw-medium mb-1">
                        <i class="bi bi-calendar me-2 text-info"></i>Date d'achat
                      </label>
                      <div class="d-flex gap-2">
                        <%= f.date_select :date_achat,
                            { order: [:day, :month, :year],
                              start_year: 1800,
                              end_year: 2040,
                              include_blank: false,
                              use_month_names: %w[Janvier Février Mars Avril Mai Juin Juillet Août Septembre Octobre Novembre Décembre] },
                            { class: "form-select border-2 rounded-3 px-3",
                              style: "background: #f8f9fa; border-color: #e9ecef !important;" } %>
                      </div>
                      <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>Date d'acquisition du bien
                      </small>
                    </div>
                  </div>
                  <!-- Documents liés à l'achat -->
                  <% if @property.persisted? %>
                    <div class="col-12">
                      <div class="border-top pt-3 mt-1">
                        <small class="text-dark fw-medium d-block mb-2"><i class="bi bi-paperclip me-1"></i>Documents liés à l'achat</small>
                        <div class="row g-2">
                          <% [['acte_notarial', 'Acte notarial', 'bi-file-earmark-text'], ['compromis', 'Compromis de vente', 'bi-pen']].each do |key, label, icon| %>
                            <% docs_count = @property.documents.where(type_document: key).count %>
                            <div class="col-6">
                              <div class="card border rounded-3 text-center p-3">
                                <i class="bi <%= icon %> mb-1 text-muted"></i>
                                <div class="fw-medium" style="font-size:0.8rem;"><%= label %></div>
                                <div class="text-muted mb-2" style="font-size:0.72rem;"><%= docs_count %> doc(s)</div>
                                <%= link_to new_property_document_path(@property, type_document: key), class: "btn btn-outline-secondary btn-sm w-100", style: "font-size:0.75rem;" do %>
                                  <i class="bi bi-plus me-1"></i>Ajouter
                                <% end %>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 6: Éligibilité & Conditions -->
          <div class="col-lg-6">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-shield-check text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Éligibilité & Conditions</h5>
                    <p class="text-muted small mb-0">Domiciliation, situation et TVA</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <label class="form-label text-dark fw-medium mb-2">
                      <i class="bi bi-house-heart me-2 text-success"></i>Serez-vous domicilié sur ce bien après rénovation?
                    </label>
                    <%= f.input :domicilie_flandre,
                        label: false,
                        as: :radio_buttons,
                        collection: [['Oui', true], ['Non', false]],
                        wrapper_html: { class: "mb-1" },
                        input_html: { class: "form-check-input" } %>
                    <small class="form-text text-muted mb-3 d-block">
                      <i class="bi bi-info-circle me-1"></i>Obligatoire pour l'éligibilité aux primes Flandre
                    </small>
                  </div>
                  <hr class="my-2">
                  <div class="col-12">
                    <label class="form-label text-dark fw-medium mb-2">
                      <i class="bi bi-house-check me-2 text-warning"></i>Possédez-vous encore un autre logement/appartement/terrain en pleine propriété sur le territoire belge ou à l'étranger?
                    </label>
                    <%= f.input :autre_bien,
                        label: false,
                        as: :radio_buttons,
                        collection: [['Oui', 'oui'], ['Non', 'non']],
                        wrapper_html: { class: "mb-3" },
                        input_html: { class: "form-check-input" } %>
                  </div>
                  <div class="col-12">
                    <label class="form-label text-dark fw-medium mb-2">
                      <i class="bi bi-shield-check me-2 text-warning"></i>Êtes-vous un client protégé (tarif social énergie)?
                    </label>
                    <%= f.input :client_protege_flandre,
                        label: false,
                        as: :radio_buttons,
                        collection: [['Oui', true], ['Non', false]],
                        wrapper_html: { class: "mb-1" },
                        input_html: { class: "form-check-input" } %>
                    <small class="form-text text-muted mb-3 d-block">
                      <i class="bi bi-info-circle me-1"></i>Client protégé = catégorie 4 automatique (primes maximales)
                    </small>
                  </div>
                  <hr class="my-2">
                  <div class="col-12">
                    <label class="form-label text-dark fw-medium mb-2">
                      <i class="bi bi-hammer me-2 text-secondary"></i>Le logement a-t-il été démoli puis reconstruit avec maintien de murs par exemple pour bénéficier du taux de 6% de TVA?
                    </label>
                    <%= f.input :reconstruit,
                        label: false,
                        as: :radio_buttons,
                        collection: [['Oui', 'oui'], ['Non', 'non']],
                        wrapper_html: { class: "mb-0" },
                        input_html: { class: "form-check-input" } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>


    <!-- Quatrième rangée: Caractéristiques spécifiques à la Flandre -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 7: Caractéristiques techniques -->
          <div class="col-lg-12">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-danger bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-gear text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Caractéristiques spécifiques à la Flandre</h5>
                    <p class="text-muted small mb-0">Informations techniques requises</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-md-4">
                    <%= f.input :annee_construction,
                        label: '<i class="bi bi-hammer me-2 text-danger"></i>Année de construction'.html_safe,
                        placeholder: "ex. 1985",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          min: "1800",
                          max: "2025",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :date_raccordement_electrique,
                        label: '<i class="bi bi-lightning me-2 text-danger"></i>Raccordement électrique'.html_safe,
                        placeholder: "Année avant 2006",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          min: "1900",
                          max: "2025",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :chauffage_post_renovation_flandre,
                        label: '<i class="bi bi-thermometer-half me-2 text-danger"></i>Système de chauffage après rénovation'.html_safe,
                        placeholder: "ex. Pompe à chaleur",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                  <div class="col-md-6">
                    <%= f.input :ean_flandre,
                        label: '<i class="bi bi-plug me-2 text-danger"></i>Numéro EAN (Flandre)'.html_safe,
                        placeholder: "ex. 5412345678901",
                        hint: '<i class="bi bi-info-circle me-1"></i>Code EAN de votre compteur électrique (obligatoire pour les primes Flandre)'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-6">
                    <%= f.input :surface_habitable,
                        label: '<i class="bi bi-rulers me-2 text-info"></i>Surface habitable (m²)'.html_safe,
                        placeholder: "ex. 120",
                        hint: '<i class="bi bi-info-circle me-1"></i>Surface des espaces habitables du logement'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          min: "1",
                          max: "10000",
                          step: "0.01"
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>
      </div>
    </div>

    <!-- Cinquième rangée: Certificat PEB -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 9: Questions PEB -->
          <div class="col-lg-12">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-clipboard-data text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Certificat PEB</h5>
                    <p class="text-muted small mb-0">Performance énergétique</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <!-- Bouton scan PEB -->
                <div class="mb-3">
                  <button type="button" id="btn-scan-peb-flandre"
                          class="btn btn-outline-success btn-sm rounded-3 px-3"
                          data-bs-toggle="tooltip"
                          title="Scanner votre PEB pour remplissage automatique">
                    <i class="bi bi-file-earmark-bar-graph me-1"></i>Scanner le PEB
                  </button>
                  <input type="file" id="peb-file-input-flandre" accept=".pdf,image/jpeg,image/png" class="d-none">
                  <div id="peb-ocr-status-flandre" class="d-none mt-2">
                    <div class="alert border-0 rounded-3 py-2 mb-0" id="peb-ocr-alert-flandre">
                      <div class="d-flex align-items-center gap-2">
                        <div id="peb-ocr-spinner-flandre" class="spinner-border spinner-border-sm text-success d-none" role="status"></div>
                        <i id="peb-ocr-icon-flandre" class="bi d-none"></i>
                        <span id="peb-ocr-message-flandre" class="small"></span>
                      </div>
                    </div>
                  </div>
                </div>
                <!-- Données OCR -->
                <% peb_fl = property&.peb_donnees&.order(created_at: :desc)&.first %>
                <div class="row g-2 mb-3">
                  <div class="col-2" style="min-width:55px">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-award me-1 text-success"></i>Label</label>
                    <div id="peb-label-display-flandre"
                      class="form-control border-2 rounded-3 px-2 bg-light text-center fw-bold fs-5 <%= peb_fl&.label_peb ? 'text-' + peb_fl.couleur_bootstrap : 'text-muted' %>"
                      style="border-color:#e9ecef !important;"><%= peb_fl&.label_peb || '—' %></div>
                  </div>
                  <div class="col-3">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-speedometer me-1 text-success"></i>Score énergétique</label>
                    <div id="peb-score-display-flandre" class="form-control border-2 rounded-3 px-3 bg-light text-muted small" style="border-color:#e9ecef !important;">
                      <%= peb_fl&.score_ep_formate || '—' %>
                    </div>
                  </div>
                  <div class="col-2">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-arrows-angle-expand me-1 text-success"></i>Surf. (m²)</label>
                    <div id="peb-surface-display-flandre" class="form-control border-2 rounded-3 px-3 bg-light text-muted small" style="border-color:#e9ecef !important;">
                      <%= peb_fl&.surface_reference ? "#{peb_fl.surface_reference.to_i} m²" : '—' %>
                    </div>
                  </div>
                  <div class="col-5">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-hash me-1 text-success"></i>N° certificat</label>
                    <div id="peb-numero-display-flandre" class="form-control border-2 rounded-3 px-3 bg-light text-muted" style="border-color:#e9ecef !important;font-size:0.72rem;">
                      <%= peb_fl&.numero_certificat || '—' %>
                    </div>
                  </div>
                  <div class="col-3">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-calendar-check me-1 text-success"></i>Date cert.</label>
                    <div id="peb-date-cert-display-flandre" class="form-control border-2 rounded-3 px-3 bg-light text-muted small" style="border-color:#e9ecef !important;">
                      <%= peb_fl&.date_certificat&.strftime('%d/%m/%Y') || '—' %>
                    </div>
                  </div>
                  <div class="col-3">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-calendar-x me-1 <%= peb_fl&.perime? ? 'text-danger' : 'text-success' %>"></i>Valide jusqu'au</label>
                    <div id="peb-date-valid-display-flandre"
                      class="form-control border-2 rounded-3 px-3 bg-light small <%= peb_fl&.perime? ? 'text-danger' : 'text-muted' %>"
                      style="border-color:#e9ecef !important;">
                      <%= peb_fl&.date_validite&.strftime('%d/%m/%Y') || '—' %>
                    </div>
                  </div>
                </div>
                <div class="row g-2">
                  <div class="col-12">
                    <label class="form-label text-dark fw-medium mb-3">
                      <i class="bi bi-graph-down me-2 text-success"></i>Le certificat PEB indique-t-il un label E ou F avant rénovation?
                    </label>
                    <%= f.input :peb,
                        label: false,
                        as: :radio_buttons,
                        collection: [['Oui', 'efg'], ['Non', 'autre']],
                        wrapper_html: { class: "mb-3" },
                        input_html: { class: "form-check-input" } %>
                  </div>

                </div>
              </div>
            </div>
          </div>

<script>
(function () {
  var propertyId = '<%= property&.id %>';
  var btn=document.getElementById('btn-scan-peb-flandre'),
      inp=document.getElementById('peb-file-input-flandre'),
      sta=document.getElementById('peb-ocr-status-flandre'),
      ale=document.getElementById('peb-ocr-alert-flandre'),
      spi=document.getElementById('peb-ocr-spinner-flandre'),
      ico=document.getElementById('peb-ocr-icon-flandre'),
      msg=document.getElementById('peb-ocr-message-flandre');
  if (!btn) return;
  btn.addEventListener('click', function(){inp.click();});
  inp.addEventListener('change', function(){
    var file=inp.files[0]; if(!file) return;
    sta.classList.remove('d-none');
    ale.className='alert border-0 rounded-3 py-2 mb-0 alert-secondary';
    spi.classList.remove('d-none'); ico.classList.add('d-none');
    msg.textContent='Analyse du PEB en cours…'; btn.disabled=true;
    var fd=new FormData(); fd.append('file',file);
    if(propertyId) fd.append('property_id',propertyId);
    fetch('<%= ocr_scan_peb_path %>',{method:'POST',headers:{'X-CSRF-Token':document.querySelector('meta[name="csrf-token"]').content},body:fd})
    .then(function(r){return r.json();})
    .then(function(d){
      spi.classList.add('d-none'); btn.disabled=false;
      if(!d.success){show('danger','bi-exclamation-triangle-fill',d.error||'Extraction échouée.');return;}
      set('peb-label-display-flandre', d.label_peb||'—');
      set('peb-score-display-flandre', d.score_ep?d.score_ep+' kWh/(m².an)':'—');
      set('peb-surface-display-flandre', d.surface_reference?d.surface_reference+' m²':'—');
      set('peb-numero-display-flandre', d.numero_certificat||'—');
      set('peb-date-cert-display-flandre', d.date_certificat||'—');
      set('peb-date-valid-display-flandre', d.date_validite||'—');
      show(d.extraction_complete?'success':'warning', d.extraction_complete?'bi-check-circle-fill':'bi-exclamation-circle-fill', d.message);
    })
    .catch(function(){spi.classList.add('d-none');btn.disabled=false;show('danger','bi-exclamation-triangle-fill','Erreur réseau.');});
    inp.value='';
  });
  function set(id,v){var e=document.getElementById(id);if(e)e.textContent=v;}
  function show(t,ic,m){ale.className='alert border-0 rounded-3 py-2 mb-0 alert-'+t;ico.className='bi '+ic+' text-'+t;ico.classList.remove('d-none');msg.textContent=m;}
})();
</script>


        </div>
      </div>
    </div>

  <!-- Actions -->
  <div class="row justify-content-center mb-5">
    <div class="col-lg-10">
      <div class="row g-4">
        <div class="col-lg-12">
          <div class="card rounded-4">
            <div class="card-header bg-white border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                  <i class="bi bi-gear text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal">Actions</h5>
                  <p class="text-muted small mb-0">Gérer votre propriété</p>
                </div>
              </div>
            </div>
            <div class="card-body px-4 py-3">
              <div class="d-flex justify-content-end gap-2">
                <%= link_to properties_path, class: "btn btn-outline-secondary rounded-3 py-2" do %>
                  <i class="bi bi-arrow-left me-2"></i>Annuler
                <% end %>
                <%= f.submit "Sauvegarder les données", class: 'btn btn-primary rounded-3 py-2 fw-medium' %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% end %>
</div>

<!-- CSS personnalisé pour le design professionnel -->
<style>
  .form-control:focus, .form-select:focus {
    border-color: #0d6efd !important;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15) !important;
  }

  .card {
    transition: all 0.3s ease;
  }

  .card:hover {
    transform: translateY(-2px);
  }

  .btn {
    transition: all 0.2s ease;
  }

  .btn:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .bg-light {
    background-color: #f8f9fa !important;
  }

  /* Simple Form customizations */
  .form-text {
    margin-top: 0.25rem;
  }

  .form-check-input:checked {
    background-color: #0d6efd;
    border-color: #0d6efd;
  }
</style>
