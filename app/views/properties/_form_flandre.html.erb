<%= simple_form_for @property, local: true do |f| %>
  <!-- Champ caché pour la région -->
  <%= f.hidden_field :region, value: "flandre" %>

  <!-- Section Adresse -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-geo-alt me-2"></i>
      Informations sur le bien à rénover
    </h5>

    <%= f.input :rue,
        label: "Straat*",
        placeholder: "bv. Energiestraat",
        wrapper_html: { class: "mb-3" },
        input_html: { class: "form-control-custom" } %>

    <div class="row g-3">
      <div class="col-md-3">
        <%= f.input :numero,
            label: "Nummer*",
            placeholder: "bv. 24",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :code_postal,
            label: "Postcode*",
            placeholder: "bv. 9000",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :commune,
            label: "Gemeente*",
            placeholder: "bv. Gent",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :region,
            label: "Regio*",
            input_html: { class: "form-control-custom", value: "Vlaanderen", readonly: true } %>
      </div>
    </div>
  </div>

  <!-- Section Type de bien -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-building me-2"></i>
      Type woning
    </h5>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :type_propriete,
            label: "Type eigendom",
            as: :select,
            collection: [
              ["Volledig eigenaar", "propriétaire complet"],
              ["Mede-eigenaar met echtgenoot", "copropriétaire"],
              ["Naakte eigenaar", "nu-propriétaire"],
              ["Vruchtgebruiker", "usufruitier"]
            ],
            prompt: "-- Selecteer type eigendom --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :type,
            label: "Type woning*",
            as: :select,
            collection: [
              ["Eengezinswoning", "maison"],
              ["Appartement", "appartement"],
              ["Gebouw met meerdere wooneenheden", "immeuble de rapport"]
            ],
            prompt: "-- Selecteer type woning --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-12">
        <%= f.input :occupation,
            label: "Bewoning*",
            as: :select,
            collection: [
              ["Hoofdverblijfplaats", "résidence principale"],
              ["Verhuurde woning", "location"],
              ["Andere", "autre"]
            ],
            prompt: "-- Selecteer type bewoning --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Caractéristiques spécifiques à la Flandre -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-info-circle me-2"></i>
      Vlaamse specifieke kenmerken
    </h5>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :annee_construction,
            label: "Bouwjaar*",
            placeholder: "bv. 1985",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :date_raccordement_electrique,
            label: "Datum aansluiting elektriciteitsnet*",
            placeholder: "Let op: datum vóór 1 januari 2006!!!",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :numero_ean,
            label: "EAN-nummer*",
            placeholder: "bv. 5412345678901",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :numero_cadastre,
            label: "Kadastraal perceelnummer (optioneel)",
            placeholder: "bv. 136E",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-3">
      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Bezit u nog een andere woning/appartement/terrein in volle eigendom?</h6>
        <%= f.input :autre_bien,
            label: false,
            as: :radio_buttons,
            collection: [['Ja', 'oui'], ['Nee', 'non']],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Geeft het EPC-certificaat een label E of F aan vóór renovatie?</h6>
        <%= f.input :peb,
            label: false,
            as: :radio_buttons,
            collection: [['Ja', 'ef'], ['Nee', 'autre']],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
    </div>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex justify-content-end mt-4">
    <%= link_to "Annuleren", properties_path, class: "btn btn-outline-secondary me-2" %>
    <%= f.submit "Eigendom toevoegen", class: "btn btn-primary-custom" %>
  </div>
<% end %>
