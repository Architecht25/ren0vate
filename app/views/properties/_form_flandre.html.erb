<%= simple_form_for @property, local: true do |f| %>
  <!-- Champ caché pour la région -->
  <%= f.hidden_field :region, value: "flandre" %>

  <!-- Section Adresse -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-geo-alt me-2"></i>
      Informations sur le bien à rénover
    </h5>

    <%= f.input :rue,
        label: "Rue*",
        placeholder: "ex. Rue de l'Énergie",
        wrapper_html: { class: "mb-3" },
        input_html: { class: "form-control-custom" } %>

    <div class="row g-3">
      <div class="col-md-3">
        <%= f.input :numero,
            label: "Numéro*",
            placeholder: "ex. 24",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>

      <div class="col-md-3">
        <%= f.input :code_postal,
            label: "Code postal*",
            placeholder: "ex. 9000",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>

      <div class="col-md-4">
        <%= f.input :commune,
            label: "Commune*",
            placeholder: "ex. Gand",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Type de bien -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-building me-2"></i>
      Type de logement
    </h5>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :type_propriete,
            label: "Type de propriété",
            as: :select,
            collection: [
              ["Propriétaire complet", "propriétaire complet"],
              ["Copropriétaire avec époux/épouse", "copropriétaire"],
              ["Nu-propriétaire", "nu-propriétaire"],
              ["Usufruitier", "usufruitier"], ["Non propriétaire", "non propriétaire"]
            ],
            prompt: "-- Sélectionnez le type de propriété --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :type,
            label: "Type de logement*",
            as: :select,
            collection: [
              ["Maison unifamiliale", "maison"],
              ["Appartement en copropriété", "appartement en copropriété"], ["Appartement non en copropriété", "appartement nonen copropriété"],
              ["Immeuble à plusieurs unités d'habitation", "immeuble de rapport"], ["Non logement", "non logement"]
            ],
            prompt: "-- Sélectionnez le type de logement --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-12">
        <%= f.input :occupation,
            label: "Occupation*",
            as: :select,
            collection: [
              ["Résidence principale", "résidence principale"],
              ["Logement loué", "location"],
              ["Autre", "autre"]
            ],
            prompt: "-- Sélectionnez le type d'occupation --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Caractéristiques spécifiques à la Flandre -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-info-circle me-2"></i>
      Caractéristiques spécifiques à la Flandre
    </h5>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :annee_construction,
            label: "Année de construction*",
            placeholder: "ex. 1985",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :date_raccordement_electrique,
            label: "Date de raccordement au réseau électrique*",
            placeholder: "Attention: date avant le 1er janvier 2006!!!",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :numero_ean,
            label: "Numéro EAN*",
            placeholder: "ex. 5412345678901",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :numero_cadastre,
            label: "Numéro de parcelle cadastrale (optionnel)",
            placeholder: "ex. 136E",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-3">
      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Possédez-vous encore un autre logement/appartement/terrain en pleine propriété?</h6>
        <%= f.input :autre_bien,
            label: false,
            as: :radio_buttons,
            collection: [['Oui', 'oui'], ['Non', 'non']],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>

      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Le certificat PEB indique-t-il un label E, F ou inférieur (G) avant rénovation?</h6>
        <%= f.input :peb,
            label: false,
            as: :radio_buttons,
            collection: [['Oui', 'efg'], ['Non', 'autre']],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>

      <div class="col-md-6">
        <%= f.input :date_peb_avant_travaux,
            label: "Date de production du certificat PEB avant travaux*",
            placeholder: "ex. 01/01/2020",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "date" } %>
        <small class="form-text text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Les certificats établis avant le 1er janvier 2019 ne sont plus valables pour la demande de prime PEB
        </small>
      </div>

      <div class="col-md-6">
        <%= f.input :date_peb_apres_travaux,
            label: "Date de production du certificat PEB après travaux",
            placeholder: "ex. 01/01/2024",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "date" } %>
      </div>

      <div class="col-md-6">
        <h6 class="text-primary-custom mb-2 fw-normal">Le logement est-il un bâtiment qui a été démoli mais en gardant des résidus pour bénéficier de la TVA à 6% ?</h6>
        <%= f.input :reconstruit,
            label: false,
            as: :radio_buttons,
            collection: [['Oui', 'oui'], ['Non', 'non']],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>

    </div>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex justify-content-end mt-4">
    <%= link_to "Annuler", properties_path, class: "btn btn-outline-secondary me-2" %>
    <%= f.submit "Ajouter la propriété", class: "btn btn-primary-custom" %>
  </div>
<% end %>
