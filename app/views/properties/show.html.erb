<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-house-door"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal"><%= @property.name %></h1>
        <small class="text-muted-custom"><%= @property.full_address %></small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to dashboard_path, class: "btn btn-light" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour dashboard
      <% end %>
      <%= link_to edit_property_path(@property), class: "btn btn-primary-custom" do %>
        <i class="bi bi-pencil me-1"></i>Modifier
      <% end %>
      <%= link_to property_path(@property),
          class: "btn btn-outline-danger",
          data: {
            confirm: "Êtes-vous sûr de vouloir supprimer ce bien ? Cette action supprimera également tous les documents, simulations et demandes liés. Cette action est irréversible.",
            turbo_method: :delete
          } do %>
        <i class="bi bi-trash me-1"></i>Supprimer
      <% end %>
    </div>
  </div>

  <!-- Barre de progression globale -->
  <div class="card border-0 bg-light-custom shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0 text-primary-custom">Complétude globale</h6>
        <span class="badge bg-<%= @property.completion_status %> rounded-pill">
          <%= @completion_stats[:overall] %>%
        </span>
      </div>
      <div class="progress" style="height: 8px;">
        <div class="progress-bar bg-<%= @property.completion_status %>"
             style="width: <%= @completion_stats[:overall] %>%"></div>
      </div>
      <% if @actions_available[:missing_fields].any? %>
        <small class="text-muted-custom mt-2 d-block">
          Champs manquants : <%= @actions_available[:missing_fields].join(', ') %>
        </small>
      <% end %>
    </div>
  </div>

  <!-- Sections de complétude -->
  <div class="row g-4 mb-4">
    <!-- Section Informations administratives -->
    <div class="col-lg-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header bg-light-custom border-0 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <div class="icon-circle me-2">
              <i class="bi bi-file-text"></i>
            </div>
            <h6 class="mb-0 fw-normal">Informations administratives</h6>
          </div>
          <span class="badge <%= @property.admin_completion_class %> rounded-pill">
            <%= @completion_stats[:admin] %>%
          </span>
        </div>
        <div class="card-body">
          <ul class="list-unstyled mb-3">
            <li class="d-flex align-items-center mb-2">
              <i class="bi bi-<%= @property.rue.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
              <span class="<%= @property.rue.present? ? 'text-dark' : 'text-muted' %>">Adresse complète</span>
            </li>
            <li class="d-flex align-items-center mb-2">
              <% type_completed = case @property.region
                                  when 'wallonie'
                                    @property.type_propriete_wallonie.present?
                                  when 'flandre'
                                    @property.type_bien_flandre.present?
                                  when 'bruxelles'
                                    @property.type_bien_bruxelles.present?
                                  else
                                    @property.type.present?
                                  end %>
              <i class="bi bi-<%= type_completed ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
              <span class="<%= type_completed ? 'text-dark' : 'text-muted' %>">Type de bien</span>
            </li>
            <li class="d-flex align-items-center mb-2">
              <i class="bi bi-<%= @property.region.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
              <span class="<%= @property.region.present? ? 'text-dark' : 'text-muted' %>">Région</span>
            </li>
            <% case @property.region
               when 'wallonie' %>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.certificat_peb_wallonie.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.certificat_peb_wallonie.present? ? 'text-dark' : 'text-muted' %>">Certificat PEB</span>
              </li>
            <% when 'flandre' %>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.usage_flandre.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.usage_flandre.present? ? 'text-dark' : 'text-muted' %>">Usage du bien</span>
              </li>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.certificat_peb_flandre.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.certificat_peb_flandre.present? ? 'text-dark' : 'text-muted' %>">Certificat PEB</span>
              </li>
            <% when 'bruxelles' %>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.certificat_peb_bruxelles.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.certificat_peb_bruxelles.present? ? 'text-dark' : 'text-muted' %>">Certificat PEB</span>
              </li>
            <% end %>
          </ul>
          <%= link_to edit_property_path(@property), class: "btn btn-outline-primary btn-sm" do %>
            <i class="bi bi-pencil me-1"></i>Compléter
          <% end %>
        </div>
      </div>
    </div>

    <!-- Section Informations chantier -->
    <div class="col-lg-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header bg-light-custom border-0 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <div class="icon-circle me-2">
              <i class="bi bi-tools"></i>
            </div>
            <h6 class="mb-0 fw-normal">Informations chantier</h6>
          </div>
          <span class="badge <%= @property.chantier_completion_class %> rounded-pill">
            <%= @completion_stats[:chantier] %>%
          </span>
        </div>
        <div class="card-body">
          <ul class="list-unstyled mb-3">
            <li class="d-flex align-items-center mb-2">
              <i class="bi bi-<%= @property.annee_construction.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
              <span class="<%= @property.annee_construction.present? ? 'text-dark' : 'text-muted' %>">Année construction</span>
            </li>
            <% case @property.region
               when 'wallonie' %>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.surface_habitable_wallonie.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.surface_habitable_wallonie.present? ? 'text-dark' : 'text-muted' %>">Surface habitable</span>
              </li>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.mode_chauffage_wallonie.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.mode_chauffage_wallonie.present? ? 'text-dark' : 'text-muted' %>">Mode de chauffage</span>
              </li>
            <% when 'flandre' %>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.ean_flandre.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.ean_flandre.present? ? 'text-dark' : 'text-muted' %>">Code EAN</span>
              </li>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.chauffage_post_renovation_flandre.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.chauffage_post_renovation_flandre.present? ? 'text-dark' : 'text-muted' %>">Système chauffage</span>
              </li>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.parcelle_flandre.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.parcelle_flandre.present? ? 'text-dark' : 'text-muted' %>">Numéro parcelle</span>
              </li>
            <% when 'bruxelles' %>
              <!-- Champs spécifiques Bruxelles à définir -->
            <% else %>
              <!-- Fallback vers anciens champs génériques -->
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.numero_ean.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.numero_ean.present? ? 'text-dark' : 'text-muted' %>">Numéro EAN</span>
              </li>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.peb.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.peb.present? ? 'text-dark' : 'text-muted' %>">Certificat PEB</span>
              </li>
            <% end %>
          </ul>

          <!-- Section projets/chantiers -->
          <div class="border-top pt-3 mt-3">
            <h6 class="mb-2 fw-normal">
              <i class="bi bi-kanban me-1"></i>Projets actifs
              <span class="badge bg-primary rounded-pill ms-2"><%= @property.projects.count %></span>
            </h6>
            <% if @property.projects.any? %>
              <% @property.projects.limit(3).each do |project| %>
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <small class="text-muted"><%= truncate(project.nom, length: 20) %></small>
                  <span class="badge bg-<%= case project.statut
                                           when 'preparation' then 'secondary'
                                           when 'en_cours' then 'warning'
                                           when 'termine' then 'success'
                                           else 'secondary'
                                           end %> rounded-pill text-white">
                    <%= project.statut&.humanize || 'Non défini' %>
                  </span>
                </div>
              <% end %>
              <% if @property.projects.count > 3 %>
                <small class="text-muted">et <%= @property.projects.count - 3 %> autre(s)...</small>
              <% end %>
            <% else %>
              <small class="text-muted">Aucun projet créé</small>
            <% end %>
          </div>

          <div class="d-grid gap-2 mt-3">
            <%= link_to edit_property_path(@property), class: "btn btn-outline-primary btn-sm" do %>
              <i class="bi bi-tools me-1"></i>Compléter infos
            <% end %>
            <%= link_to projects_path(property_id: @property.id), class: "btn btn-primary btn-sm" do %>
              <i class="bi bi-kanban me-1"></i>Gérer projets
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Section Éligibilité primes -->
    <div class="col-lg-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header bg-light-custom border-0 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <div class="icon-circle me-2">
              <i class="bi bi-currency-euro"></i>
            </div>
            <h6 class="mb-0 fw-normal">Éligibilité primes</h6>
          </div>
          <span class="badge <%= @property.primes_completion_class %> rounded-pill">
            <%= @completion_stats[:primes] %>%
          </span>
        </div>
        <div class="card-body">
          <% if @property.simulations.any? %>
            <p class="text-success mb-3">
              <i class="bi bi-check-circle-fill me-2"></i>
              <%= pluralize(@property.simulations.count, 'simulation') %> réalisée(s)
            </p>
          <% else %>
            <p class="text-muted mb-3">
              <i class="bi bi-info-circle me-2"></i>
              Aucune simulation réalisée
            </p>
          <% end %>
          <%= link_to simulations_path, class: "btn btn-outline-success btn-sm" do %>
            <i class="bi bi-calculator me-1"></i>Calculer primes
          <% end %>
        </div>
      </div>
    </div>

    <!-- Section Documents -->
    <div class="col-lg-3">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-header bg-light-custom border-0 d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center">
            <div class="icon-circle me-2">
              <i class="bi bi-files"></i>
            </div>
            <h6 class="mb-0 fw-normal">Documents</h6>
          </div>
          <span class="badge <%= @property.documents_completion_class %> rounded-pill">
            <%= @completion_stats[:documents] %>%
          </span>
        </div>
        <div class="card-body">
          <% if @property.documents.any? %>
            <p class="text-success mb-3">
              <i class="bi bi-check-circle-fill me-2"></i>
              <%= @property.completed_documents_count %>/<%= @property.total_required_documents %> documents
            </p>
          <% else %>
            <p class="text-muted mb-3">
              <i class="bi bi-info-circle me-2"></i>
              Aucun document uploadé
            </p>
          <% end %>
          <%= link_to documents_path, class: "btn btn-outline-info btn-sm" do %>
            <i class="bi bi-cloud-upload me-1"></i>Gérer documents
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Section spécifique pour l'éligibilité Wallonie -->
  <% if @property.region == 'wallonie' %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light-custom border-0">
        <div class="d-flex align-items-center">
          <div class="icon-circle me-3">
            <i class="bi bi-award"></i>
          </div>
          <div>
            <h5 class="mb-0 fw-normal text-primary-custom">Informations d'éligibilité aux primes Wallonie</h5>
            <small class="text-muted">Critères requis pour les subventions de rénovation</small>
          </div>
        </div>
      </div>
      <div class="card-body">
        <div class="row g-4">
          <div class="col-md-6">
            <h6 class="text-success mb-3">
              <i class="bi bi-house-check me-2"></i>Occupation et usage
            </h6>
            <ul class="list-unstyled">
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.occupation.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.occupation.present? ? 'text-dark' : 'text-muted' %>">
                  Type d'occupation:
                  <% if @property.occupation.present? %>
                    <strong><%= @property.occupation.humanize %></strong>
                    <% if @property.occupation == 'residence_principale' %>
                      <span class="badge bg-success ms-2">✓ Éligible</span>
                    <% end %>
                  <% else %>
                    <em>Non renseigné</em>
                  <% end %>
                </span>
              </li>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.habitation_percentage.present? && @property.habitation_percentage >= 50 ? 'check-circle-fill text-success' : (@property.habitation_percentage.present? ? 'x-circle-fill text-danger' : 'circle text-muted') %> me-2"></i>
                <span class="<%= @property.habitation_percentage.present? ? 'text-dark' : 'text-muted' %>">
                  Pourcentage d'habitation:
                  <% if @property.habitation_percentage.present? %>
                    <strong><%= @property.habitation_percentage %>%</strong>
                    <% if @property.habitation_percentage >= 50 %>
                      <span class="badge bg-success ms-2">✓ Éligible (≥50%)</span>
                    <% else %>
                      <span class="badge bg-danger ms-2">✗ Non éligible (<50%)</span>
                    <% end %>
                  <% else %>
                    <em>Non renseigné</em>
                  <% end %>
                </span>
              </li>
            </ul>
          </div>

          <div class="col-md-6">
            <h6 class="text-info mb-3">
              <i class="bi bi-building me-2"></i>Propriété et bâtiment
            </h6>
            <ul class="list-unstyled">
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.type_propriete_wallonie.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-2"></i>
                <span class="<%= @property.type_propriete_wallonie.present? ? 'text-dark' : 'text-muted' %>">
                  Statut propriétaire:
                  <% if @property.type_propriete_wallonie.present? %>
                    <strong><%= @property.type_propriete_wallonie.humanize %></strong>
                    <% proprietary_types = %w[proprietaire_occupant copropriétaire nu_proprietaire usufruitier plein_proprietaire] %>
                    <% if proprietary_types.include?(@property.type_propriete_wallonie) %>
                      <span class="badge bg-success ms-2">✓ Éligible</span>
                    <% end %>
                  <% else %>
                    <em>Non renseigné</em>
                  <% end %>
                </span>
              </li>
              <li class="d-flex align-items-center mb-2">
                <i class="bi bi-<%= @property.annee_construction.present? && (Date.current.year - @property.annee_construction) > 15 ? 'check-circle-fill text-success' : (@property.annee_construction.present? ? 'x-circle-fill text-danger' : 'circle text-muted') %> me-2"></i>
                <span class="<%= @property.annee_construction.present? ? 'text-dark' : 'text-muted' %>">
                  Âge du logement:
                  <% if @property.annee_construction.present? %>
                    <strong><%= Date.current.year - @property.annee_construction %> ans</strong>
                    <% if (Date.current.year - @property.annee_construction) > 15 %>
                      <span class="badge bg-success ms-2">✓ Éligible (>15 ans)</span>
                    <% else %>
                      <span class="badge bg-danger ms-2">✗ Non éligible (≤15 ans)</span>
                    <% end %>
                  <% else %>
                    <em>Non renseigné</em>
                  <% end %>
                </span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Résumé d'éligibilité -->
        <div class="mt-4 p-3 bg-light rounded">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h6 class="mb-1">Statut d'éligibilité global</h6>
              <small class="text-muted">Basé sur les critères principaux pour les primes Wallonie</small>
            </div>
            <div>
              <% eligibility_checks = [
                   @property.occupation == 'residence_principale',
                   @property.habitation_percentage.present? && @property.habitation_percentage >= 50,
                   @property.type_propriete_wallonie.present? && %w[proprietaire_occupant copropriétaire nu_proprietaire usufruitier plein_proprietaire].include?(@property.type_propriete_wallonie),
                   @property.annee_construction.present? && (Date.current.year - @property.annee_construction) > 15
                 ]
                 passed_checks = eligibility_checks.count(true)
                 total_checks = eligibility_checks.length %>

              <% if passed_checks == total_checks %>
                <span class="badge bg-success px-3 py-2">
                  <i class="bi bi-check-circle-fill me-1"></i>
                  Éligible (<%= passed_checks %>/<%= total_checks %>)
                </span>
              <% elsif passed_checks >= (total_checks / 2.0) %>
                <span class="badge bg-warning px-3 py-2">
                  <i class="bi bi-exclamation-triangle-fill me-1"></i>
                  Partiellement éligible (<%= passed_checks %>/<%= total_checks %>)
                </span>
              <% else %>
                <span class="badge bg-danger px-3 py-2">
                  <i class="bi bi-x-circle-fill me-1"></i>
                  Non éligible (<%= passed_checks %>/<%= total_checks %>)
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Informations sur le seuil de demandes -->
  <% unless @actions_available[:can_request] %>
    <div class="alert alert-warning">
      <i class="bi bi-exclamation-triangle me-2"></i>
      <strong>Pour débloquer les demandes de primes :</strong>
      Complétez au minimum 80% des informations requises (actuellement <%= @completion_stats[:overall] %>%).
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
