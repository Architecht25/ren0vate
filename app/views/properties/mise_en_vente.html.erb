<div class="container-fluid px-4 py-4">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3" style="background: var(--bs-warning-bg-subtle);">
        <i class="bi bi-tag-fill text-warning"></i>
      </div>
      <div>
        <h1 class="h3 mb-0 fw-normal">
          Mise en vente
          <% if @property.en_vente? %>
            <span class="badge bg-warning text-dark ms-2 fs-6">En vente</span>
          <% elsif @property.vendu? %>
            <span class="badge bg-success ms-2 fs-6">Vendu</span>
          <% end %>
        </h1>
        <small class="text-muted">
          <i class="bi bi-house-door me-1"></i>
          <%= @property.titre.presence || @property.name %> —
          <%= @property.rue %> <%= @property.numero %>, <%= @property.commune %>
        </small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-arrow-left me-1"></i>Dashboard
      <% end %>
    </div>
  </div>

  <!-- Score de préparation -->
  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h5 class="mb-1">Préparation à la vente</h5>
              <p class="text-muted small mb-0">Documents obligatoires + DIU à transmettre</p>
            </div>
            <div class="text-center">
              <span class="display-6 fw-bold <%= @readiness_score >= 75 ? 'text-success' : @readiness_score >= 40 ? 'text-warning' : 'text-danger' %>">
                <%= @readiness_score %>%
              </span>
              <div class="text-muted small">prêt</div>
            </div>
          </div>
          <div class="progress" style="height: 10px;">
            <div class="progress-bar <%= @readiness_score >= 75 ? 'bg-success' : @readiness_score >= 40 ? 'bg-warning' : 'bg-danger' %>"
                 role="progressbar"
                 style="width: <%= @readiness_score %>%"
                 aria-valuenow="<%= @readiness_score %>"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">

    <!-- Colonne gauche : Checklists -->
    <div class="col-lg-8">

      <!-- Checklist documents légaux vente -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
          <div class="d-flex align-items-center">
            <i class="bi bi-shield-check text-primary me-2 fs-5"></i>
            <div>
              <h6 class="mb-0 fw-semibold">Documents légaux obligatoires (vente)</h6>
              <small class="text-muted">Obligatoires selon le droit belge pour toute vente immobilière</small>
            </div>
          </div>
        </div>
        <div class="card-body p-0">
          <ul class="list-group list-group-flush">
            <% @checklist_vente.each do |item| %>
              <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                <div class="d-flex align-items-center">
                  <% if item[:present] %>
                    <i class="bi bi-check-circle-fill text-success me-3 fs-5"></i>
                  <% else %>
                    <i class="bi bi-x-circle text-danger me-3 fs-5"></i>
                  <% end %>
                  <span class="<%= item[:present] ? '' : 'text-muted' %>">
                    <%= item[:label] %>
                  </span>
                </div>
                <% unless item[:present] %>
                  <%= link_to new_property_document_path(@property, type_document: item[:type]),
                      class: "btn btn-outline-primary btn-sm" do %>
                    <i class="bi bi-plus me-1"></i>Ajouter
                  <% end %>
                <% else %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">Présent</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <!-- Checklist DIU -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
          <div class="d-flex align-items-center">
            <i class="bi bi-folder2-open text-warning me-2 fs-5"></i>
            <div>
              <h6 class="mb-0 fw-semibold">DIU — Dossier d'Intervention Ultérieure</h6>
              <small class="text-muted">Documents à transmettre obligatoirement à l'acheteur lors de la vente</small>
            </div>
          </div>
        </div>
        <div class="card-body p-0">
          <ul class="list-group list-group-flush">
            <% @checklist_diu.each do |item| %>
              <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                <div class="d-flex align-items-center">
                  <% if item[:present] %>
                    <i class="bi bi-check-circle-fill text-success me-3 fs-5"></i>
                  <% else %>
                    <i class="bi bi-circle text-secondary me-3 fs-5"></i>
                  <% end %>
                  <span class="<%= item[:present] ? '' : 'text-muted' %>">
                    <%= item[:label] %>
                  </span>
                </div>
                <% unless item[:present] %>
                  <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Manquant</span>
                <% else %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">Présent</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
        <div class="card-footer bg-transparent border-top py-3 px-4">
          <p class="text-muted small mb-0">
            <i class="bi bi-info-circle me-1"></i>
            Les documents DIU se trouvent dans vos chantiers. Accédez à chaque chantier pour les compléter.
          </p>
        </div>
      </div>

      <!-- Alerte Conformité Loi Breyne -->
      <% loi_breyne_applicable = @projects.any? %>
      <% if loi_breyne_applicable %>
        <%
          all_project_docs = Document.where(project_id: @projects.pluck(:id)).pluck(:type_document)
          property_docs    = @property.documents.pluck(:type_document)
          present_types    = (all_project_docs + property_docs).uniq

          has_devis            = present_types.include?('devis') || @projects.any? { |p| p.contractor_devis_montant.to_f > 0 }
          has_assurance_dec    = present_types.include?('assurance_decennale')
          has_assurance_rc     = present_types.include?('assurance_rc_pro')
          has_pv_reception     = @projects.any? { |p| p.respond_to?(:pv_reception) && p.pv_reception.present? }
          has_attestation_conf = present_types.include?('attestation_conformite')
          has_plan_diu         = present_types.include?('plan_diu')

          breyne_items = [
            {
              label:       'Contrat écrit avec prix total et délai',
              detail:      'Obligatoire : le devis signé ou contrat d\'entreprise doit stipuler le prix total et le délai de livraison.',
              present:     has_devis,
              type:        'devis',
              required:    true
            },
            {
              label:       'Garantie décennale de l\'entrepreneur',
              detail:      'L\'entrepreneur doit être couvert par une assurance décennale pour les vices graves affectant la stabilité ou l\'étanchéité.',
              present:     has_assurance_dec,
              type:        'assurance_decennale',
              required:    true
            },
            {
              label:       'Assurance RC professionnelle entrepreneur',
              detail:      'Responsabilité civile professionnelle de l\'entrepreneur — couvre les dommages causés à tiers pendant les travaux.',
              present:     has_assurance_rc,
              type:        'assurance_rc_pro',
              required:    false
            },
            {
              label:       'PV de réception des travaux',
              detail:      'Le procès-verbal de réception (provisoire puis définitive) marque le départ de la garantie décennale.',
              present:     has_pv_reception,
              type:        nil,
              required:    true
            },
            {
              label:       'Attestation de conformité',
              detail:      'Confirme que les travaux sont conformes au permis d\'urbanisme et aux règles de l\'art.',
              present:     has_attestation_conf,
              type:        'attestation_conformite',
              required:    true
            },
            {
              label:       'Plans DIU transmis à l\'acheteur',
              detail:      'Le Dossier d\'Intervention Ultérieure (plans, fiches techniques, notices) est légalement dû à l\'acheteur.',
              present:     has_plan_diu,
              type:        'plan_diu',
              required:    false
            }
          ]

          breyne_done     = breyne_items.count { |i| i[:present] }
          breyne_required = breyne_items.count { |i| i[:required] }
          breyne_req_done = breyne_items.count { |i| i[:required] && i[:present] }
          breyne_color    = breyne_req_done == breyne_required ? 'success' : breyne_req_done >= breyne_required / 2 ? 'warning' : 'danger'
        %>
        <div class="card border-0 shadow-sm mb-4 border-start border-4 border-<%= breyne_color %>">
          <div class="card-header bg-transparent border-bottom py-3">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center">
                <i class="bi bi-shield-exclamation text-<%= breyne_color %> me-2 fs-5"></i>
                <div>
                  <h6 class="mb-0 fw-semibold">Conformité Loi Breyne — Points de vigilance</h6>
                  <small class="text-muted">
                    Applicable aux rénovations lourdes — arrêt CJUE 2025 · <%= breyne_req_done %>/<%= breyne_required %> points obligatoires couverts
                  </small>
                </div>
              </div>
              <span class="badge bg-<%= breyne_color %>"><%= breyne_done %>/<%= breyne_items.count %></span>
            </div>
          </div>
          <div class="card-body p-0">
            <ul class="list-group list-group-flush">
              <% breyne_items.each do |item| %>
                <li class="list-group-item px-4 py-3">
                  <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="d-flex align-items-start gap-3 flex-grow-1">
                      <% if item[:present] %>
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0 mt-1"></i>
                      <% elsif item[:required] %>
                        <i class="bi bi-x-circle text-danger fs-5 flex-shrink-0 mt-1"></i>
                      <% else %>
                        <i class="bi bi-circle text-secondary fs-5 flex-shrink-0 mt-1"></i>
                      <% end %>
                      <div>
                        <div class="fw-medium small <%= item[:present] ? '' : 'text-muted' %>">
                          <%= item[:label] %>
                          <% if item[:required] %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1" style="font-size: 0.6rem;">Obligatoire</span>
                          <% end %>
                        </div>
                        <small class="text-muted" style="font-size: 0.75rem;"><%= item[:detail] %></small>
                      </div>
                    </div>
                    <% if !item[:present] && item[:type].present? %>
                      <%= link_to new_property_document_path(@property, type_document: item[:type]),
                          class: "btn btn-outline-primary btn-sm flex-shrink-0" do %>
                        <i class="bi bi-plus me-1"></i>Ajouter
                      <% end %>
                    <% elsif item[:present] %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle flex-shrink-0">OK</span>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
          <div class="card-footer bg-transparent border-top py-3 px-4">
            <div class="d-flex align-items-start gap-2">
              <i class="bi bi-info-circle text-muted flex-shrink-0 mt-1"></i>
              <p class="text-muted small mb-0">
                La <strong>Loi Breyne</strong> (loi du 9 juillet 1971) s'applique aux constructions neuves et rénovations lourdes.
                Suite à l'arrêt de la CJUE (2025), les garanties de conformité sont renforcées.
                En cas de doute, consultez un notaire ou un architecte avant la signature du compromis.
                <a href="https://economie.fgov.be/fr/themes/entreprises/secteur-de-la-construction/loi-breyne" target="_blank" rel="noopener" class="text-decoration-none">
                  <i class="bi bi-box-arrow-up-right ms-1"></i>SPF Économie — Loi Breyne
                </a>
              </p>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Chantiers associés -->
      <% if @projects.any? %>
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-transparent border-bottom py-3">
            <div class="d-flex align-items-center">
              <i class="bi bi-hammer text-secondary me-2 fs-5"></i>
              <h6 class="mb-0 fw-semibold">Historique des chantiers (<%= @projects.count %>)</h6>
            </div>
          </div>
          <div class="card-body p-0">
            <ul class="list-group list-group-flush">
              <% @projects.each do |project| %>
                <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3">
                  <div>
                    <div class="fw-medium"><%= project.nom %></div>
                    <small class="text-muted">
                      <% if project.created_at %>
                        <i class="bi bi-calendar3 me-1"></i><%= project.created_at.strftime('%Y') %>
                      <% end %>
                      <% if project.entrepreneur_principal_entreprise.present? %>
                        · <i class="bi bi-building me-1"></i><%= project.entrepreneur_principal_entreprise %>
                      <% end %>
                    </small>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <% doc_count = project.documents.count %>
                    <span class="badge bg-light text-dark border">
                      <i class="bi bi-file-earmark me-1"></i><%= doc_count %> doc<%= doc_count != 1 ? 's' : '' %>
                    </span>
                    <%= link_to project_path(project), class: "btn btn-outline-secondary btn-sm" do %>
                      <i class="bi bi-eye"></i>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

    </div><!-- /col-lg-8 -->

    <!-- Colonne droite : Statut + Actions -->
    <div class="col-lg-4">

      <!-- Statut actuel -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
          <h6 class="mb-0 fw-semibold"><i class="bi bi-flag me-2"></i>Statut du bien</h6>
        </div>
        <div class="card-body p-4">
          <div class="text-center mb-4">
            <span class="badge <%= @property.statut_vente_badge_class %> fs-6 px-3 py-2">
              <%= @property.statut_vente_label %>
            </span>
            <% if @property.date_mise_en_vente.present? %>
              <div class="text-muted small mt-2">
                Mis en vente le <%= l(@property.date_mise_en_vente, format: :long) %>
              </div>
            <% end %>
          </div>

          <% if @property.actif? %>
            <!-- Formulaire activation vente -->
            <%= form_with url: activer_vente_property_path(@property), method: :patch, local: true do |f| %>
              <div class="mb-3">
                <%= f.label :prix_vente_estime, "Prix de vente estimé (optionnel)", class: "form-label small fw-medium" %>
                <div class="input-group">
                  <%= f.number_field :prix_vente_estime,
                      value: @property.prix_vente_estime,
                      class: "form-control",
                      placeholder: "ex: 350000",
                      min: 0, step: 1000 %>
                  <span class="input-group-text">€</span>
                </div>
              </div>
              <%= f.submit "Mettre en vente",
                  class: "btn btn-warning w-100 fw-semibold",
                  data: { confirm: "Activer le mode « En vente » pour ce bien ?" } %>
            <% end %>

          <% elsif @property.en_vente? %>
            <!-- Mise à jour prix -->
            <%= form_with url: activer_vente_property_path(@property), method: :patch, local: true do |f| %>
              <div class="mb-3">
                <%= f.label :prix_vente_estime, "Prix demandé", class: "form-label small fw-medium" %>
                <div class="input-group">
                  <%= f.number_field :prix_vente_estime,
                      value: @property.prix_vente_estime,
                      class: "form-control",
                      placeholder: "ex: 350000",
                      min: 0, step: 1000 %>
                  <span class="input-group-text">€</span>
                </div>
              </div>
              <%= f.submit "Mettre à jour le prix", class: "btn btn-outline-warning w-100 mb-2" %>
            <% end %>
            <%= button_to "Marquer comme vendu",
                marquer_vendu_property_path(@property),
                method: :patch,
                class: "btn btn-success w-100 mb-2",
                data: { confirm: "Confirmer la vente du bien ?" } %>
            <%= button_to "Désactiver le mode vente",
                desactiver_vente_property_path(@property),
                method: :patch,
                class: "btn btn-outline-secondary w-100",
                data: { confirm: "Retirer ce bien du mode « En vente » ?" } %>

          <% elsif @property.vendu? %>
            <div class="alert alert-success text-center mb-3">
              <i class="bi bi-check-circle-fill fs-4 d-block mb-2"></i>
              <strong>Vendu !</strong>
            </div>
            <%= button_to "Remettre en actif",
                desactiver_vente_property_path(@property),
                method: :patch,
                class: "btn btn-outline-secondary w-100 btn-sm" %>
          <% end %>
        </div>
      </div>

      <!-- Info DIU légale -->
      <div class="card border-0 shadow-sm border-warning">
        <div class="card-body p-4">
          <h6 class="fw-semibold mb-3">
            <i class="bi bi-info-circle text-warning me-2"></i>
            Qu'est-ce que le DIU ?
          </h6>
          <p class="text-muted small mb-2">
            Le <strong>Dossier d'Intervention Ultérieure</strong> est un document légalement obligatoire en Belgique pour tout bien ayant fait l'objet de travaux soumis à permis.
          </p>
          <p class="text-muted small mb-0">
            Il doit être remis à l'acheteur lors de la vente et contient tous les documents relatifs aux travaux réalisés (plans, fiches techniques, notices, garanties…).
          </p>
        </div>
      </div>

    </div><!-- /col-lg-4 -->

  </div><!-- /row -->

</div>
