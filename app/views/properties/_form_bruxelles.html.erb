<% property ||= @property %>
<div class="container-fluid px-0">
  <%= simple_form_for property, local: true, html: { class: "needs-validation", novalidate: true } do |f| %>
    <!-- Style CSS renforcé pour les champs obligatoires -->
    <style>
      /* Cibler tous les types de champs avec required */
      input[required],
      select[required],
      textarea[required],
      .form-control[required],
      .form-select[required],
      input.form-control[required],
      select.form-select[required] {
        border: 3px solid #8fbc8f !important;
        border-color: #8fbc8f !important;
        box-shadow: 0 0 0 0.2rem rgba(143, 188, 143, 0.15) !important;
        background-color: #f7faf7 !important;
      }

      /* État focus pour les champs obligatoires */
      input[required]:focus,
      select[required]:focus,
      textarea[required]:focus,
      .form-control[required]:focus,
      .form-select[required]:focus,
      input.form-control[required]:focus,
      select.form-select[required]:focus {
        border: 3px solid #8fbc8f !important;
        border-color: #8fbc8f !important;
        box-shadow: 0 0 0 0.3rem rgba(143, 188, 143, 0.25) !important;
        outline: none !important;
      }

      /* Test avec une classe spécifique */
      .required-field {
        border: 4px solid #a2c5a2 !important;
        background-color: #f0f8f0 !important;
      }
    </style>

    <!-- Champ caché pour la région -->
    <%= f.hidden_field :region, value: "bruxelles" %>

    <!-- Première rangée: Nom du bien et Adresse -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 1: Nom du bien -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-tag text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Nom du bien</h5>
                    <p class="text-muted small mb-0">Identification de votre propriété</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :titre,
                        label: '<i class="bi bi-tag me-2 text-primary"></i>Nom ou titre du bien'.html_safe,
                        placeholder: "ex. Mon appartement Bruxelles, Bureau principal, Maison familiale...",
                        hint: '<i class="bi bi-info-circle me-1"></i>Donnez un nom à votre bien pour le retrouver facilement'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>

                  <!-- Photo du bien -->
                  <div class="col-12" data-controller="image-preview">
                    <%= f.input :photo,
                        as: :file,
                        label: '<i class="bi bi-camera me-2 text-primary"></i>Photo du bien'.html_safe,
                        hint: '<i class="bi bi-info-circle me-1"></i>Ajoutez une photo de votre bien (JPG, PNG, max 5MB)'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          accept: "image/*",
                          data: {
                            image_preview_target: "input",
                            action: "change->image-preview#previewImage"
                          }
                        } %>

                    <!-- Zone de prévisualisation -->
                    <div data-image-preview-target="preview" class="mt-2" style="display: none;">
                      <img data-image-preview-target="previewImg" src="" alt="Aperçu" class="img-thumbnail" style="max-width: 200px; max-height: 150px;">
                    </div>

                    <!-- Photo existante -->
                    <% if property.photo.attached? %>
                      <div class="mt-2">
                        <small class="form-text text-muted d-block">Photo actuelle:</small>
                        <%= image_tag property.photo, class: "img-thumbnail", style: "max-width: 200px; max-height: 150px;" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 2: Adresse -->
          <div class="col-lg-8">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-geo-alt text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Adresse du bien</h5>
                    <p class="text-muted small mb-0">Localisation de votre propriété</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-md-8">
                    <%= f.input :rue,
                        label: '<i class="bi bi-signpost me-2 text-success"></i>Rue'.html_safe,
                        placeholder: "ex. Rue de l'Énergie",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :numero,
                        label: '<i class="bi bi-hash me-2 text-success"></i>Numéro'.html_safe,
                        placeholder: "ex. 24",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :code_postal,
                        label: '<i class="bi bi-mailbox me-2 text-success"></i>Code postal'.html_safe,
                        placeholder: "ex. 1000",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-8">
                    <%= f.input :commune,
                        label: '<i class="bi bi-building me-2 text-success"></i>Commune'.html_safe,
                        placeholder: "ex. Bruxelles",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3 required-field",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                    <%= f.input :numero_cadastre,
                        label: '<i class="bi bi-map me-2 text-success"></i>Référence cadastrale'.html_safe,
                        placeholder: "ex. A 0123/00",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Deuxième rangée: Type de bien, Occupation et Informations d'achat -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 3: Type de bien -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-secondary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-building text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Type de bien</h5>
                    <p class="text-muted small mb-0">Classification de votre propriété</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :type_propriete,
                        label: '<i class="bi bi-building me-2 text-secondary"></i>Type de propriété'.html_safe,
                        collection: [
                          ["Propriétaire à 100%", "propriétaire complet"],
                          ["Copropriétaire avec mon conjoint", "copropriétaire"],
                          ["Nu propriétaire", "nu-propriétaire"],
                          ["Usufruitier", "usufruitier"]
                        ],
                        include_blank: "Sélectionnez le type de propriété",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-12">
                    <%= f.input :type_bien_bruxelles,
                        label: '<i class="bi bi-house me-2 text-secondary"></i>Type de bien'.html_safe,
                        collection: [
                          ["Maison unifamiliale", "maison"],
                          ["Appartement", "appartement"],
                          ["Immeuble avec plusieurs unités", "immeuble de rapport"]
                        ],
                        include_blank: "Sélectionnez le type de bien",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 4: Occupation et profil -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-house-check text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Occupation et profil</h5>
                    <p class="text-muted small mb-0">Votre situation d'occupation</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :profil_demandeur,
                        label: '<i class="bi bi-person me-2 text-warning"></i>Profil du demandeur'.html_safe,
                        collection: [
                          ["Propriétaire occupant ou futur occupant", "proprietaire_occupant_ou_futur_occupant"],
                          ["Entreprise", "entreprise"],
                          ["Syndic de copropriété, ACP, Copropriété forcée", "syndic_de_copropriete_acp_copropriete_forcee"],
                          ["Propriétaire en indivision", "proprietaire_en_indivision"],
                          ["Copropriétaire volontaire ou fortuit", "coproprietaire_volontaire_ou_fortuit"],
                          ["Locataire", "locataire"],
                          ["Propriétaire bailleur", "proprietaire_bailleur"],
                          ["Propriétaire bailleur via AIS", "proprietaire_bailleur_via_ais"],
                          ["ASBL/Coopérative", "asbl_cooperative"],
                          ["Amphythéote", "amphyteote"]
                        ],
                        include_blank: "Sélectionnez le profil",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 5: Informations d'achat -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-credit-card text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Informations d'achat</h5>
                    <p class="text-muted small mb-0">Détails financiers</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :valeur_achat,
                        label: '<i class="bi bi-currency-euro me-2 text-success"></i>Valeur d\'achat (€)'.html_safe,
                        placeholder: "ex. 250000",
                        hint: "Prix d'achat du bien en euros",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          step: "0.01",
                          min: "0"
                        } %>
                  </div>
                  <div class="col-12">
                    <div class="mb-3">
                      <label class="form-label text-dark fw-medium mb-1">
                        <i class="bi bi-calendar me-2 text-success"></i>Date d'achat
                      </label>
                      <div class="d-flex gap-2">
                        <%= f.date_select :date_achat,
                            { order: [:day, :month, :year],
                              start_year: 1800,
                              end_year: 2040,
                              include_blank: false },
                            { class: "form-select border-2 rounded-3 px-3",
                              style: "background: #f8f9fa; border-color: #e9ecef !important;" } %>
                      </div>
                      <small class="text-muted">Date d'acquisition du bien</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Troisième rangée: Caractéristiques et Statuts -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Section Caractéristiques spécifiques à Bruxelles -->
          <div class="col-12 mb-3">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-info bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-rulers text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Caractéristiques spécifiques à Bruxelles</h5>
                    <p class="text-muted small mb-0">Informations techniques du bien</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <!-- Scan PEB -->
                  <div class="col-12 mb-2">
                    <button type="button" id="btn-scan-peb-bruxelles"
                            class="btn btn-outline-primary btn-sm rounded-3 px-3"
                            data-bs-toggle="tooltip"
                            title="Scanner votre certificat PEB pour remplir automatiquement les champs">
                      <i class="bi bi-file-earmark-bar-graph me-1"></i>Scanner mon certificat PEB
                    </button>
                    <input type="file" id="peb-file-input-bruxelles" accept=".pdf,image/jpeg,image/png" class="d-none">
                    <div id="peb-ocr-status-bruxelles" class="d-none mt-2">
                      <div class="alert border-0 rounded-3 py-2 mb-0" id="peb-ocr-alert-bruxelles">
                        <div class="d-flex align-items-center gap-2">
                          <div id="peb-ocr-spinner-bruxelles" class="spinner-border spinner-border-sm text-primary d-none" role="status"></div>
                          <i id="peb-ocr-icon-bruxelles" class="bi d-none"></i>
                          <span id="peb-ocr-message-bruxelles" class="small"></span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- Affichage données OCR -->
                  <% peb_bxl = property&.peb_donnees&.order(created_at: :desc)&.first %>
                  <div class="col-md-2">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-award me-1 text-primary"></i>Label PEB</label>
                    <div id="peb-label-display-bruxelles"
                      class="form-control border-2 rounded-3 px-2 bg-light text-center fw-bold fs-5 <%= peb_bxl&.label_peb ? 'text-' + peb_bxl.couleur_bootstrap : 'text-muted' %>"
                      style="border-color:#e9ecef !important;"><%= peb_bxl&.label_peb || '—' %></div>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-speedometer me-1 text-primary"></i>Score EP</label>
                    <div id="peb-score-display-bruxelles" class="form-control border-2 rounded-3 px-3 bg-light text-muted small" style="border-color:#e9ecef !important;">
                      <%= peb_bxl&.score_ep_formate || '—' %>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-arrows-angle-expand me-1 text-primary"></i>Surface</label>
                    <div id="peb-surface-display-bruxelles" class="form-control border-2 rounded-3 px-3 bg-light text-muted small" style="border-color:#e9ecef !important;">
                      <%= peb_bxl&.surface_reference ? "#{peb_bxl.surface_reference.to_i} m²" : '—' %>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-hash me-1 text-primary"></i>N° certificat</label>
                    <div id="peb-numero-display-bruxelles" class="form-control border-2 rounded-3 px-3 bg-light text-muted" style="border-color:#e9ecef !important;font-size:0.72rem;">
                      <%= peb_bxl&.numero_certificat || '—' %>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-calendar-check me-1 text-primary"></i>Établi le</label>
                    <div id="peb-date-cert-display-bruxelles" class="form-control border-2 rounded-3 px-3 bg-light text-muted small" style="border-color:#e9ecef !important;">
                      <%= peb_bxl&.date_certificat&.strftime('%d/%m/%Y') || '—' %>
                    </div>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label text-dark fw-medium mb-1 small"><i class="bi bi-calendar-x me-1 <%= peb_bxl&.perime? ? 'text-danger' : 'text-primary' %>"></i>Valide jusqu'au</label>
                    <div id="peb-date-valid-display-bruxelles"
                      class="form-control border-2 rounded-3 px-3 bg-light small <%= peb_bxl&.perime? ? 'text-danger' : 'text-muted' %>"
                      style="border-color:#e9ecef !important;">
                      <%= peb_bxl&.date_validite&.strftime('%d/%m/%Y') || '—' %>
                    </div>
                  </div>

                  <!-- Champs formulaire -->
                  <div class="col-md-4">
                    <%= f.input :annee_construction,
                        label: '<i class="bi bi-calendar-event me-2 text-primary"></i>Année de construction*'.html_safe,
                        placeholder: "ex. 1985",
                        wrapper_html: { class: "mb-3 mt-2" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                </div>
                  <div class="col-md-4">
                    <%= f.input :annee_construction,
                        label: '<i class="bi bi-calendar-event me-2 text-primary"></i>Année de construction*'.html_safe,
                        placeholder: "ex. 1985",
                        wrapper_html: { class: "mb-3 mt-2" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                </div>

<script>
(function () {
  var propertyId = '<%= property&.id %>';
  var btn=document.getElementById('btn-scan-peb-bruxelles'),
      inp=document.getElementById('peb-file-input-bruxelles'),
      sta=document.getElementById('peb-ocr-status-bruxelles'),
      ale=document.getElementById('peb-ocr-alert-bruxelles'),
      spi=document.getElementById('peb-ocr-spinner-bruxelles'),
      ico=document.getElementById('peb-ocr-icon-bruxelles'),
      msg=document.getElementById('peb-ocr-message-bruxelles');
  if (!btn) return;
  btn.addEventListener('click', function(){inp.click();});
  inp.addEventListener('change', function(){
    var file=inp.files[0]; if(!file) return;
    sta.classList.remove('d-none');
    ale.className='alert border-0 rounded-3 py-2 mb-0 alert-secondary';
    spi.classList.remove('d-none'); ico.classList.add('d-none');
    msg.textContent='Analyse du certificat PEB…'; btn.disabled=true;
    var fd=new FormData(); fd.append('file',file);
    if(propertyId) fd.append('property_id',propertyId);
    fetch('<%= ocr_scan_peb_path %>',{method:'POST',headers:{'X-CSRF-Token':document.querySelector('meta[name="csrf-token"]').content},body:fd})
    .then(function(r){return r.json();})
    .then(function(d){
      spi.classList.add('d-none'); btn.disabled=false;
      if(!d.success){show('danger','bi-exclamation-triangle-fill',d.error||'Extraction échouée.');return;}
      set('peb-label-display-bruxelles', d.label_peb||'—');
      set('peb-score-display-bruxelles', d.score_ep?d.score_ep+' kWh/(m².an)':'—');
      set('peb-surface-display-bruxelles', d.surface_reference?d.surface_reference+' m²':'—');
      set('peb-numero-display-bruxelles', d.numero_certificat||'—');
      set('peb-date-cert-display-bruxelles', d.date_certificat||'—');
      set('peb-date-valid-display-bruxelles', d.date_validite||'—');
      if(d.label_peb){var s=document.getElementById('property_certificat_peb_bruxelles');if(s){Array.from(s.options).forEach(function(o){o.selected=(o.value===d.label_peb);});s.classList.add('border-primary');}}
      show(d.extraction_complete?'success':'warning', d.extraction_complete?'bi-check-circle-fill':'bi-exclamation-circle-fill', d.message);
    })
    .catch(function(){spi.classList.add('d-none');btn.disabled=false;show('danger','bi-exclamation-triangle-fill','Erreur réseau.');});
    inp.value='';
  });
  function set(id,v){var e=document.getElementById(id);if(e)e.textContent=v;}
  function show(t,ic,m){ale.className='alert border-0 rounded-3 py-2 mb-0 alert-'+t;ico.className='bi '+ic+' text-'+t;ico.classList.remove('d-none');msg.textContent=m;}
})();
</script>

