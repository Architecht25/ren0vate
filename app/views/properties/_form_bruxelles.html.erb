<% property ||= @property %>
<%= simple_form_for property, local: true do |f| %>
  <!-- Champ caché pour la région -->
  <%= f.hidden_field :region, value: "bruxelles" %>

  <!-- Sections Nom du bien et Adresse - côte à côte -->
  <div class="row g-4 mb-4">
    <!-- Section Nom du bien -->
    <div class="col-lg-6">
      <div class="form-section">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle me-3">
            <i class="bi bi-tag"></i>
          </div>
          <h5 class="mb-0 fw-normal text-primary-custom">Nom du bien</h5>
        </div>

        <%= f.input :titre,
            label: "Nom ou titre du bien",
            placeholder: "ex. Mon appartement Bruxelles, Bureau principal, Maison familiale...",
            hint: "Donnez un nom à votre bien pour le retrouver facilement",
            wrapper_html: { class: "mb-3" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <!-- Section Adresse -->
    <div class="col-lg-6">
      <div class="form-section">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle me-3">
            <i class="bi bi-geo-alt"></i>
          </div>
          <h5 class="mb-0 fw-normal text-primary-custom">Adresse du bien</h5>
        </div>

        <!-- Ligne 1: Rue et Numéro -->
        <div class="row g-2 mb-3">
          <div class="col-md-4">
            <%= f.input :rue,
                label: "Rue*",
                placeholder: "ex. Rue de l'Énergie",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
          <div class="col-md-4">
            <%= f.input :numero,
                label: "Numéro*",
                placeholder: "ex. 24",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
        </div>

        <!-- Ligne 2: Code postal et Commune -->
        <div class="row g-2">
          <div class="col-md-4">
            <%= f.input :code_postal,
                label: "Code postal*",
                placeholder: "ex. 1190",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
          <div class="col-md-4">
            <%= f.input :commune,
                label: "Commune*",
                as: :select,
                collection: [
                  "Anderlecht", "Auderghem", "Berchem-Sainte-Agathe", "Bruxelles-Ville",
                  "Etterbeek", "Evere", "Forest", "Ganshoren", "Ixelles", "Jette",
                  "Koekelberg", "Molenbeek-Saint-Jean", "Saint-Gilles", "Saint-Josse-ten-Noode",
                  "Schaerbeek", "Uccle", "Watermael-Boitsfort", "Woluwe-Saint-Lambert", "Woluwe-Saint-Pierre"
                ],
                prompt: "-- Sélectionnez --",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sections Type de bien et Informations d'achat - côte à côte -->
  <div class="row g-4 mb-4">
    <!-- Section Type de bien -->
    <div class="col-lg-6">
      <div class="form-section">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle me-3">
            <i class="bi bi-building"></i>
          </div>
          <h5 class="mb-0 fw-normal text-primary-custom">Type de bien</h5>
        </div>

        <div class="row g-3">
          <div class="col-12">
            <%= f.input :type_propriete,
                label: "Type de propriété",
                as: :select,
                collection: [
                  ["Propriétaire à 100%", "propriétaire complet"],
                  ["Copropriétaire avec mon conjoint", "copropriétaire"],
                  ["Nu propriétaire", "nu-propriétaire"],
                  ["Usufruitier", "usufruitier"]
                ],
                prompt: "-- Sélectionnez --",
                wrapper_html: { class: "mb-3" },
                input_html: { class: "form-control-custom" } %>
          </div>
          <div class="col-12">
            <%= f.input :type,
                label: "Type de bien*",
                as: :select,
                collection: [
                  ["Maison unifamiliale", "maison"],
                  ["Appartement", "appartement"],
                  ["Immeuble avec plusieurs unités", "immeuble de rapport"]
                ],
                prompt: "-- Sélectionnez --",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
          <div class="col-12">
            <%= f.input :profil_demandeur,
                label: "Profil du demandeur*",
                as: :select,
                collection: [
                  ["Propriétaire occupant ou futur occupant", "proprietaire_occupant_ou_futur_occupant"],
                  ["Entreprise", "entreprise"],
                  ["Syndic de copropriété, ACP, Copropriété forcée", "syndic_de_copropriete_acp_copropriete_forcee"],
                  ["Propriétaire en indivision", "proprietaire_en_indivision"],
                  ["Copropriétaire volontaire ou fortuit", "coproprietaire_volontaire_ou_fortuit"],
                  ["Locataire", "locataire"],
                  ["Propriétaire bailleur", "proprietaire_bailleur"],
                  ["Propriétaire bailleur via AIS", "proprietaire_bailleur_via_ais"],
                  ["ASBL/Coopérative", "asbl_cooperative"],
                  ["Amphythéote", "amphyteote"]
                ],
                prompt: "-- Sélectionnez le profil --",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Section Informations d'achat -->
    <div class="col-lg-6">
      <div class="form-section">
        <div class="d-flex align-items-center mb-3">
          <div class="icon-circle me-3">
            <i class="bi bi-credit-card"></i>
          </div>
          <h5 class="mb-0 fw-normal text-primary-custom">Informations d'achat</h5>
        </div>

        <div class="row g-3">
          <div class="col-12">
            <%= f.input :valeur_achat,
                label: "Valeur d'achat (€)",
                placeholder: "ex. 250000",
                hint: "Prix d'achat du bien en euros",
                wrapper_html: { class: "mb-3" },
                input_html: {
                  class: "form-control-custom",
                  type: "number",
                  step: "0.01",
                  min: "0"
                } %>
          </div>
          <div class="col-12">
            <%= f.input :date_achat,
                label: "Date d'achat",
                hint: "Date d'acquisition du bien",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" },
                as: :date %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Caractéristiques spécifiques à Bruxelles -->
  <div class="form-section mb-4">
    <div class="d-flex align-items-center mb-3">
      <div class="icon-circle me-3">
        <i class="bi bi-info-circle"></i>
      </div>
      <h5 class="mb-0 fw-normal text-primary-custom">Caractéristiques spécifiques à Bruxelles</h5>
    </div>

    <div class="row g-3">
      <div class="col-md-4">
        <%= f.input :peb,
            label: "Classe PEB",
            as: :select,
            collection: ["A+", "A", "B", "C", "D", "E", "F", "G"],
            prompt: "-- Sélectionnez --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :date_peb_avant_travaux,
            label: "Date du certificat PEB",
            hint: "Date d'établissement du certificat",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" },
            as: :date %>
      </div>
      <div class="col-md-4">
        <%= f.input :annee_construction,
            label: "Année de construction*",
            placeholder: "ex. 1985",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :usage,
            label: "Usage du bien*",
            as: :select,
            collection: [
              ["Résidentiel uniquement", "residentiel"],
              ["Mixte (résidentiel + professionnel)", "mixte"]
            ],
            prompt: "-- Sélectionnez --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :occupation,
            label: "Type d'occupation*",
            as: :select,
            collection: [
              ["Résidence principale", "residence_principale"],
              ["Résidence secondaire", "residence_secondaire"],
              ["Investissement locatif", "investissement"]
            ],
            prompt: "-- Sélectionnez --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :surface_totale,
            label: "Surface totale (m²)",
            placeholder: "ex. 120",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Statuts spéciaux -->
  <div class="form-section mb-4">
    <div class="d-flex align-items-center mb-3">
      <div class="icon-circle me-3">
        <i class="bi bi-star"></i>
      </div>
      <h5 class="mb-0 fw-normal text-primary-custom">Statuts particuliers</h5>
    </div>

    <div class="row g-3">
      <div class="col-md-4">
        <%= f.input :domiciliation,
            as: :boolean,
            label: "Domicilié à cette adresse",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :nouvelle_construction,
            as: :boolean,
            label: "Nouvelle construction",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :primes_recues,
            as: :boolean,
            label: "Primes déjà reçues pour ce bien",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-4">
        <%= f.input :bien_classe,
            as: :boolean,
            label: "Bien classé ou protégé",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :petit_patrimoine,
            as: :boolean,
            label: "Éléments petit patrimoine",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :facade_patrimoine,
            as: :boolean,
            label: "Façade avec patrimoine",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
    </div>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex justify-content-end mt-4">
    <%= link_to properties_path, class: 'btn btn-light me-2' do %>
      <i class="bi bi-arrow-left me-1"></i>Annuler
    <% end %>
    <%= f.button "submit", class: 'btn btn-primary-custom px-4' do %>
      <i class="bi bi-check-lg me-1"></i>Ajouter le bien
    <% end %>
  </div>
<% end %>
