<%= simple_form_for @property, local: true do |f| %>
  <!-- Champ caché pour la région -->
  <%= f.hidden_field :region, value: "wallonie" %>

  <!-- Section Adresse -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-geo-alt me-2"></i>
      Adresse du bien
    </h5>

    <%= f.input :rue,
        label: "Rue*",
        placeholder: "ex. Rue de l'Énergie",
        wrapper_html: { class: "mb-3" },
        input_html: { class: "form-control-custom" } %>

    <div class="row g-3">
      <div class="col-md-3">
        <%= f.input :numero,
            label: "Numéro*",
            placeholder: "ex. 24",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :code_postal,
            label: "Code postal*",
            placeholder: "ex. 5000",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :commune,
            label: "Commune*",
            placeholder: "ex. Namur",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Type de bien -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-building me-2"></i>
      Type de bien
    </h5>

    <div class="row g-3">
      <div class="col-md-12">
        <%= f.input :type_propriete_wallonie,
            label: "Type de propriété (Wallonie)*",
            as: :select,
            collection: [
              ["Propriétaire à 100%", "propriétaire complet"],
              ["Copropriétaire avec mon conjoint", "copropriétaire"],
              ["Nu propriétaire", "nu-propriétaire"],
              ["Usufruitier", "usufruitier"]
            ],
            prompt: "-- Sélectionnez le type de propriété --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Caractéristiques spécifiques à la Wallonie -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-info-circle me-2"></i>
      Caractéristiques spécifiques à la Wallonie
    </h5>

    <div class="row g-3">
      <div class="col-md-4">
        <%= f.input :certificat_peb_wallonie,
            label: "Certificat PEB (Wallonie)",
            placeholder: "ex. 350 kWh/m²",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :surface_habitable_wallonie,
            label: "Surface habitable (Wallonie)",
            placeholder: "ex. 120 m²",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
      <div class="col-md-4">
        <%= f.input :mode_chauffage_wallonie,
            label: "Mode de chauffage (Wallonie)",
            placeholder: "ex. Gaz naturel",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :annee_construction,
            label: "Année de construction*",
            placeholder: "ex. 1985",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :date_raccordement_electrique,
            label: "Date de raccordement électrique",
            placeholder: "Année de raccordement",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom", type: "number" } %>
      </div>
    </div>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex justify-content-end mt-4">
    <%= link_to "Annuler", properties_path, class: "btn btn-outline-secondary me-2" %>
    <%= f.submit "Ajouter le bien", class: "btn btn-primary-custom" %>
  </div>
<% end %>
