<% property ||= @property %>
<div class="container-fluid px-0">
  <%= simple_form_for property, local: true, html: { class: "needs-validation", novalidate: true } do |f| %>
    <!-- Style CSS renforcé pour les champs obligatoires -->
    <style>
      /* Cibler tous les types de champs avec required */
      input[required],
      select[required],
      textarea[required],
      .form-control[required],
      .form-select[required],
      input.form-control[required],
      select.form-select[required] {
        border: 3px solid #8fbc8f !important;
        border-color: #8fbc8f !important;
        box-shadow: 0 0 0 0.2rem rgba(143, 188, 143, 0.15) !important;
        background-color: #f7faf7 !important;
      }

      /* État focus pour les champs obligatoires */
      input[required]:focus,
      select[required]:focus,
      textarea[required]:focus,
      .form-control[required]:focus,
      .form-select[required]:focus,
      input.form-control[required]:focus,
      select.form-select[required]:focus {
        border: 3px solid #8fbc8f !important;
        border-color: #8fbc8f !important;
        box-shadow: 0 0 0 0.3rem rgba(143, 188, 143, 0.25) !important;
        outline: none !important;
      }

      /* Test avec une classe spécifique */
      .required-field {
        border: 4px solid #a2c5a2 !important;
        background-color: #f0f8f0 !important;
      }
    </style>

    <!-- Champ caché pour la région -->
    <%= f.hidden_field :region, value: "wallonie" %>

    <!-- Première rangée: Nom du bien et Adresse -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 1: Nom du bien -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-tag text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Nom du bien</h5>
                    <p class="text-muted small mb-0">Identification de votre propriété</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :titre,
                        label: '<i class="bi bi-tag me-2 text-primary"></i>Nom ou titre du bien'.html_safe,
                        placeholder: "ex. Maison Wallonie, Appartement Liège, Gîte familial...",
                        hint: '<i class="bi bi-info-circle me-1"></i>Donnez un nom à votre bien pour le retrouver facilement'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>

                  <!-- Photo du bien -->
                  <div class="col-12" data-controller="image-preview">
                    <%= f.input :photo,
                        as: :file,
                        label: '<i class="bi bi-camera me-2 text-primary"></i>Photo du bien'.html_safe,
                        hint: '<i class="bi bi-info-circle me-1"></i>Ajoutez une photo de votre bien (JPG, PNG, max 5MB)'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          accept: "image/*",
                          data: {
                            image_preview_target: "input",
                            action: "change->image-preview#previewImage"
                          }
                        } %>

                    <!-- Zone de prévisualisation -->
                    <div data-image-preview-target="preview" class="mt-2" style="display: none;">
                      <img data-image-preview-target="previewImg" src="" alt="Aperçu" class="img-thumbnail" style="max-width: 200px; max-height: 150px;">
                    </div>

                    <!-- Photo existante -->
                    <% if property.photo.attached? %>
                      <div class="mt-2">
                        <small class="form-text text-muted d-block">Photo actuelle:</small>
                        <%= image_tag property.photo, class: "img-thumbnail", style: "max-width: 200px; max-height: 150px;" %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 2: Adresse du bien -->
          <div class="col-lg-8">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-info bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-geo-alt text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Adresse du bien</h5>
                    <p class="text-muted small mb-0">Localisation de votre propriété</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-6">
                    <%= f.input :rue,
                        label: '<i class="bi bi-signpost me-2 text-info"></i>Rue'.html_safe,
                        placeholder: "ex. Rue de l'Énergie",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-6">
                    <%= f.input :numero,
                        label: '<i class="bi bi-hash me-2 text-info"></i>Numéro'.html_safe,
                        placeholder: "ex. 24",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-6">
                    <%= f.input :code_postal,
                        label: '<i class="bi bi-mailbox me-2 text-info"></i>Code postal'.html_safe,
                        placeholder: "ex. 5000",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-6">
                    <%= f.input :commune,
                        label: '<i class="bi bi-geo me-2 text-info"></i>Commune'.html_safe,
                        placeholder: "ex. Namur",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                    <%= f.input :numero_cadastre,
                        label: '<i class="bi bi-map me-2 text-info"></i>Référence cadastrale'.html_safe,
                        placeholder: "ex. A 0123/00",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Deuxième rangée: Type de bien, Occupation et Informations d'achat -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 3: Type de bien -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-secondary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-building text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Type de bien</h5>
                    <p class="text-muted small mb-0">Classification de votre propriété</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :type_propriete_wallonie,
                        label: '<i class="bi bi-building me-2 text-secondary"></i>Type de propriété (Wallonie)'.html_safe,
                        collection: [
                          ["Unique propriétaire", "unique_proprietaire"],
                          ["Copropriétaire avec mon conjoint (couple marié, cohabitants légaux, cohabitants de fait) figurant sur ma composition de ménage", "copropriete_conjoint"],
                          ["Copropriétaire avec d'autres", "copropriete_autres"],
                          ["Usufruitier", "usufruitier"],
                          ["Nu-propriétaire", "nu_proprietaire"],
                          ["Représentant d'une association de copropriétaires", "representant_association"],
                          ["Autre (droit d'habitation, emphytéote...)", "autre"]
                        ],
                        include_blank: "Sélectionnez le type de propriété",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-12">
                    <%= f.input :profil_demandeur,
                        label: '<i class="bi bi-person me-2 text-secondary"></i>Profil du demandeur'.html_safe,
                        collection: [
                          ["Propriétaire occupant ou futur occupant", "propriétaire_occupant_ou_futur_occupant"],
                          ["Syndic de copropriété", "syndic_copropriété"],
                          ["Bailleur social", "bailleur_social"]
                        ],
                        include_blank: "Sélectionnez votre profil",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-12">
                    <%= f.input :type_bien_wallonie,
                        label: '<i class="bi bi-building me-2 text-secondary"></i>Type de bâtiment après travaux'.html_safe,
                        collection: [
                          ["Maison unifamiliale", "maison_unifamiliale"],
                          ["Appartement/studio", "appartement_studio"],
                          ["Immeuble avec plusieurs unités de logement", "immeuble_plusieurs_unites"],
                          ["Autre", "autre"]
                        ],
                        include_blank: "Sélectionnez le type de bâtiment",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 4: Occupation et usage -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-house-check text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Occupation</h5>
                    <p class="text-muted small mb-0">Éligibilité aux primes Wallonie</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :occupation,
                        label: '<i class="bi bi-house me-2 text-warning"></i>Type d\'occupation après travaux'.html_safe,
                        collection: [
                          ["Résidence principale pendant une durée minimale de 5 ans", "residence_principale"],
                          ["Résidence secondaire", "residence_secondaire"],
                          ["Location par bail enregistré (grille des loyers)", "location_5_ans_bail_enregistre"],
                          ["Location via AIS / SLSP / APL", "location_9_ans_ais"],
                          ["Mise à disposition gratuite (parent/allié 2° degré)", "location_gratuite_1_an"]
                        ],
                        include_blank: "Sélectionnez le type d'occupation",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Conditions pour l'éligibilité aux primes Wallonie</small>
                  </div>
                  <div class="col-12">
                    <%= f.input :habitation_percentage,
                        label: '<i class="bi bi-percent me-2 text-warning"></i>Pourcentage d\'habitation (%)'.html_safe,
                        placeholder: "ex. 100",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          min: "0",
                          max: "100",
                          step: "1"
                        } %>
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Minimum 50% requis pour les primes Wallonie</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 5: Informations d'achat -->
          <div class="col-lg-4">
            <div class="card rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-credit-card text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Informations d'achat</h5>
                    <p class="text-muted small mb-0">Détails financiers</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :valeur_achat,
                        label: '<i class="bi bi-currency-euro me-2 text-success"></i>Valeur d\'achat (€)'.html_safe,
                        placeholder: "ex. 250000",
                        hint: "Prix d'achat du bien en euros",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          step: "0.01",
                          min: "0"
                        } %>
                  </div>
                  <div class="col-12">
                    <div class="mb-3">
                      <label class="form-label text-dark fw-medium mb-1">
                        <i class="bi bi-calendar me-2 text-success"></i>Date d'achat
                      </label>
                      <div class="d-flex gap-2">
                        <%= f.date_select :date_achat,
                            { order: [:day, :month, :year],
                              start_year: 1800,
                              end_year: 2040,
                              include_blank: false },
                            { class: "form-select border-2 rounded-3 px-3",
                              style: "background: #f8f9fa; border-color: #e9ecef !important;" } %>
                      </div>
                      <small class="text-muted">Date d'acquisition du bien</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>



        </div>
      </div>
    </div>

    <!-- Quatrième rangée: Caractéristiques du bâtiment -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="card rounded-4">
          <div class="card-header bg-white border-0 py-3">
            <div class="d-flex align-items-center">
              <div class="bg-info bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                <i class="bi bi-rulers text-white fs-6"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 text-dark fw-normal">Caractéristiques du bâtiment</h5>
                <p class="text-muted small mb-0">Surface, construction et mode de chauffage</p>
              </div>
            </div>
          </div>
          <div class="card-body px-4 py-3">
            <div class="row g-2">
              <div class="col-4">
                <%= f.input :surface_habitable_wallonie,
                    label: '<i class="bi bi-rulers me-2 text-info"></i>Surface habitable'.html_safe,
                    placeholder: "ex. 120",
                    hint: '<i class="bi bi-info-circle me-1"></i>Surface en m²'.html_safe,
                    wrapper_html: { class: "mb-3" },
                    label_html: { class: "form-label text-dark fw-medium mb-1" },
                    input_html: {
                      class: "form-control border-2 rounded-3 px-3",
                      style: "background: #f8f9fa; border-color: #e9ecef !important;",
                      type: "number",
                      min: "1",
                      step: "1"
                    } %>
              </div>
              <div class="col-4">
                <%= f.input :annee_construction,
                    label: '<i class="bi bi-calendar3 me-2 text-info"></i>Année de construction'.html_safe,
                    placeholder: "ex. 1985",
                    wrapper_html: { class: "mb-3" },
                    label_html: { class: "form-label text-dark fw-medium mb-1" },
                    input_html: {
                      class: "form-control border-2 rounded-3 px-3",
                      style: "background: #f8f9fa; border-color: #e9ecef !important;",
                      type: "number",
                      min: "1800",
                      max: Date.current.year,
                      required: true
                    } %>
              </div>
              <div class="col-4">
                <%= f.input :mode_chauffage_wallonie,
                    label: '<i class="bi bi-thermometer-half me-2 text-info"></i>Mode de chauffage'.html_safe,
                    collection: [
                      ["Gaz", "gaz"],
                      ["Mazout", "mazout"],
                      ["Électricité", "electricite"],
                      ["Pompe à chaleur", "pompe_a_chaleur"],
                      ["Bois/Biomasse", "bois_biomasse"],
                      ["Charbon", "charbon"],
                      ["Autre", "autre"]
                    ],
                    include_blank: "Sélectionnez le mode de chauffage",
                    hint: '<i class="bi bi-info-circle me-1"></i>Mode de chauffage principal actuel'.html_safe,
                    wrapper_html: { class: "mb-3" },
                    label_html: { class: "form-label text-dark fw-medium mb-1" },
                    input_html: {
                      class: "form-select border-2 rounded-3 px-3",
                      style: "background: #f8f9fa; border-color: #e9ecef !important;"
                    } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Cinquième rangée: Performance énergétique (PEB) -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="card rounded-4">
          <div class="card-header bg-white border-0 py-3">
            <div class="d-flex align-items-center">
              <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                <i class="bi bi-lightning-charge text-white fs-6"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 text-dark fw-normal">Performance énergétique (PEB)</h5>
                <p class="text-muted small mb-0">Certificat de Performance Énergétique des Bâtiments avant travaux</p>
              </div>
            </div>
          </div>
          <div class="card-body px-4 py-3">
            <!-- Bouton scan PEB -->
              <div class="d-flex align-items-center gap-2 mb-3">
                <button type="button" id="btn-scan-peb-wallonie"
                        class="btn btn-outline-success btn-sm rounded-3 px-3"
                        data-bs-toggle="tooltip"
                        title="Scanner votre certificat PEB pour remplir automatiquement les champs">
                  <i class="bi bi-file-earmark-bar-graph me-1"></i>Scanner mon certificat PEB
                </button>
                <input type="file" id="peb-file-input-wallonie" accept=".pdf,image/jpeg,image/png" class="d-none">
              </div>
              <!-- Zone statut OCR PEB -->
              <div id="peb-ocr-status-wallonie" class="d-none mb-3">
                <div class="alert border-0 rounded-3 py-2 mb-0" id="peb-ocr-alert-wallonie">
                  <div class="d-flex align-items-center gap-2">
                    <div id="peb-ocr-spinner-wallonie" class="spinner-border spinner-border-sm text-success d-none" role="status"></div>
                    <i id="peb-ocr-icon-wallonie" class="bi d-none"></i>
                    <span id="peb-ocr-message-wallonie" class="small"></span>
                  </div>
                </div>
              </div>

              <div class="row g-2">
                <!-- Champs OCR — 6 données extraites (lecture seule, pré-remplies par scan) -->
                <% peb = property&.peb_donnees&.order(created_at: :desc)&.first %>
                <div class="col-md-2">
                  <label class="form-label text-dark fw-medium mb-1 small">
                    <i class="bi bi-award me-1 text-success"></i>Label PEB
                  </label>
                  <div id="peb-label-display-wallonie" class="form-control border-2 rounded-3 px-3 bg-light text-center fw-bold fs-5
                    <%= peb&.label_peb ? 'text-' + peb.couleur_bootstrap : 'text-muted' %>"
                    style="border-color: #e9ecef !important;">
                    <%= peb&.label_peb || '—' %>
                  </div>
                </div>
                <div class="col-md-2">
                  <label class="form-label text-dark fw-medium mb-1 small">
                    <i class="bi bi-speedometer me-1 text-success"></i>Score EP
                  </label>
                  <div id="peb-score-display-wallonie" class="form-control border-2 rounded-3 px-3 bg-light text-muted small"
                    style="border-color: #e9ecef !important;">
                    <%= peb&.score_ep_formate || '—' %>
                  </div>
                </div>
                <div class="col-md-2">
                  <label class="form-label text-dark fw-medium mb-1 small">
                    <i class="bi bi-arrows-angle-expand me-1 text-success"></i>Surface (m²)
                  </label>
                  <div id="peb-surface-display-wallonie" class="form-control border-2 rounded-3 px-3 bg-light text-muted small"
                    style="border-color: #e9ecef !important;">
                    <%= peb&.surface_reference ? "#{peb.surface_reference.to_i} m²" : '—' %>
                  </div>
                </div>
                <div class="col-md-2">
                  <label class="form-label text-dark fw-medium mb-1 small">
                    <i class="bi bi-hash me-1 text-success"></i>N° certificat
                  </label>
                  <div id="peb-numero-display-wallonie" class="form-control border-2 rounded-3 px-3 bg-light text-muted small"
                    style="border-color: #e9ecef !important; font-size: 0.75rem;">
                    <%= peb&.numero_certificat || '—' %>
                  </div>
                </div>
                <div class="col-md-2">
                  <label class="form-label text-dark fw-medium mb-1 small">
                    <i class="bi bi-calendar-check me-1 text-success"></i>Établi le
                  </label>
                  <div id="peb-date-cert-display-wallonie" class="form-control border-2 rounded-3 px-3 bg-light text-muted small"
                    style="border-color: #e9ecef !important;">
                    <%= peb&.date_certificat&.strftime('%d/%m/%Y') || '—' %>
                  </div>
                </div>
                <div class="col-md-2">
                  <label class="form-label text-dark fw-medium mb-1 small">
                    <i class="bi bi-calendar-x me-1 <%= peb&.perime? ? 'text-danger' : 'text-success' %>"></i>Valide jusqu'au
                  </label>
                  <div id="peb-date-valid-display-wallonie"
                    class="form-control border-2 rounded-3 px-3 bg-light small <%= peb&.perime? ? 'text-danger' : 'text-muted' %>"
                    style="border-color: #e9ecef !important;">
                    <%= peb&.date_validite&.strftime('%d/%m/%Y') || '—' %>
                  </div>
                </div>

                <!-- Champs formulaire -->
                <div class="col-md-12">
                  <div class="mb-3">
                    <label class="form-label text-dark fw-medium mb-2">
                      <i class="bi bi-file-earmark-check me-2 text-success"></i>Audit énergétique
                    </label>
                    <div class="d-flex gap-3">
                      <div class="form-check form-check-inline">
                        <%= f.radio_button :audit_energetique, true,
                            class: "form-check-input border-2",
                            style: "transform: scale(1.2);" %>
                        <%= f.label :audit_energetique_true, "Oui",
                            class: "form-check-label text-success fw-medium" %>
                      </div>
                      <div class="form-check form-check-inline">
                        <%= f.radio_button :audit_energetique, false,
                            class: "form-check-input border-2",
                            style: "transform: scale(1.2);" %>
                        <%= f.label :audit_energetique_false, "Non",
                            class: "form-check-label text-muted fw-medium" %>
                      </div>
                    </div>
                    <small class="text-muted">
                      <i class="bi bi-info-circle me-1"></i>Avez-vous réalisé un audit énergétique ?
                    </small>
                  </div>
                </div>
              </div>

<script>
(function () {
  var propertyId = '<%= property&.id %>';
  var btn     = document.getElementById('btn-scan-peb-wallonie');
  var input   = document.getElementById('peb-file-input-wallonie');
  var status  = document.getElementById('peb-ocr-status-wallonie');
  var alert   = document.getElementById('peb-ocr-alert-wallonie');
  var spinner = document.getElementById('peb-ocr-spinner-wallonie');
  var icon    = document.getElementById('peb-ocr-icon-wallonie');
  var msg     = document.getElementById('peb-ocr-message-wallonie');

  if (!btn) return;
  btn.addEventListener('click', function () { input.click(); });

  input.addEventListener('change', function () {
    var file = input.files[0];
    if (!file) return;

    status.classList.remove('d-none');
    alert.className = 'alert border-0 rounded-3 py-2 mb-0 alert-secondary';
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    msg.textContent = 'Analyse du certificat PEB…';
    btn.disabled = true;

    var fd = new FormData();
    fd.append('file', file);
    if (propertyId) fd.append('property_id', propertyId);

    fetch('<%= ocr_scan_peb_path %>', {
      method: 'POST',
      headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
      body: fd
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      spinner.classList.add('d-none');
      btn.disabled = false;

      if (!d.success) {
        showStatus('danger', 'bi-exclamation-triangle-fill', d.error || 'Extraction échouée.');
        return;
      }

      // Mise à jour des affichages lecture seule
      setDisplay('peb-label-display-wallonie',     d.label_peb || '—');
      setDisplay('peb-score-display-wallonie',     d.score_ep ? d.score_ep + ' kWh/(m².an)' : '—');
      setDisplay('peb-surface-display-wallonie',   d.surface_reference ? d.surface_reference + ' m²' : '—');
      setDisplay('peb-numero-display-wallonie',    d.numero_certificat || '—');
      setDisplay('peb-date-cert-display-wallonie', d.date_certificat || '—');
      setDisplay('peb-date-valid-display-wallonie',d.date_validite || '—');

      var type = d.extraction_complete ? 'success' : 'warning';
      var ic   = d.extraction_complete ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
      showStatus(type, ic, d.message);
    })
    .catch(function () {
      spinner.classList.add('d-none');
      btn.disabled = false;
      showStatus('danger', 'bi-exclamation-triangle-fill', 'Erreur réseau. Veuillez réessayer.');
    });
    input.value = '';
  });

  function setDisplay(id, val) {
    var el = document.getElementById(id);
    if (el) el.textContent = val;
  }
  function showStatus(type, iconClass, message) {
    alert.className = 'alert border-0 rounded-3 py-2 mb-0 alert-' + type;
    icon.className = 'bi ' + iconClass + ' text-' + type;
    icon.classList.remove('d-none');
    msg.textContent = message;
  }
})();
</script>
          </div>
        </div>
      </div>
    </div>

    <!-- Boutons d'action modernes -->
    <div class="row justify-content-center mb-5">
      <div class="col-lg-10">
        <div class="card rounded-4">
          <div class="card-header bg-white border-0 py-3">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                <i class="bi bi-gear text-white fs-6"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 text-dark fw-normal">Actions</h5>
                <p class="text-muted small mb-0">Gérer votre propriété</p>
              </div>
            </div>
          </div>
          <div class="card-body px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
              <%= link_to properties_path, class: "btn btn-outline-secondary rounded-3 py-2" do %>
                <i class="bi bi-arrow-left me-2"></i>Annuler
              <% end %>
              <%= f.submit "Sauvegarder les données", class: 'btn btn-primary rounded-3 py-2 fw-medium' %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% end %>
  </div>
</div>

