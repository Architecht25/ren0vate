<% property ||= @property %>
<%= simple_form_for property, local: true do |f| %>
  <!-- Champ caché pour la région -->
  <%= f.hidden_field :region, value: "Wallonie" %>

  <!-- Sections Nom du bien et Adresse - côte à côte -->
  <div class="row g-4 mb-4">
    <!-- Section Nom du bien -->
    <div class="col-lg-6">
      <div class="form-section bg-light-subtle border rounded-3 p-4">
        <h5 class="text-primary-custom mb-3 fw-normal">
          <i class="bi bi-tag me-2"></i>
          Nom du bien
        </h5>

        <%= f.input :titre,
            label: "Nom ou titre du bien",
            placeholder: "ex. Maison Wallonie, Appartement Liège, Gîte familial...",
            hint: "Donnez un nom à votre bien pour le retrouver facilement",
            wrapper_html: { class: "mb-3" },
            input_html: { class: "form-control-custom" } %>

        <!-- Champ pour la photo du bien -->
        <div data-controller="image-preview">
          <%= f.input :photo,
              as: :file,
              label: "Photo du bien",
              hint: "Ajoutez une photo de votre bien (JPG, PNG, max 5MB)",
              wrapper_html: { class: "mb-3" },
              input_html: {
                class: "form-control-custom",
                accept: "image/*",
                data: {
                  image_preview_target: "input",
                  action: "change->image-preview#previewImage"
                }
              } %>

          <!-- Zone de prévisualisation de l'image -->
          <div data-image-preview-target="preview" class="mb-3" style="display: none;">
            <img data-image-preview-target="previewImg" src="" alt="Aperçu" class="img-thumbnail" style="max-width: 200px; max-height: 150px;">
          </div>
        </div>

        <!-- Afficher la photo existante si elle existe -->
        <% if property.photo.attached? %>
          <div class="mb-3">
            <label class="form-label">Photo actuelle</label>
            <div>
              <%= image_tag property.photo, class: "img-thumbnail", style: "max-width: 200px; max-height: 150px;" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Section Adresse -->
    <div class="col-lg-6">
      <div class="form-section bg-light-subtle border rounded-3 p-4">
        <h5 class="text-primary-custom mb-3 fw-normal">
          <i class="bi bi-geo-alt me-2"></i>
          Adresse du bien
        </h5>

        <!-- Ligne 1: Rue et Numéro -->
        <div class="row g-2 mb-3">
          <div class="col-md-4">
            <%= f.input :rue, **apply_required_styling({
                label: "Rue",
                placeholder: "ex. Rue de l'Énergie",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" }
              }, Property, :rue, property) %>
          </div>
          <div class="col-md-4">
            <%= f.input :numero, **apply_required_styling({
                label: "Numéro",
                placeholder: "ex. 24",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" }
              }, Property, :numero, property) %>
          </div>
        </div>

        <!-- Ligne 2: Code postal et Commune -->
        <div class="row g-2">
          <div class="col-md-4">
            <%= f.input :code_postal, **apply_required_styling({
                label: "Code postal",
                placeholder: "ex. 5000",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" }
              }, Property, :code_postal, property) %>
          </div>
          <div class="col-md-8">
            <%= f.input :commune, **apply_required_styling({
                label: "Commune",
                placeholder: "ex. Namur",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" }
              }, Property, :commune, property) %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sections Type de bien et Informations d'achat - côte à côte -->
  <div class="row g-4 mb-4">
    <!-- Section Type de bien -->
    <div class="col-lg-6">
      <div class="form-section bg-light-subtle border rounded-3 p-4">
        <h5 class="text-primary-custom mb-3 fw-normal">
          <i class="bi bi-building me-2"></i>
          Type de bien
        </h5>

        <div class="row g-3">
          <div class="col-12">
            <%= f.input :type_propriete_wallonie, **apply_required_styling({
                label: "Type de propriété (Wallonie)",
                as: :select,
                collection: [
                  ["Propriétaire à 100%", "propriétaire_occupant"],
                  ["Copropriétaire avec mon conjoint", "copropriétaire"],
                  ["Nu propriétaire", "nu_proprietaire"],
                  ["Usufruitier", "usufruitier"],
                  ["Plein propriétaire", "plein_proprietaire"]
                ],
                prompt: "-- Sélectionnez le type de propriété --",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" }
              }, Property, :type_propriete_wallonie, property) %>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-12">
            <%= f.input :profil_demandeur,
                label: "Profil du demandeur*",
                as: :select,
                collection: [
                  ["Propriétaire occupant ou futur occupant", "propriétaire_occupant_ou_futur_occupant"],
                  ["Syndic de copropriété", "syndic_copropriété"],
                  ["Bailleur social", "bailleur_social"],
                ],
                prompt: "-- Sélectionnez le type de propriété --",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Section Informations d'achat -->
    <div class="col-lg-6">
      <div class="form-section bg-light-subtle border rounded-3 p-4">
        <h5 class="text-primary-custom mb-3 fw-normal">
          <i class="bi bi-credit-card me-2"></i>
          Informations d'achat
        </h5>

        <div class="row g-3">
          <div class="col-12">
            <%= f.input :valeur_achat,
                label: "Valeur d'achat (€)",
                placeholder: "ex. 250000",
                hint: "Prix d'achat du bien en euros",
                wrapper_html: { class: "mb-3" },
                input_html: {
                  class: "form-control-custom",
                  type: "number",
                  step: "0.01",
                  min: "0"
                } %>
          </div>
          <div class="col-12">
            <%= f.input :date_achat,
                label: "Date d'achat",
                hint: "Date d'acquisition du bien",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" },
                as: :date %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Occupation et usage (pour éligibilité aux primes) -->
  <div class="form-section mb-4 bg-light-subtle border rounded-3 p-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-house-check me-2"></i>
      Occupation et usage du bien
    </h5>

    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h6 class="text-success mb-3 fw-semibold">
          <i class="bi bi-award me-2"></i>
          Informations pour l'éligibilité aux primes Wallonie
        </h6>

        <div class="row g-3">
          <div class="col-md-6">
            <%= f.input :occupation,
                label: "Type d'occupation",
                as: :select,
                collection: [
                  ["Résidence principale", "residence_principale"],
                  ["Résidence secondaire", "residence_secondaire"],
                  ["Investissement locatif", "investissement"]
                ],
                prompt: "-- Sélectionnez le type d'occupation --",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
            <div class="form-text text-muted">
              <i class="bi bi-info-circle me-1"></i>
              La résidence principale est généralement requise pour les primes
            </div>
          </div>
          <div class="col-md-6">
            <%= f.input :habitation_percentage,
                label: "Pourcentage d'habitation (%)",
                placeholder: "ex. 100",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom", type: "number", min: "0", max: "100", step: "1" } %>
            <div class="form-text text-muted">
              <i class="bi bi-info-circle me-1"></i>
              Minimum 50% requis pour l'éligibilité aux primes Wallonie
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Caractéristiques spécifiques à la Wallonie -->
  <div class="form-section mb-4 bg-light-subtle border rounded-3 p-4">
    <h5 class="text-primary-custom mb-4 fw-normal">
      <i class="bi bi-flag-fill me-2 text-warning"></i>
      Caractéristiques spécifiques à la Wallonie
    </h5>

    <!-- Sous-section Performance énergétique -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h6 class="text-success mb-3 fw-semibold">
          <i class="bi bi-lightning-charge me-2"></i>
          Performance énergétique
        </h6>
        <div class="row g-3">
          <div class="col-md-4">
            <%= f.input :certificat_peb_wallonie,
                label: "Certificat PEB",
                placeholder: "ex. 350 kWh/m²/an",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
          <div class="col-md-4">
            <%= f.input :date_peb_avant_travaux,
                label: "Date du certificat PEB",
                as: :date,
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
          <div class="col-md-4">
            <%= f.input :audit_energetique,
                label: "Audit énergétique",
                placeholder: "ex. 280 kWh/m²/an",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom" } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Sous-section Caractéristiques du bâtiment -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h6 class="text-info mb-3 fw-semibold">
          <i class="bi bi-rulers me-2"></i>
          Caractéristiques du bâtiment
        </h6>
        <div class="row g-3">
          <div class="col-md-4">
            <%= f.input :surface_habitable_wallonie,
                label: "Surface habitable",
                placeholder: "ex. 120",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom", type: "number", min: "1", step: "1" } %>
          </div>
          <div class="col-md-4">
            <%= f.input :annee_construction,
                label: "Année de construction*",
                placeholder: "ex. 1985",
                wrapper_html: { class: "mb-0" },
                input_html: { class: "form-control-custom", type: "number", min: "1800", max: Date.current.year } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex justify-content-end mt-4">
    <%= link_to "Annuler", properties_path, class: "btn btn-outline-secondary me-2" %>
    <%= f.submit "Ajouter le bien", class: "btn btn-primary-custom" %>
  </div>
<% end %>
