<div class="container-fluid px-4 py-4">
  <!-- Header avec navigation -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-house-door"></i>
      </div>
      <div>
        <div class="d-flex align-items-center gap-2">
          <h1 class="h3 text-primary-custom mb-0 fw-normal">
            <%= @property.titre || "Bien sans nom" %>
          </h1>
          <% unless @property.titre.present? %>
            <%= link_to edit_property_path(@property), class: "btn btn-outline-warning btn-sm", title: "Définir le nom du bien" do %>
              <i class="bi bi-pencil-square"></i>
              <small>Nommer</small>
            <% end %>
          <% end %>
        </div>
        <small class="text-muted-custom">
          <i class="bi bi-geo-alt me-1"></i>
          <%= @property.rue %> <%= @property.numero %>, <%= @property.code_postal %> <%= @property.commune %>
        </small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to dashboard_path, class: "btn btn-outline-primary-custom" do %>
        <i class="bi bi-arrow-left me-2"></i>Dashboard général
      <% end %>
      <%= link_to edit_property_path(@property), class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-pencil me-2"></i>Modifier
      <% end %>
      <%= link_to property_path(@property),
          class: "btn btn-outline-danger",
          data: {
            confirm: "Êtes-vous sûr de vouloir supprimer ce bien ? Cette action supprimera également tous les documents, simulations et demandes liés. Cette action est irréversible.",
            turbo_method: :delete
          } do %>
        <i class="bi bi-trash me-1"></i>Supprimer
      <% end %>
    </div>
  </div>

  <!-- Alertes et notifications -->
  <% unless @property.titre.present? %>
    <div class="alert alert-info border-0 mb-4">
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
          <i class="bi bi-info-circle me-2"></i>
          <div>
            <strong>Donnez un nom à votre bien !</strong>
            <span class="text-muted-custom ms-2">
              Cela vous aidera à mieux l'identifier dans vos dashboards.
            </span>
          </div>
        </div>
        <%= link_to edit_property_path(@property), class: "btn btn-info btn-sm" do %>
          <i class="bi bi-pencil-square me-1"></i>Nommer maintenant
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @actions_available && @actions_available[:missing_fields].any? %>
    <div class="alert alert-warning border-0 mb-4">
      <div class="d-flex align-items-center">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <div>
          <strong>Informations manquantes :</strong>
          <span class="text-muted-custom ms-2">
            <%= @actions_available[:missing_fields].map { |field| field.to_s.humanize }.join(", ") %>
          </span>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Navigation rapide -->
  <div class="row g-3 mb-4">
    <div class="col-md-2">
      <%= link_to edit_property_path(@property), class: "card border-0 shadow-sm bg-light text-dark text-decoration-none h-100#{ ' property-card-entreprise' if @property.is_entreprise? }" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-house-gear fs-4 mb-2 text-primary"></i>
          <small class="d-block">Infos du bien</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to projects_path, class: "card border-0 shadow-sm bg-light text-dark text-decoration-none h-100#{ ' property-card-entreprise' if @property.is_entreprise? }" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-hammer fs-4 mb-2 text-warning"></i>
          <small class="d-block">Chantiers</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to simulations_path, class: "card border-0 shadow-sm bg-light text-dark text-decoration-none h-100#{ ' property-card-entreprise' if @property.is_entreprise? }" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-calculator fs-4 mb-2 text-info"></i>
          <small class="d-block">Simulations</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to property_documents_path(@property), class: "card border-0 shadow-sm bg-light text-dark text-decoration-none h-100#{ ' property-card-entreprise' if @property.is_entreprise? }" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-file-earmark-text fs-4 mb-2 text-success"></i>
          <small class="d-block">Documents</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to requests_path, class: "card border-0 shadow-sm bg-light text-dark text-decoration-none h-100#{ ' property-card-entreprise' if @property.is_entreprise? }" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-clipboard-check fs-4 mb-2 text-purple"></i>
          <small class="d-block">Demandes</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to new_request_path(property_id: @property.id), class: "card border-0 shadow-sm bg-light text-dark text-decoration-none h-100#{ ' property-card-entreprise' if @property.is_entreprise? }" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-plus-circle fs-4 mb-2 text-secondary"></i>
          <small class="d-block">Nouvelle demande</small>
        </div>
      <% end %>
    </div>
  </div>


  <!-- Sections principales épurées -->
  <div class="row g-4">

    <!-- État des données du bien -->
    <div class="col-lg-3">
      <div class="card border-0 shadow h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-house-gear"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-normal">État des données du bien</h5>
              <small class="text-muted-custom">Complétude des informations</small>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-12">
              <div class="info-item">
                <small class="text-muted-custom">Complétude globale</small>
                <div class="fw-medium mb-2">
                  <span class="badge bg-<%= @completion_stats && @completion_stats[:overall] > 70 ? 'success' : @completion_stats && @completion_stats[:overall] > 40 ? 'warning' : 'danger' %>">
                    <%= @completion_stats ? @completion_stats[:overall] : 0 %>%
                  </span>
                </div>
                <div class="progress" style="height: 6px;">
                  <div class="progress-bar bg-<%= @completion_stats && @completion_stats[:overall] > 70 ? 'success' : @completion_stats && @completion_stats[:overall] > 40 ? 'warning' : 'danger' %>"
                       style="width: <%= @completion_stats ? @completion_stats[:overall] : 0 %>%"></div>
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="info-item">
                <small class="text-muted-custom">Informations administratives</small>
                <div class="fw-medium">
                  <span class="badge bg-<%= @completion_stats && @completion_stats[:admin] > 70 ? 'success' : @completion_stats && @completion_stats[:admin] > 40 ? 'warning' : 'danger' %>">
                    <%= @completion_stats ? @completion_stats[:admin] : 0 %>%
                  </span>
                </div>
                <!-- Détails des champs manquants -->
                <ul class="list-unstyled mt-2 small">
                  <li class="d-flex align-items-center">
                    <i class="bi bi-<%= @property.rue.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-1"></i>
                    <span class="<%= @property.rue.present? ? 'text-success' : 'text-muted' %>">Adresse</span>
                  </li>
                  <li class="d-flex align-items-center">
                    <i class="bi bi-<%= @property.region.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-1"></i>
                    <span class="<%= @property.region.present? ? 'text-success' : 'text-muted' %>">Région</span>
                  </li>
                </ul>
              </div>
            </div>
            <div class="col-6">
              <div class="info-item">
                <small class="text-muted-custom">Informations chantier</small>
                <div class="fw-medium">
                  <span class="badge bg-<%= @completion_stats && @completion_stats[:chantier] > 70 ? 'success' : @completion_stats && @completion_stats[:chantier] > 40 ? 'warning' : 'danger' %>">
                    <%= @completion_stats ? @completion_stats[:chantier] : 0 %>%
                  </span>
                </div>
                <!-- Détails des champs manquants -->
                <ul class="list-unstyled mt-2 small">
                  <li class="d-flex align-items-center">
                    <i class="bi bi-<%= @property.annee_construction.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-1"></i>
                    <span class="<%= @property.annee_construction.present? ? 'text-success' : 'text-muted' %>">Année construction</span>
                  </li>
                  <li class="d-flex align-items-center">
                    <i class="bi bi-<%= @property.surface_habitable.present? ? 'check-circle-fill text-success' : 'circle text-muted' %> me-1"></i>
                    <span class="<%= @property.surface_habitable.present? ? 'text-success' : 'text-muted' %>">Surface habitable</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-top">
            <%= link_to edit_property_path(@property), class: "btn btn-outline-primary-custom btn-sm w-100" do %>
              <i class="bi bi-pencil me-2"></i>Modifier les informations
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- État des chantiers -->
    <div class="col-lg-3">
      <div class="card border-0 shadow h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-hammer"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-normal">État des chantiers</h5>
              <small class="text-muted-custom">Projets en cours et planifiés</small>
            </div>
          </div>

          <% if @property.projects.any? %>
            <% @property.projects.limit(3).each do |project| %>
              <div class="d-flex align-items-center py-2 border-bottom">
                <i class="bi bi-hammer me-2 text-primary-custom"></i>
                <div class="flex-grow-1">
                  <div class="fw-medium"><%= project.nom || "Projet sans nom" %></div>
                  <small class="text-muted-custom">
                    Statut: <%= project.statut || "Non défini" %>
                    <% if project.date_début %>
                      | Début: <%= project.date_début.strftime("%d/%m/%Y") %>
                    <% end %>
                  </small>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4 text-muted-custom">
              <i class="bi bi-hammer fs-3 mb-2 d-block"></i>
              <p class="mb-0">Aucun chantier en cours</p>
            </div>
          <% end %>

          <div class="mt-4 pt-3 border-top">
            <%= link_to new_project_path, class: "btn btn-outline-primary-custom btn-sm w-100" do %>
              <i class="bi bi-plus-lg me-2"></i>Nouveau chantier
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <!-- Seconde rangée de sections -->

    <!-- État des analyses & simulations -->
    <div class="col-lg-3">
      <div class="card border-0 shadow h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-graph-up"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-normal">Analyses & Simulations</h5>
              <small class="text-muted-custom">Évaluations et éligibilité primes</small>
            </div>
          </div>

          <!-- Éligibilité primes -->
          <div class="mb-3">
            <% if @property.simulations.any? %>
              <p class="text-success mb-2">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong><%= pluralize(@property.simulations.count, 'simulation') %> réalisée(s)</strong>
              </p>
              <small class="text-muted">Éligibilité aux primes confirmée</small>
            <% else %>
              <p class="text-warning mb-2">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Aucune simulation réalisée</strong>
              </p>
              <small class="text-muted">Calculez vos primes potentielles</small>
            <% end %>
          </div>

          <% if @property.simulations.any? %>
            <div class="row g-3 mb-3">
              <div class="col-6">
                <div class="info-item text-center">
                  <small class="text-muted-custom">Simulations totales</small>
                  <div class="fw-medium h4 text-primary-custom mb-0"><%= @property.simulations.count %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="info-item text-center">
                  <small class="text-muted-custom">Complètes</small>
                  <div class="fw-medium h4 text-primary-custom mb-0"><%= @property.simulations.where.not(region: nil).count %></div>
                </div>
              </div>
            </div>

            <% @property.simulations.limit(2).each do |simulation| %>
              <div class="d-flex align-items-center py-2 border-bottom">
                <i class="bi bi-calculator me-2 text-primary-custom"></i>
                <div class="flex-grow-1">
                  <div class="fw-medium"><%= simulation.region&.humanize || "Simulation" %></div>
                  <small class="text-muted-custom"><%= time_ago_in_words(simulation.created_at) %></small>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4 text-muted-custom">
              <i class="bi bi-calculator fs-3 mb-2 d-block"></i>
              <p class="mb-0">Aucune simulation</p>
            </div>
          <% end %>

          <div class="mt-4 pt-3 border-top">
            <%= link_to new_simulation_path(property_id: @property.id), class: "btn btn-outline-primary-custom btn-sm w-100" do %>
              <i class="bi bi-plus-lg me-2"></i>Nouvelle simulation
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <!-- État des documents -->
    <div class="col-lg-3">
      <div class="card border-0 shadow h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-file-earmark-text"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-normal">État des documents</h5>
              <small class="text-muted-custom">Gestion documentaire</small>
            </div>
          </div>

          <% if @property.documents.any? %>
            <div class="row g-3 mb-3">
              <div class="col-4">
                <div class="info-item text-center">
                  <small class="text-muted-custom">Total</small>
                  <div class="fw-medium h4 text-primary-custom mb-0"><%= @property.documents.count %></div>
                </div>
              </div>
              <div class="col-4">
                <div class="info-item text-center">
                  <small class="text-muted-custom">Approuvés</small>
                  <div class="fw-medium h4 text-success mb-0"><%= @property.documents.where(status: 'approved').count rescue 0 %></div>
                </div>
              </div>
              <div class="col-4">
                <div class="info-item text-center">
                  <small class="text-muted-custom">En attente</small>
                  <div class="fw-medium h4 text-warning mb-0"><%= @property.documents.where(status: 'pending').count rescue 0 %></div>
                </div>
              </div>
            </div>

            <% @property.documents.limit(3).each do |document| %>
              <div class="d-flex align-items-center py-2 border-bottom">
                <i class="bi bi-file-earmark-text me-2 text-primary-custom"></i>
                <div class="flex-grow-1">
                  <div class="fw-medium"><%= document.type_document&.humanize || "Document" %></div>
                  <small class="text-muted-custom">
                    <%= document.created_at.strftime("%d/%m/%Y") %>
                    <% if document.respond_to?(:status) && document.status %>
                      | <%= document.status.humanize %>
                    <% end %>
                  </small>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4 text-muted-custom">
              <i class="bi bi-file-earmark-plus fs-3 mb-2 d-block"></i>
              <p class="mb-0">Aucun document</p>
            </div>
          <% end %>

          <div class="mt-4 pt-3 border-top">
            <%= link_to new_document_path, class: "btn btn-outline-primary-custom btn-sm w-100" do %>
              <i class="bi bi-plus-lg me-2"></i>Ajouter un document
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Deuxième rangée de sections -->
  <div class="row g-4 mt-4">
    <!-- Suivi des demandes -->
    <div class="col-lg-3">
      <div class="card border-0 shadow h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-clipboard-check"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-normal">Suivi des demandes</h5>
              <small class="text-muted-custom">Demandes de primes</small>
            </div>
          </div>

          <% if @property.requests.any? %>
            <% @property.requests.limit(3).each do |property_request| %>
              <div class="d-flex align-items-center py-2 border-bottom">
                <i class="bi bi-clipboard-check me-2 text-primary-custom"></i>
                <div class="flex-grow-1">
                  <div class="fw-medium"><%= property_request.type_travaux&.humanize || "Demande" %></div>
                  <small class="text-muted-custom">
                    <%= time_ago_in_words(property_request.created_at) %>
                    <% if property_request.respond_to?(:status) && property_request.status %>
                      | <span class="badge bg-<%= property_request.status == 'approved' ? 'success' : property_request.status == 'pending' ? 'primary' : property_request.status == 'rejected' ? 'danger' : 'secondary' %>">
                        <%= property_request.status.humanize %>
                      </span>
                    <% end %>
                  </small>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="text-center py-4 text-muted-custom">
              <i class="bi bi-clipboard-plus fs-3 mb-2 d-block"></i>
              <p class="mb-0">Aucune demande</p>
            </div>
          <% end %>

          <div class="mt-4 pt-3 border-top">
            <%= link_to new_request_path(property_id: @property.id), class: "btn btn-outline-primary-custom btn-sm w-100" do %>
              <i class="bi bi-plus-lg me-2"></i>Nouvelle demande
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions rapides -->
    <div class="col-lg-3">
      <div class="card border-0 shadow h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-lightning"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-normal">Actions rapides</h5>
              <small class="text-muted-custom">Gestion de votre bien</small>
            </div>
          </div>

          <div class="d-grid gap-2">
            <% unless @property.titre.present? %>
              <%= link_to edit_property_path(@property), class: "btn btn-warning text-start text-white" do %>
                <i class="bi bi-pencil-square me-2"></i><strong>Nommer ce bien</strong>
                <small class="d-block text-white-50">Donnez un nom à votre propriété</small>
              <% end %>
            <% end %>

            <%= link_to property_documents_path(@property), class: "btn btn-outline-primary-custom text-start" do %>
              <i class="bi bi-file-earmark-text me-2"></i><strong>Gérer les documents</strong>
              <small class="d-block text-muted">Organiser vos fichiers</small>
            <% end %>

            <%= link_to new_property_document_path(@property), class: "btn btn-outline-success text-start" do %>
              <i class="bi bi-cloud-upload me-2"></i><strong>Uploader un document</strong>
              <small class="d-block text-muted">Ajouter un fichier</small>
            <% end %>

            <%= link_to new_simulation_path(property_id: @property.id), class: "btn btn-outline-primary-custom text-start" do %>
              <i class="bi bi-calculator me-2"></i><strong>Nouvelle simulation</strong>
              <small class="d-block text-muted">Estimer vos primes</small>
            <% end %>

            <% if @property.region == 'flandre' %>
              <%= link_to "https://woningpas.vlaanderen.be/", target: "_blank", class: "btn btn-outline-info text-start" do %>
                <i class="bi bi-house-check me-2"></i>Woningpas Vlaanderen
                <i class="bi bi-box-arrow-up-right ms-1 small"></i>
              <% end %>
            <% end %>

            <%= link_to property_path(@property), class: "btn btn-outline-primary-custom text-start" do %>
              <i class="bi bi-eye me-2"></i>Voir les détails
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Activité récente -->
    <% if (@property.requests&.any? || @property.simulations&.any? || @property.documents&.any?) %>
      <div class="col-lg-3">
        <div class="card border-0 shadow h-100">
          <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="icon-circle me-3">
                <i class="bi bi-clock-history"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 fw-normal">Activité récente</h5>
                <small class="text-muted-custom">Dernières actions sur ce bien</small>
              </div>
            </div>

            <!-- Simplification du contenu pour s'adapter au format col-lg-3 -->
            <% if @property.requests&.any? %>
              <div class="mb-3">
                <h6 class="text-muted-custom mb-2 small">Demandes récentes</h6>
                <% @property.requests.limit(2).each do |property_request| %>
                  <div class="d-flex align-items-center py-1 border-bottom">
                    <i class="bi bi-clipboard-check me-2 text-primary-custom small"></i>
                    <div class="flex-grow-1">
                      <div class="fw-medium small"><%= truncate(property_request.type_travaux&.humanize || "Demande", length: 20) %></div>
                      <small class="text-muted-custom"><%= property_request.created_at.strftime("%d/%m") %></small>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <% if @property.simulations&.any? %>
              <div class="mb-3">
                <h6 class="text-muted-custom mb-2 small">Simulations récentes</h6>
                <% @property.simulations.limit(2).each do |simulation| %>
                  <div class="d-flex align-items-center py-1 border-bottom">
                    <i class="bi bi-calculator me-2 text-primary-custom small"></i>
                    <div class="flex-grow-1">
                      <div class="fw-medium small"><%= truncate(simulation.region&.humanize || "Simulation", length: 20) %></div>
                      <small class="text-muted-custom"><%= simulation.created_at.strftime("%d/%m") %></small>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <div class="mt-4 pt-3 border-top">
              <%= link_to property_path(@property), class: "btn btn-outline-primary-custom btn-sm w-100" do %>
                <i class="bi bi-eye me-1"></i>Voir tout
              <% end %>
            </div>
