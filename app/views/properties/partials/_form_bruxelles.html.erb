<%= simple_form_for @property, local: true do |f| %>
  <!-- Champ caché pour la région -->
  <%= f.hidden_field :region, value: "bruxelles" %>

  <!-- Section Adresse -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-geo-alt me-2"></i>
      Adresse du bien
    </h5>

    <%= f.input :rue,
        label: "Rue*",
        placeholder: "ex. Rue de l'Énergie",
        wrapper_html: { class: "mb-3" },
        input_html: { class: "form-control-custom" } %>

    <div class="row g-3">
      <div class="col-md-3">
        <%= f.input :numero,
            label: "Numéro*",
            placeholder: "ex. 24",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-3">
        <%= f.input :code_postal,
            label: "Code postal*",
            placeholder: "ex. 1190",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :commune,
            label: "Commune*",
            as: :select,
            collection: [
              "Anderlecht", "Auderghem", "Berchem-Sainte-Agathe", "Bruxelles-Ville",
              "Etterbeek", "Evere", "Forest", "Ganshoren", "Ixelles", "Jette",
              "Koekelberg", "Molenbeek-Saint-Jean", "Saint-Gilles", "Saint-Josse-ten-Noode",
              "Schaerbeek", "Uccle", "Watermael-Boitsfort", "Woluwe-Saint-Lambert", "Woluwe-Saint-Pierre"
            ],
            prompt: "-- Sélectionnez --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Type de bien -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-building me-2"></i>
      Type de bien
    </h5>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :type_propriete,
            label: "Type de propriété",
            as: :select,
            collection: [
              ["Propriétaire à 100%", "propriétaire complet"],
              ["Copropriétaire avec mon conjoint", "copropriétaire"],
              ["Nu propriétaire", "nu-propriétaire"],
              ["Usufruitier", "usufruitier"]
            ],
            prompt: "-- Sélectionnez --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :type,
            label: "Type de bien*",
            as: :select,
            collection: [
              ["Maison unifamiliale", "maison"],
              ["Appartement", "appartement"],
              ["Immeuble avec plusieurs unités", "immeuble de rapport"]
            ],
            prompt: "-- Sélectionnez --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>
  </div>

  <!-- Section Caractéristiques spécifiques à Bruxelles -->
  <div class="form-section mb-4">
    <h5 class="text-primary-custom mb-3 fw-normal">
      <i class="bi bi-info-circle me-2"></i>
      Caractéristiques spécifiques à Bruxelles
    </h5>

    <div class="row g-3">
      <div class="col-md-6">
        <%= f.input :peb_classe,
            label: "Classe PEB",
            as: :select,
            collection: ["A+", "A", "B", "C", "D", "E", "F", "G"],
            prompt: "-- Sélectionnez --",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :annee_construction,
            label: "Année de construction",
            placeholder: "ex. 1985",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-md-6">
        <%= f.input :revenu_cadastral,
            label: "Revenu cadastral (€)",
            placeholder: "ex. 1250",
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-control-custom" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :prime_renovation,
            label: "Éligible à la prime rénovation",
            as: :radio_buttons,
            collection: [['Oui', true], ['Non', false]],
            wrapper_html: { class: "mb-0" },
            input_html: { class: "form-check-input" } %>
      </div>
    </div>
  </div>

  <!-- Boutons d'action -->
  <div class="d-flex justify-content-end mt-4">
    <%= link_to "Annuler", properties_path, class: "btn btn-outline-secondary me-2" %>
    <%= f.submit "Ajouter le bien", class: "btn btn-primary-custom" %>
  </div>
<% end %>
