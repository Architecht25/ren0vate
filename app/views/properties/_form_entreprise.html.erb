<% property ||= @property %>
<div class="container-fluid px-4 py-3">
  <!-- Header compact avec avatar -->
  <div class="row justify-content-center mb-3">
    <div class="col-lg-10">
      <div class="text-center">
        <div class="bg-primary bg-gradient rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
          <i class="bi bi-building-gear text-white fs-4"></i>
        </div>
        <h1 class="h3 text-dark fw-light mb-1">Propriété Entreprise</h1>
        <p class="text-muted small">Informations sur votre bien d'entreprise</p>
      </div>
    </div>
  </div>

  <%= simple_form_for property, local: true, html: { class: "needs-validation", novalidate: true } do |f| %>
    <!-- Champ caché pour marquer comme entreprise -->
    <%= f.hidden_field :type, value: "entreprise" %>

    <!-- Première rangée: Informations entreprise et Photo -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 1: Informations de l'entreprise -->
          <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-building text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Informations de l'entreprise</h5>
                    <p class="text-muted small mb-0">Détails de votre société</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :titre,
                        label: '<i class="bi bi-building-check me-2 text-primary"></i>Nom de l\'entreprise ou du projet'.html_safe,
                        placeholder: "ex. ACME Solutions - Bureaux Bruxelles",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>

                  <!-- Photo du bien -->
                  <div class="col-12" data-controller="image-preview">
                    <%= f.input :photo,
                        as: :file,
                        label: '<i class="bi bi-camera me-2 text-primary"></i>Photo du bien'.html_safe,
                        hint: '<i class="bi bi-info-circle me-1"></i>Ajoutez une photo de votre bien d\'entreprise (JPG, PNG, max 5MB)'.html_safe,
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          accept: "image/*",
                          data: {
                            image_preview_target: "input",
                            action: "change->image-preview#previewImage"
                          }
                        } %>

                    <!-- Zone de prévisualisation -->
                    <div data-image-preview-target="preview" class="mt-2" style="display: none;">
                      <img data-image-preview-target="previewImg" src="" alt="Aperçu" class="img-thumbnail" style="max-width: 200px; max-height: 150px;">
                    </div>

                    <!-- Photo existante -->
                    <% if property.photo.attached? %>
                      <div class="mt-2">
                        <small class="form-text text-muted d-block">Photo actuelle:</small>
                        <%= image_tag property.photo, class: "img-thumbnail", style: "max-width: 200px; max-height: 150px;" %>
                      </div>
                    <% end %>
                  </div>

                  <!-- Informations entreprise -->
                  <div class="col-6">
                    <%= f.input :bce_number,
                        label: '<i class="bi bi-card-text me-2 text-primary"></i>Numéro d\'entreprise (BCE)'.html_safe,
                        placeholder: "ex. 0123.456.789",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                  <div class="col-6">
                    <%= f.input :occupation,
                        label: '<i class="bi bi-briefcase me-2 text-primary"></i>Type d\'activité'.html_safe,
                        collection: [
                          ['Commerce de détail', 'commerce_detail'],
                          ['Commerce de gros', 'commerce_gros'],
                          ['Services', 'services'],
                          ['Industrie', 'industrie'],
                          ['Construction', 'construction'],
                          ['Technologie', 'technologie'],
                          ['Restauration', 'restauration'],
                          ['Santé', 'sante'],
                          ['Autre', 'autre']
                        ],
                        include_blank: "Sélectionnez une activité",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 2: Informations d'investissement -->
          <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-credit-card text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Informations d'investissement</h5>
                    <p class="text-muted small mb-0">Détails financiers</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-12">
                    <%= f.input :valeur_achat,
                        label: '<i class="bi bi-currency-euro me-2 text-success"></i>Valeur d\'investissement (€)'.html_safe,
                        placeholder: "ex. 500000",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "number",
                          step: "0.01",
                          min: "0"
                        } %>
                  </div>
                  <div class="col-12">
                    <%= f.input :date_achat,
                        label: '<i class="bi bi-calendar me-2 text-success"></i>Date d\'acquisition du siège'.html_safe,
                        placeholder: "jj/mm/aaaa",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          type: "date",
                          min: "1900-01-01",
                          max: "2030-12-31"
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

      <!-- Carte 3: Adresses de l'entreprise -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="card border-0 shadow-lg rounded-4">
            <div class="card-header bg-white border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="bg-info bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                  <i class="bi bi-geo-alt text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal">Adresses de l'entreprise</h5>
                  <p class="text-muted small mb-0">Localisation et implantation</p>
                </div>
              </div>
            </div>
            <div class="card-body px-4 py-3">
              <!-- Siège social -->
              <div class="mb-4">
                <div class="d-flex align-items-center mb-3">
                  <div class="bg-info bg-gradient rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 24px; height: 24px;">
                    <i class="bi bi-building text-white" style="font-size: 0.7rem;"></i>
                  </div>
                  <h6 class="mb-0 text-primary fw-medium">Siège social</h6>
                </div>

                <div class="row g-2 mb-3">
                  <div class="col-md-4">
                    <%= f.input :rue,
                        label: '<i class="bi bi-signpost me-2 text-info"></i>Rue'.html_safe,
                        placeholder: "ex. Avenue des Entreprises",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-2">
                    <%= f.input :numero,
                        label: '<i class="bi bi-hash me-2 text-info"></i>N°'.html_safe,
                        placeholder: "42",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-2">
                    <%= f.input :code_postal,
                        label: '<i class="bi bi-mailbox me-2 text-info"></i>Code postal'.html_safe,
                        placeholder: "1000",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :commune,
                        label: '<i class="bi bi-geo me-2 text-info"></i>Commune'.html_safe,
                        placeholder: "ex. Bruxelles",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          required: true
                        } %>
                  </div>
                </div>

                <!-- Bouton de copie d'adresse -->
                <div class="d-flex gap-2 mb-3">
                  <button type="button"
                          class="btn btn-outline-info btn-sm rounded-3"
                          data-controller="address-copy"
                          data-action="click->address-copy#copyAddress"
                          data-address-copy-source-target="copyButton">
                    <i class="bi bi-copy me-1"></i>Utiliser cette adresse pour l'exploitation
                  </button>
                </div>
              </div>
              <!-- Section adresse d'exploitation -->
              <div class="mb-4">
                <div class="d-flex align-items-center mb-3">
                  <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 24px; height: 24px;">
                    <i class="bi bi-shop text-white" style="font-size: 0.7rem;"></i>
                  </div>
                  <h6 class="mb-0 text-primary fw-medium">Adresse d'exploitation (si différente)</h6>
                </div>

                <div class="row g-2">
                  <div class="col-md-4">
                    <%= f.input :rue_exploitation,
                        label: '<i class="bi bi-signpost me-2 text-warning"></i>Rue'.html_safe,
                        placeholder: "ex. Rue du Commerce",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                  <div class="col-md-2">
                    <%= f.input :numero_exploitation,
                        label: '<i class="bi bi-hash me-2 text-warning"></i>N°'.html_safe,
                        placeholder: "12",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                  <div class="col-md-2">
                    <%= f.input :code_postal_exploitation,
                        label: '<i class="bi bi-mailbox me-2 text-warning"></i>Code postal'.html_safe,
                        placeholder: "1000",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                  <div class="col-md-4">
                    <%= f.input :commune_exploitation,
                        label: '<i class="bi bi-geo me-2 text-warning"></i>Commune'.html_safe,
                        placeholder: "ex. Bruxelles",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                </div>

                <!-- Région -->
                <div class="row g-2 mt-2">
                  <div class="col-md-6">
                    <%= f.input :region,
                        label: '<i class="bi bi-map me-2 text-warning"></i>Région d\'exploitation'.html_safe,
                        collection: [['Bruxelles', 'bruxelles'], ['Wallonie', 'wallonie'], ['Flandre', 'flandre']],
                        include_blank: "Sélectionnez une région",
                        wrapper_html: { class: "mb-3" },
                        label_html: { class: "form-label text-dark fw-medium mb-1" },
                        input_html: {
                          class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;"
                        } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Carte 4: Caractéristiques du bien -->
      <div class="row mb-4">
        <div class="col-lg-6">
          <div class="card border-0 shadow-lg rounded-4 h-100">
            <div class="card-header bg-white border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="bg-secondary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                  <i class="bi bi-diagram-3 text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal">Caractéristiques du bien</h5>
                  <p class="text-muted small mb-0">Description technique</p>
                </div>
              </div>
            </div>
            <div class="card-body px-4 py-3">
              <div class="row g-2">
                <div class="col-6">
                  <%= f.input :surface_totale,
                      label: '<i class="bi bi-rulers me-2 text-secondary"></i>Surface totale (m²)'.html_safe,
                      placeholder: "ex. 250",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        type: "number",
                        step: "0.01",
                        min: "0"
                      } %>
                </div>
                <div class="col-6">
                  <%= f.input :surface_habitable,
                      label: '<i class="bi bi-box-seam me-2 text-secondary"></i>Surface utilisable (m²)'.html_safe,
                      placeholder: "ex. 500",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        type: "number",
                        step: "0.01",
                        min: "0"
                      } %>
                </div>
                <div class="col-6">
                  <%= f.input :habitation_percentage,
                      label: '<i class="bi bi-gear me-2 text-secondary"></i>% usage professionnel'.html_safe,
                      placeholder: "ex. 80",
                      hint: "Pourcentage du bien utilisé à des fins professionnelles",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        type: "number",
                        min: "0",
                        max: "100"
                      } %>
                </div>
                <div class="col-6">
                  <%= f.input :nombre_salaries,
                      label: '<i class="bi bi-people me-2 text-secondary"></i>Nombre de salariés'.html_safe,
                      placeholder: "ex. 25",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        type: "number",
                        min: "0"
                      } %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Carte 5: Codes NACE -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-lg rounded-4 h-100">
            <div class="card-header bg-white border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="bg-dark bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                  <i class="bi bi-tags text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal">Codes NACE</h5>
                  <p class="text-muted small mb-0">Classification d'activité</p>
                </div>
              </div>
            </div>
            <div class="card-body px-4 py-3">
              <div class="row g-2">
                <div class="col-12">
                  <%= f.input :code_nace_1,
                      label: '<i class="bi bi-tag me-2 text-dark"></i>Code NACE principal'.html_safe,
                      placeholder: "ex. 47.11 (Commerce de détail)",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;"
                      } %>
                </div>
                <div class="col-12">
                  <%= f.input :code_nace_2,
                      label: '<i class="bi bi-tags me-2 text-dark"></i>Code NACE secondaire'.html_safe,
                      placeholder: "ex. 47.19 (optionnel)",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;"
                      } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Carte 6: Type et usage -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="card border-0 shadow-lg rounded-4">
            <div class="card-header bg-white border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                  <i class="bi bi-building text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal">Type et usage</h5>
                  <p class="text-muted small mb-0">Classification du bien</p>
                </div>
              </div>
            </div>
            <div class="card-body px-4 py-3">
              <div class="row g-2">
                <div class="col-lg-4">
                  <%= f.input :type_propriete,
                      label: '<i class="bi bi-building me-2 text-success"></i>Type de bien'.html_safe,
                      collection: [
                        ['Bureau', 'bureau'],
                        ['Local commercial', 'local_commercial'],
                        ['Entrepôt', 'entrepot'],
                        ['Atelier', 'atelier'],
                        ['Usine', 'usine'],
                        ['Local mixte', 'local_mixte'],
                        ['Autre', 'autre']
                      ],
                      include_blank: "Sélectionnez un type",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-select border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        required: true
                      } %>
                </div>
                <div class="col-lg-6">
                  <%= f.input :usage,
                      label: '<i class="bi bi-gear me-2 text-success"></i>Usage principal'.html_safe,
                      collection: [
                        ['Siège social', 'siege_social'],
                        ['Point de vente', 'point_vente'],
                        ['Production', 'production'],
                        ['Stockage', 'stockage'],
                        ['Services', 'services'],
                        ['Location', 'location'],
                        ['Autre', 'autre']
                      ],
                      include_blank: "Sélectionnez un usage",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-select border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;"
                      } %>
                </div>
                <div class="col-lg-6">
                  <%= f.input :profil_demandeur,
                      label: '<i class="bi bi-key me-2 text-success"></i>Statut d\'occupation'.html_safe,
                      collection: [
                        ['Propriétaire', 'proprietaire'],
                        ['Locataire', 'locataire'],
                        ['Usufruitier', 'usufruitier'],
                        ['Autre', 'autre']
                      ],
                      include_blank: "Sélectionnez un statut",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-select border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;"
                      } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Carte 7: Informations administratives -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="card border-0 shadow-lg rounded-4">
            <div class="card-header bg-white border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                  <i class="bi bi-info-circle text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal">Informations administratives</h5>
                  <p class="text-muted small mb-0">Détails réglementaires</p>
                </div>
              </div>
            </div>
            <div class="card-body px-4 py-3">
              <div class="row g-2">
                <div class="col-lg-6">
                  <%= f.input :date_creation,
                      label: '<i class="bi bi-calendar me-2 text-warning"></i>Date d\'inscription BCE'.html_safe,
                      placeholder: "jj/mm/aaaa",
                      hint: "Date d'inscription à la Banque Carrefour des Entreprises",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        type: "date",
                        min: "1930-01-01",
                        max: "2030-12-31"
                      } %>
                </div>
                <div class="col-lg-6">
                  <div class="d-flex align-items-center h-100">
                    <div class="form-check form-switch">
                      <%= f.check_box :regle_minimis,
                          class: "form-check-input",
                          style: "transform: scale(1.2);" %>
                      <%= f.label :regle_minimis,
                          '<i class="bi bi-exclamation-triangle me-2 text-warning"></i>Aides de minimis dépassées'.html_safe,
                          class: "form-check-label text-dark fw-medium" %>
                      <small class="text-muted d-block mt-1">
                        Cochez si votre entreprise a reçu plus de 300.000€ d'aides de minimis sur les 3 dernières années
                      </small>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Section Conformité et Éligibilité -->
              <div class="row g-3 mt-3 pt-3 border-top">
                <div class="col-12 mb-2">
                  <h6 class="text-dark fw-medium mb-0">
                    <i class="bi bi-shield-check me-2 text-success"></i>Conformité et Éligibilité
                  </h6>
                  <small class="text-muted">Conditions requises pour les aides de Bruxelles</small>
                </div>

                <div class="col-lg-6">
                  <div class="form-check form-switch">
                    <%= f.check_box :comptes_annuels_conformes,
                        class: "form-check-input",
                        style: "transform: scale(1.2);" %>
                    <%= f.label :comptes_annuels_conformes,
                        '<i class="bi bi-file-earmark-text me-2 text-info"></i>Comptes annuels en ordre'.html_safe,
                        class: "form-check-label text-dark fw-medium" %>
                    <small class="text-muted d-block mt-1">
                      Entreprise en ordre avec les obligations de publication des comptes annuels
                    </small>
                  </div>
                </div>

                <div class="col-lg-6">
                  <div class="form-check form-switch">
                    <%= f.check_box :plan_diversite_actif,
                        class: "form-check-input",
                        style: "transform: scale(1.2);" %>
                    <%= f.label :plan_diversite_actif,
                        '<i class="bi bi-people-fill me-2 text-primary"></i>Plan de diversité actif'.html_safe,
                        class: "form-check-label text-dark fw-medium" %>
                    <small class="text-muted d-block mt-1">
                      Obligatoire pour les entreprises de plus de 50 travailleurs
                    </small>
                  </div>
                </div>

                <div class="col-lg-6">
                  <%= f.input :pourcentage_financement_public,
                      label: '<i class="bi bi-percent me-2 text-warning"></i>% Financement public'.html_safe,
                      placeholder: "ex. 25.5",
                      wrapper_html: { class: "mb-3" },
                      label_html: { class: "form-label text-dark fw-medium mb-1" },
                      input_html: {
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        type: "number",
                        step: "0.01",
                        min: "0",
                        max: "100"
                      },
                      hint: "Maximum 75% pour être éligible aux aides Bruxelles" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
          <div class="card border-0 shadow-lg rounded-4">
            <div class="card-header bg-white border-0 py-3">
              <div class="d-flex align-items-center">
                <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                  <i class="bi bi-gear text-white fs-6"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0 text-dark fw-normal">Actions</h5>
                  <p class="text-muted small mb-0">Gérer votre bien d'entreprise</p>
                </div>
              </div>
            </div>
            <div class="card-body px-4 py-3">
              <div class="d-flex justify-content-between align-items-center">
                <%= link_to property.persisted? ? property_path(property) : new_property_path, class: "btn btn-outline-secondary rounded-3 py-2" do %>
                  <i class="bi bi-arrow-left me-2"></i>Annuler
                <% end %>
                <%= f.submit property.persisted? ? "Mettre à jour les données" : "Créer le bien d'entreprise", class: 'btn btn-primary rounded-3 py-2 fw-medium px-4' %>
              </div>
            </div>
          </div>
        </div>
      </div>
  <% end %>
</div>


<!-- CSS personnalisé pour le design moderne -->
<style>
  .form-control:focus, .form-select:focus {
    border-color: #0d6efd !important;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
  }

  .card {
    transition: all 0.3s ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.175) !important;
  }

  .btn {
    transition: all 0.3s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .bg-gradient {
    background: linear-gradient(135deg, var(--bs-primary) 0%, var(--bs-primary-dark) 100%) !important;
  }

  .form-control, .form-select {
    transition: all 0.3s ease;
  }

  .form-control:hover, .form-select:hover {
    background-color: #fff !important;
    border-color: #ced4da !important;
  }
</style>
