                  ['85.59 - Enseignements divers', '85.59'],
                  ['86.90 - Autres activités pour la santé humaine', '86.90'],
                  ['96.02 - Coiffure et autres soins de beauté', '96.02']
                ],
                include_blank: "Sélectionnez un code NACE (optionnel)",
                wrapper_html: { class: "mb-3" },
                input_html: { class: "form-select-custom" } %>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-12">
            <%= f.input :code_nace_3,
                label: "Code NACE 3",
                collection: [
                  ['01.11 - Culture de céréales', '01.11'],
                  ['10.71 - Fabrication de pain et de pâtisserie fraîche', '10.71'],
                  ['41.20 - Construction de bâtiments résidentiels et non résidentiels', '41.20'],
                  ['46.90 - Commerce de gros non spécialisé', '46.90'],
                  ['47.11 - Commerce de détail en magasin non spécialisé', '47.11'],
                  ['56.10 - Restaurants et services de restauration mobile', '56.10'],
                  ['62.01 - Programmation informatique', '62.01'],
                  ['68.10 - Achat et vente de biens immobiliers propres', '68.10'],
                  ['69.10 - Activités juridiques', '69.10'],
                  ['70.22 - Conseil pour les affaires et autres conseils de gestion', '70.22'],
                  ['71.12 - Activités d\'ingénierie et conseils techniques', '71.12'],
                  ['73.11 - Activités des agences de publicité', '73.11'],
                  ['82.99 - Autres services de soutien aux entreprises', '82.99'],
                  ['85.59 - Enseignements divers', '85.59'],
                  ['86.90 - Autres activités pour la santé humaine', '86.90'],
                  ['96.02 - Coiffure et autres soins de beauté', '96.02']
                ],
                include_blank: "Sélectionnez un code NACE (optionnel)",
                wrapper_html: { class: "mb-3" },
                input_html: { class: "form-select-custom" } %>
          </div>
          <div class="col-12">
            <%= f.input :code_nace_4,
                label: "Code NACE 4",
                collection: [
                  ['01.11 - Culture de céréales', '01.11'],
                  ['10.71 - Fabrication de pain et de pâtisserie fraîche', '10.71'],
                  ['41.20 - Construction de bâtiments résidentiels et non résidentiels', '41.20'],
                  ['46.90 - Commerce de gros non spécialisé', '46.90'],
                  ['47.11 - Commerce de détail en magasin non spécialisé', '47.11'],
                  ['56.10 - Restaurants et services de restauration mobile', '56.10'],
                  ['62.01 - Programmation informatique', '62.01'],
                  ['68.10 - Achat et vente de biens immobiliers propres', '68.10'],
                  ['69.10 - Activités juridiques', '69.10'],
                  ['70.22 - Conseil pour les affaires et autres conseils de gestion', '70.22'],
                  ['71.12 - Activités d\'ingénierie et conseils techniques', '71.12'],
                  ['73.11 - Activités des agences de publicité', '73.11'],
                  ['82.99 - Autres services de soutien aux entreprises', '82.99'],
                  ['85.59 - Enseignements divers', '85.59'],
                  ['86.90 - Autres activités pour la santé humaine', '86.90'],
                  ['96.02 - Coiffure et autres soins de beauté', '96.02']
                ],
                include_blank: "Sélectionnez un code NACE (optionnel)",
                wrapper_html: { class: "mb-3" },
                input_html: { class: "form-select-custom" } %>
          </div>
          <div class="col-12">
            <%= f.input :code_nace_5,
                label: "Code NACE 5",
                collection: [
                  ['01.11 - Culture de céréales', '01.11'],
                  ['10.71 - Fabrication de pain et de pâtisserie fraîche', '10.71'],
                  ['41.20 - Construction de bâtiments résidentiels et non résidentiels', '41.20'],
                  ['46.90 - Commerce de gros non spécialisé', '46.90'],
                  ['47.11 - Commerce de détail en magasin non spécialisé', '47.11'],
                  ['56.10 - Restaurants et services de restauration mobile', '56.10'],
                  ['62.01 - Programmation informatique', '62.01'],
                  ['68.10 - Achat et vente de biens immobiliers propres', '68.10'],
                  ['69.10 - Activités juridiques', '69.10'],
                  ['70.22 - Conseil pour les affaires et autres conseils de gestion', '70.22'],
                  ['71.12 - Activités d\'ingénierie et conseils techniques', '71.12'],
                  ['73.11 - Activités des agences de publicité', '73.11'],
                  ['82.99 - Autres services de soutien aux entreprises', '82.99'],
                  ['85.59 - Enseignements divers', '85.59'],
                  ['86.90 - Autres activités pour la santé humaine', '86.90'],
                  ['96.02 - Coiffure et autres soins de beauté', '96.02']
                ],
                include_blank: "Sélectionnez un code NACE (optionnel)",
                wrapper_html: { class: "mb-3" },
                input_html: { class: "form-select-custom" } %>
          </div>
        </div>

        <div class="mt-3">
          <small class="text-muted">
            <i class="bi bi-lightbulb me-1"></i>
            <strong>Conseil :</strong> Le code NACE principal doit correspondre à l'activité générant le plus de revenus.
            Les codes secondaires peuvent être utilisés pour des activités complémentaires.
          </small>
        </div>
      </div>
    </div>
  </div>



  <!-- Actions -->
  <div class="d-flex justify-content-between align-items-center">
    <%= link_to "Annuler", property.persisted? ? property_path(property) : new_property_path, class: "btn btn-outline-secondary" %>
    <%= f.button :submit, property.persisted? ? "Mettre à jour les données" : "Créer le bien d'entreprise", class: "btn btn-primary-custom px-4" %>
  </div>
<% end %>
