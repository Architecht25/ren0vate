<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-house-door"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">
          <%= @property.name || "Bien sans nom" %>
        </h1>
        <small class="text-muted-custom">
          <%= @property.rue %> <%= @property.numero %>, <%= @property.code_postal %> <%= @property.commune %>
        </small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to dashboard_path, class: "btn btn-outline-primary-custom" do %>
        <i class="bi bi-arrow-left me-2"></i>Dashboard général
      <% end %>
      <%= link_to edit_property_path(@property), class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-pencil me-2"></i>Modifier
      <% end %>
    </div>
  </div>

  <!-- Alertes simplifiées -->
  <% if @actions_available[:missing_fields].any? %>
    <div class="alert alert-warning border-0 mb-4">
      <div class="d-flex align-items-center">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <div>
          <strong>Informations manquantes :</strong>
          <span class="text-muted-custom ms-2">
            <%= @actions_available[:missing_fields].map(&:humanize).join(", ") %>
          </span>
        </div>
      </div>
    </div>
  <% end %>

  <% if @actions_available[:can_request] %>
    <div class="alert alert-success border-0 mb-4">
      <div class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
          <i class="bi bi-check-circle me-2"></i>
          <span><strong>Prêt pour une demande !</strong> Toutes les informations nécessaires sont complètes.</span>
        </div>
        <%= link_to new_request_path(property_id: @property.id), class: "btn btn-success btn-sm" do %>
          <i class="bi bi-plus-lg me-1"></i>Faire une demande
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Statistiques épurées -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-4">
          <div class="icon-circle-large mx-auto mb-3">
            <i class="bi bi-percent"></i>
          </div>
          <h3 class="text-primary-custom mb-1"><%= @completion_stats[:overall] %>%</h3>
          <small class="text-muted-custom">Complétude générale</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-4">
          <div class="icon-circle-large mx-auto mb-3">
            <i class="bi bi-person-gear"></i>
          </div>
          <h3 class="text-primary-custom mb-1"><%= @completion_stats[:admin] %>%</h3>
          <small class="text-muted-custom">Infos administratives</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-4">
          <div class="icon-circle-large mx-auto mb-3">
            <i class="bi bi-hammer"></i>
          </div>
          <h3 class="text-primary-custom mb-1"><%= @completion_stats[:chantier] %>%</h3>
          <small class="text-muted-custom">Infos chantier</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-4">
          <div class="icon-circle-large mx-auto mb-3">
            <i class="bi bi-file-earmark-text"></i>
          </div>
          <h3 class="text-primary-custom mb-1"><%= @property.documents_completion_percentage %>%</h3>
          <small class="text-muted-custom">Documents</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Sections principales épurées -->
  <div class="row g-4">
    <!-- Section Informations administratives -->
    <div class="col-lg-6">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-person-gear"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-normal">Informations administratives</h5>
              <small class="text-muted-custom"><%= @completion_stats[:admin] %>% complété</small>
            </div>
          </div>

          <div class="row g-3">
            <div class="col-6">
              <div class="info-item">
                <small class="text-muted-custom">Rue</small>
                <div class="fw-medium"><%= @property.rue || "Non renseigné" %></div>
              </div>
            </div>
            <div class="col-6">
              <div class="info-item">
                <small class="text-muted-custom">Numéro</small>
                <div class="fw-medium"><%= @property.numero || "Non renseigné" %></div>
              </div>
            </div>
            <div class="col-6">
              <div class="info-item">
                <small class="text-muted-custom">Code postal</small>
                <div class="fw-medium"><%= @property.code_postal || "Non renseigné" %></div>
              </div>
            </div>
            <div class="col-6">
              <div class="info-item">
                <small class="text-muted-custom">Commune</small>
                <div class="fw-medium"><%= @property.commune || "Non renseigné" %></div>
              </div>
            </div>
            <div class="col-12">
              <div class="info-item">
                <small class="text-muted-custom">Région</small>
                <div class="fw-medium">
                  <% if @property.region %>
                    <span class="badge bg-primary-custom"><%= @property.region.humanize %></span>
                  <% else %>
                    Non renseigné
                  <% end %>
                </div>
              </div>
            </div>
            
            <!-- Affichage conditionnel selon la région -->
            <% if @property.region == 'wallonie' %>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Type de propriété</small>
                  <div class="fw-medium"><%= @property.type_propriete_wallonie&.humanize || "Non renseigné" %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Certificat PEB</small>
                  <div class="fw-medium">
                    <% if @property.certificat_peb_wallonie.present? %>
                      <span class="badge bg-info"><%= @property.certificat_peb_wallonie %></span>
                    <% else %>
                      Non renseigné
                    <% end %>
                  </div>
                </div>
              </div>
            <% elsif @property.region == 'flandre' %>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Type de bien</small>
                  <div class="fw-medium"><%= @property.type_bien_flandre&.humanize || "Non renseigné" %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Usage</small>
                  <div class="fw-medium"><%= @property.usage_flandre&.humanize || "Non renseigné" %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Certificat PEB</small>
                  <div class="fw-medium">
                    <% if @property.certificat_peb_flandre.present? %>
                      <span class="badge bg-info"><%= @property.certificat_peb_flandre %></span>
                    <% else %>
                      Non renseigné
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Code EAN</small>
                  <div class="fw-medium"><%= @property.ean_flandre || "Non renseigné" %></div>
                </div>
              </div>
            <% elsif @property.region == 'bruxelles' %>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Type de bien</small>
                  <div class="fw-medium"><%= @property.type_bien_bruxelles&.humanize || "Non renseigné" %></div>
                </div>
              </div>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Certificat PEB</small>
                  <div class="fw-medium">
                    <% if @property.certificat_peb_bruxelles.present? %>
                      <span class="badge bg-info"><%= @property.certificat_peb_bruxelles %></span>
                    <% else %>
                      Non renseigné
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
            
            <% if @property.annee_construction.present? %>
              <div class="col-6">
                <div class="info-item">
                  <small class="text-muted-custom">Année de construction</small>
                  <div class="fw-medium"><%= @property.annee_construction %></div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="mt-4 pt-3 border-top">
            <%= link_to edit_property_path(@property), class: "btn btn-outline-primary-custom btn-sm w-100" do %>
              <i class="bi bi-pencil me-2"></i>Modifier les informations
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Section Actions rapides -->
    <div class="col-lg-6">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-lightning"></i>
            </div>
            <div>
              <h5 class="card-title mb-0 fw-normal">Actions rapides</h5>
              <small class="text-muted-custom">Gestion de votre bien</small>
            </div>
          </div>

          <div class="d-grid gap-2">
            <%= link_to new_request_path(property_id: @property.id), class: "btn btn-primary-custom text-start" do %>
              <i class="bi bi-plus-lg me-2"></i>Faire une demande de prime
            <% end %>

            <%= link_to documents_dashboard_property_path(@property), class: "btn btn-outline-primary-custom text-start" do %>
              <i class="bi bi-file-earmark-text me-2"></i>Gérer les documents
            <% end %>

            <%= link_to new_property_simulation_path(@property), class: "btn btn-outline-primary-custom text-start" do %>
              <i class="bi bi-calculator me-2"></i>Nouvelle simulation
            <% end %>

            <%= link_to property_path(@property), class: "btn btn-outline-primary-custom text-start" do %>
              <i class="bi bi-eye me-2"></i>Voir les détails
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Activité récente -->
  <% if @recent_requests&.any? || @recent_simulations&.any? %>
    <div class="row g-4 mt-4">
      <div class="col-12">
        <div class="card border-0 bg-light-custom">
          <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="icon-circle me-3">
                <i class="bi bi-clock-history"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 fw-normal">Activité récente</h5>
                <small class="text-muted-custom">Dernières actions sur ce bien</small>
              </div>
            </div>

            <div class="row g-3">
              <% if @recent_requests&.any? %>
                <div class="col-md-6">
                  <h6 class="text-muted-custom mb-2">Demandes récentes</h6>
                  <% @recent_requests.each do |request| %>
                    <div class="d-flex align-items-center py-2 border-bottom">
                      <i class="bi bi-file-earmark-text me-2 text-primary-custom"></i>
                      <div class="flex-grow-1">
                        <div class="fw-medium"><%= request.region&.humanize || "Demande" %></div>
                        <small class="text-muted-custom"><%= request.created_at.strftime("%d/%m/%Y") %></small>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <% if @recent_simulations&.any? %>
                <div class="col-md-6">
                  <h6 class="text-muted-custom mb-2">Simulations récentes</h6>
                  <% @recent_simulations.each do |simulation| %>
                    <div class="d-flex align-items-center py-2 border-bottom">
                      <i class="bi bi-calculator me-2 text-primary-custom"></i>
                      <div class="flex-grow-1">
                        <div class="fw-medium">Simulation</div>
                        <small class="text-muted-custom"><%= simulation.created_at.strftime("%d/%m/%Y") %></small>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Notifications liées au bien -->
  <% if @property_notifications&.any? %>
    <div class="row g-4 mt-4">
      <div class="col-12">
        <div class="card border-0 bg-light-custom">
          <div class="card-body p-4">
            <div class="d-flex align-items-center mb-3">
              <div class="icon-circle me-3">
                <i class="bi bi-bell"></i>
              </div>
              <div>
                <h5 class="card-title mb-0 fw-normal">Notifications récentes</h5>
                <small class="text-muted-custom">Concernant ce bien</small>
              </div>
            </div>

            <% @property_notifications.each do |notification| %>
              <div class="d-flex align-items-center py-2 border-bottom">
                <i class="bi bi-info-circle me-2 text-primary-custom"></i>
                <div class="flex-grow-1">
                  <div class="fw-medium"><%= notification.message %></div>
                  <small class="text-muted-custom"><%= notification.created_at.strftime("%d/%m/%Y à %H:%M") %></small>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- CSS externe pour le dashboard -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
