<div class="container-fluid px-4 py-4">
  <!-- Header avec navigation -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-house-door"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-no             <% if @property.requests.any? %>
            <% @property.requests.recent.limit(3).each do |property_request| %>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <span class="fw-medium"><%= property_request.type_travaux&.humanize || "Demande" %></span>
                  <br><small class="text-muted"><%= time_ago_in_words(property_request.created_at) %></small>
                </div>
                <span class="badge bg-<%= property_request.status == 'approved' ? 'success' : property_request.status == 'pending' ? 'primary' : property_request.status == 'rejected' ? 'danger' : 'secondary' %>">
                  <%= property_request.status&.humanize || 'En attente' %>
                </span>
              </div>
            <% end %>div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <span class="fw-medium"><%= request.type_travaux&.humanize || "Demande" %></span>
                  <br><small class="text-muted"><%= time_ago_in_words(request.created_at) %></small>
                </div>
                <span class="badge bg-<%= request.status == 'approved' ? 'success' : request.status == 'pending' ? 'primary' : request.status == 'rejected' ? 'danger' : 'secondary' %>">
                  <%= request.status&.humanize || 'En attente' %></span>          <%= @property.name || "Bien sans nom" %>
        </h1>
        <small class="text-muted-custom">
          <i class="bi bi-geo-alt me-1"></i>
          <%= @property.rue %> <%= @property.numero %>, <%= @property.code_postal %> <%= @property.commune %>
        </small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to dashboard_path, class: "btn btn-outline-primary-custom" do %>
        <i class="bi bi-arrow-left me-2"></i>Dashboard général
      <% end %>
      <%= link_to edit_property_path(@property), class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-pencil me-2"></i>Modifier
      <% end %>
    </div>
  </div>

  <!-- Alertes et notifications -->
  <% if @actions_available && @actions_available[:missing_fields].any? %>
    <div class="alert alert-warning border-0 mb-4">
      <div class="d-flex align-items-center">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <div>
          <strong>Informations manquantes :</strong>
          <span class="text-muted-custom ms-2">
            <%= @actions_available[:missing_fields].map { |field| field.to_s.humanize }.join(", ") %>
          </span>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Navigation rapide -->
  <div class="row g-3 mb-4">
    <div class="col-md-2">
      <%= link_to edit_property_path(@property), class: "card border-0 bg-primary-custom text-white text-decoration-none h-100" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-house-gear fs-4 mb-2"></i>
          <small class="d-block">Infos du bien</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to projects_path, class: "card border-0 bg-warning text-white text-decoration-none h-100" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-hammer fs-4 mb-2"></i>
          <small class="d-block">Chantiers</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to simulations_path, class: "card border-0 bg-info text-white text-decoration-none h-100" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-calculator fs-4 mb-2"></i>
          <small class="d-block">Simulations</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to property_documents_path(@property), class: "card border-0 bg-success text-white text-decoration-none h-100" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-file-earmark-text fs-4 mb-2"></i>
          <small class="d-block">Documents</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to requests_path, class: "card border-0 bg-purple text-white text-decoration-none h-100" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-clipboard-check fs-4 mb-2"></i>
          <small class="d-block">Demandes</small>
        </div>
      <% end %>
    </div>
    <div class="col-md-2">
      <%= link_to new_request_path(property_id: @property.id), class: "card border-0 bg-secondary text-white text-decoration-none h-100" do %>
        <div class="card-body text-center p-3">
          <i class="bi bi-plus-circle fs-4 mb-2"></i>
          <small class="d-block">Nouvelle demande</small>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Statistiques principales -->
  <div class="row g-3 mb-4">
    <div class="col-md-2">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-3">
          <div class="icon-circle mx-auto mb-2">
            <i class="bi bi-percent"></i>
          </div>
          <h4 class="text-primary-custom mb-1"><%= @completion_stats ? @completion_stats[:overall] : 0 %>%</h4>
          <small class="text-muted-custom">Complétude</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-3">
          <div class="icon-circle mx-auto mb-2">
            <i class="bi bi-file-earmark-text"></i>
          </div>
          <h4 class="text-primary-custom mb-1"><%= @property.documents.count %></h4>
          <small class="text-muted-custom">Documents</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-3">
          <div class="icon-circle mx-auto mb-2">
            <i class="bi bi-clipboard-check"></i>
          </div>
          <h4 class="text-primary-custom mb-1"><%= @property.requests.count %></h4>
          <small class="text-muted-custom">Demandes</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-3">
          <div class="icon-circle mx-auto mb-2">
            <i class="bi bi-calculator"></i>
          </div>
          <h4 class="text-primary-custom mb-1"><%= @property.simulations.count %></h4>
          <small class="text-muted-custom">Simulations</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-3">
          <div class="icon-circle mx-auto mb-2">
            <i class="bi bi-hammer"></i>
          </div>
          <h4 class="text-primary-custom mb-1"><%= @property.projects.count rescue 0 %></h4>
          <small class="text-muted-custom">Chantiers</small>
        </div>
      </div>
    </div>
    <div class="col-md-2">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-3">
          <div class="icon-circle mx-auto mb-2">
            <i class="bi bi-currency-euro"></i>
          </div>
          <h4 class="text-primary-custom mb-1">
            <%= number_to_currency((@property.requests.sum(:montant_total) rescue 0), unit: "€", separator: ",", delimiter: " ") %>
          </h4>
          <small class="text-muted-custom">Primes obtenues</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Sections principales en grille -->
  <div class="row g-4">

    <!-- État des données du bien -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <i class="bi bi-house-gear text-primary-custom me-2"></i>
              <h5 class="mb-0">État des données du bien</h5>
            </div>
            <%= link_to edit_property_path(@property), class: "btn btn-outline-primary btn-sm" do %>
              <i class="bi bi-pencil"></i>
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-6">
              <div class="d-flex justify-content-between">
                <span>Informations administratives</span>
                <span class="badge bg-<%= @completion_stats && @completion_stats[:admin] > 70 ? 'success' : @completion_stats && @completion_stats[:admin] > 40 ? 'warning' : 'danger' %>">
                  <%= @completion_stats ? @completion_stats[:admin] : 0 %>%
                </span>
              </div>
            </div>
            <div class="col-6">
              <div class="d-flex justify-content-between">
                <span>Informations chantier</span>
                <span class="badge bg-<%= @completion_stats && @completion_stats[:chantier] > 70 ? 'success' : @completion_stats && @completion_stats[:chantier] > 40 ? 'warning' : 'danger' %>">
                  <%= @completion_stats ? @completion_stats[:chantier] : 0 %>%
                </span>
              </div>
            </div>
            <div class="col-12">
              <small class="text-muted">
                Région: <strong><%= @property.region&.humanize || "Non définie" %></strong> |
                Superficie: <strong><%= @property.surface_habitable || "Non renseignée" %></strong> |
                Année: <strong><%= @property.annee_construction || "Non renseignée" %></strong>
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- État des chantiers -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <i class="bi bi-hammer text-warning me-2"></i>
              <h5 class="mb-0">État des chantiers</h5>
            </div>
            <%= link_to projects_path, class: "btn btn-outline-warning btn-sm" do %>
              <i class="bi bi-eye"></i>
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <% if @property.projects&.any? %>
            <% @property.projects.limit(3).each do |chantier| %>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span><%= chantier.nom || "Chantier #{chantier.id}" %></span>
                <span class="badge bg-<%= chantier.statut == 'termine' ? 'success' : chantier.statut == 'en_cours' ? 'primary' : 'secondary' %>">
                  <%= chantier.statut&.humanize || 'Non défini' %>
                </span>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-3">
              <i class="bi bi-hammer fs-4 mb-2"></i>
              <p class="mb-0">Aucun chantier enregistré</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- État des analyses -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <i class="bi bi-graph-up text-info me-2"></i>
              <h5 class="mb-0">Analyses & Simulations</h5>
            </div>
            <%= link_to simulations_path, class: "btn btn-outline-info btn-sm" do %>
              <i class="bi bi-eye"></i>
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <% if @property.simulations.any? %>
            <div class="row g-2">
              <div class="col-6">
                <div class="text-center">
                  <div class="h4 text-info mb-1"><%= @property.simulations.count %></div>
                  <small class="text-muted">Simulations</small>
                </div>
              </div>
              <div class="col-6">
                <div class="text-center">
                  <div class="h4 text-info mb-1"><%= @property.simulations.where.not(region: nil).count %></div>
                  <small class="text-muted">Complètes</small>
                </div>
              </div>
            </div>
            <hr class="my-3">
            <% @property.simulations.recent.limit(2).each do |simulation| %>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span><%= simulation.region&.humanize || "Simulation" %></span>
                <small class="text-muted"><%= time_ago_in_words(simulation.created_at) %></small>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-3">
              <i class="bi bi-calculator fs-4 mb-2"></i>
              <p class="mb-0">Aucune simulation</p>
              <%= link_to new_simulation_path(property_id: @property.id), class: "btn btn-outline-info btn-sm mt-2" do %>
                <i class="bi bi-plus"></i> Créer une simulation
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- État des documents -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <i class="bi bi-file-earmark-text text-success me-2"></i>
              <h5 class="mb-0">État des documents</h5>
            </div>
            <%= link_to property_documents_path(@property), class: "btn btn-outline-success btn-sm" do %>
              <i class="bi bi-eye"></i>
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <% if @property.documents.any? %>
            <div class="row g-2 mb-3">
              <div class="col-4">
                <div class="text-center">
                  <div class="h4 text-success mb-1"><%= @property.documents.count %></div>
                  <small class="text-muted">Total</small>
                </div>
              </div>
              <div class="col-4">
                <div class="text-center">
                  <div class="h4 text-success mb-1"><%= @property.documents.where(status: 'approved').count %></div>
                  <small class="text-muted">Approuvés</small>
                </div>
              </div>
              <div class="col-4">
                <div class="text-center">
                  <div class="h4 text-warning mb-1"><%= @property.documents.where(status: 'pending').count %></div>
                  <small class="text-muted">En attente</small>
                </div>
              </div>
            </div>
          <% else %>
            <div class="text-center text-muted py-3">
              <i class="bi bi-file-earmark-plus fs-4 mb-2"></i>
              <p class="mb-0">Aucun document</p>
              <%= link_to new_property_document_path(@property), class: "btn btn-outline-success btn-sm mt-2" do %>
                <i class="bi bi-plus"></i> Ajouter un document
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Suivi des demandes -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <i class="bi bi-clipboard-check text-purple me-2"></i>
              <h5 class="mb-0">Suivi des demandes</h5>
            </div>
            <%= link_to requests_path, class: "btn btn-outline-purple btn-sm" do %>
              <i class="bi bi-eye"></i>
            <% end %>
          </div>
        </div>
        <div class="card-body">
          <% if @property.requests.any? %>
            <% @property.requests.recent.limit(3).each do |request| %>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                  <span class="fw-medium"><%= request.type_demande&.humanize || "Demande" %></span>
                  <br><small class="text-muted"><%= time_ago_in_words(request.created_at) %></small>
                </div>
                <span class="badge bg-<%= request.statut == 'approuve' ? 'success' : request.statut == 'en_cours' ? 'primary' : request.statut == 'refuse' ? 'danger' : 'secondary' %>">
                  <%= request.statut&.humanize || 'En attente' %>
                </span>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-3">
              <i class="bi bi-clipboard-plus fs-4 mb-2"></i>
              <p class="mb-0">Aucune demande</p>
              <%= link_to new_request_path(property_id: @property.id), class: "btn btn-outline-purple btn-sm mt-2" do %>
                <i class="bi bi-plus"></i> Nouvelle demande
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Timeline et planning -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center">
            <i class="bi bi-calendar-event text-primary-custom me-2"></i>
            <h5 class="mb-0">Timeline & Planning</h5>
          </div>
        </div>
        <div class="card-body">
          <div class="timeline">
            <% if @property.requests.any? %>
              <% @property.requests.recent.limit(3).each_with_index do |property_request, index| %>
                <div class="timeline-item">
                  <div class="timeline-marker bg-<%= property_request.status == 'approved' ? 'success' : property_request.status == 'pending' ? 'primary' : 'secondary' %>"></div>
                  <div class="timeline-content">
                    <h6 class="mb-1"><%= property_request.type_travaux&.humanize || "Demande" %></h6>
                    <p class="text-muted mb-0"><%= property_request.created_at.strftime("%d/%m/%Y") %></p>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="text-center text-muted py-3">
                <i class="bi bi-calendar-plus fs-4 mb-2"></i>
                <p class="mb-0">Aucun événement planifié</p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Conditions à respecter -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center">
            <i class="bi bi-shield-check text-warning me-2"></i>
            <h5 class="mb-0">Conditions à respecter</h5>
          </div>
        </div>
        <div class="card-body">
          <% conditions = [] %>
          <% if @property.region == 'wallonie' %>
            <% conditions << "Audit énergétique obligatoire pour primes > 3000€" %>
            <% conditions << "Entrepreneur agréé requis" %>
            <% conditions << "Matériaux certifiés CE" %>
          <% elsif @property.region == 'flandre' %>
            <% conditions << "EPC (certificat énergétique) à jour" %>
            <% conditions << "Entrepreneur reconnu Vlaanderen" %>
            <% conditions << "Normes de qualité flamandes" %>
          <% elsif @property.region == 'bruxelles' %>
            <% conditions << "Permis d'urbanisme si requis" %>
            <% conditions << "Entrepreneur agréé région Bruxelles" %>
            <% conditions << "Conformité aux normes RBC" %>
          <% end %>

          <% if conditions.any? %>
            <% conditions.each do |condition| %>
              <div class="d-flex align-items-start mb-2">
                <i class="bi bi-check-circle text-success me-2 mt-1"></i>
                <span><%= condition %></span>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-3">
              <i class="bi bi-info-circle fs-4 mb-2"></i>
              <p class="mb-0">Conditions spécifiques selon la région</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Recommandations -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-transparent border-0 pb-0">
          <div class="d-flex align-items-center">
            <i class="bi bi-lightbulb text-info me-2"></i>
            <h5 class="mb-0">Recommandations</h5>
          </div>
        </div>
        <div class="card-body">
          <% recommendations = [] %>
          <% if @completion_stats && @completion_stats[:overall] < 50 %>
            <% recommendations << "Complétez les informations manquantes du bien" %>
          <% end %>
          <% if @property.documents.count < 3 %>
            <% recommendations << "Ajoutez les documents administratifs essentiels" %>
          <% end %>
          <% if @property.simulations.count == 0 %>
            <% recommendations << "Réalisez une simulation pour estimer vos primes" %>
          <% end %>
          <% if @property.requests.count == 0 && @completion_stats && @completion_stats[:overall] > 70 %>
            <% recommendations << "Votre dossier semble complet, lancez une demande !" %>
          <% end %>

          <% if recommendations.any? %>
            <% recommendations.each do |recommendation| %>
              <div class="d-flex align-items-start mb-2">
                <i class="bi bi-arrow-right text-info me-2 mt-1"></i>
                <span><%= recommendation %></span>
              </div>
            <% end %>
          <% else %>
            <div class="text-center text-muted py-3">
              <i class="bi bi-check-all fs-4 mb-2"></i>
              <p class="mb-0">Tout semble en ordre !</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- CSS pour la timeline -->
<style>
.timeline {
  position: relative;
  padding-left: 30px;
}

.timeline-item {
  position: relative;
  margin-bottom: 20px;
}

.timeline-marker {
  position: absolute;
  left: -37px;
  top: 5px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: -31px;
  top: 17px;
  width: 2px;
  height: calc(100% + 5px);
  background-color: #e9ecef;
}

.icon-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: rgba(var(--bs-primary-rgb), 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bg-purple {
  background-color: #6f42c1 !important;
}

.text-purple {
  color: #6f42c1 !important;
}

.btn-outline-purple {
  border-color: #6f42c1;
  color: #6f42c1;
}

.btn-outline-purple:hover {
  background-color: #6f42c1;
  border-color: #6f42c1;
  color: white;
}
</style>
