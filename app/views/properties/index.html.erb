<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Biens Immobiliers</h1>
    <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter un bien
    <% end %>
  </div>

  <!-- Liste minimaliste -->
  <% if @properties.any? %>
    <div class="row g-3">
      <% @properties.each do |property| %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 bg-light-custom h-100 property-card">
            <div class="card-body p-4">
              <div class="d-flex align-items-center mb-3">
                <div class="icon-circle me-3">
                  <i class="bi bi-house-door"></i>
                </div>
                <div class="flex-grow-1">
                  <h5 class="card-title text-dark mb-1 fw-normal"><%= property.name %></h5>
                  <% if property.rue && property.numero && property.commune %>
                    <p class="text-muted-custom mb-0 small"><%= property.rue %> <%= property.numero %>, <%= property.commune %></p>
                  <% else %>
                    <p class="text-muted-custom mb-0 small">Adresse à renseigner</p>
                  <% end %>
                </div>
              </div>

              <!-- Actions -->
              <div class="d-flex gap-2 mt-3">
                <%= link_to dashboard_property_path(property), class: "btn btn-primary-custom btn-sm flex-fill" do %>
                  <i class="bi bi-speedometer2 me-1"></i>Dashboard
                <% end %>
                <%= link_to property_path(property), class: "btn btn-outline-primary-custom btn-sm flex-fill" do %>
                  <i class="bi bi-eye me-1"></i>Détails
                <% end %>
              </div>
              
              <!-- Actions secondaires -->
              <div class="d-flex gap-2 mt-2">
                <%= link_to edit_property_path(property), class: "btn btn-outline-secondary btn-sm flex-fill" do %>
                  <i class="bi bi-pencil me-1"></i>Modifier
                <% end %>
                <%= link_to property_path(property), 
                    method: :delete,
                    class: "btn btn-outline-danger btn-sm flex-fill",
                    data: { 
                      confirm: "Êtes-vous sûr de vouloir supprimer ce bien ? Cette action est irréversible.",
                      turbo_method: :delete
                    } do %>
                  <i class="bi bi-trash me-1"></i>Supprimer
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-house-door"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun bien enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par ajouter votre premier bien immobilier</p>
      <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Ajouter mon premier bien
      <% end %>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
