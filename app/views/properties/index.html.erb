<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Biens Immobiliers</h1>
    <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter un bien
    <% end %>
  </div>

  <!-- Liste améliorée -->
  <% if @properties.any? %>
    <div class="row g-4">
      <% @properties.each do |property| %>
        <div class="col-xl-3 col-lg-4 col-md-6">
          <div class="card border-0 shadow-sm h-100 property-card-enhanced<%= ' property-card-entreprise' if property.is_entreprise? %>">
            <div class="card-body p-0">
              <div class="row g-0 h-100">
                <!-- Photo du bien à gauche -->
                <div class="col-4">
                  <div class="property-photo h-100">
                    <% if property.photo.attached? %>
                      <%= image_tag property.photo, class: "img-fluid h-100 w-100", style: "object-fit: cover;" %>
                    <% else %>
                      <div class="h-100 w-100 d-flex align-items-center justify-content-center bg-light">
                        <i class="bi bi-<%= property.is_entreprise? ? 'building' : 'house-door' %> text-muted fs-4"></i>
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- Contenu à droite -->
                <div class="col-8">
                  <div class="p-3 h-100 d-flex flex-column">
                    <!-- Header avec badge région et complétude -->
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <!-- Badge région à gauche -->
                      <div class="flex-shrink-0">
                        <% if property.region %>
                          <span class="badge bg-<%= property.region == 'wallonie' ? 'warning' : property.region == 'flandre' ? 'success' : 'info' %>" style="font-size: 0.65rem;">
                            <%= property.region.humanize %>
                          </span>
                        <% else %>
                          <!-- Espace réservé pour maintenir l'alignement -->
                          <span style="display: inline-block; width: 1px;"></span>
                        <% end %>
                      </div>

                      <!-- Indicateur de complétude à droite -->
                      <div class="completion-indicator">
                        <svg class="progress-ring" width="32" height="32" viewBox="0 0 32 32">
                          <circle class="progress-ring-circle progress-ring-bg" stroke="#e9ecef" stroke-width="2" fill="transparent" r="13" cx="16" cy="16"/>
                          <circle class="progress-ring-circle progress-ring-fill" stroke="#0d6efd" stroke-width="2" fill="transparent" r="13" cx="16" cy="16"
                                  style="stroke-dasharray: 81.681; stroke-dashoffset: <%= 81.681 - (81.681 * (property.completion_percentage || 0) / 100) %>;"/>
                        </svg>
                        <div class="progress-text"><%= property.completion_percentage || 0 %>%</div>
                      </div>
                    </div>

                    <!-- Titre -->
                    <div class="mb-2">
                      <h6 class="card-title text-dark mb-0 fw-semibold" style="font-size: 0.85rem; line-height: 1.2;"><%= property.titre || "Bien sans nom" %></h6>
                    </div>

                    <!-- Adresse compacte -->
                    <div class="address-section mb-2">
                      <% if property.rue && property.numero && property.commune %>
                        <p class="text-muted mb-0" style="font-size: 0.75rem; line-height: 1.2;">
                          <i class="bi bi-geo-alt me-1 text-muted"></i>
                          <%= property.rue %> <%= property.numero %><br>
                          <%= property.code_postal %> <%= property.commune %>
                        </p>
                      <% else %>
                        <p class="text-warning mb-0" style="font-size: 0.75rem;">
                          <i class="bi bi-exclamation-triangle me-1"></i>
                          Adresse incomplète
                        </p>
                      <% end %>
                    </div>

                    <!-- Statistiques compactes -->
                    <div class="stats-section mb-1 flex-grow-1">
                      <div class="row g-0 text-center" style="font-size: 0.65rem;">
                        <div class="col-4">
                          <div class="stat-item">
                            <div class="stat-number text-primary-custom fw-bold" style="font-size: 0.75rem;"><%= property.projects.count %></div>
                            <div class="stat-label text-muted">Projets</div>
                          </div>
                        </div>
                        <div class="col-4">
                          <div class="stat-item">
                            <div class="stat-number text-success fw-bold" style="font-size: 0.75rem;"><%= property.simulations.count %></div>
                            <div class="stat-label text-muted">Sims</div>
                          </div>
                        </div>
                        <div class="col-4">
                          <div class="stat-item">
                            <div class="stat-number text-info fw-bold" style="font-size: 0.75rem;"><%= property.documents.count %></div>
                            <div class="stat-label text-muted">Docs</div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Actions compactes -->
                    <div class="actions-section mt-auto">
                      <div class="d-flex gap-1">
                        <%= link_to dashboard_property_path(property), class: "btn btn-primary-custom btn-sm flex-fill py-1", style: "font-size: 0.7rem;" do %>
                          <i class="bi bi-speedometer2"></i>
                        <% end %>
                        <%= link_to edit_property_path(property), class: "btn btn-outline-secondary btn-sm flex-fill py-1", style: "font-size: 0.7rem;" do %>
                          <i class="bi bi-pencil"></i>
                        <% end %>
                        <%= link_to property_path(property),
                            class: "btn btn-outline-danger btn-sm flex-fill py-1",
                            style: "font-size: 0.7rem;",
                            data: {
                              confirm: "Êtes-vous sûr de vouloir supprimer ce bien ? Cette action est irréversible.",
                              turbo_method: :delete
                            } do %>
                          <i class="bi bi-trash"></i>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-house-door"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun bien enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par ajouter votre premier bien immobilier</p>
      <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Ajouter mon premier bien
      <% end %>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
