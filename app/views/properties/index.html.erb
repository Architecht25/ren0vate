<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Biens Immobiliers</h1>
    <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter un bien
    <% end %>
  </div>

  <!-- Liste minimaliste -->
  <% if @properties.any? %>
    <div class="row g-3">
      <% @properties.each do |property| %>
        <div class="col-md-6 col-lg-4">
          <%= link_to property_path(property), class: "text-decoration-none" do %>
            <div class="card border-0 bg-light-custom h-100 property-card">
              <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                  <div class="icon-circle me-3">
                    <i class="bi bi-house-door"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h5 class="card-title text-dark mb-1 fw-normal"><%= property.name %></h5>
                    <% if property.respond_to?(:location) && property.location.present? %>
                      <p class="text-muted-custom mb-0 small"><%= property.location %></p>
                    <% else %>
                      <p class="text-muted-custom mb-0 small">Adresse à renseigner</p>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-house-door"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun bien enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par ajouter votre premier bien immobilier</p>
      <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Ajouter mon premier bien
      <% end %>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
