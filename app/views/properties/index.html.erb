<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Biens Immobiliers</h1>
    <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter un bien
    <% end %>
  </div>

  <!-- Liste améliorée -->
  <% if @properties.any? %>
    <%
      # Grouper les propriétés par région pour afficher les séparateurs
      grouped_properties = @properties.group_by { |p| p.region&.downcase || 'autre' }
      region_order = ['flandre', 'bruxelles', 'wallonie', 'autre']
      region_names = {
        'flandre' => 'Flandre',
        'bruxelles' => 'Bruxelles',
        'wallonie' => 'Wallonie',
        'autre' => 'Autres régions'
      }
    %>

    <% region_order.each do |region_key| %>
      <% if grouped_properties[region_key]&.any? %>
        <!-- Séparateur de région -->
        <div class="row mb-3">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <h5 class="text-muted mb-0 me-3">
                <i class="bi bi-geo-alt me-2"></i><%= region_names[region_key] %>
              </h5>
              <hr class="flex-grow-1 my-0 text-muted">
              <span class="badge bg-light text-dark ms-3"><%= grouped_properties[region_key].count %> property<%= 's' if grouped_properties[region_key].count > 1 %></span>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-5">
          <% grouped_properties[region_key].each do |property| %>
        <div class="col-xl-4 col-lg-6 col-md-12">
          <div class="card border-0 h-100 property-card position-relative overflow-hidden" style="min-height: 200px; border-radius: 12px;">
            <!-- Image de fond sur toute la carte -->
            <% if property.photo.attached? %>
              <%= image_tag property.photo,
                  class: "position-absolute w-100 h-100",
                  style: "object-fit: cover; top: 0; left: 0; z-index: 1;",
                  alt: "Photo de #{property.titre || 'ce bien'}" %>
            <% else %>
              <div class="position-absolute w-100 h-100 d-flex align-items-center justify-content-center"
                   style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); top: 0; left: 0; z-index: 1;">
                <div class="text-center text-white">
                  <i class="bi bi-<%= property.is_entreprise? ? 'building' : 'house-door' %> opacity-50 mb-3" style="font-size: 3rem;"></i>
                  <div class="mb-2" style="font-size: 0.9rem; opacity: 0.9;">
                    Aucune photo
                  </div>
                  <%= link_to edit_property_path(property),
                      class: "btn btn-light btn-sm",
                      style: "font-size: 0.8rem; z-index: 10; position: relative;",
                      onclick: "event.stopPropagation();" do %>
                    <i class="bi bi-camera me-1"></i>Ajouter une photo
                  <% end %>
                </div>
              </div>
            <% end %>

            <!-- Overlay sombre pour la lisibilité -->
            <div class="position-absolute w-100 h-100" style="background: rgba(0,0,0,0.4); top: 0; left: 0; z-index: 2;"></div>

            <!-- Badge région en haut à gauche -->
            <% if property.region %>
              <div class="position-absolute top-0 start-0 m-2" style="z-index: 4;">
                <span class="badge bg-<%= property.region == 'wallonie' ? 'danger' : property.region == 'flandre' ? 'dark' : 'warning' %>" style="font-size: 0.7rem;">
                  <%= property.region.humanize %>
                </span>
              </div>
            <% end %>

            <!-- Menu actions trois points en haut à droite -->
            <div class="position-absolute top-0 end-0 m-2" style="z-index: 4;">
              <div class="dropdown dropup">
                <button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="opacity: 0.9;">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index: 1050;">
                  <li>
                    <%= link_to dashboard_property_path(property), class: "dropdown-item" do %>
                      <i class="bi bi-speedometer2 me-2"></i>Voir le dashboard
                    <% end %>
                  </li>
                  <li>
                    <%= link_to edit_property_path(property), class: "dropdown-item" do %>
                      <i class="bi bi-pencil me-2"></i>Modifier
                    <% end %>
                  </li>
                  <li><hr class="dropdown-divider"></li>
                  <li>
                    <%= link_to property_path(property),
                        class: "dropdown-item text-danger",
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "Êtes-vous sûr de vouloir supprimer le bien '#{property.titre || 'ce bien'}' ?\n\nCette action supprimera définitivement :\n- Le bien et ses informations\n- Tous les projets associés\n- Les documents liés\n\nCette action est irréversible."
                        } do %>
                      <i class="bi bi-trash me-2"></i>Supprimer
                    <% end %>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Contenu centré avec l'adresse -->
            <%= link_to dashboard_property_path(property), class: "text-decoration-none position-absolute w-100 h-100 d-flex align-items-center justify-content-center", style: "z-index: 3;" do %>
              <div class="text-center text-white">
                <!-- Titre du bien -->
                <h5 class="fw-bold mb-2" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.7);"><%= property.titre || "Bien sans nom" %></h5>

                <!-- Adresse -->
                <% if property.rue && property.numero && property.commune %>
                  <div class="text-white" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.8);">
                    <div style="font-size: 1rem; font-weight: 500;">
                      <i class="bi bi-geo-alt me-2"></i>
                      <%= property.rue %> <%= property.numero %>
                    </div>
                    <div style="font-size: 0.9rem; opacity: 0.9;">
                      <%= property.code_postal %> <%= property.commune %>
                    </div>
                  </div>
                <% else %>
                  <div class="text-warning" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.8);">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Adresse incomplète
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-house-door"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun bien enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par ajouter votre premier bien immobilier</p>
      <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Ajouter mon premier bien
      <% end %>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
