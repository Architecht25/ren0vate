<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Biens Immobiliers</h1>
    <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter un bien
    <% end %>
  </div>

  <!-- Bandeau métriques portfolio -->
  <% if @properties.any? %>
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-primary-light-ren0vate" style="border-radius: 12px;">
          <div class="fw-bold fs-3 text-primary-ren0vate"><%= @portfolio_stats[:biens_count] %></div>
          <div class="text-muted small"><i class="bi bi-houses me-1"></i>Bien<%= 's' if @portfolio_stats[:biens_count] > 1 %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-success-light-ren0vate" style="border-radius: 12px;">
          <div class="fw-bold fs-3 text-success-ren0vate"><%= number_to_currency(@portfolio_stats[:total_primes], unit: '€', format: '%n %u', precision: 0, delimiter: '.') %></div>
          <div class="text-muted small"><i class="bi bi-piggy-bank me-1"></i>Primes simulées</div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-accent-light-ren0vate" style="border-radius: 12px;">
          <div class="fw-bold fs-3 text-accent-ren0vate"><%= @portfolio_stats[:simulations_count] %></div>
          <div class="text-muted small"><i class="bi bi-calculator me-1"></i>Simulation<%= 's' if @portfolio_stats[:simulations_count] != 1 %></div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card border-0 text-center py-3 bg-danger-light-ren0vate" style="border-radius: 12px;">
          <div class="fw-bold fs-3 text-danger-ren0vate"><%= @portfolio_stats[:projets_actifs] %></div>
          <div class="text-muted small"><i class="bi bi-hammer me-1"></i>Projet<%= 's' if @portfolio_stats[:projets_actifs] != 1 %> actif<%= 's' if @portfolio_stats[:projets_actifs] != 1 %></div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Message d'information -->
  <div class="alert alert-info border-0 mb-4" style="background-color: #e8f4f8;">
    <div class="d-flex align-items-start">
      <i class="bi bi-info-circle me-3 mt-1" style="font-size: 1.2rem;"></i>
      <p class="mb-0">
        La création d'un bien immobilier est une étape fondamentale pour commencer votre parcours de rénovation. C'est ici que vous allez renseigner les informations principales du bien qui fera l'objet de la rénovation : son adresse, sa région, sa superficie, son année de construction et tout autre détail important. Ces informations serviront de base pour créer vos simulations de primes, vos projets de rénovation et suivre l'ensemble de vos démarches administratives.
      </p>
    </div>
  </div>

  <!-- Liste améliorée -->
  <% if @properties.any? %>
    <%
      # Grouper les propriétés par région pour afficher les séparateurs
      grouped_properties = @properties.group_by { |p| p.region&.downcase || 'autre' }
      region_order = ['flandre', 'bruxelles', 'wallonie', 'autre']
      region_names = {
        'flandre' => 'Flandre',
        'bruxelles' => 'Bruxelles',
        'wallonie' => 'Wallonie',
        'autre' => 'Autres régions'
      }
    %>

    <% region_order.each do |region_key| %>
      <% if grouped_properties[region_key]&.any? %>
        <!-- Séparateur de région -->
        <div class="row mb-3">
          <div class="col-12">
            <div class="d-flex align-items-center">
              <h5 class="text-muted mb-0 me-3">
                <i class="bi bi-geo-alt me-2"></i><%= region_names[region_key] %>
              </h5>
              <hr class="flex-grow-1 my-0 text-muted">
              <span class="badge bg-light text-dark ms-3"><%= grouped_properties[region_key].count %> property<%= 's' if grouped_properties[region_key].count > 1 %></span>
            </div>
          </div>
        </div>

        <div class="row g-3 mb-5">
          <% grouped_properties[region_key].each do |property| %>
            <% pct = property.completion_percentage %>
            <div class="col-xl-3 col-lg-4 col-md-6">
              <div class="card border-0 h-100 property-card position-relative overflow-hidden" style="min-height: 220px; border-radius: 12px;">

                <!-- COUCHE 1 : fond (photo ou dégradé) -->
                <% if property.photo.attached? %>
                  <%= image_tag property.photo,
                      class: "position-absolute w-100 h-100",
                      style: "object-fit: cover; top: 0; left: 0; z-index: 1;",
                      alt: "Photo de #{property.titre || 'ce bien'}" %>
                <% else %>
                  <div class="position-absolute w-100 h-100"
                       style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); top: 0; left: 0; z-index: 1;">
                    <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                      <i class="bi bi-house-door text-white opacity-25" style="font-size: 5rem;"></i>
                    </div>
                  </div>
                <% end %>

                <!-- COUCHE 2 : overlay sombre -->
                <div class="position-absolute w-100 h-100" style="background: rgba(0,0,0,0.45); top: 0; left: 0; z-index: 2;"></div>

                <!-- COUCHE 3 : lien cliquable (toute la carte) -->
                <%= link_to dashboard_property_path(property),
                    class: "position-absolute w-100 d-flex flex-column justify-content-center align-items-center text-decoration-none text-white",
                    style: "z-index: 3; top: 0; left: 0; bottom: 36px;" do %>
                  <h5 class="fw-bold mb-2 text-center px-3 text-arch-orange" style="text-shadow: 2px 2px 8px rgba(0,0,0,1);">
                    <%= property.titre || "Bien sans nom" %>
                  </h5>
                  <% if property.rue && property.numero && property.commune %>
                    <div class="text-center" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.9);">
                      <div style="font-size: 0.9rem; font-weight: 500;">
                        <i class="bi bi-geo-alt me-1"></i><%= property.rue %> <%= property.numero %>
                      </div>
                      <div style="font-size: 0.82rem; opacity: 0.85;">
                        <%= property.code_postal %> <%= property.commune %>
                      </div>
                    </div>
                  <% else %>
                    <div class="text-warning text-center" style="font-size: 0.82rem; text-shadow: 1px 1px 3px rgba(0,0,0,0.9);">
                      <i class="bi bi-exclamation-triangle me-1"></i>Adresse incomplète
                    </div>
                  <% end %>
                <% end %>

                <!-- COUCHE 4 : barre de complétion (bas fixe) -->
                <div class="position-absolute w-100" style="bottom: 0; left: 0; z-index: 4; background: rgba(0,0,0,0.55); padding: 6px 10px;">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-white" style="font-size: 0.68rem; opacity: 0.85;">Complétude</span>
                    <span class="text-white fw-semibold" style="font-size: 0.68rem;"><%= pct %>%</span>
                  </div>
                  <div class="progress" style="height: 3px; background: rgba(255,255,255,0.25); border-radius: 2px;">
                    <div class="progress-bar <%= pct >= 80 ? 'bg-success' : pct >= 40 ? 'bg-warning' : 'bg-danger' %>"
                         role="progressbar" style="width: <%= pct %>%;"></div>
                  </div>
                </div>

                <!-- COUCHE 5 : badge région (haut gauche) -->
                <% if property.region %>
                  <div class="position-absolute top-0 start-0 m-2" style="z-index: 5;">
                    <span class="badge bg-<%= property.region == 'wallonie' ? 'danger' : property.region == 'flandre' ? 'dark' : 'warning' %>" style="font-size: 0.65rem;">
                      <%= property.region.humanize %>
                    </span>
                  </div>
                <% end %>

                <!-- COUCHE 5 : menu actions (haut droite) -->
                <div class="position-absolute top-0 end-0 m-2" style="z-index: 5;">
                  <div class="dropdown">
                    <button class="btn btn-sm btn-dark btn-dark opacity-75 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="padding: 2px 7px;">
                      <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index: 1050;">
                      <li>
                        <%= link_to dashboard_property_path(property), class: "dropdown-item" do %>
                          <i class="bi bi-speedometer2 me-2"></i>Voir le dashboard
                        <% end %>
                      </li>
                      <li>
                        <%= link_to edit_property_path(property), class: "dropdown-item" do %>
                          <i class="bi bi-pencil me-2"></i>Modifier
                        <% end %>
                      </li>
                      <% unless property.photo.attached? %>
                        <li>
                          <%= link_to edit_property_path(property), class: "dropdown-item" do %>
                            <i class="bi bi-camera me-2"></i>Ajouter une photo
                          <% end %>
                        </li>
                      <% end %>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <%= link_to property_path(property),
                            class: "dropdown-item text-danger",
                            data: {
                              turbo_method: :delete,
                              turbo_confirm: "Êtes-vous sûr de vouloir supprimer le bien '#{property.titre || 'ce bien'}' ?\n\nCette action supprimera définitivement :\n- Le bien et ses informations\n- Tous les projets associés\n- Les documents liés\n\nCette action est irréversible."
                            } do %>
                          <i class="bi bi-trash me-2"></i>Supprimer
                        <% end %>
                      </li>
                    </ul>
                  </div>
                </div>

              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-house-door"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun bien enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par ajouter votre premier bien immobilier</p>
      <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Ajouter mon premier bien
      <% end %>
    </div>
  <% end %>
</div>
