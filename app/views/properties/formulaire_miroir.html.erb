<% content_for :title, "Formulaire Miroir - #{@property.name}" %>

<div class="container-fluid py-4">
  <!-- Header avec indicateurs -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <h1 class="h3 mb-1">
                <i class="bi bi-file-text text-primary me-2"></i>
                Formulaire Miroir - Flandre
              </h1>
              <p class="text-muted mb-0">Prévisualisation de votre demande avant soumission officielle</p>
            </div>
            <%= link_to property_dashboard_path(@property), class: "btn btn-outline-secondary" do %>
              <i class="bi bi-arrow-left me-2"></i>Retour au dashboard
            <% end %>
          </div>

          <!-- Indicateurs de complétude -->
          <div class="row g-3">
            <div class="col-md-3">
              <div class="d-flex align-items-center">
                <div class="progress-circle-small me-3">
                  <div class="progress-fill-<%= @completion_stats[:admin] %>"></div>
                  <span class="progress-text"><%= @completion_stats[:admin] %>%</span>
                </div>
                <div>
                  <div class="fw-semibold">Informations</div>
                  <small class="text-muted">Profil & logement</small>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center">
                <div class="progress-circle-small me-3">
                  <div class="progress-fill-<%= @completion_stats[:chantier] %>"></div>
                  <span class="progress-text"><%= @completion_stats[:chantier] %>%</span>
                </div>
                <div>
                  <div class="fw-semibold">Travaux</div>
                  <small class="text-muted">Détails techniques</small>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center">
                <div class="progress-circle-small me-3">
                  <div class="progress-fill-<%= @completion_stats[:documents] %>"></div>
                  <span class="progress-text"><%= @completion_stats[:documents] %>%</span>
                </div>
                <div>
                  <div class="fw-semibold">Documents</div>
                  <small class="text-muted">Pièces justificatives</small>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <div class="d-flex align-items-center">
                <div class="progress-circle-small me-3 <%= @property.submission_readiness_class %>">
                  <div class="progress-fill-<%= @completion_stats[:overall] %>"></div>
                  <span class="progress-text"><%= @completion_stats[:overall] %>%</span>
                </div>
                <div>
                  <div class="fw-semibold">Prêt</div>
                  <small class="text-muted">Pour soumission</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Alerte si pas prêt -->
          <% unless @property.ready_for_submission? %>
            <div class="alert alert-warning mt-3">
              <i class="bi bi-exclamation-triangle me-2"></i>
              <strong>Attention :</strong> Votre dossier n'est pas encore complet pour la soumission.
              <ul class="mb-0 mt-2">
                <% @property.missing_for_submission.each do |missing| %>
                  <li><%= missing %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Formulaire Miroir -->
  <%= form_with url: submit_prime_property_path(@property), method: :post,
               local: true, class: "formulaire-miroir" do |form| %>

    <!-- Section 0: Conditions préalables -->
    <section class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light">
        <h3 class="card-title mb-0">
          <span class="badge bg-primary me-2">0</span>
          Conditions préalables
        </h3>
      </div>
      <div class="card-body">
        <p>Le dépôt de votre demande ne peut se faire que si vous êtes domicilié dans votre bien après travaux</p>
        <div class="form-check">
          <%= form.check_box :domicile,
                             { class: "form-check-input", required: true },
                             "true", "" %>
          <%= form.label :domicile,
                        "Êtes-vous bien domicilié dans votre bien?",
                        class: "form-check-label" %>
        </div>
      </div>
    </section>

    <!-- Section 1: Profil du demandeur -->
    <section class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light">
        <h3 class="card-title mb-0">
          <span class="badge bg-primary me-2">1</span>
          Profil du demandeur
          <% if @completion_stats[:admin] >= 80 %>
            <span class="badge bg-success ms-2">✅ Complet</span>
          <% else %>
            <span class="badge bg-warning ms-2">⚠️ À compléter</span>
          <% end %>
        </h3>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <%= form.label :type_demandeur, "Type de demandeur *", class: "form-label" %>
            <%= form.select :type_demandeur,
                           options_for_select([
                             ['-- Sélectionnez --', ''],
                             ['Particulier', 'particulier'],
                             ['Société', 'societe'],
                             ['Syndicat de copropriété', 'syndic'],
                             ['Bailleur social', 'bailleur_social'],
                             ['ASBL ou Coopérative', 'asbl_cooperative']
                           ], 'particulier'),
                           { required: true },
                           { class: "form-select" } %>
          </div>
          <div class="col-md-6">
            <%= form.label :registre_national, "Numéro de registre national ou BCE *", class: "form-label" %>
            <%= form.text_field :registre_national,
                               value: @form_data[:registre_national],
                               class: "form-control",
                               required: true %>
          </div>
          <div class="col-md-6">
            <%= form.label :nom, "Nom du demandeur *", class: "form-label" %>
            <%= form.text_field :nom,
                               value: @form_data[:nom],
                               class: "form-control",
                               required: true %>
          </div>
          <div class="col-md-6">
            <%= form.label :prenom, "Prénom du demandeur *", class: "form-label" %>
            <%= form.text_field :prenom,
                               value: @form_data[:prenom],
                               class: "form-control",
                               required: true %>
          </div>
          <div class="col-md-6">
            <%= form.label :telephone, "Téléphone *", class: "form-label" %>
            <%= form.telephone_field :telephone,
                                    value: @form_data[:telephone],
                                    class: "form-control",
                                    required: true %>
          </div>
          <div class="col-md-6">
            <%= form.label :email, "Adresse email *", class: "form-label" %>
            <%= form.email_field :email,
                                value: @form_data[:email],
                                class: "form-control",
                                required: true %>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Données du logement -->
    <section class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light">
        <h3 class="card-title mb-0">
          <span class="badge bg-primary me-2">2</span>
          Données du logement concerné
          <% if @form_data[:ean].present? && @form_data[:adresse].present? %>
            <span class="badge bg-success ms-2">✅ Pré-rempli</span>
          <% else %>
            <span class="badge bg-warning ms-2">⚠️ À vérifier</span>
          <% end %>
        </h3>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <%= form.label :ean, "Code EAN *", class: "form-label" %>
            <%= form.text_field :ean,
                               value: @form_data[:ean],
                               class: "form-control",
                               placeholder: "Ex: 54144...",
                               required: true %>
          </div>
          <div class="col-md-6">
            <%= form.label :parcelle, "Numéro de parcelle (optionnel)", class: "form-label" %>
            <%= form.text_field :parcelle,
                               value: @form_data[:parcelle],
                               class: "form-control" %>
          </div>
          <div class="col-md-8">
            <%= form.label :adresse, "Adresse du logement *", class: "form-label" %>
            <%= form.text_field :adresse,
                               value: @form_data[:adresse],
                               class: "form-control",
                               required: true %>
          </div>
          <div class="col-md-4">
            <%= form.label :code_postal, "Code postal *", class: "form-label" %>
            <%= form.text_field :code_postal,
                               value: @form_data[:code_postal],
                               class: "form-control",
                               required: true %>
          </div>
          <div class="col-md-6">
            <%= form.label :commune, "Commune *", class: "form-label" %>
            <%= form.text_field :commune,
                               value: @form_data[:commune],
                               class: "form-control",
                               required: true %>
          </div>
          <div class="col-md-6">
            <%= form.label :type_bien, "Type de bien *", class: "form-label" %>
            <%= form.select :type_bien,
                           options_for_select([
                             ['-- Sélectionnez --', ''],
                             ['Maison unifamiliale', 'maison'],
                             ['Appartement', 'appartement'],
                             ['Immeuble avec plusieurs unités', 'immeuble']
                           ], @form_data[:type_bien]),
                           { required: true },
                           { class: "form-select" } %>
          </div>
          <div class="col-md-6">
            <%= form.label :usage, "Usage du bien *", class: "form-label" %>
            <%= form.select :usage,
                           options_for_select([
                             ['-- Sélectionnez --', ''],
                             ['Résidence principale', 'residence_principale'],
                             ['Bien en location', 'location'],
                             ['Autre', 'autre']
                           ], @form_data[:usage]),
                           { required: true },
                           { class: "form-select" } %>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Travaux -->
    <section class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light">
        <h3 class="card-title mb-0">
          <span class="badge bg-primary me-2">3</span>
          Travaux à déclarer
          <% if @completion_stats[:chantier] >= 60 %>
            <span class="badge bg-success ms-2">✅ Spécifiés</span>
          <% else %>
            <span class="badge bg-warning ms-2">⚠️ À détailler</span>
          <% end %>
        </h3>
      </div>
      <div class="card-body">
        <p class="mb-4">Veuillez cocher les types de travaux envisagés et compléter les champs demandés.</p>

        <!-- Travaux détaillés -->
        <%= render 'formulaire_miroir/travaux_section', form: form, form_data: @form_data %>
      </div>
    </section>

    <!-- Section 4: Documents -->
    <section class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light">
        <h3 class="card-title mb-0">
          <span class="badge bg-primary me-2">4</span>
          Documents justificatifs
          <% if @completion_stats[:documents] >= 80 %>
            <span class="badge bg-success ms-2">✅ Complets</span>
          <% else %>
            <span class="badge bg-warning ms-2">⚠️ Manquants</span>
          <% end %>
        </h3>
      </div>
      <div class="card-body">
        <p class="mb-3">Récapitulatif des documents déjà fournis dans Ren0vate :</p>

        <div class="row g-3 mb-4">
          <% @property.documents.group_by(&:type_document).each do |type, docs| %>
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-check text-success me-2"></i>
                <span><%= type.humanize %> (<%= docs.count %>)</span>
              </div>
            </div>
          <% end %>
        </div>

        <div class="alert alert-info">
          <i class="bi bi-info-circle me-2"></i>
          Les documents seront automatiquement joints lors de la soumission.
          Vous pouvez encore les modifier via la <%= link_to "gestion des documents", documents_dashboard_property_path(@property), class: "alert-link" %>.
        </div>
      </div>
    </section>

    <!-- Section Success Fee -->
    <% if @property.ready_for_submission? %>
      <section class="card border-0 shadow-sm mb-4 border-warning">
        <div class="card-header bg-warning text-dark">
          <h3 class="card-title mb-0">
            <i class="bi bi-credit-card me-2"></i>
            Conditions de Success Fee
          </h3>
        </div>
        <div class="card-body">
          <% submission = PrimeSubmission.new(property: @property, region: @property.region) %>
          <div class="row g-3">
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body text-center">
                  <h5 class="text-primary">Estimation Prime</h5>
                  <div class="h3 text-success"><%= number_to_currency(submission.estimated_amount, unit: '€', delimiter: ' ') %></div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card bg-light">
                <div class="card-body text-center">
                  <h5 class="text-primary">Success Fee (<%= submission.success_fee_percentage %>%)</h5>
                  <div class="h3 text-warning"><%= number_to_currency(submission.success_fee_amount, unit: '€', delimiter: ' ') %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-3">
            <div class="form-check">
              <%= form.check_box :accept_success_fee,
                                 { class: "form-check-input", required: true },
                                 "true", "" %>
              <%= form.label :accept_success_fee, class: "form-check-label fw-bold" do %>
                J'accepte de payer <%= submission.success_fee_percentage %>% de commission
                (<%= number_to_currency(submission.success_fee_amount, unit: '€', delimiter: ' ') %>)
                uniquement si ma prime est accordée et versée.
              <% end %>
            </div>
          </div>
        </div>
      </section>
    <% end %>

    <!-- Section Soumission -->
    <section class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light">
        <h3 class="card-title mb-0">
          <span class="badge bg-primary me-2">5</span>
          Soumission de la demande
        </h3>
      </div>
      <div class="card-body">
        <p class="mb-3">
          Vous êtes sur le point de soumettre votre demande officielle vers l'administration flamande.
          Veuillez vérifier que toutes les informations sont correctes.
        </p>

        <div class="form-check my-3">
          <%= form.check_box :confirmation_veracite,
                             { class: "form-check-input", required: true },
                             "true", "" %>
          <%= form.label :confirmation_veracite,
                        "Je confirme que les informations fournies sont exactes et complètes à ma connaissance.",
                        class: "form-check-label fw-bold" %>
        </div>

        <div class="form-check my-3">
          <%= form.check_box :mentions_legales,
                             { class: "form-check-input", required: true },
                             "true", "" %>
          <%= form.label :mentions_legales,
                        "J'accepte les conditions générales et les mentions légales de Ren0vate.",
                        class: "form-check-label" %>
        </div>

        <div class="mt-4">
          <% if @property.ready_for_submission? && current_user.can_submit? %>
            <%= form.submit "🚀 Soumettre la demande officielle",
                           class: "btn btn-success btn-lg me-3",
                           data: { confirm: "Êtes-vous sûr de vouloir soumettre cette demande ? Cette action est irréversible." } %>
          <% else %>
            <button type="button" class="btn btn-secondary btn-lg me-3" disabled>
              <i class="bi bi-lock me-2"></i>Soumission non disponible
            </button>
          <% end %>

          <button type="button" class="btn btn-outline-primary btn-lg" onclick="window.print()">
            <i class="bi bi-printer me-2"></i>Imprimer le résumé
          </button>
        </div>

        <% unless @property.ready_for_submission? %>
          <div class="alert alert-warning mt-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Pour activer la soumission, complétez d'abord votre dossier via le dashboard.
          </div>
        <% end %>

        <% unless current_user.can_submit? %>
          <div class="alert alert-info mt-3">
            <i class="bi bi-info-circle me-2"></i>
            L'accès à la soumission nécessite l'acceptation des conditions success fee.
          </div>
        <% end %>
      </div>
    </section>

  <% end %>
</div>

<style>
.formulaire-miroir .card {
  transition: all 0.3s ease;
}

.formulaire-miroir .card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
}

.progress-circle-small {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  position: relative;
  border: 3px solid #e9ecef;
}

.progress-circle-small.bg-success {
  border-color: #28a745;
}

.progress-circle-small.bg-warning {
  border-color: #ffc107;
}

.progress-circle-small.bg-danger {
  border-color: #dc3545;
}

.progress-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 0.75rem;
  font-weight: bold;
}

@media print {
  .btn, .alert, .card-header {
    display: none !important;
  }
}
</style>
