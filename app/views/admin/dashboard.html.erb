<div class="container-fluid px-4 py-4">
  <!-- Header principal -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h2 text-primary-custom mb-1">
        <i class="bi bi-gear me-3"></i>Centre de Commandement Admin
      </h1>
      <p class="text-muted mb-0">Pilotez votre application Ren0vate</p>
    </div>
    <div class="d-flex gap-2">
      <span class="badge bg-success fs-6 px-3 py-2">
        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
        Système opérationnel
      </span>
    </div>
  </div>

  <!-- Vue d'ensemble rapide -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @users.count %></h3>
              <small class="opacity-75">Utilisateurs totaux</small>
            </div>
            <i class="bi bi-people fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @notifications.count %></h3>
              <small class="opacity-75">Notifications actives</small>
            </div>
            <i class="bi bi-bell fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @properties.count %></h3>
              <small class="opacity-75">Propriétés enregistrées</small>
            </div>
            <i class="bi bi-house fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @simulations.count %></h3>
              <small class="opacity-75">Simulations réalisées</small>
            </div>
            <i class="bi bi-calculator fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation par onglets -->
  <ul class="nav nav-pills nav-fill mb-4" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-panel" type="button" role="tab">
        <i class="bi bi-people me-2"></i>Utilisateurs
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="notifications-tab" data-bs-toggle="pill" data-bs-target="#notifications-panel" type="button" role="tab">
        <i class="bi bi-bell me-2"></i>Notifications
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="stats-tab" data-bs-toggle="pill" data-bs-target="#stats-panel" type="button" role="tab">
        <i class="bi bi-graph-up me-2"></i>Statistiques
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="system-tab" data-bs-toggle="pill" data-bs-target="#system-panel" type="button" role="tab">
        <i class="bi bi-gear me-2"></i>Système
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="security-tab" data-bs-toggle="pill" data-bs-target="#security-panel" type="button" role="tab">
        <i class="bi bi-shield-check me-2"></i>Sécurité
      </button>
    </li>
  </ul>

  <!-- Contenu des onglets -->
  <div class="tab-content" id="adminTabsContent">

    <!-- ========== ONGLET NOTIFICATIONS ========== -->
    <div class="tab-pane fade" id="notifications-panel" role="tabpanel">
      <div class="row">
        <!-- Statistiques notifications -->
        <div class="col-md-8">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Vue d'ensemble des notifications</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-primary-custom mb-0"><%= @notifications.count %></h4>
                    <small class="text-muted">Total</small>
                  </div>
                </div>
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-warning mb-0"><%= @notifications.unread.count %></h4>
                    <small class="text-muted">Non lues</small>
                  </div>
                </div>
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-info mb-0"><%= @notifications.where("type LIKE 'admin_%'").count %></h4>
                    <small class="text-muted">Admin</small>
                  </div>
                </div>
                <div class="col-3">
                  <h4 class="text-success mb-0"><%= @notifications.where(created_at: 24.hours.ago..Time.current).count %></h4>
                  <small class="text-muted">Aujourd'hui</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Dernières notifications -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Activité récente</h5>
            </div>
            <div class="card-body">
              <% if @notifications.any? %>
                <% @notifications.order(created_at: :desc).limit(5).each do |notification| %>
                  <div class="d-flex align-items-center py-2 border-bottom">
                    <div class="me-3">
                      <i class="bi bi-<%= notification.type.include?('admin') ? 'megaphone' : 'bell' %> text-<%= notification.type.include?('admin') ? 'info' : 'primary' %>"></i>
                    </div>
                    <div class="flex-grow-1">
                      <h6 class="mb-1"><%= notification.title.truncate(50) %></h6>
                      <small class="text-muted">
                        <%= notification.type.humanize %> • <%= time_ago_in_words(notification.created_at) %>
                      </small>
                    </div>
                    <span class="badge bg-<%= notification.type.include?('admin') ? 'info' : 'secondary' %>">
                      <%= notification.priority&.capitalize || 'Normal' %>
                    </span>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="bi bi-bell-slash fs-1 mb-3"></i>
                  <p>Aucune notification créée</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Actions rapides -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Actions rapides</h5>
            </div>
            <div class="card-body">
              <div class="d-grid gap-3">
                <%= link_to new_admin_notifications_path, class: "btn btn-primary-custom btn-lg" do %>
                  <i class="bi bi-plus-circle me-2"></i>Créer notification
                <% end %>

                <button type="button" id="generate-automatic-notifications-btn" class="btn btn-outline-info btn-lg">
                  <i class="bi bi-robot me-2"></i>Générer automatiques
                </button>

                <%= link_to notifications_path, class: "btn btn-outline-secondary" do %>
                  <i class="bi bi-list me-2"></i>Voir toutes
                <% end %>
              </div>
            </div>
          </div>

          <!-- Types de notifications -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Répartition par type</h5>
            </div>
            <div class="card-body">
              <% notification_types = @notifications.group(:type).count %>
              <% if notification_types.any? %>
                <% notification_types.each do |type, count| %>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small">
                      <i class="bi bi-<%= type.include?('admin') ? 'megaphone' : 'bell' %> me-1"></i>
                      <%= type.humanize %>
                    </span>
                    <span class="badge bg-light text-dark"><%= count %></span>
                  </div>
                <% end %>
              <% else %>
                <small class="text-muted">Aucune donnée disponible</small>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET UTILISATEURS ========== -->
    <div class="tab-pane fade show active" id="users-panel" role="tabpanel">
      <div class="row">
        <div class="col-md-4">
          <!-- Stats utilisateurs -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-people me-2"></i>Aperçu des utilisateurs</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-12 mb-3">
                  <h3 class="text-primary-custom mb-0"><%= @users.count %></h3>
                  <small class="text-muted">Utilisateurs inscrits</small>
                </div>
              </div>
              <div class="mb-3">
                <h6>Répartition par région</h6>
                <% User.group(:region).count.each do |region, count| %>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small">
                      <i class="bi bi-geo-alt me-1"></i>
                      <%= region&.capitalize || 'Non définie' %>
                    </span>
                    <span class="badge bg-primary-custom"><%= count %></span>
                  </div>
                <% end %>
              </div>
              <div class="mb-3">
                <h6>Profils complétés</h6>
                <% complete_profiles = @users.select { |u| u.first_name.present? && u.last_name.present? && u.region.present? }.count %>
                <div class="progress">
                  <div class="progress-bar bg-success" style="width: <%= (@users.count > 0 ? (complete_profiles.to_f / @users.count * 100) : 0).round(1) %>%"></div>
                </div>
                <small class="text-muted"><%= complete_profiles %>/<%= @users.count %> profils complets</small>
              </div>

              <div class="mb-3">
                <h6>Activité globale</h6>
                <div class="row g-2">
                  <div class="col-6">
                    <div class="text-center p-2 bg-info bg-opacity-10 rounded">
                      <div class="h5 mb-0 text-info"><%= @properties.count %></div>
                      <small class="text-muted">Propriétés</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="text-center p-2 bg-warning bg-opacity-10 rounded">
                      <div class="h5 mb-0 text-warning"><%= @projects.count %></div>
                      <small class="text-muted">Chantiers</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="text-center p-2 bg-success bg-opacity-10 rounded">
                      <div class="h5 mb-0 text-success"><%= @simulations.count %></div>
                      <small class="text-muted">Simulations</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="text-center p-2 bg-secondary bg-opacity-10 rounded">
                      <div class="h5 mb-0 text-secondary"><%= @documents.count %></div>
                      <small class="text-muted">Documents</small>
                    </div>
                  </div>
                </div>
                <hr class="my-2">
                <div class="row g-2">
                  <div class="col-6">
                    <small class="text-muted">
                      <i class="bi bi-bell me-1"></i><%= @notifications.count %> notifications
                    </small>
                  </div>
                  <div class="col-6">
                    <small class="text-muted">
                      <i class="bi bi-list-check me-1"></i><%= @requests.count %> demandes
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-8">
          <!-- Liste des utilisateurs -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
              <h5 class="mb-0"><i class="bi bi-list me-2"></i>Utilisateurs récents</h5>
              <small class="text-muted">Derniers inscrits</small>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Utilisateur</th>
                      <th>Région</th>
                      <th>Inscription</th>
                      <th>Statistiques d'activité</th>
                      <th>Statut</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @users.order(created_at: :desc).each do |user| %>
                      <tr>
                        <td>
                          <div>
                            <strong><%= user.email %></strong>
                            <% if user.first_name.present? || user.last_name.present? %>
                              <br><small class="text-muted"><%= "#{user.first_name} #{user.last_name}".strip %></small>
                            <% end %>
                          </div>
                        </td>
                        <td>
                          <% if user.region.present? %>
                            <span class="badge bg-<%= user.region == 'wallonie' ? 'success' : user.region == 'bruxelles' ? 'primary' : 'warning' %>">
                              <%= user.region.capitalize %>
                            </span>
                          <% else %>
                            <span class="badge bg-secondary">Non définie</span>
                          <% end %>
                        </td>
                        <td>
                          <small class="text-muted"><%= user.created_at.strftime("%d/%m/%Y") %></small>
                        </td>
                        <td>
                          <div class="d-flex flex-wrap gap-1 align-items-center">
                            <span class="badge bg-primary text-white px-2 py-1" title="Propriétés">
                              <i class="bi bi-house me-1"></i><%= user.properties.count %>
                            </span>
                            <span class="badge bg-warning text-dark px-2 py-1" title="Chantiers">
                              <i class="bi bi-hammer me-1"></i><%= user.projects.count %>
                            </span>
                            <span class="badge bg-success text-white px-2 py-1" title="Simulations">
                              <i class="bi bi-calculator me-1"></i><%= user.simulations.count %>
                            </span>
                            <span class="badge bg-info text-white px-2 py-1" title="Documents">
                              <i class="bi bi-file-earmark me-1"></i><%= user.documents.count %>
                            </span>
                            <span class="badge bg-secondary text-white px-2 py-1" title="Notifications">
                              <i class="bi bi-bell me-1"></i><%= user.notifications.count %>
                            </span>
                            <span class="badge bg-dark text-white px-2 py-1" title="Demandes">
                              <i class="bi bi-list-check me-1"></i><%= user.requests.count %>
                            </span>
                          </div>
                        </td>
                        <td>
                          <% if user.first_name.present? && user.last_name.present? && user.region.present? %>
                            <span class="badge bg-success">✓ Complet</span>
                          <% else %>
                            <span class="badge bg-warning">⚠ Incomplet</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET STATISTIQUES ========== -->
    <div class="tab-pane fade" id="stats-panel" role="tabpanel">
      <div class="row">
        <div class="col-md-6">
          <!-- Stats générales -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <div class="card text-center border-0 shadow-sm">
                <div class="card-body">
                  <h3 class="text-primary"><%= @properties.count %></h3>
                  <p class="card-text small">Propriétés enregistrées</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div class="card text-center border-0 shadow-sm">
                <div class="card-body">
                  <h3 class="text-warning"><%= @projects.count %></h3>
                  <p class="card-text small">Chantiers créés</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div class="card text-center border-0 shadow-sm">
                <div class="card-body">
                  <h3 class="text-danger"><%= @simulations.count %></h3>
                  <p class="card-text small">Simulations effectuées</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div class="card text-center border-0 shadow-sm">
                <div class="card-body">
                  <h3 class="text-info"><%= @documents.count %></h3>
                  <p class="card-text small">Documents téléchargés</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <!-- Primes par région -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Primes par région</h5>
            </div>
            <div class="card-body">
              <% @primes.group_by(&:region).each do |region, primes| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span><%= region.capitalize %></span>
                  <span class="badge bg-success"><%= primes.count %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET SYSTÈME ========== -->
    <div class="tab-pane fade" id="system-panel" role="tabpanel">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Informations système</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h6>Environnement</h6>
              <p><code><%= Rails.env %></code></p>

              <h6>Version Rails</h6>
              <p><code><%= Rails.version %></code></p>
            </div>
            <div class="col-md-6">
              <h6>Base de données</h6>
              <p><code><%= ActiveRecord::Base.connection.adapter_name %></code></p>

              <h6>Dernière mise à jour</h6>
              <p><code><%= Time.current.strftime("%d/%m/%Y %H:%M") %></code></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET SÉCURITÉ ========== -->
    <div class="tab-pane fade" id="security-panel" role="tabpanel">
      <div class="row">
        <!-- État général de la sécurité -->
        <div class="col-12 mb-4">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-danger text-white">
              <h5 class="mb-0"><i class="bi bi-shield-check me-2"></i>État de la sécurité</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-shield-fill-check text-success display-4"></i>
                    <h6 class="mt-2">HTTPS/SSL</h6>
                    <span class="badge bg-success">ACTIF</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-lock-fill text-success display-4"></i>
                    <h6 class="mt-2">Authentification</h6>
                    <span class="badge bg-success">DEVISE</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-envelope-check-fill text-success display-4"></i>
                    <h6 class="mt-2">Email Confirm</h6>
                    <span class="badge bg-success">ACTIF</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-eye-slash-fill text-success display-4"></i>
                    <h6 class="mt-2">CSP</h6>
                    <span class="badge bg-success">ENFORCED</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-database-lock text-success display-4"></i>
                    <h6 class="mt-2">Sessions</h6>
                    <span class="badge bg-success">SÉCURISÉES</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-people-fill <%= User.admin.count == 1 ? 'text-success' : 'text-warning' %> display-4"></i>
                    <h6 class="mt-2">Gestion Rôles</h6>
                    <span class="badge bg-<%= User.admin.count == 1 ? 'success' : 'warning' %>" id="admin-roles-status">
                      <%= User.admin.count %> ADMIN<%= 's' if User.admin.count > 1 %>
                    </span>
                  </div>
                </div>
              </div>

              <!-- Score global de sécurité -->
              <div class="row mt-4">
                <div class="col-12 text-center">
                  <div class="security-status">
                    <i class="bi bi-graph-up text-success display-5"></i>
                    <h5 class="mt-2 mb-3">Score Global de Sécurité</h5>
                    <span class="badge bg-success fs-4 px-4 py-2" id="global-security-score">
                      <%= User.admin.count == 1 ? '98%' : '85%' %>
                      <i class="bi bi-<%= User.admin.count == 1 ? 'check-circle' : 'exclamation-triangle' %> ms-2"></i>
                    </span>
                    <p class="text-muted mt-2 mb-0">
                      <%= User.admin.count == 1 ? 'Configuration optimale' : 'Amélioration possible' %>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Headers de sécurité -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-primary text-white">
              <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Headers de sécurité</h6>
            </div>
            <div class="card-body">
              <div class="security-check-list">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>X-Frame-Options</span>
                  <span class="badge bg-success">SAMEORIGIN</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>X-Content-Type-Options</span>
                  <span class="badge bg-success">nosniff</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>X-XSS-Protection</span>
                  <span class="badge bg-success">1; mode=block</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>Referrer-Policy</span>
                  <span class="badge bg-success">strict-origin</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>HSTS</span>
                  <span class="badge bg-success">31536000s</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <span>Permissions-Policy</span>
                  <span class="badge bg-success">Restrictive</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Content Security Policy -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-warning text-dark">
              <h6 class="mb-0"><i class="bi bi-eye-slash me-2"></i>Content Security Policy</h6>
            </div>
            <div class="card-body">
              <div class="row mb-3">
                <div class="col-6">
                  <small class="text-muted">Mode</small>
                  <div class="fw-bold">
                    <%= Rails.env.production? ? 'Enforcement' : 'Report-only' %>
                    <i class="bi bi-<%= Rails.env.production? ? 'shield-fill-check text-success' : 'shield-exclamation text-warning' %>"></i>
                  </div>
                </div>
                <div class="col-6">
                  <small class="text-muted">Environment</small>
                  <div class="fw-bold"><%= Rails.env.upcase %></div>
                </div>
              </div>

              <div class="csp-directives">
                <small class="text-muted d-block mb-2">Directives principales :</small>
                <div class="mb-1"><code class="small">default-src 'self'</code></div>
                <div class="mb-1"><code class="small">script-src 'self' https: CDNs</code></div>
                <div class="mb-1"><code class="small">style-src 'self' https: 'unsafe-inline'</code></div>
                <div class="mb-1"><code class="small">img-src 'self' https: data: cloudinary</code></div>
                <div class="mb-1"><code class="small">connect-src 'self' APIs</code></div>
                <div><code class="small">object-src 'none'</code></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Violations CSP récentes -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-info text-white">
              <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Violations CSP (24h)</h6>
            </div>
            <div class="card-body">
              <div class="text-center">
                <div class="display-6 text-muted mb-2">
                  <i class="bi bi-graph-down"></i>
                </div>
                <h3 class="text-success mb-2">
                  <span id="csp-violations-count">0</span>
                </h3>
                <p class="text-muted mb-3">violations critiques détectées</p>
                <small class="text-muted">
                  Les violations sont automatiquement loggées et analysées.<br>
                  Endpoint : <code>/csp-violation-report-endpoint</code>
                </small>
              </div>
            </div>
          </div>
        </div>

        <!-- Authentification et sessions -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-success text-white">
              <h6 class="mb-0"><i class="bi bi-person-lock me-2"></i>Authentification</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Devise configuré</span>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>OUI
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Confirmation email</span>
                    <span class="badge bg-success">
                      <i class="bi bi-envelope-check me-1"></i>ACTIF
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Utilisateurs confirmés</span>
                    <span class="badge bg-info">
                      <i class="bi bi-people me-1"></i><span id="confirmed-users-count">-</span>
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>En attente confirmation</span>
                    <span class="badge bg-warning">
                      <i class="bi bi-hourglass me-1"></i><span id="unconfirmed-users-count">-</span>
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Sessions sécurisées</span>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>secure, httponly
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>CSRF Protection</span>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>ACTIF
                    </span>
                  </div>
                </div>
                <div class="col-12">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Utilisateurs actifs</span>
                    <span class="badge bg-primary"><%= @users.count %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Monitoring des rôles administrateur -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-<%= User.admin.count == 1 ? 'primary' : 'warning' %> text-white">
              <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Gestion des Rôles</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Administrateurs</span>
                    <span class="badge bg-<%= User.admin.count == 1 ? 'success' : 'warning' %>">
                      <i class="bi bi-<%= User.admin.count == 1 ? 'check-circle' : 'exclamation-triangle' %> me-1"></i>
                      <%= User.admin.count %>
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Modérateurs</span>
                    <span class="badge bg-info">
                      <i class="bi bi-shield me-1"></i><%= User.moderator.count %>
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Utilisateurs standard</span>
                    <span class="badge bg-secondary">
                      <i class="bi bi-person me-1"></i><%= User.user.count %>
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Sécurité admin</span>
                    <span class="badge bg-<%= User.admin.count == 1 ? 'success' : 'danger' %>">
                      <i class="bi bi-<%= User.admin.count == 1 ? 'check-circle' : 'x-circle' %> me-1"></i>
                      <%= User.admin.count == 1 ? 'OPTIMAL' : 'RISQUE' %>
                    </span>
                  </div>
                </div>
                <div class="col-12">
                  <small class="text-muted">
                    <strong>Admin unique :</strong>
                    <% if User.admin.count == 1 %>
                      <%= User.admin.first.email %>
                      <i class="bi bi-check-circle text-success ms-1"></i>
                    <% else %>
                      <span class="text-warning">Multiples administrateurs détectés</span>
                      <i class="bi bi-exclamation-triangle text-warning ms-1"></i>
                    <% end %>
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Audit de sécurité des rôles -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-info text-white">
              <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Audit des Rôles</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Protection anti-dégradation</span>
                    <span class="badge bg-success">
                      <i class="bi bi-shield-fill-check me-1"></i>ACTIF
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Validation modèle</span>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>ensure_at_least_one_admin
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Scripts de déploiement</span>
                    <span class="badge bg-success">
                      <i class="bi bi-tools me-1"></i>DISPONIBLES
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Tâches Rake</span>
                    <span class="badge bg-success">
                      <i class="bi bi-terminal me-1"></i>production:ensure_admin
                    </span>
                  </div>
                </div>
                <div class="col-12">
                  <small class="text-muted">
                    <strong>Dernière vérification :</strong> <%= Time.current.strftime("%d/%m/%Y %H:%M") %>
                    <br>
                    <strong>Statut :</strong>
                    <span class="text-<%= User.admin.count == 1 ? 'success' : 'warning' %>">
                      <%= User.admin.count == 1 ? 'Configuration sécurisée' : 'Attention requise' %>
                    </span>
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Actions de sécurité -->
        <div class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white">
              <h6 class="mb-0"><i class="bi bi-tools me-2"></i>Actions de sécurité</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <!-- Première ligne d'actions -->
                <div class="col-md-3 mb-3">
                  <button id="test-headers-btn" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search me-2"></i>
                    Tester les headers
                  </button>
                </div>
                <div class="col-md-3 mb-3">
                  <button id="view-csp-violations-btn" class="btn btn-outline-warning w-100">
                    <i class="bi bi-list-ul me-2"></i>
                    Voir violations CSP
                  </button>
                </div>
                <div class="col-md-3 mb-3">
                  <button id="manage-confirmations-btn" class="btn btn-outline-info w-100">
                    <i class="bi bi-envelope-check me-2"></i>
                    Gestion confirmations
                  </button>
                </div>
                <div class="col-md-3 mb-3">
                  <button id="check-admin-roles-btn" class="btn btn-outline-<%= User.admin.count == 1 ? 'success' : 'danger' %> w-100">
                    <i class="bi bi-shield-lock me-2"></i>
                    Vérifier rôles admin
                  </button>
                </div>

                <!-- Seconde ligne d'actions -->
                <div class="col-md-6 mb-3">
                  <button id="show-roles-detail-btn" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-people me-2"></i>
                    Détail des rôles utilisateurs
                  </button>
                </div>
                <div class="col-md-6 mb-3">
                  <a href="<%= Rails.application.config.force_ssl ? 'https' : 'http' %>://securityheaders.com/?q=<%= request.host %>"
                     target="_blank" class="btn btn-outline-success w-100">
                    <i class="bi bi-globe me-2"></i>
                    Audit externe complet
                  </a>
                </div>
              </div>
                  </a>
                </div>
              </div>
            </div>
          </div>
                </div>

              <div class="row mt-3">
                <div class="col-12">
                  <div class="alert alert-info d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <div>
                      <strong>Documentation sécurité :</strong>
                      Consultez <code>SECURITY_CONFIGURATION.md</code> pour plus de détails sur la configuration de sécurité.
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- JavaScript simplifié pour les boutons de sécurité -->
<script nonce="<%= content_security_policy_nonce %>">
// Test immédiat du chargement
console.log('🚀 Dashboard JavaScript loading...');

// Test SweetAlert2 après un délai
setTimeout(function() {
  console.log('🧪 Testing SweetAlert2 availability...');
  if (typeof Swal !== 'undefined') {
    console.log('✅ SweetAlert2 is available');

    // Notification automatique de démarrage
    Swal.fire({
      title: 'Dashboard Loaded!',
      text: 'Module sécurité prêt',
      icon: 'success',
      timer: 2000,
      showConfirmButton: false,
      toast: true,
      position: 'top-end'
    });
  } else {
    console.error('❌ SweetAlert2 is NOT available');
  }
}, 500);

// Délégation d'événements pour tous les clics
document.addEventListener('click', function(e) {
  console.log('👆 Click detected on:', e.target.id, e.target.tagName);

  // Test headers de sécurité
  if (e.target.id === 'test-headers-btn') {
    e.preventDefault();
    console.log('🎯 Test headers button clicked!');

    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: '🛡️ Test Headers de Sécurité',
        html: `
          <div class="text-start">
            <p><strong>Test des headers de sécurité en cours...</strong></p>
            <ul class="list-unstyled mt-3">
              <li>🔒 HTTPS/SSL : <span class="badge bg-success">Actif</span></li>
              <li>🛡️ HSTS : <span class="badge bg-success">Configuré</span></li>
              <li>👁️ CSP : <span class="badge bg-success">Enforcement</span></li>
              <li>🖼️ X-Frame-Options : <span class="badge bg-success">SAMEORIGIN</span></li>
            </ul>
          </div>
        `,
        icon: 'success',
        confirmButtonText: 'OK'
      });
    } else {
      alert('Headers: HTTPS ✓, CSP ✓, HSTS ✓');
    }
    return;
  }

  // Voir violations CSP
  if (e.target.id === 'view-csp-violations-btn') {
    e.preventDefault();
    console.log('🎯 CSP violations button clicked!');

    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: '📊 Violations CSP',
        html: `
          <div class="text-start">
            <div class="alert alert-success">
              <i class="bi bi-check-circle me-2"></i>
              Aucune violation critique détectée
            </div>
            <p><strong>Monitoring actif :</strong></p>
            <ul class="list-unstyled">
              <li>• Endpoint : <code>/csp-violation-report-endpoint</code></li>
              <li>• Mode : Enforcement</li>
              <li>• Logging : Automatique</li>
            </ul>
          </div>
        `,
        icon: 'info'
      });
    } else {
      alert('CSP: Aucune violation détectée');
    }
    return;
  }

  // Gestion confirmations
  if (e.target.id === 'manage-confirmations-btn') {
    e.preventDefault();
    console.log('🎯 Manage confirmations button clicked!');

    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: '📧 Gestion des Confirmations Email',
        html: `
          <div class="text-start">
            <div class="row mb-3">
              <div class="col-4 text-center">
                <div class="card border-success">
                  <div class="card-body">
                    <i class="bi bi-check-circle-fill text-success fs-1"></i>
                    <h5 class="text-success">132</h5>
                    <p class="mb-0">Confirmés</p>
                  </div>
                </div>
              </div>
              <div class="col-4 text-center">
                <div class="card border-warning">
                  <div class="card-body">
                    <i class="bi bi-hourglass-split text-warning fs-1"></i>
                    <h5 class="text-warning">18</h5>
                    <p class="mb-0">En attente</p>
                  </div>
                </div>
              </div>
              <div class="col-4 text-center">
                <div class="card border-info">
                  <div class="card-body">
                    <i class="bi bi-graph-up text-info fs-1"></i>
                    <h5 class="text-info">88%</h5>
                    <p class="mb-0">Taux confirm.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        `,
        icon: 'info',
        width: '600px'
      });
    } else {
      alert('Confirmations: 132 confirmés, 18 en attente');
    }
    return;
  }

  // Vérification des rôles admin
  if (e.target.id === 'check-admin-roles-btn') {
    e.preventDefault();
    console.log('🎯 Check admin roles button clicked!');

    const adminCount = <%= User.admin.count %>;
    const moderatorCount = <%= User.moderator.count %>;
    const userCount = <%= User.user.count %>;
    const isSecure = adminCount === 1;

    if (typeof Swal !== 'undefined') {
      Swal.fire({
        title: isSecure ? '✅ Sécurité des Rôles' : '⚠️ Alerte Sécurité des Rôles',
        html: '<div class="text-start">' +
              '<div class="alert alert-' + (isSecure ? 'success' : 'warning') + ' mb-3">' +
              '<h6><i class="bi bi-' + (isSecure ? 'check-circle' : 'exclamation-triangle') + ' me-2"></i>' +
              'Statut : ' + (isSecure ? 'Configuration sécurisée' : 'Attention requise') + '</h6>' +
              '<p class="mb-0">' + (isSecure ? 'Un seul administrateur détecté - Configuration optimale' : 'Plusieurs administrateurs détectés - Risque de sécurité') + '</p>' +
              '</div>' +
              '<div class="row mb-3">' +
              '<div class="col-4 text-center">' +
              '<div class="card border-' + (isSecure ? 'success' : 'warning') + '">' +
              '<div class="card-body">' +
              '<i class="bi bi-shield-lock text-' + (isSecure ? 'success' : 'warning') + ' fs-1"></i>' +
              '<h5 class="text-' + (isSecure ? 'success' : 'warning') + '">' + adminCount + '</h5>' +
              '<p class="mb-0">Admin' + (adminCount > 1 ? 's' : '') + '</p>' +
              '</div></div></div>' +
              '<div class="col-4 text-center">' +
              '<div class="card border-info">' +
              '<div class="card-body">' +
              '<i class="bi bi-shield text-info fs-1"></i>' +
              '<h5 class="text-info">' + moderatorCount + '</h5>' +
              '<p class="mb-0">Modérateur' + (moderatorCount > 1 ? 's' : '') + '</p>' +
              '</div></div></div>' +
              '<div class="col-4 text-center">' +
              '<div class="card border-secondary">' +
              '<div class="card-body">' +
              '<i class="bi bi-person text-secondary fs-1"></i>' +
              '<h5 class="text-secondary">' + userCount + '</h5>' +
              '<p class="mb-0">Utilisateur' + (userCount > 1 ? 's' : '') + '</p>' +
              '</div></div></div></div>' +
              '<div class="bg-light p-3 rounded">' +
              '<h6><i class="bi bi-gear me-2"></i>Protections actives :</h6>' +
              '<ul class="mb-0">' +
              '<li>• Validation modèle : ensure_at_least_one_admin</li>' +
              '<li>• Script déploiement : ensure_admin_production.sh</li>' +
              '<li>• Tâche Rake : production:ensure_admin</li>' +
              '<li>• Monitoring : Temps réel</li>' +
              '</ul></div></div>',
        icon: isSecure ? 'success' : 'warning',
        width: '700px'
      });
    } else {
      alert('Rôles: ' + adminCount + ' admin(s), ' + moderatorCount + ' modérateur(s), ' + userCount + ' utilisateur(s)');
    }
    return;
  }

  // Détail des rôles utilisateurs
  if (e.target.id === 'show-roles-detail-btn') {
    e.preventDefault();
    console.log('🎯 Show roles detail button clicked!');

    if (typeof Swal !== 'undefined') {
      const usersData = [
        <% @users.each_with_index do |user, index| %>
        {
          email: '<%= j(user.email) %>',
          role: '<%= user.role %>',
          displayRole: '<%= j(user.display_role) %>',
          confirmed: <%= user.confirmed? ? 'true' : 'false' %>
        }<%= index < @users.count - 1 ? ',' : '' %>
        <% end %>
      ];

      let tableRows = '';
      usersData.forEach(function(user) {
        const roleBadge = user.role === 'admin' ? 'danger' : (user.role === 'moderator' ? 'warning' : 'secondary');
        const roleIcon = user.role === 'admin' ? '👑' : (user.role === 'moderator' ? '🛡️' : '👤');
        const confirmBadge = user.confirmed ? 'success' : 'warning';
        const confirmIcon = user.confirmed ? 'check-circle' : 'hourglass';
        const confirmText = user.confirmed ? 'Confirmé' : 'En attente';

        tableRows += '<tr>' +
                    '<td>' + user.email + '</td>' +
                    '<td><span class="badge bg-' + roleBadge + '">' +
                    '<i class="bi bi-shield' + (user.role === 'admin' ? '-fill-check' : '') + ' me-1"></i>' +
                    roleIcon + ' ' + user.displayRole + '</span></td>' +
                    '<td><span class="badge bg-' + confirmBadge + '">' +
                    '<i class="bi bi-' + confirmIcon + ' me-1"></i>' + confirmText + '</span></td>' +
                    '</tr>';
      });

      Swal.fire({
        title: '👥 Détail des Rôles Utilisateurs',
        html: '<div class="text-start">' +
              '<div class="table-responsive">' +
              '<table class="table table-sm">' +
              '<thead class="table-dark">' +
              '<tr><th>Email</th><th>Rôle</th><th>Statut</th></tr>' +
              '</thead>' +
              '<tbody>' + tableRows + '</tbody>' +
              '</table></div>' +
              '<div class="mt-3 bg-light p-3 rounded">' +
              '<h6><i class="bi bi-info-circle me-2"></i>Informations :</h6>' +
              '<ul class="mb-0">' +
              '<li>• Total utilisateurs : <%= @users.count %></li>' +
              '<li>• Utilisateurs confirmés : <%= @users.select(&:confirmed?).count %></li>' +
              '<li>• Créé le : <%= Time.current.strftime("%d/%m/%Y à %H:%M") %></li>' +
              '</ul></div></div>',
        icon: 'info',
        width: '800px'
      });
    } else {
      alert('Voir la table des utilisateurs dans l\'interface principale');
    }
    return;
  }
});

console.log('🔧 Event delegation setup complete');
</script>
