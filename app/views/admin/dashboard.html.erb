                </div>
                <div class="col-6">
                  <h5 class="text-primary mb-0"><%= @admin_stats[:properties][:with_projects] %></h5>
                  <small class="text-muted">Avec projets</small>
                </div>
              </div>

              <div class="mb-3">
                <div class="d-flex justify-content-between mb-1">
