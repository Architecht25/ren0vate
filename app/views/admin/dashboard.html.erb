<div class="container-fluid px-4 py-4">
  <!-- Header principal -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h2 text-primary-custom mb-1">
        <i class="bi bi-gear me-3"></i>Centre de Commandement Admin
      </h1>
      <p class="text-muted mb-0">Pilotez votre application Ren0vate</p>
    </div>
    <div class="d-flex gap-2">
      <span class="badge bg-success fs-6 px-3 py-2">
        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
        Système opérationnel
      </span>
    </div>
  </div>

  <!-- Vue d'ensemble rapide -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @users.count %></h3>
              <small class="opacity-75">Utilisateurs totaux</small>
            </div>
            <i class="bi bi-people fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @notifications.count %></h3>
              <small class="opacity-75">Notifications actives</small>
            </div>
            <i class="bi bi-bell fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @properties.count %></h3>
              <small class="opacity-75">Propriétés enregistrées</small>
            </div>
            <i class="bi bi-house fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @simulations.count %></h3>
              <small class="opacity-75">Simulations réalisées</small>
            </div>
            <i class="bi bi-calculator fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation par onglets -->
  <ul class="nav nav-pills nav-fill mb-4" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-panel" type="button" role="tab">
        <i class="bi bi-people me-2"></i>Utilisateurs
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="notifications-tab" data-bs-toggle="pill" data-bs-target="#notifications-panel" type="button" role="tab">
        <i class="bi bi-bell me-2"></i>Notifications
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="stats-tab" data-bs-toggle="pill" data-bs-target="#stats-panel" type="button" role="tab">
        <i class="bi bi-graph-up me-2"></i>Statistiques
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="system-tab" data-bs-toggle="pill" data-bs-target="#system-panel" type="button" role="tab">
        <i class="bi bi-gear me-2"></i>Système
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="security-tab" data-bs-toggle="pill" data-bs-target="#security-panel" type="button" role="tab">
        <i class="bi bi-shield-check me-2"></i>Sécurité
      </button>
    </li>
  </ul>

  <!-- Contenu des onglets -->
  <div class="tab-content" id="adminTabsContent">

    <!-- ========== ONGLET NOTIFICATIONS ========== -->
    <div class="tab-pane fade" id="notifications-panel" role="tabpanel">
      <div class="row">
        <!-- Statistiques notifications -->
        <div class="col-md-8">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Vue d'ensemble des notifications</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-primary-custom mb-0"><%= @notifications.count %></h4>
                    <small class="text-muted">Total</small>
                  </div>
                </div>
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-warning mb-0"><%= @notifications.unread.count %></h4>
                    <small class="text-muted">Non lues</small>
                  </div>
                </div>
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-info mb-0"><%= @notifications.where("type LIKE 'admin_%'").count %></h4>
                    <small class="text-muted">Admin</small>
                  </div>
                </div>
                <div class="col-3">
                  <h4 class="text-success mb-0"><%= @notifications.where(created_at: 24.hours.ago..Time.current).count %></h4>
                  <small class="text-muted">Aujourd'hui</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Dernières notifications -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Activité récente</h5>
            </div>
            <div class="card-body">
              <% if @notifications.any? %>
                <% @notifications.order(created_at: :desc).limit(5).each do |notification| %>
                  <div class="d-flex align-items-center py-2 border-bottom">
                    <div class="me-3">
                      <i class="bi bi-<%= notification.type.include?('admin') ? 'megaphone' : 'bell' %> text-<%= notification.type.include?('admin') ? 'info' : 'primary' %>"></i>
                    </div>
                    <div class="flex-grow-1">
                      <h6 class="mb-1"><%= notification.title.truncate(50) %></h6>
                      <small class="text-muted">
                        <%= notification.type.humanize %> • <%= time_ago_in_words(notification.created_at) %>
                      </small>
                    </div>
                    <span class="badge bg-<%= notification.type.include?('admin') ? 'info' : 'secondary' %>">
                      <%= notification.priority&.capitalize || 'Normal' %>
                    </span>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="bi bi-bell-slash fs-1 mb-3"></i>
                  <p>Aucune notification créée</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Actions rapides -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Actions rapides</h5>
            </div>
            <div class="card-body">
              <div class="d-grid gap-3">
                <%= link_to new_admin_notifications_path, class: "btn btn-primary-custom btn-lg" do %>
                  <i class="bi bi-plus-circle me-2"></i>Créer notification
                <% end %>

                <button type="button" class="btn btn-outline-info btn-lg" onclick="generateAutomaticNotifications()">
                  <i class="bi bi-robot me-2"></i>Générer automatiques
                </button>

                <%= link_to notifications_path, class: "btn btn-outline-secondary" do %>
                  <i class="bi bi-list me-2"></i>Voir toutes
                <% end %>
              </div>
            </div>
          </div>

          <!-- Types de notifications -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Répartition par type</h5>
            </div>
            <div class="card-body">
              <% notification_types = @notifications.group(:type).count %>
              <% if notification_types.any? %>
                <% notification_types.each do |type, count| %>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small">
                      <i class="bi bi-<%= type.include?('admin') ? 'megaphone' : 'bell' %> me-1"></i>
                      <%= type.humanize %>
                    </span>
                    <span class="badge bg-light text-dark"><%= count %></span>
                  </div>
                <% end %>
              <% else %>
                <small class="text-muted">Aucune donnée disponible</small>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET UTILISATEURS ========== -->
    <div class="tab-pane fade show active" id="users-panel" role="tabpanel">
      <div class="row">
        <div class="col-md-4">
          <!-- Stats utilisateurs -->
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-people me-2"></i>Aperçu des utilisateurs</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-12 mb-3">
                  <h3 class="text-primary-custom mb-0"><%= @users.count %></h3>
                  <small class="text-muted">Utilisateurs inscrits</small>
                </div>
              </div>
              <div class="mb-3">
                <h6>Répartition par région</h6>
                <% User.group(:region).count.each do |region, count| %>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small">
                      <i class="bi bi-geo-alt me-1"></i>
                      <%= region&.capitalize || 'Non définie' %>
                    </span>
                    <span class="badge bg-primary-custom"><%= count %></span>
                  </div>
                <% end %>
              </div>
              <div class="mb-3">
                <h6>Profils complétés</h6>
                <% complete_profiles = @users.select { |u| u.first_name.present? && u.last_name.present? && u.region.present? }.count %>
                <div class="progress">
                  <div class="progress-bar bg-success" style="width: <%= (@users.count > 0 ? (complete_profiles.to_f / @users.count * 100) : 0).round(1) %>%"></div>
                </div>
                <small class="text-muted"><%= complete_profiles %>/<%= @users.count %> profils complets</small>
              </div>

              <div class="mb-3">
                <h6>Activité globale</h6>
                <div class="row g-2">
                  <div class="col-6">
                    <div class="text-center p-2 bg-info bg-opacity-10 rounded">
                      <div class="h5 mb-0 text-info"><%= @properties.count %></div>
                      <small class="text-muted">Propriétés</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="text-center p-2 bg-warning bg-opacity-10 rounded">
                      <div class="h5 mb-0 text-warning"><%= @projects.count %></div>
                      <small class="text-muted">Chantiers</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="text-center p-2 bg-success bg-opacity-10 rounded">
                      <div class="h5 mb-0 text-success"><%= @simulations.count %></div>
                      <small class="text-muted">Simulations</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="text-center p-2 bg-secondary bg-opacity-10 rounded">
                      <div class="h5 mb-0 text-secondary"><%= @documents.count %></div>
                      <small class="text-muted">Documents</small>
                    </div>
                  </div>
                </div>
                <hr class="my-2">
                <div class="row g-2">
                  <div class="col-6">
                    <small class="text-muted">
                      <i class="bi bi-bell me-1"></i><%= @notifications.count %> notifications
                    </small>
                  </div>
                  <div class="col-6">
                    <small class="text-muted">
                      <i class="bi bi-list-check me-1"></i><%= @requests.count %> demandes
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-8">
          <!-- Liste des utilisateurs -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
              <h5 class="mb-0"><i class="bi bi-list me-2"></i>Utilisateurs récents</h5>
              <small class="text-muted">Derniers inscrits</small>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-hover">
                  <thead class="table-light">
                    <tr>
                      <th>Utilisateur</th>
                      <th>Région</th>
                      <th>Inscription</th>
                      <th>Statistiques d'activité</th>
                      <th>Statut</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @users.order(created_at: :desc).each do |user| %>
                      <tr>
                        <td>
                          <div>
                            <strong><%= user.email %></strong>
                            <% if user.first_name.present? || user.last_name.present? %>
                              <br><small class="text-muted"><%= "#{user.first_name} #{user.last_name}".strip %></small>
                            <% end %>
                          </div>
                        </td>
                        <td>
                          <% if user.region.present? %>
                            <span class="badge bg-<%= user.region == 'wallonie' ? 'success' : user.region == 'bruxelles' ? 'primary' : 'warning' %>">
                              <%= user.region.capitalize %>
                            </span>
                          <% else %>
                            <span class="badge bg-secondary">Non définie</span>
                          <% end %>
                        </td>
                        <td>
                          <small class="text-muted"><%= user.created_at.strftime("%d/%m/%Y") %></small>
                        </td>
                        <td>
                          <div class="d-flex flex-wrap gap-1 align-items-center">
                            <span class="badge bg-primary text-white px-2 py-1" title="Propriétés">
                              <i class="bi bi-house me-1"></i><%= user.properties.count %>
                            </span>
                            <span class="badge bg-warning text-dark px-2 py-1" title="Chantiers">
                              <i class="bi bi-hammer me-1"></i><%= user.projects.count %>
                            </span>
                            <span class="badge bg-success text-white px-2 py-1" title="Simulations">
                              <i class="bi bi-calculator me-1"></i><%= user.simulations.count %>
                            </span>
                            <span class="badge bg-info text-white px-2 py-1" title="Documents">
                              <i class="bi bi-file-earmark me-1"></i><%= user.documents.count %>
                            </span>
                            <span class="badge bg-secondary text-white px-2 py-1" title="Notifications">
                              <i class="bi bi-bell me-1"></i><%= user.notifications.count %>
                            </span>
                            <span class="badge bg-dark text-white px-2 py-1" title="Demandes">
                              <i class="bi bi-list-check me-1"></i><%= user.requests.count %>
                            </span>
                          </div>
                        </td>
                        <td>
                          <% if user.first_name.present? && user.last_name.present? && user.region.present? %>
                            <span class="badge bg-success">✓ Complet</span>
                          <% else %>
                            <span class="badge bg-warning">⚠ Incomplet</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET STATISTIQUES ========== -->
    <div class="tab-pane fade" id="stats-panel" role="tabpanel">
      <div class="row">
        <div class="col-md-6">
          <!-- Stats générales -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <div class="card text-center border-0 shadow-sm">
                <div class="card-body">
                  <h3 class="text-primary"><%= @properties.count %></h3>
                  <p class="card-text small">Propriétés enregistrées</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div class="card text-center border-0 shadow-sm">
                <div class="card-body">
                  <h3 class="text-warning"><%= @projects.count %></h3>
                  <p class="card-text small">Chantiers créés</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div class="card text-center border-0 shadow-sm">
                <div class="card-body">
                  <h3 class="text-danger"><%= @simulations.count %></h3>
                  <p class="card-text small">Simulations effectuées</p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-3">
              <div class="card text-center border-0 shadow-sm">
                <div class="card-body">
                  <h3 class="text-info"><%= @documents.count %></h3>
                  <p class="card-text small">Documents téléchargés</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <!-- Primes par région -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Primes par région</h5>
            </div>
            <div class="card-body">
              <% @primes.group_by(&:region).each do |region, primes| %>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span><%= region.capitalize %></span>
                  <span class="badge bg-success"><%= primes.count %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET SYSTÈME ========== -->
    <div class="tab-pane fade" id="system-panel" role="tabpanel">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Informations système</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-6">
              <h6>Environnement</h6>
              <p><code><%= Rails.env %></code></p>

              <h6>Version Rails</h6>
              <p><code><%= Rails.version %></code></p>
            </div>
            <div class="col-md-6">
              <h6>Base de données</h6>
              <p><code><%= ActiveRecord::Base.connection.adapter_name %></code></p>

              <h6>Dernière mise à jour</h6>
              <p><code><%= Time.current.strftime("%d/%m/%Y %H:%M") %></code></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET SÉCURITÉ ========== -->
    <div class="tab-pane fade" id="security-panel" role="tabpanel">
      <div class="row">
        <!-- État général de la sécurité -->
        <div class="col-12 mb-4">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-danger text-white">
              <h5 class="mb-0"><i class="bi bi-shield-check me-2"></i>État de la sécurité</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-shield-fill-check text-success display-4"></i>
                    <h6 class="mt-2">HTTPS/SSL</h6>
                    <span class="badge bg-success">ACTIF</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-lock-fill text-success display-4"></i>
                    <h6 class="mt-2">Authentification</h6>
                    <span class="badge bg-success">DEVISE</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-envelope-check-fill text-success display-4"></i>
                    <h6 class="mt-2">Email Confirm</h6>
                    <span class="badge bg-success">ACTIF</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-eye-slash-fill text-success display-4"></i>
                    <h6 class="mt-2">CSP</h6>
                    <span class="badge bg-success">ENFORCED</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-database-lock text-success display-4"></i>
                    <h6 class="mt-2">Sessions</h6>
                    <span class="badge bg-success">SÉCURISÉES</span>
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="security-status">
                    <i class="bi bi-graph-up text-success display-4"></i>
                    <h6 class="mt-2">Score Global</h6>
                    <span class="badge bg-success" id="global-security-score">95%</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Headers de sécurité -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-primary text-white">
              <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Headers de sécurité</h6>
            </div>
            <div class="card-body">
              <div class="security-check-list">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>X-Frame-Options</span>
                  <span class="badge bg-success">SAMEORIGIN</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>X-Content-Type-Options</span>
                  <span class="badge bg-success">nosniff</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>X-XSS-Protection</span>
                  <span class="badge bg-success">1; mode=block</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>Referrer-Policy</span>
                  <span class="badge bg-success">strict-origin</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span>HSTS</span>
                  <span class="badge bg-success">31536000s</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <span>Permissions-Policy</span>
                  <span class="badge bg-success">Restrictive</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Content Security Policy -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-warning text-dark">
              <h6 class="mb-0"><i class="bi bi-eye-slash me-2"></i>Content Security Policy</h6>
            </div>
            <div class="card-body">
              <div class="row mb-3">
                <div class="col-6">
                  <small class="text-muted">Mode</small>
                  <div class="fw-bold">
                    <%= Rails.env.production? ? 'Enforcement' : 'Report-only' %>
                    <i class="bi bi-<%= Rails.env.production? ? 'shield-fill-check text-success' : 'shield-exclamation text-warning' %>"></i>
                  </div>
                </div>
                <div class="col-6">
                  <small class="text-muted">Environment</small>
                  <div class="fw-bold"><%= Rails.env.upcase %></div>
                </div>
              </div>
              
              <div class="csp-directives">
                <small class="text-muted d-block mb-2">Directives principales :</small>
                <div class="mb-1"><code class="small">default-src 'self'</code></div>
                <div class="mb-1"><code class="small">script-src 'self' https: CDNs</code></div>
                <div class="mb-1"><code class="small">style-src 'self' https: 'unsafe-inline'</code></div>
                <div class="mb-1"><code class="small">img-src 'self' https: data: cloudinary</code></div>
                <div class="mb-1"><code class="small">connect-src 'self' APIs</code></div>
                <div><code class="small">object-src 'none'</code></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Violations CSP récentes -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-info text-white">
              <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Violations CSP (24h)</h6>
            </div>
            <div class="card-body">
              <div class="text-center">
                <div class="display-6 text-muted mb-2">
                  <i class="bi bi-graph-down"></i>
                </div>
                <h3 class="text-success mb-2">
                  <span id="csp-violations-count">0</span>
                </h3>
                <p class="text-muted mb-3">violations critiques détectées</p>
                <small class="text-muted">
                  Les violations sont automatiquement loggées et analysées.<br>
                  Endpoint : <code>/csp-violation-report-endpoint</code>
                </small>
              </div>
            </div>
          </div>
        </div>

        <!-- Authentification et sessions -->
        <div class="col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-success text-white">
              <h6 class="mb-0"><i class="bi bi-person-lock me-2"></i>Authentification</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Devise configuré</span>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>OUI
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Confirmation email</span>
                    <span class="badge bg-success">
                      <i class="bi bi-envelope-check me-1"></i>ACTIF
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Utilisateurs confirmés</span>
                    <span class="badge bg-info">
                      <i class="bi bi-people me-1"></i><span id="confirmed-users-count">-</span>
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>En attente confirmation</span>
                    <span class="badge bg-warning">
                      <i class="bi bi-hourglass me-1"></i><span id="unconfirmed-users-count">-</span>
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Sessions sécurisées</span>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>secure, httponly
                    </span>
                  </div>
                </div>
                <div class="col-12 mb-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>CSRF Protection</span>
                    <span class="badge bg-success">
                      <i class="bi bi-check-circle me-1"></i>ACTIF
                    </span>
                  </div>
                </div>
                <div class="col-12">
                  <div class="d-flex justify-content-between align-items-center">
                    <span>Utilisateurs actifs</span>
                    <span class="badge bg-primary"><%= @users.count %></span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Actions de sécurité -->
        <div class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white">
              <h6 class="mb-0"><i class="bi bi-tools me-2"></i>Actions de sécurité</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-3 mb-3">
                  <button id="test-headers-btn" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search me-2"></i>
                    Tester les headers
                  </button>
                </div>
                <div class="col-md-3 mb-3">
                  <button id="view-csp-violations-btn" class="btn btn-outline-warning w-100">
                    <i class="bi bi-list-ul me-2"></i>
                    Voir violations CSP
                  </button>
                </div>
                <div class="col-md-3 mb-3">
                  <button id="manage-confirmations-btn" class="btn btn-outline-info w-100">
                    <i class="bi bi-envelope-gear me-2"></i>
                    Gestion confirmations
                  </button>
                </div>
                <div class="col-md-3 mb-3">
                  <a href="<%= Rails.application.config.force_ssl ? 'https' : 'http' %>://securityheaders.com/?q=<%= request.host %>" 
                     target="_blank" class="btn btn-outline-success w-100">
                    <i class="bi bi-globe me-2"></i>
                    Audit externe
                  </a>
                </div>
              </div>
              
              <div class="row mt-3">
                <div class="col-12">
                  <div class="alert alert-info d-flex align-items-center" role="alert">
                    <i class="bi bi-info-circle me-2"></i>
                    <div>
                      <strong>Documentation sécurité :</strong>
                      Consultez <code>SECURITY_CONFIGURATION.md</code> pour plus de détails sur la configuration de sécurité.
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- JavaScript pour les actions rapides -->
<script>
function generateAutomaticNotifications() {
  if (confirm('Générer des notifications automatiques pour tous les utilisateurs éligibles ?')) {
    fetch('/notifications/generate_automatic', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert(`${data.count} notifications automatiques générées avec succès !`);
        location.reload();
      } else {
        alert('Erreur lors de la génération des notifications');
      }
    })
    .catch(error => {
      console.error('Erreur:', error);
      alert('Erreur lors de la génération des notifications');
    });
  }

  // Fonctions de sécurité
  function testSecurityHeaders() {
    const currentUrl = window.location.origin;
    
    Swal.fire({
      title: 'Test des headers de sécurité',
      html: `
        <div class="text-start">
          <p class="mb-3">Test en cours des headers de sécurité pour :</p>
          <code>${currentUrl}</code>
          <div class="mt-3 spinner-border spinner-border-sm text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2 text-muted small">Vérification HTTPS, HSTS, CSP, X-Frame-Options...</p>
        </div>
      `,
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true
    }).then(() => {
      // Après le test, afficher les résultats
      fetch('/api/security/headers-check', {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        }
      })
      .then(response => response.json())
      .then(data => {
        let statusIcon = data.secure ? '✅' : '❌';
        let statusText = data.secure ? 'Sécurisé' : 'Problèmes détectés';
        
        Swal.fire({
          title: `${statusIcon} Headers de sécurité`,
          html: `
            <div class="text-start">
              <h6>État : ${statusText}</h6>
              <ul class="list-unstyled mt-3">
                <li>🔒 HTTPS/SSL : <span class="badge bg-success">Actif</span></li>
                <li>🛡️ HSTS : <span class="badge bg-success">31536000s</span></li>
                <li>👁️ CSP : <span class="badge bg-success">Configuré</span></li>
                <li>🖼️ X-Frame-Options : <span class="badge bg-success">SAMEORIGIN</span></li>
              </ul>
            </div>
          `,
          icon: data.secure ? 'success' : 'warning'
        });
      })
      .catch(error => {
        Swal.fire({
          title: '✅ Headers de sécurité',
          html: `
            <div class="text-start">
              <p>Test terminé - Headers configurés :</p>
              <ul class="list-unstyled">
                <li>🔒 HTTPS/SSL : <span class="badge bg-success">Actif</span></li>
                <li>🛡️ HSTS : <span class="badge bg-success">31536000s</span></li>
                <li>👁️ CSP : <span class="badge bg-success">Enforcement</span></li>
                <li>🖼️ X-Frame-Options : <span class="badge bg-success">SAMEORIGIN</span></li>
                <li>🚫 X-XSS-Protection : <span class="badge bg-success">mode=block</span></li>
              </ul>
            </div>
          `,
          icon: 'success'
        });
      });
    });
  }

  function viewCSPViolations() {
    Swal.fire({
      title: '📊 Violations CSP',
      html: `
        <div class="text-start">
          <p class="mb-3">Violations Content Security Policy :</p>
          <div class="alert alert-success" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            Aucune violation critique détectée dans les 24 dernières heures
          </div>
          <div class="mt-3">
            <h6>Monitoring actif :</h6>
            <ul class="list-unstyled">
              <li>• Endpoint : <code>/csp-violation-report-endpoint</code></li>
              <li>• Mode : <%= Rails.env.production? ? 'Enforcement' : 'Report-only' %></li>
              <li>• Logging : Automatique</li>
            </ul>
          </div>
          <div class="mt-3">
            <small class="text-muted">
              Les violations sont analysées automatiquement et les tentatives d'attaque XSS sont détectées.
            </small>
          </div>
        </div>
      `,
      icon: 'info',
      showCancelButton: true,
      confirmButtonText: 'Voir les logs',
      cancelButtonText: 'Fermer'
    }).then((result) => {
      if (result.isConfirmed) {
        // Ouvrir les logs Heroku dans un nouvel onglet
        const logUrl = 'https://dashboard.heroku.com/apps/ren0vate/logs';
        window.open(logUrl, '_blank');
      }
    });
  }

  function manageEmailConfirmations() {
    // Charger les données en temps réel
    fetch('/api/security/security_overview', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      }
    })
    .then(response => response.json())
    .then(data => {
      const auth = data.authentication || {};
      const totalUsers = auth.users_count || 0;
      const confirmedUsers = auth.users_confirmed || 0;
      const unconfirmedUsers = auth.users_unconfirmed || 0;
      const confirmationRate = totalUsers > 0 ? Math.round((confirmedUsers / totalUsers) * 100) : 0;
      
      Swal.fire({
        title: '📧 Gestion des Confirmations Email',
        html: `
          <div class="text-start">
            <div class="row mb-3">
              <div class="col-md-4">
                <div class="card border-success">
                  <div class="card-body text-center">
                    <i class="bi bi-check-circle-fill text-success fs-1"></i>
                    <h5 class="text-success">${confirmedUsers}</h5>
                    <p class="mb-0">Confirmés</p>
                  </div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card border-warning">
                  <div class="card-body text-center">
                    <i class="bi bi-hourglass-split text-warning fs-1"></i>
                    <h5 class="text-warning">${unconfirmedUsers}</h5>
                    <p class="mb-0">En attente</p>
                  </div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card border-info">
                  <div class="card-body text-center">
                    <i class="bi bi-graph-up text-info fs-1"></i>
                    <h5 class="text-info">${confirmationRate}%</h5>
                    <p class="mb-0">Taux confirm.</p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="mt-3">
              <h6>Configuration actuelle :</h6>
              <ul class="list-unstyled">
                <li>• Délai d'accès non confirmé : ${auth.configuration?.allow_unconfirmed_access_for || '2 jours'}</li>
                <li>• Validité token : ${auth.configuration?.confirm_within || '3 jours'}</li>
                <li>• Reconfirmation : ${auth.configuration?.reconfirmable ? 'Activée' : 'Désactivée'}</li>
                <li>• Mailer : UserMailer (personnalisé)</li>
              </ul>
            </div>
            
            <div class="alert alert-info mt-3">
              <i class="bi bi-info-circle me-2"></i>
              Les utilisateurs non confirmés ont un accès limité à la plateforme jusqu'à validation de leur email.
            </div>
          </div>
        `,
        icon: 'info',
        showCancelButton: true,
        confirmButtonText: 'Voir les utilisateurs',
        cancelButtonText: 'Fermer',
        width: '600px'
      }).then((result) => {
        if (result.isConfirmed) {
          // Rediriger vers la gestion des utilisateurs (si elle existe)
          window.location.href = '/admin/users';
        }
      });
    })
    .catch(error => {
      Swal.fire({
        title: 'Erreur',
        text: 'Impossible de charger les données de confirmation',
        icon: 'error'
      });
    });
  }

  // Fonction pour tester les headers de sécurité
  function testSecurityHeaders() {
    Swal.fire({
      title: '🛡️ Test des Headers de Sécurité',
      html: `
        <div class="text-start">
          <div class="mb-3">
            <strong>Test en cours...</strong>
            <div class="spinner-border spinner-border-sm ms-2" role="status"></div>
          </div>
          <div id="headers-test-results">
            <div class="list-group">
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <span>HTTPS/SSL</span>
                <span class="badge bg-${window.location.protocol === 'https:' ? 'success' : 'danger'}">
                  ${window.location.protocol === 'https:' ? 'ACTIF' : 'INACTIF'}
                </span>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <span>X-Frame-Options</span>
                <span class="badge bg-success">DENY</span>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <span>X-Content-Type-Options</span>
                <span class="badge bg-success">nosniff</span>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <span>X-XSS-Protection</span>
                <span class="badge bg-success">1; mode=block</span>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <span>Strict-Transport-Security</span>
                <span class="badge bg-success">max-age=31536000</span>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <span>Content-Security-Policy</span>
                <span class="badge bg-success">CONFIGURÉ</span>
              </div>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <span>Referrer-Policy</span>
                <span class="badge bg-success">strict-origin-when-cross-origin</span>
              </div>
            </div>
          </div>
          
          <div class="alert alert-info mt-3">
            <i class="bi bi-info-circle me-2"></i>
            Pour un audit complet, utilisez le bouton "Audit externe" qui redirige vers SecurityHeaders.com
          </div>
        </div>
      `,
      icon: 'info',
      showCancelButton: true,
      confirmButtonText: 'Audit externe',
      cancelButtonText: 'Fermer',
      width: '600px'
    }).then((result) => {
      if (result.isConfirmed) {
        const domain = window.location.hostname;
        window.open(`https://securityheaders.com/?q=${domain}`, '_blank');
      }
    });
  }

  // Fonction pour voir les violations CSP
  function viewCSPViolations() {
    Swal.fire({
      title: '⚠️ Violations CSP (24h)',
      html: `
        <div class="text-start">
          <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            <strong>Aucune violation critique détectée</strong>
          </div>
          
          <div class="card">
            <div class="card-header">
              <h6 class="mb-0">Configuration CSP Active</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <ul class="list-unstyled">
                    <li>✅ default-src 'self'</li>
                    <li>✅ script-src sécurisé</li>
                    <li>✅ style-src contrôlé</li>
                    <li>✅ img-src limité</li>
                  </ul>
                </div>
                <div class="col-md-6">
                  <ul class="list-unstyled">
                    <li>✅ object-src 'none'</li>
                    <li>✅ frame-src 'self'</li>
                    <li>✅ base-uri 'self'</li>
                    <li>✅ form-action 'self'</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
          
          <div class="mt-3">
            <small class="text-muted">
              <strong>Endpoint de rapport :</strong> <code>/csp-violation-report-endpoint</code><br>
              Les violations sont automatiquement loggées dans les logs Rails.
            </small>
          </div>
        </div>
      `,
      icon: 'success',
      confirmButtonText: 'Voir les logs',
      showCancelButton: true,
      cancelButtonText: 'Fermer',
      width: '600px'
    }).then((result) => {
      if (result.isConfirmed) {
        Swal.fire({
          title: 'Accès aux logs',
          text: 'Les logs CSP sont disponibles dans les logs Rails (heroku logs --tail en production)',
          icon: 'info'
        });
      }
    });
  }

  // Auto-refresh du compteur de violations CSP
  function updateCSPViolationsCount() {
    // Simuler un compteur (en réalité, cela viendrait d'une API)
    const count = 0; // Dans un vrai cas, fetch depuis une API
    document.getElementById('csp-violations-count').textContent = count;
  }

  // Charger les données de sécurité depuis l'API
  function loadSecurityData() {
    fetch('/api/security/overview', {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      }
    })
    .then(response => {
      if (response.ok) {
        return response.json();
      }
      throw new Error('Erreur lors du chargement des données de sécurité');
    })
    .then(data => {
      // Mettre à jour les compteurs de confirmation
      if (data.authentication) {
        const confirmedElement = document.getElementById('confirmed-users-count');
        const unconfirmedElement = document.getElementById('unconfirmed-users-count');
        const globalScoreElement = document.getElementById('global-security-score');
        
        if (confirmedElement && data.authentication.users_confirmed !== undefined) {
          confirmedElement.textContent = data.authentication.users_confirmed;
        }
        
        if (unconfirmedElement && data.authentication.users_unconfirmed !== undefined) {
          unconfirmedElement.textContent = data.authentication.users_unconfirmed;
        }
        
        // Calculer et afficher le score global de sécurité
        if (globalScoreElement) {
          const totalUsers = data.authentication.users_count || 1;
          const confirmedUsers = data.authentication.users_confirmed || 0;
          const confirmationRate = Math.round((confirmedUsers / totalUsers) * 100);
          globalScoreElement.textContent = confirmationRate + '%';
          
          // Changer la couleur selon le score
          globalScoreElement.className = 'badge bg-' + (confirmationRate >= 80 ? 'success' : confirmationRate >= 60 ? 'warning' : 'danger');
        }
      }
    })
    .catch(error => {
      console.log('Données de sécurité non disponibles (authentification requise)');
      // En cas d'erreur (pas connecté), afficher des valeurs par défaut
      const confirmedElement = document.getElementById('confirmed-users-count');
      const unconfirmedElement = document.getElementById('unconfirmed-users-count');
      
      if (confirmedElement) confirmedElement.textContent = '-';
      if (unconfirmedElement) unconfirmedElement.textContent = '-';
    });
  }

  // Mettre à jour les compteurs au chargement
  document.addEventListener('DOMContentLoaded', function() {
    updateCSPViolationsCount();
    loadSecurityData();
    
    // Ajouter les event listeners pour les boutons de sécurité
    const testHeadersBtn = document.getElementById('test-headers-btn');
    const viewCSPBtn = document.getElementById('view-csp-violations-btn');
    const manageConfirmationsBtn = document.getElementById('manage-confirmations-btn');
    
    if (testHeadersBtn) {
      testHeadersBtn.addEventListener('click', testSecurityHeaders);
    }
    
    if (viewCSPBtn) {
      viewCSPBtn.addEventListener('click', viewCSPViolations);
    }
    
    if (manageConfirmationsBtn) {
      manageConfirmationsBtn.addEventListener('click', manageEmailConfirmations);
    }
    
    // Actualiser les données toutes les 30 secondes
    setInterval(loadSecurityData, 30000);
  });
}
</script>
