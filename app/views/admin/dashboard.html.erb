              <h6 class="text-muted mb-2">Top villes utilisateurs:</h6>
              <% @admin_stats[:geographic][:top_cities].first(3).each do |city, count| %>
                <div class="d-flex justify-content-between mb-1">
                  <small><%= city %></small>
                  <small class="text-muted"><%= count %> users</small>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Activité récente et tendances -->
      <div class="row">
        <div class="col-lg-6 mb-4">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h6 class="mb-0"><i class="bi bi-activity me-2"></i>Activité des 7 derniers jours</h6>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-4 text-center">
                  <canvas id="userActivityChart" width="80" height="80"></canvas>
                  <p class="small text-muted mt-2">Nouveaux utilisateurs</p>
                </div>
                <div class="col-4 text-center">
                  <canvas id="propertyActivityChart" width="80" height="80"></canvas>
                  <p class="small text-muted mt-2">Nouvelles propriétés</p>
                </div>
                <div class="col-4 text-center">
                  <canvas id="simulationActivityChart" width="80" height="80"></canvas>
                  <p class="small text-muted mt-2">Simulations</p>
                </div>
              </div>

              <hr class="my-3">

              <div class="row text-center">
                <div class="col-12">
                  <small class="text-muted">
                    <i class="bi bi-clock me-1"></i>
                    Pic d'activité: <%= @admin_stats[:activity][:peak_hours] %>
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Métriques business -->
        <div class="col-lg-6 mb-4">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h6 class="mb-0"><i class="bi bi-graph-up me-2"></i>Métriques Business</h6>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-6">
                  <div class="text-center p-3 bg-light rounded">
                    <h5 class="text-primary mb-1"><%= @admin_stats[:simulations][:avg_per_user] %></h5>
                    <small class="text-muted">Simulations / utilisateur</small>
                  </div>
                </div>
                <div class="col-6">
                  <div class="text-center p-3 bg-light rounded">
                    <h5 class="text-success mb-1"><%= @admin_stats[:documents][:avg_per_user] %></h5>
                    <small class="text-muted">Documents / utilisateur</small>
                  </div>
                </div>
                <div class="col-6">
                  <div class="text-center p-3 bg-light rounded">
                    <h5 class="text-warning mb-1"><%= @admin_stats[:simulations][:success_rate] %>%</h5>
                    <small class="text-muted">Taux de succès simulations</small>
                  </div>
                </div>
                <div class="col-6">
                  <div class="text-center p-3 bg-light rounded">
                    <h5 class="text-info mb-1"><%= @admin_stats[:activity][:weekly_growth] %></h5>
                    <small class="text-muted">Croissance hebdo</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions rapides -->
      <div class="row">
        <div class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h6 class="mb-0"><i class="bi bi-lightning me-2"></i>Actions rapides</h6>
            </div>
            <div class="card-body">
              <div class="row g-2">
                <div class="col-md-3">
                  <button class="btn btn-outline-primary w-100" onclick="exportStats()">
                    <i class="bi bi-download me-2"></i>Exporter stats
                  </button>
                </div>
                <div class="col-md-3">
                  <button class="btn btn-outline-success w-100" onclick="refreshStats()">
                    <i class="bi bi-arrow-clockwise me-2"></i>Actualiser
                  </button>
                </div>
                <div class="col-md-3">
                  <button class="btn btn-outline-warning w-100" onclick="geocodeAll()">
                    <i class="bi bi-geo-alt me-2"></i>Géocoder tout
                  </button>
                </div>
                <div class="col-md-3">
                  <button class="btn btn-outline-info w-100" onclick="generateReport()">
                    <i class="bi bi-file-text me-2"></i>Rapport détaillé
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET PRIMES ========== -->
    <div class="tab-pane fade" id="primes-panel" role="tabpanel">
      <div class="row g-4">
        <!-- Gestion des Primes Particuliers -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-primary bg-opacity-10">
              <h5 class="mb-0 text-primary">
                <i class="bi bi-house-heart me-2"></i>Primes Particuliers
              </h5>
            </div>
            <div class="card-body">
              <div class="row g-3 mb-4">
                <div class="col-4 text-center">
                  <div class="badge bg-primary bg-opacity-10 text-primary fs-4 rounded-circle p-3 mb-2">
                    <%= Prime.where(region: 'flandre').count %>
                  </div>
                  <small class="text-muted d-block">Flandre</small>
                </div>
                <div class="col-4 text-center">
                  <div class="badge bg-success bg-opacity-10 text-success fs-4 rounded-circle p-3 mb-2">
                    <%= Prime.where(region: 'wallonie').count %>
                  </div>
                  <small class="text-muted d-block">Wallonie</small>
                </div>
                <div class="col-4 text-center">
                  <div class="badge bg-warning bg-opacity-10 text-warning fs-4 rounded-circle p-3 mb-2">
                    <%= Prime.where(region: 'bruxelles').count %>
                  </div>
                  <small class="text-muted d-block">Bruxelles</small>
                </div>
              </div>

              <div class="d-grid gap-2">
                <%= link_to primes_path, class: "btn btn-primary" do %>
                  <i class="bi bi-eye me-2"></i>Consulter toutes les primes
                <% end %>
                <%= link_to new_prime_path, class: "btn btn-outline-primary" do %>
                  <i class="bi bi-plus-circle me-2"></i>Ajouter une prime
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Gestion des Aides Entreprises -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-info bg-opacity-10">
              <h5 class="mb-0 text-info">
                <i class="bi bi-building me-2"></i>Aides Entreprises
              </h5>
            </div>
            <div class="card-body">
              <div class="row g-3 mb-4">
                <div class="col-12 text-center">
                  <div class="badge bg-info bg-opacity-10 text-info fs-3 rounded-circle p-4 mb-2">
                    <%= EntrepriseAide.where(region: 'bruxelles').count %>
                  </div>
                  <small class="text-muted d-block">Aides Bruxelles</small>
                </div>
              </div>

              <div class="d-grid gap-2">
                <%= link_to primes_path + '#entreprises', class: "btn btn-info" do %>
                  <i class="bi bi-eye me-2"></i>Consulter les aides entreprises
                <% end %>
                <button class="btn btn-outline-info" disabled>
                  <i class="bi bi-plus-circle me-2"></i>Ajouter une aide
                  <small class="text-muted">(via seeds)</small>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Statistiques détaillées -->
        <div class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0">
                <i class="bi bi-graph-up me-2"></i>Statistiques détaillées
              </h5>
            </div>
            <div class="card-body">
              <div class="row g-4">
                <div class="col-md-3">
                  <div class="text-center">
                    <h4 class="text-primary mb-1"><%= Prime.count %></h4>
                    <small class="text-muted">Total primes particuliers</small>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="text-center">
                    <h4 class="text-info mb-1"><%= EntrepriseAide.count %></h4>
                    <small class="text-muted">Total aides entreprises</small>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="text-center">
                    <h4 class="text-success mb-1"><%= Prime.count + EntrepriseAide.count %></h4>
                    <small class="text-muted">Total général</small>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="text-center">
                    <h4 class="text-warning mb-1"><%= Category.count %></h4>
                    <small class="text-muted">Catégories</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET SYSTÈME ========== -->
    <div class="tab-pane fade" id="system-panel" role="tabpanel">

      <!-- Vue d'ensemble du système -->
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="card-body text-white">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="mb-0"><%= @system_info[:environment][:rails_env].upcase %></h5>
                  <small class="opacity-75">Environnement</small>
                </div>
                <i class="bi bi-server fs-1 opacity-50"></i>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="card-body text-white">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="mb-0"><%= @system_info[:performance][:active_connections] %></h5>
                  <small class="opacity-75">Connexions DB actives</small>
                </div>
                <i class="bi bi-database fs-1 opacity-50"></i>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <div class="card-body text-white">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="mb-0"><%= @system_info[:security][:active_sessions] %></h5>
                  <small class="opacity-75">Sessions actives</small>
                </div>
                <i class="bi bi-people fs-1 opacity-50"></i>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
            <div class="card-body text-white">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <h5 class="mb-0"><%= @system_info[:services][:database][:response_time] %></h5>
                  <small class="opacity-75">Latence DB</small>
                </div>
                <i class="bi bi-speedometer2 fs-1 opacity-50"></i>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <!-- Informations d'environnement -->
        <div class="col-lg-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Environnement & Infrastructure</h5>
            </div>
            <div class="card-body">
              <div class="row">
                <div class="col-md-6">
                  <h6><i class="bi bi-server me-2"></i>Plateforme</h6>
                  <ul class="list-unstyled mb-3">
                    <li><strong>Rails:</strong> <code><%= @system_info[:environment][:rails_version] %></code></li>
                    <li><strong>Ruby:</strong> <code><%= @system_info[:environment][:ruby_version] %></code></li>
                    <li><strong>Environnement:</strong> <span class="badge bg-primary"><%= @system_info[:environment][:rails_env] %></span></li>
                    <li><strong>Timezone:</strong> <code><%= @system_info[:environment][:timezone] %></code></li>
                  </ul>

                  <h6><i class="bi bi-database me-2"></i>Base de données</h6>
                  <ul class="list-unstyled mb-3">
                    <li><strong>Type:</strong> <code><%= @system_info[:infrastructure][:database_adapter] %></code></li>
                    <li><strong>Version:</strong> <code class="small"><%= truncate(@system_info[:infrastructure][:database_version], length: 50) %></code></li>
                    <li><strong>Pool:</strong> <%= @system_info[:performance][:database_pool][:checked_out] %>/<%= @system_info[:performance][:database_pool][:size] %> utilisées</li>
                  </ul>
                </div>
                <div class="col-md-6">
                  <h6><i class="bi bi-gem me-2"></i>Gems critiques</h6>
                  <ul class="list-unstyled mb-3">
                    <% @system_info[:infrastructure][:critical_gems].each do |gem_name, version| %>
                      <li><strong><%= gem_name %>:</strong> <code><%= version %></code></li>
                    <% end %>
                  </ul>

                  <% if @system_info[:infrastructure][:heroku_info][:dyno_name] %>
                    <h6><i class="bi bi-cloud me-2"></i>Heroku</h6>
                    <ul class="list-unstyled mb-3">
                      <li><strong>Dyno:</strong> <code><%= @system_info[:infrastructure][:heroku_info][:dyno_name] %></code></li>
                      <li><strong>App:</strong> <code><%= @system_info[:infrastructure][:heroku_info][:heroku_app] %></code></li>
                      <li><strong>Release:</strong> <code><%= @system_info[:infrastructure][:heroku_info][:release_version] %></code></li>
                    </ul>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- État des services -->
        <div class="col-lg-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-activity me-2"></i>État des Services</h5>
            </div>
            <div class="card-body">
              <!-- Base de données -->
              <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                <div>
                  <h6 class="mb-1"><i class="bi bi-database me-2"></i>Base de données</h6>
                  <small class="text-muted">Connexions: <%= @system_info[:services][:database][:connection_count] %></small>
                </div>
                <div class="text-end">
                  <span class="badge bg-success"><%= @system_info[:services][:database][:status] %></span>
                  <br><small class="text-muted"><%= @system_info[:services][:database][:response_time] %></small>
                </div>
              </div>

              <!-- Email -->
              <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                <div>
                  <h6 class="mb-1"><i class="bi bi-envelope me-2"></i>Service Email</h6>
                  <small class="text-muted"><%= @system_info[:services][:email][:delivery_method] %></small>
                </div>
                <div class="text-end">
                  <span class="badge bg-<%= @system_info[:services][:email][:status].include?('✅') ? 'success' : 'warning' %>">
                    <%= @system_info[:services][:email][:status] %>
                  </span>
                </div>
              </div>

              <!-- Stockage -->
              <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                <div>
                  <h6 class="mb-1"><i class="bi bi-cloud-upload me-2"></i>Stockage</h6>
                  <small class="text-muted"><%= @system_info[:services][:storage][:service] %></small>
                </div>
                <div class="text-end">
                  <span class="badge bg-<%= @system_info[:services][:storage][:status].include?('✅') ? 'success' : 'secondary' %>">
                    <%= @system_info[:services][:storage][:status] %>
                  </span>
                </div>
              </div>

              <!-- APIs externes -->
              <% @system_info[:services][:external_apis].each do |api_name, api_info| %>
                <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                  <div>
                    <h6 class="mb-1"><i class="bi bi-globe me-2"></i><%= api_name.to_s.humanize %></h6>
                    <small class="text-muted"><%= api_info[:service] if api_info[:service] %></small>
                  </div>
                  <div class="text-end">
                    <span class="badge bg-<%= api_info[:status].include?('✅') ? 'success' : 'danger' %>">
                      <%= api_info[:status] %>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Performance et Sécurité -->
        <div class="col-lg-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-speedometer2 me-2"></i>Performance & Sécurité</h5>
            </div>
            <div class="card-body">
              <h6><i class="bi bi-cpu me-2"></i>Mémoire & Performance</h6>
              <div class="mb-3">
                <% if @system_info[:performance][:memory_usage][:heap_live_slots] %>
                  <small class="text-muted d-block">Objets Ruby alloués: <%= number_with_delimiter(@system_info[:performance][:memory_usage][:total_allocated_objects]) %></small>
                  <small class="text-muted d-block">Slots mémoire actifs: <%= number_with_delimiter(@system_info[:performance][:memory_usage][:heap_live_slots]) %></small>
                <% else %>
                  <small class="text-muted"><%= @system_info[:performance][:memory_usage][:status] %></small>
                <% end %>
              </div>

              <h6><i class="bi bi-shield-check me-2"></i>Sécurité</h6>
              <div class="mb-3">
                <div class="d-flex justify-content-between">
                  <span>SSL/HTTPS:</span>
                  <span class="badge bg-<%= @system_info[:security][:ssl_info][:status].include?('✅') ? 'success' : 'warning' %>">
                    <%= @system_info[:security][:ssl_info][:status] %>
                  </span>
                </div>
                <div class="d-flex justify-content-between mt-2">
                  <span>CSP:</span>
                  <span class="badge bg-<%= @system_info[:security][:csp_status][:status].include?('✅') ? 'success' : 'warning' %>">
                    <%= @system_info[:security][:csp_status][:csp] %>
                  </span>
                </div>
                <div class="d-flex justify-content-between mt-2">
                  <span>Échecs de connexion (1h):</span>
                  <% failed_logins = @system_info[:security][:recent_failed_logins].is_a?(Numeric) ? @system_info[:security][:recent_failed_logins] : 0 %>
                  <span class="badge bg-<%= failed_logins > 5 ? 'danger' : 'success' %>">
                    <%= failed_logins %>
                  </span>
                </div>
              </div>

              <h6><i class="bi bi-clock me-2"></i>Temps & Uptime</h6>
              <div class="mb-3">
                <small class="text-muted d-block">Heure système: <%= @system_info[:environment][:current_time].strftime("%Y-%m-%d %H:%M:%S %Z") %></small>
                <small class="text-muted d-block">Uptime: <%= @system_info[:environment][:uptime] %></small>
              </div>
            </div>
          </div>
        </div>

        <!-- Maintenance et Logs -->
        <div class="col-lg-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-tools me-2"></i>Maintenance & Monitoring</h5>
            </div>
            <div class="card-body">
              <h6><i class="bi bi-database-gear me-2"></i>Base de données</h6>
              <div class="mb-3">
                <% if @system_info[:maintenance][:last_migration][:version] %>
                  <small class="text-muted d-block">Dernière migration: <code><%= @system_info[:maintenance][:last_migration][:version] %></code></small>
                  <small class="text-muted d-block">Date: <%= @system_info[:maintenance][:last_migration][:formatted] %></small>
                <% else %>
                  <small class="text-muted"><%= @system_info[:maintenance][:last_migration][:status] || @system_info[:maintenance][:last_migration][:error] %></small>
                <% end %>
              </div>

              <h6><i class="bi bi-cloud-arrow-up me-2"></i>Déploiement</h6>
              <div class="mb-3">
                <small class="text-muted d-block">Déployé le: <%= @system_info[:maintenance][:deployment_info][:deployed_at] %></small>
                <% if @system_info[:maintenance][:deployment_info][:git_commit] != "Non disponible" %>
                  <small class="text-muted d-block">Commit: <code><%= @system_info[:maintenance][:deployment_info][:git_commit][0..7] %></code></small>
                <% end %>
