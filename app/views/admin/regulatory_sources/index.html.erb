<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="fw-bold mb-0"><i class="bi bi-shield-check me-2 text-primary"></i>Veille réglementaire</h4>
      <p class="text-muted small mb-0">
        Pages officielles surveillées mensuellement (RegulatoryWatchJob) — un email n'est envoyé
        que si une page a réellement changé.
      </p>
    </div>
    <%= button_to "Vérifier maintenant", check_now_admin_regulatory_sources_path, method: :post, class: "btn btn-primary btn-sm" %>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Source</th>
            <th>Région</th>
            <th>Dernière vérification</th>
            <th>Dernier changement</th>
            <th>Code concerné</th>
          </tr>
        </thead>
        <tbody>
          <% @sources.each do |source| %>
            <tr>
              <td>
                <div class="fw-semibold"><%= source.label %></div>
                <a href="<%= source.url %>" target="_blank" rel="noopener" class="small text-muted text-break">
                  <%= source.url %>
                </a>
              </td>
              <td><span class="badge bg-light text-dark"><%= source.region_label %></span></td>
              <td class="small">
                <% if source.last_checked_at %>
                  <%= l(source.last_checked_at, format: :short) %>
                <% else %>
                  <span class="text-muted">Jamais</span>
                <% end %>
              </td>
              <td class="small">
                <% if source.last_changed_at %>
                  <span class="text-warning fw-semibold"><%= l(source.last_changed_at, format: :short) %></span>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="small text-muted"><%= source.notes %></td>
            </tr>
          <% end %>
          <% if @sources.empty? %>
            <tr>
              <td colspan="5" class="text-center text-muted py-4">
                Aucune source configurée — voir db/seeds/regulatory_sources.rb
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
