<div class="container-fluid px-4 py-4">
  <!-- Header principal -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h2 text-primary-custom mb-1">
        <i class="bi bi-gear me-3"></i>Centre de Commandement Admin
      </h1>
      <p class="text-muted mb-0">Pilotez votre application Ren0vate</p>
    </div>
    <div class="d-flex gap-2">
      <span class="badge bg-success fs-6 px-3 py-2">
        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
        Système opérationnel
      </span>
    </div>
  </div>

  <!-- Vue d'ensemble rapide -->
  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @users.count %></h3>
              <small class="opacity-75">Utilisateurs totaux</small>
            </div>
            <i class="bi bi-people fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @notifications.count %></h3>
              <small class="opacity-75">Notifications actives</small>
            </div>
            <i class="bi bi-bell fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @properties.count %></h3>
              <small class="opacity-75">Propriétés enregistrées</small>
            </div>
            <i class="bi bi-house fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-gradient" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
        <div class="card-body text-white">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0"><%= @simulations.count %></h3>
              <small class="opacity-75">Simulations réalisées</small>
            </div>
            <i class="bi bi-calculator fs-1 opacity-50"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation par onglets -->
  <ul class="nav nav-pills nav-fill mb-4" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="notifications-tab" data-bs-toggle="pill" data-bs-target="#notifications-panel" type="button" role="tab">
        <i class="bi bi-bell me-2"></i>Notifications
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-panel" type="button" role="tab">
        <i class="bi bi-people me-2"></i>Utilisateurs
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="stats-tab" data-bs-toggle="pill" data-bs-target="#stats-panel" type="button" role="tab">
        <i class="bi bi-graph-up me-2"></i>Statistiques
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="system-tab" data-bs-toggle="pill" data-bs-target="#system-panel" type="button" role="tab">
        <i class="bi bi-gear me-2"></i>Système
      </button>
    </li>
  </ul>

  <!-- Contenu des onglets -->
  <div class="tab-content" id="adminTabsContent">
    
    <!-- ========== ONGLET NOTIFICATIONS ========== -->
    <div class="tab-pane fade show active" id="notifications-panel" role="tabpanel">
      <div class="row">
        <!-- Statistiques notifications -->
        <div class="col-md-8">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Vue d'ensemble des notifications</h5>
            </div>
            <div class="card-body">
              <div class="row text-center">
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-primary-custom mb-0"><%= @notifications.count %></h4>
                    <small class="text-muted">Total</small>
                  </div>
                </div>
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-warning mb-0"><%= @notifications.unread.count %></h4>
                    <small class="text-muted">Non lues</small>
                  </div>
                </div>
                <div class="col-3">
                  <div class="border-end">
                    <h4 class="text-info mb-0"><%= @notifications.where("type LIKE 'admin_%'").count %></h4>
                    <small class="text-muted">Admin</small>
                  </div>
                </div>
                <div class="col-3">
                  <h4 class="text-success mb-0"><%= @notifications.where(created_at: 24.hours.ago..Time.current).count %></h4>
                  <small class="text-muted">Aujourd'hui</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Dernières notifications -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Activité récente</h5>
            </div>
            <div class="card-body">
              <% if @notifications.any? %>
                <% @notifications.order(created_at: :desc).limit(5).each do |notification| %>
                  <div class="d-flex align-items-center py-2 border-bottom">
                    <div class="me-3">
                      <i class="bi bi-<%= notification.type.include?('admin') ? 'megaphone' : 'bell' %> text-<%= notification.type.include?('admin') ? 'info' : 'primary' %>"></i>
                    </div>
                    <div class="flex-grow-1">
                      <h6 class="mb-1"><%= notification.title.truncate(50) %></h6>
                      <small class="text-muted">
                        <%= notification.type.humanize %> • <%= time_ago_in_words(notification.created_at) %>
                      </small>
                    </div>
                    <span class="badge bg-<%= notification.type.include?('admin') ? 'info' : 'secondary' %>">
                      <%= notification.priority&.capitalize || 'Normal' %>
                    </span>
                  </div>
                <% end %>
              <% else %>
                <div class="text-center text-muted py-4">
                  <i class="bi bi-bell-slash fs-1 mb-3"></i>
                  <p>Aucune notification créée</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Actions rapides -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Actions rapides</h5>
            </div>
            <div class="card-body">
              <div class="d-grid gap-3">
                <%= link_to new_admin_notifications_path, class: "btn btn-primary-custom btn-lg" do %>
                  <i class="bi bi-plus-circle me-2"></i>Créer notification
                <% end %>
                
                <button type="button" class="btn btn-outline-info btn-lg" onclick="generateAutomaticNotifications()">
                  <i class="bi bi-robot me-2"></i>Générer automatiques
                </button>
                
                <%= link_to notifications_path, class: "btn btn-outline-secondary" do %>
                  <i class="bi bi-list me-2"></i>Voir toutes
                <% end %>
              </div>
            </div>
          </div>

          <!-- Types de notifications -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Répartition par type</h5>
            </div>
            <div class="card-body">
              <% notification_types = @notifications.group(:type).count %>
              <% if notification_types.any? %>
                <% notification_types.each do |type, count| %>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small">
                      <i class="bi bi-<%= type.include?('admin') ? 'megaphone' : 'bell' %> me-1"></i>
                      <%= type.humanize %>
                    </span>
                    <span class="badge bg-light text-dark"><%= count %></span>
                  </div>
                <% end %>
              <% else %>
                <small class="text-muted">Aucune donnée disponible</small>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== ONGLET UTILISATEURS ========== -->
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== SECTION UTILISATEURS ========== -->

<h2>Utilisateurs inscrits (<%= @users.count %>)</h2>
<div class="table-responsive">
  <table class="table table-striped">
    <thead>
      <tr>
        <th>ID</th>
        <th>Email</th>
        <th>Nom</th>
        <th>Prénom</th>
        <th>Région</th>
        <th>Téléphone</th>
        <th>Ville</th>
        <th>Date d'inscription</th>
        <th>Profil complet</th>
        <th>Propriétés</th>
        <th>Chantiers</th>
        <th>Simulations</th>
        <th>Documents</th>
        <th>Demandes</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.email %></td>
          <td><%= user.last_name %></td>
          <td><%= user.first_name %></td>
          <td>
            <% if user.region.present? %>
              <span class="badge bg-<%= user.region == 'wallonie' ? 'success' : user.region == 'bruxelles' ? 'primary' : 'warning' %>">
                <%= user.region.capitalize %>
              </span>
            <% else %>
              <span class="badge bg-secondary">Non définie</span>
            <% end %>
          </td>
          <td><%= user.phone %></td>
          <td><%= user.city %></td>
          <td><%= user.created_at.strftime("%d/%m/%Y") %></td>
          <td>
            <% if user.first_name.present? && user.last_name.present? && user.region.present? %>
              <span class="badge bg-success">✓ Complet</span>
            <% else %>
              <span class="badge bg-warning">⚠ Incomplet</span>
            <% end %>
          </td>
          <td>
            <% if user.properties.any? %>
              <span class="badge bg-info"><%= user.properties.count %></span>
            <% else %>
              <span class="badge bg-secondary">0</span>
            <% end %>
          </td>
          <td>
            <% if user.projects.any? %>
              <span class="badge bg-info"><%= user.projects.count %></span>
            <% else %>
              <span class="badge bg-secondary">Aucune</span>
            <% end %>
          </td>
          <td>
            <% if user.simulations.any? %>
              <span class="badge bg-info"><%= user.simulations.count %></span>
            <% else %>
              <span class="badge bg-secondary">Aucune</span>
            <% end %>
          </td>
          <td>
            <% if user.documents.any? %>
              <span class="badge bg-info"><%= user.documents.count %></span>
            <% else %>
              <span class="badge bg-secondary">Aucune</span>
            <% end %>
          </td>
          <td>
            <% if user.requests.any? %>
              <span class="badge bg-info"><%= user.requests.count %> demande(s)</span>
            <% else %>
              <span class="badge bg-secondary">Aucune</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<!-- Statistiques -->
<h2>Statistiques</h2>
<div class="col-md-2">
    <h3>Primes par région</h3>
    <ul class="list-group">
      <% @primes.group_by(&:region).each do |region, primes| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= region.capitalize %>
          <span class="badge bg-success rounded-pill"><%= primes.count %></span>
        </li>
      <% end %>
    </ul>
  </div>
  <div class="row">
  <div class="col-md-2">
    <h3>Total des utilisateurs</h3>
    <div class="card text-center">
      <div class="card-body">
        <h1 class="card-title text-primary"><%= @users.count %></h1>
        <p class="card-text">Utilisateurs inscrits</p>
      </div>
    </div>
  </div>

  <div class="col-md-2">
    <h3>Total des biens</h3>
    <div class="card text-center">
      <div class="card-body">
        <h1 class="card-title text-info"><%= @properties.count %></h1>
        <p class="card-text">Propriétés enregistrées</p>
      </div>
    </div>
  </div>

  <div class="col-md-2">
    <h3>Total des chantiers</h3>
    <div class="card text-center">
      <div class="card-body">
        <h1 class="card-title text-warning"><%= @projects.count %></h1>
        <p class="card-text">Chantiers créés</p>
      </div>
    </div>
  </div>

  <div class="col-md-2">
    <h3>Total des simulations</h3>
    <div class="card text-center">
      <div class="card-body">
        <h1 class="card-title text-danger"><%= @simulations.count %></h1>
        <p class="card-text">Simulations effectuées</p>
      </div>
    </div>
  </div>

  <div class="col-md-2">
    <h3>Total des documents</h3>
    <div class="card text-center">
      <div class="card-body">
        <h1 class="card-title text-secondary"><%= @documents.count %></h1>
        <p class="card-text">Documents téléchargés</p>
      </div>
    </div>
  </div>
  
  <div class="col-md-2">
    <h3>Total des demandes</h3>
    <div class="card text-center">
      <div class="card-body">
        <h1 class="card-title text-primary"><%= @requests.count %></h1>
        <p class="card-text">Demandes en cours</p>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript pour les actions rapides -->
<script>
function generateAutomaticNotifications() {
  if (confirm('Générer des notifications automatiques pour tous les utilisateurs éligibles ?')) {
    fetch('/notifications/generate_automatic', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        alert(`${data.count} notifications automatiques générées avec succès !`);
        location.reload();
      } else {
        alert('Erreur lors de la génération des notifications');
      }
    })
    .catch(error => {
      console.error('Erreur:', error);
      alert('Erreur lors de la génération des notifications');
    });
  }
}
</script>
