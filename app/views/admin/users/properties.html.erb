<% content_for :title, "Propriétés de #{@user.email}" %>

<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 text-primary-custom mb-1">
        <i class="bi bi-house me-2"></i>Propriétés - <%= @user.email %>
      </h1>
      <p class="text-muted mb-0">
        <%= @properties.count %> propriété(s) •
        <span class="text-success"><%= @properties.where.not(latitude: nil).count %> géolocalisée(s)</span>
      </p>
    </div>
    <div>
      <%= link_to "Retour au dashboard", admin_dashboard_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if @properties.any? %>
    <div class="row">
      <% @properties.each do |property| %>
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light">
              <div class="d-flex justify-content-between align-items-start">
                <h6 class="mb-0">
                  <i class="bi bi-house me-2"></i><%= truncate(property.adresse, length: 25) %>
                </h6>
                <span class="badge bg-<%= property.latitude.present? ? 'success' : 'warning' %>">
                  <%= property.latitude.present? ? 'Géolocalisée' : 'Non géolocalisée' %>
                </span>
              </div>
            </div>
            <div class="card-body">
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <small class="text-muted">Ville</small>
                  <div class="fw-bold"><%= property.commune || "Non renseignée" %></div>
                </div>
                <div class="col-6">
                  <small class="text-muted">Code postal</small>
                  <div class="fw-bold"><%= property.code_postal || "N/A" %></div>
                </div>
                <div class="col-6">
                  <small class="text-muted">Prix d'achat</small>
                  <div class="fw-bold text-primary">
                    <%= property.valeur_achat.present? ? number_to_currency(property.valeur_achat, unit: "€", separator: ",", delimiter: " ") : "Non renseigné" %>
                  </div>
                </div>
                <div class="col-6">
                  <small class="text-muted">Année construction</small>
                  <div class="fw-bold"><%= property.annee_construction || "N/A" %></div>
                </div>
              </div>

              <!-- Informations PEB -->
              <% peb_cert = property.certificat_peb_wallonie || property.certificat_peb_flandre || property.certificat_peb_bruxelles %>
              <% if peb_cert.present? %>
                <div class="alert alert-success p-2 mb-3">
                  <small>
                    <i class="bi bi-patch-check me-1"></i>
                    <strong>PEB:</strong> <%= peb_cert %>
                    <% if property.surface_habitable.present? %>
                      • <%= property.surface_habitable %> m²
                    <% end %>
                  </small>
                </div>
              <% else %>
                <div class="alert alert-warning p-2 mb-3">
                  <small>
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>PEB non renseigné</strong>
                  </small>
                </div>
              <% end %>

              <!-- Statistiques des projets -->
              <div class="row text-center mb-3">
                <div class="col-4">
                  <div class="border-end">
                    <h5 class="text-warning mb-0"><%= property.projects.count %></h5>
                    <small class="text-muted">Projets</small>
                  </div>
                </div>
                <div class="col-4">
                  <div class="border-end">
                    <h5 class="text-info mb-0"><%= property.simulations.count %></h5>
                    <small class="text-muted">Simulations</small>
                  </div>
                </div>
                <div class="col-4">
                  <h5 class="text-dark mb-0"><%= property.documents.count %></h5>
                  <small class="text-muted">Documents</small>
                </div>
              </div>

              <!-- Actions -->
              <div class="d-grid gap-2">
                <button class="btn btn-outline-primary btn-sm" onclick="alert('Propriété ID: <%= property.id %> - Utilisateur: <%= @user.email %>')">
                  <i class="bi bi-eye me-2"></i>Voir les détails
                </button>

                <% if property.projects.any? %>
                  <%= link_to projects_admin_user_path(@user, property_filter: property.id), class: "btn btn-outline-warning btn-sm" do %>
                    <i class="bi bi-hammer me-2"></i>Voir les projets (<%= property.projects.count %>)
                  <% end %>
                <% end %>

                <% if property.documents.any? %>
                  <%= link_to documents_admin_user_path(@user, property_filter: property.id), class: "btn btn-outline-dark btn-sm" do %>
                    <i class="bi bi-file-earmark me-2"></i>Voir les documents (<%= property.documents.count %>)
                  <% end %>
                <% end %>
              </div>
            </div>
            <div class="card-footer bg-light">
              <small class="text-muted">
                <i class="bi bi-calendar me-1"></i>
                Ajoutée le <%= property.created_at.strftime("%d/%m/%Y") %>
              </small>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-5">
        <i class="bi bi-house-x text-muted" style="font-size: 4rem;"></i>
        <h4 class="text-muted mt-3">Aucune propriété trouvée</h4>
        <p class="text-muted">Cet utilisateur n'a pas encore enregistré de propriétés.</p>
      </div>
    </div>
  <% end %>

  <!-- Résumé statistiques -->
  <div class="row mt-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-primary bg-opacity-10">
        <div class="card-body text-center">
          <h4 class="text-primary mb-0"><%= @properties.count %></h4>
          <small class="text-muted">Total propriétés</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-success bg-opacity-10">
        <div class="card-body text-center">
          <h4 class="text-success mb-0"><%= @properties.where.not(latitude: nil).count %></h4>
          <small class="text-muted">Géolocalisées</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-info bg-opacity-10">
        <div class="card-body text-center">
          <h4 class="text-info mb-0"><%= @properties.where("certificat_peb_wallonie IS NOT NULL OR certificat_peb_flandre IS NOT NULL OR certificat_peb_bruxelles IS NOT NULL").count %></h4>
          <small class="text-muted">Avec certificat PEB</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
        <div class="card-body text-center">
          <h4 class="text-warning mb-0">
            <%= number_to_currency(@properties.where.not(valeur_achat: nil).average(:valeur_achat) || 0, unit: "€", precision: 0, separator: ",", delimiter: " ") %>
          </h4>
          <small class="text-muted">Prix moyen</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Carte des propriétés si géolocalisées -->
  <% if @properties.where.not(latitude: nil).any? %>
    <div class="card border-0 shadow-sm mt-4">
      <div class="card-header bg-light">
        <h6 class="mb-0">
          <i class="bi bi-geo-alt me-2"></i>Localisation des propriétés
        </h6>
      </div>
      <div class="card-body p-0">
        <div id="user-properties-map" style="height: 400px; width: 100%;">
          <div class="d-flex justify-content-center align-items-center h-100">
            <div class="text-center text-muted">
              <div class="spinner-border mb-3" role="status">
                <span class="visually-hidden">Chargement de la carte...</span>
              </div>
              <p>Chargement de la carte des propriétés...</p>
              <small class="text-muted">
                <%= @properties.where.not(latitude: nil).count %> propriété(s) géolocalisée(s)
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
