<% content_for :title, "Projets de #{@user.email}" %>

<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 text-primary-custom mb-1">
        <i class="bi bi-hammer me-2"></i>Projets - <%= @user.email %>
      </h1>
      <p class="text-muted mb-0">
        <%= @projects.count %> projet(s) •
        <span class="text-warning"><%= @projects.where(statut: 'en_cours').count %> actif(s)</span>
      </p>
    </div>
    <div>
      <%= link_to "Retour au dashboard", admin_dashboard_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if @projects.any? %>
    <div class="row">
      <% @projects.each do |project| %>
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-light">
              <div class="d-flex justify-content-between align-items-start">
                <h6 class="mb-0">
                  <i class="bi bi-hammer me-2"></i><%= truncate(project.nom, length: 25) %>
                </h6>
                <span class="badge bg-<%= project.statut == 'en_cours' ? 'warning' : project.statut == 'termine' ? 'success' : 'secondary' %>">
                  <%= project.statut&.humanize || 'Non défini' %>
                </span>
              </div>
            </div>
            <div class="card-body">
              <!-- Propriété associée -->
              <div class="mb-3">
                <small class="text-muted">Propriété</small>
                <div class="fw-bold">
                  <i class="bi bi-house me-1"></i>
                  <%= truncate(project.property.adresse, length: 30) %>
                </div>
                <small class="text-muted"><%= project.property.commune %></small>
              </div>

              <!-- Description du projet -->
              <% if project.description.present? %>
                <div class="mb-3">
                  <small class="text-muted">Description</small>
                  <div class="text-wrap">
                    <%= truncate(project.description, length: 80) %>
                  </div>
                </div>
              <% end %>

              <!-- Informations techniques -->
              <div class="row g-2 mb-3">
                <% if project.type_travaux.present? %>
                  <div class="col-6">
                    <small class="text-muted">Type de travaux</small>
                    <div class="fw-bold"><%= project.type_travaux %></div>
                  </div>
                <% end %>

                <% if project.date_début.present? %>
                  <div class="col-6">
                    <small class="text-muted">Début prévu</small>
                    <div class="fw-bold"><%= project.date_début.strftime("%d/%m/%Y") %></div>
                  </div>
                <% end %>

                <% if project.date_fin.present? %>
                  <div class="col-6">
                    <small class="text-muted">Fin prévue</small>
                    <div class="fw-bold"><%= project.date_fin.strftime("%d/%m/%Y") %></div>
                  </div>
                <% end %>
              </div>

              <!-- Statistiques du projet -->
              <div class="row text-center mb-3">
                <div class="col-6">
                  <div class="border-end">
                    <h5 class="text-dark mb-0"><%= project.documents.count %></h5>
                    <small class="text-muted">Documents</small>
                  </div>
                </div>
                <div class="col-6">
                  <h5 class="text-info mb-0"><%= project.request ? 1 : 0 %></h5>
                  <small class="text-muted">Demande</small>
                </div>
              </div>

              <!-- Actions -->
              <div class="d-grid gap-2">
                <button class="btn btn-outline-primary btn-sm" onclick="alert('Projet: <%= project.nom %> - Propriété: <%= truncate(project.property.adresse, length: 30) %>')">
                  <i class="bi bi-eye me-2"></i>Voir les détails
                </button>

                <% if project.documents.any? %>
                  <%= link_to documents_admin_user_path(@user, project_filter: project.id), class: "btn btn-outline-dark btn-sm" do %>
                    <i class="bi bi-file-earmark me-2"></i>Voir les documents (<%= project.documents.count %>)
                  <% end %>
                <% end %>
              </div>
            </div>
            <div class="card-footer bg-light">
              <small class="text-muted">
                <i class="bi bi-calendar me-1"></i>
                Créé le <%= project.created_at.strftime("%d/%m/%Y") %>
              </small>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-5">
        <i class="bi bi-hammer text-muted" style="font-size: 4rem;"></i>
        <h4 class="text-muted mt-3">Aucun projet trouvé</h4>
        <p class="text-muted">Cet utilisateur n'a pas encore créé de projets.</p>
      </div>
    </div>
  <% end %>

  <!-- Résumé statistiques -->
  <div class="row mt-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
        <div class="card-body text-center">
          <h4 class="text-warning mb-0"><%= @projects.count %></h4>
          <small class="text-muted">Total projets</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-primary bg-opacity-10">
        <div class="card-body text-center">
          <h4 class="text-primary mb-0"><%= @projects.where(statut: 'en_cours').count %></h4>
          <small class="text-muted">Projets actifs</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-success bg-opacity-10">
        <div class="card-body text-center">
          <h4 class="text-success mb-0"><%= @projects.where(statut: 'termine').count %></h4>
          <small class="text-muted">Projets terminés</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-info bg-opacity-10">
        <div class="card-body text-center">
          <h4 class="text-info mb-0">
            Non disponible
          </h4>
          <small class="text-muted">Budget moyen</small>
        </div>
      </div>
    </div>
  </div>
</div>
