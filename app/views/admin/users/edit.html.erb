<% content_for :title, "Modifier #{@user.email}" %>

<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 text-primary-custom mb-1">
        <i class="bi bi-pencil-square me-2"></i>Modifier l'utilisateur
      </h1>
      <p class="text-muted mb-0"><%= @user.email %></p>
    </div>
    <div>
      <%= link_to "Annuler", admin_user_path(@user), class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-7">
      <div class="card shadow-sm">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-person me-2"></i>Informations du compte</h5>
        </div>
        <div class="card-body">
          <%= form_with model: @user, url: admin_user_path(@user), method: :patch do |f| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @user.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="row mb-3">
              <div class="col-md-6">
                <%= f.label :first_name, "Prénom", class: "form-label" %>
                <%= f.text_field :first_name, class: "form-control" %>
              </div>
              <div class="col-md-6">
                <%= f.label :last_name, "Nom", class: "form-label" %>
                <%= f.text_field :last_name, class: "form-control" %>
              </div>
            </div>

            <div class="mb-3">
              <%= f.label :email, "Email", class: "form-label" %>
              <%= f.email_field :email, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :phone, "Téléphone", class: "form-label" %>
              <%= f.text_field :phone, class: "form-control" %>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <%= f.label :region, "Région", class: "form-label" %>
                <%= f.select :region,
                    [["Wallonie", "wallonie"], ["Bruxelles", "bruxelles"], ["Flandre", "flandre"]],
                    { include_blank: "— Sélectionner —" },
                    class: "form-select" %>
              </div>
              <div class="col-md-6">
                <%= f.label :preferred_locale, "Langue", class: "form-label" %>
                <%= f.select :preferred_locale,
                    [["Français", "fr"], ["Nederlands", "nl"]],
                    { include_blank: "— Sélectionner —" },
                    class: "form-select" %>
              </div>
            </div>

            <div class="mb-4">
              <%= f.label :role, "Rôle", class: "form-label" %>
              <%= f.select :role,
                  [["Utilisateur", "user"], ["Modérateur", "moderator"], ["Administrateur", "admin"]],
                  {},
                  class: "form-select" %>
              <div class="form-text text-warning">
                <i class="bi bi-exclamation-triangle me-1"></i>Modifier le rôle avec précaution.
              </div>
            </div>

            <div class="d-flex gap-2">
              <%= f.submit "Enregistrer les modifications", class: "btn btn-primary" %>
              <%= link_to "Annuler", admin_user_path(@user), class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card shadow-sm">
        <div class="card-header">
          <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informations non modifiables</h5>
        </div>
        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-5 text-muted">ID</dt>
            <dd class="col-sm-7">#<%= @user.id %></dd>

            <dt class="col-sm-5 text-muted">Inscrit le</dt>
            <dd class="col-sm-7"><%= @user.created_at.strftime("%d/%m/%Y") %></dd>

            <dt class="col-sm-5 text-muted">Confirmé</dt>
            <dd class="col-sm-7">
              <% if @user.confirmed_at? %>
                <span class="badge bg-success"><%= @user.confirmed_at.strftime("%d/%m/%Y") %></span>
              <% else %>
                <span class="badge bg-warning text-dark">Non confirmé</span>
              <% end %>
            </dd>

            <dt class="col-sm-5 text-muted">Propriétés</dt>
            <dd class="col-sm-7"><%= @user.properties.count %></dd>

            <dt class="col-sm-5 text-muted">Dossiers</dt>
            <dd class="col-sm-7"><%= @user.projects.count %></dd>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>
