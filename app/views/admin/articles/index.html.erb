<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold" style="color: var(--ren0vate-primary);">Articles de blog</h1>
    <%= link_to "Nouvel article", new_admin_article_path, class: "btn btn-primary btn-sm" %>
  </div>

  <%# Brouillons %>
  <% if @drafts.any? %>
    <h2 class="h5 text-muted mb-3">Brouillons (<%= @drafts.count %>)</h2>
    <div class="card border-0 shadow-sm mb-5">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Titre</th><th>Catégorie</th><th>Créé le</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% @drafts.each do |article| %>
              <tr>
                <td><strong><%= article.title %></strong></td>
                <td><span class="badge bg-secondary"><%= article.category_label %></span></td>
                <td class="text-muted small"><%= article.created_at.strftime("%-d %b %Y") %></td>
                <td class="text-end">
                  <%= link_to "Éditer", edit_admin_article_path(article), class: "btn btn-sm btn-outline-primary me-1" %>
                  <%= button_to "Publier", publish_admin_article_path(article), method: :post, class: "btn btn-sm btn-success me-1" %>
                  <%= button_to "Supprimer", admin_article_path(article), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo_confirm: "Supprimer cet article ?" } } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# Publiés %>
  <h2 class="h5 text-muted mb-3">Publiés (<%= @published.count %>)</h2>
  <% if @published.any? %>
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Titre</th><th>Catégorie</th><th>Publié le</th><th>Lecture</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% @published.each do |article| %>
              <tr>
                <td>
                  <strong><%= article.title %></strong><br>
                  <small class="text-muted">/blog/<%= article.slug %></small>
                </td>
                <td><span class="badge" style="background: var(--ren0vate-accent);"><%= article.category_label %></span></td>
                <td class="text-muted small"><%= article.published_at.strftime("%-d %b %Y") %></td>
                <td class="text-muted small"><%= article.reading_time_minutes %> min</td>
                <td class="text-end">
                  <%= link_to "Voir", blog_show_path(slug: article.slug), target: "_blank", class: "btn btn-sm btn-outline-secondary me-1" %>
                  <%= link_to "Éditer", edit_admin_article_path(article), class: "btn btn-sm btn-outline-primary me-1" %>
                  <%= button_to "Dépublier", unpublish_admin_article_path(article), method: :post, class: "btn btn-sm btn-outline-warning" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="text-muted">Aucun article publié.</p>
  <% end %>
</div>
