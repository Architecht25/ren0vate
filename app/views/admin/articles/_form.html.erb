<link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .editor-toolbar button i { font-style: normal; }
  .editor-toolbar .bi { font-size: 14px; line-height: 1; }
</style>

<%= simple_form_for [:admin, article] do |f| %>
  <%= f.error_notification %>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm p-4 mb-4">
        <h5 class="fw-semibold mb-3">Contenu</h5>

        <%= f.input :title, label: "Titre", input_html: { class: "form-control" } %>
        <%= f.input :slug, label: "Slug (URL)", hint: "Généré automatiquement depuis le titre",
            input_html: { class: "form-control font-monospace" } %>
        <%= f.input :excerpt, label: "Résumé (affiché en listing)", as: :text,
            input_html: { class: "form-control", rows: 3 } %>
        <div class="mb-3">
          <label class="form-label">Contenu</label>
          <%= f.input :content, label: false, as: :text,
              input_html: { class: "form-control", id: "article_content_editor", rows: 25 } %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 shadow-sm p-4 mb-4">
        <h5 class="fw-semibold mb-3">Paramètres</h5>

        <%= f.input :category, label: "Catégorie", as: :select,
            collection: Article::CATEGORIES.map { |k, v| [v, k] },
            input_html: { class: "form-select" } %>
        <%= f.input :author, label: "Auteur", input_html: { class: "form-control" } %>
        <%= f.input :reading_time_minutes, label: "Durée de lecture (min)",
            input_html: { class: "form-control", type: "number", min: 1 },
            hint: "Estimée automatiquement si laissé à 0" %>
        <%= f.input :meta_description, label: "Meta description (SEO)",
            hint: "160 caractères max", as: :text,
            input_html: { class: "form-control", rows: 3, maxlength: 160 } %>
      </div>

      <div class="d-grid gap-2">
        <%= f.button :submit, article.persisted? ? "Enregistrer" : "Créer le brouillon",
            class: "btn btn-primary" %>
        <%= link_to "Annuler", admin_articles_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
<% end %>

<script src="https://unpkg.com/easymde/dist/easymde.min.js"></script>
<%= javascript_tag nonce: true do %>
  document.addEventListener('DOMContentLoaded', function() {
    var textarea = document.getElementById('article_content_editor');
    if (!textarea) return;

    var easyMDE = new EasyMDE({
      element: textarea,
      spellChecker: false,
      autosave: {
        enabled: true,
        uniqueId: "article_content_autosave",
        delay: 5000
      },
      toolbar: [
        { name: "bold",           action: EasyMDE.toggleBold,           className: "bi bi-type-bold",           title: "Gras" },
        { name: "italic",         action: EasyMDE.toggleItalic,         className: "bi bi-type-italic",         title: "Italique" },
        { name: "strikethrough",  action: EasyMDE.toggleStrikethrough,  className: "bi bi-type-strikethrough",  title: "Barré" },
        "|",
        { name: "heading-1",      action: EasyMDE.toggleHeading1,       className: "bi bi-type-h1",             title: "Titre H1" },
        { name: "heading-2",      action: EasyMDE.toggleHeading2,       className: "bi bi-type-h2",             title: "Titre H2" },
        { name: "heading-3",      action: EasyMDE.toggleHeading3,       className: "bi bi-type-h3",             title: "Sous-titre H3" },
        "|",
        { name: "quote",          action: EasyMDE.toggleBlockquote,     className: "bi bi-blockquote-left",     title: "Citation" },
        { name: "unordered-list", action: EasyMDE.toggleUnorderedList,  className: "bi bi-list-ul",             title: "Liste à puces" },
        { name: "ordered-list",   action: EasyMDE.toggleOrderedList,    className: "bi bi-list-ol",             title: "Liste numérotée" },
        { name: "horizontal-rule",action: EasyMDE.drawHorizontalRule,   className: "bi bi-dash-lg",             title: "Séparateur" },
        "|",
        { name: "link",           action: EasyMDE.drawLink,             className: "bi bi-link-45deg",          title: "Lien" },
        { name: "image",          action: EasyMDE.drawImage,            className: "bi bi-image",               title: "Image (URL)" },
        { name: "table",          action: EasyMDE.drawTable,            className: "bi bi-table",               title: "Tableau" },
        "|",
        { name: "preview",        action: EasyMDE.togglePreview,        className: "bi bi-eye no-disable",      title: "Aperçu" },
        { name: "side-by-side",   action: EasyMDE.toggleSideBySide,     className: "bi bi-layout-split no-disable no-mobile", title: "Côte à côte" },
        { name: "fullscreen",     action: EasyMDE.toggleFullScreen,     className: "bi bi-fullscreen no-disable no-mobile",   title: "Plein écran" },
        "|",
        { name: "guide", action: "https://www.markdownguide.org/basic-syntax/", className: "bi bi-question-circle", title: "Guide Markdown", target: "_blank" }
      ],
      renderingConfig: {
        singleLineBreaks: false,
        codeSyntaxHighlighting: false
      },
      placeholder: "Rédigez votre article ici...\n\n# Titre principal\n\n## Sous-section\n\nVotre texte...",
      status: ["autosave", "lines", "words", "cursor"],
      styleSelectedText: false,
      sideBySideFullscreen: false
    });
  });
<% end %>
