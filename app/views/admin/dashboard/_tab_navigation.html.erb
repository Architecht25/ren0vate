  <%# ── Rangée 2 : Intelligence & Acquisition ── %>
  <div class="d-flex align-items-center gap-2 mb-4 pt-1 border-top">
    <span class="text-muted small fw-semibold text-uppercase me-1" style="font-size: 0.65rem; letter-spacing: 0.06em; white-space: nowrap;">Intelligence &amp; Acquisition</span>
    <ul class="nav nav-pills flex-grow-0" id="adminTabsRow2" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="intelligence-tab" data-bs-toggle="pill" data-bs-target="#intelligence-panel" type="button" role="tab">
          <i class="bi bi-binoculars me-2"></i>Veille
          <% if @intelligence_latest&.week_of == @intelligence_current_week %>
            <span class="badge bg-success ms-1">New</span>
          <% end %>
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="marketing-tab" data-bs-toggle="pill" data-bs-target="#marketing-panel" type="button" role="tab">
          <i class="bi bi-megaphone me-2"></i>Marketing
          <% if @marketing_latest&.draft? %>
            <span class="badge bg-warning text-dark ms-1">À relire</span>
          <% end %>
        </button>
      </li>
    </ul>
  </div>

  <%# Synchronisation des deux rangées de pills : désactiver l'autre rangée quand une tab est activée %>
  <script nonce="<%= content_security_policy_nonce %>">
    (function() {
      var row1 = document.getElementById('adminTabs');
      var row2 = document.getElementById('adminTabsRow2');
      if (!row1 || !row2) return;

      function deactivateRow(rowEl) {
        rowEl.querySelectorAll('.nav-link.active').forEach(function(btn) {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        });
      }

      row1.addEventListener('show.bs.tab', function() { deactivateRow(row2); });
      row2.addEventListener('show.bs.tab', function() { deactivateRow(row1); });
    })();
  </script>

