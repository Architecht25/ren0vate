    <!-- ========== ONGLET UTILISATEURS ========== -->
    <div class="tab-pane fade" id="users-panel" role="tabpanel">
      <div class="row">
        <div class="col-md-12">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
              <h5 class="mb-0 fw-semibold"><i class="bi bi-people text-primary me-2"></i>Utilisateurs</h5>
              <small class="text-muted"><%= @users.count %> au total · <%= User.where('created_at >= ?', 30.days.ago).count %> inscrits ce mois</small>
            </div>
            <div class="card-body pt-2">

              <!-- Filtres -->
              <div class="mb-3 p-3 bg-light rounded">
                <div class="row g-2 align-items-end">
                  <div class="col-md-3">
                    <label class="form-label small mb-1">Recherche</label>
                    <input type="text" class="form-control form-control-sm" id="searchFilter"
                           placeholder="Nom, prénom ou email…" oninput="applyFilters()">
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small mb-1">Type</label>
                    <select class="form-select form-select-sm" id="userTypeFilter" onchange="applyFilters()">
                      <option value="">Tous</option>
                      <option value="client">Client</option>
                      <option value="entrepreneur">Entrepreneur</option>
                      <option value="architecte">Architecte</option>
                      <option value="autre">Autre</option>
                    </select>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small mb-1">Région</label>
                    <select class="form-select form-select-sm" id="regionFilter" onchange="applyFilters()">
                      <option value="">Toutes</option>
                      <option value="wallonie">Wallonie</option>
                      <option value="bruxelles">Bruxelles</option>
                      <option value="flandre">Flandre</option>
                    </select>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small mb-1">Engagement</label>
                    <select class="form-select form-select-sm" id="engagementFilter" onchange="applyFilters()">
                      <option value="">Tous</option>
                      <option value="excellent">Excellent</option>
                      <option value="bon">Bon</option>
                      <option value="moyen">Moyen</option>
                      <option value="faible">Faible</option>
                    </select>
                  </div>
                  <div class="col-md-2">
                    <label class="form-label small mb-1">Abonnement</label>
                    <select class="form-select form-select-sm" id="tierFilter" onchange="applyFilters()">
                      <option value="">Tous les tiers</option>
                      <option value="freemium">Découverte</option>
                      <option value="individual">Propriétaire</option>
                      <option value="portfolio">Investisseur</option>
                      <option value="professional">Expert</option>
                      <option value="enterprise">Platform</option>
                    </select>
                  </div>
                  <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-sm w-100" onclick="clearFilters()" title="Effacer les filtres">
                      <i class="bi bi-x-circle"></i>
                    </button>
                  </div>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-hover align-middle" id="usersTable">
                  <thead class="table-light">
                    <tr>
                      <th style="cursor:pointer;" onclick="sortTable(0)">Utilisateur <i class="bi bi-arrow-down-up small"></i></th>
                      <th style="cursor:pointer;" onclick="sortTable(1)">Région <i class="bi bi-arrow-down-up small"></i></th>
                      <th style="cursor:pointer;" onclick="sortTable(2)">Inscription <i class="bi bi-arrow-down-up small"></i></th>
                      <th style="cursor:pointer;" onclick="sortTable(3)">Dernière activité <i class="bi bi-arrow-down-up small"></i></th>
                      <th style="cursor:pointer;" onclick="sortTable(4)">Simulations <i class="bi bi-arrow-down-up small"></i></th>
                      <th style="cursor:pointer;" onclick="sortTable(5)">Conversion <i class="bi bi-arrow-down-up small"></i></th>
                      <th style="cursor:pointer;" onclick="sortTable(6)">Abonnement <i class="bi bi-arrow-down-up small"></i></th>
                      <th style="cursor:pointer;" onclick="sortTable(7)">Engagement <i class="bi bi-arrow-down-up small"></i></th>
                      <th>Activité</th>
                      <th>Segment</th>
                      <th>Suivi</th>
                      <th>Profil</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @users.includes(:simulations, :properties, :projects, :requests, :documents, :subscriptions, :project_members).order(created_at: :desc).each do |user| %>
                      <%
                        # Détecter le type utilisateur selon son activité
                        is_architect    = user.project_members.any? { |pm| pm.role == 'architect' && pm.status == 'active' }
                        is_entrepreneur = user.project_members.any? { |pm| pm.role == 'entrepreneur' && pm.status == 'active' }
                        user_type = if is_architect then 'architecte'
                                    elsif is_entrepreneur then 'entrepreneur'
                                    elsif user.properties.any? || user.simulations.any? then 'client'
                                    else 'autre'
                                    end
                      %>
                      <%
                        sim_count      = user.simulations.size
                        req_count      = user.requests.size
                        proj_count     = user.projects.size
                        prop_count     = user.properties.size
                        doc_count      = user.documents.size
                        sim_total      = user.simulations.sum { |s| s.total_simule.to_f }
                        total_actions  = prop_count + sim_count + proj_count + req_count + doc_count
                        days_signup    = [(Date.current - user.created_at.to_date).to_i, 1].max
                        engagement     = case total_actions
                                         when 0..2 then { level: 'Faible',    color: 'danger'  }
                                         when 3..7 then { level: 'Moyen',     color: 'warning' }
                                         when 8..15 then { level: 'Bon',      color: 'info'    }
                                         else            { level: 'Excellent', color: 'success' }
                                         end
                        last_activity  = [
                          user.simulations.map(&:updated_at).max,
                          user.properties.map(&:updated_at).max,
                          user.requests.map(&:updated_at).max,
                          user.projects.map(&:updated_at).max
                        ].compact.max
                        sub = user.subscriptions.find { |s| s.status == 'active' }
                      %>
                      <tr data-user-type="<%= user_type %>" data-user-search="<%= [user.email, user.first_name, user.last_name].compact.join(' ').downcase %>">
                        <%# Utilisateur %>
                        <td>
                          <strong class="small">
                            <%= link_to user.email, admin_user_path(user), class: "text-decoration-none" %>
                          </strong>
                          <% if user.first_name.present? || user.last_name.present? %>
                            <div class="text-muted" style="font-size: 11px;"><%= "#{user.first_name} #{user.last_name}".strip %></div>
                          <% end %>
                          <div class="d-flex flex-wrap gap-1 mt-1">
                            <% type_badge = { 'client' => ['bg-primary', 'person'], 'entrepreneur' => ['bg-warning text-dark', 'tools'], 'architecte' => ['bg-info text-dark', 'pencil-ruler'], 'autre' => ['bg-secondary', 'three-dots'] } %>
                            <span class="badge <%= type_badge[user_type][0] %>" style="font-size: 10px;">
                              <i class="bi bi-<%= type_badge[user_type][1] %> me-1"></i><%= user_type.capitalize %>
                            </span>
                            <% if user.admin? %>
                              <span class="badge bg-danger" style="font-size: 10px;">Admin</span>
                            <% elsif user.moderator? %>
                              <span class="badge bg-danger bg-opacity-50" style="font-size: 10px;">Modérateur</span>
                            <% end %>
                          </div>
                        </td>

                        <%# Région %>
                        <td>
                          <% if user.region.present? %>
                            <span class="badge bg-<%= user.region == 'wallonie' ? 'success' : user.region == 'bruxelles' ? 'primary' : 'warning text-dark' %>">
                              <%= user.region.capitalize %>
                            </span>
                          <% else %>
                            <span class="badge bg-secondary">Non définie</span>
                          <% end %>
                        </td>

                        <%# Inscription %>
                        <td>
                          <div class="small"><%= user.created_at.strftime("%d/%m/%Y") %></div>
                          <div class="text-muted" style="font-size: 11px;"><%= time_ago_in_words(user.created_at) %></div>
                          <% unless user.confirmed_at %>
                            <span class="badge bg-warning text-dark" style="font-size: 10px;">Non confirmé</span>
                          <% end %>
                        </td>

                        <%# Dernière activité %>
                        <td>
                          <% if last_activity %>
                            <div class="small fw-semibold"><%= last_activity.strftime("%d/%m/%Y") %></div>
                            <div class="text-muted" style="font-size: 11px;"><%= time_ago_in_words(last_activity) %></div>
                            <% if last_activity > 7.days.ago %>
                              <span class="badge bg-success" style="font-size: 10px;">Actif</span>
                            <% elsif last_activity > 30.days.ago %>
                              <span class="badge bg-warning text-dark" style="font-size: 10px;">Modéré</span>
                            <% else %>
                              <span class="badge bg-danger" style="font-size: 10px;">Inactif</span>
                            <% end %>
                          <% else %>
                            <span class="text-muted small">Aucune</span>
                          <% end %>
                        </td>

                        <%# Simulations %>
                        <td>
                          <% if sim_count > 0 %>
                            <div class="small fw-semibold text-success"><%= number_to_currency(sim_total, unit: '€', format: '%n %u', precision: 0) %></div>
                            <div class="text-muted" style="font-size: 11px;"><%= sim_count %> simulation<%= 's' if sim_count > 1 %></div>
                          <% else %>
                            <span class="text-muted small">—</span>
                          <% end %>
                        </td>

                        <%# Conversion sim → demande %>
                        <td>
                          <% if sim_count > 0 %>
                            <% rate = (req_count.to_f / sim_count * 100).round %>
                            <div class="small fw-semibold"><%= rate %>%</div>
                            <div class="progress mt-1" style="height: 4px; width: 60px;">
                              <div class="progress-bar <%= rate >= 80 ? 'bg-success' : rate >= 40 ? 'bg-warning' : 'bg-danger' %>"
                                   style="width: <%= [rate, 100].min %>%;"></div>
                            </div>
                            <div class="text-muted" style="font-size: 11px;"><%= req_count %> demande<%= 's' if req_count > 1 %></div>
                          <% elsif req_count > 0 %>
                            <span class="badge bg-info text-dark" style="font-size: 10px;"><%= req_count %> demande<%= 's' if req_count > 1 %></span>
                          <% else %>
                            <span class="text-muted small">—</span>
                          <% end %>
                        </td>

                        <%# Abonnement %>
                        <td>
                          <% tier_colors = { 'freemium' => 'secondary', 'individual' => 'primary', 'portfolio' => 'warning text-dark', 'professional' => 'purple', 'enterprise' => 'dark' } %>
                          <% if sub %>
                            <span class="badge bg-<%= tier_colors[sub.tier] || 'secondary' %>" style="font-size: 10px;">
                              <%= sub.tier_name %>
                            </span>
                            <div class="text-muted" style="font-size: 11px;"><%= sub.monthly_price %>€/mois</div>
                          <% else %>
                            <span class="text-muted small">Gratuit</span>
                          <% end %>
                        </td>

                        <%# Engagement %>
                        <td>
                          <span class="badge bg-<%= engagement[:color] %>"><%= engagement[:level] %></span>
                          <div class="text-muted" style="font-size: 11px;"><%= total_actions %> actions</div>
                          <div class="text-muted" style="font-size: 11px;"><%= (total_actions.to_f / days_signup * 7).round(1) %>/sem.</div>
                        </td>

                        <%# Badges activité %>
                        <td>
                          <div class="d-flex flex-wrap gap-1">
                            <span class="badge bg-primary px-2 py-1" title="Propriétés"><i class="bi bi-house me-1"></i><%= prop_count %></span>
                            <span class="badge bg-warning text-dark px-2 py-1" title="Projets"><i class="bi bi-hammer me-1"></i><%= proj_count %></span>
                            <span class="badge bg-success px-2 py-1" title="Simulations"><i class="bi bi-calculator me-1"></i><%= sim_count %></span>
                            <span class="badge bg-dark px-2 py-1" title="Demandes"><i class="bi bi-list-check me-1"></i><%= req_count %></span>
                            <span class="badge bg-info px-2 py-1" title="Documents"><i class="bi bi-file-earmark me-1"></i><%= doc_count %></span>
                          </div>
                        </td>

                        <%# Segment Primes-Services %>
                        <td class="text-center">
                          <button type="button"
                                  class="btn btn-sm border-0 p-1 primes-services-toggle"
                                  data-toggle-url="<%= toggle_primes_services_admin_user_path(user) %>"
                                  data-state="<%= user.primes_services_client? ? '1' : '0' %>"
                                  title="<%= user.primes_services_client? ? 'Retirer Primes-Services' : 'Marquer Primes-Services' %>"
                                  style="background:none;">
                            <% if user.primes_services_client? %>
                              <i class="bi bi-star-fill" style="color:#D97706; font-size:1.2rem;"></i>
                            <% else %>
                              <i class="bi bi-star" style="color:#ccc; font-size:1.2rem;"></i>
                            <% end %>
                          </button>
                        </td>

                        <%# Suivi relance (leads simulateurs non convertis) %>
                        <td>
                          <% if sub %>
                            <span class="text-muted small">—</span>
                          <% elsif user.contacted_at %>
                            <div class="small"><%= user.contacted_at.strftime("%d/%m/%Y") %></div>
                            <div class="text-muted" style="font-size: 11px;"><%= time_ago_in_words(user.contacted_at) %></div>
                            <% if user.contacted_at <= 7.days.ago %>
                              <span class="badge bg-danger" style="font-size: 10px;" title="Contacté il y a plus de 7 jours sans conversion">
                                <i class="bi bi-exclamation-triangle me-1"></i>Relance/suppr.
                              </span>
                            <% else %>
                              <span class="badge bg-info text-dark" style="font-size: 10px;">Contacté</span>
                            <% end %>
                          <% else %>
                            <button type="button" class="btn btn-outline-primary btn-sm mark-contacted-btn"
                                    data-mark-contacted-url="<%= mark_contacted_admin_user_path(user) %>"
                                    style="font-size: 11px;">
                              <i class="bi bi-telephone me-1"></i>Marquer contacté
                            </button>
                          <% end %>
                        </td>

                        <%# Profil %>
                        <td>
                          <% complete = user.first_name.present? && user.last_name.present? && user.region.present? %>
                          <% if complete %>
                            <span class="badge bg-success" style="font-size: 10px;"><i class="bi bi-check me-1"></i>Complet</span>
                          <% else %>
                            <span class="badge bg-warning text-dark" style="font-size: 10px;"><i class="bi bi-pencil me-1"></i>Incomplet</span>
                          <% end %>
                          <%= link_to admin_user_path(user), class: "btn btn-outline-secondary btn-sm d-block mt-1", style: "font-size: 11px;" do %>
                            <i class="bi bi-eye me-1"></i>Voir
                          <% end %>
                          <% unless user == current_user %>
                            <%= button_to admin_user_path(user), method: :delete,
                                form: { class: "d-block mt-1", data: { turbo_confirm: "Supprimer définitivement le compte #{user.email} ? Cette action est irréversible." } },
                                class: "btn btn-outline-danger btn-sm w-100", style: "font-size: 11px;" do %>
                              <i class="bi bi-trash me-1"></i>Supprimer
                            <% end %>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
