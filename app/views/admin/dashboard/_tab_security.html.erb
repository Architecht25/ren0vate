      <!-- ── 3. OWASP TOP 10 CHECKLIST ─────────────────────────────────────── -->
      <div class="row mb-4">
        <div class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
              <h5 class="mb-0 text-white"><i class="bi bi-list-check me-2"></i>OWASP Top 10 (2021) — État</h5>
              <small class="opacity-75 text-white">Scan du 18 avril 2026</small>
            </div>
            <div class="card-body">
              <div class="row g-2">
                <%
                  owasp_items = [
                    { code: 'A01', name: 'Broken Access Control',         status: 'ok',      detail: 'authenticate_user! global · IDOR corrigés 18 avr' },
                    { code: 'A02', name: 'Cryptographic Failures',        status: 'warn',    detail: 'national_number/IBAN ✅ · revenus/OCR non chiffrés (P3)' },
                    { code: 'A03', name: 'Injection',                     status: 'ok',      detail: 'ActiveRecord ORM · XSS 3 faux positifs ignorés justifiés' },
                    { code: 'A04', name: 'Insecure Design',               status: 'ok',      detail: 'Pseudonymisation IA · consentement RGPD · séparation rôles' },
                    { code: 'A05', name: 'Security Misconfiguration',     status: 'warn',    detail: "CSP : unsafe-inline, unsafe-eval présents · nonces à implémenter" },
                    { code: 'A06', name: 'Outdated Components',           status: 'ok',      detail: 'stripe 19 · Rails 8.1.3 · Devise 5.0.3 · brakeman 8.0.4' },
                    { code: 'A07', name: 'Identification & Auth Failures', status: 'ok',     detail: 'Devise + Lockable ✅ · 2FA admin (OTP email) actif depuis mai 2026' },
                    { code: 'A08', name: 'Software & Data Integrity',     status: 'ok',      detail: 'Stripe webhook signé · importmap · Gemfile.lock versionné' },
                    { code: 'A09', name: 'Security Logging & Monitoring', status: 'danger',  detail: 'filter_params ✅ · pas de SIEM · endpoint CSP à vérifier en prod' },
                    { code: 'A10', name: 'SSRF',                          status: 'ok',      detail: 'TRUSTED_IMAGE_HOSTS whitelist · URLs API fixes' },
                  ]
                  status_map = {
                    'ok'     => { color: 'success', icon: 'check-circle-fill', label: 'OK' },
                    'warn'   => { color: 'warning',  icon: 'exclamation-triangle-fill', label: 'À améliorer' },
                    'danger' => { color: 'danger',   icon: 'x-circle-fill', label: 'Action requise' }
                  }
                %>
                <% owasp_items.each do |item| %>
                  <% s = status_map[item[:status]] %>
                  <div class="col-lg-6">
                    <div class="d-flex align-items-start gap-3 p-2 rounded border border-<%= s[:color] %> border-opacity-25 bg-<%= s[:color] %> bg-opacity-10">
                      <i class="bi bi-<%= s[:icon] %> text-<%= s[:color] %> mt-1" style="font-size:1.1rem; flex-shrink:0;"></i>
                      <div class="flex-grow-1 min-width-0">
                        <div class="d-flex justify-content-between align-items-center">
                          <span class="fw-semibold small"><span class="text-muted me-1"><%= item[:code] %></span><%= item[:name] %></span>
                          <span class="badge bg-<%= s[:color] %> ms-2" style="white-space:nowrap; font-size:10px;"><%= s[:label] %></span>
                        </div>
                        <div class="text-muted" style="font-size:11px; margin-top:2px;"><%= item[:detail] %></div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── 4. PROTECTIONS AVANCÉES ───────────────────────────────────────── -->
