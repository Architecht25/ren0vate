            </div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-md-6">
                  <table class="table table-sm mb-0">
                    <thead class="table-light"><tr><th>Directive</th><th>Problème</th><th>Action</th></tr></thead>
                    <tbody>
                      <tr>
                        <td><code>script-src 'unsafe-inline'</code></td>
                        <td><span class="badge bg-warning text-dark">🟠 Neutralise XSS</span></td>
                        <td class="small text-muted">Migrer vers nonces (infra déjà en place)</td>
                      </tr>
                      <tr>
                        <td><code>script-src 'unsafe-eval'</code></td>
                        <td><span class="badge bg-warning text-dark">🟠 eval() risqué</span></td>
                        <td class="small text-muted">Requis par Turbo — surveiller Turbo 2.x</td>
                      </tr>
                      <tr>
                        <td><code>script-src :https</code></td>
                        <td><span class="badge bg-warning text-dark">🟠 Trop permissif</span></td>
                        <td class="small text-muted">Lister CDNs explicitement</td>
                      </tr>
                      <tr>
                        <td><code>style-src 'unsafe-inline'</code></td>
                        <td><span class="badge bg-info text-dark">🟡 Acceptable</span></td>
                        <td class="small text-muted">Standard Bootstrap — bas risque</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div class="col-md-6">
