                  </thead>
                  <tbody>
                    <%
                      deps = [
                        { name: 'stripe',                  old: '15.5.0',  current: '19.0.0', prio: 'danger',  note: 'Mise à jour critique 18 avr' },
                        { name: 'rails',                   old: '8.0.2',   current: '8.1.3',  prio: 'warning', note: 'Fixture simulations.yml corrigée' },
                        { name: 'devise',                  old: '4.9.4',   current: '5.0.3',  prio: 'warning', note: 'CVE-2026-32700 · data-turbo-temporary migré' },
                        { name: 'loofah',                  old: '2.24.1',  current: '2.25.1', prio: 'warning', note: 'Sanitization HTML' },
                        { name: 'rails-html-sanitizer',    old: '1.6.2',   current: '1.7.0',  prio: 'warning', note: 'Sanitization HTML' },
                        { name: 'rubyzip',                 old: '2.4.1',   current: '3.2.2',  prio: 'warning', note: 'API Zip::File.open v3 compatible' },
                        { name: 'nokogiri',                old: '1.18.8',  current: '1.19.2', prio: 'info',    note: 'Maintenance normale' },
                        { name: 'brakeman',                old: '7.0.2',   current: '8.0.4',  prio: 'info',    note: '0 warnings · 402 templates' },
                      ]
