                        <td><strong class="text-success"><%= d[:current] %></strong></td>
                        <td><span class="badge bg-<%= d[:prio] %>" style="font-size:10px;"><%= d[:prio] == 'danger' ? 'Critique' : d[:prio] == 'warning' ? 'Haute' : 'Normale' %></span></td>
                        <td class="small text-muted"><%= d[:note] %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
