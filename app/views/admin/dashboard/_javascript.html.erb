console.log('🔧 Event delegation setup complete');

// Toggle Primes-Services AJAX — mise à jour instantanée sans rechargement de page
document.addEventListener('click', function(e) {
  const btn = e.target.closest('.primes-services-toggle');
  if (!btn) return;

  e.preventDefault();
  e.stopPropagation();

  const url = btn.dataset.toggleUrl;
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  // Feedback visuel immédiat (spinner)
  const icon = btn.querySelector('i');
  icon.className = 'bi bi-arrow-repeat';
  icon.style.color = '#aaa';
  btn.disabled = true;

  fetch(url, {
    method: 'POST',
    headers: {
      'X-CSRF-Token': csrfToken,
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    }
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    const active = data.primes_services_client;
    btn.dataset.state = active ? '1' : '0';
    btn.title = active ? 'Retirer Primes-Services' : 'Marquer Primes-Services';
    icon.className = active ? 'bi bi-star-fill' : 'bi bi-star';
    icon.style.color = active ? '#D97706' : '#ccc';
    icon.style.fontSize = '1.2rem';
    btn.disabled = false;
  })
  .catch(function() {
    // En cas d'erreur : restaurer l'état précédent
    const wasActive = btn.dataset.state === '1';
    icon.className = wasActive ? 'bi bi-star-fill' : 'bi bi-star';
    icon.style.color = wasActive ? '#D97706' : '#ccc';
    icon.style.fontSize = '1.2rem';
    btn.disabled = false;
  });
});

// Marquer un lead comme contacté (suivi relance J+7) — AJAX sans rechargement de page
document.addEventListener('click', function(e) {
  const btn = e.target.closest('.mark-contacted-btn');
  if (!btn) return;

  e.preventDefault();
  e.stopPropagation();

  const url = btn.dataset.markContactedUrl;
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  btn.disabled = true;
  const originalHtml = btn.innerHTML;
  btn.innerHTML = '<i class="bi bi-arrow-repeat"></i>';

  fetch(url, {
    method: 'POST',
    headers: {
      'X-CSRF-Token': csrfToken,
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    }
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    const cell = btn.closest('td');
    const datePart = data.contacted_at.split(' ')[0];
    cell.innerHTML =
      '<div class="small">' + datePart + '</div>' +
      '<div class="text-muted" style="font-size: 11px;">à l\'instant</div>' +
      '<span class="badge bg-info text-dark" style="font-size: 10px;">Contacté</span>';
  })
  .catch(function() {
    btn.disabled = false;
    btn.innerHTML = originalHtml;
  });
});

// Fonction de test pour la modal
function testModal(userId) {
  console.log('🎯 Tentative d\'ouverture de la modal pour user:', userId);

  // Tester d'abord si la modal existe
  const modalElement = document.getElementById('userDetailsModal');
  if (!modalElement) {
    console.error('❌ Modal userDetailsModal non trouvée');
    alert('Erreur: Modal non trouvée dans le DOM');
    return;
  }

  console.log('✅ Modal trouvée, tentative d\'ouverture...');

  try {
    // Ouvrir la modal d'abord
    const modal = new bootstrap.Modal(modalElement);
    modal.show();

    console.log('✅ Modal ouverte, chargement du contenu...');

    // Charger le contenu simple
    const contentDiv = document.getElementById('user-details-content');
    if (contentDiv) {
      contentDiv.innerHTML = `
        <div class="text-center p-4">
          <div class="spinner-border text-primary mb-3" role="status">
            <span class="visually-hidden">Chargement...</span>
          </div>
          <p>Chargement des détails de l'utilisateur ${userId}...</p>
        </div>
      `;

      // Simuler un délai puis charger les vraies données
      setTimeout(() => loadUserDetails(userId), 1000);
    } else {
      console.error('❌ Div user-details-content non trouvé');
    }

  } catch (error) {
    console.error('❌ Erreur lors de l\'ouverture de la modal:', error);
    alert('Erreur: ' + error.message);
  }
}

// ===== FONCTIONNALITÉS DE FILTRAGE ET TRI DU TABLEAU UTILISATEURS =====

// Variables globales
let sortDirection = {};
let currentFilters = {
  region: '',
  engagement: '',
  potential: ''
};

// Fonction de tri des colonnes
function sortTable(columnIndex) {
  const table = document.getElementById('usersTable');
  const tbody = table.querySelector('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));

  // Déterminer la direction du tri
  sortDirection[columnIndex] = sortDirection[columnIndex] === 'asc' ? 'desc' : 'asc';

  // Fonction de comparaison
  rows.sort((a, b) => {
    let aValue = a.cells[columnIndex].textContent.trim();
    let bValue = b.cells[columnIndex].textContent.trim();

    // Traitement spécial pour les montants (€)
    if (aValue.includes('€')) {
      aValue = parseFloat(aValue.replace(/[€,\s]/g, '')) || 0;
      bValue = parseFloat(bValue.replace(/[€,\s]/g, '')) || 0;
    }
    // Traitement spécial pour les dates
    else if (aValue.match(/\d{2}\/\d{2}\/\d{4}/)) {
      aValue = new Date(aValue.split('/').reverse().join('-'));
      bValue = new Date(bValue.split('/').reverse().join('-'));
    }
    // Traitement numérique pour les pourcentages
    else if (aValue.includes('%')) {
      aValue = parseFloat(aValue.replace('%', '')) || 0;
      bValue = parseFloat(bValue.replace('%', '')) || 0;
    }

    if (sortDirection[columnIndex] === 'asc') {
      return aValue < bValue ? -1 : aValue > bValue ? 1 : 0;
    } else {
      return aValue > bValue ? -1 : aValue < bValue ? 1 : 0;
    }
  });

  // Remettre les lignes triées dans le tableau
  rows.forEach(row => tbody.appendChild(row));

  // Mettre à jour les indicateurs visuels
  updateSortIndicators(columnIndex);
}

// Mise à jour des indicateurs de tri
function updateSortIndicators(activeColumn) {
  const headers = document.querySelectorAll('#usersTable thead th');
  headers.forEach((header, index) => {
    const icon = header.querySelector('i');
    if (icon) {
      if (index === activeColumn) {
        icon.className = sortDirection[activeColumn] === 'asc' ?
          'bi bi-arrow-up small text-primary' :
          'bi bi-arrow-down small text-primary';
      } else {
        icon.className = 'bi bi-arrow-down-up small';
      }
    }
  });
}

// Application des filtres
function applyFilters() {
  const searchFilter    = (document.getElementById('searchFilter')?.value || '').toLowerCase().trim();
  const userTypeFilter  = (document.getElementById('userTypeFilter')?.value || '').toLowerCase();
  const regionFilter    = (document.getElementById('regionFilter')?.value || '').toLowerCase();
  const engagementFilter = (document.getElementById('engagementFilter')?.value || '').toLowerCase();
  const tierFilter      = (document.getElementById('tierFilter')?.value || '').toLowerCase();

  const tbody = document.querySelector('#usersTable tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));

  let visibleCount = 0;

  rows.forEach(row => {
    let shouldShow = true;

    // Filtre recherche (email, nom, prénom via data-attribute)
    if (searchFilter) {
      const searchData = (row.dataset.userSearch || '').toLowerCase();
      shouldShow = shouldShow && searchData.includes(searchFilter);
    }

    // Filtre type utilisateur via data-attribute
    if (userTypeFilter) {
      shouldShow = shouldShow && (row.dataset.userType || '') === userTypeFilter;
    }

    // Filtre région (colonne 1)
    if (regionFilter) {
      const regionCell = row.cells[1]?.textContent.toLowerCase() || '';
      shouldShow = shouldShow && regionCell.includes(regionFilter);
    }

    // Filtre engagement (colonne 7)
    if (engagementFilter) {
      const engagementCell = row.cells[7]?.textContent.toLowerCase() || '';
      shouldShow = shouldShow && engagementCell.includes(engagementFilter);
    }

    // Filtre abonnement (colonne 6)
    if (tierFilter) {
      const tierCell = row.cells[6]?.textContent.toLowerCase() || '';
      shouldShow = shouldShow && tierCell.includes(tierFilter);
    }

    row.style.display = shouldShow ? '' : 'none';
    if (shouldShow) visibleCount++;
  });

  updateFilterCount(visibleCount, rows.length);
}

// Effacer tous les filtres
function clearFilters() {
  ['searchFilter', 'userTypeFilter', 'regionFilter', 'engagementFilter', 'tierFilter'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = '';
  });

  const tbody = document.querySelector('#usersTable tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));
  rows.forEach(row => { row.style.display = ''; });
  updateFilterCount(rows.length, rows.length);
}

// Mise à jour du compteur de filtres
function updateFilterCount(visible, total) {
  const existingCounter = document.querySelector('.filter-counter');
  if (existingCounter) {
    existingCounter.remove();
  }

  const filterDiv = document.querySelector('.mb-3.p-3.bg-light.rounded');
  const counter = document.createElement('div');
  counter.className = 'filter-counter mt-2 text-center';
  counter.innerHTML = `<small class="text-info"><i class="bi bi-funnel-fill me-1"></i>Affichage: <strong>${visible}</strong> sur <strong>${total}</strong> utilisateurs</small>`;
  filterDiv.appendChild(counter);
}

// Initialisation au chargement de la page
document.addEventListener('DOMContentLoaded', function() {
  updateFilterCount(
    document.querySelectorAll('#usersTable tbody tr').length,
    document.querySelectorAll('#usersTable tbody tr').length
  );
});

// Exposition en global : les attributs onclick/oninput du HTML (tableau utilisateurs)
// cherchent ces fonctions sur window, hors de la portée de cette IIFE.
window.sortTable = sortTable;
window.applyFilters = applyFilters;
window.clearFilters = clearFilters;

})(); // fin IIFE
</script>
