<!-- Section Backups et Récupération de Données -->
<div class="col-lg-6 mb-4">
  <div class="card border-0 shadow-sm h-100">
    <% _bg_class = case @backup_status[:backup_health][:status]
                   when 'excellent' then 'text-bg-success'
                   when 'good'      then 'text-bg-primary'
                   when 'average'   then 'text-bg-warning'
                   else                  'text-bg-danger'
                   end %>
    <% _title_color = @backup_status[:backup_health][:status] == 'average' ? 'text-dark' : 'text-white' %>
    <div class="card-header <%= _bg_class %>">
      <h5 class="mb-0 <%= _title_color %>">
        <i class="bi bi-hdd-stack me-2"></i>Backups et Récupération de Données
        <span class="badge bg-light text-dark ms-2">
          Score: <%= @backup_status[:backup_health][:percentage] %>%
        </span>
      </h5>
    </div>
    <div class="card-body">
      <% if @backup_status[:heroku_backup][:simulated] && !Rails.env.development? %>
        <div class="alert alert-warning alert-sm py-2 mb-3">
          <i class="bi bi-exclamation-triangle me-1"></i>
          <small><strong>Données estimées</strong> — Statut Heroku non connecté à l'API en temps réel. Exécutez <code>heroku pg:backups:info --app ren0vate</code> pour vérifier.</small>
        </div>
      <% end %>
      <div class="row">
        <!-- Statut Heroku Backup -->
        <div class="col-md-3">
          <div class="backup-status-item text-center">
            <i class="bi bi-cloud-arrow-up display-4 text-<%= @backup_status[:heroku_backup][:status] == 'active' ? 'success' : 'danger' %>"></i>
            <h6 class="mt-2">Backup Heroku</h6>
            <span class="badge bg-<%= @backup_status[:heroku_backup][:status] == 'active' ? 'success' : 'danger' %>">
              <%= @backup_status[:heroku_backup][:status] == 'active' ? 'ACTIF' : 'INACTIF' %>
            </span>
            <% if @backup_status[:heroku_backup][:last_backup] %>
              <small class="d-block text-muted mt-1">
                Dernier: <%= time_ago_in_words(@backup_status[:heroku_backup][:last_backup]) %>
              </small>
            <% end %>
          </div>
        </div>

        <!-- Taille et Fréquence -->
        <div class="col-md-3">
          <div class="backup-status-item text-center">
            <i class="bi bi-speedometer2 display-4 text-info"></i>
            <h6 class="mt-2">Fréquence</h6>
            <span class="badge bg-info">QUOTIDIEN</span>
            <small class="d-block text-muted mt-1">
              Prochaine: <%= @backup_status[:heroku_backup][:next_backup]&.strftime('%H:%M') || 'N/A' %>
            </small>
          </div>
        </div>

        <!-- Taille du dernier backup -->
        <div class="col-md-3">
          <div class="backup-status-item text-center">
            <i class="bi bi-file-zip display-4 text-primary"></i>
            <h6 class="mt-2">Taille</h6>
            <span class="badge bg-primary"><%= @backup_status[:heroku_backup][:size] %></span>
            <small class="d-block text-muted mt-1">
              Rétention: <%= @backup_status[:heroku_backup][:retention] %>
            </small>
          </div>
        </div>

        <!-- Backup Manuel -->
        <div class="col-md-3">
          <div class="backup-status-item text-center">
            <i class="bi bi-download display-4 text-<%= @backup_status[:last_manual_backup] ? 'success' : 'warning' %>"></i>
            <h6 class="mt-2">Backup Manuel</h6>
            <span class="badge bg-<%= @backup_status[:last_manual_backup] ? 'success' : 'warning' %>">
              <%= @backup_status[:last_manual_backup] ? 'DISPONIBLE' : 'AUCUN' %>
            </span>
            <% if @backup_status[:last_manual_backup] %>
              <small class="d-block text-muted mt-1">
                <%= time_ago_in_words(@backup_status[:last_manual_backup][:created_at]) %>
              </small>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Détails et recommandations -->
      <div class="row mt-4">
        <div class="col-md-8">
          <h6><i class="bi bi-info-circle me-2"></i>Informations détaillées</h6>
          <div class="table-responsive">
            <table class="table table-sm">
              <tbody>
                <tr>
                  <td><strong>Backup automatique Heroku:</strong></td>
                  <td>
                    <span class="badge bg-<%= @backup_status[:heroku_backup][:status] == 'active' ? 'success' : 'danger' %>">
                      <%= @backup_status[:backup_frequency][:heroku_automatic] %>
                    </span>
                  </td>
                </tr>
                <tr>
                  <td><strong>Scripts de backup manuels:</strong></td>
                  <td>
                    <code>bin/backup_production.sh</code>
                    <span class="badge bg-info ms-2">Disponible</span>
                  </td>
                </tr>
                <tr>
                  <td><strong>Exports JSON critiques:</strong></td>
                  <td>
                    <code>rake backup:critical_data</code>
                    <span class="badge bg-success ms-2">Fonctionnel</span>
                  </td>
                </tr>
                <tr>
                  <td><strong>Backups locaux stockés:</strong></td>
                  <td>
                    <span class="badge bg-secondary"><%= @backup_status[:local_backups] %> fichiers</span>
                    <small class="text-muted ms-2">dans tmp/backups/</small>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="col-md-4">
          <h6><i class="bi bi-lightbulb me-2"></i>Recommandations</h6>
          <div class="backup-recommendations">
            <% @backup_status[:backup_health][:recommendations].each do |recommendation| %>
              <div class="alert alert-<%= @backup_status[:backup_health][:status] == 'excellent' ? 'success' : 'warning' %> alert-sm py-2 mb-2">
                <i class="bi bi-<%= @backup_status[:backup_health][:status] == 'excellent' ? 'check-circle' : 'exclamation-triangle' %> me-1"></i>
                <small><%= recommendation %></small>
              </div>
            <% end %>
          </div>

          <!-- Actions rapides backup -->
          <div class="mt-3">
            <h6><i class="bi bi-tools me-2"></i>Actions rapides</h6>
            <div class="d-grid gap-2">
              <button class="btn btn-sm btn-outline-primary" id="test-backup-btn">
                <i class="bi bi-play-circle me-1"></i>Tester backup
              </button>
              <button class="btn btn-sm btn-outline-info" id="backup-stats-btn">
                <i class="bi bi-graph-up me-1"></i>Statistiques
              </button>
              <a href="/Documents_strategiques/BACKUP_STRATEGY.md" class="btn btn-sm btn-outline-secondary" target="_blank">
                <i class="bi bi-book me-1"></i>Documentation
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
