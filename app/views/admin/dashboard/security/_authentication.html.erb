<!-- Authentification et sessions -->
<div class="col-lg-2 col-md-6 mb-4">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-header text-bg-success">
      <h6 class="mb-0 text-white"><i class="bi bi-person-lock me-2"></i>Authentification</h6>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>Devise configuré</span>
            <span class="badge bg-success">
              <i class="bi bi-check-circle me-1"></i>OUI
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>Confirmation email</span>
            <span class="badge bg-success">
              <i class="bi bi-envelope-check me-1"></i>ACTIF
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>Utilisateurs confirmés</span>
            <span class="badge bg-info">
              <i class="bi bi-people me-1"></i><span id="confirmed-users-count"><%= @security_stats[:confirmed_count] %></span>
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>En attente confirmation</span>
            <span class="badge bg-<%= @security_stats[:unconfirmed_count].to_i > 0 ? 'warning' : 'success' %>">
              <i class="bi bi-hourglass me-1"></i><span id="unconfirmed-users-count"><%= @security_stats[:unconfirmed_count] %></span>
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>Sessions sécurisées</span>
            <span class="badge bg-success">
              <i class="bi bi-check-circle me-1"></i>secure, httponly
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>CSRF Protection</span>
            <span class="badge bg-success">
              <i class="bi bi-check-circle me-1"></i>ACTIF
            </span>
          </div>
        </div>
        <div class="col-12">
          <div class="d-flex justify-content-between align-items-center">
            <span>Utilisateurs actifs</span>
            <span class="badge bg-primary"><%= @users.count %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
