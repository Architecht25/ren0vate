<!-- État général de la sécurité -->
<div class="col-lg-6 mb-4">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-header bg-danger text-white">
      <h5 class="mb-0"><i class="bi bi-shield-check me-2"></i>État de la sécurité</h5>
    </div>
    <div class="card-body">
      <div class="row text-center">
        <div class="col-md-2">
          <div class="security-status">
            <i class="bi bi-shield-fill-check <%= @security_stats[:ssl_active] ? 'text-success' : 'text-danger' %> display-4"></i>
            <h6 class="mt-2">HTTPS/SSL</h6>
            <span class="badge bg-<%= @security_stats[:ssl_active] ? 'success' : 'danger' %>"><%= @security_stats[:ssl_active] ? 'ACTIF' : 'INACTIF' %></span>
          </div>
        </div>
        <div class="col-md-2">
          <div class="security-status">
            <i class="bi bi-lock-fill text-success display-4"></i>
            <h6 class="mt-2">Authentification</h6>
            <span class="badge bg-success">DEVISE</span>
          </div>
        </div>
        <div class="col-md-2">
          <div class="security-status">
            <i class="bi bi-envelope-check-fill text-success display-4"></i>
            <h6 class="mt-2">Email Confirm</h6>
            <span class="badge bg-success">ACTIF</span>
          </div>
        </div>
        <div class="col-md-2">
          <div class="security-status">
            <i class="bi bi-eye-slash-fill <%= @security_stats[:csp_enforced] ? 'text-success' : 'text-warning' %> display-4"></i>
            <h6 class="mt-2">CSP</h6>
            <span class="badge bg-<%= @security_stats[:csp_enforced] ? 'success' : 'warning' %>"><%= @security_stats[:csp_enforced] ? 'ENFORCED' : 'REPORT-ONLY' %></span>
          </div>
        </div>
        <div class="col-md-2">
          <div class="security-status">
            <i class="bi bi-database-lock text-success display-4"></i>
            <h6 class="mt-2">Sessions</h6>
            <span class="badge bg-success">SÉCURISÉES</span>
          </div>
        </div>
        <div class="col-md-2">
          <div class="security-status">
            <i class="bi bi-people-fill <%= @security_stats[:admin_count] == 1 ? 'text-success' : 'text-warning' %> display-4"></i>
            <h6 class="mt-2">Gestion Rôles</h6>
            <span class="badge bg-<%= @security_stats[:admin_count] == 1 ? 'success' : 'warning' %>" id="admin-roles-status">
              <%= @security_stats[:admin_count] %> ADMIN<%= 's' if @security_stats[:admin_count] > 1 %>
            </span>
          </div>
        </div>
      </div>

      <!-- Score global de sécurité -->
      <%
        score_points = 0
        score_points += 20 if @security_stats[:ssl_active]
        score_points += 20 if @security_stats[:csp_enforced]
        score_points += 20 if @security_stats[:hsts_active]
        score_points += 20 if @security_stats[:admin_count] == 1
        score_points += 20 if @security_stats[:unconfirmed_count].to_i < (@security_stats[:total_users] * 0.2)
        score_color = score_points >= 80 ? 'success' : score_points >= 60 ? 'warning' : 'danger'
        score_icon  = score_points >= 80 ? 'check-circle' : 'exclamation-triangle'
      %>
      <div class="row mt-4">
        <div class="col-12 text-center">
          <div class="security-status">
            <i class="bi bi-graph-up text-<%= score_color %> display-5"></i>
            <h5 class="mt-2 mb-3">Score Global de Sécurité</h5>
            <span class="badge bg-<%= score_color %> fs-4 px-4 py-2" id="global-security-score">
              <%= score_points %>%
              <i class="bi bi-<%= score_icon %> ms-2"></i>
            </span>
            <p class="text-muted mt-2 mb-0">
              <%= score_points >= 80 ? 'Configuration optimale' : score_points >= 60 ? 'Améliorations recommandées' : 'Attention requise' %>
            </p>
            <% unless Rails.env.production? %>
              <small class="text-muted fst-italic">
                (score réduit en <%= Rails.env %> — SSL/HSTS/CSP enforcement désactivés intentionnellement)
              </small>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
