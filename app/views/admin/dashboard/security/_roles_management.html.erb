<!-- Monitoring des rôles administrateur -->
<div class="col-lg-2 col-md-6 mb-4">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-header bg-<%= User.admin.count == 1 ? 'primary' : 'warning' %> text-white">
      <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Gestion des Rôles</h6>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>Administrateurs</span>
            <span class="badge bg-<%= User.admin.count == 1 ? 'success' : 'warning' %>">
              <i class="bi bi-<%= User.admin.count == 1 ? 'check-circle' : 'exclamation-triangle' %> me-1"></i>
              <%= User.admin.count %>
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>Modérateurs</span>
            <span class="badge bg-info">
              <i class="bi bi-shield me-1"></i><%= User.moderator.count %>
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>Utilisateurs standard</span>
            <span class="badge bg-secondary">
              <i class="bi bi-person me-1"></i><%= User.user.count %>
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex justify-content-between align-items-center">
            <span>Sécurité admin</span>
            <span class="badge bg-<%= User.admin.count == 1 ? 'success' : 'danger' %>">
              <i class="bi bi-<%= User.admin.count == 1 ? 'check-circle' : 'x-circle' %> me-1"></i>
              <%= User.admin.count == 1 ? 'OPTIMAL' : 'RISQUE' %>
            </span>
          </div>
        </div>
        <div class="col-12">
          <small class="text-muted">
            <strong>Admin unique :</strong>
            <% if User.admin.count == 1 %>
              <%= User.admin.first.email %>
              <i class="bi bi-check-circle text-success ms-1"></i>
            <% else %>
              <span class="text-warning">Multiples administrateurs détectés</span>
              <i class="bi bi-exclamation-triangle text-warning ms-1"></i>
            <% end %>
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
