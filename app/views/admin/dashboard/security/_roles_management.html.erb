<!-- Monitoring des rôles administrateur -->
<div class="col-lg-2 col-md-6 mb-4">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-header text-bg-<%= @security_stats[:admin_count] == 1 ? 'primary' : 'warning' %>">
      <h6 class="mb-0 text-white"><i class="bi bi-shield-lock me-2"></i>Gestion des Rôles</h6>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-12 mb-3">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Administrateurs</span>
            <span class="badge bg-<%= @security_stats[:admin_count] == 1 ? 'success' : 'warning' %>">
              <i class="bi bi-<%= @security_stats[:admin_count] == 1 ? 'check-circle' : 'exclamation-triangle' %> me-1"></i>
              <%= @security_stats[:admin_count] %>
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Modérateurs</span>
            <span class="badge bg-info">
              <i class="bi bi-shield me-1"></i><%= @security_stats[:moderator_count] %>
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Utilisateurs standard</span>
            <span class="badge bg-secondary">
              <i class="bi bi-person me-1"></i><%= @security_stats[:user_count] %>
            </span>
          </div>
        </div>
        <div class="col-12 mb-3">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Sécurité admin</span>
            <span class="badge bg-<%= @security_stats[:admin_count] == 1 ? 'success' : 'danger' %>">
              <i class="bi bi-<%= @security_stats[:admin_count] == 1 ? 'check-circle' : 'x-circle' %> me-1"></i>
              <%= @security_stats[:admin_count] == 1 ? 'OPTIMAL' : 'RISQUE' %>
            </span>
          </div>
        </div>
        <div class="col-12">
          <small class="text-muted d-flex flex-wrap align-items-center gap-1">
            <strong>Admin unique :</strong>
            <% if @security_stats[:admin_count] == 1 %>
              <span class="text-break"><%= User.admin.first&.email %></span>
              <i class="bi bi-check-circle text-success"></i>
            <% else %>
              <span class="text-warning">Multiples administrateurs détectés</span>
              <i class="bi bi-exclamation-triangle text-warning"></i>
            <% end %>
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
