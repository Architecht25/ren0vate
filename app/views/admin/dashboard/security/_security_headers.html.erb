<!-- Headers de sécurité -->
<div class="col-lg-2 col-md-6 mb-4">
  <div class="card border-0 shadow-sm h-100">
    <div class="card-header bg-primary text-white">
      <h6 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Headers de sécurité</h6>
    </div>
    <div class="card-body">
      <div class="security-check-list">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span>X-Frame-Options</span>
          <span class="badge bg-success">SAMEORIGIN</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span>X-Content-Type-Options</span>
          <span class="badge bg-success">nosniff</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span>X-XSS-Protection</span>
          <span class="badge bg-success">1; mode=block</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span>Referrer-Policy</span>
          <span class="badge bg-success">strict-origin</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span>HSTS</span>
          <span class="badge bg-success">31536000s</span>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <span>Permissions-Policy</span>
          <span class="badge bg-success">Restrictive</span>
        </div>
      </div>
    </div>
  </div>
</div>
