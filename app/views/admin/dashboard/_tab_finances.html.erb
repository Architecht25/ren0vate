<div class="tab-pane fade" id="finances-panel" role="tabpanel">

  <!-- KPI finances -->
  <div class="row g-3 mb-4">

    <!-- MRR Stripe par tier -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="text-muted fw-semibold text-uppercase mb-3" style="font-size: 11px; letter-spacing: 0.5px;">
            <i class="bi bi-currency-euro me-1"></i>Revenus récurrents mensuels (MRR)
          </h6>
          <div class="d-flex align-items-end gap-2 mb-3">
            <span class="fw-bold" style="font-size: 28px;"><%= @mrr_total %>€</span>
            <span class="text-muted small mb-1">/ mois</span>
          </div>
          <% tier_colors = { 'freemium' => '#9ca3af', 'individual' => '#667eea', 'portfolio' => '#ea580c', 'professional' => '#8b5cf6', 'enterprise' => '#f59e0b' } %>
          <% @subscriptions_by_tier.each do |tier, data| %>
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="rounded-circle flex-shrink-0" style="width: 10px; height: 10px; background: <%= tier_colors[tier] %>;"></div>
                <span class="small"><%= Subscription.new(tier: tier).tier_name rescue tier.humanize %></span>
              </div>
              <div class="text-end">
                <span class="small fw-semibold"><%= data[:count] %> abonnés</span>
                <span class="text-muted small ms-2"><%= data[:mrr] %>€</span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Stats OCR & factures -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="text-muted fw-semibold text-uppercase mb-3" style="font-size: 11px; letter-spacing: 0.5px;">
            <i class="bi bi-file-earmark-text me-1"></i>Factures & devis
          </h6>
          <div class="row g-2">
            <div class="col-6">
              <div class="bg-light rounded p-2 text-center">
                <div class="fw-bold fs-5"><%= @finance_stats[:total_factures] %></div>
                <div class="text-muted" style="font-size: 11px;">Factures</div>
              </div>
            </div>
            <div class="col-6">
              <div class="bg-light rounded p-2 text-center">
                <div class="fw-bold fs-5"><%= @finance_stats[:total_devis] %></div>
                <div class="text-muted" style="font-size: 11px;">Devis</div>
              </div>
            </div>
            <div class="col-6">
              <div class="bg-warning bg-opacity-10 rounded p-2 text-center">
                <div class="fw-bold fs-5 text-warning"><%= @finance_stats[:non_payees] %></div>
                <div class="text-muted" style="font-size: 11px;">Non payées</div>
              </div>
            </div>
            <div class="col-6">
              <div class="bg-success bg-opacity-10 rounded p-2 text-center">
                <div class="fw-bold fs-5 text-success"><%= @finance_stats[:validees_manuellement] %></div>
                <div class="text-muted" style="font-size: 11px;">Validées OCR</div>
              </div>
            </div>
          </div>
          <div class="mt-3">
            <div class="d-flex justify-content-between mb-1">
              <span class="small">Confiance OCR moyenne</span>
              <span class="small fw-semibold"><%= @finance_stats[:ocr_confiance_moyenne] %>%</span>
            </div>
            <div class="progress" style="height: 6px;">
              <div class="progress-bar <%= @finance_stats[:ocr_confiance_moyenne].to_f >= 75 ? 'bg-success' : 'bg-warning' %>"
                   style="width: <%= @finance_stats[:ocr_confiance_moyenne] %>%;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Alertes deadlines primes -->
    <div class="col-lg-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h6 class="text-muted fw-semibold text-uppercase mb-3" style="font-size: 11px; letter-spacing: 0.5px;">
            <i class="bi bi-alarm me-1"></i>Deadlines primes
          </h6>
          <% if @factures_expiration_critique.any? %>
            <div class="alert alert-danger py-1 px-2 mb-2" style="font-size: 12px;">
              <i class="bi bi-exclamation-octagon-fill me-1"></i>
              <strong><%= @factures_expiration_critique.count %></strong> facture(s) critiques (&lt;30j)
            </div>
          <% end %>
          <% if @factures_expiration_proche.any? %>
            <div class="alert alert-warning py-1 px-2 mb-2" style="font-size: 12px;">
              <i class="bi bi-exclamation-triangle-fill me-1"></i>
              <strong><%= @factures_expiration_proche.count %></strong> facture(s) proches (&lt;90j)
            </div>
          <% end %>
          <% if @factures_expiration_critique.empty? && @factures_expiration_proche.empty? %>
            <div class="text-success small">
              <i class="bi bi-check-circle-fill me-1"></i>Aucune deadline urgente
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>

  <!-- Alertes expiration critique -->
  <% if @factures_expiration_critique.any? %>
    <div class="card border-0 shadow-sm border-start border-danger border-3 mb-4">
      <div class="card-header bg-white border-0 pt-3 pb-2">
        <h6 class="mb-0 text-danger fw-semibold">
          <i class="bi bi-exclamation-octagon-fill me-2"></i>Factures à deadline critique (&lt; 30 jours)
        </h6>
      </div>
      <div class="card-body pt-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 table-sm">
            <thead class="table-light">
              <tr>
                <th class="border-0 text-muted fw-semibold" style="font-size: 11px;">NUMÉRO</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 11px;">ENTREPRISE</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 11px;">MONTANT</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 11px;">PROJET</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 11px;">JOURS RESTANTS</th>
              </tr>
            </thead>
            <tbody>
              <% @factures_expiration_critique.each do |f| %>
                <tr>
                  <td class="small"><%= f.numero_facture.presence || "—" %></td>
                  <td class="small"><%= f.nom_entreprise.presence || "—" %></td>
                  <td class="small fw-semibold"><%= number_to_currency(f.montant, unit: '€', format: '%n %u', precision: 0) rescue '—' %></td>
                  <td class="small"><%= f.project&.nom || "—" %></td>
                  <td>
                    <span class="badge bg-danger">
                      <%= f.jours_avant_expiration %> j
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Factures récentes -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-4 pb-2 d-flex align-items-center justify-content-between">
      <h5 class="mb-0 fw-semibold"><i class="bi bi-receipt text-primary me-2"></i>Factures & devis récents</h5>
      <span class="badge bg-light text-secondary"><%= @factures_recent.count %> affichés</span>
    </div>
    <div class="card-body pt-0">
      <% if @factures_recent.empty? %>
        <div class="text-center text-muted py-5">
          <i class="bi bi-receipt fs-1 d-block mb-2"></i>
          Aucune facture enregistrée
        </div>
      <% else %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="border-0 text-muted fw-semibold" style="font-size: 12px;">TYPE</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 12px;">NUMÉRO</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 12px;">ENTREPRISE</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 12px;">MONTANT</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 12px;">PAIEMENT</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 12px;">OCR</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 12px;">PROJET</th>
                <th class="border-0 text-muted fw-semibold" style="font-size: 12px;">DATE</th>
              </tr>
            </thead>
            <tbody>
              <% type_badge = { 'devis' => 'bg-info text-dark', 'facture' => 'bg-primary', 'acompte' => 'bg-secondary', 'solde' => 'bg-success', 'etat_avancement' => 'bg-warning text-dark' } %>
              <% paiement_badge = { 'paye' => 'bg-success', 'non_paye' => 'bg-danger', 'partiel' => 'bg-warning text-dark' } %>
              <% @factures_recent.each do |f| %>
                <tr>
                  <td>
                    <span class="badge <%= type_badge[f.type_facture] || 'bg-secondary' %>" style="font-size: 10px;">
                      <%= f.type_facture&.humanize %>
                    </span>
                  </td>
                  <td class="small text-muted"><%= f.numero_facture.presence || '—' %></td>
                  <td>
                    <div class="small"><%= f.nom_entreprise.presence || '—' %></div>
                    <% if f.type_intervenant %>
                      <div class="text-muted" style="font-size: 11px;"><%= f.type_intervenant %></div>
                    <% end %>
                  </td>
                  <td class="small fw-semibold">
                    <%= f.montant.present? ? number_to_currency(f.montant, unit: '€', format: '%n %u', precision: 0) : '—' %>
                  </td>
                  <td>
                    <% if f.statut_paiement %>
                      <span class="badge <%= paiement_badge[f.statut_paiement] || 'bg-secondary' %>" style="font-size: 10px;">
                        <%= f.statut_paiement.humanize %>
                      </span>
                    <% end %>
                  </td>
                  <td>
                    <% if f.confiance_ocr %>
                      <div class="d-flex align-items-center gap-1">
                        <div class="progress flex-grow-1" style="height: 5px; width: 40px;">
                          <div class="progress-bar <%= f.confiance_ocr >= 75 ? 'bg-success' : 'bg-warning' %>"
                               style="width: <%= f.confiance_ocr %>%;"></div>
                        </div>
                        <span class="text-muted" style="font-size: 11px;"><%= f.confiance_ocr %>%</span>
                      </div>
                    <% else %>
                      <span class="text-muted small">—</span>
                    <% end %>
                  </td>
                  <td class="small text-truncate" style="max-width: 120px;"><%= f.project&.nom || '—' %></td>
                  <td class="text-muted small"><%= f.date_facture&.strftime('%d/%m/%Y') || f.created_at.strftime('%d/%m/%Y') %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>

</div>
