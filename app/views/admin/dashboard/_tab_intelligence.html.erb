<div class="tab-pane fade" id="intelligence-panel" role="tabpanel">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-semibold mb-0">Veille marché & intelligence produit</h5>
    <%= button_to "Lancer l'analyse",
        run_admin_intelligence_reports_path,
        method: :post,
        class: "btn btn-primary btn-sm",
        form: { data: { turbo_confirm: "Lancer une analyse pour #{@intelligence_current_week} ?" } } %>
  </div>

  <% if @intelligence_latest.present? %>
    <%# Dernier rapport complété %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><%= @intelligence_latest.week_label %></span>
        <span class="badge bg-success">Complété</span>
      </div>
      <div class="card-body">
        <div class="intelligence-analysis">
          <%= simple_format(@intelligence_latest.analysis) %>
        </div>
        <div class="mt-3 text-end">
          <%= link_to "Voir les sources brutes →", admin_intelligence_report_path(@intelligence_latest), class: "small text-muted" %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Historique des rapports %>
  <% if @intelligence_reports.any? %>
    <h6 class="text-muted mb-2">Historique</h6>
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0 small">
          <thead class="table-light">
            <tr>
              <th>Semaine</th>
              <th>Statut</th>
              <th>Articles</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @intelligence_reports.each do |report| %>
              <tr>
                <td>
                  <%= report.week_label %>
                  <% if report.week_of == @intelligence_current_week %>
                    <span class="badge bg-info ms-1">Cette semaine</span>
                  <% end %>
                </td>
                <td>
                  <% if report.completed? %>
                    <span class="badge bg-success">Complété</span>
                  <% elsif report.processing? %>
                    <span class="badge bg-warning text-dark">En cours...</span>
                  <% elsif report.failed? %>
                    <span class="badge bg-danger" title="<%= report.error_message %>">Échec</span>
                  <% else %>
                    <span class="badge bg-secondary">En attente</span>
                  <% end %>
                </td>
                <td class="text-muted"><%= report.sources_count %></td>
                <td class="text-muted"><%= report.created_at.strftime("%-d %b") %></td>
                <td>
                  <% if report.completed? %>
                    <%= link_to "Lire", admin_intelligence_report_path(report), class: "btn btn-xs btn-outline-primary btn-sm py-0 px-2" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="text-muted small">Aucun rapport encore généré. Lance une première analyse.</p>
  <% end %>
</div>

<style>
  #intelligence-panel .intelligence-analysis h2 { font-size: 1rem; font-weight: 600; margin-top: 1.25rem; margin-bottom: 0.4rem; color: var(--ren0vate-primary); }
  #intelligence-panel .intelligence-analysis p  { margin-bottom: 0.6rem; line-height: 1.6; font-size: 0.9rem; }
</style>
