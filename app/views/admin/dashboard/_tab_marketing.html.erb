<div class="tab-pane fade" id="marketing-panel" role="tabpanel">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-semibold mb-0">Marketing — Drafts Agent</h5>
    <%= link_to "Voir tous les drafts →", admin_marketing_weeks_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if @marketing_latest.present? %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold"><%= @marketing_latest.week_label %></span>
        <% case @marketing_latest.status %>
        <% when 'draft' %>
          <span class="badge bg-warning text-dark">À relire</span>
        <% when 'reviewed' %>
          <span class="badge bg-info">Relu</span>
        <% when 'published' %>
          <span class="badge bg-success">Publié</span>
        <% end %>
      </div>
      <div class="card-body">
        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <div class="p-3 border rounded bg-light">
              <p class="small fw-semibold mb-1">📝 Article blog</p>
              <% if @marketing_latest.article %>
                <p class="small mb-1 text-truncate"><%= @marketing_latest.article.title %></p>
                <%= link_to "Éditer →", edit_admin_article_path(@marketing_latest.article), class: "small text-primary" %>
              <% else %>
                <p class="small text-muted mb-0">Non généré</p>
              <% end %>
            </div>
          </div>
          <div class="col-md-8">
            <div class="p-3 border rounded bg-light">
              <p class="small fw-semibold mb-1">Posts sociaux</p>
              <div class="d-flex gap-3">
                <span class="small <%= @marketing_latest.linkedin_post.present? ? 'text-success' : 'text-muted' %>">
                  <%= @marketing_latest.linkedin_post.present? ? '✓' : '—' %> LinkedIn
                </span>
                <span class="small <%= @marketing_latest.instagram_post.present? ? 'text-success' : 'text-muted' %>">
                  <%= @marketing_latest.instagram_post.present? ? '✓' : '—' %> Instagram
                </span>
                <span class="small <%= @marketing_latest.facebook_post.present? ? 'text-success' : 'text-muted' %>">
                  <%= @marketing_latest.facebook_post.present? ? '✓' : '—' %> Facebook
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="text-end">
          <%= link_to "Voir les drafts complets →", admin_marketing_week_path(@marketing_latest), class: "small text-muted" %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @marketing_weeks.any? %>
    <h6 class="text-muted mb-2">Historique</h6>
    <div class="card border-0 shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover mb-0 small">
          <thead class="table-light">
            <tr>
              <th>Semaine</th>
              <th>Statut</th>
              <th>Article</th>
              <th>Posts</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @marketing_weeks.each do |week| %>
              <tr>
                <td><%= week.week_label %></td>
                <td>
                  <% case week.status
                     when 'draft' %>
                    <span class="badge bg-warning text-dark">À relire</span>
                  <% when 'reviewed' %>
                    <span class="badge bg-info">Relu</span>
                  <% when 'published' %>
                    <span class="badge bg-success">Publié</span>
                  <% end %>
                </td>
                <td class="text-muted"><%= week.article ? week.article.title.truncate(30) : '—' %></td>
                <td class="text-muted"><%= week.social_posts_count %>/3</td>
                <td>
                  <%= link_to "Voir", admin_marketing_week_path(week), class: "btn btn-xs btn-outline-primary btn-sm py-0 px-2" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <p class="text-muted small">
      Aucun draft disponible. Lance <code>ruby ~/agents-hub/Ren0vate/acquisition/marketing_agent.rb</code> après le rapport de veille.
    </p>
  <% end %>
</div>
