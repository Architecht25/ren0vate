  <!-- KPI Cards — activité réelle de la plateforme -->
  <% active_users_30d = User.where('updated_at >= ? OR created_at >= ?', 30.days.ago, 30.days.ago).count %>
  <% new_users_7d = User.where('created_at >= ?', 7.days.ago).count %>
  <% projects_en_cours = @projects.select { |p| p.statut.present? && !['termine', 'annule'].include?(p.statut) }.count %>
  <% reserves_ouvertes = @reserves_stats[:ouvertes] + @reserves_stats[:en_cours] %>
  <div class="row mb-4">

    <%# 1 — Utilisateurs actifs 30j %>
    <div class="col-lg-1p5 col-md-3 col-sm-6 mb-3">
      <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card-body text-white p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0 fw-bold text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.3);"><%= active_users_30d %></h3>
              <small class="text-white d-block" style="opacity: 0.9; font-weight: 500;">Utilisateurs actifs <span class="badge bg-white bg-opacity-25 ms-1">30j</span></small>
              <small class="text-white" style="opacity: 0.7;">+<%= new_users_7d %> cette semaine</small>
            </div>
            <i class="bi bi-people fs-1 text-white" style="opacity: 0.7;"></i>
          </div>
        </div>
      </div>
    </div>

    <%# 2 — Propriétés %>
    <div class="col-lg-1p5 col-md-3 col-sm-6 mb-3">
      <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
        <div class="card-body text-white p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0 fw-bold text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.3);"><%= @properties.count %></h3>
              <small class="text-white d-block" style="opacity: 0.9; font-weight: 500;">Propriétés</small>
              <small class="text-white" style="opacity: 0.7;"><%= @properties.select { |p| p.latitude.present? }.count %> géocodées</small>
            </div>
            <i class="bi bi-house fs-1 text-white" style="opacity: 0.7;"></i>
          </div>
        </div>
      </div>
    </div>

    <%# 3 — Projets en cours %>
    <div class="col-lg-1p5 col-md-3 col-sm-6 mb-3">
      <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #ea580c 0%, #dc2626 100%);">
        <div class="card-body text-white p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0 fw-bold text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.3);"><%= projects_en_cours %></h3>
              <small class="text-white d-block" style="opacity: 0.9; font-weight: 500;">Projets en cours</small>
              <small class="text-white" style="opacity: 0.7;"><%= @projects.count %> au total</small>
            </div>
            <i class="bi bi-hammer fs-1 text-white" style="opacity: 0.7;"></i>
          </div>
        </div>
      </div>
    </div>

    <%# 4 — Simulations %>
    <div class="col-lg-1p5 col-md-3 col-sm-6 mb-3">
      <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
        <div class="card-body text-white p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0 fw-bold text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.3);"><%= @simulations.count %></h3>
              <small class="text-white d-block" style="opacity: 0.9; font-weight: 500;">Simulations</small>
              <small class="text-white" style="opacity: 0.7;"><%= @simulations.where('created_at >= ?', 30.days.ago).count %> ce mois</small>
            </div>
            <i class="bi bi-calculator fs-1 text-white" style="opacity: 0.7;"></i>
          </div>
        </div>
      </div>
    </div>

    <%# 5 — Réserves ouvertes (punch list) %>
    <div class="col-lg-1p5 col-md-3 col-sm-6 mb-3">
      <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
        <div class="card-body text-white p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0 fw-bold text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.3);"><%= reserves_ouvertes %></h3>
              <small class="text-white d-block" style="opacity: 0.9; font-weight: 500;">Réserves actives</small>
              <small class="text-white" style="opacity: 0.7;"><%= @reserves_stats[:levees] %> levées</small>
            </div>
            <i class="bi bi-exclamation-triangle fs-1 text-white" style="opacity: 0.7;"></i>
          </div>
        </div>
      </div>
    </div>

    <%# 6 — MRR Stripe %>
    <div class="col-lg-1p5 col-md-3 col-sm-6 mb-3">
      <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
        <div class="card-body text-white p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0 fw-bold text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.3);"><%= @mrr_total %>€</h3>
              <small class="text-white d-block" style="opacity: 0.9; font-weight: 500;">MRR</small>
              <small class="text-white" style="opacity: 0.7;"><%= @subscriptions_active.count %> abonnés actifs</small>
            </div>
            <i class="bi bi-currency-euro fs-1 text-white" style="opacity: 0.7;"></i>
          </div>
        </div>
      </div>
    </div>

    <%# 7 — Suivis de primes %>
    <div class="col-lg-1p5 col-md-3 col-sm-6 mb-3">
      <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #8b5cf6 0%, #a855f7 100%);">
        <div class="card-body text-white p-3">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h3 class="mb-0 fw-bold text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.3);"><%= @request_progresses.count %></h3>
              <small class="text-white d-block" style="opacity: 0.9; font-weight: 500;">Suivis de primes</small>
              <small class="text-white" style="opacity: 0.7;"><%= @request_progresses.select { |rp| rp.status_administratif == 'accorde' }.count %> accordées</small>
            </div>
            <i class="bi bi-clipboard-check fs-1 text-white" style="opacity: 0.7;"></i>
          </div>
        </div>
      </div>
    </div>

    <%# 8 — Tickets support %>
    <% overdue_count = @support_stats[:overdue] %>
    <div class="col-lg-1p5 col-md-3 col-sm-6 mb-3">
      <%= link_to admin_support_tickets_path, class: "text-decoration-none" do %>
        <div class="card border-0 shadow-lg h-100" style="background: linear-gradient(135deg, #0ea5e9 0%, #0369a1 100%);">
          <div class="card-body text-white p-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h3 class="mb-0 fw-bold text-white" style="text-shadow: 0 1px 3px rgba(0,0,0,0.3);">
                  <%= @support_stats[:open] %>
                  <% if overdue_count > 0 %>
                    <span class="badge bg-danger ms-1" style="font-size: 11px;"><%= overdue_count %> SLA</span>
                  <% end %>
                </h3>
                <small class="text-white d-block" style="opacity: 0.9; font-weight: 500;">Tickets ouverts</small>
                <small class="text-white" style="opacity: 0.7;"><%= @support_stats[:resolved_this_week] %> résolus ce mois</small>
              </div>
              <i class="bi bi-headset fs-1 text-white" style="opacity: 0.7;"></i>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- CSS pour les colonnes égales sur 8 cartes -->
  <style>
    @media (min-width: 992px) {
      .col-lg-1p5 {
        flex: 0 0 12.5%;
        max-width: 12.5%;
      }
    }
    @media (max-width: 991.98px) {
      .col-lg-1p5 {
        flex: 0 0 25%;
        max-width: 25%;
      }
    }
    @media (max-width: 575.98px) {
      .col-lg-1p5 {
        flex: 0 0 50%;
        max-width: 50%;
      }
    }
  </style>

  <!-- Navigation par onglets -->
