    <!-- ========== ONGLET PRIMES ========== -->
    <div class="tab-pane fade" id="primes-panel" role="tabpanel">
      <div class="row g-4">
        <!-- Gestion des Primes Particuliers -->
        <div class="col-lg-6">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-primary bg-opacity-10">
              <h5 class="mb-0 text-primary">
                <i class="bi bi-house-heart me-2"></i>Primes Particuliers
              </h5>
            </div>
            <div class="card-body">
              <div class="row g-3 mb-4">
                <div class="col-4 text-center">
                  <div class="badge bg-primary bg-opacity-10 text-primary fs-4 rounded-circle p-3 mb-2">
                    <%= Prime.where(region: 'flandre').count %>
                  </div>
                  <small class="text-muted d-block">Flandre</small>
                </div>
                <div class="col-4 text-center">
                  <div class="badge bg-success bg-opacity-10 text-success fs-4 rounded-circle p-3 mb-2">
                    <%= Prime.where(region: 'wallonie').count %>
                  </div>
                  <small class="text-muted d-block">Wallonie</small>
                </div>
                <div class="col-4 text-center">
                  <div class="badge bg-warning bg-opacity-10 text-warning fs-4 rounded-circle p-3 mb-2">
                    <%= Prime.where(region: 'bruxelles').count %>
                  </div>
                  <small class="text-muted d-block">Bruxelles</small>
                </div>
              </div>

              <div class="d-grid gap-2">
                <%= link_to primes_path, class: "btn btn-primary" do %>
                  <i class="bi bi-eye me-2"></i>Consulter toutes les primes
                <% end %>
                <%= link_to new_prime_path, class: "btn btn-outline-primary" do %>
                  <i class="bi bi-plus-circle me-2"></i>Ajouter une prime
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Statistiques détaillées -->
        <div class="col-12">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light">
              <h5 class="mb-0">
                <i class="bi bi-graph-up me-2"></i>Statistiques détaillées
              </h5>
            </div>
            <div class="card-body">
              <div class="row g-4">
                <div class="col-md-6">
                  <div class="text-center">
                    <h4 class="text-primary mb-1"><%= Prime.count %></h4>
                    <small class="text-muted">Total primes</small>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="text-center">
                    <h4 class="text-warning mb-1"><%= Category.count %></h4>
                    <small class="text-muted">Catégories</small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

