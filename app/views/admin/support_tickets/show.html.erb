<% content_for :title, "Ticket ##{@ticket.id} — Admin Support" %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-xl-9">

      <div class="d-flex align-items-center justify-content-between mb-3">
        <%= link_to admin_support_tickets_path, class: "btn btn-sm btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Tickets
        <% end %>
        <div class="d-flex gap-2">
          <span class="badge bg-<%= @ticket.status_color %> fs-6"><%= @ticket.status_label %></span>
          <% if @ticket.priority == 'urgent' %>
            <span class="badge bg-danger fs-6">Urgent</span>
          <% end %>
          <% unless @ticket.within_sla? || @ticket.responded_at %>
            <span class="badge bg-danger fs-6">SLA dépassé</span>
          <% end %>
        </div>
      </div>

      <!-- Infos ticket -->
      <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-0 fw-bold"><%= @ticket.subject %></h5>
            <small class="text-muted">
              #<%= @ticket.id %> · <%= @ticket.user.email %> (Plan : <%= @ticket.user.subscription_tier_name %>)
              · créé le <%= @ticket.created_at.strftime('%d/%m/%Y à %Hh%M') %>
            </small>
          </div>
          <div class="d-flex gap-2">
            <% unless @ticket.status == 'resolved' %>
              <%= button_to resolve_admin_support_ticket_path(@ticket), method: :patch,
                    class: "btn btn-success btn-sm",
                    data: { confirm: "Marquer ce ticket comme résolu ?" } do %>
                <i class="bi bi-check2-circle me-1"></i>Résolu
              <% end %>
            <% end %>
            <% unless @ticket.status == 'closed' %>
              <%= button_to close_admin_support_ticket_path(@ticket), method: :patch,
                    class: "btn btn-outline-secondary btn-sm" do %>
                Fermer
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Fil de messages -->
        <div class="card-body p-3">
          <% @messages.each do |msg| %>
            <% is_admin = msg.is_admin_reply? %>
            <div class="d-flex gap-3 mb-4 <%= 'flex-row-reverse' if is_admin %>">
              <div class="flex-shrink-0">
                <div class="rounded-circle d-flex align-items-center justify-content-center
                            <%= is_admin ? 'bg-primary' : 'bg-success' %> text-white"
                     style="width:38px;height:38px;font-size:14px;">
                  <%= is_admin ? 'A' : @ticket.user.email.first.upcase %>
                </div>
              </div>
              <div class="flex-grow-1">
                <div class="small text-muted mb-1 <%= 'text-end' if is_admin %>">
                  <strong><%= is_admin ? "Admin (#{msg.user.email})" : @ticket.user.email %></strong>
                  · <%= msg.created_at.strftime('%d/%m à %Hh%M') %>
                </div>
                <div class="p-3 rounded-3 <%= is_admin ? 'bg-primary bg-opacity-10' : 'bg-light' %>"
                     style="white-space: pre-wrap; font-size: 0.9rem;">
                  <%= msg.body %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Formulaire réponse admin -->
      <% unless %w[closed].include?(@ticket.status) %>
        <div class="card border-primary border-2 shadow-sm">
          <div class="card-header bg-primary text-white">
            <strong><i class="bi bi-reply me-1"></i>Répondre à <%= @ticket.user.email %></strong>
          </div>
          <div class="card-body p-3">
            <%= form_with url: reply_admin_support_ticket_path(@ticket), method: :post do |f| %>
              <%= f.text_area :body,
                    name: "support_message[body]",
                    rows: 5,
                    class: "form-control mb-3",
                    placeholder: "Votre réponse à l'utilisateur..." %>
              <%= f.submit "Envoyer la réponse", class: "btn btn-primary" %>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
