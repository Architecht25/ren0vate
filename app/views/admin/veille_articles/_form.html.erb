<%= form_with model: [:admin, article], class: "needs-validation" do |f| %>
  <% if article.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% article.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <%# Titre %>
    <div class="col-12">
      <%= f.label :titre, "Titre de l'article", class: "form-label fw-semibold" %>
      <%= f.text_field :titre, class: "form-control", placeholder: "Ex: 46% des bailleurs réalisent actuellement des travaux...", required: true %>
    </div>

    <%# Source + Date %>
    <div class="col-md-4">
      <%= f.label :source, "Source", class: "form-label fw-semibold" %>
      <%= f.select :source,
          options_for_select(VeilleArticle::SOURCES, article.source),
          { include_blank: "— choisir —" },
          class: "form-select" %>
    </div>
    <div class="col-md-4">
      <%= f.label :source_date, "Date de publication", class: "form-label fw-semibold" %>
      <%= f.date_field :source_date, class: "form-control", required: true %>
    </div>
    <div class="col-md-4">
      <%= f.label :region, "Région concernée", class: "form-label fw-semibold" %>
      <%= f.select :region,
          options_for_select(VeilleArticle::REGIONS.map { |r| [r.capitalize, r] }, article.region),
          { include_blank: "— générale —" },
          class: "form-select" %>
    </div>

    <%# Thèmes (checkboxes) %>
    <div class="col-12">
      <label class="form-label fw-semibold">Thèmes</label>
      <div class="d-flex flex-wrap gap-2">
        <% VeilleArticle::THEMES.each do |theme| %>
          <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox"
              name="veille_article[themes_list][]"
              value="<%= theme %>"
              id="theme_<%= theme %>"
              <%= "checked" if article.themes_list.include?(theme) %>>
            <label class="form-check-label small" for="theme_<%= theme %>"><%= theme %></label>
          </div>
        <% end %>
        <%# champ caché pour envoyer tableau vide si rien n'est coché %>
        <input type="hidden" name="veille_article[themes_list][]" value="">
      </div>
    </div>

    <%# Contenu %>
    <div class="col-12">
      <%= f.label :contenu, "Contenu de l'article (coller le texte ici)", class: "form-label fw-semibold" %>
      <%= f.text_area :contenu, class: "form-control", rows: 14,
          placeholder: "Coller ici le texte intégral de l'article..." %>
      <div class="form-text">Ce texte sera injecté dans le contexte de l'agent IA pour les articles actifs.</div>
    </div>

    <%# Notes admin %>
    <div class="col-12">
      <%= f.label :admin_notes, "Notes internes (non injectées dans le bot)", class: "form-label fw-semibold" %>
      <%= f.text_area :admin_notes, class: "form-control", rows: 3,
          placeholder: "Observations, lien source original, pertinence pour les utilisateurs..." %>
    </div>

    <%# Actif %>
    <div class="col-12">
      <div class="form-check form-switch">
        <%= f.check_box :active, class: "form-check-input", role: "switch", id: "article_active" %>
        <%= f.label :active, "Injecter dans le contexte de l'agent IA", class: "form-check-label fw-semibold" %>
      </div>
      <div class="form-text">Seuls les articles actifs sont transmis à l'agent. Les 5 plus récents sont sélectionnés.</div>
    </div>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= f.submit article.new_record? ? "Ajouter l'article" : "Enregistrer les modifications",
        class: "btn btn-primary" %>
    <%= link_to "Annuler", admin_veille_articles_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
