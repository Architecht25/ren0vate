<div class="container-fluid px-4 py-4" style="max-width: 900px;">
  <div class="mb-4">
    <%= link_to admin_veille_articles_path, class: "text-muted text-decoration-none small" do %>
      <i class="bi bi-arrow-left me-1"></i>Retour à la veille presse
    <% end %>
    <h4 class="fw-bold mt-2 mb-0">Modifier l'article</h4>
    <p class="text-muted small mb-0"><%= @article.source %> — <%= @article.source_date&.strftime("%-d %b %Y") %></p>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <%= render "form", article: @article %>
    </div>
  </div>
</div>
