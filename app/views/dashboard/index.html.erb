<%
  # Page d'accueil après connexion - Dashboard des fonctionnalités
  # Style architectural en grille 3x3 avec les 9 fonctionnalités principales

  set_seo_meta(
    title: "Tableau de bord - Ren0vate",
    description: "Accédez à toutes vos fonctionnalités Ren0vate depuis votre tableau de bord",
    keywords: ["dashboard", "tableau de bord", "fonctionnalités", "rénovation", "primes", "simulations"]
  )
%>

  <!-- Widget Notifications en haut à droite -->
  <div class="notification-widget position-fixed" style="top: 80px; right: 20px; z-index: 2000;">
    <% unread_count = current_user.respond_to?(:notifications) ? current_user.notifications.unread.count : 0 %>
    <%= link_to notifications_path, class: "btn btn-outline-primary position-relative notification-widget-btn", style: "border-radius: 50%; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);" do %>
      <i class="bi bi-bell fs-4"></i>
      <% if unread_count > 0 %>
        <span class="badge bg-danger position-absolute" style="top: -5px; right: -5px; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem;">
          <%= unread_count %>
        </span>
      <% end %>
    <% end %>
  </div>

<!-- Hero Section - Style Carnet d'Architecte avec grille intégrée -->
<div class="architectural-hero position-relative d-flex min-vh-100"
     data-controller="architectural-parallax"
     data-architectural-parallax-hero-target="hero">

  <!-- Image de fond directe -->
  <img src="<%= asset_path('arcliine.jpg') %>"
       alt="Architectural watercolor background"
       class="architectural-bg-image">

  <!-- Overlay léger pour la lisibilité -->
  <div class="architectural-overlay"></div>

  <!-- Sketch Overlay avec effet parallax -->
  <div class="sketch-overlay position-absolute w-100 h-100">
    <div class="blueprint-grid"></div>
    <div class="technical-lines"></div>
  </div>

  <!-- Titre et statistiques -->
  <div class="container position-relative d-flex flex-column justify-content-start align-items-center pt-5">
    <div class="architectural-content text-center mb-5">

      <h1 class="architectural-title display-4 mb-4">
        <i class="bi bi-house-gear me-3"></i>
        Bonjour <span class="highlight-watercolor"><%= current_user.first_name || current_user.email.split('@').first.capitalize %></span>
      </h1>

      <div class="subtitle-sketch mb-4">
        <p class="architect-subtitle">
          Guide d'utilisation Ren0vate<br>
          Suivez ce parcours pour optimiser vos rénovations et investissements
        </p>
        <div class="sketch-underline"></div>
      </div>

    </div>

    <!-- Annonce Évolution -->
    <div class="alert alert-success text-center mx-auto mb-5" style="max-width: 800px;">
      <h5 class="mb-2">
        <i class="bi bi-rocket-takeoff me-2"></i>
        <strong>Ren0vate évolue vers une plateforme complète de gestion de rénovation !</strong>
      </h5>
      <p class="mb-2">
        Nouvelles fonctionnalités disponibles progressivement d'ici <strong>fin mars 2026</strong> :
        Import PEB, ROI Calculator, Permis urbanisme, Suivi chantier, Clôture administrative
      </p>
      <small class="text-muted">
        Les étapes marquées "🚧 À venir" seront activées au fur et à mesure du développement
      </small>
    </div>

    <!-- Guide d'utilisation progressif - Phase 1 : Configuration -->
    <div class="container-fluid px-0 mb-4">
      <div class="text-center mb-3">
        <h4 class="text-primary">
          <i class="bi bi-1-circle-fill me-2"></i>
          Phase 1 : Configuration
        </h4>
        <p class="text-muted">✅ Disponible maintenant - Commencez par créer votre profil et enregistrer vos biens</p>
      </div>
      <div class="row g-3 justify-content-center" style="z-index: 1001; position: relative;">

        <!-- Étape 1 : Mon profil -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">01</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-secondary compact-dashboard">
                <div class="card-body p-4 text-center">
                  <div class="feature-icon-compact mb-3">
                    <i class="bi bi-person-gear text-secondary"></i>
                  </div>
                  <h5 class="feature-title-compact mb-3 text-secondary">
                    1. Créez votre profil
                    <span class="badge bg-success ms-2">✅ Actif</span>
                  </h5>
                  <p class="feature-description-compact mb-3">
                    Commencez par configurer vos informations personnelles et préférences.
                    Un profil complet vous permettra de recevoir des conseils personnalisés et d'accéder à votre calcul d'éligibilité des aides.
                  </p>
                  <div class="feature-stats-compact mb-3">
                    <span class="badge bg-secondary-subtle text-secondary">
                      <i class="bi bi-arrow-right me-1"></i>Une fois créé, passez à l'enregistrement de votre bien
                    </span>
                  </div>
                <%= link_to profile_path, class: "btn btn-secondary" do %>
                  <i class="bi bi-gear me-2"></i>Configurer mon profil
                <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Étape 2 : Mes biens -->
          <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
            <div class="margin-note">02</div>
            <div class="annotated-section">
              <div class="card border-0 h-100 feature-card feature-card-success compact-dashboard">
                <div class="card-body p-4 text-center">
                  <div class="feature-icon-compact mb-3">
                    <i class="bi bi-house text-success"></i>
                  </div>
                  <h5 class="feature-title-compact mb-3 text-success">
                    2. Enregistrez vos biens
                    <span class="badge bg-success ms-2">✅ Actif</span>
                  </h5>
                  <p class="feature-description-compact mb-3">
                    Ajoutez vos propriétés à rénover (Flandre/Bruxelles/Wallonie) ou votre siège social et d'exploitation
                    pour vos entreprises à Bruxelles. Chaque bien a ses aides spécifiques.
                  </p>
                  <div class="feature-stats-compact mb-3">
                    <span class="badge bg-success-subtle text-success">
                      <i class="bi bi-arrow-right me-1"></i>Ensuite, créez la base de votre chantier
                    </span>
                  </div>
                  <%= link_to properties_path, class: "btn btn-success" do %>
                    <i class="bi bi-plus-circle me-2"></i>Gérer mes biens
                  <% end %>
                </div>
              </div>
            </div>
          </div>

      </div>
    </div>

    <!-- Phase 2 : Simulation énergétique et financement -->
    <div class="container-fluid px-0 mb-4">
      <div class="text-center mb-3">
        <h4 class="text-purple">
          <i class="bi bi-2-circle-fill me-2"></i>
          Phase 2 : Simulation énergétique et financement
        </h4>
        <p class="text-muted">✅ Partiellement disponible - Nouvelles fonctionnalités en cours de développement</p>
      </div>
      <div class="row g-3 justify-content-center" style="z-index: 1001; position: relative;">

        <!-- Étape 3 : Chantiers -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">03</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-purple compact-dashboard">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-tools text-purple"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-purple">
                  3. Créez vos projets
                  <span class="badge bg-success ms-2">Actif</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  Définissez la base de votre chantier de rénovation en Belgique.
                  Cette étape structure votre projet et active vos simulations.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-purple-subtle text-purple">
                    <i class="bi bi-arrow-right me-1"></i>Puis dirigez-vous vers les simulations
                  </span>
                </div>
                <%= link_to projects_path, class: "btn btn-purple" do %>
                  <i class="bi bi-plus-circle me-2"></i>Créer un projet
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 4a : Import PEB/Audit -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">04a</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-warning compact-dashboard" style="opacity: 0.85;">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-file-earmark-bar-graph text-warning"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-warning">
                  4a. Import PEB/Audit énergétique
                  <span class="badge bg-warning ms-2">🚧 Mars 2026</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  <strong>À venir :</strong> Upload certificat PEB ou audit (40 pages), extraction automatique données clés,
                  génération roadmap évolution label (F→B), timeline conformité réglementaire.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-warning-subtle text-warning">
                    <i class="bi bi-sparkles me-1"></i>ROI Calculator + Priorisation travaux
                  </span>
                </div>
                <button class="btn btn-warning" disabled>
                  <i class="bi bi-upload me-2"></i>En développement
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 4b : Simulations -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">04b</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-primary compact-dashboard">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-calculator text-primary"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-primary">
                  4b. Simulation primes/prêts
                  <span class="badge bg-success ms-2">Actif</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  Calculez vos aides disponibles selon région.
                  <strong>Bientôt :</strong> ROI Calculator complet, comparaison scénarios, intégration recommandations PEB.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-primary-subtle text-primary">
                    <i class="bi bi-arrow-right me-1"></i>Ceci active votre espace technique
                  </span>
                </div>
                <%= link_to simulations_path, class: "btn btn-primary" do %>
                  <i class="bi bi-calculator me-2"></i>Lancer une simulation
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- ROI Calculator Badge -->
        <div class="col-12 text-center">
          <div class="alert alert-info d-inline-block">
            <i class="bi bi-info-circle me-2"></i>
            <strong>ROI Calculator complet</strong> : Projections 20 ans, économies énergétiques, valorisation immobilière - <strong>Mars 2026</strong>
          </div>
        </div>

      </div>
    </div>

    <!-- Phase 3 : Préparation chantier -->
    <div class="container-fluid px-0 mb-4">
      <div class="text-center mb-3">
        <h4 class="text-success">
          <i class="bi bi-3-circle-fill me-2"></i>
          Phase 3 : Préparation chantier
        </h4>
        <p class="text-muted">🚧 Nouvelles fonctionnalités - Disponibles progressivement d'ici fin mars 2026</p>
      </div>
      <div class="row g-3 justify-content-center" style="z-index: 1001; position: relative;">

        <!-- Étape 5 : Gestion documentaire -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">05</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-info compact-dashboard">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-folder text-info"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-info">
                  5. Gestion documentaire
                  <span class="badge bg-success ms-2">Actif</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  Organisez tous vos documents (devis, factures, certificats).
                  <strong>Bientôt :</strong> Checklist conformité, validation automatique, archivage horodaté.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-info-subtle text-info">
                    <i class="bi bi-folder-check me-1"></i>Classement intelligent par phase
                  </span>
                </div>
                <%= link_to documents_path, class: "btn btn-info" do %>
                  <i class="bi bi-upload me-2"></i>Gérer mes documents
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 6 : Permis urbanisme -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">06</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-warning compact-dashboard" style="opacity: 0.85;">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-building-check text-warning"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-warning">
                  6. Permis d'urbanisme
                  <span class="badge bg-warning ms-2">🚧 Mars 2026</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  <strong>À venir :</strong> Évaluation nécessité permis, checklist documents par commune,
                  génération formulaires, suivi instruction, alertes deadlines.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-warning-subtle text-warning">
                    <i class="bi bi-calendar-check me-1"></i>Timeline automatique + Notifications
                  </span>
                </div>
                <button class="btn btn-warning" disabled>
                  <i class="bi bi-file-earmark-text me-2"></i>En développement
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 7 : Comparateur entrepreneurs -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">07</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-warning compact-dashboard" style="opacity: 0.85;">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-people text-warning"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-warning">
                  7. Comparateur entrepreneurs
                  <span class="badge bg-warning ms-2">🚧 Mars 2026</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  <strong>À venir :</strong> Base entrepreneurs, demandes devis multiples,
                  comparaison automatique, vérification assurances/certifications BCE.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-warning-subtle text-warning">
                    <i class="bi bi-shield-check me-1"></i>Validation conformité automatique
                  </span>
                </div>
                <button class="btn btn-warning" disabled>
                  <i class="bi bi-search me-2"></i>En développement
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 8 : Comparateur produits énergétiques -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">08</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-warning compact-dashboard" style="opacity: 0.85;">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-layers text-warning"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-warning">
                  8. Comparateur produits
                  <span class="badge bg-warning ms-2">🚧 Mars 2026</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  <strong>À venir :</strong> Comparez isolations, châssis, chaudières, PAC, ventilation, régulation.
                  Critères techniques, prix, ROI, impact environnemental. Choix éclairé pour néophytes.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-warning-subtle text-warning">
                    <i class="bi bi-bar-chart me-1"></i>Comparaison multicritères + Recommandations
                  </span>
                </div>
                <button class="btn btn-warning" disabled>
                  <i class="bi bi-box-seam me-2"></i>En développement
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 9 : Planificateur budgétaire -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">09</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-warning compact-dashboard" style="opacity: 0.85;">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-cash-coin text-warning"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-warning">
                  9. Planificateur budgétaire
                  <span class="badge bg-warning ms-2">🚧 Mars 2026</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  <strong>À venir :</strong> Simulation coûts temps réel, alertes dépassements,
                  intégration prêts/primes, suivi budget vs réalisé.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-warning-subtle text-warning">
                    <i class="bi bi-graph-up me-1"></i>Dashboard financier complet
                  </span>
                </div>
                <button class="btn btn-warning" disabled>
                  <i class="bi bi-calculator me-2"></i>En développement
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Phase 4 : Espace technique -->
    <div class="container-fluid px-0 mb-4">
      <div class="text-center mb-3">
        <h4 class="text-info">
          <i class="bi bi-4-circle-fill me-2"></i>
          Phase 4 : Espace technique
        </h4>
        <p class="text-muted">✅ Disponible maintenant - Conseils personnalisés et organisation</p>
      </div>
      <div class="row g-3 justify-content-center" style="z-index: 1001; position: relative;">

        <!-- Étape 10 : Decision Hub -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">10</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-gradient compact-dashboard">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-robot text-info"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-info">
                  10. Decision Hub
                  <span class="badge bg-success ms-2">✅ Actif</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  Assistant IA pour conseils techniques, analyse devis/factures,
                  résumé simulations, timing à respecter, documents à collecter.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-info-subtle text-info">
                    <i class="bi bi-chat-dots me-1"></i>Conseils personnalisés en temps réel
                  </span>
                </div>
                <%= link_to decision_hub_index_path, class: "btn btn-gradient" do %>
                  <i class="bi bi-robot me-2"></i>Accéder au Decision Hub
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 11 : Documents -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">11</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-info compact-dashboard">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-folder text-info"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-info">
                  11. Gestion documentaire
                  <span class="badge bg-success ms-2">✅ Actif</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  Organisez devis, factures, plans, certificats.
                  <strong>Bientôt :</strong> Extraction OCR avancée, archivage horodaté sécurisé.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-info-subtle text-info">
                    <i class="bi bi-folder-check me-1"></i>Classement intelligent par projet
                  </span>
                </div>
                <%= link_to documents_path, class: "btn btn-info" do %>
                  <i class="bi bi-upload me-2"></i>Gérer mes documents
                <% end %>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Phase 5 : Suivi chantier -->
    <div class="container-fluid px-0 mb-4">
      <div class="text-center mb-3">
        <h4 class="text-danger">
          <i class="bi bi-5-circle-fill me-2"></i>
          Phase 5 : Suivi chantier
        </h4>
        <p class="text-muted">🚧 Nouvelles fonctionnalités - Mars 2026</p>
      </div>
      <div class="row g-3 justify-content-center" style="z-index: 1001; position: relative;">

        <!-- Étape 12 : Assistant conformité -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">12</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-warning compact-dashboard" style="opacity: 0.85;">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-shield-check text-warning"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-warning">
                  12. Assistant conformité
                  <span class="badge bg-warning ms-2">🚧 Mars 2026</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  <strong>À venir :</strong> Vérification conformité normes (RGIE, thermique),
                  validation certifications entrepreneurs, alertes inspections obligatoires.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-warning-subtle text-warning">
                    <i class="bi bi-check-square me-1"></i>Checklist automatique par phase
                  </span>
                </div>
                <button class="btn btn-warning" disabled>
                  <i class="bi bi-shield me-2"></i>En développement
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 13 : État d'avancement -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">13</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-warning compact-dashboard" style="opacity: 0.85;">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-graph-up text-warning"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-warning">
                  13. État d'avancement
                  <span class="badge bg-warning ms-2">🚧 Mars 2026</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  <strong>À venir :</strong> Suivi % avancement par phase chantier,
                  photos horodatées, notifications retards, timeline visuelle.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-warning-subtle text-warning">
                    <i class="bi bi-calendar-event me-1"></i>Dashboard temps réel + Photos
                  </span>
                </div>
                <button class="btn btn-warning" disabled>
                  <i class="bi bi-bar-chart me-2"></i>En développement
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Phase 6 : Administration & Clôture -->
    <div class="container-fluid px-0 mb-4">
      <div class="text-center mb-3">
        <h4 class="text-dark">
          <i class="bi bi-6-circle-fill me-2"></i>
          Phase 6 : Administration & Clôture
        </h4>
        <p class="text-muted">Finalisez votre projet et sécurisez vos aides</p>
      </div>
      <div class="row g-3 justify-content-center" style="z-index: 1001; position: relative;">

        <!-- Étape 14 : Formulaires demandes -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">14</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-dark compact-dashboard">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-file-earmark-check text-dark"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-dark">
                  14. Formulaires & Suivi
                  <span class="badge bg-success ms-2">✅ Actif</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  Préparez formulaires primes/prêts, validez données, suivez avancement administratif.
                  <strong>Bientôt :</strong> Pré-remplissage automatique depuis simulations.
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-dark-subtle text-dark">
                    <i class="bi bi-journal-check me-1"></i>Visualisation formulaires officiels
                  </span>
                </div>
                <%= link_to requests_path, class: "btn btn-dark" do %>
                  <i class="bi bi-journal-text me-2"></i>Gérer mes demandes
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Étape 15 : Checklist clôture -->
        <div class="col-xl-6 col-lg-6 col-md-6 position-relative">
          <div class="margin-note">15</div>
          <div class="annotated-section">
            <div class="card border-0 h-100 feature-card feature-card-warning compact-dashboard" style="opacity: 0.85;">
              <div class="card-body p-4 text-center">
                <div class="feature-icon-compact mb-3">
                  <i class="bi bi-check2-all text-warning"></i>
                </div>
                <h5 class="feature-title-compact mb-3 text-warning">
                  15. Checklist clôture
                  <span class="badge bg-warning ms-2">🚧 Mars 2026</span>
                </h5>
                <p class="feature-description-compact mb-3">
                  <strong>À venir :</strong> Vérification réception travaux, validation paiements,
                  constitution dossier garanties, archivage certifications (PEB, RGIE, audits).
                </p>
                <div class="feature-stats-compact mb-3">
                  <span class="badge bg-warning-subtle text-warning">
                    <i class="bi bi-archive me-1"></i>Dossier final sécurisé 10 ans
                  </span>
                </div>
                <button class="btn btn-warning" disabled>
                  <i class="bi bi-list-check me-2"></i>En développement
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>


  </div>
</div>

