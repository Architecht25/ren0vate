<%
  set_seo_meta(
    title: "Tableau de bord - Ren0vate",
    description: "Votre assistant IA expert en rénovation — gérez vos projets, primes et chantiers depuis votre tableau de bord",
    keywords: ["dashboard", "tableau de bord", "assistant IA", "primes rénovation", "gestion chantier"]
  )

  # Complétude des données pour l'IA
  has_profile    = current_user.first_name.present? && current_user.region.present?
  has_property   = @properties.any?
  first_property = @properties.first
  has_simulation = (current_user.simulations.any? rescue false)
  simulation_count = (current_user.simulations.count rescue 0)
  project_count    = (current_user.projects.count rescue 0)
  has_project   = project_count > 0
  property_count   = @total_properties

  ia_steps_done = [has_profile, has_property, has_project, has_simulation].count(true)
  ia_ready      = ia_steps_done == 4
  next_step     = !has_profile ? :profile : !has_property ? :property : !has_project ? :project : !has_simulation ? :simulation : nil
%>

<!-- Widget Notifications -->
<div class="notification-widget position-fixed d-none d-md-block" style="top: 80px; right: 20px; z-index: 2000;">
  <% unread_count = current_user.respond_to?(:notifications) ? current_user.notifications.unread.count : 0 %>
  <%= link_to notifications_path, class: "btn btn-outline-primary position-relative notification-widget-btn", style: "border-radius: 50%; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);" do %>
    <i class="bi bi-bell fs-4"></i>
    <% if unread_count > 0 %>
      <span class="badge bg-danger position-absolute" style="top: -5px; right: -5px; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem;"><%= unread_count %></span>
    <% end %>
  <% end %>
</div>

<!-- Hero Section -->
<div class="architectural-hero position-relative"
     data-controller="architectural-parallax"
     data-architectural-parallax-hero-target="hero"
     style="min-height: 100vh;">

  <img src="<%= asset_path('arcliine.jpg') %>" alt=""
       class="architectural-bg-image"
       style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.2; z-index: 0;">
  <div class="architectural-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.3); z-index: 1;"></div>
  <div class="sketch-overlay position-absolute w-100 h-100" style="top: 0; left: 0; z-index: 2;">
    <div class="blueprint-grid"></div>
    <div class="technical-lines"></div>
  </div>

  <div class="container position-relative d-flex flex-column justify-content-center align-items-center py-5" style="z-index: 3; min-height: 100vh;">

    <!-- Greeting -->
    <div class="text-center mb-5">
      <h1 class="architectural-title display-4 mb-2">
        <i class="bi bi-house-gear me-3"></i>
        Bonjour <span class="highlight-watercolor"><%= current_user.first_name || current_user.email.split('@').first.capitalize %></span>
      </h1>
      <p class="text-muted" style="font-size: 1.05rem;">
        <% if ia_ready %>
          Votre assistant IA est connecté à toutes vos données et prêt à vous répondre
        <% else %>
          <strong>5 minutes suffisent</strong> pour activer votre assistant IA personnalisé
        <% end %>
      </p>
    </div>

    <!-- ===== SITUATION ACTUELLE ===== -->
    <div class="mx-auto w-100 mb-4" style="max-width: 780px;">
      <div class="rounded-4 overflow-hidden" style="background: var(--ren0vate-white); box-shadow: var(--ren0vate-shadow-lg); border: 1px solid var(--ren0vate-border);">

        <!-- Header -->
        <div class="p-4 text-white" style="background: linear-gradient(135deg, var(--ren0vate-primary) 0%, var(--ren0vate-success-dark) 100%);">
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:56px; height:56px; background: rgba(255,255,255,0.2); font-size: 1.7rem;">
              <i class="bi bi-speedometer2"></i>
            </div>
            <div class="flex-grow-1">
              <h4 class="mb-1 fw-bold" style="color: var(--ren0vate-accent);">Situation actuelle</h4>
              <p class="mb-0 opacity-90" style="font-size: 0.9rem;">
                Budget engagé, primes attendues et alertes en cours sur vos chantiers
              </p>
            </div>
            <% if @alerts.any? %>
              <span class="badge fs-6 fw-normal px-3 py-2 flex-shrink-0" style="background: rgba(255,255,255,0.2);">
                <i class="bi bi-bell-fill me-1"></i><%= @alerts.count %> alerte<%= @alerts.count > 1 ? 's' : '' %>
              </span>
            <% end %>
          </div>
        </div>

        <!-- KPIs -->
        <div class="px-4 py-3">
          <div class="row g-2">

            <div class="col-6 col-md-3">
              <div class="rounded-3 p-3 text-center" style="background: var(--ren0vate-light); border: 1px solid var(--ren0vate-border);">
                <div class="small mb-1" style="color: var(--ren0vate-text-muted); font-size: 0.75rem;"><i class="bi bi-hammer me-1"></i>Budget engagé</div>
                <div class="fw-bold" style="font-size: 1.1rem; color: var(--ren0vate-primary);">
                  <% if @budget_total > 0 %><%= number_with_delimiter(@budget_total, delimiter: ' ') %> €<% else %>—<% end %>
                </div>
              </div>
            </div>

            <div class="col-6 col-md-3">
              <div class="rounded-3 p-3 text-center" style="background: rgba(var(--ren0vate-success-rgb), 0.08); border: 1px solid rgba(var(--ren0vate-success-rgb), 0.25);">
                <div class="small mb-1" style="color: var(--ren0vate-text-muted); font-size: 0.75rem;"><i class="bi bi-gift me-1"></i>Primes attendues</div>
                <div class="fw-bold" style="font-size: 1.1rem; color: var(--ren0vate-success-dark);">
                  <% if @primes_attendues > 0 %><%= number_with_delimiter(@primes_attendues, delimiter: ' ') %> €<% else %>—<% end %>
                </div>
              </div>
            </div>

            <div class="col-6 col-md-3">
              <div class="rounded-3 p-3 text-center" style="background: <%= @factures_en_attente_count > 0 ? 'rgba(var(--ren0vate-accent-rgb), 0.07)' : 'var(--ren0vate-light)' %>; border: 1px solid <%= @factures_en_attente_count > 0 ? 'rgba(var(--ren0vate-accent-rgb), 0.3)' : 'var(--ren0vate-border)' %>;">
                <div class="small mb-1" style="color: var(--ren0vate-text-muted); font-size: 0.75rem;"><i class="bi bi-receipt me-1"></i>Factures en attente</div>
                <div class="fw-bold d-flex align-items-center justify-content-center gap-1" style="font-size: 1.1rem; color: <%= @factures_en_attente_count > 0 ? 'var(--ren0vate-accent)' : 'var(--ren0vate-primary)' %>;">
                  <%= @factures_en_attente_count %>
                  <% if @factures_en_attente_count > 0 %><i class="bi bi-exclamation-circle-fill" style="font-size: 0.75rem;"></i><% end %>
                </div>
              </div>
            </div>

            <div class="col-6 col-md-3">
              <div class="rounded-3 p-3 text-center" style="background: var(--ren0vate-light); border: 1px solid var(--ren0vate-border);">
                <div class="small mb-1" style="color: var(--ren0vate-text-muted); font-size: 0.75rem;"><i class="bi bi-buildings me-1"></i>Chantiers actifs</div>
                <div class="fw-bold" style="font-size: 1.1rem; color: var(--ren0vate-primary);"><%= project_count %></div>
              </div>
            </div>

          </div>
        </div>

        <!-- Alertes -->
        <% if @alerts.any? %>
          <div class="mx-4 mb-3" style="border-top: 1px solid var(--ren0vate-border);"></div>
          <div class="px-4 pb-3 d-flex flex-column gap-2">
            <% @alerts.each do |alert| %>
              <% urgent = alert[:level] == :urgent %>
              <div class="d-flex align-items-center gap-3 px-3 py-2 rounded-3"
                   style="background: <%= urgent ? 'rgba(239,68,68,0.05)' : 'rgba(249,115,22,0.05)' %>; border-left: 3px solid <%= urgent ? '#ef4444' : '#f97316' %>; border: 1px solid <%= urgent ? 'rgba(239,68,68,0.2)' : 'rgba(249,115,22,0.2)' %>; border-left: 3px solid <%= urgent ? '#ef4444' : '#f97316' %>;">
                <i class="bi bi-<%= urgent ? 'exclamation-circle-fill' : 'exclamation-triangle-fill' %> flex-shrink-0"
                   style="color: <%= urgent ? '#ef4444' : '#f97316' %>; font-size: 0.95rem;"></i>
                <span class="flex-grow-1 small" style="color: var(--ren0vate-text-secondary);"><%= alert[:message] %></span>
                <%= link_to project_path(alert[:project]), class: "btn btn-sm flex-shrink-0 fw-semibold", style: "color: var(--ren0vate-primary); font-size: 0.75rem; padding: 2px 10px; background: rgba(var(--ren0vate-primary-rgb), 0.07); border: 1px solid rgba(var(--ren0vate-primary-rgb), 0.2);" do %>
                  Voir <i class="bi bi-arrow-right ms-1"></i>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

      </div>
    </div>

    <!-- ===== MAIN IA CARD ===== -->
    <div class="mx-auto w-100 mb-4" style="max-width: 780px;">
      <div class="rounded-4 overflow-hidden" style="background: var(--ren0vate-white); box-shadow: var(--ren0vate-shadow-lg); border: 1px solid var(--ren0vate-border);">

        <!-- Header gradient -->
        <div class="p-4 text-white" style="background: linear-gradient(135deg, var(--ren0vate-primary) 0%, var(--ren0vate-success-dark) 100%);">
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:56px; height:56px; background: rgba(255,255,255,0.2); font-size: 1.7rem;">
              <i class="bi bi-robot"></i>
            </div>
            <div class="flex-grow-1">
              <h4 class="mb-1 fw-bold" style="color: var(--ren0vate-accent);">Expert IA Ren0vate</h4>
              <p class="mb-0 opacity-90" style="font-size: 0.9rem;">
                Connecté à toutes vos données — primes, chantiers, financements, réglementations
              </p>
            </div>
            <% if ia_ready %>
              <span class="badge fs-6 fw-normal px-3 py-2 flex-shrink-0"
                    style="background: rgba(255,255,255,0.2);">
                <i class="bi bi-check2-circle me-1"></i>Prêt
              </span>
            <% else %>
              <span class="badge fs-6 fw-normal px-3 py-2 flex-shrink-0"
                    style="background: rgba(255,255,255,0.15);">
                <%= ia_steps_done %>/4 données renseignées
              </span>
            <% end %>
          </div>
        </div>

        <!-- Data sources bar -->
        <div class="px-4 py-3 d-flex gap-3 flex-wrap align-items-center" style="background: var(--ren0vate-light); border-bottom: 1px solid var(--ren0vate-border);">
          <span class="small fw-medium me-1" style="color: var(--ren0vate-text-muted);">Sources connectées :</span>

          <span class="d-flex align-items-center gap-1 small">
            <% if has_profile %>
              <i class="bi bi-check-circle-fill" style="color: var(--ren0vate-success-dark);"></i>
              <span class="fw-medium" style="color: var(--ren0vate-success-dark);">Profil</span>
            <% else %>
              <i class="bi bi-dash-circle" style="color: var(--ren0vate-accent);"></i>
              <span class="fw-medium" style="color: var(--ren0vate-accent);">Profil</span>
            <% end %>
          </span>

          <span style="color: var(--ren0vate-border-dark);">·</span>

          <span class="d-flex align-items-center gap-1 small">
            <% if has_property %>
              <i class="bi bi-check-circle-fill" style="color: var(--ren0vate-success-dark);"></i>
              <span class="fw-medium" style="color: var(--ren0vate-success-dark);"><%= property_count %> bien<%= property_count > 1 ? 's' : '' %></span>
            <% else %>
              <i class="bi bi-dash-circle" style="color: var(--ren0vate-accent);"></i>
              <span class="fw-medium" style="color: var(--ren0vate-accent);">Aucun bien</span>
            <% end %>
          </span>

          <span style="color: var(--ren0vate-border-dark);">·</span>

          <span class="d-flex align-items-center gap-1 small">
            <% if has_project %>
              <i class="bi bi-check-circle-fill" style="color: var(--ren0vate-success-dark);"></i>
              <span class="fw-medium" style="color: var(--ren0vate-success-dark);"><%= project_count %> chantier<%= project_count > 1 ? 's' : '' %></span>
            <% else %>
              <i class="bi bi-dash-circle" style="color: var(--ren0vate-accent);"></i>
              <span class="fw-medium" style="color: var(--ren0vate-accent);">Aucun chantier</span>
            <% end %>
          </span>

          <span style="color: var(--ren0vate-border-dark);">·</span>

          <span class="d-flex align-items-center gap-1 small">
            <% if has_simulation %>
              <i class="bi bi-check-circle-fill" style="color: var(--ren0vate-success-dark);"></i>
              <span class="fw-medium" style="color: var(--ren0vate-success-dark);"><%= simulation_count %> simulation<%= simulation_count > 1 ? 's' : '' %> primes</span>
            <% else %>
              <i class="bi bi-dash-circle" style="color: var(--ren0vate-accent);"></i>
              <span class="fw-medium" style="color: var(--ren0vate-accent);">Aucune simulation</span>
            <% end %>
          </span>
        </div>

        <!-- Card body -->
        <div class="p-4">
          <% if ia_ready %>
            <%# Toutes les données sont là - montrer le CTA principal %>
            <p class="mb-4" style="font-size: 0.95rem; color: var(--ren0vate-text-secondary);">
              L'assistant connaît <strong>votre profil</strong>, <strong>vos biens</strong>, <strong>vos chantiers</strong> et <strong>vos simulations de primes</strong>.
              Posez-lui n'importe quelle question : montants de primes, travaux prioritaires, démarches administratives,
              prêts disponibles, ou prochaine étape de votre projet.
            </p>

            <!-- Deux modes d'accès à l'IA -->
            <div class="row g-3 mb-3">

              <!-- Vue d'ensemble -->
              <div class="col-md-6">
                <div class="rounded-3 p-3 h-100 d-flex flex-column"
                     style="background: rgba(var(--ren0vate-success-rgb), 0.1); border: 1.5px solid rgba(var(--ren0vate-success-rgb), 0.45);">
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-layers fs-5" style="color: var(--ren0vate-primary);"></i>
                    <span class="fw-semibold" style="color: var(--ren0vate-primary);">Vue d'ensemble</span>
                  </div>
                  <p class="small mb-3 flex-grow-1" style="color: var(--ren0vate-text-muted);">
                    Questions transversales sur <strong>tous vos biens</strong> : priorisation patrimoine, comparaison primes, stratégie globale.
                  </p>
                  <%= link_to expert_decision_hub_index_path(all: 1), class: "btn btn-ren0vate fw-semibold w-100" do %>
                    <i class="bi bi-chat-dots-fill me-2"></i>Tous mes biens
                  <% end %>
                </div>
              </div>

              <!-- Bien spécifique -->
              <div class="col-md-6">
                <div class="rounded-3 p-3 h-100 d-flex flex-column"
                     style="background: rgba(var(--ren0vate-primary-rgb), 0.05); border: 1.5px solid rgba(var(--ren0vate-primary-rgb), 0.2);">
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-house-door fs-5" style="color: var(--ren0vate-info);"></i>
                    <span class="fw-semibold" style="color: var(--ren0vate-info);">Bien spécifique</span>
                  </div>
                  <p class="small mb-3 flex-grow-1" style="color: var(--ren0vate-text-muted);">
                    Questions ciblées sur <strong>un bien précis</strong> : primes détaillées, chantiers, PEB, documents, intervenants.
                  </p>
                  <%= link_to expert_decision_hub_index_path, class: "btn btn-primary fw-semibold w-100" do %>
                    <i class="bi bi-arrow-right-circle me-2"></i>Choisir un bien
                  <% end %>
                </div>
              </div>

            </div>


          <% else %>
            <%# Données manquantes - afficher la checklist %>

            <!-- Bandeau motivation -->
            <div class="d-flex align-items-start gap-3 p-3 rounded-3 mb-4"
                 style="background: rgba(var(--ren0vate-accent-rgb), 0.07); border: 1.5px solid rgba(var(--ren0vate-accent-rgb), 0.25);">
              <i class="bi bi-lightning-charge-fill fs-5 flex-shrink-0 mt-1" style="color: var(--ren0vate-accent);"></i>
              <div style="font-size: 0.9rem; color: var(--ren0vate-text-secondary);">
                En <strong>5 minutes</strong>, l'assistant IA sera calibré sur votre situation et pourra calculer vos <strong>primes exactes</strong>, identifier vos <strong>travaux prioritaires</strong> et vous guider à chaque étape de votre chantier.
              </div>
            </div>

            <!-- Barre de progression -->
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="small fw-semibold" style="color: var(--ren0vate-text-secondary);">
                <% case ia_steps_done
                   when 0 then %>Démarrons ensemble
                <% when 1 then %>Bon début, continuez !
                <% when 2 then %>Vous y êtes presque…
                <% when 3 then %>Plus qu'une étape !
                <% end %>
              </span>
              <span class="small" style="color: var(--ren0vate-text-muted);"><%= ia_steps_done %>/4 complétées</span>
            </div>
            <div class="progress mb-4" style="height: 7px; border-radius: 4px; background: var(--ren0vate-border);">
              <div class="progress-bar" role="progressbar"
                   style="width: <%= ia_steps_done * 25 %>%; background: var(--ren0vate-success-dark); border-radius: 4px;"
                   aria-valuenow="<%= ia_steps_done * 25 %>" aria-valuemin="0" aria-valuemax="100"></div>
            </div>

            <div class="d-flex flex-column gap-2 mb-4">

              <!-- Étape 1 : Profil -->
              <div class="d-flex align-items-center gap-3 p-3 rounded-3"
                   style="background: <%= has_profile ? 'rgba(var(--ren0vate-success-rgb), 0.1)' : 'rgba(var(--ren0vate-accent-rgb), 0.07)' %>; border: <%= next_step == :profile ? '2px solid var(--ren0vate-accent)' : has_profile ? '1px solid rgba(var(--ren0vate-success-rgb), 0.4)' : '1px solid rgba(var(--ren0vate-accent-rgb), 0.35)' %>;">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                     style="width:34px; height:34px; font-size:0.85rem; min-width:34px; background: <%= has_profile ? 'var(--ren0vate-success-dark)' : 'var(--ren0vate-accent)' %>;">
                  <%= has_profile ? '✓' : '1' %>
                </div>
                <div class="flex-grow-1">
                  <div class="fw-semibold small d-flex align-items-center gap-2" style="color: <%= has_profile ? 'var(--ren0vate-success-dark)' : 'var(--ren0vate-accent-dark)' %>;">
                    Complétez votre profil
                    <% if has_profile %>
                      <span class="fw-normal" style="color: var(--ren0vate-success-dark);">— fait</span>
                    <% elsif next_step == :profile %>
                      <span class="badge fw-normal" style="background: var(--ren0vate-accent); font-size: 0.7rem;">→ À faire maintenant</span>
                    <% end %>
                  </div>
                  <div style="font-size: 0.8rem; color: var(--ren0vate-text-muted);">Région, revenus, situation — débloque le calcul exact de vos primes &nbsp;<span class="text-nowrap"><i class="bi bi-clock" style="font-size:0.7rem;"></i> ~2 min</span></div>
                </div>
                <% unless has_profile %>
                  <%= link_to edit_user_registration_path, class: "btn btn-sm btn-accent-ren0vate fw-semibold flex-shrink-0" do %>
                    <i class="bi bi-pencil me-1"></i>Compléter
                  <% end %>
                <% end %>
              </div>

              <!-- Étape 2 : Bien -->
              <div class="d-flex align-items-center gap-3 p-3 rounded-3"
                   style="background: <%= has_property ? 'rgba(var(--ren0vate-success-rgb), 0.1)' : 'rgba(var(--ren0vate-accent-rgb), 0.07)' %>; border: <%= next_step == :property ? '2px solid var(--ren0vate-accent)' : has_property ? '1px solid rgba(var(--ren0vate-success-rgb), 0.4)' : '1px solid rgba(var(--ren0vate-accent-rgb), 0.35)' %>;">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                     style="width:34px; height:34px; font-size:0.85rem; min-width:34px; background: <%= has_property ? 'var(--ren0vate-success-dark)' : 'var(--ren0vate-accent)' %>;">
                  <%= has_property ? '✓' : '2' %>
                </div>
                <div class="flex-grow-1">
                  <div class="fw-semibold small d-flex align-items-center gap-2" style="color: <%= has_property ? 'var(--ren0vate-success-dark)' : 'var(--ren0vate-accent-dark)' %>;">
                    Ajoutez votre bien
                    <% if has_property %>
                      <span class="fw-normal" style="color: var(--ren0vate-success-dark);">— <%= property_count %> bien<%= property_count > 1 ? 's' : '' %> renseigné<%= property_count > 1 ? 's' : '' %></span>
                    <% elsif next_step == :property %>
                      <span class="badge fw-normal" style="background: var(--ren0vate-accent); font-size: 0.7rem;">→ À faire maintenant</span>
                    <% end %>
                  </div>
                  <div style="font-size: 0.8rem; color: var(--ren0vate-text-muted);">Adresse, type, PEB — l'IA cible vos travaux prioritaires et primes applicables &nbsp;<span class="text-nowrap"><i class="bi bi-clock" style="font-size:0.7rem;"></i> ~2 min</span></div>
                </div>
                <% unless has_property %>
                  <%= link_to new_property_path, class: "btn btn-sm btn-accent-ren0vate fw-semibold flex-shrink-0" do %>
                    <i class="bi bi-plus-circle me-1"></i>Ajouter
                  <% end %>
                <% end %>
              </div>

              <!-- Étape 3 : Chantier -->
              <div class="d-flex align-items-center gap-3 p-3 rounded-3"
                   style="background: <%= has_project ? 'rgba(var(--ren0vate-success-rgb), 0.1)' : 'rgba(var(--ren0vate-accent-rgb), 0.07)' %>; border: <%= next_step == :project ? '2px solid var(--ren0vate-accent)' : has_project ? '1px solid rgba(var(--ren0vate-success-rgb), 0.4)' : '1px solid rgba(var(--ren0vate-accent-rgb), 0.35)' %>;">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                     style="width:34px; height:34px; font-size:0.85rem; min-width:34px; background: <%= has_project ? 'var(--ren0vate-success-dark)' : 'var(--ren0vate-accent)' %>;">
                  <%= has_project ? '✓' : '3' %>
                </div>
                <div class="flex-grow-1">
                  <div class="fw-semibold small d-flex align-items-center gap-2" style="color: <%= has_project ? 'var(--ren0vate-success-dark)' : 'var(--ren0vate-accent-dark)' %>;">
                    Créez un chantier
                    <% if has_project %>
                      <span class="fw-normal" style="color: var(--ren0vate-success-dark);">— <%= project_count %> chantier<%= project_count > 1 ? 's' : '' %> renseigné<%= project_count > 1 ? 's' : '' %></span>
                    <% elsif next_step == :project %>
                      <span class="badge fw-normal" style="background: var(--ren0vate-accent); font-size: 0.7rem;">→ À faire maintenant</span>
                    <% end %>
                  </div>
                  <div style="font-size: 0.8rem; color: var(--ren0vate-text-muted);">Type de travaux, budget — l'IA suit l'avancement et ajuste ses conseils en temps réel &nbsp;<span class="text-nowrap"><i class="bi bi-clock" style="font-size:0.7rem;"></i> ~1 min</span></div>
                </div>
                <% unless has_project %>
                  <%= link_to new_property_path, class: "btn btn-sm btn-accent-ren0vate fw-semibold flex-shrink-0" do %>
                    <i class="bi bi-plus-circle me-1"></i>Créer
                  <% end %>
                <% end %>
              </div>

              <!-- Étape 4 : Simulation primes -->
              <div class="d-flex align-items-center gap-3 p-3 rounded-3"
                   style="background: <%= has_simulation ? 'rgba(var(--ren0vate-success-rgb), 0.1)' : 'rgba(var(--ren0vate-accent-rgb), 0.07)' %>; border: <%= next_step == :simulation ? '2px solid var(--ren0vate-accent)' : has_simulation ? '1px solid rgba(var(--ren0vate-success-rgb), 0.4)' : '1px solid rgba(var(--ren0vate-accent-rgb), 0.35)' %>;">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-bold text-white"
                     style="width:34px; height:34px; font-size:0.85rem; min-width:34px; background: <%= has_simulation ? 'var(--ren0vate-success-dark)' : 'var(--ren0vate-accent)' %>;">
                  <%= has_simulation ? '✓' : '4' %>
                </div>
                <div class="flex-grow-1">
                  <div class="fw-semibold small d-flex align-items-center gap-2" style="color: <%= has_simulation ? 'var(--ren0vate-success-dark)' : 'var(--ren0vate-accent-dark)' %>;">
                    Simulez vos primes régionales
                    <% if has_simulation %><span class="fw-normal" style="color: var(--ren0vate-success-dark);">— <%= simulation_count %> simulation<%= simulation_count > 1 ? 's' : '' %></span>
                    <% elsif next_step == :simulation %><span class="badge fw-normal" style="background: var(--ren0vate-accent); font-size: 0.7rem;">→ À faire maintenant</span><% end %>
                  </div>
                  <div style="font-size: 0.8rem; color: var(--ren0vate-text-muted);">Bruxelles / Wallonie / Flandre — l'IA connaît vos montants et optimise votre dossier de primes &nbsp;<span class="text-nowrap"><i class="bi bi-clock" style="font-size:0.7rem;"></i> quelques secondes</span></div>
                </div>
                <% unless has_simulation %>
                  <%= link_to new_simulation_path, class: "btn btn-sm btn-accent-ren0vate fw-semibold flex-shrink-0" do %>
                    <i class="bi bi-calculator me-1"></i>Simuler
                  <% end %>
                <% end %>
              </div>

            </div>

            <!-- CTA partiel si au moins profil + bien renseignés -->
            <% if has_profile && has_property %>
              <div class="d-flex align-items-center gap-3 flex-wrap pt-1">
                <p class="small mb-0" style="color: var(--ren0vate-text-muted);">Vous pouvez déjà interroger l'IA avec les données disponibles :</p>
                <%= link_to expert_decision_hub_index_path(property_id: first_property.id),
                      class: "btn btn-outline-primary fw-semibold" do %>
                  <i class="bi bi-chat-dots me-2"></i>Consulter quand même
                <% end %>
              </div>
            <% end %>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
