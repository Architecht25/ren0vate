<%
  # Page d'accueil après connexion - Dashboard des fonctionnalités
  # Style architectural en grille 3x3 avec les 9 fonctionnalités principales

  set_seo_meta(
    title: "Tableau de bord - Ren0vate",
    description: "Accédez à toutes vos fonctionnalités Ren0vate depuis votre tableau de bord",
    keywords: ["dashboard", "tableau de bord", "fonctionnalités", "rénovation", "gestion chantier", "suivi travaux"]
  )
%>

  <!-- Widget Notifications en haut à droite -->
  <div class="notification-widget position-fixed" style="top: 80px; right: 20px; z-index: 2000;">
    <% unread_count = current_user.respond_to?(:notifications) ? current_user.notifications.unread.count : 0 %>
    <%= link_to notifications_path, class: "btn btn-outline-primary position-relative notification-widget-btn", style: "border-radius: 50%; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1); background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);" do %>
      <i class="bi bi-bell fs-4"></i>
      <% if unread_count > 0 %>
        <span class="badge bg-danger position-absolute" style="top: -5px; right: -5px; border-radius: 50%; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem;">
          <%= unread_count %>
        </span>
      <% end %>
    <% end %>
  </div>

<!-- Hero Section - Full page avec image background -->
<div class="architectural-hero position-relative"
     data-controller="architectural-parallax"
     data-architectural-parallax-hero-target="hero"
     style="min-height: 100vh;">

  <!-- Image de fond directe avec opacité réduite -->
  <img src="<%= asset_path('arcliine.jpg') %>"
       alt="Architectural watercolor background"
       class="architectural-bg-image"
       style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.2; z-index: 0;">

  <!-- Overlay léger pour la lisibilité -->
  <div class="architectural-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255, 255, 255, 0.3); z-index: 1;"></div>

  <!-- Sketch Overlay avec effet parallax -->
  <div class="sketch-overlay position-absolute w-100 h-100" style="top: 0; left: 0; z-index: 2;">
    <div class="blueprint-grid"></div>
    <div class="technical-lines"></div>
  </div>

  <!-- Contenu positionné par-dessus l'image -->
  <div class="container position-relative d-flex flex-column justify-content-center align-items-center h-100 py-5" style="z-index: 3; min-height: 100vh;">
    <div class="architectural-content text-center mb-4">

      <h1 class="architectural-title display-4 mb-4">
        <i class="bi bi-house-gear me-3"></i>
        Bonjour <span class="highlight-watercolor"><%= current_user.first_name || current_user.email.split('@').first.capitalize %></span>
      </h1>

      <div class="subtitle-sketch mb-4">
        <p class="architect-subtitle">
          Guide d'utilisation Ren0vate<br>
          Suivez ce parcours pour optimiser vos rénovations et investissements
        </p>
        <div class="sketch-underline"></div>
      </div>

    </div>

    <!-- Annonce Évolution -->
    <div class="alert alert-success text-center mx-auto mb-5" style="max-width: 800px;">
      <h5 class="mb-2">
        <i class="bi bi-rocket-takeoff me-2"></i>
        <strong>Ren0vate évolue vers une plateforme complète de gestion de rénovation !</strong>
      </h5>
      <p class="mb-2">
        Nouvelles fonctionnalités disponibles progressivement d'ici <strong>fin mars 2026</strong>
      </p>
      <small class="text-muted">
        Les étapes marquées "Bientôt" seront activées au fur et à mesure
      </small>
    </div>

    <!-- Message d'orientation (sur l'image) -->
    <div class="text-center mx-auto" style="max-width: 700px; background: white; padding: 2rem; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
      <p class="lead mb-4">
        <strong>Ren0vate</strong> est votre partenaire pour gérer vos projets de rénovation de A à Z
      </p>
      <p class="mb-4">
        Utilisez la <strong>sidebar à gauche</strong> pour naviguer entre les différentes fonctionnalités :
      </p>
      <div class="row g-3 text-start">
        <div class="col-md-6">
          <p class="mb-2"><i class="bi bi-gear-fill text-primary me-2"></i> <strong>Configuration</strong> - Profil et biens</p>
          <p class="mb-2"><i class="bi bi-currency-euro text-success me-2"></i> <strong>Financement</strong> - Budget et suivi des coûts</p>
          <p class="mb-2"><i class="bi bi-file-earmark-text-fill text-info me-2"></i> <strong>Documents</strong> - Classement intelligent</p>
          <p class="mb-2"><i class="bi bi-chat-dots-fill text-warning me-2"></i> <strong>Chat IA</strong> - Assistant personnalisé</p>
        </div>
        <div class="col-md-6">
          <p class="mb-2"><i class="bi bi-tools" style="color: #8b5cf6;" me-2></i> <strong>Préparation chantier</strong> - Planification</p>
          <p class="mb-2"><i class="bi bi-clipboard2-check-fill me-2"></i> <strong>Suivi chantier</strong> <small class="text-muted">(Bientôt)</small></p>
          <p class="mb-2"><i class="bi bi-check-circle-fill me-2"></i> <strong>Clôture</strong> <small class="text-muted">(Bientôt)</small></p>
        </div>
      </div>
    </div>
  </div>
</div>
