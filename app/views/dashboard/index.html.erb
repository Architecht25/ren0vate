<div class="container-fluid px-4 py-4">
  <!-- Header principal -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-house-door"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">
          Bienvenue <%= current_user.first_name || current_user.email.split('@').first %>
        </h1>
        <small class="text-muted-custom">Tableau de bord - Vue d'ensemble de vos biens</small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to notifications_path, class: "btn btn-outline-primary-custom position-relative" do %>
        <i class="bi bi-bell"></i>
        <% if @recent_notifications&.any? %>
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            <%= @recent_notifications.count %>
          </span>
        <% end %>
      <% end %>
      <%= link_to new_property_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Ajouter un bien
      <% end %>
    </div>
  </div>

  <!-- Statistiques en un coup d'œil -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-4">
          <div class="icon-circle-large mx-auto mb-3">
            <i class="bi bi-house-door"></i>
          </div>
          <h3 class="text-primary-custom mb-1"><%= @total_properties %></h3>
          <small class="text-muted-custom">Biens enregistrés</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-4">
          <div class="icon-circle-large mx-auto mb-3">
            <i class="bi bi-percent"></i>
          </div>
          <h3 class="text-primary-custom mb-1"><%= @completion_stats[:average] %>%</h3>
          <small class="text-muted-custom">Complétude moyenne</small>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-4">
          <div class="icon-circle-large mx-auto mb-3">
            <i class="bi bi-file-earmark-text"></i>
          </div>
          <h3 class="text-primary-custom mb-1"><%= @request_stats[:pending] + @request_stats[:in_progress] + @request_stats[:submitted] %></h3>
          <small class="text-muted-custom">Demandes en cours</small>
          <% if @request_stats[:estimated_amount] > 0 %>
            <div class="mt-2">
              <small class="text-success fw-semibold">
                <%= number_to_currency(@request_stats[:estimated_amount], unit: "€", separator: ",", delimiter: " ") %>
              </small>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 bg-light-custom h-100">
        <div class="card-body text-center p-4">
          <div class="icon-circle-large mx-auto mb-3">
            <i class="bi bi-check-circle"></i>
          </div>
          <h3 class="text-primary-custom mb-1"><%= @completion_stats[:completed] %></h3>
          <small class="text-muted-custom">Biens finalisés (≥80%)</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Détail des demandes en cours -->
  <% if @request_stats[:total] > 0 %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light-custom border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-normal text-primary-custom">
          <i class="bi bi-file-earmark-text me-2"></i>État des demandes de primes
        </h5>
        <%= link_to requests_path, class: "btn btn-outline-primary-custom btn-sm" do %>
          Voir toutes →
        <% end %>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <% if @request_stats[:pending] > 0 %>
            <div class="col-md-3">
              <div class="text-center p-3 bg-warning bg-opacity-10 rounded">
                <div class="h4 text-warning mb-1"><%= @request_stats[:pending] %></div>
                <small class="text-muted">En attente</small>
              </div>
            </div>
          <% end %>

          <% if @request_stats[:in_progress] > 0 %>
            <div class="col-md-3">
              <div class="text-center p-3 bg-info bg-opacity-10 rounded">
                <div class="h4 text-info mb-1"><%= @request_stats[:in_progress] %></div>
                <small class="text-muted">En traitement</small>
              </div>
            </div>
          <% end %>

          <% if @request_stats[:submitted] > 0 %>
            <div class="col-md-3">
              <div class="text-center p-3 bg-primary bg-opacity-10 rounded">
                <div class="h4 text-primary mb-1"><%= @request_stats[:submitted] %></div>
                <small class="text-muted">Soumises</small>
              </div>
            </div>
          <% end %>

          <% if @request_stats[:validated] > 0 %>
            <div class="col-md-3">
              <div class="text-center p-3 bg-success bg-opacity-10 rounded">
                <div class="h4 text-success mb-1"><%= @request_stats[:validated] %></div>
                <small class="text-muted">Validées</small>
              </div>
            </div>
          <% end %>
        </div>

        <% if @request_stats[:estimated_amount] > 0 %>
          <div class="mt-3 pt-3 border-top">
            <div class="row">
              <div class="col-md-6">
                <small class="text-muted">Montant estimé des demandes en cours :</small>
              </div>
              <div class="col-md-6 text-end">
                <span class="h5 text-success mb-0">
                  <%= number_to_currency(@request_stats[:estimated_amount], unit: "€", separator: ",", delimiter: " ") %>
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Liste des biens avec état de complétude -->
  <% if @properties.any? %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light-custom border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-normal text-primary-custom">
          <i class="bi bi-house-door me-2"></i>Mes biens récents
        </h5>
        <%= link_to properties_path, class: "btn btn-outline-primary-custom btn-sm" do %>
          Voir tous →
        <% end %>
      </div>
      <div class="card-body p-0">
        <div class="list-group list-group-flush">
          <% if @properties.present? %>
            <% @properties.each do |property| %>
              <%= link_to dashboard_property_path(property), class: "list-group-item list-group-item-action border-0 py-3 px-4" do %>
                <div class="d-flex align-items-center">
                  <div class="icon-circle me-3">
                    <i class="bi bi-house-door"></i>
                  </div>
                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <h6 class="mb-0 fw-normal">
                        <%= property.name rescue "Bien #{property.commune || property.id}" %>
                      </h6>
                      <small class="text-muted-custom">
                        <i class="bi bi-geo-alt"></i>
                        <%= property.commune || 'Commune inconnue' %>
                      </small>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                      <div class="flex-grow-1 me-3">
                        <div class="progress" style="height: 6px;">
                          <div class="progress-bar bg-<%= property.completion_status rescue 'secondary' %>"
                               style="width: <%= property.completion_percentage rescue 0 %>%"></div>
                        </div>
                      </div>
                      <span class="badge bg-<%= property.completion_status rescue 'secondary' %> rounded-pill">
                        <%= property.completion_percentage rescue 0 %>%
                      </span>
                    </div>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div class="text-center py-4">
              <i class="bi bi-house-door text-muted display-6"></i>
              <p class="text-muted mt-2">Aucun bien enregistré pour le moment</p>
              <%= link_to new_property_path, class: "btn btn-primary-custom" do %>
                <i class="bi bi-plus-lg me-2"></i>Ajouter votre premier bien
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  <% else %>
    <!-- État vide pour nouvel utilisateur -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-house-door"></i>
      </div>
      <h4 class="text-muted-custom mb-3 fw-normal">Aucun bien enregistré</h4>
      <p class="text-muted-custom mb-4">Commencez par ajouter votre premier bien immobilier pour débloquer l'accès aux primes de rénovation</p>
      <%= link_to new_property_path, class: "btn btn-primary-custom px-5 py-3" do %>
        <i class="bi bi-plus-lg me-2"></i>Ajouter mon premier bien
      <% end %>

      <!-- Guide rapide pour nouveaux utilisateurs -->
      <div class="row justify-content-center mt-5">
        <div class="col-lg-8">
          <div class="card border-0 bg-light-custom">
            <div class="card-body p-4">
              <h6 class="text-primary-custom mb-3">🚀 Pour bien commencer :</h6>
              <div class="row g-3 text-start">
                <div class="col-md-4">
                  <div class="d-flex align-items-start">
                    <span class="badge bg-primary-custom rounded-circle me-3 mt-1">1</span>
                    <div>
                      <strong>Ajoutez votre bien</strong>
                      <br><small class="text-muted-custom">Renseignez l'adresse et les caractéristiques</small>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="d-flex align-items-start">
                    <span class="badge bg-primary-custom rounded-circle me-3 mt-1">2</span>
                    <div>
                      <strong>Calculez vos primes</strong>
                      <br><small class="text-muted-custom">Découvrez les aides disponibles</small>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="d-flex align-items-start">
                    <span class="badge bg-primary-custom rounded-circle me-3 mt-1">3</span>
                    <div>
                      <strong>Faites votre demande</strong>
                      <br><small class="text-muted-custom">Soumettez votre dossier complet</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
