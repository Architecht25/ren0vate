<% content_for :title, "Financer mes travaux – Ren0vate" %>

<div class="container-fluid px-4 py-4">

  <div class="mb-4 pb-3 border-bottom d-flex align-items-start justify-content-between gap-3">
    <div>
      <h1 class="h3 text-primary-custom mb-1 fw-normal">Financer mes travaux</h1>
      <p class="text-muted small mb-0">Deux leviers pour financer votre rénovation — ils se combinent souvent</p>
    </div>
    <% if @property %>
      <%= link_to dashboard_property_path(@property), class: "btn btn-outline-secondary btn-sm flex-shrink-0" do %>
        <i class="bi bi-arrow-left me-1"></i>Retour au bien
      <% end %>
    <% end %>
  </div>

  <div class="row g-4">

    <!-- Primes & subsides -->
    <div class="col-lg-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:52px;height:52px;background:var(--ren0vate-primary);">
              <i class="bi bi-award text-white fs-4"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Primes & subsides</h5>
              <p class="text-muted small mb-0">De l'argent que vous ne devez pas rembourser</p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-check-circle me-2 text-primary-ren0vate"></i>Aides régionales (Wallonie, Flandre, Bruxelles)</li>
            <li><i class="bi bi-check-circle me-2 text-primary-ren0vate"></i>Cumulables selon vos travaux</li>
            <li><i class="bi bi-check-circle me-2 text-primary-ren0vate"></i>Simulation, dossier et suivi en un seul endroit</li>
          </ul>
          <div class="mt-auto">
            <% if @simulations_count > 0 || @requests_count > 0 %>
              <p class="text-muted small mb-2">
                <%= @simulations_count %> simulation<%= 's' if @simulations_count != 1 %> ·
                <%= @requests_count %> dossier<%= 's' if @requests_count != 1 %> en cours
              </p>
            <% end %>
            <%= link_to primes_hub_path(@property ? { property_id: @property.id } : {}), class: "btn w-100 fw-semibold text-white",
                  style: "background:var(--ren0vate-primary);border-color:var(--ren0vate-primary);border-radius:8px;" do %>
              <i class="bi bi-award me-2"></i>Gérer mes primes
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Prêts avantageux -->
    <div class="col-lg-6">
      <div class="card border-0 h-100" style="border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.07);">
        <div class="card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width:52px;height:52px;background:var(--ren0vate-accent);">
              <i class="bi bi-bank text-white fs-4"></i>
            </div>
            <div>
              <h5 class="card-title mb-1 fw-semibold">Prêts avantageux</h5>
              <p class="text-muted small mb-0">De l'argent à rembourser, à taux réduit ou nul</p>
            </div>
          </div>
          <ul class="list-unstyled small text-muted mb-4" style="line-height:1.8;">
            <li><i class="bi bi-check-circle me-2 text-accent-ren0vate"></i>Prêts régionaux à 0% (Rénopack, VerbouwLening, EcoReno)</li>
            <li><i class="bi bi-check-circle me-2 text-accent-ren0vate"></i>Crédit classique si besoin de compléter</li>
            <li><i class="bi bi-check-circle me-2 text-accent-ren0vate"></i>Simulation de mensualités avant de signer</li>
          </ul>
          <div class="mt-auto">
            <% if @pret_wallonie_dossiers_count > 0 %>
              <p class="text-muted small mb-2">
                <%= @pret_wallonie_dossiers_count %> dossier<%= 's' if @pret_wallonie_dossiers_count != 1 %> de prêt bonifié en cours
              </p>
            <% end %>
            <%= link_to loans_hub_path(@property ? { property_id: @property.id } : {}), class: "btn w-100 fw-semibold text-white",
                  style: "background:var(--ren0vate-accent);border-color:var(--ren0vate-accent);border-radius:8px;" do %>
              <i class="bi bi-bank me-2"></i>Simuler mon prêt
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>

  <p class="text-muted small mt-4 mb-0">
    <i class="bi bi-info-circle me-1"></i>
    Un prêt à taux 0% combiné à vos primes régionales peut couvrir la quasi-totalité du coût de votre rénovation énergétique.
  </p>
</div>
