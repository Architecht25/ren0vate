<% content_for :title, @template.title %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item">
            <%= link_to "Documents", prime_document_templates_path %>
          </li>
          <li class="breadcrumb-item">
            <%= link_to @prime.titre, prime_document_templates_path(prime_id: @prime.id) %>
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <%= truncate(@template.title, length: 50) %>
          </li>
        </ol>
      </nav>

      <!-- Document Card -->
      <div class="card">
        <div class="card-header">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <h4 class="mb-1"><%= @template.title %></h4>
              <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-primary"><%= @template.type_document.humanize %></span>
                <% if @template.is_required %>
                  <span class="badge bg-success">Obligatoire</span>
                <% else %>
                  <span class="badge bg-secondary">Optionnel</span>
                <% end %>
                <% if @template.file_available? %>
                  <span class="badge bg-info">Disponible</span>
                <% else %>
                  <span class="badge bg-warning">Non disponible</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="card-body">
          <!-- Prime associée -->
          <div class="alert alert-light border-start border-primary border-4 mb-4">
            <h6 class="alert-heading mb-2">
              <i class="bi bi-award"></i> Prime associée
            </h6>
            <div class="row">
              <div class="col-md-8">
                <strong><%= @prime.titre %></strong><br>
                <small class="text-muted">
                  Région: <%= @prime.region&.capitalize %> •
                  Type: <%= @prime.type_de_valeur %>
                </small>
              </div>
              <div class="col-md-4 text-end">
                <%= link_to "Voir la prime", "#", class: "btn btn-sm btn-outline-primary" %>
              </div>
            </div>
          </div>

          <!-- Description -->
          <% if @template.description.present? %>
            <div class="mb-4">
              <h6><i class="bi bi-info-circle"></i> Description</h6>
              <div class="bg-light p-3 rounded">
                <%= simple_format(@template.description) %>
              </div>
            </div>
          <% end %>

          <!-- Informations sur le fichier -->
          <div class="mb-4">
            <h6><i class="bi bi-file-earmark"></i> Informations sur le fichier</h6>
            <div class="table-responsive">
              <table class="table table-sm">
                <tbody>
                  <tr>
                    <td><strong>Nom du fichier:</strong></td>
                    <td><%= @template.file_name %></td>
                  </tr>
                  <tr>
                    <td><strong>Type:</strong></td>
                    <td><%= @template.type_document.humanize %></td>
                  </tr>
                  <tr>
                    <td><strong>Statut:</strong></td>
                    <td>
                      <% if @template.file_available? %>
                        <span class="text-success">
                          <i class="bi bi-check-circle"></i> Disponible
                        </span>
                      <% else %>
                        <span class="text-danger">
                          <i class="bi bi-x-circle"></i> Non disponible
                        </span>
                      <% end %>
                    </td>
                  </tr>
                  <tr>
                    <td><strong>Ajouté le:</strong></td>
                    <td><%= l(@template.created_at, format: :long) %></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Actions -->
          <div class="d-flex gap-2 flex-wrap">
            <% if @template.file_available? %>
              <%= link_to download_prime_document_template_path(@template),
                    class: "btn btn-primary",
                    target: "_blank" do %>
                <i class="bi bi-download"></i> Télécharger le document
              <% end %>
            <% else %>
              <button class="btn btn-secondary" disabled>
                <i class="bi bi-x-circle"></i> Document non disponible
              </button>
            <% end %>

            <%= link_to prime_document_templates_path(prime_id: @prime.id),
                  class: "btn btn-outline-secondary" do %>
              <i class="bi bi-arrow-left"></i> Retour aux documents de cette prime
            <% end %>

            <%= link_to prime_document_templates_path,
                  class: "btn btn-outline-secondary" do %>
              <i class="bi bi-list"></i> Tous les documents
            <% end %>
          </div>
        </div>
      </div>

      <!-- Documents similaires -->
      <% other_docs = @prime.document_templates.where.not(id: @template.id).limit(3) %>
      <% if other_docs.any? %>
        <div class="mt-4">
          <h6>Autres documents pour cette prime</h6>
          <div class="row g-3">
            <% other_docs.each do |doc| %>
              <div class="col-md-4">
                <div class="card card-body h-100">
                  <h6 class="card-title"><%= doc.title %></h6>
                  <p class="small text-muted mb-2"><%= doc.type_document.humanize %></p>
                  <%= link_to "Voir", prime_document_template_path(doc),
                        class: "btn btn-sm btn-outline-primary mt-auto" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
