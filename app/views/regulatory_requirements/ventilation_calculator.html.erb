<div class="container-fluid px-4 py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-calculator"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Calculateur de Ventilation</h1>
        <small class="text-muted">Calculez les exigences de ventilation pour vos châssis</small>
      </div>
    </div>
    <%= link_to regulatory_requirements_path(tab: 'ventilation', region: @region),
        class: "btn btn-outline-primary" do %>
      <i class="bi bi-arrow-left me-2"></i>Retour au guide
    <% end %>
  </div>

  <div class="row">
    <div class="col-lg-6">
      <!-- Formulaire de calcul -->
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h5 class="mb-4">🧮 Paramètres de calcul</h5>

          <%= form_with url: ventilation_calculator_regulatory_requirements_path,
              method: :get, local: true, class: "needs-validation" do |f| %>

            <div class="mb-3">
              <%= f.label :room_type, "Type de pièce", class: "form-label" %>
              <%= f.select :room_type,
                  [
                    ['Salon/Séjour', 'woonkamer'],
                    ['Chambre', 'slaapkamer'],
                    ['Bureau/Étude', 'studeerkamer'],
                    ['Salle de jeux', 'speelkamer'],
                    ['Salle de hobby', 'hobbyruimte']
                  ],
                  { selected: @room_type },
                  { class: "form-select", required: true } %>
            </div>

            <div class="mb-3">
              <%= f.label :room_area, "Surface de la pièce (m²)", class: "form-label" %>
              <%= f.number_field :room_area,
                  value: @room_area,
                  step: 0.1,
                  min: 1,
                  class: "form-control",
                  placeholder: "Ex: 25.5",
                  required: true %>
            </div>

            <div class="mb-4">
              <%= f.label :window_width, "Largeur totale des fenêtres remplacées (m)", class: "form-label" %>
              <%= f.number_field :window_width,
                  value: @window_width,
                  step: 0.1,
                  min: 0.1,
                  class: "form-control",
                  placeholder: "Ex: 2.5",
                  required: true %>
              <div class="form-text">
                Additionner la largeur de toutes les fenêtres remplacées dans cette pièce
              </div>
            </div>

            <div class="d-grid">
              <%= f.submit "Calculer", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <% if @final_requirement %>
        <!-- Résultats -->
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <h5 class="mb-4">📊 Résultats du calcul</h5>

            <div class="alert alert-success text-center">
              <h4 class="mb-0">
                <i class="bi bi-check-circle me-2"></i>
                <strong><%= @final_requirement.round(1) %> m³/h</strong>
              </h4>
              <small>Débit de ventilation requis</small>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-6">
                <div class="card bg-light">
                  <div class="card-body text-center p-3">
                    <div class="h5 text-primary mb-1"><%= @base_requirement.round(1) %></div>
                    <small class="text-muted">Calcul de base<br>(surface × 3,6)</small>
                  </div>
                </div>
              </div>
              <div class="col-6">
                <div class="card bg-light">
                  <div class="card-body text-center p-3">
                    <div class="h5 text-warning mb-1"><%= @minimum_requirement %></div>
                    <small class="text-muted">Minimum<br>réglementaire</small>
                  </div>
                </div>
              </div>
              <% if @maximum_limit %>
                <div class="col-6">
                  <div class="card bg-light">
                    <div class="card-body text-center p-3">
                      <div class="h5 text-info mb-1"><%= @maximum_limit %></div>
                      <small class="text-muted">Maximum<br>autorisé</small>
                    </div>
                  </div>
                </div>
              <% end %>
              <div class="col-6">
                <div class="card bg-light">
                  <div class="card-body text-center p-3">
                    <div class="h5 text-secondary mb-1"><%= @window_limitation.round(1) %></div>
                    <small class="text-muted">Limitation<br>fenêtres</small>
                  </div>
                </div>
              </div>
            </div>

            <div class="border-top pt-3">
              <h6 class="mb-3">💡 Interprétation</h6>
              <% if @final_requirement == @window_limitation %>
                <p class="text-success mb-2">
                  <i class="bi bi-check-circle me-2"></i>
                  La largeur de vos fenêtres limite le débit requis.
                  Vous bénéficiez de la réduction à 45 m³/h par mètre linéaire.
                </p>
              <% elsif @final_requirement == @minimum_requirement %>
                <p class="text-warning mb-2">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  Le minimum réglementaire s'applique car votre pièce est petite.
                </p>
              <% else %>
                <p class="text-primary mb-2">
                  <i class="bi bi-info-circle me-2"></i>
                  Le calcul standard s'applique (surface × 3,6 m³/h).
                </p>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Solutions pratiques -->
        <div class="card border-0 shadow-sm mt-4">
          <div class="card-body p-4">
            <h6 class="mb-3">🔧 Solutions pratiques</h6>
            <ul class="list-unstyled mb-0">
              <li class="mb-2">
                <i class="bi bi-arrow-right text-primary me-2"></i>
                Grilles de ventilation intégrées aux châssis
              </li>
              <li class="mb-2">
                <i class="bi bi-arrow-right text-primary me-2"></i>
                Système de ventilation mécanique contrôlée (VMC)
              </li>
              <li class="mb-2">
                <i class="bi bi-arrow-right text-primary me-2"></i>
                Ventilation naturelle avec grilles murales
              </li>
            </ul>
          </div>
        </div>
      <% else %>
        <!-- Instructions -->
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4">
            <h5 class="mb-3">📋 Instructions</h5>
            <ol class="mb-4">
              <li class="mb-2">Sélectionnez le type de pièce</li>
              <li class="mb-2">Indiquez la surface en m²</li>
              <li class="mb-2">Précisez la largeur totale des fenêtres à remplacer</li>
              <li class="mb-2">Cliquez sur "Calculer"</li>
            </ol>

            <div class="alert alert-info">
              <i class="bi bi-lightbulb me-2"></i>
              <strong>Astuce :</strong> Pour plusieurs fenêtres, additionnez leurs largeurs.
              Par exemple : 1,2m + 1,5m + 0,8m = 3,5m au total.
            </div>
          </div>
        </div>

        <!-- Exemple visuel -->
        <div class="card border-0 shadow-sm mt-4">
          <div class="card-body p-4">
            <h6 class="mb-3">💡 Exemple</h6>
            <div class="bg-light p-3 rounded">
              <strong>Salon de 30 m²</strong> avec 2 fenêtres de 1,5m chacune
              <br><br>
              <em>Surface :</em> 30 m²<br>
              <em>Largeur totale :</em> 1,5 + 1,5 = 3,0 m<br>
              <em>Résultat :</em> 108 m³/h requis
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
.icon-circle {
  width: 48px;
  height: 48px;
  background: rgba(var(--bs-primary-rgb), 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: var(--bs-primary);
}
</style>
