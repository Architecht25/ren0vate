<div class="row justify-content-center">
  <div class="col-lg-8">
    <!-- Message principal -->
    <div class="card border-0 shadow-sm mb-4 text-center">
      <div class="card-body p-5">
        <div class="mb-4">
          <i class="bi bi-house-heart display-1 text-success"></i>
        </div>
        <h2 class="text-primary-custom mb-3">Exigences Réglementaires - Wallonie</h2>
        <p class="lead text-muted-custom mb-4">
          Nous développons actuellement le contenu spécifique aux réglementations wallonnes
          pour vous guider dans vos projets de rénovation énergétique.
        </p>

        <div class="row g-4 mt-4">
          <div class="col-md-4">
            <div class="card border-0 bg-light-custom h-100">
              <div class="card-body p-3 text-center">
                <i class="bi bi-award text-success mb-2" style="font-size: 2rem;"></i>
                <h6 class="mb-2">Primes Habitation</h6>
                <p class="small text-muted-custom mb-0">Conditions et montants des primes</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border-0 bg-light-custom h-100">
              <div class="card-body p-3 text-center">
                <i class="bi bi-graph-up text-success mb-2" style="font-size: 2rem;"></i>
                <h6 class="mb-2">Certificat PEB</h6>
                <p class="small text-muted-custom mb-0">Performance énergétique wallonne</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border-0 bg-light-custom h-100">
              <div class="card-body p-3 text-center">
                <i class="bi bi-tools text-success mb-2" style="font-size: 2rem;"></i>
                <h6 class="mb-2">Rénopack</h6>
                <p class="small text-muted-custom mb-0">Prêt à 0% et accompagnement</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Informations temporaires -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="text-primary-custom mb-3">
          <i class="bi bi-info-circle me-2"></i>En attendant, voici quelques informations utiles
        </h5>

        <div class="alert alert-success">
          <h6 class="mb-2">🏡 Primes Habitation - SPW Énergie</h6>
          <p class="mb-2">
            Les primes habitation soutiennent l'amélioration énergétique des logements wallons.
            Elles concernent l'isolation, le chauffage, la ventilation et les énergies renouvelables.
          </p>
          <ul class="mb-0 small">
            <li>Montants selon les revenus et la localisation</li>
            <li>Cumul avec Rénopack (prêt à 0%)</li>
            <li>Audit énergétique recommandé</li>
          </ul>
        </div>

        <div class="alert alert-warning">
          <h6 class="mb-2">⚠️ Points d'attention spécifiques à la Wallonie</h6>
          <ul class="mb-0 small">
            <li>Respect de la réglementation PEB wallonne</li>
            <li>Obligations selon l'âge du bâtiment</li>
            <li>Exigences techniques spécifiques par type de travaux</li>
            <li>Procédures communales variables</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Actions recommandées -->
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h6 class="text-primary-custom mb-3">🚀 En attendant, vous pouvez :</h6>
        <div class="d-grid gap-2">
          <%= link_to "https://energie.wallonie.be/fr/les-primes-habitation.html",
              target: "_blank", class: "btn btn-outline-success" do %>
            <i class="bi bi-globe me-2"></i>Consulter le site officiel SPW Énergie
          <% end %>

          <%= link_to documents_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-folder me-2"></i>Préparer vos documents
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Sidebar avec notifications -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h6 class="text-primary-custom mb-3">
          <i class="bi bi-bell me-2"></i>Restez informé
        </h6>
        <p class="small text-muted-custom mb-3">
          Nous vous notifierons dès que le contenu spécifique à la Wallonie sera disponible.
        </p>
        <div class="d-grid">
          <button class="btn btn-outline-success btn-sm" disabled>
            <i class="bi bi-bell me-2"></i>Notifications activées
          </button>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h6 class="mb-3">📅 Planning</h6>
        <div class="small text-muted-custom">
          <div class="mb-2">
            <strong>Août 2025</strong><br>
            Contenu réglementaire Wallonie
          </div>
          <div class="mb-2">
            <strong>Septembre 2025</strong><br>
            Calculateurs spécialisés
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
