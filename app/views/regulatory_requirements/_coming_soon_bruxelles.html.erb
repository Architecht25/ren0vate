<div class="row justify-content-center">
  <div class="col-lg-8">
    <!-- Message principal -->
    <div class="card border-0 shadow-sm mb-4 text-center">
      <div class="card-body p-5">
        <div class="mb-4">
          <i class="bi bi-buildings display-1 text-primary"></i>
        </div>
        <h2 class="text-primary-custom mb-3">Exigences Réglementaires - Bruxelles</h2>
        <p class="lead text-muted-custom mb-4">
          Nous préparons actuellement le contenu spécifique aux réglementations bruxelloises
          pour vous accompagner dans vos projets de rénovation énergétique.
        </p>

        <div class="row g-4 mt-4">
          <div class="col-md-4">
            <div class="card border-0 bg-light-custom h-100">
              <div class="card-body p-3 text-center">
                <i class="bi bi-file-earmark-text text-primary mb-2" style="font-size: 2rem;"></i>
                <h6 class="mb-2">Primes Rénolution</h6>
                <p class="small text-muted-custom mb-0">Conditions et exigences techniques</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border-0 bg-light-custom h-100">
              <div class="card-body p-3 text-center">
                <i class="bi bi-house-gear text-primary mb-2" style="font-size: 2rem;"></i>
                <h6 class="mb-2">Réglementation PEB</h6>
                <p class="small text-muted-custom mb-0">Performance énergétique des bâtiments</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card border-0 bg-light-custom h-100">
              <div class="card-body p-3 text-center">
                <i class="bi bi-clipboard-check text-primary mb-2" style="font-size: 2rem;"></i>
                <h6 class="mb-2">Documents Requis</h6>
                <p class="small text-muted-custom mb-0">Attestations et certificats</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Informations temporaires -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h5 class="text-primary-custom mb-3">
          <i class="bi bi-info-circle me-2"></i>En attendant, voici quelques informations utiles
        </h5>

        <div class="alert alert-info">
          <h6 class="mb-2">📋 Primes Rénolution - Bruxelles Environnement</h6>
          <p class="mb-2">
            Les primes Rénolution soutiennent la rénovation énergétique des logements bruxellois.
            Elles couvrent l'isolation, le chauffage, la ventilation et les audits énergétiques.
          </p>
          <ul class="mb-0 small">
            <li>Prime de base + bonus selon les revenus</li>
            <li>Cumul possible avec d'autres aides (Prêt Vert, etc.)</li>
            <li>Obligation d'audit énergétique pour certains travaux</li>
          </ul>
        </div>

        <div class="alert alert-warning">
          <h6 class="mb-2">⚠️ Points d'attention spécifiques à Bruxelles</h6>
          <ul class="mb-0 small">
            <li>Respect du Plan Régional Air-Climat-Énergie (PACE)</li>
            <li>Contraintes architecturales en zone protégée</li>
            <li>Réglementation PEB bruxelloise spécifique</li>
            <li>Obligations en matière de performance énergétique</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Actions recommandées -->
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h6 class="text-primary-custom mb-3">🚀 En attendant, vous pouvez :</h6>
        <div class="d-grid gap-2">
          <%= link_to "https://environnement.brussels/thematiques/energie/primes-et-aides-financieres/primes-renolution",
              target: "_blank", class: "btn btn-outline-primary-custom" do %>
            <i class="bi bi-globe me-2"></i>Consulter le site officiel Bruxelles Environnement
          <% end %>

          <%= link_to documents_path, class: "btn btn-outline-secondary" do %>
            <i class="bi bi-folder me-2"></i>Préparer vos documents
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Sidebar avec notifications -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body p-4">
        <h6 class="text-primary-custom mb-3">
          <i class="bi bi-bell me-2"></i>Restez informé
        </h6>
        <p class="small text-muted-custom mb-3">
          Nous vous notifierons dès que le contenu spécifique à Bruxelles sera disponible.
        </p>
        <div class="d-grid">
          <button class="btn btn-outline-primary-custom btn-sm" disabled>
            <i class="bi bi-bell me-2"></i>Notifications activées
          </button>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h6 class="mb-3">📅 Planning</h6>
        <div class="small text-muted-custom">
          <div class="mb-2">
            <strong>Août 2025</strong><br>
            Contenu réglementaire Bruxelles
          </div>
          <div class="mb-2">
            <strong>Septembre 2025</strong><br>
            Calculateurs spécialisés
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
