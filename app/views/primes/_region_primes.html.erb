<% if primes.any? %>
  <div class="row g-3 justify-content-center">
    <% primes.each do |prime| %>
      <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
        <% # Déterminer le lien selon le type d'objet
           if prime.is_a?(EntrepriseAide)
             link_path = entreprise_aide_path(prime)
             link_options = {}
           else
             link_path = prime_path(prime)
             link_options = {}
           end %>
        <%= link_to link_path, class: "text-decoration-none", **link_options do %>
          <div class="prime-card bg-white border rounded-3 overflow-hidden h-100 shadow-sm">
            <div class="d-flex align-items-stretch h-100">
              <!-- Image côté gauche qui occupe toute la hauteur -->
              <div class="prime-image-left" style="width: 160px; min-height: 100px;">
                <% cloudinary_id = case prime.titre&.downcase
                    when /isolation.*toiture/
                      'isolation_toiture_f9r4hs'
                    when /isolation.*murs/
                      'renovation_murs_kflk5b'
                    when /isolation.*sols?/
                      'Eurofloor_1_wah35y'
                    when /chassis|fenêtres?|portes?.*extérieures?/
                      'remplacement_chassis_lrszxo'
                    when /pac|pompe.*chaleur/
                      'pac_géothermique_cj7l2y'
                    when /chauffage|chaudière/
                      'efficacite-energetique-batiment_mlgdaj'
                    when /chauffe.eau|thermodynamique|boiler/
                      'pac_hybride_ukmzp8'
                    when /ventilation/
                      'Housing-Ventilation-Shutterstock-16-9-1920x1080px_uxckrq'
                    when /rénovation.*globale/
                      'renovation_toiture_guwknw'
                    when /rénovation|préparatoires/
                      'module-chantier_bnnpcl'
                    when /sanitaires?.*électricité|électricité.*sanitaires?|plomberie.*électricité|électricité.*plomberie/
                      'électricité-plomberie-1_lbqblm'
                    # Images spécifiques entreprises
                    when /consultant|audit|conseil/
                      'consultant_uup0sz'
                    when /formation|recrutement|emploi/
                      'on_recrute_cmceil'
                    when /transition|économique|stratégique/
                      'Les-enjeux-economiques-de-la-transition-vers-la-neutralite-carbone-min_pnxl9b'
                    when /investissement|équipement|financement/
                      'financement-dequipement-comment-reduire-les-couts-dinvestissement-1024x683_l1zath'
                    else
                      # Image par défaut selon le type d'objet
                      prime.is_a?(EntrepriseAide) ? 'consultant_uup0sz' : 'bureau_etude_renovation_energetique_4_yswh8x'
                    end %>
                <div class="h-100 w-100"
                     style="background-image: url('https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/c_fill,w_160,h_120,q_auto,f_auto/<%= cloudinary_id %>');
                            background-size: cover;
                            background-position: center;">
                </div>
              </div>

              <div class="flex-grow-1 p-3 d-flex flex-column justify-content-center">
                <!-- Titre de la prime -->
                <h6 class="prime-title mb-1 <%= case color_class when 'primary' then 'text-primary' when 'success' then 'text-success' when 'warning' then 'text-secondary' else 'text-primary' end %> fw-semibold lh-sm">
                  <%= prime.titre %>
                </h6>

                <!-- Petite indication du type ou région -->
                <small class="text-muted d-flex align-items-center">
                  <i class="bi bi-<%= prime.respond_to?(:icon_name) && prime.icon_name.present? ? prime.icon_name : (prime.is_a?(EntrepriseAide) ? 'building' : 'award') %> me-1" style="font-size: 12px;"></i>
                  <%= case color_class when 'primary' then 'Flandre' when 'success' then 'Wallonie' when 'warning' then 'Bruxelles' when 'info' then 'Entreprises' else region_name end %>
                </small>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-5">
    <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px;">
      <i class="bi bi-stars text-muted"></i>
    </div>
    <h5 class="text-muted">Aucune prime disponible en <%= region_name %></h5>
    <p class="text-muted small">Les primes apparaîtront ici une fois configurées.</p>
  </div>
<% end %>
