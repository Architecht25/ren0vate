<div class="container-fluid px-4 py-4">
  <!-- Header avec titre -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-stars"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Primes disponibles par région</h1>
    </div>
    <%= link_to root_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à l'accueil
    <% end %>
  </div>

  <!-- Onglets régionaux -->
  <ul class="nav nav-pills justify-content-center mb-4" id="regionTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="flandre-tab" data-bs-toggle="pill" data-bs-target="#flandre" type="button" role="tab" aria-controls="flandre" aria-selected="true">
        🇳🇱 Flandre
        <span class="badge bg-white text-primary ms-2"><%= @primes_by_region[:flandre]&.count || 0 %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="wallonie-tab" data-bs-toggle="pill" data-bs-target="#wallonie" type="button" role="tab" aria-controls="wallonie" aria-selected="false">
        🏴󠁢󠁥󠁷󠁡󠁬󠁿 Wallonie
        <span class="badge bg-white text-primary ms-2"><%= @primes_by_region[:wallonie]&.count || 0 %></span>
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="bruxelles-tab" data-bs-toggle="pill" data-bs-target="#bruxelles" type="button" role="tab" aria-controls="bruxelles" aria-selected="false">
        🏢 Bruxelles
        <span class="badge bg-white text-primary ms-2"><%= @primes_by_region[:bruxelles]&.count || 0 %></span>
      </button>
    </li>
  </ul>

  <!-- Contenu des onglets -->
  <div class="tab-content" id="regionTabsContent">
    <!-- Onglet Flandre -->
    <div class="tab-pane fade show active" id="flandre" role="tabpanel" aria-labelledby="flandre-tab">
      <%= render 'region_primes',
          primes: @primes_by_region[:flandre] || [],
          region: 'flandre',
          region_name: 'Flandre',
          color_class: 'primary' %>
    </div>

    <!-- Onglet Wallonie -->
    <div class="tab-pane fade" id="wallonie" role="tabpanel" aria-labelledby="wallonie-tab">
      <%= render 'region_primes',
          primes: @primes_by_region[:wallonie] || [],
          region: 'wallonie',
          region_name: 'Wallonie',
          color_class: 'success' %>
    </div>

    <!-- Onglet Bruxelles -->
    <div class="tab-pane fade" id="bruxelles" role="tabpanel" aria-labelledby="bruxelles-tab">
      <%= render 'region_primes',
          primes: @primes_by_region[:bruxelles] || [],
          region: 'bruxelles',
          region_name: 'Bruxelles',
          color_class: 'warning' %>
    </div>
  </div>
</div>
