<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f5f0ea; padding: 20px;">
  <div style="max-width: 560px; margin: 0 auto; background: white; border-radius: 10px; overflow: hidden;">
    <div style="background: #334155; padding: 24px; text-align: center;">
      <h1 style="color: white; margin: 0; font-size: 18px;">Réponse à votre demande #<%= @ticket.id %></h1>
    </div>
    <div style="padding: 28px;">
      <p style="color: #334155;">Bonjour <strong><%= @user.email %></strong>,</p>
      <p style="color: #475569;">L'équipe Ren0vate a répondu à votre demande <strong>"<%= @ticket.subject %>"</strong> :</p>
      <div style="background: #f0fdf4; border-left: 4px solid #22c55e; padding: 14px; border-radius: 4px; margin: 16px 0; white-space: pre-wrap; color: #166534;">
        <%= @message.body %>
      </div>
      <div style="margin-top: 24px; text-align: center;">
        <a href="<%= support_ticket_url(@ticket) %>"
           style="background: #334155; color: white; padding: 12px 28px; border-radius: 6px; text-decoration: none; font-weight: bold;">
          Voir le fil de discussion
        </a>
      </div>
    </div>
    <div style="background: #f8fafc; padding: 14px; text-align: center; font-size: 12px; color: #94a3b8;">
      Ren0vate · Support prioritaire 24h
    </div>
  </div>
</body>
</html>
