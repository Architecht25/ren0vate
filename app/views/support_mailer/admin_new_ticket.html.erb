<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f5f0ea; padding: 20px;">
  <div style="max-width: 560px; margin: 0 auto; background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08);">
    <div style="background: #d97706; padding: 24px; text-align: center;">
      <h1 style="color: white; margin: 0; font-size: 18px;">🎫 Nouveau ticket support</h1>
    </div>
    <div style="padding: 24px;">
      <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
        <tr><td style="padding: 6px 0; color: #64748b;">Ticket</td><td style="font-weight: bold;">#<%= @ticket.id %></td></tr>
        <tr><td style="padding: 6px 0; color: #64748b;">Utilisateur</td><td><%= @user.email %></td></tr>
        <tr><td style="padding: 6px 0; color: #64748b;">Plan</td><td><%= @user.subscription_tier_name %></td></tr>
        <tr><td style="padding: 6px 0; color: #64748b;">Sujet</td><td><%= @ticket.subject %></td></tr>
        <tr><td style="padding: 6px 0; color: #64748b;">Priorité</td><td><%= @ticket.priority %></td></tr>
        <tr><td style="padding: 6px 0; color: #64748b;">Créé le</td><td><%= @ticket.created_at.strftime('%d/%m/%Y à %Hh%M') %></td></tr>
        <tr><td style="padding: 6px 0; color: #dc2626; font-weight: bold;">SLA</td><td>Réponse attendue avant <%= (@ticket.created_at + 24.hours).strftime('%d/%m à %Hh%M') %></td></tr>
      </table>
      <% first_message = @ticket.support_messages.first %>
      <% if first_message %>
        <div style="margin-top: 16px; background: #f8fafc; border-radius: 6px; padding: 14px; color: #334155; font-size: 14px; white-space: pre-wrap;"><%= first_message.body %></div>
      <% end %>
      <div style="margin-top: 20px; text-align: center;">
        <a href="<%= admin_support_ticket_url(@ticket) %>"
           style="background: #334155; color: white; padding: 12px 28px; border-radius: 6px; text-decoration: none; font-weight: bold;">
          Répondre au ticket
        </a>
      </div>
    </div>
  </div>
</body>
</html>
