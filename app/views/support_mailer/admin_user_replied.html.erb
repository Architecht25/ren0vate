<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f5f0ea; padding: 20px;">
  <div style="max-width: 560px; margin: 0 auto; background: white; border-radius: 10px; overflow: hidden;">
    <div style="background: #d97706; padding: 20px; text-align: center;">
      <h1 style="color: white; margin: 0; font-size: 16px;">💬 Réponse sur ticket #<%= @ticket.id %></h1>
    </div>
    <div style="padding: 24px;">
      <p style="font-size: 14px; color: #475569;"><strong><%= @user.email %></strong> a répondu sur le ticket <em>"<%= @ticket.subject %>"</em> :</p>
      <div style="background: #f8fafc; border-radius: 6px; padding: 14px; white-space: pre-wrap; font-size: 14px; color: #334155;">
        <%= @message.body %>
      </div>
      <div style="margin-top: 16px; text-align: center;">
        <a href="<%= admin_support_ticket_url(@ticket) %>"
           style="background: #d97706; color: white; padding: 10px 24px; border-radius: 6px; text-decoration: none; font-weight: bold;">
          Répondre
        </a>
      </div>
    </div>
  </div>
</body>
</html>
