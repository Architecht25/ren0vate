<h1 class="text-center mb-4">Créer un nouvel utilisateur</h1>

<%= form_with model: @user, local: true do |form| %>
  <div class="card shadow-sm p-4 mb-5 bg-white rounded mx-auto" style="max-width: 600px;">
    <div class="form-section">
      <h5 class="mb-3 text-primary">Informations utilisateur</h5>
      <div class="mb-3">
        <%= form.label :name, 'Nom complet', class: 'form-label' %>
        <%= form.text_field :name, class: 'form-control', placeholder: 'Nom complet' %>
      </div>
      <div class="mb-3">
        <%= form.label :email, 'Email', class: 'form-label' %>
        <%= form.email_field :email, class: 'form-control', placeholder: 'Email' %>
      </div>
      <div class="mb-3">
        <%= form.label :password, 'Mot de passe', class: 'form-label' %>
        <%= form.password_field :password, class: 'form-control', placeholder: 'Mot de passe' %>
      </div>

      <div class="d-flex justify-content-center">
        <%= form.submit 'Créer', class: 'btn btn-success btn-lg text-center mt-3' %>
      </div>
    </div>
  </div>
<% end %>

<div class="text-center">
  <%= link_to 'Retour', users_path, class: 'btn btn-secondary btn-lg' %>
</div>
