                  type="button" role="tab">
            <i class="bi bi-currency-euro me-2"></i>Finances & Famille
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link px-4 py-2 rounded-3" id="tab-compte-btn"
                  data-bs-toggle="pill" data-bs-target="#tab-compte"
                  type="button" role="tab">
            <i class="bi bi-gear me-2"></i>Mon compte
          </button>
        </li>
      </ul>
    </div>
  </div>

  <%= form_with model: current_user, url: profile_path, method: :patch, local: true, class: "needs-validation", novalidate: true do |f| %>

    <div class="tab-content" id="profileTabsContent">

      <!-- ===== TAB 1 : PROFIL ===== -->
      <div class="tab-pane fade show active" id="tab-profil" role="tabpanel">
        <div class="row justify-content-center mb-3">
          <div class="col-lg-10">
            <div class="row g-3">

              <!-- Carte 1: Informations personnelles -->
              <div class="col-lg-6">
                <div class="card h-100">
                  <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center">
                      <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                        <i class="bi bi-person text-white fs-6"></i>
                      </div>
                      <div>
                        <h5 class="card-title mb-0 text-dark fw-normal">Informations personnelles</h5>
                        <p class="text-muted small mb-0">Vos données d'identité</p>
                      </div>
                    </div>
                  </div>
                  <div class="card-body px-4 py-3">
                    <div class="row g-2">
                      <div class="col-md-4">
                        <label class="form-label text-dark fw-medium mb-1">
                          <i class="bi bi-person-badge me-2 text-primary"></i>Prénom
                        </label>
                        <%= f.text_field :first_name,
                            class: "form-control border-2 rounded-3 px-3",
                            style: "background: #f8f9fa; border-color: #e9ecef !important;",
                            placeholder: "Votre prénom" %>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label text-dark fw-medium mb-1">
                          <i class="bi bi-person-badge me-2 text-primary"></i>Nom
                        </label>
                        <%= f.text_field :last_name,
                            class: "form-control border-2 rounded-3 px-3",
                            style: "background: #f8f9fa; border-color: #e9ecef !important;",
                            placeholder: "Votre nom de famille" %>
                      </div>
                      <div class="col-4">
                        <label class="form-label text-dark fw-medium mb-1">
                          <i class="bi bi-envelope me-2 text-primary"></i>Adresse email
                        </label>
                        <%= f.email_field :email,
                            class: "form-control border-2 rounded-3 px-3",
                            style: "background: #f8f9fa; border-color: #e9ecef !important;",
                            placeholder: "votre@email.com" %>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label text-dark fw-medium mb-1">
                          <i class="bi bi-telephone me-2 text-primary"></i>Téléphone
                        </label>
                        <%= f.telephone_field :phone,
                            class: "form-control border-2 rounded-3 px-3",
                            style: "background: #f8f9fa; border-color: #e9ecef !important;",
                            placeholder: "+32 xxx xx xx xx" %>
                      </div>
                      <div class="col-md-4">
                        <label class="form-label text-dark fw-medium mb-1">
                          <i class="bi bi-bank me-2 text-primary"></i>Registre national
                        </label>
                        <%= f.text_field :national_number,
                            class: "form-control border-2 rounded-3 px-3",
                            style: "background: #f8f9fa; border-color: #e9ecef !important;",
                            placeholder: "Ex: 77.15.06.123.88" %>
                      </div>
                      <% rib_derniere = current_user.rib_donnees.order(created_at: :desc).first %>
                      <div class="col-md-4">
                        <label class="form-label text-dark fw-medium mb-1">
                          <i class="bi bi-bank me-2 text-primary"></i>IBAN
                        </label>
                        <div class="d-flex gap-2 align-items-start">
                          <%= f.text_field :iban,
                              id: 'user_iban',
                              class: "form-control border-2 rounded-3 px-3",
                              style: "background: #f8f9fa; border-color: #e9ecef !important;",
                              placeholder: "Ex: BE68 5390 0754 7034" %>
                          <button type="button"
                                  id="btn-scan-rib"
                                  class="btn btn-outline-primary btn-sm rounded-3 flex-shrink-0"
                                  style="height: 38px; white-space: nowrap;"
                                  data-bs-toggle="tooltip"
                                  title="Scanner votre RIB pour remplir automatiquement l'IBAN">
                            <i class="bi bi-upc-scan"></i>
                          </button>
                          <input type="file" id="rib-file-input" accept=".pdf,image/jpeg,image/png" class="d-none">
                        </div>
                        <small id="rib-nom-banque" class="text-muted mt-1 ms-1<%= rib_derniere&.nom_banque ? '' : ' d-none' %>">
                          <i class="bi bi-building me-1"></i><span id="rib-nom-banque-text"><%= rib_derniere&.nom_banque %></span>
                        </small>
                        <div id="rib-ocr-status" class="d-none mt-1">
                          <div class="alert border-0 rounded-2 py-1 px-2 mb-0 small" id="rib-ocr-alert">
                            <div class="d-flex align-items-center gap-2">
                              <div id="rib-ocr-spinner" class="spinner-border spinner-border-sm text-primary d-none" role="status"></div>
                              <i id="rib-ocr-icon" class="bi d-none"></i>
                              <span id="rib-ocr-message"></span>
                            </div>
                          </div>
                        </div>
                      </div>

<script nonce="<%= content_security_policy_nonce %>">
(function () {
  const btnScan   = document.getElementById('btn-scan-rib');
  const fileInput = document.getElementById('rib-file-input');
  const statusZone = document.getElementById('rib-ocr-status');
  const alertBox  = document.getElementById('rib-ocr-alert');
  const spinner   = document.getElementById('rib-ocr-spinner');
  const icon      = document.getElementById('rib-ocr-icon');
  const msgEl     = document.getElementById('rib-ocr-message');
  const fieldIban     = document.getElementById('user_iban');
  const nomBanqueEl   = document.getElementById('rib-nom-banque');
  const nomBanqueText = document.getElementById('rib-nom-banque-text');

  btnScan.addEventListener('click', function () { fileInput.click(); });

  fileInput.addEventListener('change', function () {
    const file = fileInput.files[0];
    if (!file) return;

    statusZone.classList.remove('d-none');
    alertBox.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small alert-secondary';
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    msgEl.textContent = 'Lecture du RIB…';
    btnScan.disabled = true;

    const formData = new FormData();
    formData.append('file', file);

    fetch('<%= ocr_scan_rib_path %>', {
      method: 'POST',
      headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') },
      body: formData
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      spinner.classList.add('d-none');
      btnScan.disabled = false;
      if (!data.success) { showStatus('danger', 'bi-exclamation-triangle-fill', data.error || 'Extraction échouée.'); return; }
      if (data.iban) { fieldIban.value = data.iban_formate || data.iban; fieldIban.classList.add('border-primary'); }
      if (data.nom_banque) { nomBanqueText.textContent = data.nom_banque; nomBanqueEl.classList.remove('d-none'); } else { nomBanqueEl.classList.add('d-none'); }
      var type = data.extraction_complete ? 'success' : 'warning';
      var ic   = data.extraction_complete ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
      showStatus(type, ic, data.message);
    })
    .catch(function () { spinner.classList.add('d-none'); btnScan.disabled = false; showStatus('danger', 'bi-exclamation-triangle-fill', 'Erreur réseau. Veuillez réessayer.'); });

    fileInput.value = '';
  });

  function showStatus(type, iconClass, message) {
    alertBox.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small alert-' + type;
    icon.className = 'bi ' + iconClass + ' text-' + type;
    icon.classList.remove('d-none');
    msgEl.textContent = message;
  }
})();
</script>
                    </div>
                  </div>
                </div>
              </div>

