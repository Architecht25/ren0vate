                  data-bs-toggle="pill" data-bs-target="#tab-profil"
                  type="button" role="tab">
            <i class="bi bi-person me-2"></i>Profil
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link px-4 py-2 rounded-3" id="tab-finances-btn"
