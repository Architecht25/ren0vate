<div class="container-fluid px-4 py-3">
  <!-- Header compact avec avatar -->
  <div class="row justify-content-center mb-3">
    <div class="col-lg-10">
      <div class="text-center">
        <div class="bg-primary bg-gradient rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
          <i class="bi bi-person text-white fs-4"></i>
        </div>
        <h1 class="h3 text-dark fw-light mb-1">Mon Profil</h1>
        <p class="text-muted small">Gérez vos informations personnelles et préférences</p>
      </div>
    </div>
  </div>

  <!-- Message d'information -->
  <div class="row justify-content-center mb-3">
    <div class="col-lg-10">
      <div class="alert alert-info border-0" style="background-color: #e8f4f8;">
        <div class="d-flex align-items-start">
          <i class="bi bi-info-circle me-3 mt-1" style="font-size: 1.2rem;"></i>
          <p class="mb-0">
            Commencez par le début ! Renseigner vos données personnelles est essentiel pour profiter pleinement de Ren0vate. Ces informations seront utilisées pour les aspects financiers de votre projet, notamment pour le calcul des primes auxquelles vous avez droit et pour vos demandes de prêts. Un profil complet vous permettra également de recevoir des conseils personnalisés adaptés à votre situation.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Formulaire avec design moderne -->
  <%= form_with model: current_user, url: profile_path, method: :patch, local: true, class: "needs-validation", novalidate: true do |f| %>

    <!-- Première rangée: Informations principales -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 1: Informations personnelles -->
          <div class="col-lg-6">
            <div class="card h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-person text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Informations personnelles</h5>
                    <p class="text-muted small mb-0">Vos données d'identité</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-md-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-person-badge me-2 text-primary"></i>Prénom
                    </label>
                    <%= f.text_field :first_name,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "Votre prénom" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-person-badge me-2 text-primary"></i>Nom
                    </label>
                    <%= f.text_field :last_name,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "Votre nom de famille" %>
                  </div>
                  <div class="col-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-envelope me-2 text-primary"></i>Adresse email
                    </label>
                    <%= f.email_field :email,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "votre@email.com" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-telephone me-2 text-primary"></i>Téléphone
                    </label>
                    <%= f.telephone_field :phone,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "+32 xxx xx xx xx" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-bank me-2 text-primary"></i>Numéro de registre national
                    </label>
                    <%= f.text_field :national_number,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "Ex: 77.15.06.123.88" %>
                  </div>
                  <% rib_derniere = current_user.rib_donnees.order(created_at: :desc).first %>
                  <div class="col-md-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-bank me-2 text-primary"></i>IBAN
                    </label>
                    <div class="d-flex gap-2 align-items-start">
                      <%= f.text_field :iban,
                          id: 'user_iban',
                          class: "form-control border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;",
                          placeholder: "Ex: BE68 5390 0754 7034" %>
                      <button type="button"
                              id="btn-scan-rib"
                              class="btn btn-outline-primary btn-sm rounded-3 flex-shrink-0"
                              style="height: 38px; white-space: nowrap;"
                              data-bs-toggle="tooltip"
                              title="Scanner votre RIB pour remplir automatiquement l'IBAN">
                        <i class="bi bi-upc-scan"></i>
                      </button>
                      <input type="file" id="rib-file-input" accept=".pdf,image/jpeg,image/png" class="d-none">
                    </div>
                    <!-- Nom de la banque -->
                    <small id="rib-nom-banque" class="text-muted mt-1 ms-1<%= rib_derniere&.nom_banque ? '' : ' d-none' %>">
                      <i class="bi bi-building me-1"></i><span id="rib-nom-banque-text"><%= rib_derniere&.nom_banque %></span>
                    </small>
                    <!-- Zone statut OCR RIB -->
                    <div id="rib-ocr-status" class="d-none mt-1">
                      <div class="alert border-0 rounded-2 py-1 px-2 mb-0 small" id="rib-ocr-alert">
                        <div class="d-flex align-items-center gap-2">
                          <div id="rib-ocr-spinner" class="spinner-border spinner-border-sm text-primary d-none" role="status"></div>
                          <i id="rib-ocr-icon" class="bi d-none"></i>
                          <span id="rib-ocr-message"></span>
                        </div>
                      </div>
                    </div>
                  </div>

<script nonce="<%= content_security_policy_nonce %>">
(function () {
  const btnScan   = document.getElementById('btn-scan-rib');
  const fileInput = document.getElementById('rib-file-input');
  const statusZone = document.getElementById('rib-ocr-status');
  const alertBox  = document.getElementById('rib-ocr-alert');
  const spinner   = document.getElementById('rib-ocr-spinner');
  const icon      = document.getElementById('rib-ocr-icon');
  const msgEl     = document.getElementById('rib-ocr-message');
  const fieldIban     = document.getElementById('user_iban');
  const nomBanqueEl   = document.getElementById('rib-nom-banque');
  const nomBanqueText = document.getElementById('rib-nom-banque-text');

  btnScan.addEventListener('click', function () { fileInput.click(); });

  fileInput.addEventListener('change', function () {
    const file = fileInput.files[0];
    if (!file) return;

    statusZone.classList.remove('d-none');
    alertBox.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small alert-secondary';
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    msgEl.textContent = 'Lecture du RIB…';
    btnScan.disabled = true;

    const formData = new FormData();
    formData.append('file', file);

    fetch('<%= ocr_scan_rib_path %>', {
      method: 'POST',
      headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') },
      body: formData
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      spinner.classList.add('d-none');
      btnScan.disabled = false;

      if (!data.success) {
        showStatus('danger', 'bi-exclamation-triangle-fill', data.error || 'Extraction échouée.');
        return;
      }

      if (data.iban) {
        // Insérer l'IBAN formaté avec les espaces (BE68 5390 0754 7034)
        fieldIban.value = data.iban_formate || data.iban;
        fieldIban.classList.add('border-primary');
      }

      if (data.nom_banque) {
        nomBanqueText.textContent = data.nom_banque;
        nomBanqueEl.classList.remove('d-none');
      } else {
        nomBanqueEl.classList.add('d-none');
      }

      var type = data.extraction_complete ? 'success' : 'warning';
      var ic   = data.extraction_complete ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill';
      showStatus(type, ic, data.message);
    })
    .catch(function () {
      spinner.classList.add('d-none');
      btnScan.disabled = false;
      showStatus('danger', 'bi-exclamation-triangle-fill', 'Erreur réseau. Veuillez réessayer.');
    });

    fileInput.value = '';
  });

  function showStatus(type, iconClass, message) {
    alertBox.className = 'alert border-0 rounded-2 py-1 px-2 mb-0 small alert-' + type;
    icon.className = 'bi ' + iconClass + ' text-' + type;
    icon.classList.remove('d-none');
    msgEl.textContent = message;
  }
})();
</script>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 2: Adresse et localisation -->
          <div class="col-lg-6">
            <div class="card h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                    <i class="bi bi-geo-alt text-white fs-6"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-0 text-dark fw-normal">Adresse et localisation</h5>
                    <p class="text-muted small mb-0">Votre lieu de résidence</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="row g-2">
                  <div class="col-md-8">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-signpost me-2 text-success"></i>Rue
                    </label>
                    <%= f.text_field :street,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "Nom de la rue" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-hash me-2 text-success"></i>Numéro
                    </label>
                    <%= f.text_field :number,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "N°" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-mailbox me-2 text-success"></i>Code postal
                    </label>
                    <%= f.text_field :postal_code,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "1000" %>
                  </div>
                  <div class="col-md-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-building me-2 text-success"></i>Ville
                    </label>
                    <%= f.text_field :city,
                        class: "form-control border-2 rounded-3 px-3",
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: "Bruxelles" %>
                  </div>
                  <div class="col-4">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-map me-2 text-success"></i>Région
                    </label>
                    <%= f.select :region,
                        options_for_select([
                          ['Bruxelles-Capitale', 'bruxelles'],
                          ['Wallonie', 'wallonie'],
                          ['Flandre', 'flandre']
                        ], current_user.region),
                        { prompt: 'Sélectionnez votre région...' },
                        { class: "form-select border-2 rounded-3 px-3",
                          style: "background: #f8f9fa; border-color: #e9ecef !important;" } %>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Deuxième rangée: Revenus et famille -->
    <div class="row justify-content-center mb-3">
      <div class="col-lg-10">
        <div class="row g-3">

          <!-- Carte 3: Revenus -->
          <div class="col-lg-8">
            <div class="card h-100">
              <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center">
                    <div class="bg-warning bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                      <i class="bi bi-currency-euro text-white fs-6"></i>
                    </div>
                    <div>
                      <h5 class="card-title mb-0 text-dark fw-normal">Informations fiscales</h5>
                      <p class="text-muted small mb-0">Vos revenus pour le calcul des primes</p>
                    </div>
                  </div>
                  <!-- Bouton scan AER -->
                  <div>
                    <button type="button"
                            id="btn-scan-aer"
                            class="btn btn-outline-warning btn-sm rounded-3 px-3"
                            data-bs-toggle="tooltip"
                            title="Uploadez votre Avertissement-Extrait de Rôle pour remplir automatiquement ces champs">
                      <i class="bi bi-file-earmark-text me-1"></i>Scanner mon AER
                    </button>
                    <input type="file" id="aer-file-input" accept=".pdf,image/jpeg,image/png" class="d-none">
                  </div>
                </div>
              </div>

              <!-- Zone d'info AER (masquée par défaut) -->
              <div id="aer-info-banner" class="d-none mx-4 mb-0">
                <div class="alert alert-warning border-0 rounded-3 py-2 mb-0">
                  <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-lightbulb-fill text-warning mt-1 flex-shrink-0"></i>
                    <div class="small">
                      <strong>Qu'est-ce que l'AER ?</strong> L'Avertissement-Extrait de Rôle est le document fiscal que le SPF Finances vous envoie chaque année. Il récapitule votre imposition et mentionne vos <strong>revenus nets imposables globalement</strong> — la donnée clé pour le calcul des primes et prêts rénovation. Vous le trouverez aussi sur <a href="https://www.myminfin.be" target="_blank" rel="noopener" class="text-warning fw-medium">MyMinfin.be</a>.
                      <br><em class="text-muted">Formats acceptés : PDF, JPEG, PNG (max 10 MB).</em>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Zone de progression OCR (masquée par défaut) -->
              <div id="aer-ocr-status" class="d-none mx-4 mt-2">
                <div class="alert border-0 rounded-3 py-2 mb-0" id="aer-ocr-alert">
                  <div class="d-flex align-items-center gap-2">
                    <div id="aer-ocr-spinner" class="spinner-border spinner-border-sm text-warning d-none" role="status"></div>
                    <i id="aer-ocr-icon" class="bi d-none"></i>
                    <span id="aer-ocr-message" class="small"></span>
                  </div>
                </div>
              </div>

              <div class="card-body px-4 py-3">
                <div class="row g-3">
                  <!-- Revenus demandeur -->
                  <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3">
                      <h6 class="text-dark mb-3">
                        <i class="bi bi-person-check me-2 text-warning"></i>Vos revenus
                      </h6>
                      <label class="form-label text-dark fw-medium mb-1">Revenus Imposables Globalement</label>
                      <div class="row g-2">
                        <div class="col-8">
                          <%= f.number_field :revenu_demandeur,
                              id: 'user_revenu_demandeur',
                              class: 'form-control border-2 rounded-3 px-3',
                              style: "background: white; border-color: #e9ecef !important;",
                              placeholder: 'Ex 21 374',
                              min: 0,
                              step: 1 %>
                        </div>
                        <div class="col-4">
                          <%= f.select :annee_revenus_demandeur,
                              [[2025, '2025'], [2024, '2024'], [2023, '2023'], [2022, '2022'], [2021, '2021']],
                              { prompt: 'Année' },
                              id: 'user_annee_revenus_demandeur',
                              class: 'form-select border-2 rounded-3',
                              style: "background: white; border-color: #e9ecef !important;" %>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Revenus conjoint -->
                  <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3">
                      <h6 class="text-dark mb-3">
                        <i class="bi bi-people me-2 text-warning"></i>Revenus du conjoint
                      </h6>
                      <label class="form-label text-dark fw-medium mb-1">Revenus Imposables Globalement</label>
                      <div class="mb-2">
                        <small class="text-muted">Si vous êtes en couple</small>
                      </div>
                      <div class="row g-2">
                        <div class="col-8">
                          <%= f.number_field :revenu_conjoint,
                              id: 'user_revenu_conjoint',
                              class: 'form-control border-2 rounded-3 px-3',
                              style: "background: white; border-color: #e9ecef !important;",
                              placeholder: 'Ex: 19 671',
                              min: 0,
                              step: 1 %>
                        </div>
                        <div class="col-4">
                          <%= f.select :annee_revenus_conjoint,
                              [[2025, '2025'], [2024, '2024'], [2023, '2023'], [2022, '2022'], [2021, '2021']],
                              { prompt: 'Année' },
                              id: 'user_annee_revenus_conjoint',
                              class: 'form-select border-2 rounded-3',
                              style: "background: white; border-color: #e9ecef !important;" %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div><!-- /row revenus -->

                <!-- Badge confirmation AER scanné -->
                <div id="aer-scanned-badge" class="d-none mt-3">
                  <div class="d-flex align-items-center gap-2 text-success small">
                    <i class="bi bi-patch-check-fill"></i>
                    <span>Données pré-remplies depuis votre AER — vérifiez et sauvegardez.</span>
                  </div>
                </div>

              </div><!-- /card-body -->
            </div><!-- /card -->
          </div><!-- /col-lg-8 -->

<script nonce="<%= content_security_policy_nonce %>">
(function () {
  const btnScan    = document.getElementById('btn-scan-aer');
  const fileInput  = document.getElementById('aer-file-input');
  const infoBanner = document.getElementById('aer-info-banner');
  const statusZone = document.getElementById('aer-ocr-status');
  const alertBox   = document.getElementById('aer-ocr-alert');
  const spinner    = document.getElementById('aer-ocr-spinner');
  const icon       = document.getElementById('aer-ocr-icon');
  const msgEl      = document.getElementById('aer-ocr-message');
  const badge      = document.getElementById('aer-scanned-badge');

  // Champs cibles à pré-remplir
  const fieldRevenuDemandeur  = document.getElementById('user_revenu_demandeur');
  const fieldRevenuConjoint   = document.getElementById('user_revenu_conjoint');
  const fieldAnneeDemandeur   = document.getElementById('user_annee_revenus_demandeur');
  const fieldAnneeConjoint    = document.getElementById('user_annee_revenus_conjoint');

  // ── Formatage belge : 41691.27 → "41.691,27" (nl-BE : point milliers, virgule déc.)
  function formatBE(num) {
    if (num == null) return '—';
    return Number(num).toLocaleString('nl-BE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Premier clic → afficher la bannière pédagogique + ouvrir le sélecteur
  btnScan.addEventListener('click', function () {
    infoBanner.classList.remove('d-none');
    fileInput.click();
  });

  fileInput.addEventListener('change', function () {
    const file = fileInput.files[0];
    if (!file) return;

    // UI : démarrage
    statusZone.classList.remove('d-none');
    alertBox.className = 'alert border-0 rounded-3 py-2 mb-0 alert-secondary';
    spinner.classList.remove('d-none');
    icon.classList.add('d-none');
    msgEl.textContent = 'Analyse de votre AER en cours…';
    btnScan.disabled = true;

    const formData = new FormData();
    formData.append('file', file);

    fetch('<%= ocr_scan_aer_path %>', {
      method: 'POST',
      headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content') },
      body: formData
    })
    .then(function (response) { return response.json(); })
    .then(function (data) {
      spinner.classList.add('d-none');
      btnScan.disabled = false;

      if (!data.success) {
        showStatus('danger', 'bi-exclamation-triangle-fill', data.error || 'Extraction échouée.');
        return;
      }

      // Pré-remplir les champs avec la valeur entière arrondie (colonnes integer du profil)
      if (data.revenu_demandeur) {
        fieldRevenuDemandeur.value = Math.round(data.revenu_demandeur);
        fieldRevenuDemandeur.classList.add('border-warning');
      }
      if (data.revenu_conjoint) {
        fieldRevenuConjoint.value = Math.round(data.revenu_conjoint);
        fieldRevenuConjoint.classList.add('border-warning');
      }
      if (data.annee_revenus) {
        setSelectValue(fieldAnneeDemandeur, data.annee_revenus);
        if (data.revenu_conjoint) setSelectValue(fieldAnneeConjoint, data.annee_revenus);
      }

      // Message de retour avec montants formatés en nl-BE
      var lignesMontants = [];
      if (data.revenu_demandeur)  lignesMontants.push('Vous : ' + formatBE(data.revenu_demandeur) + ' €');
      if (data.revenu_conjoint)   lignesMontants.push('Conjoint : ' + formatBE(data.revenu_conjoint) + ' €');
      var suffixeMontants = lignesMontants.length ? ' (' + lignesMontants.join(' · ') + ')' : '';

      const alertClass = data.revenus_potentiellement_perimes ? 'alert-warning'
                       : data.extraction_complete            ? 'alert-success'
                                                             : 'alert-warning';
      const iconClass  = data.revenus_potentiellement_perimes ? 'bi-clock-history'
                       : data.extraction_complete            ? 'bi-check-circle-fill'
                                                             : 'bi-exclamation-circle-fill';
      showStatus(alertClass.replace('alert-', ''), iconClass, data.message + suffixeMontants);

      if (data.revenu_demandeur || data.revenu_conjoint) {
        badge.classList.remove('d-none');
      }
    })
    .catch(function (err) {
      spinner.classList.add('d-none');
      btnScan.disabled = false;
      showStatus('danger', 'bi-exclamation-triangle-fill', 'Erreur réseau. Veuillez réessayer.');
    });

    // Réinitialiser l'input pour permettre un nouvel upload du même fichier
    fileInput.value = '';
  });

  function showStatus(type, iconClass, message) {
    alertBox.className = 'alert border-0 rounded-3 py-2 mb-0 alert-' + type;
    icon.className = 'bi ' + iconClass + ' text-' + type;
    icon.classList.remove('d-none');
    msgEl.textContent = message;
  }

  function setSelectValue(selectEl, value) {
    if (!selectEl) return;
    Array.from(selectEl.options).forEach(function (opt) {
      opt.selected = (opt.value === String(value));
    });
  }
})();
</script>

          <!-- Carte 4: Situation familiale -->
          <div class="col-lg-4">
            <div class="card h-100">
              <div class="card-header bg-white border-0 pt-4">
                <div class="d-flex align-items-center">
                  <div class="bg-info bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-people text-white fs-5"></i>
                  </div>
                  <div>
                    <h5 class="card-title mb-1 text-dark fw-normal">Famille</h5>
                    <p class="text-muted small mb-0">Votre situation</p>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 pb-4">
                <div class="row g-3">
                  <div class="col-6">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-heart me-2 text-info"></i>Situation familiale
                    </label>
                    <%= f.select :situation_familiale,
                        [['Couple', 'couple'], ['Isolé', 'isole'], ['Isolé avec enfant à charge', 'isole_avec_enfant']],
                        { prompt: 'Sélectionnez...' },
                        class: 'form-select border-2 rounded-3 px-3',
                        style: "background: #f8f9fa; border-color: #e9ecef !important;" %>
                  </div>
                  <div class="col-6">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-person-hearts me-2 text-info"></i>Enfants à charge
                    </label>
                    <%= f.number_field :nombre_enfants,
                        class: 'form-control border-2 rounded-3 px-3',
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: '0',
                        min: 0 %>
                  </div>
                </div>

                <!-- Nouveaux champs pour déductions fiscales Wallonie -->
                <div class="row g-3 mt-2">
                  <div class="col-12">
                    <div class="alert alert-info border-0 rounded-3 mb-0">
                      <small><i class="bi bi-info-circle me-1"></i><strong>Wallonie:</strong> Ces informations permettent des déductions de 5.000€ chacune sur vos revenus imposables.</small>
                    </div>
                  </div>
                  <div class="col-6">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-person-badge me-2 text-info"></i>Personnes de 60 ans et plus
                    </label>
                    <%= f.number_field :personnes_60_ans_et_plus,
                        class: 'form-control border-2 rounded-3 px-3',
                        style: "background: #f8f9fa; border-color: #e9ecef !important;",
                        placeholder: '0',
                        min: 0 %>
                    <small class="text-muted">Nombre de personnes de 60 ans et plus dans le ménage</small>
                  </div>
                  <div class="col-6">
                    <label class="form-label text-dark fw-medium mb-1">
                      <i class="bi bi-heart-pulse me-2 text-info"></i>Femme enceinte
                    </label>
                    <%= f.select :femme_enceinte,
                        [['Non', false], ['Oui', true]],
                        { include_blank: 'Sélectionnez...' },
                        class: 'form-select border-2 rounded-3 px-3',
                        style: "background: #f8f9fa; border-color: #e9ecef !important;" %>
                    <small class="text-muted">Y a-t-il une femme enceinte dans le ménage ?</small>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Troisième rangée: Actions et sécurité -->
    <div class="row justify-content-center mb-5">
      <div class="col-lg-10">
        <div class="row g-4">

          <!-- Carte 5: Actions principales -->
          <div class="col-lg-4">
            <div class="card h-100">
              <div class="card-header bg-white border-0 py-2">
                <div class="d-flex align-items-center">
                  <div class="bg-primary bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                    <i class="bi bi-gear text-white"></i>
                  </div>
                  <div>
                    <h6 class="card-title mb-0 text-dark fw-normal">Actions</h6>
                    <small class="text-muted">Gérer votre profil</small>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="d-grid gap-2">
                  <%= f.button type: 'submit', class: 'btn btn-primary rounded-3 py-2 fw-medium' do %>
                    <i class="bi bi-check2-circle me-2"></i>Sauvegarder les modifications
                  <% end %>
                  <%= link_to dashboard_path, class: "btn btn-outline-secondary rounded-3 py-2" do %>
                    <i class="bi bi-arrow-left me-2"></i>Retour au tableau de bord
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 6: Sécurité -->
          <div class="col-lg-4">
            <div class="card h-100">
              <div class="card-header bg-white border-0 py-2">
                <div class="d-flex align-items-center">
                  <div class="bg-danger bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                    <i class="bi bi-shield-lock text-white"></i>
                  </div>
                  <div>
                    <h6 class="card-title mb-0 text-dark fw-normal">Sécurité</h6>
                    <small class="text-muted">Protéger votre compte</small>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="d-grid gap-2">
                  <%= link_to edit_user_registration_path, class: "btn btn-outline-danger rounded-3 py-2" do %>
                    <i class="bi bi-key me-2"></i>Changer le mot de passe
                  <% end %>
                  <button type="button" class="btn btn-outline-warning rounded-3 py-2" disabled>
                    <i class="bi bi-shield-check me-2"></i>Double authentification
                    <small class="d-block text-muted mt-1">Bientôt disponible</small>
                  </button>

                  <!-- Séparateur pour zone dangereuse -->
                  <hr class="my-2">

                  <!-- Zone dangereuse intégrée -->
                  <div class="border border-danger rounded-3 p-2 bg-light bg-opacity-50">
                    <div class="d-flex align-items-start">
                      <div class="bg-danger bg-gradient rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width: 25px; height: 25px;">
                        <i class="bi bi-exclamation-triangle text-white small"></i>
                      </div>
                      <div class="flex-grow-1">
                        <h6 class="text-danger mb-1 fw-medium small">Zone dangereuse</h6>
                        <p class="text-muted small mb-2">Suppression définitive et irréversible.</p>
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-3" data-bs-toggle="modal" data-bs-target="#deleteAccountModal">
                          <i class="bi bi-person-x me-1"></i>Supprimer mon compte
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Carte 7: Paiements -->
          <div class="col-lg-4">
            <div class="card h-100">
              <div class="card-header bg-white border-0 py-2">
                <div class="d-flex align-items-center">
                  <div class="bg-success bg-gradient rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                    <i class="bi bi-credit-card text-white"></i>
                  </div>
                  <div>
                    <h6 class="card-title mb-0 text-dark fw-normal">Paiements</h6>
                    <small class="text-muted">Moyens de paiement</small>
                  </div>
                </div>
              </div>
              <div class="card-body px-4 py-3">
                <div class="d-grid gap-2">
                  <button type="button" class="btn btn-outline-success rounded-3 py-2" disabled>
                    <i class="bi bi-stripe me-2"></i>Configurer Stripe
                    <small class="d-block text-muted mt-1">Bientôt disponible</small>
                  </button>
                  <button type="button" class="btn btn-outline-info rounded-3 py-2" disabled>
                    <i class="bi bi-receipt me-2"></i>Historique des paiements
                    <small class="d-block text-muted mt-1">Bientôt disponible</small>
                  </button>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

  <% end %>
</div>

<!-- CSS personnalisé pour le design professionnel -->
<style>
  .form-control:focus, .form-select:focus {
    border-color: #0d6efd !important;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15) !important;
  }

  .card {
    transition: all 0.3s ease;
  }

  .card:hover {
    transform: translateY(-2px);
  }

  .btn {
    transition: all 0.2s ease;
  }

  .btn:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .bg-light {
    background-color: #f8f9fa !important;
  }
</style>

<!-- Modal Supprimer compte avec design moderne -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-4">
      <div class="modal-header border-0 pb-0">
        <div class="w-100 text-center">
          <div class="bg-danger bg-gradient rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-exclamation-triangle text-white fs-4"></i>
          </div>
          <h5 class="modal-title text-danger fw-normal" id="deleteAccountModalLabel">
            Supprimer définitivement le compte
          </h5>
        </div>
        <button type="button" class="btn-close position-absolute" style="top: 15px; right: 15px;" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body px-4 py-3">
        <div class="alert alert-danger border-0 rounded-3">
          <h6 class="alert-heading text-danger fw-medium">⚠️ Attention - Action irréversible</h6>
          <p class="mb-3">Cette action supprimera définitivement et sans possibilité de récupération :</p>
          <ul class="mb-0">
            <li>Votre profil et toutes vos informations personnelles</li>
            <li>Toutes vos propriétés enregistrées</li>
            <li>Tous vos projets de rénovation</li>
            <li>Toutes vos demandes de primes</li>
            <li>L'historique complet de votre activité</li>
          </ul>
        </div>
        <div class="text-center">
          <p class="text-muted mb-3">
            <strong>Êtes-vous absolument certain de vouloir continuer ?</strong>
          </p>
          <%= link_to cancel_user_registration_path,
              class: "btn btn-danger btn-lg rounded-3 px-4",
              method: :get,
              data: {
                confirm: "⚠️ DERNIÈRE CONFIRMATION ⚠️\n\nVous êtes sur le point de supprimer définitivement votre compte.\n\nCette action ne peut PAS être annulée.\n\nTapez 'SUPPRIMER' pour confirmer définitivement :",
                turbo_confirm: "SUPPRIMER"
              } do %>
            <i class="bi bi-person-x me-2"></i>Oui, supprimer mon compte définitivement
          <% end %>
        </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-outline-secondary btn-lg rounded-3 flex-fill" data-bs-dismiss="modal">
          <i class="bi bi-shield-check me-2"></i>Non, conserver mon compte
        </button>
      </div>
    </div>
  </div>
</div>
