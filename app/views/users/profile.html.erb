<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mon Profil</h1>
    <div>
      <%= link_to root_path, class: 'btn btn-light' do %>
        <i class="bi bi-arrow-left me-1"></i>Retour
      <% end %>
    </div>
  </div>

  <!-- Formulaire avec style harmonisé -->
  <%= form_with model: current_user, url: user_path(current_user), method: :patch, local: true do |f| %>
    <div class="card border-0 bg-light-custom shadow-sm p-4 mb-4 rounded mx-auto" style="max-width: 800px;">
      <div class="card-body">
        <div class="mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-person"></i>
            </div>
            <h5 class="mb-0 fw-normal text-primary-custom">Données personnelles</h5>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :last_name, 'Nom', class: 'form-label small text-muted-custom' %>
              <%= f.text_field :last_name, class: 'form-control', placeholder: 'Nom complet' %>
            </div>
            <div class="col-md-6">
              <%= f.label :first_name, 'Prénom', class: 'form-label small text-muted-custom' %>
              <%= f.text_field :first_name, class: 'form-control', placeholder: 'Prénom' %>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-envelope"></i>
            </div>
            <h5 class="mb-0 fw-normal text-primary-custom">Coordonnées</h5>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <%= f.label :email, 'Email', class: 'form-label small text-muted-custom' %>
              <%= f.email_field :email, class: 'form-control', placeholder: 'Email' %>
            </div>
            <div class="col-md-6">
              <%= f.label :phone, 'Téléphone', class: 'form-label small text-muted-custom' %>
              <%= f.telephone_field :phone, class: 'form-control', placeholder: 'ex. 0471 23 45 67' %>
            </div>
          </div>
        </div>

        <div class="mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-credit-card"></i>
            </div>
            <h5 class="mb-0 fw-normal text-primary-custom">Compte bancaire</h5>
          </div>
          <%= f.label :iban, 'IBAN', class: 'form-label small text-muted-custom' %>
          <%= f.text_field :iban, class: 'form-control', placeholder: 'IBAN du compte bancaire - BExx xxxx xxxx xxxx' %>
        </div>

        <div class="mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-geo-alt"></i>
            </div>
            <h5 class="mb-0 fw-normal text-primary-custom">Adresse de résidence</h5>
          </div>
          <div class="mb-3">
            <%= f.label :street, 'Rue', class: 'form-label small text-muted-custom' %>
            <%= f.text_field :street, class: 'form-control', placeholder: 'ex. Rue de l Énergie' %>
          </div>
          <div class="row g-3">
            <div class="col-md-4">
              <%= f.label :number, 'Numéro', class: 'form-label small text-muted-custom' %>
              <%= f.text_field :number, class: 'form-control', placeholder: 'ex. 24' %>
            </div>
            <div class="col-md-4">
              <%= f.label :postal_code, 'Code postal', class: 'form-label small text-muted-custom' %>
              <%= f.text_field :postal_code, class: 'form-control', placeholder: 'ex. 1190' %>
            </div>
            <div class="col-md-4">
              <%= f.label :city, 'Commune', class: 'form-label small text-muted-custom' %>
              <%= f.text_field :city, class: 'form-control', placeholder: 'ex. Forest' %>
            </div>
          </div>
          <div class="mb-3 mt-3">
            <%= f.label :region, 'Région', class: 'form-label small text-muted-custom' %>
            <%= f.select :region, [['Flandre', 'flandre'], ['Bruxelles-Capitale', 'bruxelles'], ['Wallonie', 'wallonie']], { prompt: '-- Sélectionnez une région --' }, class: 'form-select' %>
          </div>
        </div>

        <div class="mb-4">
          <div class="d-flex align-items-center mb-3">
            <div class="icon-circle me-3">
              <i class="bi bi-shield-check"></i>
            </div>
            <h5 class="mb-0 fw-normal text-primary-custom">Statut client</h5>
          </div>
          <div class="form-check form-check-inline">
            <%= f.radio_button :protected_client, 'oui', class: 'form-check-input' %>
            <%= f.label :protected_client_oui, 'Client protégé', class: 'form-check-label' %>
          </div>
          <div class="form-check form-check-inline">
            <%= f.radio_button :protected_client, 'non', class: 'form-check-input' %>
            <%= f.label :protected_client_non, 'Client standard', class: 'form-check-label' %>
          </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
          <%= link_to root_path, class: 'btn btn-light me-2' do %>
            <i class="bi bi-arrow-left me-1"></i>Retour
          <% end %>
          <%= f.button type: 'submit', class: 'btn btn-primary-custom px-4' do %>
            <i class="bi bi-check-lg me-1"></i>Enregistrer
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
