<h1 class="text-center mb-4">Liste des utilisateurs</h1>

<div class="card shadow-sm p-4 mb-5 bg-white rounded mx-auto" style="max-width: 800px;">
  <ul class="list-group">
    <% @users.each do |user| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <span><%= user.first_name %></span>
        <%= link_to 'Voir le profil', user_path(user), class: 'btn btn-primary btn-sm' %>
      </li>
    <% end %>
  </ul>

  <div class="d-flex justify-content-center mt-4">
    <%= link_to 'Nouvel utilisateur', new_user_path, class: 'btn btn-success btn-lg' %>
  </div>
</div>
