<%
  # Récupération des données pour le dashboard simplifié
  # Si @project n'existe pas, on utilise le projet de la simulation du Decision Hub
  project = @project || @default_simulation&.project

  if project && project.factures.any?
    factures = project.factures.includes(:document)
    analyse = FactureValidationService.new(project).analyser_ensemble
  else
    factures = []
    analyse = {
      total_factures: 0,
      pourcentage_budget: 0,
      alertes_delais: { status: 'ok', message: 'Aucune facture' },
      ecarts: { type: 'normal' },
      anomalies: []
    }
  end
%>

<div class="factures-dashboard-integration">
  <!-- Vue d'ensemble rapide -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 bg-light h-100">
        <div class="card-body text-center">
          <div class="h4 text-primary mb-1">
            <%= number_to_currency(analyse[:total_factures] || 0, unit: "", precision: 0) %>€
          </div>
          <small class="text-muted">Total factures</small>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 bg-light h-100">
        <div class="card-body text-center">
          <div class="h4 mb-1 <%= analyse[:pourcentage_budget] > 100 ? 'text-danger' : 'text-success' %>">
            <%= analyse[:pourcentage_budget] %>%
          </div>
          <small class="text-muted">du budget</small>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 bg-light h-100">
        <div class="card-body text-center">
          <div class="h4 text-info mb-1">
            <%= factures.count %>
          </div>
          <small class="text-muted">factures</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Alertes importantes -->
  <% if analyse[:alertes_delais][:status] != 'ok' %>
    <div class="alert alert-<%= analyse[:alertes_delais][:status] == 'critique' ? 'danger' : 'warning' %> d-flex align-items-center mb-4">
      <i class="bi bi-<%= analyse[:alertes_delais][:status] == 'critique' ? 'exclamation-triangle-fill' : 'clock-fill' %> me-2"></i>
      <div class="flex-grow-1">
        <strong><%= analyse[:alertes_delais][:status] == 'critique' ? 'URGENT' : 'Attention' %></strong>
        <br><%= analyse[:alertes_delais][:message] %>
      </div>
    </div>
  <% end %>

  <!-- Liste des factures récentes -->
  <% if factures.any? %>
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0">
          <i class="bi bi-receipt me-2"></i>Factures récentes
        </h6>
        <% if project %>
          <%= link_to "Voir détails", project_factures_path(project), class: "btn btn-sm btn-outline-primary" %>
        <% end %>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Date</th>
                <th>Fournisseur</th>
                <th>Montant</th>
                <th>Type</th>
                <th class="text-center">OCR</th>
              </tr>
            </thead>
            <tbody>
              <% factures.order(date_facture: :desc).limit(5).each do |facture| %>
                <tr>
                  <td>
                    <small class="text-muted">
                      <%= facture.date_facture&.strftime("%d/%m/%Y") || "Non défini" %>
                    </small>
                  </td>
                  <td>
                    <div class="fw-medium"><%= facture.fournisseur&.truncate(25) || "Non défini" %></div>
                  </td>
                  <td>
                    <span class="fw-bold text-primary">
                      <%= number_to_currency(facture.montant_euros || 0, unit: "", precision: 0) %>€
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-<%= facture.type_facture == 'solde' ? 'danger' : 'secondary' %>">
                      <%= facture.type_facture&.capitalize || "Standard" %>
                    </span>
                  </td>
                  <td class="text-center">
                    <% confidence = facture.confiance_ocr || 0 %>
                    <span class="badge bg-<%= confidence > 80 ? 'success' : confidence > 60 ? 'warning' : 'danger' %>">
                      <%= confidence %>%
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Actions rapides -->
    <div class="mt-3 d-flex gap-2 flex-wrap">
      <% if project %>
        <%= link_to project_factures_path(project), class: "btn btn-primary btn-sm" do %>
          <i class="bi bi-plus-circle me-1"></i>Ajouter facture
        <% end %>
        <%= link_to factures_dashboard_path(project), class: "btn btn-outline-secondary btn-sm" do %>
          <i class="bi bi-graph-up me-1"></i>Analyse complète
        <% end %>
      <% end %>
    </div>

  <% else %>
    <!-- État vide -->
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-5">
        <i class="bi bi-receipt fs-1 text-muted mb-3"></i>
        <h6 class="text-muted mb-3">Aucune facture ajoutée</h6>
        <p class="text-muted mb-4">
          Commencez par ajouter vos factures de travaux pour analyser votre budget et vérifier les délais de demande de prime.
        </p>
        <% if project %>
          <%= link_to project_factures_path(project), class: "btn btn-primary" do %>
            <i class="bi bi-plus-circle me-2"></i>Ajouter ma première facture
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<style>
.factures-dashboard-integration .card {
  transition: all 0.2s ease;
}

.factures-dashboard-integration .card:hover {
  transform: translateY(-2px);
}

.factures-dashboard-integration .table td {
  vertical-align: middle;
  padding: 0.75rem 1rem;
}

.factures-dashboard-integration .table tbody tr:hover {
  background-color: rgba(0,123,255,0.05);
}
</style>
