<h1 class="display-4 text-center mb-4">Surveillance du localStorage</h1>

<div data-controller="localstorage-monitor" class="container text-center mt-4">
  <div data-localstorage-monitor-target="output" class="table-responsive">
    <!-- Le tableau des données sera inséré ici par le contrôleur Stimulus -->
  </div>

  <!-- Formulaire d'envoi par email -->
  <div class="row justify-content-center mt-4">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">📧 Recevoir les résultats par email</h5>
        </div>
        <div class="card-body">
          <div class="input-group">
            <input
              type="email"
              class="form-control"
              placeholder="Votre adresse email"
              data-localstorage-monitor-target="emailInput"
              required
            >
            <button
              class="btn btn-primary"
              type="button"
              data-action="click->localstorage-monitor#sendByEmail"
            >
              Envoyer
            </button>
          </div>
          <small class="text-muted mt-2 d-block">
            Recevez un résumé complet de votre test de rénovation énergétique
          </small>
        </div>
      </div>
    </div>
  </div>

  <%= link_to "← Retour à l'accueil", root_path, class: "btn btn-secondary mt-3" %>
</div>

<footer class="text-center mt-5">
  <p class="text-muted">© 2025 Surveillance du localStorage. Tous droits réservés.</p>
</footer>
