<div class="container-fluid py-4">
  <!-- Header moderne -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-database text-info fs-4"></i>
              </div>
              <div>
                <h1 class="h3 mb-1 text-info">Debug localStorage</h1>
                <p class="text-muted mb-0">Surveillance des données stockées localement</p>
              </div>
            </div>
            <%= link_to root_path, class: "btn btn-outline-secondary" do %>
              <i class="bi bi-arrow-left me-2"></i>Retour à l'accueil
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenu principal -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h4 class="card-title mb-0">
            <i class="bi bi-eye text-info me-2"></i>
            Données du localStorage
          </h4>
        </div>
        <div class="card-body">
          <div id="localStorage-output" class="table-responsive">
            <!-- Les données seront affichées ici -->
          </div>

          <div class="mt-4 text-center">
            <button class="btn btn-warning me-2" onclick="refreshData()">
              <i class="bi bi-arrow-clockwise me-2"></i>Actualiser
            </button>
            <button class="btn btn-danger" onclick="clearLocalStorage()">
              <i class="bi bi-trash me-2"></i>Vider le localStorage
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function displayLocalStorageData() {
  const order = ["region", "user-type", "eligibiliteRenovate", "categorie_estimee", "statut_familial", "personnes_charge", "revenu_net", "categorie_badge", "total_primes", "details_primes"];
  const localStorageData = order.map(key => {
    const value = localStorage.getItem(key);
    return value ? { key, value } : null;
  }).filter(data => data !== null);

  const output = document.getElementById('localStorage-output');

  if (localStorageData.length === 0) {
    output.innerHTML = `
      <div class="text-center py-5">
        <div class="text-muted mb-3">
          <i class="bi bi-database fs-1"></i>
        </div>
        <h5 class="text-muted">Aucune donnée</h5>
        <p class="text-muted">Le localStorage est vide</p>
      </div>
    `;
    return;
  }

  output.innerHTML = `
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr>
          <th style="width: 25%; min-width: 200px;">Clé</th>
          <th style="width: 75%;">Valeur</th>
        </tr>
      </thead>
      <tbody>
        ${localStorageData.map(data => {
          let valueHTML;
          try {
            const parsed = JSON.parse(data.value);
            if (typeof parsed === 'object' && parsed !== null) {
              valueHTML = `
                <div class="json-container">
                  ${Object.entries(parsed).map(([k, v]) =>
                    `<div class="json-entry mb-1">
                      <span class="badge bg-secondary me-2">${k}</span>
                      <span class="fw-bold text-success">${v}</span>
                    </div>`
                  ).join('')}
                </div>
              `;
            } else {
              valueHTML = `<span class="text-success fw-bold">${data.value}</span>`;
            }
          } catch {
            valueHTML = `<span class="text-info">${data.value}</span>`;
          }

          return `
            <tr>
              <td class="fw-bold text-primary align-top">${data.key}</td>
              <td class="value-cell">${valueHTML}</td>
            </tr>
          `;
        }).join('')}
      </tbody>
    </table>
  `;
}

function refreshData() {
  displayLocalStorageData();
}

function clearLocalStorage() {
  if (confirm("Êtes-vous sûr de vouloir vider le localStorage ?")) {
    localStorage.clear();
    displayLocalStorageData();
  }
}

// Initialisation au chargement de la page
document.addEventListener('DOMContentLoaded', function() {
  displayLocalStorageData();
});
</script>

<style>
.json-container {
  max-width: 100%;
  overflow-wrap: break-word;
}
.json-entry {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.25rem;
  margin-bottom: 0.5rem;
  width: 100%;
}
.value-cell {
  word-wrap: break-word;
  max-width: none !important;
  overflow-wrap: break-word;
  white-space: normal;
  min-height: auto;
}
.table-responsive {
  overflow-x: auto;
}
.table td {
  vertical-align: top;
  max-width: none !important;
  overflow: visible !important;
}
@media (max-width: 768px) {
  .json-entry {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
