<% content_for :title, "Vérification en deux étapes" %>

<div class="auth-container">
  <div class="row justify-content-center">
    <div class="col-auto" style="min-width: 320px; max-width: 420px;">
      <div class="auth-card">

        <div class="auth-header text-center mb-4">
          <div class="auth-logo mb-3">
            <i class="bi bi-shield-lock-fill" style="font-size: 3rem; color: var(--ren0vate-primary);"></i>
          </div>
          <h2 class="auth-title">Vérification admin</h2>
          <p class="auth-subtitle text-muted">
            Un code à 6 chiffres a été envoyé à<br>
            <strong><%= current_user.email %></strong>
          </p>
        </div>

        <% if alert = flash[:alert] %>
          <div class="alert alert-danger rounded-3 py-2 mb-3 small"><%= alert %></div>
        <% end %>
        <% if notice = flash[:notice] %>
          <div class="alert alert-success rounded-3 py-2 mb-3 small"><%= notice %></div>
        <% end %>

        <%= form_with url: verify_admin_two_factor_path, method: :post, local: true, html: { class: "auth-form" } do |f| %>
          <div class="mb-3">
            <label class="form-label fw-semibold">Code de vérification</label>
            <%= f.text_field :otp_code,
                  class: "form-control form-control-lg text-center",
                  placeholder: "_ _ _ _ _ _",
                  maxlength: 6,
                  autocomplete: "one-time-code",
                  inputmode: "numeric",
                  pattern: "[0-9]{6}",
                  autofocus: true,
                  style: "letter-spacing: 8px; font-size: 1.5rem; font-weight: 700;" %>
            <div class="form-text text-muted small">Ce code expire dans 10 minutes.</div>
          </div>

          <div class="form-check mb-4">
            <%= f.check_box :remember_device, { class: "form-check-input", id: "remember_device" }, '1', '0' %>
            <label class="form-check-label small" for="remember_device">
              Se souvenir de cet appareil pendant 30 jours
            </label>
          </div>

          <%= f.submit "Vérifier", class: "btn btn-primary-custom w-100 py-2 fw-semibold" %>
        <% end %>

        <div class="text-center mt-3">
          <small class="text-muted">Vous n'avez pas reçu le code ?</small><br>
          <%= link_to "Renvoyer un nouveau code", resend_admin_two_factor_path, method: :post,
                class: "small text-primary-custom",
                data: { turbo_method: :post } %>
        </div>

      </div>
    </div>
  </div>
</div>
