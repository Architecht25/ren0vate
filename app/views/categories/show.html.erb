<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-tag"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Catégorie de revenus</h1>
        <p class="text-muted mb-0"><%= @category.description %></p>
      </div>
    </div>
    <div class="d-flex gap-2">
      <%= link_to edit_category_path(@category), class: "btn btn-warning px-4" do %>
        <i class="bi bi-pencil me-2"></i>
        Modifier
      <% end %>
      <%= link_to categories_path, class: "btn btn-outline-primary-custom px-4" do %>
        <i class="bi bi-arrow-left me-2"></i>
        Retour à la liste
      <% end %>
    </div>
  </div>

  <!-- Contenu principal -->
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="row g-3 justify-content-center">
        <!-- Informations générales -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 text-center">
              <div class="icon-circle mx-auto mb-3" style="width: 45px; height: 45px;">
                <i class="bi bi-info-circle"></i>
              </div>
              <h6 class="card-title text-primary-custom mb-3">Informations</h6>
              <div class="mb-2">
                <small class="text-muted-custom d-block">Code</small>
                <strong class="text-dark"><%= @category.code %></strong>
              </div>
              <div>
                <small class="text-muted-custom d-block">Description</small>
                <span class="text-dark"><%= @category.description %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Seuils de revenus -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 text-center">
              <div class="icon-circle mx-auto mb-3" style="width: 45px; height: 45px;">
                <i class="bi bi-calculator"></i>
              </div>
              <h6 class="card-title text-primary-custom mb-3">Seuils de revenus</h6>
              <div class="row g-2">
                <div class="col-6">
                  <div class="bg-light-custom rounded p-2">
                    <small class="text-muted-custom d-block mb-1">Seul</small>
                    <strong class="text-success small"><%= number_with_delimiter(@category.seuil_seul) %>€</strong>
                  </div>
                </div>
                <div class="col-6">
                  <div class="bg-light-custom rounded p-2">
                    <small class="text-muted-custom d-block mb-1">Avec charge</small>
                    <strong class="text-success small"><%= number_with_delimiter(@category.seuil_seul_avec_charge) %>€</strong>
                  </div>
                </div>
                <div class="col-6">
                  <div class="bg-light-custom rounded p-2">
                    <small class="text-muted-custom d-block mb-1">Couple</small>
                    <strong class="text-success small"><%= number_with_delimiter(@category.couple_sans_charge) %>€</strong>
                  </div>
                </div>
                <div class="col-6">
                  <div class="bg-light-custom rounded p-2">
                    <small class="text-muted-custom d-block mb-1">Par personne +</small>
                    <strong class="text-info small">+<%= number_with_delimiter(@category.increment_par_personne) %>€</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Conditions d'éligibilité -->
        <div class="col-md-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 text-center">
              <div class="icon-circle mx-auto mb-3" style="width: 45px; height: 45px;">
                <i class="bi bi-gear"></i>
              </div>
              <h6 class="card-title text-primary-custom mb-3">Conditions</h6>
              <div class="d-grid gap-2">
                <div class="d-flex align-items-center justify-content-between bg-light-custom rounded p-2">
                  <small class="text-muted-custom">Autre bien</small>
                  <% if @category.autre_bien_interdit %>
                    <span class="badge bg-danger">Non</span>
                  <% else %>
                    <span class="badge bg-success">Oui</span>
                  <% end %>
                </div>
                <div class="d-flex align-items-center justify-content-between bg-light-custom rounded p-2">
                  <small class="text-muted-custom">Location sociale</small>
                  <% if @category.location_sociale_autorisee %>
                    <span class="badge bg-success">Oui</span>
                  <% else %>
                    <span class="badge bg-danger">Non</span>
                  <% end %>
                </div>
                <div class="d-flex align-items-center justify-content-between bg-light-custom rounded p-2">
                  <small class="text-muted-custom">Verbouwlening</small>
                  <% if @category.eligible_pour_verbouwlening %>
                    <span class="badge bg-success">Oui</span>
                  <% else %>
                    <span class="badge bg-danger">Non</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Actions compactes -->
      <div class="text-center mt-4">
        <%= link_to root_path, class: "btn btn-primary-custom btn-sm px-4" do %>
          <i class="bi bi-house me-2"></i>Retour à l'accueil
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
