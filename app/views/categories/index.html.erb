<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-tags"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Catégories de revenus</h1>
    </div>
    <%= link_to root_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à l'accueil
    <% end %>
  </div>

  <!-- Liste des catégories groupées par région -->
  <% categories_with_region = @categories.select { |category| category.region.present? } %>
  <% if categories_with_region.any? %>
    <% categories_by_region = categories_with_region.group_by(&:region) %>

    <!-- Flandre -->
    <% if categories_by_region['flandre']&.any? %>
      <div class="mb-5">
        <h4 class="mb-3 text-center" style="color: #000000;">
          <i class="bi bi-tag me-2"></i>Flandre
        </h4>
        <div class="row g-4 justify-content-center">
          <% categories_by_region['flandre'].each do |category| %>
            <div class="col-lg-3 col-md-6">
              <%= link_to category_path(category), class: "text-decoration-none" do %>
                <div class="bg-light p-4 rounded text-center h-100">
                  <!-- Icône circulaire -->
                  <div class="icon-circle mx-auto mb-3" style="width: 50px; height: 50px; background-color: #000000; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-tag" style="color: #ffffff; font-size: 20px;"></i>
                  </div>
                  <!-- Titre de la catégorie -->
                  <h6 class="mb-0 fw-bold" style="color: #000000;">
                    <%= category.description %>
                  </h6>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Bruxelles -->
    <% if categories_by_region['bruxelles']&.any? %>
      <div class="mb-5">
        <h4 class="mb-3 text-center" style="color: #ffc107;">
          <i class="bi bi-tag me-2"></i>Bruxelles
        </h4>
        <div class="row g-4 justify-content-center">
          <% categories_by_region['bruxelles'].each do |category| %>
            <div class="col-lg-4 col-md-6">
              <%= link_to category_path(category), class: "text-decoration-none" do %>
                <div class="bg-light p-4 rounded text-center h-100">
                  <!-- Icône circulaire -->
                  <div class="icon-circle mx-auto mb-3" style="width: 50px; height: 50px; background-color: #ffc107; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-tag" style="color: #000000; font-size: 20px;"></i>
                  </div>
                  <!-- Titre de la catégorie -->
                  <h6 class="mb-0 fw-bold" style="color: #ffc107;">
                    <%= category.description %>
                  </h6>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Wallonie -->
    <% if categories_by_region['wallonie']&.any? %>
      <div class="mb-5">
        <h4 class="mb-3 text-center" style="color: #dc3545;">
          <i class="bi bi-tag me-2"></i>Wallonie
        </h4>
        <div class="row g-4 justify-content-center">
          <% categories_by_region['wallonie'].each do |category| %>
            <div class="col-lg-2 col-md-4 col-sm-6">
              <%= link_to category_path(category), class: "text-decoration-none" do %>
                <div class="bg-light p-4 rounded text-center h-100">
                  <!-- Icône circulaire -->
                  <div class="icon-circle mx-auto mb-3" style="width: 50px; height: 50px; background-color: #dc3545; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-tag" style="color: #ffffff; font-size: 20px;"></i>
                  </div>
                  <!-- Titre de la catégorie -->
                  <h6 class="mb-0 fw-bold" style="color: #dc3545;">
                    <%= category.description %>
                  </h6>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <!-- État vide simplifié -->
    <div class="text-center py-5">
      <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px; background-color: #2c5282; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
        <i class="bi bi-tags" style="color: white; font-size: 24px;"></i>
      </div>
      <h5 class="text-muted">Aucune catégorie disponible</h5>
      <p class="text-muted small">Les catégories apparaîtront ici une fois configurées.</p>
    </div>
  <% end %>
</div>
