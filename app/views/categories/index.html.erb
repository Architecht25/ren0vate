<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-tags"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Catégories de revenus</h1>
    </div>
    <%= link_to root_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à l'accueil
    <% end %>
  </div>

  <!-- Liste des catégories avec style primes -->
  <% if @categories.any? %>
    <div class="row g-4 justify-content-center">
      <% @categories.each do |category| %>
        <div class="col-lg-4 col-md-6">
          <%= link_to category_path(category), class: "text-decoration-none" do %>
            <div class="bg-light p-4 rounded text-center h-100">
              <!-- Icône circulaire avec couleur selon la région -->
              <div class="icon-circle mx-auto mb-3" style="width: 50px; height: 50px; background-color: <%=
                case category.region.to_s.downcase
                when 'flandre' then '#2c5282'  # Bleu pour Flandre
                when 'wallonie' then '#38a169'  # Vert pour Wallonie
                when 'bruxelles' then '#6c757d'  # Gris pour Bruxelles
                when '' then '#2c5282'  # Bleu pour région non définie (Flandre par défaut)
                else '#2c5282'  # Bleu par défaut (Flandre)
                end %>; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-tag" style="color: white; font-size: 20px;"></i>
              </div>

              <!-- Titre de la catégorie -->
              <h6 class="mb-0 fw-bold" style="color: <%=
                case category.region.to_s.downcase
                when 'flandre' then '#2c5282'  # Bleu pour Flandre
                when 'wallonie' then '#38a169'  # Vert pour Wallonie
                when 'bruxelles' then '#6c757d'  # Gris pour Bruxelles
                when '' then '#2c5282'  # Bleu pour région non définie (Flandre par défaut)
                else '#2c5282'  # Bleu par défaut (Flandre)
                end %>;">
                <%= category.description %>
              </h6>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- État vide simplifié -->
    <div class="text-center py-5">
      <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px; background-color: #2c5282; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
        <i class="bi bi-tags" style="color: white; font-size: 24px;"></i>
      </div>
      <h5 class="text-muted">Aucune catégorie disponible</h5>
      <p class="text-muted small">Les catégories apparaîtront ici une fois configurées.</p>
    </div>
  <% end %>
</div>
