<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-tags"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Catégories de revenus</h1>
    </div>
    <%= link_to root_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour à l'accueil
    <% end %>
  </div>

  <!-- Liste des catégories -->
  <% if @categories.any? %>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="row g-3">
          <% @categories.each do |category| %>
            <div class="col-md-6">
              <%= link_to category_path(category), class: "text-decoration-none" do %>
                <div class="card border-0 bg-light-custom h-100 property-card">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center mb-2">
                      <div class="icon-circle me-2" style="width: 35px; height: 35px;">
                        <i class="bi bi-tag"></i>
                      </div>
                      <div class="flex-grow-1">
                        <h6 class="card-title text-dark mb-0 fw-normal"><%= category.description %></h6>
                        <small class="text-muted-custom">Code: <%= category.code %></small>
                      </div>
                    </div>

                    <div class="mt-2">
                      <div class="row g-1 text-center">
                        <div class="col-6">
                          <div class="bg-white rounded p-2 border-end">
                            <small class="text-muted-custom d-block mb-1">Seul</small>
                            <strong class="text-primary-custom small"><%= number_with_delimiter(category.seuil_seul) %>€</strong>
                          </div>
                        </div>
                        <div class="col-6">
                          <div class="bg-white rounded p-2">
                            <small class="text-muted-custom d-block mb-1">Avec charge</small>
                            <strong class="text-primary-custom small"><%= number_with_delimiter(category.seuil_seul_avec_charge) %>€</strong>
                          </div>
                        </div>
                      </div>

                      <div class="mt-2 text-center">
                        <div class="bg-white rounded p-2">
                          <small class="text-muted-custom d-block mb-1">Par personne +</small>
                          <strong class="text-success small">+<%= number_with_delimiter(category.increment_par_personne) %>€</strong>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-tags"></i>
      </div>
      <h3 class="text-muted-custom mb-3 fw-normal">Aucune catégorie</h3>
      <p class="text-muted-custom mb-4">Les catégories de revenus apparaîtront ici.</p>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
