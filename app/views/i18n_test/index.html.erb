<div class="row">
  <div class="col-lg-8 mx-auto">
    <!-- Test du système I18n -->
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white">
        <h3 class="card-title mb-0">
          <i class="bi bi-translate me-2"></i>
          <%= t('navigation.home') %> - Test I18n
        </h3>
      </div>

      <div class="card-body">
        <!-- Informations sur la locale -->
        <div class="alert alert-info">
          <h5><i class="bi bi-info-circle me-2"></i>Informations de langue</h5>
          <ul class="mb-0">
            <li><strong>Locale actuelle :</strong> <%= I18n.locale %></li>
            <li><strong>Locales disponibles :</strong> <%= I18n.available_locales.join(', ') %></li>
            <li><strong>Nom de la langue :</strong> <%= current_locale_name %></li>
            <li><strong>Drapeau :</strong> <%= current_locale_flag %></li>
          </ul>
        </div>

        <!-- Tests de traduction -->
        <div class="row">
          <div class="col-md-6">
            <h5><i class="bi bi-chat-square-text me-2"></i>Traductions générales</h5>
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between">
                <span>Enregistrer :</span>
                <strong><%= t('common.save') %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                <span>Annuler :</span>
                <strong><%= t('common.cancel') %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                <span>Chargement :</span>
                <strong><%= t('common.loading') %></strong>
              </li>
            </ul>
          </div>

          <div class="col-md-6">
            <h5><i class="bi bi-geo-alt me-2"></i>Régions</h5>
            <ul class="list-group list-group-flush">
              <li class="list-group-item d-flex justify-content-between">
                <span>Wallonie :</span>
                <strong><%= t('regions.wallonie') %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                <span>Flandre :</span>
                <strong><%= t('regions.flandre') %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                <span>Bruxelles :</span>
                <strong><%= t('regions.bruxelles') %></strong>
              </li>
            </ul>
          </div>
        </div>

        <!-- Navigation multilingue -->
        <div class="mt-4">
          <h5><i class="bi bi-signpost me-2"></i>Navigation</h5>
          <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between">
              <span>Accueil :</span>
              <strong><%= t('navigation.home') %></strong>
            </li>
            <li class="list-group-item d-flex justify-content-between">
              <span>Mes biens :</span>
              <strong><%= t('navigation.properties') %></strong>
            </li>
            <li class="list-group-item d-flex justify-content-between">
              <span>Simulations :</span>
              <strong><%= t('navigation.simulations') %></strong>
            </li>
          </ul>
        </div>

        <!-- Test de formatage -->
        <div class="mt-4">
          <h5><i class="bi bi-cash-coin me-2"></i>Tests de formatage</h5>
          <div class="row">
            <div class="col-md-6">
              <p><strong>Montant :</strong> <%= format_currency(2500) %></p>
              <p><strong>Date :</strong> <%= localize_date(Date.current) %></p>
            </div>
            <div class="col-md-6">
              <p><strong>URL actuelle :</strong> <code><%= request.fullpath %></code></p>
              <p><strong>Langue utilisateur :</strong> <%= request.env['HTTP_ACCEPT_LANGUAGE']&.truncate(30) || 'Non définie' %></p>
            </div>
          </div>
        </div>

        <!-- Messages de test -->
        <div class="mt-4">
          <h5><i class="bi bi-exclamation-triangle me-2"></i>Messages d'état</h5>
          <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            <%= t('notices.property_created') %>
          </div>
          <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <%= t('common.please_correct_errors') %>
          </div>
        </div>

        <!-- Actions de test -->
        <div class="mt-4 text-center">
          <h5><i class="bi bi-gear me-2"></i>Actions de test</h5>
          <div class="btn-group" role="group">
            <%= link_to url_for(locale: 'fr'), class: "btn btn-outline-primary #{'active' if I18n.locale == :fr}" do %>
              🇫🇷 Français
            <% end %>
            <%= link_to url_for(locale: 'nl'), class: "btn btn-outline-primary #{'active' if I18n.locale == :nl}" do %>
              🇧🇪 Nederlands
            <% end %>
            <%= link_to url_for(locale: 'en'), class: "btn btn-outline-primary #{'active' if I18n.locale == :en}" do %>
              🇬🇧 English
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
