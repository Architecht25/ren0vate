<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: "Garanties", subtitle: @project.nom } do %>
    <%= link_to new_project_warranty_path(@project), class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Ajouter une garantie
    <% end %>
  <% end %>

  <% if @warranties.any? %>
    <div class="list-group">
      <% @warranties.each do |warranty| %>
        <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <div class="fw-bold">
              <%= warranty.label %>
              <% if warranty.lot %><span class="badge bg-secondary ms-1"><%= warranty.lot.name %></span><% end %>
              <% if warranty.expired? %>
                <span class="badge bg-danger ms-1">Expirée</span>
              <% elsif warranty.expiring_soon? %>
                <span class="badge bg-warning text-dark ms-1">Expire bientôt</span>
              <% end %>
            </div>
            <div class="text-muted small"><%= warranty.start_date.strftime("%d/%m/%Y") %> → <%= warranty.end_date.strftime("%d/%m/%Y") %></div>
          </div>
          <% if policy(warranty).destroy? %>
            <%= button_to "Supprimer", warranty_path(warranty), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Supprimer cette garantie ?" } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center text-muted py-5">Aucune garantie enregistrée pour l'instant.</div>
  <% end %>
</div>
