<!-- Section pour l'affichage des documents filtrés par type -->
<% if params[:type_document].present? %>
  <div class="container-fluid px-4 py-4">
    <% if @documents.any? %>
      <!-- Affichage des documents filtrés par type -->
      <h6 class="text-primary mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span>
          <i class="bi bi-files me-2"></i>
          Photos du chantier (<%= @documents.count %>)
        </span>
        <div class="d-flex gap-2" id="photos-toolbar-default">
          <% if @project %>
            <%= link_to download_zip_documents_path(project_id: @project.id, type_document: params[:type_document]),
                  class: "btn btn-outline-success btn-sm",
                  title: "Télécharger toutes les photos en ZIP",
                  data: { turbo: false } do %>
              <i class="bi bi-file-zip me-1"></i>Tout télécharger (ZIP)
            <% end %>
          <% end %>
          <button type="button" id="toggle-selection-btn" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-check2-square me-1"></i>Sélectionner
          </button>
        </div>
      </h6>

      <!-- Barre de sélection (cachée par défaut) -->
      <div id="selection-toolbar" class="d-none mb-3 p-3 bg-light rounded border">
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="select-all-photos">
            <label class="form-check-label fw-semibold" for="select-all-photos">Tout sélectionner</label>
          </div>
          <span id="selection-count" class="text-muted small">0 photo sélectionnée</span>
          <% if @project %>
            <button id="download-selected-btn"
                    class="btn btn-primary btn-sm"
                    data-project-id="<%= @project.id %>"
                    data-download-url="<%= download_zip_documents_path %>"
                    disabled>
              <i class="bi bi-download me-1"></i>Télécharger la sélection (ZIP)
            </button>
          <% end %>
          <button id="delete-selected-btn"
                  class="btn btn-danger btn-sm"
                  data-delete-url="<%= destroy_multiple_documents_path %>"
                  disabled>
            <i class="bi bi-trash me-1"></i>Supprimer la sélection
          </button>
          <button type="button" id="cancel-selection-btn" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-x me-1"></i>Annuler
          </button>
        </div>
      </div>

      <div id="photos-grid" class="row">
        <% @documents.each do |document| %>
          <div class="col-lg-2 col-md-3 col-sm-4 col-6 mb-3" data-photo-col="<%= document.id %>">
            <div class="card border-0 shadow-sm h-100 document-card position-relative photo-item">
              <!-- Checkbox de sélection (caché hors mode sélection) -->
              <div class="photo-checkbox-wrapper position-absolute top-0 start-0 m-2 d-none" style="z-index: 10;">
                <input class="form-check-input photo-checkbox shadow" type="checkbox"
                       value="<%= document.id %>"
                       id="photo-check-<%= document.id %>"
                       style="width: 1.25rem; height: 1.25rem; cursor: pointer;">
              </div>
              <div class="card-body">
                <div class="d-flex align-items-start mb-2">
                  <div class="me-3">
                    <% if document.file.attached? && document.file.content_type&.start_with?('image/') %>
                      <i class="bi bi-image text-success" style="font-size: 1.5rem;"></i>
                    <% elsif document.file.attached? && document.file.content_type == 'application/pdf' %>
                      <i class="bi bi-file-earmark-pdf text-danger" style="font-size: 1.5rem;"></i>
                    <% else %>
                      <i class="bi bi-file-earmark text-primary" style="font-size: 1.5rem;"></i>
                    <% end %>
                  </div>
                  <div class="flex-grow-1">
                    <h6 class="card-title mb-1">
                      <%= if document.file.attached?
                            document.file.filename.to_s
                          else
                            "#{document.type_document&.humanize || 'Document'} - #{document.id}"
                          end %>
                    </h6>
                    <small class="text-muted d-block">
                      <%= document.type_document&.humanize || "Type non défini" %>
                    </small>
                    <small class="text-muted d-block">
                      <i class="bi bi-calendar3 me-1"></i>
                      <%= l(document.created_at, format: :short) %>
                    </small>
                  </div>
                </div>

                <!-- Prévisualisation du document -->
                <% if document.file.attached? %>
                  <div class="mb-3">
                    <div class="document-preview text-center">
                      <%= link_to view_document_path(document), target: "_blank", class: "text-decoration-none" do %>
                        <% if document.file.content_type&.start_with?('image/') %>
                          <!-- Prévisualisation IMAGE -->
                          <%= image_tag rails_blob_url(document.file),
                              class: "img-fluid rounded shadow-sm document-thumbnail",
                              style: "max-height: 200px; max-width: 100%; object-fit: cover; cursor: pointer;",
                              alt: document.file.filename.to_s,
                              loading: "lazy" %>
                          <div class="small text-muted mt-2">
                            <i class="bi bi-zoom-in me-1"></i>Cliquer pour agrandir
                          </div>
                        <% elsif document.file.content_type == 'application/pdf' %>
                          <!-- Prévisualisation PDF -->
                          <% cached_url = pdf_preview_url_cached(document) %>
                          <% if cached_url %>
                            <!-- Aperçu déjà en cache - affichage direct -->
                            <%= image_tag cached_url,
                                class: "img-fluid rounded shadow-sm document-thumbnail",
                                style: "max-height: 200px; max-width: 100%; object-fit: cover; cursor: pointer;",
                                alt: "Aperçu de #{document.file.filename}",
                                loading: "lazy" %>
                          <% else %>
                            <!-- Prévisualisation asynchrone avec Stimulus -->
                            <div class="pdf-preview-container"
                                 data-controller="pdf-preview"
                                 data-pdf-preview-document-id-value="<%= document.id %>">
                              <!-- Placeholder statique pendant génération -->
                              <div class="pdf-preview-loading d-flex flex-column align-items-center justify-content-center"
                                   data-pdf-preview-target="loading"
                                   style="height: 200px; background: #f8f9fa; border: 2px dashed #dee2e6; border-radius: 8px;">
                                <i class="bi bi-file-earmark-pdf text-primary mb-2" style="font-size: 3rem;"></i>
                                <small class="text-muted">Génération de l'aperçu...</small>
                              </div>
                              <img class="pdf-preview-image img-fluid rounded shadow-sm document-thumbnail d-none"
                                   data-pdf-preview-target="image"
                                   style="max-height: 200px; max-width: 100%; object-fit: cover; cursor: pointer;"
                                   alt="Aperçu de #{document.file.filename}"
                                   loading="lazy" />
                            </div>
                          <% end %>
                          <div class="small text-muted mt-2">
                            <i class="bi bi-zoom-in me-1"></i>Cliquer pour agrandir
                          </div>
                        <% else %>
                          <!-- Prévisualisation AUTRES DOCUMENTS -->
                          <div class="file-preview-box p-3">
                            <div class="file-icon-large mb-2">
                              <% case document.file.content_type %>
                              <% when /word|msword|officedocument.wordprocessingml/ %>
                                <i class="bi bi-file-earmark-word text-primary" style="font-size: 3rem;"></i>
                              <% when /excel|spreadsheet/ %>
                                <i class="bi bi-file-earmark-excel text-success" style="font-size: 3rem;"></i>
                              <% when /powerpoint|presentation/ %>
                                <i class="bi bi-file-earmark-ppt text-warning" style="font-size: 3rem;"></i>
                              <% when /text\// %>
                                <i class="bi bi-file-earmark-text text-secondary" style="font-size: 3rem;"></i>
                              <% when /zip|rar|7z|tar/ %>
                                <i class="bi bi-file-earmark-zip text-info" style="font-size: 3rem;"></i>
                              <% else %>
                                <i class="bi bi-file-earmark text-dark" style="font-size: 3rem;"></i>
                              <% end %>
                            </div>
                            <div class="small text-muted">
                              <strong><%= document.file.filename %></strong><br>
                              <i class="bi bi-file-earmark me-1"></i><%= document.file.content_type || "Type inconnu" %><br>
                              <% if document.file.byte_size %>
                                <i class="bi bi-hdd me-1"></i><%= number_to_human_size(document.file.byte_size) %>
                              <% end %>
                            </div>
                            <div class="small text-primary mt-2">
                              <i class="bi bi-box-arrow-up-right me-1"></i>Cliquer pour ouvrir
                            </div>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>

                <!-- Actions pour le document -->
                <div class="d-flex gap-2 flex-wrap">
                  <% if document.has_ocr_content? %>
                    <%= link_to ocr_view_document_path(document),
                        class: "btn btn-outline-info btn-sm",
                        title: "Voir le contenu OCR" do %>
                      <i class="bi bi-eye me-1"></i>OCR
                    <% end %>
                  <% end %>
                  <% if document.file.attached? %>
                    <button class="btn btn-outline-secondary btn-sm ocr-scan-btn"
                            data-document-id="<%= document.id %>"
                            data-url="<%= ocr_scan_existing_path(document) %>">
                      <i class="bi bi-search me-1"></i><%= document.has_ocr_content? ? 'Rescanner OCR' : 'Scanner OCR' %>
                    </button>
                    <div id="ocr-result-<%= document.id %>" class="w-100 mt-1 d-none">
                      <div class="alert alert-info p-2 mb-0 small" id="ocr-result-text-<%= document.id %>"></div>
                    </div>
                  <% end %>
                  <%= link_to download_document_path(document),
                      class: "btn btn-outline-primary btn-sm",
                      title: "Télécharger le document",
                      data: { turbo: false } do %>
                    <i class="bi bi-download me-1"></i>Télécharger
                  <% end %>
                  <%= link_to document_path(document,
                        type_document: params[:type_document],
                        filter_phase: params[:filter_phase]),
                      method: :delete,
                      class: "btn btn-outline-danger btn-sm",
                      data: {
                        confirm: "Êtes-vous sûr de vouloir supprimer ce document ?",
                        turbo_method: :delete
                      } do %>
                    <i class="bi bi-trash me-1"></i>Supprimer
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-warning">
        <i class="bi bi-info-circle me-2"></i>
        Aucun document trouvé pour ce filtre.
      </div>
    <% end %>
  </div>
<% end %>

<script nonce="<%= content_security_policy_nonce %>">
  document.addEventListener('turbo:load', function() {
    const scanBtns = document.querySelectorAll('.ocr-scan-btn');

    // Afficher le bouton "Scanner tous" si des boutons de scan existent
    const scanAllBtn = document.getElementById('ocr-scan-all-btn');
    if (scanAllBtn && scanBtns.length > 0) {
      scanAllBtn.classList.remove('d-none');

      scanAllBtn.addEventListener('click', async function() {
        const buttons = Array.from(document.querySelectorAll('.ocr-scan-btn:not([disabled])'));
        if (buttons.length === 0) return;

        const progress = document.getElementById('ocr-scan-all-progress');
        scanAllBtn.disabled = true;
        progress.classList.remove('d-none');

        for (let i = 0; i < buttons.length; i++) {
          progress.textContent = (i + 1) + '/' + buttons.length;
          buttons[i].click();
          // Attendre que le scan se termine avant de passer au suivant
          await new Promise(resolve => setTimeout(resolve, 2500));
        }

        progress.textContent = '✓ Terminé';
        scanAllBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Tous scannés';
        scanAllBtn.className = 'btn btn-success';
      });
    }

    // ── Mode sélection photos ──────────────────────────────────────────────────
    (function() {
      const toggleBtn      = document.getElementById('toggle-selection-btn');
      const cancelBtn      = document.getElementById('cancel-selection-btn');
      const toolbar        = document.getElementById('selection-toolbar');
      const defaultToolbar = document.getElementById('photos-toolbar-default');
      const selectAllCb    = document.getElementById('select-all-photos');
      const countLabel     = document.getElementById('selection-count');
      const downloadBtn    = document.getElementById('download-selected-btn');
      const deleteBtn      = document.getElementById('delete-selected-btn');

      if (!toggleBtn) return;

      function getCheckboxes() {
        return Array.from(document.querySelectorAll('.photo-checkbox'));
      }

      function updateCount() {
        const checked = getCheckboxes().filter(cb => cb.checked);
        const n = checked.length;
        countLabel.textContent = n === 0 ? 'Aucune photo sélectionnée' :
          n === 1 ? '1 photo sélectionnée' : n + ' photos sélectionnées';
        if (downloadBtn) downloadBtn.disabled = n === 0;
        deleteBtn.disabled = n === 0;
        selectAllCb.indeterminate = n > 0 && n < getCheckboxes().length;
        selectAllCb.checked = n > 0 && n === getCheckboxes().length;
      }

      function enterSelectionMode() {
        toolbar.classList.remove('d-none');
        defaultToolbar.classList.add('d-none');
        document.querySelectorAll('.photo-checkbox-wrapper').forEach(w => w.classList.remove('d-none'));
        document.querySelectorAll('.photo-item').forEach(card => {
          card.style.cursor = 'pointer';
          card.dataset.selectable = 'true';
        });
        updateCount();
      }

      function exitSelectionMode() {
        toolbar.classList.add('d-none');
        defaultToolbar.classList.remove('d-none');
        document.querySelectorAll('.photo-checkbox-wrapper').forEach(w => w.classList.add('d-none'));
        document.querySelectorAll('.photo-checkbox').forEach(cb => { cb.checked = false; });
        document.querySelectorAll('.photo-item').forEach(card => {
          card.style.cursor = '';
          delete card.dataset.selectable;
        });
        updateCount();
      }

      toggleBtn.addEventListener('click', enterSelectionMode);
      cancelBtn.addEventListener('click', exitSelectionMode);

      selectAllCb.addEventListener('change', function() {
        getCheckboxes().forEach(cb => { cb.checked = selectAllCb.checked; });
        updateCount();
      });

      document.addEventListener('change', function(e) {
        if (e.target.classList.contains('photo-checkbox')) updateCount();
      });

      // Clic sur la carte en mode sélection → toggle la checkbox
      document.addEventListener('click', function(e) {
        const card = e.target.closest('.photo-item[data-selectable]');
        if (!card) return;
        if (e.target.closest('a, button, input')) return; // laisser les actions intactes
        const cb = card.querySelector('.photo-checkbox');
        if (cb) { cb.checked = !cb.checked; updateCount(); }
      });

      if (downloadBtn) {
        downloadBtn.addEventListener('click', function() {
          const checked = getCheckboxes().filter(cb => cb.checked);
          if (checked.length === 0) return;

          const baseUrl = downloadBtn.dataset.downloadUrl;
          const projectId = downloadBtn.dataset.projectId;
          const url = new URL(baseUrl, window.location.origin);
          url.searchParams.set('project_id', projectId);
          checked.forEach(cb => url.searchParams.append('document_ids[]', cb.value));

          window.location.href = url.toString();
        });
      }

      deleteBtn.addEventListener('click', function() {
        const checked = getCheckboxes().filter(cb => cb.checked);
        if (checked.length === 0) return;

        const n = checked.length;
        const msg = n === 1
          ? 'Supprimer cette photo définitivement ?'
          : 'Supprimer ces ' + n + ' photos définitivement ?';
        if (!confirm(msg)) return;

        const deleteUrl = deleteBtn.dataset.deleteUrl;
        const ids = checked.map(cb => cb.value);
        const body = new URLSearchParams();
        ids.forEach(id => body.append('document_ids[]', id));

        deleteBtn.disabled = true;
        deleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Suppression…';

        fetch(deleteUrl, {
          method: 'DELETE',
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: body.toString()
        })
        .then(r => r.json())
        .then(data => {
          if (data.status === 'success') {
            data.deleted_ids.forEach(function(id) {
              const col = document.querySelector('[data-photo-col="' + id + '"]');
              if (col) col.remove();
            });
            // Mettre à jour le compteur de photos dans le titre
            const remaining = document.querySelectorAll('.photo-item').length;
            const titleSpan = document.querySelector('h6.text-primary span');
            if (titleSpan) titleSpan.innerHTML = '<i class="bi bi-files me-2"></i>Photos du chantier (' + remaining + ')';

            exitSelectionMode();
            if (remaining === 0) {
              document.getElementById('photos-grid').closest('.container-fluid').innerHTML =
                '<div class="alert alert-warning"><i class="bi bi-info-circle me-2"></i>Aucun document trouvé pour ce filtre.</div>';
            }
          } else {
            alert('Erreur lors de la suppression.');
            deleteBtn.disabled = false;
            deleteBtn.innerHTML = '<i class="bi bi-trash me-1"></i>Supprimer la sélection';
          }
        })
        .catch(function() {
          alert('Erreur réseau lors de la suppression.');
          deleteBtn.disabled = false;
          deleteBtn.innerHTML = '<i class="bi bi-trash me-1"></i>Supprimer la sélection';
        });
      });
    })();
    // ── Fin mode sélection ─────────────────────────────────────────────────────

    scanBtns.forEach(function(btn) {
      if (btn.dataset.ocrBound) return;
      btn.dataset.ocrBound = 'true';

      btn.addEventListener('click', function() {
        const docId = btn.dataset.documentId;
        const url = btn.dataset.url;
        const resultBox = document.getElementById('ocr-result-' + docId);
        const resultText = document.getElementById('ocr-result-text-' + docId);

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Scan…';

        fetch(url, {
          method: 'POST',
          headers: {
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
            'Accept': 'application/json'
          }
        })
        .then(r => r.json())
        .then(data => {
          resultBox.classList.remove('d-none');
          if (data.success) {
            resultText.className = 'alert alert-success p-2 mb-0 small';
            const previewId = 'ocr-text-preview-' + docId;
            const preview = data.text ? data.text.substring(0, 300) + (data.text.length > 300 ? '…' : '') : '';
            resultText.innerHTML =
              '<strong>OCR réussi</strong> — Confiance : ' + data.confidence + '% (' + data.method + ')' +
              (data.text ? (
                '<details class="mt-2">' +
                  '<summary style="cursor:pointer;">Voir le texte extrait</summary>' +
                  '<pre class="mt-2 mb-0 p-2 bg-white border rounded" style="white-space:pre-wrap;font-size:0.75rem;max-height:250px;overflow-y:auto;">' +
                    data.text.replace(/</g, '&lt;').replace(/>/g, '&gt;') +
                  '</pre>' +
                '</details>'
              ) : '<br><em>Aucun texte extrait.</em>');
            btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Scanné';
            btn.className = 'btn btn-success btn-sm';
          } else {
            resultText.className = 'alert alert-danger p-2 mb-0 small';
            resultText.textContent = data.error || 'Erreur OCR';
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-search me-1"></i>Réessayer';
          }
        })
        .catch(function() {
          resultBox.classList.remove('d-none');
          resultText.className = 'alert alert-danger p-2 mb-0 small';
          resultText.textContent = 'Erreur réseau';
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-search me-1"></i>Réessayer';
        });
      });
    });
  });
</script>
