<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-pencil-square"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Modifier le Document</h1>
    </div>
    <%= link_to @document, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour aux détails
    <% end %>
  </div>

  <!-- Formulaire dans une card épurée -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-info-circle me-2"></i>Informations du document
          </h5>

          <%= form_with model: @document, local: true, class: "needs-validation", novalidate: true do |form| %>
            <div class="row g-3">
              <div class="col-12">
                <div class="mb-3">
                  <%= form.label :type_document, "Type de document*", class: "form-label" %>
                  <%= form.text_field :type_document, class: "form-control", placeholder: "Ex: Facture, Devis, Certificat", required: true %>
                  <div class="invalid-feedback">
                    Veuillez entrer un type de document.
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="mb-3">
                  <%= form.label :notes, "Notes", class: "form-label" %>
                  <%= form.text_area :notes, rows: 4, class: "form-control", placeholder: "Ajoutez des notes sur ce document..." %>
                </div>
              </div>

              <div class="col-12">
                <div class="mb-3">
                  <%= form.label :status, "Statut", class: "form-label" %>
                  <%= form.select :status,
                        options_for_select([
                          ['En attente', 'pending'],
                          ['Approuvé', 'approved'],
                          ['Rejeté', 'rejected']
                        ], @document.status),
                        {},
                        { class: "form-select" } %>
                </div>
              </div>

              <!-- Associations -->
              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :property_id, "Bien immobilier", class: "form-label" %>
                  <%= form.select :property_id,
                        options_from_collection_for_select(current_user.properties, :id, :address, @document.property_id),
                        { prompt: "Sélectionner un bien..." },
                        { class: "form-select" } %>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <%= form.label :project_id, "Projet", class: "form-label" %>
                  <%= form.select :project_id,
                        options_from_collection_for_select(current_user.projects, :id, :display_name, @document.project_id),
                        { prompt: "Sélectionner un projet..." },
                        { class: "form-select" } %>
                </div>
              </div>

              <div class="col-12">
                <div class="mb-3">
                  <%= form.label :request_id, "Demande", class: "form-label" %>
                  <%= form.select :request_id,
                        options_from_collection_for_select(current_user.requests, :id, :title, @document.request_id),
                        { prompt: "Sélectionner une demande..." },
                        { class: "form-select" } %>
                </div>
              </div>

              <!-- Boutons d'action -->
              <div class="col-12">
                <div class="d-flex gap-3 justify-content-end">
                  <%= link_to @document, class: "btn btn-outline-secondary" do %>
                    <i class="bi bi-x-lg me-2"></i>Annuler
                  <% end %>
                  <%= form.submit "Mettre à jour", class: "btn btn-primary-custom px-4" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 bg-light-custom">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-info-circle me-2"></i>Informations
          </h6>
          <ul class="list-unstyled text-muted-custom small">
            <li class="mb-2">
              <i class="bi bi-calendar-plus me-2"></i>
              Créé le <%= @document.created_at.strftime("%d/%m/%Y") %>
            </li>
            <% if @document.updated_at != @document.created_at %>
              <li class="mb-2">
                <i class="bi bi-pencil me-2"></i>
                Modifié le <%= @document.updated_at.strftime("%d/%m/%Y") %>
              </li>
            <% end %>
            <% if @document.file.attached? %>
              <li class="mb-2">
                <i class="bi bi-file-earmark me-2"></i>
                Fichier: <%= @document.file.filename %>
              </li>
              <li class="mb-2">
                <i class="bi bi-hdd me-2"></i>
                Taille: <%= number_to_human_size(@document.file.byte_size) %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= content_security_policy_nonce %>">
// Validation Bootstrap
(function() {
  'use strict';
  var forms = document.querySelectorAll('.needs-validation');
  Array.prototype.slice.call(forms)
    .forEach(function(form) {
      form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
})();
</script>

<!-- Styles CSS -->
<style>
.icon-circle {
  width: 48px;
  height: 48px;
  background: rgba(var(--bs-primary-rgb), 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: var(--bs-primary);
}

.bg-light-custom {
  background-color: #f8f9fa !important;
}

.text-primary-custom {
  color: var(--bs-primary) !important;
}

.text-muted-custom {
  color: #6c757d !important;
}

.btn-primary-custom {
  background-color: var(--bs-primary);
  border-color: var(--bs-primary);
  color: white;
}

.btn-primary-custom:hover {
  background-color: var(--bs-primary);
  border-color: var(--bs-primary);
  opacity: 0.9;
}

.btn-outline-primary-custom {
  color: var(--bs-primary);
  border-color: var(--bs-primary);
}

.btn-outline-primary-custom:hover {
  background-color: var(--bs-primary);
  border-color: var(--bs-primary);
  color: white;
}
</style>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
