<div class="mb-4">
  <h6 class="text-<%= class_color %> mb-3">
    <i class="bi bi-<%= icon %> me-2"></i><%= title %>
  </h6>

  <% if is_required %>
    <!-- Cartes pour documents obligatoires -->
    <div class="row">
      <% document_types.each do |doc_type| %>
        <% docs_of_type = @documents.select { |d| d.type_document == doc_type } %>
        <% has_approved = docs_of_type.any? { |d| d.status == 'approved' } %>
        <% card_border_class = has_approved ? 'success' : 'danger' %>
        <% icon_class = has_approved ? 'check-circle-fill text-success' : 'exclamation-circle-fill text-danger' %>

        <div class="col-lg-2 col-md-4 col-sm-6 mb-3">
          <div class="card border-<%= card_border_class %> h-100">
            <div class="card-body text-center">
              <div class="mb-2">
                <i class="bi bi-<%= icon_class %>" style="font-size: 2rem;"></i>
              </div>
              <h6 class="card-title"><%= document_type_name(doc_type) %></h6>
              <p class="small text-muted mb-2"><%= docs_of_type.count %> document(s)</p>
              <div class="d-flex gap-1 justify-content-center">
                <%= render 'document_type_actions', doc_type: doc_type, docs_of_type: docs_of_type, is_required: true %>
              </div>
              <% if (hint = document_type_hint(doc_type)) %>
                <p class="small text-muted fst-italic mt-2 mb-0" style="font-size: 0.72rem; line-height: 1.3;"><%= hint %></p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <!-- Liste compacte pour documents optionnels -->
    <div class="card border-0 shadow-sm">
      <% document_types.each_with_index do |doc_type, i| %>
        <% docs_of_type = @documents.select { |d| d.type_document == doc_type } %>
        <% has_docs = docs_of_type.any? %>
        <div class="d-flex align-items-center px-3 py-2 <%= 'border-top' if i > 0 %>">
          <i class="bi bi-<%= has_docs ? 'file-earmark-check text-success' : 'file-earmark-plus text-muted' %> me-3 flex-shrink-0"></i>
          <div class="flex-grow-1">
            <span class="fw-medium small"><%= document_type_name(doc_type) %></span>
            <% if (hint = document_type_hint(doc_type)) %>
              <span class="text-muted ms-2" style="font-size: 0.72rem;"><%= hint %></span>
            <% end %>
          </div>
          <% if has_docs %>
            <span class="badge bg-success-subtle text-success border border-success-subtle me-2" style="font-size: 0.7rem;"><%= docs_of_type.count %> doc<%= 's' if docs_of_type.count > 1 %></span>
          <% end %>
          <div class="d-flex gap-1 flex-shrink-0">
            <%= render 'document_type_actions', doc_type: doc_type, docs_of_type: docs_of_type, is_required: false %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
