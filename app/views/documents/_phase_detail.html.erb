<!-- Vue détaillée de la phase sélectionnée -->
<div class="row mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-<%= phase.color %> text-white">
        <div class="d-flex align-items-center">
          <div class="me-3" style="font-size: 2rem;"><%= phase.icon %></div>
          <div class="flex-grow-1">
            <h4 class="mb-1"><%= phase.name %></h4>
            <p class="mb-0 opacity-75"><%= phase.description %></p>
          </div>
          <div class="text-end">
            <%= link_to documents_path(
                          property_id: @property&.id,
                          project_id: @project&.id
                        ),
                       class: "btn btn-outline-light btn-sm" do %>
              <i class="bi bi-arrow-left me-1"></i>Toutes les phases
            <% end %>
          </div>
        </div>
      </div>

      <div class="card-body">
        <!-- Types de documents obligatoires -->
        <% if phase.required_document_types.any? %>
          <%= render 'document_types_section',
                     title: 'Documents obligatoires',
                     icon: 'exclamation-triangle',
                     class_color: 'danger',
                     document_types: phase.required_document_types,
                     is_required: true %>
        <% end %>

        <!-- Types de documents optionnels -->
        <% if phase.optional_document_types.any? %>
          <%= render 'document_types_section',
                     title: 'Documents optionnels',
                     icon: 'info-circle',
                     class_color: 'info',
                     document_types: phase.optional_document_types,
                     is_required: false %>
        <% end %>
      </div>
    </div>
  </div>
</div>
