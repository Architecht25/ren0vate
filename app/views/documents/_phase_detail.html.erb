<!-- Vue détaillée d'une phase documentaire -->
<div class="row mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h5 class="mb-3 fw-normal">
          <%= phase.icon %> <%= phase_label_for(phase.name) %>
        </h5>

        <!-- Types de documents obligatoires -->
        <% if phase.required_document_types.any? %>
          <%= render 'document_types_section',
                     title: 'Documents obligatoires',
                     icon: 'exclamation-triangle',
                     class_color: 'danger',
                     document_types: phase.required_document_types,
                     is_required: true %>
        <% end %>

        <!-- Types de documents optionnels -->
        <% if phase.optional_document_types.any? %>
          <%= render 'document_types_section',
                     title: 'Documents optionnels',
                     icon: 'info-circle',
                     class_color: 'info',
                     document_types: phase.optional_document_types,
                     is_required: false %>
        <% end %>
      </div>
    </div>
  </div>
</div>
