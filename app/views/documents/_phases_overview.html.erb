<!-- Mini vue des phases -->
<div class="row mb-5">
  <div class="col-12 mb-4">
    <div class="d-flex align-items-center justify-content-between">
      <div>
        <h4 class="mb-1 fw-600" style="color: var(--neutral-800);">
          <i class="bi bi-kanban me-2 text-primary"></i>Progression par phases
        </h4>
        <p class="text-muted mb-0 small">
          <% if @property %>
            Avancement spécifique pour <%= @property.name %>
          <% else %>
            Vue d'ensemble de vos documents
          <% end %>
        </p>
      </div>
    </div>
  </div>

  <!-- Phases pour particuliers (chantier) -->
  <% phases_chantier = @phases_data.select { |phase_data| phase_data[:phase].category == 'chantier' } %>
  <% if phases_chantier.any? %>
    <div class="col-12 mb-3">
      <div class="alert alert-light border-start border-primary border-4">
        <div class="d-flex align-items-center">
          <i class="bi bi-person-circle text-primary me-2 fs-4"></i>
          <div>
            <h6 class="mb-0 text-primary">Documents pour Particuliers</h6>
            <small class="text-muted">Phases de chantier et rénovation résidentielle</small>
          </div>
        </div>
      </div>
    </div>

    <% phases_chantier.each do |phase_data| %>
      <% phase = phase_data[:phase] %>
      <% docs_in_phase = @documents.select { |d| d.document_phase == phase } %>
      <% completion_class = phase_data[:completion_percentage] >= 80 ? 'high' : phase_data[:completion_percentage] >= 50 ? 'medium' : 'low' %>
      <% all_types = phase.required_document_types + phase.optional_document_types %>

      <div class="col-lg-3 col-md-6 mb-4">
        <%= link_to documents_path(
                      property_id: @property&.id,
                      project_id: @project&.id,
                      filter_phase: phase.id
                    ),
                   class: "text-decoration-none" do %>
          <div class="card document-phase-card h-100 phase-card-chantier" style="cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 8px 16px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';">
            <div class="card-body p-4 text-center position-relative">

              <div class="mb-4 mt-2">
                <div class="phase-icon-circle mx-auto mb-3">
                  <%= phase.icon %>
                </div>
              </div>

              <h5 class="card-title mb-4 fw-600" style="color: var(--neutral-800);">
                <%= phase.name.gsub('Phase ', '') %>
              </h5>

            <div class="mb-4">
              <div class="small text-muted mb-2">
                <%= docs_in_phase.count %> document<%= docs_in_phase.count > 1 ? 's' : '' %>
              </div>
              <!-- Progress bar moderne -->
              <div class="progress mb-3" style="height: 8px; border-radius: 10px; background-color: var(--neutral-100);">
                <div class="progress-bar"
                     style="width: <%= phase_data[:completion_percentage] %>%;
                            background: linear-gradient(90deg,
                              <%= completion_class == 'high' ? 'var(--success-color)' :
                                  completion_class == 'medium' ? 'var(--warning-color)' :
                                  'var(--danger-color)' %>,
                              <%= completion_class == 'high' ? '#10b981' :
                                  completion_class == 'medium' ? '#f59e0b' :
                                  '#ef4444' %>);
                            border-radius: 10px;"></div>
              </div>
            </div>

            <!-- Liste des sous-catégories de documents -->
            <div class="mb-4">
              <div class="fw-medium text-dark mb-3 border-bottom pb-2">
                <i class="bi bi-list-ul me-2 text-primary"></i>Documents concernés
              </div>
              <div class="row g-2">
                <% all_types.each_with_index do |doc_type, index| %>
                  <%
                    # Palette cohérente basée sur la phase
                    case phase.name.downcase
                    when /administrative/
                      badge_bg = "rgba(59, 130, 246, 0.1)"
                      badge_border = "rgba(59, 130, 246, 0.2)"
                      icon_color = "text-blue-600"
                    when /technique/
                      badge_bg = "rgba(34, 197, 94, 0.1)"
                      badge_border = "rgba(34, 197, 94, 0.2)"
                      icon_color = "text-green-600"
                    when /exécution|execution/
                      badge_bg = "rgba(251, 146, 60, 0.1)"
                      badge_border = "rgba(251, 146, 60, 0.2)"
                      icon_color = "text-orange-600"
                    when /réception|reception/
                      badge_bg = "rgba(168, 85, 247, 0.1)"
                      badge_border = "rgba(168, 85, 247, 0.2)"
                      icon_color = "text-purple-600"
                    else
                      badge_bg = "rgba(107, 114, 128, 0.1)"
                      badge_border = "rgba(107, 114, 128, 0.2)"
                      icon_color = "text-gray-600"
                    end
                  %>
                  <div class="col-12 col-md-6">
                    <div class="d-flex align-items-start py-2 px-3 rounded-3" style="background-color: <%= badge_bg %>; border: 1px solid <%= badge_border %>;">
                      <i class="bi bi-file-earmark-check me-2 <%= icon_color %>" style="font-size: 1rem; margin-top: 2px;"></i>
                      <span class="small text-dark flex-grow-1 fw-medium" style="line-height: 1.4;">
                        <%= document_type_name(doc_type) %>
                      </span>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
