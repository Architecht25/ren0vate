<!-- Modal de prévisualisation -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Prévisualisation du document</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="preview-content" class="text-center">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Chargement...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal de renommage -->
<div class="modal fade" id="renameDocModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Renommer le document</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <label for="renameDocInput" class="form-label">Nom du fichier</label>
        <input type="text" id="renameDocInput" class="form-control" maxlength="255">
        <div id="renameDocError" class="text-danger small mt-2 d-none"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        <button type="button" id="renameDocConfirm" class="btn btn-primary">
          <i class="bi bi-check2 me-1"></i>Renommer
        </button>
      </div>
    </div>
  </div>
</div>

<style>
.card {
  transition: all 0.3s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
}

.badge-sm {
  font-size: 0.7rem;
  padding: 0.25em 0.5em;
}

.alert-sm {
  padding: 0.5rem;
  margin-bottom: 0.5rem;
}

.preview-btn:hover {
  transform: scale(1.1);
}
</style>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('turbo:load', function() {
  // Gestion de la prévisualisation
  const previewButtons = document.querySelectorAll('.preview-btn');
  const previewModal = new bootstrap.Modal(document.getElementById('previewModal'));
  const previewContent = document.getElementById('preview-content');

  previewButtons.forEach(button => {
    button.addEventListener('click', function() {
      const documentId = this.dataset.documentId;

      previewContent.innerHTML = `
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Chargement...</span>
        </div>
      `;

      previewModal.show();

      fetch(`/documents/${documentId}/preview`)
        .then(response => response.json())
        .then(data => {
          console.log('Preview data received:', data);
          if (data.type === 'image') {
            previewContent.innerHTML = `<img src="${data.url}" class="img-fluid" alt="Prévisualisation">`;
          } else if (data.type === 'pdf') {
            // Utilisation d'iframe au lieu d'embed pour une meilleure compatibilité
            previewContent.innerHTML = `
              <iframe src="${data.url}"
                      width="100%"
                      height="600px"
                      style="border: none;"
                      title="Prévisualisation PDF">
              </iframe>
            `;
          } else {
            previewContent.innerHTML = `<div class="alert alert-warning">${data.message || 'Prévisualisation non disponible'}</div>`;
          }
        })
        .catch(error => {
          console.error('Preview error:', error);
          previewContent.innerHTML = `<div class="alert alert-danger">Erreur lors du chargement de la prévisualisation</div>`;
        });
    });
  });

  // Gestion du renommage — délégation d'événements pour couvrir tous les boutons
  // "Renommer" des différentes vues (liste bien, cartes chantier/global)
  const renameModalEl = document.getElementById('renameDocModal');
  if (renameModalEl) {
    const renameModal   = new bootstrap.Modal(renameModalEl);
    const renameInput   = document.getElementById('renameDocInput');
    const renameError   = document.getElementById('renameDocError');
    const renameConfirm = document.getElementById('renameDocConfirm');
    let currentRenameBtn = null;

    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.rename-doc-btn');
      if (!btn) return;

      currentRenameBtn = btn;
      renameError.classList.add('d-none');
      renameInput.value = btn.dataset.currentFilename || '';
      renameModal.show();
      setTimeout(function() { renameInput.focus(); renameInput.select(); }, 200);
    });

    renameConfirm.addEventListener('click', function() {
      if (!currentRenameBtn) return;
      const newName = renameInput.value.trim();
      if (!newName) {
        renameError.textContent = 'Le nom ne peut pas être vide.';
        renameError.classList.remove('d-none');
        return;
      }

      const documentId = currentRenameBtn.dataset.documentId;
      renameConfirm.disabled = true;
      renameConfirm.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Renommage…';

      fetch(`/documents/${documentId}/rename`, {
        method: 'PATCH',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Content-Type': 'application/x-www-form-urlencoded',
          'Accept': 'application/json'
        },
        body: new URLSearchParams({ filename: newName }).toString()
      })
      .then(r => r.json())
      .then(data => {
        renameConfirm.disabled = false;
        renameConfirm.innerHTML = '<i class="bi bi-check2 me-1"></i>Renommer';
        if (data.success) {
          document.querySelectorAll(`[data-doc-filename-for="${documentId}"]`).forEach(function(el) {
            el.textContent = data.filename;
          });
          currentRenameBtn.dataset.currentFilename = data.filename;
          renameModal.hide();
        } else {
          renameError.textContent = data.error || 'Erreur lors du renommage.';
          renameError.classList.remove('d-none');
        }
      })
      .catch(function() {
        renameConfirm.disabled = false;
        renameConfirm.innerHTML = '<i class="bi bi-check2 me-1"></i>Renommer';
        renameError.textContent = 'Erreur réseau.';
        renameError.classList.remove('d-none');
      });
    });
  }
});
</script>
