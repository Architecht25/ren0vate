<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-cloud-upload"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Upload Document</h1>
    </div>
    <%= link_to documents_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour aux documents
    <% end %>
  </div>

  <div class="row">
    <!-- Formulaire d'upload principal -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-file-earmark-plus me-2"></i>Nouveau Document
          </h5>

          <%= form_with model: @document, local: true, multipart: true,
                        class: "needs-validation upload-form",
                        novalidate: true,
                        data: { turbo: false } do |form| %>

            <!-- Type de document -->
            <div class="mb-4">
              <%= form.label :type_document, "Type de document*", class: "form-label" %>
              <%= form.select :type_document,
                  options_from_collection_for_select(Document.type_documents, :first, :first, @document.type_document),
                  { include_blank: "-- Sélectionnez le type --" },
                  { class: "form-select", required: true } %>
              <div class="invalid-feedback">
                Veuillez sélectionner un type de document.
              </div>
            </div>

            <!-- Association à un bien -->
            <div class="mb-4">
              <%= form.label :property_id, "Bien associé", class: "form-label" %>
              <% if @property %>
                <%= form.hidden_field :property_id, value: @property.id %>
                <div class="alert alert-info">
                  <i class="bi bi-house-door me-2"></i>
                  Document associé au bien : <strong><%= @property.name %></strong>
                </div>
              <% else %>
                <%= form.select :property_id,
                    options_from_collection_for_select(current_user.properties, :id, :address, @document.property_id),
                    { include_blank: "-- Sélectionnez un bien (optionnel) --" },
                    { class: "form-select" } %>
                <small class="form-text text-muted">
                  Sélectionnez le bien concerné par ce document.
                </small>
              <% end %>
            </div>

            <!-- Association à un projet -->
            <div class="mb-4">
              <%= form.label :project_id, "Projet associé", class: "form-label" %>
              <% if @project %>
                <%= form.hidden_field :project_id, value: @project.id %>
                <div class="alert alert-info">
                  <i class="bi bi-tools me-2"></i>
                  Document associé au projet : <strong><%= @project.nom %></strong>
                </div>
              <% else %>
                <%= form.select :project_id,
                    options_from_collection_for_select(current_user.projects, :id, :display_name, @document.project_id),
                    { include_blank: "-- Sélectionnez un projet (optionnel) --" },
                    { class: "form-select" } %>
                <small class="form-text text-muted">
                  Sélectionnez le projet concerné par ce document.
                </small>
              <% end %>
            </div>

            <!-- Association à une demande -->
            <div class="mb-4">
              <%= form.label :request_id, "Demande associée", class: "form-label" %>
              <% if @request %>
                <%= form.hidden_field :request_id, value: @request.id %>
                <div class="alert alert-info">
                  <i class="bi bi-file-text me-2"></i>
                  Document associé à la demande : <strong><%= @request.title %></strong>
                </div>
              <% else %>
                <%= form.select :request_id,
                    options_from_collection_for_select(current_user.requests, :id, :title, @document.request_id),
                    { include_blank: "-- Sélectionnez une demande (optionnel) --" },
                    { class: "form-select" } %>
                <small class="form-text text-muted">
                  Sélectionnez la demande concernée par ce document.
                </small>
              <% end %>
            </div>

            <!-- Zone de drag & drop avec OCR -->
            <div class="mb-4">
              <%= form.label :file, "Fichier*", class: "form-label" %>

              <!-- Options d'upload -->
              <div class="upload-options mb-3">
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="upload_mode" id="upload_normal" value="normal" checked>
                  <label class="form-check-label" for="upload_normal">
                    <i class="bi bi-cloud-upload me-1"></i>Upload normal
                  </label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="upload_mode" id="upload_ocr" value="ocr">
                  <label class="form-check-label" for="upload_ocr">
                    <i class="bi bi-eye me-1"></i>Scan OCR + Upload
                  </label>
                </div>
              </div>

              <div class="upload-zone" id="upload-zone">
                <div class="upload-content">
                  <i class="bi bi-cloud-upload upload-icon" id="upload-icon"></i>
                  <h6 class="upload-title" id="upload-title">Glissez-déposez votre fichier ici</h6>
                  <p class="upload-text text-muted" id="upload-text">ou cliquez pour sélectionner</p>
                  <div class="upload-formats">
                    <small class="text-muted" id="upload-formats">
                      Formats acceptés: PDF, Images (JPEG, PNG, GIF, WebP), Word, Excel
                      <br>Taille max: 10 MB
                    </small>
                  </div>
                </div>
                <%= form.file_field :file,
                    class: "upload-input",
                    accept: ".pdf,.jpg,.jpeg,.png,.gif,.webp,.doc,.docx,.xls,.xlsx",
                    required: true %>
                <div class="invalid-feedback">
                  Veuillez sélectionner un fichier.
                </div>
              </div>

              <!-- Prévisualisation du fichier -->
              <div class="file-preview" id="file-preview" style="display: none;">
                <div class="d-flex align-items-center p-3 bg-light rounded">
                  <i class="bi bi-file-earmark me-3 text-primary-custom"></i>
                  <div class="flex-grow-1">
                    <div class="file-name fw-medium"></div>
                    <div class="file-size text-muted small"></div>
                  </div>
                  <button type="button" class="btn btn-sm btn-outline-danger" id="remove-file">
                    <i class="bi bi-trash"></i>
                  </button>
                </div>
              </div>

              <!-- Zone de résultat OCR -->
              <div class="ocr-result" id="ocr-result" style="display: none;">
                <div class="card border-0 bg-info-subtle mt-3">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center mb-2">
                      <i class="bi bi-eye text-info me-2"></i>
                      <h6 class="mb-0 text-info-emphasis">Texte extrait par OCR</h6>
                      <span class="badge bg-info ms-auto" id="ocr-confidence"></span>
                    </div>
                    <div class="ocr-text-container">
                      <div class="form-floating">
                        <textarea class="form-control" id="ocr-text" readonly style="height: 120px; font-size: 0.9rem;"></textarea>
                        <label for="ocr-text">Texte extrait</label>
                      </div>
                      <div class="d-flex justify-content-between align-items-center mt-2">
                        <small class="text-muted">
                          <i class="bi bi-clock me-1"></i>
                          <span id="ocr-processing-time"></span>
                        </small>
                        <button type="button" class="btn btn-sm btn-outline-info" id="copy-ocr-text">
                          <i class="bi bi-clipboard me-1"></i>Copier
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Indicateur de traitement OCR -->
              <div class="ocr-processing" id="ocr-processing" style="display: none;">
                <div class="card border-0 bg-warning-subtle mt-3">
                  <div class="card-body p-3 text-center">
                    <div class="spinner-border spinner-border-sm text-warning me-2" role="status"></div>
                    <span class="text-warning-emphasis">Analyse OCR en cours...</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Notes optionnelles avec texte OCR -->
            <div class="mb-4">
              <%= form.label :notes, "Notes (optionnel)", class: "form-label" %>
              <%= form.text_area :notes,
                  class: "form-control",
                  rows: 4,
                  id: "document-notes",
                  placeholder: "Ajoutez des notes ou commentaires sur ce document..." %>
              <div class="mt-2">
                <button type="button" class="btn btn-sm btn-outline-info" id="append-ocr-to-notes" style="display: none;">
                  <i class="bi bi-plus-circle me-1"></i>Ajouter le texte OCR aux notes
                </button>
              </div>
            </div>

            <!-- Status -->
            <div class="mb-4">
              <%= form.label :status, "Statut", class: "form-label" %>
              <%= form.select :status,
                  options_from_collection_for_select(Document.statuses, :first, :first, 'pending'),
                  {},
                  { class: "form-select" } %>
            </div>

            <!-- Boutons d'action -->
            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Annuler", documents_path, class: "btn btn-outline-secondary" %>
              <%= form.submit "Uploader le document",
                  class: "btn btn-primary-custom",
                  data: { disable_with: "Upload en cours..." } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar avec informations -->
    <div class="col-lg-4">
      <!-- Types de documents -->
      <div class="card border-0 bg-light-custom mb-4">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-info-circle me-2"></i>Types de documents
          </h6>
          <div class="document-types-list">
            <% Document.type_documents.each do |key, value| %>
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-file-earmark text-muted me-2"></i>
                <small class="text-capitalize"><%= key.humanize %></small>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Conseils d'upload -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-lightbulb me-2"></i>Conseils d'upload
          </h6>
          <ul class="list-unstyled text-muted-custom small">
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Nommez vos fichiers clairement
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Vérifiez la qualité des images
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Utilisez le format PDF quand possible
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Ajoutez des notes explicatives
            </li>
          </ul>
        </div>
      </div>

      <!-- Sécurité -->
      <div class="card border-0 bg-warning-subtle mb-4">
        <div class="card-body p-4">
          <h6 class="card-title text-warning-emphasis mb-3">
            <i class="bi bi-shield-check me-2"></i>Sécurité & Confidentialité
          </h6>
          <p class="text-warning-emphasis small mb-0">
            Vos documents sont stockés de manière sécurisée et ne sont accessibles qu'à vous et aux personnes autorisées.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* Styles pour l'upload zone */
.upload-zone {
  border: 2px dashed #dee2e6;
  border-radius: 8px;
  padding: 3rem 2rem;
  text-align: center;
  transition: all 0.3s ease;
  position: relative;
  background: #f8f9fa;
  cursor: pointer;
}

.upload-zone:hover,
.upload-zone.dragover {
  border-color: var(--bs-primary);
  background: rgba(var(--bs-primary-rgb), 0.05);
}

.upload-zone.dragover {
  transform: scale(1.02);
}

.upload-zone.ocr-mode {
  border-color: #0dcaf0;
  background: rgba(13, 202, 240, 0.05);
}

.upload-zone.ocr-mode:hover,
.upload-zone.ocr-mode.dragover {
  border-color: #0dcaf0;
  background: rgba(13, 202, 240, 0.1);
}

.upload-options {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
}

.upload-options .form-check-label {
  cursor: pointer;
  padding: 0.5rem 1rem;
  border: 1px solid #dee2e6;
  border-radius: 6px;
  transition: all 0.2s ease;
}

.upload-options .form-check-input:checked + .form-check-label {
  background-color: var(--bs-primary);
  color: white;
  border-color: var(--bs-primary);
}

.upload-options .form-check-input[value="ocr"]:checked + .form-check-label {
  background-color: #0dcaf0;
  border-color: #0dcaf0;
}

.upload-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.upload-icon {
  font-size: 3rem;
  color: var(--bs-primary);
  margin-bottom: 1rem;
}

.upload-title {
  color: var(--bs-primary);
  margin-bottom: 0.5rem;
}

.upload-text {
  margin-bottom: 1rem;
}

.upload-formats {
  border-top: 1px solid #dee2e6;
  padding-top: 1rem;
}

.file-preview {
  margin-top: 1rem;
}

/* Styles OCR */
.ocr-result {
  animation: slideDown 0.3s ease-out;
}

.ocr-processing {
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ocr-text-container .form-control {
  background-color: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(13, 202, 240, 0.3);
}

.ocr-text-container .form-floating > label {
  color: #0dcaf0;
}

/* Animation de loading */
.btn[data-disable-with] {
  position: relative;
}

.btn[disabled] {
  pointer-events: none;
}

/* Responsive */
@media (max-width: 768px) {
  .upload-zone {
    padding: 2rem 1rem;
  }

  .upload-icon {
    font-size: 2rem;
  }
}
</style>

<script>
document.addEventListener('turbo:load', function() {
  const uploadZone = document.getElementById('upload-zone');
  const fileInput = document.querySelector('.upload-input');
  const filePreview = document.getElementById('file-preview');
  const removeFileBtn = document.getElementById('remove-file');
  const uploadModeRadios = document.querySelectorAll('input[name="upload_mode"]');
  const ocrResult = document.getElementById('ocr-result');
  const ocrProcessing = document.getElementById('ocr-processing');
  const appendOcrBtn = document.getElementById('append-ocr-to-notes');
  const copyOcrBtn = document.getElementById('copy-ocr-text');
  const documentNotes = document.getElementById('document-notes');

  let currentOcrText = '';
  let isOcrMode = false;

  if (!uploadZone || !fileInput) return;

  // Gestion du changement de mode upload
  uploadModeRadios.forEach(radio => {
    radio.addEventListener('change', function() {
      isOcrMode = this.value === 'ocr';
      updateUploadZoneAppearance();
    });
  });

  function updateUploadZoneAppearance() {
    const uploadIcon = document.getElementById('upload-icon');
    const uploadTitle = document.getElementById('upload-title');
    const uploadText = document.getElementById('upload-text');
    const uploadFormats = document.getElementById('upload-formats');

    if (isOcrMode) {
      uploadZone.classList.add('ocr-mode');
      uploadIcon.className = 'bi bi-eye upload-icon';
      uploadTitle.textContent = 'Glissez-déposez votre document pour scan OCR';
      uploadText.textContent = 'Le texte sera automatiquement extrait du document';
      uploadFormats.innerHTML = `
        <small class="text-info">
          <i class="bi bi-info-circle me-1"></i>
          Formats optimaux pour OCR: PDF, JPEG, PNG
          <br>Le texte extrait sera ajouté automatiquement aux notes
        </small>
      `;
    } else {
      uploadZone.classList.remove('ocr-mode');
      uploadIcon.className = 'bi bi-cloud-upload upload-icon';
      uploadTitle.textContent = 'Glissez-déposez votre fichier ici';
      uploadText.textContent = 'ou cliquez pour sélectionner';
      uploadFormats.innerHTML = `
        <small class="text-muted">
          Formats acceptés: PDF, Images (JPEG, PNG, GIF, WebP), Word, Excel
          <br>Taille max: 10 MB
        </small>
      `;
    }
  }

  // Drag & Drop handlers
  uploadZone.addEventListener('dragover', function(e) {
    e.preventDefault();
    uploadZone.classList.add('dragover');
  });

  uploadZone.addEventListener('dragleave', function(e) {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
  });

  uploadZone.addEventListener('drop', function(e) {
    e.preventDefault();
    uploadZone.classList.remove('dragover');

    const files = e.dataTransfer.files;
    if (files.length > 0) {
      fileInput.files = files;
      handleFileSelect(files[0]);
    }
  });

  // Click handler
  uploadZone.addEventListener('click', function() {
    fileInput.click();
  });

  // File selection handler
  fileInput.addEventListener('change', function(e) {
    if (e.target.files.length > 0) {
      handleFileSelect(e.target.files[0]);
    }
  });

  // Remove file handler
  if (removeFileBtn) {
    removeFileBtn.addEventListener('click', function() {
      fileInput.value = '';
      filePreview.style.display = 'none';
      uploadZone.style.display = 'block';
      hideOcrResult();
    });
  }

  // OCR buttons handlers
  if (copyOcrBtn) {
    copyOcrBtn.addEventListener('click', function() {
      const ocrTextArea = document.getElementById('ocr-text');
      ocrTextArea.select();
      document.execCommand('copy');

      // Feedback visuel
      const originalText = this.innerHTML;
      this.innerHTML = '<i class="bi bi-check me-1"></i>Copié!';
      this.classList.remove('btn-outline-info');
      this.classList.add('btn-success');

      setTimeout(() => {
        this.innerHTML = originalText;
        this.classList.remove('btn-success');
        this.classList.add('btn-outline-info');
      }, 2000);
    });
  }

  if (appendOcrBtn) {
    appendOcrBtn.addEventListener('click', function() {
      if (currentOcrText && documentNotes) {
        const currentNotes = documentNotes.value;
        const separator = currentNotes ? '\n\n---\n\n' : '';
        const ocrSection = `📄 Texte extrait par OCR:\n\n${currentOcrText}`;

        documentNotes.value = currentNotes + separator + ocrSection;
        documentNotes.focus();

        // Feedback
        this.innerHTML = '<i class="bi bi-check me-1"></i>Ajouté aux notes';
        this.classList.remove('btn-outline-info');
        this.classList.add('btn-success');

        setTimeout(() => {
          this.innerHTML = '<i class="bi bi-plus-circle me-1"></i>Ajouter le texte OCR aux notes';
          this.classList.remove('btn-success');
          this.classList.add('btn-outline-info');
        }, 3000);
      }
    });
  }

  function handleFileSelect(file) {
    // Validation côté client
    const maxSize = 10 * 1024 * 1024; // 10 MB
    const allowedTypes = [
      'application/pdf',
      'image/jpeg', 'image/png', 'image/gif', 'image/webp',
      'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
    ];

    if (file.size > maxSize) {
      alert('Le fichier est trop volumineux. Taille maximum: 10 MB');
      return;
    }

    if (!allowedTypes.includes(file.type)) {
      alert('Format de fichier non autorisé. Veuillez utiliser: PDF, images, documents Word/Excel');
      return;
    }

    // Afficher la prévisualisation
    displayFilePreview(file);

    // Si mode OCR, lancer l'OCR
    if (isOcrMode) {
      performOCR(file);
    }
  }

  function displayFilePreview(file) {
    const fileName = filePreview.querySelector('.file-name');
    const fileSize = filePreview.querySelector('.file-size');

    fileName.textContent = file.name;
    fileSize.textContent = formatFileSize(file.size);

    uploadZone.style.display = 'none';
    filePreview.style.display = 'block';
  }

  function performOCR(file) {
    showOcrProcessing();
    hideOcrResult();

    const formData = new FormData();
    formData.append('file', file);

    fetch('/ocr/scan', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      hideOcrProcessing();

      if (data.success) {
        showOcrResult(data);
      } else {
        showOcrError(data.error || 'Erreur lors du traitement OCR');
      }
    })
    .catch(error => {
      hideOcrProcessing();
      console.error('Erreur OCR:', error);
      showOcrError('Erreur de connexion lors du traitement OCR');
    });
  }

  function showOcrProcessing() {
    ocrProcessing.style.display = 'block';
  }

  function hideOcrProcessing() {
    ocrProcessing.style.display = 'none';
  }

  function showOcrResult(data) {
    currentOcrText = data.text;

    document.getElementById('ocr-text').value = data.text;
    document.getElementById('ocr-confidence').textContent = `${data.confidence}% confiance`;
    document.getElementById('ocr-processing-time').textContent = `Traité en ${data.processing_time}s`;

    ocrResult.style.display = 'block';
    appendOcrBtn.style.display = data.text ? 'inline-block' : 'none';

    // Auto-ajout aux notes si le texte est de bonne qualité
    if (data.confidence > 70 && data.text.length > 10) {
      const currentNotes = documentNotes.value;
      if (!currentNotes.includes('📄 Texte extrait par OCR:')) {
        const separator = currentNotes ? '\n\n---\n\n' : '';
        const ocrSection = `📄 Texte extrait par OCR (${data.confidence}% confiance):\n\n${data.text}`;
        documentNotes.value = currentNotes + separator + ocrSection;
      }
    }
  }

  function showOcrError(errorMessage) {
    const errorHtml = `
      <div class="card border-0 bg-danger-subtle mt-3">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle text-danger me-2"></i>
            <span class="text-danger-emphasis">${errorMessage}</span>
          </div>
        </div>
      </div>
    `;

    ocrResult.innerHTML = errorHtml;
    ocrResult.style.display = 'block';
  }

  function hideOcrResult() {
    ocrResult.style.display = 'none';
    appendOcrBtn.style.display = 'none';
    currentOcrText = '';
  }

  function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }
});

// Validation Bootstrap
(function() {
  'use strict';
  var forms = document.querySelectorAll('.needs-validation');
  Array.prototype.slice.call(forms)
    .forEach(function(form) {
      form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
})();
</script>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
