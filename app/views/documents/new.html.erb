<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-cloud-upload"></i>
      </div>
      <h1 class="h3 text-primary-custom mb-0 fw-normal">Upload Document</h1>
    </div>
    <%= link_to documents_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour aux documents
    <% end %>
  </div>

  <div class="row">
    <!-- Formulaire d'upload principal -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-file-earmark-plus me-2"></i>Nouveau Document
          </h5>

          <%= form_with model: @document, local: true, multipart: true,
                        class: "needs-validation upload-form",
                        novalidate: true,
                        data: { turbo: false } do |form| %>

            <!-- Type de document -->
            <% if @document.type_document.present? %>
              <!-- Type pré-défini -->
              <%= form.hidden_field :type_document, value: @document.type_document %>
              <div class="mb-4">
                <div class="alert alert-success">
                  <i class="bi bi-file-earmark-check me-2"></i>
                  Type de document : <strong><%= @document.type_document.humanize %></strong>
                </div>
              </div>
            <% else %>
              <!-- Sélection du type -->
              <div class="mb-4">
                <%= form.label :type_document, "Type de document*", class: "form-label" %>
                <%= form.select :type_document,
                    options_from_collection_for_select(Document.type_documents, :first, :first, @document.type_document),
                    { include_blank: "-- Sélectionnez le type --" },
                    { class: "form-select", required: true } %>
                <div class="invalid-feedback">
                  Veuillez sélectionner un type de document.
                </div>
              </div>
            <% end %>

            <!-- Associations (bien, projet, demande) -->
            <% # Vérifier s'il y a des associations prédéfinies %>
            <% has_predefined_associations = @property || @project || @request %>

            <% if has_predefined_associations %>
              <!-- Affichage des associations prédéfinies -->
              <% if @property %>
                <%= form.hidden_field :property_id, value: @property.id %>
                <div class="mb-4">
                  <div class="alert alert-info">
                    <i class="bi bi-house-door me-2"></i>
                    Document associé au bien : <strong><%= @property.name %></strong>
                  </div>
                </div>
              <% end %>

              <% if @project %>
                <%= form.hidden_field :project_id, value: @project.id %>
                <div class="mb-4">
                  <div class="alert alert-info">
                    <i class="bi bi-tools me-2"></i>
                    Document associé au projet : <strong><%= @project.nom %></strong>
                  </div>
                </div>
              <% end %>

              <% if @request %>
                <%= form.hidden_field :request_id, value: @request.id %>
                <div class="mb-4">
                  <div class="alert alert-info">
                    <i class="bi bi-file-text me-2"></i>
                    Document associé à la demande : <strong><%= @request.title %></strong>
                  </div>
                </div>
              <% end %>
            <% else %>
              <!-- Sélection des associations sur une ligne -->
              <div class="mb-4">
                <label class="form-label">Associations (optionnelles)</label>
                <div class="row associations-row">
                  <div class="col-md-4">
                    <%= form.label :property_id, "Bien", class: "form-label small" %>
                    <%= form.select :property_id,
                        options_from_collection_for_select(current_user.properties, :id, :address, @document.property_id),
                        { include_blank: "-- Aucun --" },
                        { class: "form-select form-select-sm" } %>
                  </div>
                  <div class="col-md-4">
                    <%= form.label :project_id, "Projet", class: "form-label small" %>
                    <%= form.select :project_id,
                        options_from_collection_for_select(current_user.projects, :id, :display_name, @document.project_id),
                        { include_blank: "-- Aucun --" },
                        { class: "form-select form-select-sm" } %>
                  </div>
                  <div class="col-md-4">
                    <%= form.label :request_id, "Demande", class: "form-label small" %>
                    <%= form.select :request_id,
                        options_from_collection_for_select(current_user.requests, :id, :title, @document.request_id),
                        { include_blank: "-- Aucune --" },
                        { class: "form-select form-select-sm" } %>
                  </div>
                </div>
                <small class="form-text text-muted mt-2">
                  <i class="bi bi-info-circle me-1"></i>
                  Associez ce document à un bien, projet ou demande existant pour une meilleure organisation.
                </small>
              </div>
            <% end %>

            <!-- Zone de drag & drop avec OCR -->
            <div class="mb-4">
              <%= form.label :file, "Fichier*", class: "form-label" %>

              <!-- Options d'upload -->
              <div class="upload-options mb-3">
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="upload_mode" id="upload_normal" value="normal" <%= @ocr_mode ? '' : 'checked' %>>
                  <label class="form-check-label" for="upload_normal">
                    <i class="bi bi-cloud-upload me-1"></i>Upload normal
                  </label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="upload_mode" id="upload_ocr" value="ocr" <%= @ocr_mode ? 'checked' : '' %>>
                  <label class="form-check-label" for="upload_ocr">
                    <i class="bi bi-eye me-1"></i>Scan OCR + Upload
                  </label>
                </div>
              </div>

              <div class="upload-zone" id="upload-zone">
                <div class="upload-content">
                  <i class="bi bi-cloud-upload upload-icon" id="upload-icon"></i>
                  <h6 class="upload-title" id="upload-title">Glissez-déposez vos fichiers ici</h6>
                  <p class="upload-text text-muted" id="upload-text">ou cliquez pour sélectionner (plusieurs fichiers possibles)</p>
                  <div class="upload-formats">
                    <small class="text-muted" id="upload-formats">
                      Formats acceptés: PDF, Images (JPEG, PNG, GIF, WebP), Word, Excel
                      <br>Taille max: 30 MB
                    </small>
                  </div>
                </div>
                <%= form.file_field :file,
                    class: "upload-input",
                    accept: ".pdf,.jpg,.jpeg,.png,.gif,.webp,.doc,.docx,.xls,.xlsx",
                    multiple: true,
                    required: true %>
                <div class="invalid-feedback">
                  Veuillez sélectionner au moins un fichier.
                </div>
              </div>

              <!-- Prévisualisation du fichier améliorée -->
              <div id="file-preview" style="display: none;">
                <div class="card mt-3">
                  <div class="card-header">
                    <h6 class="mb-0">
                      <i class="bi bi-eye me-2"></i>Prévisualisation
                    </h6>
                  </div>
                  <div class="card-body">
                    <div id="preview-content">
                      <!-- Le contenu de la prévisualisation sera inséré ici par JavaScript -->
                    </div>
                  </div>
                </div>
              </div>

              <!-- Zone de résultat OCR -->
              <div class="ocr-result" id="ocr-result" style="display: none;">
                <div class="card border-0 bg-info-subtle mt-3">
                  <div class="card-body p-3">
                    <div class="d-flex align-items-center mb-2">
                      <i class="bi bi-eye text-info me-2"></i>
                      <h6 class="mb-0 text-info-emphasis">Texte extrait par OCR</h6>
                      <span class="badge bg-info ms-auto" id="ocr-confidence"></span>
                    </div>
                    <div class="ocr-text-container">
                      <div class="form-floating">
                        <textarea class="form-control" id="ocr-text" readonly style="height: 120px; font-size: 0.9rem;"></textarea>
                        <label for="ocr-text">Texte extrait</label>
                      </div>
                      <div class="d-flex justify-content-between align-items-center mt-2">
                        <small class="text-muted">
                          <i class="bi bi-clock me-1"></i>
                          <span id="ocr-processing-time"></span>
                        </small>
                        <button type="button" class="btn btn-sm btn-outline-info" id="copy-ocr-text">
                          <i class="bi bi-clipboard me-1"></i>Copier
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Indicateur de traitement OCR -->
              <div class="ocr-processing" id="ocr-processing" style="display: none;">
                <div class="card border-0 bg-warning-subtle mt-3">
                  <div class="card-body p-3 text-center">
                    <div class="spinner-border spinner-border-sm text-warning me-2" role="status"></div>
                    <span class="text-warning-emphasis">Analyse OCR en cours...</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Boutons d'action -->
            <div class="d-flex justify-content-end gap-2">
              <%= link_to "Annuler", documents_path, class: "btn btn-outline-secondary" %>
              <%= form.submit "Uploader le document",
                  class: "btn btn-primary-custom",
                  data: { disable_with: "Upload en cours..." } %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Sidebar avec informations -->
    <div class="col-lg-4">
      <!-- Types de documents -->
      <div class="card border-0 bg-light-custom mb-4">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-info-circle me-2"></i>Types de documents
          </h6>
          <div class="document-types-list">
            <% Document.type_documents.each do |key, value| %>
              <div class="d-flex align-items-center mb-2">
                <i class="bi bi-file-earmark text-muted me-2"></i>
                <small class="text-capitalize"><%= key.humanize %></small>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Conseils d'upload -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-lightbulb me-2"></i>Conseils d'upload
          </h6>
          <ul class="list-unstyled text-muted-custom small">
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Nommez vos fichiers clairement
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Vérifiez la qualité des images
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Utilisez le format PDF quand possible
            </li>
            <li class="mb-2">
              <i class="bi bi-check-circle text-success me-2"></i>
              Utilisez la fonction OCR pour l'extraction de texte
            </li>
          </ul>
        </div>
      </div>

      <!-- Sécurité -->
      <div class="card border-0 bg-warning-subtle mb-4">
        <div class="card-body p-4">
          <h6 class="card-title text-warning-emphasis mb-3">
            <i class="bi bi-shield-check me-2"></i>Sécurité & Confidentialité
          </h6>
          <p class="text-warning-emphasis small mb-0">
            Vos documents sont stockés de manière sécurisée et ne sont accessibles qu'à vous et aux personnes autorisées.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* Styles pour l'upload zone */
.upload-zone {
  border: 2px dashed #dee2e6;
  border-radius: 8px;
  padding: 3rem 2rem;
  text-align: center;
  transition: all 0.3s ease;
  position: relative;
  background: #f8f9fa;
  cursor: pointer;
}

.upload-zone:hover,
.upload-zone.dragover {
  border-color: var(--bs-primary);
  background: rgba(var(--bs-primary-rgb), 0.05);
}

.upload-zone.dragover {
  transform: scale(1.02);
}

.upload-zone.ocr-mode {
  border-color: #0dcaf0;
  background: rgba(13, 202, 240, 0.05);
}

.upload-zone.ocr-mode:hover,
.upload-zone.ocr-mode.dragover {
  border-color: #0dcaf0;
  background: rgba(13, 202, 240, 0.1);
}

.upload-options {
  display: flex;
  gap: 1rem;
  margin-bottom: 1rem;
}

.upload-options .form-check-label {
  cursor: pointer;
  padding: 0.5rem 1rem;
  border: 1px solid #dee2e6;
  border-radius: 6px;
  transition: all 0.2s ease;
}

.upload-options .form-check-input:checked + .form-check-label {
  background-color: var(--bs-primary);
  color: white;
  border-color: var(--bs-primary);
}

.upload-options .form-check-input[value="ocr"]:checked + .form-check-label {
  background-color: #0dcaf0;
  border-color: #0dcaf0;
}

.upload-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.upload-icon {
  font-size: 3rem;
  color: var(--bs-primary);
  margin-bottom: 1rem;
}

.upload-title {
  color: var(--bs-primary);
  margin-bottom: 0.5rem;
}

.upload-text {
  margin-bottom: 1rem;
}

.upload-formats {
  border-top: 1px solid #dee2e6;
  padding-top: 1rem;
}

.file-preview {
  margin-top: 1rem;
}

/* Styles OCR */
.ocr-result {
  animation: slideDown 0.3s ease-out;
}

.ocr-processing {
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ocr-text-container .form-control {
  background-color: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(13, 202, 240, 0.3);
}

.ocr-text-container .form-floating > label {
  color: #0dcaf0;
}

/* Animation de loading */
.btn[data-disable-with] {
  position: relative;
}

.btn[disabled] {
  pointer-events: none;
}

/* === AMÉLIORATIONS POUR LES ASSOCIATIONS EN LIGNE === */
.form-select-sm {
  font-size: 0.875rem;
}

.associations-row .col-md-4 {
  margin-bottom: 0.5rem;
}

@media (max-width: 768px) {
  .associations-row .col-md-4 {
    margin-bottom: 1rem;
  }
}
</style>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('turbo:load', function() {
  const uploadZone = document.getElementById('upload-zone');
  const fileInput = document.querySelector('.upload-input');
  const filePreview = document.getElementById('file-preview');
  const removeFileBtn = document.getElementById('remove-file');
  const uploadModeRadios = document.querySelectorAll('input[name="upload_mode"]');
  const ocrResult = document.getElementById('ocr-result');
  const ocrProcessing = document.getElementById('ocr-processing');
  const copyOcrBtn = document.getElementById('copy-ocr-text');

  let currentOcrText = '';
  let isOcrMode = <%= @ocr_mode ? 'true' : 'false' %>;

  if (!uploadZone || !fileInput) return;

  // Initialisation du mode OCR basé sur l'URL
  console.log('🔍 Mode OCR initial:', isOcrMode);
  updateUploadZoneAppearance();

  // Gestion du changement de mode upload
  uploadModeRadios.forEach(radio => {
    radio.addEventListener('change', function() {
      isOcrMode = this.value === 'ocr';
      console.log('🔄 Changement de mode OCR:', isOcrMode);
      updateUploadZoneAppearance();
    });
  });

  function updateUploadZoneAppearance() {
    const uploadIcon = document.getElementById('upload-icon');
    const uploadTitle = document.getElementById('upload-title');
    const uploadText = document.getElementById('upload-text');
    const uploadFormats = document.getElementById('upload-formats');

    if (isOcrMode) {
      uploadZone.classList.add('ocr-mode');
      uploadIcon.className = 'bi bi-eye upload-icon';
      uploadTitle.textContent = 'Glissez-déposez vos documents pour scan OCR';
      uploadText.textContent = 'Le texte sera automatiquement extrait de chaque document';
      uploadFormats.innerHTML = `
        <small class="text-info">
          <i class="bi bi-info-circle me-1"></i>
          Formats optimaux pour OCR: PDF, JPEG, PNG
          <br>Le texte extrait sera ajouté automatiquement aux notes
          <br>Plusieurs fichiers possibles
        </small>
      `;
    } else {
      uploadZone.classList.remove('ocr-mode');
      uploadIcon.className = 'bi bi-cloud-upload upload-icon';
      uploadTitle.textContent = 'Glissez-déposez vos fichiers ici';
      uploadText.textContent = 'ou cliquez pour sélectionner (plusieurs fichiers possibles)';
      uploadFormats.innerHTML = `
        <small class="text-muted">
          Formats acceptés: PDF, Images (JPEG, PNG, GIF, WebP), Word, Excel
          <br>Taille max: 30 MB par fichier
        </small>
      `;
    }
  }

  // Gestion multiple de fichiers
  function handleMultipleFileSelect(files) {
    if (files.length === 1) {
      // Un seul fichier : utiliser la logique existante
      handleFileSelect(files[0]);
    } else {
      // Plusieurs fichiers : afficher la liste
      showMultipleFilesPreview(files);
    }
  }

  function showMultipleFilesPreview(files) {
    const filesArray = Array.from(files);
    const fileNames = filesArray.map(file => file.name).join(', ');

    uploadZone.style.display = 'none';
    if (filePreview) {
      filePreview.style.display = 'block';

      filePreview.innerHTML = `
        <div class="multiple-files-preview">
          <div class="d-flex align-items-center mb-3">
            <i class="bi bi-files text-primary me-2" style="font-size: 2rem;"></i>
            <div>
              <h6 class="mb-1">${files.length} fichier(s) sélectionné(s)</h6>
              <p class="text-muted mb-0 small">${fileNames}</p>
            </div>
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="change-files">
              <i class="bi bi-arrow-repeat me-1"></i>Changer
            </button>
          </div>
        </div>
      `;

      // Handler pour changer les fichiers
      const changeFilesBtn = document.getElementById('change-files');
      if (changeFilesBtn) {
        changeFilesBtn.addEventListener('click', function() {
          fileInput.value = '';
          filePreview.style.display = 'none';
          uploadZone.style.display = 'block';
        });
      }
    }
  }

  // Drag & Drop handlers
  uploadZone.addEventListener('dragover', function(e) {
    e.preventDefault();
    uploadZone.classList.add('dragover');
  });

  uploadZone.addEventListener('dragleave', function(e) {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
  });

  uploadZone.addEventListener('drop', function(e) {
    e.preventDefault();
    uploadZone.classList.remove('dragover');

    const files = e.dataTransfer.files;
    if (files.length > 0) {
      fileInput.files = files;
      handleMultipleFileSelect(files);
    }
  });

  // Click handler - éviter les conflits avec le contrôleur Stimulus
  uploadZone.addEventListener('click', function(e) {
    // Éviter de déclencher si le clic vient du file input lui-même
    if (e.target === fileInput) return;

    e.preventDefault();
    e.stopPropagation();
    fileInput.click();
  });

  // File selection handler - éviter les doubles événements
  fileInput.addEventListener('change', function(e) {
    e.stopPropagation();
    if (e.target.files.length > 0) {
      console.log('📁 Fichier(s) sélectionné(s):', e.target.files.length);
      handleMultipleFileSelect(e.target.files);
    }
  });

  // Remove file handler - géré maintenant dans displayFilePreview et showMultipleFilesPreview
  // Plus besoin d'un gestionnaire séparé

  // OCR buttons handlers
  if (copyOcrBtn) {
    copyOcrBtn.addEventListener('click', function() {
      const ocrTextArea = document.getElementById('ocr-text');
      ocrTextArea.select();
      document.execCommand('copy');

      // Feedback visuel
      const originalText = this.innerHTML;
      this.innerHTML = '<i class="bi bi-check me-1"></i>Copié!';
      this.classList.remove('btn-outline-info');
      this.classList.add('btn-success');

      setTimeout(() => {
        this.innerHTML = originalText;
        this.classList.remove('btn-success');
        this.classList.add('btn-outline-info');
      }, 2000);
    });
  }

  // Plus de fonctionnalité d'ajout aux notes puisque le champ a été retiré

  function handleFileSelect(file) {
    // Validation côté client
    const maxSize = 30 * 1024 * 1024; // 30 MB
    const allowedTypes = [
      'application/pdf',
      'image/jpeg', 'image/png', 'image/gif', 'image/webp',
      'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
      'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
    ];

    if (file.size > maxSize) {
      alert('Le fichier est trop volumineux. Taille maximum: 30 MB');
      return;
    }

    if (!allowedTypes.includes(file.type)) {
      alert('Format de fichier non autorisé. Veuillez utiliser: PDF, images, documents Word/Excel');
      return;
    }

    // Afficher la prévisualisation
    displayFilePreview(file);

    // Si mode OCR, lancer l'OCR
    if (isOcrMode) {
      performOCR(file);
    }
  }

  function displayFilePreview(file) {
    if (filePreview) {
      const previewContent = document.getElementById('preview-content');
      if (previewContent) {
        previewContent.innerHTML = `
          <div class="d-flex align-items-center mb-3">
            <i class="bi bi-file-earmark text-primary me-2" style="font-size: 2rem;"></i>
            <div>
              <h6 class="mb-1 file-name">${file.name}</h6>
              <p class="text-muted mb-0 small file-size">${formatFileSize(file.size)}</p>
            </div>
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="change-file">
              <i class="bi bi-arrow-repeat me-1"></i>Changer
            </button>
          </div>
        `;

        // Handler pour changer le fichier
        const changeFileBtn = document.getElementById('change-file');
        if (changeFileBtn) {
          changeFileBtn.addEventListener('click', function() {
            fileInput.value = '';
            filePreview.style.display = 'none';
            uploadZone.style.display = 'block';
            hideOcrResult();
          });
        }
      }

      uploadZone.style.display = 'none';
      filePreview.style.display = 'block';
    }
  }

  function performOCR(file) {
    showOcrProcessing();
    hideOcrResult();

    const formData = new FormData();
    formData.append('file', file);

    fetch('/ocr/scan', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      hideOcrProcessing();

      if (data.success) {
        showOcrResult(data);
      } else {
        showOcrError(data.error || 'Erreur lors du traitement OCR');
      }
    })
    .catch(error => {
      hideOcrProcessing();
      console.error('Erreur OCR:', error);
      showOcrError('Erreur de connexion lors du traitement OCR');
    });
  }

  function showOcrProcessing() {
    ocrProcessing.style.display = 'block';
  }

  function hideOcrProcessing() {
    ocrProcessing.style.display = 'none';
  }

  function showOcrResult(data) {
    currentOcrText = data.text;

    document.getElementById('ocr-text').value = data.text;
    document.getElementById('ocr-confidence').textContent = `${data.confidence}% confiance`;
    document.getElementById('ocr-processing-time').textContent = `Traité en ${data.processing_time}s`;

    ocrResult.style.display = 'block';
    // Plus de bouton d'ajout aux notes puisque le champ a été retiré
  }

  function showOcrError(errorMessage) {
    const errorHtml = `
      <div class="card border-0 bg-danger-subtle mt-3">
        <div class="card-body p-3">
          <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle text-danger me-2"></i>
            <span class="text-danger-emphasis">${errorMessage}</span>
          </div>
        </div>
      </div>
    `;

    ocrResult.innerHTML = errorHtml;
    ocrResult.style.display = 'block';
  }

  function hideOcrResult() {
    ocrResult.style.display = 'none';
    currentOcrText = '';
  }

  function formatFileSize(bytes) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }
});

// Validation Bootstrap
(function() {
  'use strict';
  var forms = document.querySelectorAll('.needs-validation');
  Array.prototype.slice.call(forms)
    .forEach(function(form) {
      form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
})();
</script>

