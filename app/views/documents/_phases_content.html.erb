<!-- Vue par phases - affichée dans tous les contextes sauf quand on filtre directement par type -->
<% if @phases_data&.any? && !params[:type_document].present? %>
  <% if @selected_phase.present? %>
    <%= render 'phase_detail', phase: @selected_phase %>
  <% else %>
    <%= render 'phases_overview' %>
  <% end %>
<% end %>
