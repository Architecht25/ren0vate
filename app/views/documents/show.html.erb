<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div class="d-flex align-items-center">
      <div class="icon-circle me-3">
        <i class="bi bi-file-earmark-text"></i>
      </div>
      <div>
        <h1 class="h3 text-primary-custom mb-0 fw-normal">Document</h1>
        <p class="text-muted mb-0"><%= @document.type_document %></p>
      </div>
    </div>
    <%= link_to documents_path, class: "btn btn-outline-primary-custom px-4" do %>
      <i class="bi bi-arrow-left me-2"></i>
      Retour aux documents
    <% end %>
  </div>

  <!-- Contenu principal -->
  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
          <h5 class="card-title text-primary-custom mb-4">
            <i class="bi bi-info-circle me-2"></i>Détails du document
          </h5>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label text-muted-custom">Type de document</label>
              <p class="mb-0"><%= @document.type_document %></p>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label text-muted-custom">Statut</label>
              <p class="mb-0">
                <% case @document.status %>
                <% when 'pending' %>
                  <span class="badge bg-warning text-dark">En attente</span>
                <% when 'approved' %>
                  <span class="badge bg-success">Approuvé</span>
                <% when 'rejected' %>
                  <span class="badge bg-danger">Rejeté</span>
                <% else %>
                  <span class="badge bg-secondary">Inconnu</span>
                <% end %>
              </p>
            </div>
          </div>

          <% if @document.notes.present? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom">Notes</label>
              <div class="bg-light p-3 rounded">
                <%= simple_format(@document.notes) %>
              </div>
            </div>
          <% end %>

          <% if @document.file.attached? %>
            <div class="mb-3">
              <label class="form-label text-muted-custom">Fichier attaché</label>
              <div class="d-flex align-items-center bg-light p-3 rounded">
                <div class="me-3">
                  <% case @document.file.content_type %>
                  <% when /image/ %>
                    <i class="bi bi-file-earmark-image text-success fs-3"></i>
                  <% when 'application/pdf' %>
                    <i class="bi bi-file-earmark-pdf text-danger fs-3"></i>
                  <% when /word/ %>
                    <i class="bi bi-file-earmark-word text-primary fs-3"></i>
                  <% when /excel|sheet/ %>
                    <i class="bi bi-file-earmark-excel text-success fs-3"></i>
                  <% else %>
                    <i class="bi bi-file-earmark text-muted fs-3"></i>
                  <% end %>
                </div>
                <div class="flex-grow-1">
                  <div class="fw-medium"><%= @document.file.filename %></div>
                  <small class="text-muted"><%= number_to_human_size(@document.file.byte_size) %></small>
                </div>
                <div>
                  <%= link_to download_document_path(@document), class: "btn btn-sm btn-outline-primary", target: "_blank" do %>
                    <i class="bi bi-download me-1"></i>Télécharger
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label text-muted-custom">Créé le</label>
              <p class="mb-0">
                <i class="bi bi-calendar-plus me-2"></i>
                <%= @document.created_at.strftime("%d/%m/%Y à %H:%M") if @document.created_at %>
              </p>
            </div>
            <% if @document.updated_at != @document.created_at %>
              <div class="col-md-6 mb-3">
                <label class="form-label text-muted-custom">Modifié le</label>
                <p class="mb-0">
                  <i class="bi bi-pencil me-2"></i>
                  <%= @document.updated_at.strftime("%d/%m/%Y à %H:%M") %>
                </p>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card border-0 bg-light-custom">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-tools me-2"></i>Actions
          </h6>
          <div class="d-grid gap-2">
            <%= link_to edit_document_path(@document), class: "btn btn-primary-custom" do %>
              <i class="bi bi-pencil me-2"></i>Modifier
            <% end %>
            <% if @document.file.attached? && @document.file.content_type&.include?('pdf') %>
              <%= link_to preview_document_path(@document), class: "btn btn-outline-info", target: "_blank" do %>
                <i class="bi bi-eye me-2"></i>Prévisualiser
              <% end %>
            <% end %>
            <%= link_to document_path(@document), method: :delete,
                confirm: "Êtes-vous sûr de vouloir supprimer ce document ?",
                class: "btn btn-outline-danger" do %>
              <i class="bi bi-trash me-2"></i>Supprimer
            <% end %>
          </div>
        </div>
      </div>

      <!-- Informations de contexte -->
      <div class="card border-0 bg-light-custom mt-3">
        <div class="card-body p-4">
          <h6 class="card-title text-primary-custom mb-3">
            <i class="bi bi-info-circle me-2"></i>Contexte
          </h6>
          <% if @document.property %>
            <div class="d-flex align-items-center mb-2">
              <i class="bi bi-house-door me-2 text-primary"></i>
              <small>
                Propriété: <%= link_to @document.property.name, property_path(@document.property), class: "text-decoration-none" %>
              </small>
            </div>
          <% elsif @document.project %>
            <div class="d-flex align-items-center mb-2">
              <i class="bi bi-tools me-2 text-warning"></i>
              <small>
                Projet: <%= link_to @document.project.nom, project_path(@document.project), class: "text-decoration-none" %>
              </small>
            </div>
          <% elsif @document.request %>
            <div class="d-flex align-items-center mb-2">
              <i class="bi bi-clipboard me-2 text-info"></i>
              <small>
                Demande: <%= link_to "Demande ##{@document.request.id}", request_path(@document.request), class: "text-decoration-none" %>
              </small>
            </div>
          <% elsif @document.simulation %>
            <div class="d-flex align-items-center mb-2">
              <i class="bi bi-calculator me-2 text-success"></i>
              <small>
                Simulation: <%= link_to "Simulation ##{@document.simulation.id}", simulation_path(@document.simulation), class: "text-decoration-none" %>
              </small>
            </div>
          <% else %>
            <small class="text-muted">Document indépendant</small>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Styles CSS -->
<style>
.icon-circle {
  width: 48px;
  height: 48px;
  background: rgba(var(--bs-primary-rgb), 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: var(--bs-primary);
}

.bg-light-custom {
  background-color: #f8f9fa !important;
}

.text-primary-custom {
  color: var(--bs-primary) !important;
}

.text-muted-custom {
  color: #6c757d !important;
}

.btn-primary-custom {
  background-color: var(--bs-primary);
  border-color: var(--bs-primary);
  color: white;
}

.btn-primary-custom:hover {
  background-color: var(--bs-primary);
  border-color: var(--bs-primary);
  opacity: 0.9;
}

.btn-outline-primary-custom {
  color: var(--bs-primary);
  border-color: var(--bs-primary);
}

.btn-outline-primary-custom:hover {
  background-color: var(--bs-primary);
  border-color: var(--bs-primary);
  color: white;
}
</style>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
