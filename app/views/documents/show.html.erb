<div class="container-fluid py-4">
  <!-- Header moderne -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-file-earmark-text text-primary fs-4"></i>
              </div>
              <div>
                <h1 class="h3 mb-1 text-primary"><%= @document.name %></h1>
                <p class="text-muted mb-0">
                  <i class="bi bi-calendar3 me-1"></i>
                  Créé le <%= @document.created_at.strftime("%d/%m/%Y à %H:%M") if @document.created_at %>
                </p>
              </div>
            </div>
            <div class="d-flex gap-2">
              <%= link_to edit_document_path(@document), class: "btn btn-warning" do %>
                <i class="bi bi-pencil me-2"></i>Modifier
              <% end %>
              <%= link_to documents_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-arrow-left me-2"></i>Retour
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenu du document -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h4 class="card-title mb-0">
            <i class="bi bi-file-text text-primary me-2"></i>
            Contenu du Document
          </h4>
        </div>
        <div class="card-body">
          <% if @document.content.present? %>
            <div class="document-content">
              <%= simple_format(@document.content, {}, wrapper_tag: "div") %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <div class="text-muted mb-3">
                <i class="bi bi-file-earmark fs-1"></i>
              </div>
              <h5 class="text-muted mb-2">Aucun contenu</h5>
              <p class="text-muted mb-3">Ce document ne contient pas encore de contenu.</p>
              <%= link_to edit_document_path(@document), class: "btn btn-warning" do %>
                <i class="bi bi-pencil me-2"></i>Ajouter du contenu
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Informations et actions -->
  <div class="row mt-4">
    <div class="col-md-8">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="card-title mb-0">
            <i class="bi bi-info-circle text-info me-2"></i>
            Informations du Document
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <i class="bi bi-calendar-plus text-success me-2"></i>
                <div>
                  <small class="text-muted">Date de création</small>
                  <div><%= @document.created_at.strftime("%d/%m/%Y à %H:%M") if @document.created_at %></div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <i class="bi bi-clock text-warning me-2"></i>
                <div>
                  <small class="text-muted">Dernière modification</small>
                  <div><%= @document.updated_at.strftime("%d/%m/%Y à %H:%M") if @document.updated_at %></div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <i class="bi bi-type text-primary me-2"></i>
                <div>
                  <small class="text-muted">Nombre de caractères</small>
                  <div><%= @document.content&.length || 0 %> caractères</div>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-text text-info me-2"></i>
                <div>
                  <small class="text-muted">Nombre de mots</small>
                  <div><%= @document.content&.split&.size || 0 %> mots</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h5 class="card-title mb-0">
            <i class="bi bi-gear text-secondary me-2"></i>
            Actions
          </h5>
        </div>
        <div class="card-body">
          <div class="d-grid gap-2">
            <%= link_to edit_document_path(@document), class: "btn btn-warning" do %>
              <i class="bi bi-pencil me-2"></i>Modifier ce document
            <% end %>
            <%= link_to documents_path, class: "btn btn-outline-info" do %>
              <i class="bi bi-list-ul me-2"></i>Tous les documents
            <% end %>
            <%= link_to new_document_path, class: "btn btn-outline-success" do %>
              <i class="bi bi-plus-lg me-2"></i>Nouveau document
            <% end %>
            <%= link_to root_path, class: "btn btn-outline-secondary" do %>
              <i class="bi bi-house me-2"></i>Accueil
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .document-content {
    line-height: 1.6;
    font-size: 1.1rem;
  }

  .document-content p {
    margin-bottom: 1rem;
  }
</style>
