<% content_for :title, "Documents#{" - #{@property.titre}" if @property}" %>

<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <div>
      <h1 class="h3 text-primary-custom mb-1 fw-normal">
        <i class="bi bi-folder2 me-2"></i>
        Documents
        <% if @property %>
          - <%= @property.titre || "Bien sans nom" %>
        <% elsif @project %>
          - <%= @project.nom || "Projet sans nom" %>
        <% end %>
      </h1>
      <p class="text-muted-custom mb-0">
        <% if @selected_document_type %>
          Documents de type "<%= document_type_name(@selected_document_type) %>" • <%= @documents.count %> document(s)
          <% if @selected_phase %>
            <span class="badge bg-<%= @selected_phase.color %> ms-2"><%= @selected_phase.name %></span>
          <% end %>
        <% elsif @selected_phase %>
          Documents de la <%= @selected_phase.name.downcase %> • <%= @documents.count %> document(s)
        <% elsif params[:type_document].present? %>
          Documents de type "<%= document_type_name(params[:type_document]) %>" • <%= @documents.count %> document(s)
        <% else %>
          Gestion de vos documents • <%= @documents.count %> document(s)
        <% end %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <%= link_to new_document_path(
            property_id: @property&.id,
            project_id: @project&.id
          ),
          class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Nouveau document
      <% end %>
      <% if @property %>
        <%= link_to documents_phases_dashboard_property_path(@property),
                    class: "btn btn-outline-primary-custom" do %>
          <i class="bi bi-kanban me-1"></i>Vue phases
        <% end %>
        <%= link_to dashboard_property_path(@property),
                    class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Dashboard bien
        <% end %>
      <% elsif @project %>
        <%= link_to @project, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Retour projet
        <% end %>
      <% else %>
        <%= link_to dashboard_path, class: "btn btn-outline-secondary" do %>
          <i class="bi bi-arrow-left me-1"></i>Dashboard
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Filtres -->
  <% if @phases_data&.any? %>
    <div class="row mb-4">
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <h6 class="mb-0">Filtrer par phase</h6>
                <small class="text-muted-custom">Organisez vos documents par phases de travaux</small>
              </div>
              <div class="btn-group" role="group">
                <%= link_to documents_path(
                      property_id: @property&.id,
                      project_id: @project&.id
                    ),
                           class: "btn #{'btn-primary-custom' if @selected_phase.nil?} #{'btn-outline-primary-custom' unless @selected_phase.nil?} btn-sm" do %>
                  <i class="bi bi-grid me-1"></i>Toutes
                <% end %>
                <% @phases_data.each do |phase_data| %>
                  <% phase = phase_data[:phase] %>
                  <%= link_to documents_path(
                                property_id: @property&.id,
                                project_id: @project&.id,
                                filter_phase: phase.id
                              ),
                             class: "btn #{'btn-primary-custom' if @selected_phase == phase} #{'btn-outline-primary-custom' unless @selected_phase == phase} btn-sm" do %>
                    <%= phase.icon %> <%= phase.name.gsub('Phase ', '') %>
                    <span class="badge bg-light text-dark ms-1"><%= phase_data[:count] %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

      <!-- Vue par phases - affichée dans tous les contextes sauf quand on filtre directement par type -->
      <% if @phases_data&.any? && !params[:type_document].present? %>
        <% if @selected_phase.present? %>
          <!-- Vue détaillée de la phase sélectionnée -->
          <div class="row mb-4">
            <div class="col-12">
              <div class="card border-0 shadow-sm">
                <div class="card-header bg-<%= @selected_phase.color %> text-white">
                  <div class="d-flex align-items-center">
                    <div class="me-3" style="font-size: 2rem;"><%= @selected_phase.icon %></div>
                    <div class="flex-grow-1">
                      <h4 class="mb-1"><%= @selected_phase.name %></h4>
                      <p class="mb-0 opacity-75"><%= @selected_phase.description %></p>
                    </div>
                    <div class="text-end">
                      <%= link_to documents_path(
                                    property_id: @property&.id,
                                    project_id: @project&.id
                                  ),
                                 class: "btn btn-outline-light btn-sm" do %>
                        <i class="bi bi-arrow-left me-1"></i>Toutes les phases
                      <% end %>
                    </div>
                  </div>
                </div>

                <div class="card-body">
                  <!-- Types de documents obligatoires -->
                  <% if @selected_phase.required_document_types.any? %>
                    <div class="mb-4">
                      <h6 class="text-danger mb-3">
                        <i class="bi bi-exclamation-triangle me-2"></i>Documents obligatoires
                      </h6>
                      <div class="row">
                        <% @selected_phase.required_document_types.each do |doc_type| %>
                          <% docs_of_type = @documents.select { |d| d.type_document == doc_type } %>
                          <% has_approved = docs_of_type.any? { |d| d.status == 'approved' } %>

                          <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card border-<%= has_approved ? 'success' : 'danger' %> h-100">
                              <div class="card-body text-center">
                                <div class="mb-2">
                                  <i class="bi bi-<%= has_approved ? 'check-circle-fill text-success' : 'exclamation-circle-fill text-danger' %>" style="font-size: 2rem;"></i>
                                </div>
                                <h6 class="card-title">
                                  <%= doc_type.humanize %>
                                  <% if doc_type == 'attestation_entrepreneur' %>
                                    <span class="badge bg-info ms-1">
                                      <i class="bi bi-download me-1"></i>Officiels
                                    </span>
                                  <% end %>
                                </h6>
                                <p class="small text-muted mb-2"><%= docs_of_type.count %> document(s)</p>

                                <div class="d-flex gap-1 justify-content-center">
                                  <% if doc_type == 'attestation_entrepreneur' %>
                                    <%= link_to prime_document_templates_path,
                                               class: "btn btn-outline-info btn-sm" do %>
                                      <i class="bi bi-download me-1"></i>Voir officiels
                                    <% end %>
                                  <% else %>
                                    <% if @property %>
                                      <%= link_to property_documents_path(@property, type_document: doc_type),
                                                 class: "btn btn-outline-secondary btn-sm" do %>
                                        <i class="bi bi-eye me-1"></i>Voir
                                      <% end %>
                                    <% elsif @project %>
                                      <%= link_to project_documents_path(@project, type_document: doc_type),
                                                 class: "btn btn-outline-secondary btn-sm" do %>
                                        <i class="bi bi-eye me-1"></i>Voir
                                      <% end %>
                                    <% else %>
                                      <%= link_to documents_path(type_document: doc_type),
                                                 class: "btn btn-outline-secondary btn-sm" do %>
                                        <i class="bi bi-eye me-1"></i>Voir
                                      <% end %>
                                    <% end %>
                                  <% end %>
                                  <% if @property %>
                                    <%= link_to new_property_document_path(@property, type_document: doc_type, upload_mode: 'ocr'),
                                               class: "btn btn-primary btn-sm" do %>
                                      <i class="bi bi-plus me-1"></i>Ajouter
                                    <% end %>
                                  <% elsif @project %>
                                    <%= link_to new_project_document_path(@project, type_document: doc_type, upload_mode: 'ocr'),
                                               class: "btn btn-primary btn-sm" do %>
                                      <i class="bi bi-plus me-1"></i>Ajouter
                                    <% end %>
                                  <% else %>
                                    <%= link_to new_document_path(type_document: doc_type, upload_mode: 'ocr'),
                                               class: "btn btn-primary btn-sm" do %>
                                      <i class="bi bi-plus me-1"></i>Ajouter
                                    <% end %>
                                  <% end %>
                                </div>
                              </div>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>

                  <!-- Types de documents optionnels -->
                  <% if @selected_phase.optional_document_types.any? %>
                    <div class="mb-3">
                      <h6 class="text-info mb-3">
                        <i class="bi bi-info-circle me-2"></i>Documents optionnels
                      </h6>
                      <div class="row">
                        <% @selected_phase.optional_document_types.each do |doc_type| %>
                          <% docs_of_type = @documents.select { |d| d.type_document == doc_type } %>
                          <% has_docs = docs_of_type.any? %>

                          <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card border-<%= has_docs ? 'info' : 'secondary' %> h-100">
                              <div class="card-body text-center">
                                <div class="mb-2">
                                  <i class="bi bi-<%= has_docs ? 'file-earmark-check text-info' : 'file-earmark-plus text-muted' %>" style="font-size: 2rem;"></i>
                                </div>
                                <h6 class="card-title">
                                  <%= doc_type.humanize %>
                                  <% if doc_type == 'attestation_entrepreneur' %>
                                    <span class="badge bg-info ms-1">
                                      <i class="bi bi-download me-1"></i>Officiels
                                    </span>
                                  <% end %>
                                </h6>
                                <p class="small text-muted mb-2"><%= docs_of_type.count %> document(s)</p>

                                <div class="d-flex gap-1 justify-content-center">
                                  <% if doc_type == 'attestation_entrepreneur' %>
                                    <%= link_to prime_document_templates_path,
                                               class: "btn btn-outline-info btn-sm" do %>
                                      <i class="bi bi-download me-1"></i>Voir officiels
                                    <% end %>
                                  <% elsif has_docs %>
                                    <% if @property %>
                                      <%= link_to property_documents_path(@property, type_document: doc_type),
                                                 class: "btn btn-outline-info btn-sm" do %>
                                        <i class="bi bi-eye me-1"></i>Voir
                                      <% end %>
                                    <% elsif @project %>
                                      <%= link_to project_documents_path(@project, type_document: doc_type),
                                                 class: "btn btn-outline-info btn-sm" do %>
                                        <i class="bi bi-eye me-1"></i>Voir
                                      <% end %>
                                    <% else %>
                                      <%= link_to documents_path(type_document: doc_type),
                                                 class: "btn btn-outline-info btn-sm" do %>
                                        <i class="bi bi-eye me-1"></i>Voir
                                      <% end %>
                                    <% end %>
                                  <% end %>
                                  <% if @property %>
                                    <%= link_to new_property_document_path(@property, type_document: doc_type, upload_mode: 'ocr'),
                                               class: "btn btn-outline-secondary btn-sm" do %>
                                      <i class="bi bi-plus me-1"></i>Ajouter
                                    <% end %>
                                  <% elsif @project %>
                                    <%= link_to new_project_document_path(@project, type_document: doc_type, upload_mode: 'ocr'),
                                               class: "btn btn-outline-secondary btn-sm" do %>
                                      <i class="bi bi-plus me-1"></i>Ajouter
                                    <% end %>
                                  <% else %>
                                    <%= link_to new_document_path(type_document: doc_type, upload_mode: 'ocr'),
                                               class: "btn btn-outline-secondary btn-sm" do %>
                                      <i class="bi bi-plus me-1"></i>Ajouter
                                    <% end %>
                                  <% end %>
                                </div>
                              </div>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% else %>
          <!-- Mini vue des phases -->
          <div class="row mb-4">
            <div class="col-12 mb-3">
              <h5 class="text-muted mb-0">
                <i class="bi bi-kanban me-2"></i>Vue d'ensemble par phases métier
              </h5>
              <small class="text-muted">
                <% if @property %>
                  Progression spécifique pour <%= @property.name %>
                <% else %>
                  Progression générale de vos documents
                <% end %>
              </small>
            </div>
          <% @phases_data.each do |phase_data| %>
            <% phase = phase_data[:phase] %>
            <% docs_in_phase = @documents.select { |d| d.document_phase == phase } %>

            <div class="col-lg-3 col-md-6 mb-3">
              <div class="card border-0 shadow-sm h-100 document-phase-card">
                <div class="card-body p-4 text-center">
                  <div class="mb-3">
                    <div class="phase-icon-circle mx-auto mb-2">
                      <%= phase.icon %>
                    </div>
                    <div class="badge bg-<%= phase_data[:completion_percentage] >= 80 ? 'success' : phase_data[:completion_percentage] >= 50 ? 'warning' : 'danger' %> position-absolute top-0 end-0 m-2">
                      <%= phase_data[:completion_percentage] %>%
                    </div>
                  </div>

                  <h6 class="card-title mb-2"><%= phase.name.gsub('Phase ', '') %></h6>
                  <p class="text-muted small mb-3"><%= phase.description %></p>

                  <div class="mb-3">
                    <small class="text-muted d-block"><%= docs_in_phase.count %> document(s)</small>
                  </div>

                  <!-- Progress bar -->
                  <div class="progress mb-3" style="height: 6px;">
                    <div class="progress-bar bg-<%= phase_data[:completion_percentage] >= 80 ? 'success' : phase_data[:completion_percentage] >= 50 ? 'warning' : 'danger' %>"
                         style="width: <%= phase_data[:completion_percentage] %>%"></div>
                  </div>

                  <!-- Documents requis/optionnels -->
                  <div class="small mb-3 text-center">
                    <div class="text-muted">
                      <strong>Obligatoires:</strong> <%= phase.required_document_types.count %>
                      | <strong>Optionnels:</strong> <%= phase.optional_document_types.count %>
                    </div>
                  </div>

                  <!-- Actions -->
                  <div class="d-flex justify-content-center gap-2">
                    <%= link_to documents_path(
                                  property_id: @property&.id,
                                  project_id: @project&.id,
                                  filter_phase: phase.id
                                ),
                               class: "btn btn-outline-primary btn-sm" do %>
                      <i class="bi bi-folder2-open me-1"></i>Voir détails
                    <% end %>
                    <% if phase_data[:missing_required]&.any? %>
                      <%= link_to new_document_path(
                                    property_id: @property&.id,
                                    project_id: @project&.id,
                                    type_document: phase_data[:missing_required].first,
                                    upload_mode: 'ocr'
                                  ),
                                 class: "btn btn-success btn-sm" do %>
                        <i class="bi bi-plus me-1"></i>Ajouter
                      <% end %>
                    <% else %>
                      <%= link_to new_document_path(
                                    property_id: @property&.id,
                                    project_id: @project&.id,
                                    type_document: phase.required_document_types.first
                                  ),
                                 class: "btn btn-outline-secondary btn-sm" do %>
                        <i class="bi bi-plus me-1"></i>Nouveau
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <% end %>
      <% end %>      <!-- Liste des documents -->
      <% if @documents.any? %>
        <% if params[:type_document].present? || @selected_phase.present? %>
          <!-- Vue détaillée pour les documents filtrés -->
          <div class="row g-3">
            <% @documents.order(created_at: :desc).each do |document| %>
              <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="card border-0 bg-light-custom h-100 property-card">
                  <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                      <div class="icon-circle me-3">
                        <i class="bi bi-file-earmark-text"></i>
                      </div>
                      <div class="flex-grow-1">
                        <h5 class="card-title text-dark mb-1 fw-normal">
                          <%= truncate(document.type_document.humanize, length: 25) %>
                        </h5>
                        <p class="text-muted-custom mb-0 small">
                          <% if document.respond_to?(:document_phase) && document.document_phase %>
                            <%= document.document_phase.icon %> <%= document.document_phase.name.gsub('Phase ', '') %>
                          <% else %>
                            <i class="bi bi-question-circle me-1"></i>Non classé
                          <% end %>
                        </p>
                      </div>
                      <div class="dropdown dropup">
                        <button class="btn btn-sm btn-outline-secondary border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                          <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow" style="z-index: 1050;">
                          <li>
                            <% if document.file.attached? %>
                              <%= link_to rails_blob_path(document.file, disposition: "attachment"),
                                          class: "dropdown-item",
                                          target: "_blank" do %>
                                <i class="bi bi-download me-2"></i>Télécharger
                              <% end %>
                            <% end %>
                          </li>
                          <li>
                            <%= link_to edit_document_path(document), class: "dropdown-item" do %>
                              <i class="bi bi-pencil me-2"></i>Modifier
                            <% end %>
                          </li>
                          <li><hr class="dropdown-divider"></li>
                          <li>
                            <%= link_to document_path(document), method: :delete,
                                class: "dropdown-item text-danger",
                                confirm: "Êtes-vous sûr de vouloir supprimer ce document ?",
                                data: {
                                  turbo_method: :delete,
                                  turbo_confirm: "Êtes-vous sûr de vouloir supprimer ce document ? Cette action est irréversible."
                                } do %>
                              <i class="bi bi-trash me-2"></i>Supprimer
                            <% end %>
                          </li>
                        </ul>
                      </div>
                    </div>

                    <div class="mb-3">
                      <!-- Badge de statut -->
                      <span class="badge bg-<%=
                        case document.status
                        when 'approved' then 'success'
                        when 'pending' then 'warning'
                        when 'rejected' then 'danger'
                        else 'secondary'
                        end
                      %>">
                        <%=
                          case document.status
                          when 'approved' then '✓ Approuvé'
                          when 'pending' then '⏳ En attente'
                          when 'rejected' then '✗ Rejeté'
                          else 'Non défini'
                          end
                        %>
                      </span>
                    </div>

                    <!-- Informations du fichier -->
                    <% if document.file.attached? %>
                      <div class="small text-muted-custom mb-2">
                        <i class="bi bi-paperclip me-1"></i>
                        <%= truncate(document.file.filename.to_s, length: 30) %>
                      </div>
                      <div class="small text-muted-custom mb-3">
                        <i class="bi bi-hdd me-1"></i>
                        <%= number_to_human_size(document.file.byte_size) %>
                      </div>
                    <% end %>

                    <!-- Date -->
                    <div class="small text-muted-custom mb-3">
                      <i class="bi bi-clock me-1"></i>
                      Ajouté <%= time_ago_in_words(document.created_at) %>
                    </div>

                    <!-- Actions -->
                    <div class="d-grid">
                      <% if document.file.attached? %>
                        <%= link_to rails_blob_path(document.file, disposition: "attachment"),
                                    class: "btn btn-outline-primary-custom btn-sm",
                                    target: "_blank" do %>
                          <i class="bi bi-eye me-1"></i>Voir le document
                        <% end %>
                      <% else %>
                        <span class="btn btn-outline-secondary btn-sm disabled">
                          <i class="bi bi-x-circle me-1"></i>Aucun fichier
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <!-- Vue allégée pour l'index principal -->
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-light border-0">
              <h6 class="mb-0">
                <i class="bi bi-files me-2"></i>Derniers documents uploadés
              </h6>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th class="border-0">Document</th>
                      <th class="border-0">Type</th>
                      <th class="border-0">Phase</th>
                      <th class="border-0">Statut</th>
                      <th class="border-0">Date</th>
                      <th class="border-0 text-end">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @documents.order(created_at: :desc).limit(10).each do |document| %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center">
                            <i class="bi bi-file-earmark-text text-primary me-2"></i>
                            <div>
                              <div class="fw-medium">
                                <%= document.file.attached? ? document.file.filename : 'Document sans fichier' %>
                              </div>
                              <% if document.file.attached? %>
                                <small class="text-muted">
                                  <%= number_to_human_size(document.file.byte_size) %>
                                </small>
                              <% end %>
                            </div>
                          </div>
                        </td>
                        <td>
                          <span class="badge bg-light text-dark">
                            <%= document.type_document.humanize %>
                          </span>
                        </td>
                        <td>
                          <% if document.respond_to?(:document_phase) && document.document_phase %>
                            <small class="text-muted">
                              <%= document.document_phase.icon %> <%= document.document_phase.name.gsub('Phase ', '') %>
                            </small>
                          <% else %>
                            <small class="text-muted">Non classé</small>
                          <% end %>
                        </td>
                        <td>
                          <span class="badge bg-<%=
                            case document.status
                            when 'approved' then 'success'
                            when 'pending' then 'warning'
                            when 'rejected' then 'danger'
                            else 'secondary'
                            end
                          %>">
                            <%=
                              case document.status
                              when 'approved' then '✓'
                              when 'pending' then '⏳'
                              when 'rejected' then '✗'
                              else '?'
                              end
                            %>
                          </span>
                        </td>
                        <td>
                          <small class="text-muted">
                            <%= time_ago_in_words(document.created_at) %>
                          </small>
                        </td>
                        <td class="text-end">
                          <div class="btn-group btn-group-sm">
                            <% if document.file.attached? && (document.file.content_type.start_with?('image/') || document.file.content_type == 'application/pdf') %>
                              <button class="btn btn-outline-info preview-btn"
                                      data-document-id="<%= document.id %>"
                                      title="Prévisualiser">
                                <i class="bi bi-eye"></i>
                              </button>
                            <% end %>
                            <%= link_to document, class: "btn btn-outline-primary", title: "Voir détails" do %>
                              <i class="bi bi-info-circle"></i>
                            <% end %>
                            <%= link_to edit_document_path(document), class: "btn btn-outline-secondary", title: "Modifier" do %>
                              <i class="bi bi-pencil"></i>
                            <% end %>
                          </div>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <% if @documents.count > 10 %>
                <div class="card-footer bg-light border-0 text-center">
                  <small class="text-muted">
                    Affichage des 10 derniers documents sur <%= @documents.count %> total
                  </small>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <!-- Message si aucun document -->
        <div class="text-center py-5">
          <div class="mb-4">
            <i class="bi bi-files display-1 text-muted"></i>
          </div>
          <h4 class="text-muted mb-3">Aucun document trouvé</h4>
          <p class="text-muted mb-4">
            <% if params[:type_document].present? %>
              Aucun document de type "<%= params[:type_document].humanize %>" n'a été trouvé.
            <% elsif @selected_phase %>
              Aucun document trouvé pour la <%= @selected_phase.name.downcase %>.
            <% else %>
              Commencez par ajouter vos premiers documents.
            <% end %>
          </p>
          <% if @property %>
            <%= link_to new_property_document_path(@property), class: "btn btn-primary" do %>
              <i class="bi bi-plus-circle me-2"></i>Ajouter un document
            <% end %>
          <% elsif @project %>
            <%= link_to new_project_document_path(@project), class: "btn btn-primary" do %>
              <i class="bi bi-plus-circle me-2"></i>Ajouter un document
            <% end %>
          <% else %>
            <%= link_to new_document_path, class: "btn btn-primary" do %>
              <i class="bi bi-plus-circle me-2"></i>Ajouter un document
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Modal de prévisualisation -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Prévisualisation du document</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="preview-content" class="text-center">
          <div class="spinner-border" role="status">
            <span class="visually-hidden">Chargement...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div><style>
.card {
  transition: all 0.3s ease;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(0,0,0,0.1) !important;
}

.badge-sm {
  font-size: 0.7rem;
  padding: 0.25em 0.5em;
}

.alert-sm {
  padding: 0.5rem;
  margin-bottom: 0.5rem;
}

.preview-btn:hover {
  transform: scale(1.1);
}
</style>

<script nonce="<%= content_security_policy_nonce %>">
document.addEventListener('turbo:load', function() {
  // Gestion de la prévisualisation
  const previewButtons = document.querySelectorAll('.preview-btn');
  const previewModal = new bootstrap.Modal(document.getElementById('previewModal'));
  const previewContent = document.getElementById('preview-content');

  previewButtons.forEach(button => {
    button.addEventListener('click', function() {
      const documentId = this.dataset.documentId;

      previewContent.innerHTML = `
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Chargement...</span>
        </div>
      `;

      previewModal.show();

      fetch(`/documents/${documentId}/preview`)
        .then(response => response.json())
        .then(data => {
          if (data.type === 'image') {
            previewContent.innerHTML = `<img src="${data.url}" class="img-fluid" alt="Prévisualisation">`;
          } else if (data.type === 'pdf') {
            previewContent.innerHTML = `<embed src="${data.url}" type="application/pdf" width="100%" height="600px">`;
          } else {
            previewContent.innerHTML = `<div class="alert alert-warning">${data.message || 'Prévisualisation non disponible'}</div>`;
          }
        })
        .catch(error => {
          previewContent.innerHTML = `<div class="alert alert-danger">Erreur lors du chargement de la prévisualisation</div>`;
        });
    });
  });
});
</script>

<style>
/* === EFFETS HOVER POUR LES CARTES DE PHASES === */
.document-phase-card {
  transition: all 0.3s ease;
  border-radius: 12px;
  overflow: hidden;
  position: relative;
}

.document-phase-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 40px rgba(44, 82, 130, 0.15) !important;
}

.document-phase-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.1),
    rgba(255, 255, 255, 0.05));
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: inherit;
  pointer-events: none;
}

.document-phase-card:hover::before {
  opacity: 1;
}

.phase-icon-circle {
  width: 60px;
  height: 60px;
  background: rgba(var(--bs-primary-rgb), 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  color: var(--bs-primary);
  transition: all 0.3s ease;
}

.document-phase-card:hover .phase-icon-circle {
  background: rgba(var(--bs-primary-rgb), 0.2);
  transform: scale(1.1);
}

/* === EFFETS HOVER POUR LES CARTES DE DOCUMENTS === */
.document-card {
  transition: all 0.3s ease;
  border-radius: 10px;
  overflow: hidden;
  position: relative;
}

.document-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(44, 82, 130, 0.12) !important;
}

.document-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.08),
    rgba(255, 255, 255, 0.03));
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: inherit;
  pointer-events: none;
}

.document-card:hover::before {
  opacity: 1;
}

/* === ANIMATIONS D'ENTRÉE === */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.document-phase-card {
  animation: fadeInUp 0.6s ease forwards;
}

.document-card {
  animation: fadeInUp 0.5s ease forwards;
}

.document-phase-card:nth-child(1) { animation-delay: 0.1s; }
.document-phase-card:nth-child(2) { animation-delay: 0.2s; }
.document-phase-card:nth-child(3) { animation-delay: 0.3s; }
.document-phase-card:nth-child(4) { animation-delay: 0.4s; }

.document-card:nth-child(1) { animation-delay: 0.1s; }
.document-card:nth-child(2) { animation-delay: 0.2s; }
.document-card:nth-child(3) { animation-delay: 0.3s; }
.document-card:nth-child(4) { animation-delay: 0.4s; }
.document-card:nth-child(5) { animation-delay: 0.5s; }
.document-card:nth-child(6) { animation-delay: 0.6s; }

/* === AMÉLIORATIONS VISUELLES === */
.progress {
  border-radius: 10px;
  overflow: hidden;
}

.progress-bar {
  transition: width 0.6s ease;
}

.badge-sm {
  font-size: 0.75rem;
  padding: 4px 8px;
}

/* === RESPONSIVE === */
@media (max-width: 768px) {
  .document-phase-card:hover,
  .document-card:hover {
    transform: translateY(-2px);
  }

  .phase-icon-circle {
    width: 50px;
    height: 50px;
    font-size: 1.25rem;
  }
}

/* === EFFETS DE FOCUS POUR L'ACCESSIBILITÉ === */
.document-phase-card:focus-within,
.document-card:focus-within {
  outline: 2px solid var(--bs-primary);
  outline-offset: 2px;
}
</style>
</script>
