<% content_for :title, "Documents#{" - #{@property.titre}" if @property}" %>

<div class="container-fluid px-4 py-4">
  <%= render 'header' %>

  <% if @project %>
    <%= render 'projects/partials_general/kpi_chips' %>

    <ul class="nav nav-pills mb-4 gap-1 border-bottom pb-3">
      <li class="nav-item">
        <%= link_to project_path(@project, tab: :preparation),
              class: "nav-link",
              data: { turbo_frame: "project_content", turbo_action: "advance" } do %>
          <i class="bi bi-clipboard-check me-2"></i>Préparation
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to project_path(@project, tab: :suivi),
              class: "nav-link",
              data: { turbo_frame: "project_content", turbo_action: "advance" } do %>
          <i class="bi bi-hammer me-2"></i>Suivi
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to project_path(@project, tab: :reception),
              class: "nav-link",
              data: { turbo_frame: "project_content", turbo_action: "advance" } do %>
          <i class="bi bi-file-earmark-check me-2"></i>Réception
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to project_documents_path(@project),
              class: "nav-link active" do %>
          <i class="bi bi-folder2-open me-2"></i>Documents
        <% end %>
      </li>
    </ul>
  <% end %>

  <%= render 'filters' %>

  <% if @property && !@project %>
    <%# Vue bien : liste plate avec filtres chantier / type / phase %>
    <%= render 'property_documents_list' %>
  <% else %>
    <%# Vue projet ou globale : organisation par phase %>
    <%= render 'phases_content' %>
    <% if @documents.empty? && !params[:type_document].present? %>
      <%= render 'empty_state' %>
    <% end %>
  <% end %>
</div>

<% unless @property && !@project %>
  <%= render 'type_filtered_documents' %>
<% end %>
<%= render 'modals_and_scripts' %>
<%= render 'styles' %>
