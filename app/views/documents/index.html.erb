<% content_for :title, "Documents#{" - #{@property.titre}" if @property}" %>

<div class="container-fluid px-4 py-4">
  <%= render 'header' %>

  <!-- Message d'information -->
  <div class="alert alert-info border-0 mb-4" style="background-color: #e8f4f8;">
    <div class="d-flex align-items-start">
      <i class="bi bi-info-circle me-3 mt-1" style="font-size: 1.2rem;"></i>
      <p class="mb-0">
        Ici vous pouvez stocker l'ensemble de vos documents de chantier. Ceux-ci seront exploités par le système afin d'offrir des services d'analyse et vous informer sur la progression de votre chantier.
      </p>
    </div>
  </div>

  <%= render 'filters' %>
  <%= render 'phases_content' %>

  <!-- Section pour les documents sans documents -->
  <% if @documents.empty? && !params[:type_document].present? %>
    <%= render 'empty_state' %>
  <% end %>
</div>

<%= render 'type_filtered_documents' %>
<%= render 'modals_and_scripts' %>
<%= render 'styles' %>
