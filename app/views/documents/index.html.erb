  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  color: var(--bs-primary);
  transition: all 0.3s ease;
}

.document-phase-card:hover .phase-icon-circle {
  background: rgba(var(--bs-primary-rgb), 0.2);
  transform: scale(1.1);
}

/* === EFFETS HOVER POUR LES CARTES DE DOCUMENTS === */
.document-card {
  transition: all 0.3s ease;
  border-radius: 10px;
  overflow: hidden;
  position: relative;
}

.document-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(44, 82, 130, 0.12) !important;
}

.document-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.08),
    rgba(255, 255, 255, 0.03));
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: inherit;
  pointer-events: none;
}

.document-card:hover::before {
  opacity: 1;
}

/* === ANIMATIONS D'ENTRÉE === */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.document-phase-card {
  animation: fadeInUp 0.6s ease forwards;
}

