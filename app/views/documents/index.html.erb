<div class="container-fluid py-4">
  <!-- Header moderne -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
              <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-folder-open text-info fs-4"></i>
              </div>
              <div>
                <h1 class="h3 mb-1 text-info">Gestion des Documents</h1>
                <p class="text-muted mb-0">Organisez vos documents et ressources</p>
              </div>
            </div>
            <%= link_to new_document_path, class: "btn btn-info" do %>
              <i class="bi bi-plus-lg me-2"></i>Nouveau Document
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Liste des documents -->
  <div class="row">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
          <h4 class="card-title mb-0">
            <i class="bi bi-list-ul text-info me-2"></i>
            Mes Documents
          </h4>
        </div>
        <div class="card-body">
          <% if @documents.any? %>
            <div class="row g-3">
              <% @documents.each do |document| %>
                <div class="col-lg-4 col-md-6 col-12">
                  <div class="card h-100 shadow-sm border-0 hover-card">
                    <div class="card-body">
                      <div class="d-flex align-items-start mb-3">
                        <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                          <i class="bi bi-file-earmark-text text-info"></i>
                        </div>
                        <div class="flex-grow-1">
                          <h5 class="card-title mb-1"><%= truncate(document.name, length: 30) %></h5>
                          <p class="text-muted small mb-0">
                            <i class="bi bi-calendar3 me-1"></i>
                            <%= document.created_at.strftime("%d/%m/%Y") if document.created_at %>
                          </p>
                        </div>
                      </div>
                      <% if document.content.present? %>
                        <p class="card-text text-muted mb-3">
                          <%= truncate(strip_tags(document.content), length: 80) %>
                        </p>
                      <% end %>
                      <div class="d-flex gap-2 mt-auto">
                        <%= link_to document_path(document), class: "btn btn-outline-info btn-sm flex-grow-1" do %>
                          <i class="bi bi-eye me-1"></i>Voir
                        <% end %>
                        <%= link_to edit_document_path(document), class: "btn btn-outline-secondary btn-sm" do %>
                          <i class="bi bi-pencil"></i>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-5">
              <div class="text-muted mb-3">
                <i class="bi bi-folder-plus fs-1"></i>
              </div>
              <h5 class="text-muted mb-2">Aucun document</h5>
              <p class="text-muted mb-4">Commencez par créer votre premier document</p>
              <%= link_to new_document_path, class: "btn btn-info" do %>
                <i class="bi bi-plus-lg me-2"></i>Créer un Document
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Actions supplémentaires -->
  <div class="row mt-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-1">
                <i class="bi bi-gear text-secondary me-2"></i>
                Actions
              </h5>
              <p class="text-muted mb-0">Gérez vos documents facilement</p>
            </div>
            <div class="d-flex gap-2">
              <%= link_to root_path, class: "btn btn-outline-secondary btn-sm" do %>
                <i class="bi bi-house me-1"></i>Accueil
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hover-card {
    transition: transform 0.2s ease-in-out;
  }
  .hover-card:hover {
    transform: translateY(-2px);
  }
</style>
