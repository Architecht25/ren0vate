<div class="container-fluid px-4 py-4">
  <!-- Header épuré -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
    <h1 class="h3 text-primary-custom mb-0 fw-normal">Mes Documents</h1>
    <%= link_to new_document_path, class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Nouveau document
    <% end %>
  </div>

  <!-- Liste des documents -->
  <% if @documents.any? %>
    <div class="row g-3">
      <% @documents.each do |document| %>
        <div class="col-md-6 col-lg-4">
          <%= link_to document_path(document), class: "text-decoration-none" do %>
            <div class="card border-0 bg-light-custom h-100 property-card">
              <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                  <div class="icon-circle me-3">
                    <i class="bi bi-file-earmark-text"></i>
                  </div>
                  <div class="flex-grow-1">
                    <h5 class="card-title text-dark mb-1 fw-normal"><%= document.type_document || "Document" %></h5>
                    <p class="text-muted-custom mb-0 small">
                      <i class="bi bi-calendar me-1"></i>
                      <%= document.created_at.strftime("%d/%m/%Y") %>
                    </p>
                  </div>
                </div>
                <div class="mt-3">
                  <div class="d-flex justify-content-between align-items-center">
                    <% status_class = case document.status
                         when 'pending' then 'warning'
                         when 'approved' then 'success'
                         when 'rejected' then 'danger'
                         else 'secondary'
                       end %>
                    <span class="badge bg-<%= status_class %> rounded-pill px-3 py-2">
                      <%= document.status&.humanize || 'En attente' %>
                    </span>
                    <small class="text-muted-custom">
                      <i class="bi bi-clock me-1"></i>
                      <%= time_ago_in_words(document.updated_at) %>
                    </small>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- État vide minimaliste -->
    <div class="text-center py-5 mt-5">
      <div class="icon-circle-large mx-auto mb-4">
        <i class="bi bi-file-earmark-text"></i>
      </div>
      <h3 class="text-muted-custom mb-3 fw-normal">Aucun document</h3>
      <p class="text-muted-custom mb-4">Ajoutez votre premier document pour commencer.</p>
      <%= link_to new_document_path, class: "btn btn-primary-custom px-4" do %>
        <i class="bi bi-plus-lg me-2"></i>Nouveau document
      <% end %>
    </div>
  <% end %>
</div>

<!-- Utilise le fichier CSS externe properties.css -->
<%= stylesheet_link_tag 'properties', 'data-turbo-track': 'reload' %>
