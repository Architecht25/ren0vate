<%
  set_seo_meta(
    title: "Assistant IA Expert - Ren0vate",
    description: "Posez vos questions à notre assistant IA expert en rénovation",
    keywords: ["assistant IA", "expert rénovation", "intelligence artificielle", "conseil"]
  )
%>

<div class="expert-ia-page">
  <div class="row g-3 expert-ia-row">

    <!-- Sidebar -->
    <div class="col-lg-3">
      <div class="panel expert-ia-sidebar-panel">
        <div class="panel-header">
          <h3><i class="bi bi-cpu me-2"></i>Assistant IA Expert</h3>
        </div>
        <div class="panel-body">

          <!-- Sélecteur de simulation -->
          <div class="mb-3">
            <label class="expert-ia-label">Contexte simulation</label>
            <% if @simulations.any? %>
              <select class="form-select form-select-sm" id="aiExpertSimulationSelector">
                <option value="">Conversation générale</option>
                <% @simulations.each do |simulation| %>
                  <option value="<%= simulation.id %>" <%= 'selected' if simulation.id == @simulation&.id %>>
                    <%= simulation.titre || "Simulation #{simulation.id}" %>
                  </option>
                <% end %>
              </select>
            <% else %>
              <div class="expert-ia-empty-state">
                <i class="bi bi-calculator me-1"></i>
                <%= link_to "Créer une simulation", new_simulation_path %> pour un conseil personnalisé
              </div>
            <% end %>
          </div>

          <!-- Carte simulation active -->
          <% if @simulation %>
            <div class="expert-ia-sim-card">
              <div class="expert-ia-sim-label">Simulation active</div>
              <div class="expert-ia-sim-title"><%= @simulation.titre || "Simulation #{@simulation.id}" %></div>
              <div class="expert-ia-sim-meta">
                <span><i class="bi bi-geo-alt"></i> <%= @simulation.region&.capitalize %></span>
                <span><i class="bi bi-currency-euro"></i> <%= number_to_currency(@simulation.total_simule || 0, unit: "", precision: 0) %>€</span>
                <span><i class="bi bi-calendar"></i> <%= @simulation.created_at.strftime("%d/%m/%Y") %></span>
              </div>
            </div>
          <% end %>

          <!-- Questions suggérées -->
          <div class="mt-3">
            <div class="section-title">Questions suggérées</div>
            <div class="d-grid gap-2">
              <button class="suggested-question"><i class="bi bi-lightning-charge"></i> Résume-moi ma situation</button>
              <button class="suggested-question"><i class="bi bi-cash-stack"></i> Quelles sont mes primes prioritaires ?</button>
              <button class="suggested-question"><i class="bi bi-calendar-check"></i> Quel est le calendrier optimal ?</button>
              <button class="suggested-question"><i class="bi bi-tools"></i> Par quoi dois-je commencer ?</button>
              <button class="suggested-question"><i class="bi bi-exclamation-triangle"></i> Quels sont les pièges à éviter ?</button>
            </div>
          </div>

          <!-- Info Claude -->
          <div class="expert-ia-info-badge">
            <i class="bi bi-info-circle"></i>
            Claude accède à tout votre dossier (propriétés, projets, simulations) pour des réponses personnalisées.
          </div>

        </div>
      </div>
    </div>

    <!-- Zone de chat -->
    <div class="col-lg-9">
      <div class="panel expert-ia-chat-panel d-flex flex-column">

        <!-- Header chat -->
        <div class="panel-header">
          <h3><i class="bi bi-robot me-2"></i>Assistant IA Expert Rénovation</h3>
          <div class="d-flex align-items-center gap-2">
            <span class="panel-badge"><i class="bi bi-circle-fill me-1" style="color: #84A98C; font-size: 0.45rem;"></i>Claude Sonnet</span>
            <%= link_to decision_hub_index_path, class: "btn btn-sm btn-outline-light" do %>
              <i class="bi bi-compass me-1"></i>Feuille de route
            <% end %>
          </div>
        </div>

        <!-- Messages -->
        <div class="expert-ia-messages" id="chatMessages">
          <div class="d-flex mb-4">
            <div class="flex-shrink-0">
              <div class="bot-avatar"><i class="bi bi-robot"></i></div>
            </div>
            <div class="flex-grow-1 ms-3">
              <div class="ai-message">
                <p class="mb-2"><strong>Bonjour <%= current_user.first_name || current_user.email.split('@').first.capitalize %> !</strong></p>
                <p class="mb-2">Je suis votre assistant IA expert en rénovation. Je peux vous aider à :</p>
                <ul class="mb-2">
                  <li>Analyser votre situation et vos primes</li>
                  <li>Optimiser votre planning de rénovation</li>
                  <li>Répondre à vos questions techniques</li>
                  <li>Vous conseiller sur les démarches administratives</li>
                </ul>
                <p class="mb-0 small text-muted">💡 J'ai accès à l'ensemble de votre dossier : propriétés, projets et simulations.</p>
              </div>
              <small class="text-muted ms-2">À l'instant</small>
            </div>
          </div>
        </div>

        <!-- Zone de saisie -->
        <div class="expert-ia-input-zone">
          <form id="aiExpertForm">
            <div class="input-group">
              <input type="text" class="form-control" id="aiExpertInput"
                     placeholder="Posez votre question à l'expert IA..." autocomplete="off">
              <button class="btn btn-ren0vate" type="submit" id="aiExpertSendBtn">
                <i class="bi bi-send me-1"></i>Envoyer
              </button>
            </div>
            <small class="text-muted mt-2 d-block">
              <i class="bi bi-shield-check me-1"></i>Vos conversations sont privées et sécurisées
            </small>
          </form>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('aiExpertForm');
  const input = document.getElementById('aiExpertInput');
  const chatMessages = document.getElementById('chatMessages');
  const sendBtn = document.getElementById('aiExpertSendBtn');
  const simulationSelector = document.getElementById('aiExpertSimulationSelector');
  const suggestedQuestions = document.querySelectorAll('.suggested-question');

  // Questions suggérées
  suggestedQuestions.forEach(btn => {
    btn.addEventListener('click', function() {
      const question = this.textContent.trim().replace(/^.*?\s/, ''); // Retire l'icône
      input.value = question;
      form.dispatchEvent(new Event('submit'));
    });
  });

  // Changement de simulation
  if (simulationSelector) {
    simulationSelector.addEventListener('change', function() {
      const simulationId = this.value;
      if (simulationId) {
        // Recharger la page avec la nouvelle simulation
        window.location.href = `<%= expert_decision_hub_index_path %>?simulation_id=${simulationId}`;
      } else {
        window.location.href = `<%= expert_decision_hub_index_path %>`;
      }
    });
  }

  // Soumission du formulaire
  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    const question = input.value.trim();
    if (!question) return;

    // Ajouter le message utilisateur
    addUserMessage(question);
    input.value = '';

    // Afficher l'indicateur de chargement
    const loadingId = addLoadingMessage();

    try {
      // Récupérer l'ID de simulation actif
      const simulationId = simulationSelector ? simulationSelector.value : '<%= @simulation&.id %>';

      // Appeler Claude via l'API (historique géré côté serveur)
      const response = await fetch(`/api/contextual_bot/chat`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        },
        body: JSON.stringify({
          message: question,
          current_page: 'decision_hub',
          mode: 'expert'
        })
      });

      const data = await response.json();

      // Retirer l'indicateur de chargement
      removeLoadingMessage(loadingId);

      if (data.response && data.response.content) {
        addAIMessage(data.response.content);
      } else {
        addAIMessage("Désolé, je n'ai pas pu générer une réponse. Veuillez réessayer.");
      }

    } catch (error) {
      console.error('Erreur:', error);
      removeLoadingMessage(loadingId);
      addAIMessage("Une erreur s'est produite. Veuillez réessayer.");
    }
  });

  function addUserMessage(text) {
    const messageDiv = document.createElement('div');
    messageDiv.className = 'd-flex justify-content-end mb-4';
    messageDiv.innerHTML = `
      <div class="user-message">
        ${escapeHtml(text)}
      </div>
    `;
    chatMessages.appendChild(messageDiv);
    scrollToBottom();
  }

  function addAIMessage(text) {
    const messageDiv = document.createElement('div');
    messageDiv.className = 'd-flex mb-4';
    messageDiv.innerHTML = `
      <div class="flex-shrink-0">
        <div class="bot-avatar">
          <i class="bi bi-robot"></i>
        </div>
      </div>
      <div class="flex-grow-1 ms-3">
        <div class="ai-message">
          ${formatAIResponse(text)}
        </div>
        <small class="text-muted ms-2">À l'instant</small>
      </div>
    `;
    chatMessages.appendChild(messageDiv);
    scrollToBottom();
  }

  function addLoadingMessage() {
    const loadingId = 'loading-' + Date.now();
    const messageDiv = document.createElement('div');
    messageDiv.id = loadingId;
    messageDiv.className = 'd-flex mb-4';
    messageDiv.innerHTML = `
      <div class="flex-shrink-0">
        <div class="bot-avatar">
          <i class="bi bi-robot"></i>
        </div>
      </div>
      <div class="flex-grow-1 ms-3">
        <div class="ai-message">
          <span class="message-loading"></span>
          <span class="message-loading"></span>
          <span class="message-loading"></span>
        </div>
      </div>
    `;
    chatMessages.appendChild(messageDiv);
    scrollToBottom();
    return loadingId;
  }

  function removeLoadingMessage(loadingId) {
    const element = document.getElementById(loadingId);
    if (element) {
      element.remove();
    }
  }

  function scrollToBottom() {
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function formatAIResponse(text) {
    // Formater la réponse (markdown basique)
    return text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n/g, '<br>')
      .replace(/- (.*?)(<br>|$)/g, '<li>$1</li>')
      .replace(/(<li>.*<\/li>)+/g, '<ul>$&</ul>');
  }
});
</script>
