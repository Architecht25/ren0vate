<%
  set_seo_meta(
    title: "Assistant IA Expert - Ren0vate",
    description: "Posez vos questions à notre assistant IA expert en rénovation",
    keywords: ["assistant IA", "expert rénovation", "intelligence artificielle", "conseil"]
  )
%>

<div class="expert-ia-page">

<% if @properties.none? %>
  <%# ── Aucun bien : état vide ─────────────────────────────────────────────── %>
  <div class="text-center py-5">
    <div class="icon-circle-large mx-auto mb-3"><i class="bi bi-house-door"></i></div>
    <h4 class="fw-normal mb-2">Aucun bien enregistré</h4>
    <p class="text-muted mb-4">Ajoutez un bien immobilier pour accéder à l'assistant IA expert.</p>
    <%= link_to new_property_path, class: "btn btn-ren0vate" do %>
      <i class="bi bi-plus-circle me-2"></i>Ajouter un bien
    <% end %>
  </div>

<% elsif @overview %>
  <%# ── Mode vue d'ensemble : chat générique sur tous les biens ───────────── %>
  <div class="row g-3 expert-ia-row">

    <!-- Sidebar -->
    <div class="col-lg-3">
      <div class="panel expert-ia-sidebar-panel">
        <div class="panel-header">
          <h3><i class="bi bi-cpu me-2"></i>Assistant IA Expert</h3>
        </div>
        <div class="panel-body">

          <!-- Contexte : tous les biens -->
          <div class="expert-ia-property-active mb-3">
            <div class="d-flex align-items-start gap-2 mb-2">
              <div style="width:32px; height:32px; background: var(--ren0vate-gradient-primary); border-radius: 50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <i class="bi bi-houses text-white" style="font-size:0.85rem;"></i>
              </div>
              <div class="flex-grow-1 min-w-0">
                <div class="fw-semibold" style="font-size: 0.9rem;">Vue d'ensemble</div>
                <div class="text-muted" style="font-size: 0.75rem;">
                  <i class="bi bi-layers me-1"></i><%= @properties.count %> bien<%= @properties.count > 1 ? 's' : '' %> connecté<%= @properties.count > 1 ? 's' : '' %>
                </div>
              </div>
            </div>

            <div class="d-flex flex-wrap gap-1 mb-3">
              <% @properties.each do |p| %>
                <span class="badge bg-light text-dark" style="font-size: 0.7rem;">
                  <i class="bi bi-house-door me-1" style="color:var(--ren0vate-primary);"></i><%= p.titre.presence || p.commune %>
                </span>
              <% end %>
            </div>

            <%= link_to expert_decision_hub_index_path, class: "btn btn-sm btn-outline-secondary w-100 mb-2", style: "font-size: 0.75rem;" do %>
              <i class="bi bi-house-door me-1"></i>Consulter sur un bien précis
            <% end %>
          </div>

          <!-- Info Claude -->
          <div class="expert-ia-info-badge mt-3">
            <i class="bi bi-info-circle"></i>
            Claude a accès à l'ensemble de vos biens, chantiers, simulations de primes et documents.
          </div>

        </div>
      </div>
    </div>

    <!-- Zone de chat -->
    <div class="col-lg-9">
      <div class="panel expert-ia-chat-panel d-flex flex-column">

        <!-- Header chat -->
        <div class="panel-header">
          <h3><i class="bi bi-robot me-2"></i>Assistant IA Expert Rénovation</h3>
          <div class="d-flex align-items-center gap-2">
            <span class="panel-badge"><i class="bi bi-circle-fill me-1" style="color: #84A98C; font-size: 0.45rem;"></i>Claude Sonnet</span>
            <span class="panel-badge" style="background: rgba(var(--ren0vate-primary-rgb),0.15); color: var(--ren0vate-primary);">
              <i class="bi bi-layers me-1"></i>Tous les biens
            </span>
            <%= link_to decision_hub_index_path, class: "btn btn-sm btn-outline-light" do %>
              <i class="bi bi-compass me-1"></i>Feuille de route
            <% end %>
          </div>
        </div>

        <!-- Messages -->
        <div class="expert-ia-messages" id="chatMessages">
          <div class="d-flex mb-4">
            <div class="flex-shrink-0">
              <div class="bot-avatar"><i class="bi bi-robot"></i></div>
            </div>
            <div class="flex-grow-1 ms-3">
              <div class="ai-message">
                <p class="mb-2"><strong>Bonjour <%= current_user.first_name || current_user.email.split('@').first.capitalize %> !</strong></p>
                <p class="mb-2">Je suis votre assistant IA expert en rénovation. En mode <strong>vue d'ensemble</strong>, je connais l'intégralité de votre patrimoine :
                  <strong><%= @properties.map { |p| p.titre.presence || p.commune }.to_sentence %></strong>.
                </p>
                <p class="mb-2">Posez-moi des questions transversales, par exemple :</p>
                <ul class="mb-2">
                  <li>Quels biens ont le meilleur potentiel de primes ?</li>
                  <li>Quelle est la priorité travaux sur l'ensemble de mon patrimoine ?</li>
                  <li>Quel bien rénover en premier pour maximiser la valeur ?</li>
                  <li>Comparaison des simulations primes entre mes biens</li>
                </ul>
                <p class="mb-0 small text-muted">💡 Pour des questions spécifiques à un bien, utilisez le mode "Consulter sur un bien précis".</p>
              </div>
              <small class="text-muted ms-2">À l'instant</small>
            </div>
          </div>
        </div>

        <!-- Zone de saisie -->
        <div class="expert-ia-input-zone">
          <form id="aiExpertForm">
            <div class="input-group">
              <input type="text" class="form-control" id="aiExpertInput"
                     placeholder="Posez votre question sur l'ensemble de vos biens..." autocomplete="off">
              <button type="button" class="btn btn-outline-secondary" id="aiVoiceBtn" title="Dicter votre question">
                <i class="bi bi-mic"></i>
              </button>
              <button class="btn btn-ren0vate" type="submit" id="aiExpertSendBtn">
                <i class="bi bi-send me-1"></i>Envoyer
              </button>
            </div>
            <small class="text-muted mt-2 d-block">
              <i class="bi bi-shield-check me-1"></i>Vos conversations sont privées et sécurisées
            </small>
          </form>
        </div>

      </div>
    </div>

  </div>

<% elsif @property.nil? %>
  <%# ── Sélection du bien : cartes full-width ──────────────────────────────── %>
  <div class="mb-4 pb-3 border-bottom d-flex align-items-center justify-content-between">
    <div>
      <h2 class="h4 mb-1"><i class="bi bi-cpu me-2" style="color: var(--ren0vate-primary);"></i>Assistant IA Expert</h2>
      <p class="text-muted mb-0 small">Sélectionnez le bien sur lequel vous souhaitez obtenir des conseils personnalisés</p>
    </div>
    <%= link_to decision_hub_index_path, class: "btn btn-sm btn-outline-secondary" do %>
      <i class="bi bi-compass me-1"></i>Feuille de route
    <% end %>
  </div>

  <div class="row g-3">
    <% @properties.each do |property| %>
      <% peb = property.certificat_peb_wallonie || property.certificat_peb_flandre || property.certificat_peb_bruxelles || property.peb %>
      <% best_sim = property.simulations.max_by { |s| s.total_simule.to_i } %>
      <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100 expert-property-card">
          <div class="card-body p-4 d-flex flex-column">
            <div class="d-flex align-items-start mb-3">
              <div class="icon-circle me-3 flex-shrink-0">
                <i class="bi bi-house-door"></i>
              </div>
              <div class="flex-grow-1 min-w-0">
                <h5 class="card-title mb-1 fw-semibold text-truncate">
                  <%= property.titre.presence || "Bien sans nom" %>
                </h5>
                <small class="text-muted">
                  <i class="bi bi-geo-alt me-1"></i>
                  <%= property.rue %> <%= property.numero %>, <%= property.code_postal %> <%= property.commune %>
                </small>
              </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
              <% if peb.present? %>
                <span class="badge rounded-pill" style="background: rgba(var(--ren0vate-primary-rgb), 0.1); color: var(--ren0vate-primary);">
                  <i class="bi bi-lightning me-1"></i>PEB <%= peb %>
                </span>
              <% end %>
              <span class="badge rounded-pill" style="background: rgba(var(--ren0vate-accent-rgb, 180,100,50), 0.1); color: var(--ren0vate-text-muted);">
                <i class="bi bi-geo me-1"></i><%= property.region&.capitalize %>
              </span>
              <% if property.projects.any? %>
                <span class="badge rounded-pill bg-light text-muted">
                  <i class="bi bi-tools me-1"></i><%= property.projects.count %> chantier<%= property.projects.count > 1 ? 's' : '' %>
                </span>
              <% end %>
              <% if best_sim %>
                <span class="badge rounded-pill" style="background: rgba(132,169,140,0.15); color: #527a5f;">
                  <i class="bi bi-currency-euro me-1"></i><%= number_to_currency(best_sim.total_simule || 0, unit: "", precision: 0) %>&thinsp;€ primes
                </span>
              <% end %>
            </div>

            <div class="mt-auto pt-3 border-top">
              <%= link_to expert_decision_hub_index_path(property_id: property.id), class: "btn btn-ren0vate d-block" do %>
                <i class="bi bi-robot me-2"></i>Consulter l'expert IA
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

<% else %>
  <div class="row g-3 expert-ia-row">

    <!-- Sidebar -->
    <div class="col-lg-3">
      <div class="panel expert-ia-sidebar-panel">
        <div class="panel-header">
          <h3><i class="bi bi-cpu me-2"></i>Bien sélectionné pour le chat</h3>
        </div>
        <div class="panel-body">

          <!-- Carte bien actif -->
          <div class="expert-ia-property-active mb-3">
            <div class="d-flex align-items-start gap-2 mb-2">
              <div style="width:32px; height:32px; background: var(--ren0vate-gradient-primary); border-radius: 50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <i class="bi bi-house-door text-white" style="font-size:0.85rem;"></i>
              </div>
              <div class="flex-grow-1 min-w-0">
                <div class="fw-semibold text-truncate" style="font-size: 0.9rem;">
                  <%= @property.titre.presence || @property.commune %>
                </div>
                <div class="text-muted" style="font-size: 0.75rem;">
                  <i class="bi bi-geo-alt me-1"></i><%= @property.commune %>, <%= @property.region&.capitalize %>
                </div>
              </div>
            </div>

            <% peb = @property.certificat_peb_wallonie || @property.certificat_peb_flandre || @property.certificat_peb_bruxelles || @property.peb %>
            <div class="d-flex flex-wrap gap-1 mb-2">
              <% if peb.present? %>
                <span class="badge bg-light text-dark" style="font-size: 0.7rem;"><i class="bi bi-lightning me-1" style="color:var(--ren0vate-primary);"></i>PEB <%= peb %></span>
              <% end %>
              <% if @property_projects.any? %>
                <span class="badge bg-light text-dark" style="font-size: 0.7rem;"><i class="bi bi-tools me-1" style="color:var(--ren0vate-accent);"></i><%= @property_projects.count %> chantier<%= @property_projects.count > 1 ? 's' : '' %></span>
              <% end %>
              <% if @property_simulations.any? %>
                <% best_sim = @property_simulations.max_by { |s| s.total_simule.to_i } %>
                <span class="badge bg-light text-dark" style="font-size: 0.7rem;"><i class="bi bi-currency-euro me-1" style="color:#527a5f;"></i><%= number_to_currency(best_sim.total_simule || 0, unit: "", precision: 0) %>&thinsp;€</span>
              <% end %>
            </div>

            <%= link_to expert_decision_hub_index_path, class: "btn btn-sm btn-outline-secondary w-100", style: "font-size: 0.75rem;" do %>
              <i class="bi bi-arrow-left-right me-1"></i>Changer de bien
            <% end %>
          </div>

          <!-- Info Claude -->
          <div class="expert-ia-info-badge mt-3">
            <i class="bi bi-info-circle"></i>
            Claude accède au bien sélectionné et à tous ses chantiers, primes, documents et intervenants.
          </div>

        </div>
      </div>
    </div>

    <!-- Zone de chat -->
    <div class="col-lg-9">
      <div class="panel expert-ia-chat-panel d-flex flex-column">

        <!-- Header chat -->
        <div class="panel-header">
          <h3><i class="bi bi-robot me-2"></i>Assistant IA Expert Rénovation</h3>
          <div class="d-flex align-items-center gap-2">
            <span class="panel-badge"><i class="bi bi-circle-fill me-1" style="color: #84A98C; font-size: 0.45rem;"></i>Claude Sonnet</span>
            <%= link_to decision_hub_index_path, class: "btn btn-sm btn-outline-light" do %>
              <i class="bi bi-compass me-1"></i>Feuille de route
            <% end %>
          </div>
        </div>

        <!-- Messages -->
        <div class="expert-ia-messages" id="chatMessages">
          <div class="d-flex mb-4">
            <div class="flex-shrink-0">
              <div class="bot-avatar"><i class="bi bi-robot"></i></div>
            </div>
            <div class="flex-grow-1 ms-3">
              <div class="ai-message">
                <p class="mb-2"><strong>Bonjour <%= current_user.first_name || current_user.email.split('@').first.capitalize %> !</strong></p>
                <p class="mb-2">Je suis votre assistant IA expert en rénovation. Je connais votre bien
                  <strong><%= @property.titre.presence || @property.commune %></strong>
                  (<%= @property.full_address %>) et l'ensemble de ses chantiers, primes et documents.
                </p>
                <ul class="mb-2">
                  <li>Analyser le potentiel de vos primes sur ce bien</li>
                  <li>Optimiser l'ordre et le planning de vos travaux</li>
                  <li>Répondre à vos questions techniques et administratives</li>
                  <li>Identifier les risques et les pièges à éviter</li>
                </ul>
                <p class="mb-0 small text-muted">💡 Posez directement votre question ci-dessous.</p>
              </div>
              <small class="text-muted ms-2">À l'instant</small>
            </div>
          </div>
        </div>

        <!-- Zone de saisie -->
        <div class="expert-ia-input-zone">
          <form id="aiExpertForm" data-property-id="<%= @property.id %>">
            <div class="input-group">
              <input type="text" class="form-control" id="aiExpertInput"
                     placeholder="Posez votre question à l'expert IA..." autocomplete="off">
              <button type="button" class="btn btn-outline-secondary" id="aiVoiceBtn" title="Dicter votre question">
                <i class="bi bi-mic"></i>
              </button>
              <button class="btn btn-ren0vate" type="submit" id="aiExpertSendBtn">
                <i class="bi bi-send me-1"></i>Envoyer
              </button>
            </div>
            <small class="text-muted mt-2 d-block">
              <i class="bi bi-shield-check me-1"></i>Vos conversations sont privées et sécurisées
            </small>
          </form>
        </div>

      </div>
    </div>

  </div>
<% end %>

<script>
function initExpertIA() {
  const form = document.getElementById('aiExpertForm');
  const input = document.getElementById('aiExpertInput');
  const chatMessages = document.getElementById('chatMessages');
  const sendBtn = document.getElementById('aiExpertSendBtn');
  if (!form || !input || !chatMessages) return;

  if (form.dataset.initialized === 'true') return;
  form.dataset.initialized = 'true';

  function setLoading(loading) {
    if (sendBtn) {
      sendBtn.disabled = loading;
      sendBtn.innerHTML = loading
        ? '<span class="spinner-border spinner-border-sm me-1"></span>...'
        : '<i class="bi bi-send me-1"></i>Envoyer';
    }
    if (input) input.disabled = loading;
  }

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    const question = input.value.trim();
    if (!question) return;

    addUserMessage(question);
    input.value = '';
    setLoading(true);

    const loadingId = addLoadingMessage();

    try {
      const csrfToken = document.querySelector('[name="csrf-token"]');

      const response = await fetch('/api/contextual_bot/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken ? csrfToken.content : ''
        },
        body: JSON.stringify({
          message: question,
          current_page: 'decision_hub',
          mode: 'expert',
          property_id: form.dataset.propertyId || ''
        })
      });

      removeLoadingMessage(loadingId);
      setLoading(false);

      if (!response.ok) {
        addAIMessage("⚠️ Erreur serveur (" + response.status + "). Veuillez réessayer.");
        return;
      }

      const data = await response.json();

      if (data.response && data.response.content) {
        addAIMessage(data.response.content, data.response.timestamp);
      } else if (data.error) {
        addAIMessage("⚠️ " + data.error);
      } else {
        addAIMessage("Désolé, je n'ai pas pu générer une réponse. Veuillez réessayer.");
      }

    } catch (error) {
      console.error('Expert IA error:', error);
      removeLoadingMessage(loadingId);
      setLoading(false);
      addAIMessage("🔌 Problème de connexion. Vérifiez votre réseau et réessayez.");
    }
  });

  function addUserMessage(text) {
    const d = document.createElement('div');
    d.className = 'd-flex justify-content-end mb-3';
    d.innerHTML = `<div class="user-message">${escapeHtml(text)}</div>`;
    chatMessages.appendChild(d);
    scrollToBottom();
  }

  function addAIMessage(text, timestamp) {
    const time = timestamp || new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
    const d = document.createElement('div');
    d.className = 'd-flex mb-3';
    d.innerHTML = `
      <div class="flex-shrink-0"><div class="bot-avatar"><i class="bi bi-robot"></i></div></div>
      <div class="flex-grow-1 ms-3">
        <div class="ai-message">${formatAIResponse(text)}</div>
        <small class="text-muted ms-2">${time}</small>
      </div>`;
    chatMessages.appendChild(d);
    scrollToBottom();
  }

  function addLoadingMessage() {
    const id = 'loading-' + Date.now();
    const d = document.createElement('div');
    d.id = id;
    d.className = 'd-flex mb-3';
    d.innerHTML = `
      <div class="flex-shrink-0"><div class="bot-avatar"><i class="bi bi-robot"></i></div></div>
      <div class="flex-grow-1 ms-3">
        <div class="ai-message d-flex align-items-center gap-2" style="padding:0.75rem 1rem;">
          <span class="spinner-border spinner-border-sm" style="color:var(--ren0vate-primary);"></span>
          <span class="text-muted small">Claude réfléchit…</span>
        </div>
      </div>`;
    chatMessages.appendChild(d);
    scrollToBottom();
    return id;
  }

  function removeLoadingMessage(id) {
    const el = document.getElementById(id);
    if (el) el.remove();
  }

  function scrollToBottom() {
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function formatAIResponse(text) {
    return text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/^### (.+)$/gm, '<h6 class="fw-bold mt-2 mb-1">$1</h6>')
      .replace(/^## (.+)$/gm, '<h5 class="fw-bold mt-3 mb-1">$1</h5>')
      .replace(/\n\n/g, '</p><p class="mb-2">')
      .replace(/\n/g, '<br>')
      .replace(/^[-•] (.+)$/gm, '<li>$1</li>')
      .replace(/(<li>[\s\S]*?<\/li>)/g, m => `<ul class="mb-2 ps-3">${m}</ul>`)
      .replace(/^(?!<[houp5ul]|<li)(.+)$/gm, m => m.includes('<') ? m : `<span>${m}</span>`);
  }

  // Commande vocale
  const voiceBtn = document.getElementById('aiVoiceBtn');
  const SpeechRecognitionAPI = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (voiceBtn && SpeechRecognitionAPI) {
    const recognition = new SpeechRecognitionAPI();
    recognition.lang = 'fr-FR';
    recognition.interimResults = true;
    recognition.continuous = false;
    let isListening = false;

    function setListening(listening) {
      isListening = listening;
      voiceBtn.classList.toggle('btn-danger', listening);
      voiceBtn.classList.toggle('btn-outline-secondary', !listening);
      voiceBtn.innerHTML = listening
        ? '<i class="bi bi-mic-fill voice-pulse"></i>'
        : '<i class="bi bi-mic"></i>';
      voiceBtn.title = listening ? 'Je vous écoute… (cliquez pour arrêter)' : 'Dicter votre question';
    }

    recognition.onresult = (event) => {
      const transcript = Array.from(event.results).map(r => r[0].transcript).join('');
      input.value = transcript;
    };

    recognition.onend = () => { setListening(false); };
    recognition.onerror = () => { setListening(false); };

    voiceBtn.addEventListener('click', () => {
      if (isListening) {
        recognition.stop();
      } else {
        input.value = '';
        recognition.start();
        setListening(true);
      }
    });
  } else if (voiceBtn) {
    voiceBtn.style.display = 'none';
  }
}

document.addEventListener('DOMContentLoaded', initExpertIA);
document.addEventListener('turbo:load', initExpertIA);
</script>
