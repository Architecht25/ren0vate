<% content_for :title, "Carrefour Conseil - #{@simulation&.property&.full_address || 'Votre projet'}" %>

<div class="decision-hub-container">

  <!-- Header Principal (Compact) -->
  <div class="decision-hub-header compact-header">
    <div class="container-fluid">
      <div class="row align-items-center">
        <div class="col-md-8">
          <h1 class="hub-title">
            🎯 <strong>Carrefour Conseil</strong>
            <small class="text-muted">Votre accompagnement intelligent</small>
          </h1>
        </div>
        <div class="col-md-4 text-end">
          <div class="confidence-badge">
            <span class="badge bg-success fs-6">
              <i class="bi bi-check-circle-fill me-1"></i>
              Fiabilité 94%
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Corps Principal : Triple Panneau -->
  <div class="decision-hub-body">
    <div class="container-fluid">
      <div class="row g-3">

        <!-- PANNEAU 1: Synthèse Simulation (Plus compact) -->
        <div class="col-xl-3 col-lg-6 col-md-12">
          <div class="panel synthesis-panel">
            <div class="panel-header">
              <h3>
                <i class="bi bi-graph-up text-primary me-2"></i>
                Vos Simulations
              </h3>
              <span class="panel-badge">Résultats</span>
            </div>

            <div class="panel-body compact-panel">
              <!-- Montant Total Highlight -->
              <div class="amount-highlight mb-3">
                <div class="amount-container">
                  <span class="amount-value">12,450€</span>
                  <span class="amount-label">Total primes éligibles</span>
                </div>
                <div class="primes-count">
                  <span class="count-number">5</span>
                  <span class="count-label">primes disponibles</span>
                </div>
              </div>

              <!-- Liste Prioritaire des Primes -->
              <div class="priority-list">
                <h5 class="section-title">Primes par priorité</h5>

                <div class="prime-item priority-high">
                  <div class="prime-header">
                    <span class="prime-name">Prime Isolation Toiture</span>
                    <span class="prime-amount">4,200€</span>
                  </div>
                  <div class="prime-meta">
                    <span class="urgency urgent">
                      <i class="bi bi-clock-fill me-1"></i>
                      Urgence: 30 jours
                    </span>
                  </div>
                </div>

                <div class="prime-item priority-high">
                  <div class="prime-header">
                    <span class="prime-name">Prime Pompe à Chaleur</span>
                    <span class="prime-amount">3,800€</span>
                  </div>
                  <div class="prime-meta">
                    <span class="urgency normal">
                      <i class="bi bi-calendar me-1"></i>
                      Flexible: 90 jours
                    </span>
                  </div>
                </div>

                <div class="prime-item priority-medium">
                  <div class="prime-header">
                    <span class="prime-name">Prime Isolation Façade</span>
                    <span class="prime-amount">2,850€</span>
                  </div>
                  <div class="prime-meta">
                    <span class="urgency seasonal">
                      <i class="bi bi-sun me-1"></i>
                      Saisonnier: Printemps
                    </span>
                  </div>
                </div>

                <div class="prime-item priority-low">
                  <div class="prime-header">
                    <span class="prime-name">Prime Audit Énergétique</span>
                    <span class="prime-amount">800€</span>
                  </div>
                  <div class="prime-meta">
                    <span class="urgency flexible">
                      <i class="bi bi-check-circle me-1"></i>
                      Déjà éligible
                    </span>
                  </div>
                </div>

                <div class="prime-item priority-low">
                  <div class="prime-header">
                    <span class="prime-name">Prime Ventilation</span>
                    <span class="prime-amount">800€</span>
                  </div>
                  <div class="prime-meta">
                    <span class="urgency conditional">
                      <i class="bi bi-exclamation-triangle me-1"></i>
                      Conditions à vérifier
                    </span>
                  </div>
                </div>
              </div>

              <!-- Actions Simulation -->
              <div class="panel-actions mt-4">
                <button class="btn btn-outline-primary btn-sm w-100">
                  <i class="bi bi-arrow-clockwise me-1"></i>
                  Recalculer avec nouvelles données
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- PANNEAU 2: Obligations & Recommandations (Plus large) -->
        <div class="col-xl-3 col-lg-6 col-md-12">
          <div class="panel obligations-panel">
            <div class="panel-header">
              <h3>
                <i class="bi bi-list-check text-warning me-2"></i>
                Obligations & Conseils
              </h3>
              <button class="btn btn-sm btn-outline-secondary" id="filterBtn">
                <i class="bi bi-funnel me-1"></i>
                Filtrer
              </button>
            </div>

            <div class="panel-body compact-panel">
              <!-- Obligations Légales -->
              <div class="obligations-section mb-3">
                <h5 class="section-title">
                  <i class="bi bi-exclamation-triangle text-danger me-1"></i>
                  Obligations (Avant dépôt)
                </h5>

                <div class="checklist">
                  <% @hub_data[:obligations].each_with_index do |obligation, index| %>
                    <div class="check-item <%= obligation[:type] %>-obligation"
                         data-type="<%= obligation[:type] %>"
                         data-importance="<%= obligation[:importance] %>">
                      <input type="checkbox"
                             id="obligation<%= index + 1 %>"
                             class="form-check-input"
                             <%= 'checked' if obligation[:completed] %>>
                      <label for="obligation<%= index + 1 %>" class="check-label">
                        <span class="check-text">
                          <%= obligation[:description] %>
                          <% if obligation[:importance] == 'critical' %>
                            <span class="badge badge-critical ms-1">Critique</span>
                          <% elsif obligation[:importance] == 'high' %>
                            <span class="badge badge-high ms-1">Important</span>
                          <% end %>
                        </span>
                        <span class="check-deadline">Échéance: <%= obligation[:deadline] %></span>
                        <% if obligation[:details] %>
                          <span class="check-details">
                            <i class="bi bi-info-circle me-1"></i>
                            <%= obligation[:details] %>
                          </span>
                        <% end %>
                      </label>
                    </div>
                  <% end %>
                </div>

                <!-- Légende des types -->
                <div class="obligations-legend mt-2">
                  <small class="text-muted">
                    <span class="legend-item">
                      <span class="badge bg-primary">Admin</span> Administrative
                    </span>
                    <span class="legend-item">
                      <span class="badge bg-success">Tech</span> Technique
                    </span>
                  </small>
                </div>
              </div>

              <!-- Recommandations Stratégiques -->
              <div class="recommendations-section">
                <h5 class="section-title">
                  <i class="bi bi-lightbulb text-info me-1"></i>
                  Recommandations Stratégiques
                </h5>

                <div class="recommendations-list">
                  <% @hub_data[:recommendations].each do |recommendation| %>
                    <div class="recommendation-item impact-<%= recommendation[:impact] %>"
                         data-type="<%= recommendation[:type] %>">
                      <div class="rec-icon"><%= recommendation[:icon] %></div>
                      <div class="rec-content">
                        <span class="rec-text"><%= recommendation[:description] %></span>
                        <span class="rec-benefit"><%= recommendation[:benefit] %></span>
                        <% if recommendation[:details] %>
                          <span class="rec-details">
                            <i class="bi bi-arrow-right me-1"></i>
                            <%= recommendation[:details] %>
                          </span>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PANNEAU 3: Obligations Techniques & Administratives (Nouveau) -->
        <div class="col-xl-3 col-lg-6 col-md-12">
          <div class="panel technical-obligations-panel">
            <div class="panel-header">
              <h3>
                <i class="bi bi-tools text-primary me-2"></i>
                Obligations Techniques
              </h3>
              <span class="panel-badge">Critiques</span>
            </div>

            <div class="panel-body compact-panel">
              <!-- Obligations Techniques -->
              <div class="technical-section mb-3">
                <h5 class="section-title">
                  <i class="bi bi-gear-fill text-primary me-1"></i>
                  Spécifications Techniques
                </h5>

                <div class="technical-checklist">
                  <% technical_obligations = @hub_data[:obligations].select { |o| o[:type] == "technical" } %>
                  <% technical_obligations.each_with_index do |obligation, index| %>
                    <div class="tech-item <%= obligation[:importance] %>-importance"
                         data-type="<%= obligation[:type] %>"
                         data-importance="<%= obligation[:importance] %>">
                      <input type="checkbox"
                             id="tech<%= index + 1 %>"
                             class="form-check-input"
                             <%= 'checked' if obligation[:completed] %>>
                      <label for="tech<%= index + 1 %>" class="tech-label">
                        <span class="tech-title">
                          <%= obligation[:description] %>
                          <% if obligation[:importance] == 'critical' %>
                            <span class="badge bg-danger ms-1">⚠️ Critique</span>
                          <% elsif obligation[:importance] == 'high' %>
                            <span class="badge bg-warning ms-1">🔶 Important</span>
                          <% else %>
                            <span class="badge bg-info ms-1">ℹ️ Standard</span>
                          <% end %>
                        </span>
                        <span class="tech-timing">📅 <%= obligation[:deadline] %></span>
                        <% if obligation[:details] %>
                          <span class="tech-details">
                            <i class="bi bi-info-circle me-1"></i>
                            <%= obligation[:details] %>
                          </span>
                        <% end %>
                      </label>
                    </div>
                  <% end %>
                </div>

                <!-- Actions techniques -->
                <div class="tech-actions mt-3">
                  <button class="btn btn-outline-primary btn-sm w-100 mb-2">
                    <i class="bi bi-download me-1"></i>
                    Télécharger spécifications PDF
                  </button>
                  <button class="btn btn-outline-info btn-sm w-100">
                    <i class="bi bi-calculator me-1"></i>
                    Calculateur résistance thermique
                  </button>
                </div>
              </div>

              <!-- Obligations Administratives -->
              <div class="administrative-section">
                <h5 class="section-title">
                  <i class="bi bi-file-text text-warning me-1"></i>
                  Démarches Administratives
                </h5>

                <div class="admin-checklist">
                  <% admin_obligations = @hub_data[:obligations].select { |o| o[:type] == "administrative" } %>
                  <% admin_obligations.each_with_index do |obligation, index| %>
                    <div class="admin-item <%= obligation[:importance] %>-importance"
                         data-type="<%= obligation[:type] %>"
                         data-importance="<%= obligation[:importance] %>">
                      <input type="checkbox"
                             id="admin<%= index + 1 %>"
                             class="form-check-input"
                             <%= 'checked' if obligation[:completed] %>>
                      <label for="admin<%= index + 1 %>" class="admin-label">
                        <span class="admin-title">
                          <%= obligation[:description] %>
                          <% if obligation[:importance] == 'critical' %>
                            <span class="badge bg-danger ms-1">🚨 Urgent</span>
                          <% elsif obligation[:importance] == 'high' %>
                            <span class="badge bg-warning ms-1">⚡ Priorité</span>
                          <% else %>
                            <span class="badge bg-secondary ms-1">📋 Standard</span>
                          <% end %>
                        </span>
                        <span class="admin-timing">⏰ <%= obligation[:deadline] %></span>
                        <% if obligation[:details] %>
                          <span class="admin-details">
                            <i class="bi bi-arrow-right me-1"></i>
                            <%= obligation[:details] %>
                          </span>
                        <% end %>
                      </label>
                    </div>
                  <% end %>
                </div>

                <!-- Actions administratives -->
                <div class="admin-actions mt-3">
                  <button class="btn btn-outline-warning btn-sm w-100 mb-2">
                    <i class="bi bi-clipboard-check me-1"></i>
                    Check-list administrative
                  </button>
                  <button class="btn btn-outline-success btn-sm w-100">
                    <i class="bi bi-globe me-1"></i>
                    Accéder aux portails officiels
                  </button>
                </div>
              </div>

              <!-- Statut global -->
              <div class="compliance-status mt-3 p-2 rounded">
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fw-bold">Conformité Globale:</span>
                  <span class="badge bg-warning">68% Complete</span>
                </div>
                <div class="progress mt-2" style="height: 6px;">
                  <div class="progress-bar bg-warning" style="width: 68%"></div>
                </div>
                <small class="text-muted d-block mt-1">
                  <i class="bi bi-exclamation-triangle me-1"></i>
                  5 obligations critiques restantes
                </small>
              </div>
            </div>
          </div>
        </div>

        <!-- PANNEAU 4: Timeline & Actions (Optimisé) -->
        <div class="col-xl-3 col-lg-6 col-md-12">
          <div class="panel timeline-panel">
            <div class="panel-header">
              <h3>
                <i class="bi bi-calendar-check text-success me-2"></i>
                Planning Optimisé
              </h3>
              <span class="panel-badge">6-8 semaines</span>
            </div>

            <div class="panel-body">
              <!-- Timeline Phases -->
              <div class="timeline-container">

                <!-- Phase 1 -->
                <div class="timeline-phase phase-1 active">
                  <div class="phase-header">
                    <div class="phase-number">1</div>
                    <div class="phase-info">
                      <span class="phase-name">Préparation Dossier</span>
                      <span class="phase-duration">2-3 semaines</span>
                    </div>
                  </div>

                  <div class="phase-actions">
                    <div class="action-item">
                      <span class="action-text">Rassembler documents techniques</span>
                      <button class="btn btn-outline-primary btn-sm action-btn">
                        Voir la liste
                      </button>
                    </div>

                    <div class="action-item">
                      <span class="action-text">Valider éligibilité entrepreneur</span>
                      <button class="btn btn-outline-primary btn-sm action-btn">
                        Trouver entrepreneurs
                      </button>
                    </div>

                    <div class="action-item">
                      <span class="action-text">Obtenir devis conformes</span>
                      <button class="btn btn-outline-primary btn-sm action-btn">
                        Modèles devis
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Phase 2 -->
                <div class="timeline-phase phase-2">
                  <div class="phase-header">
                    <div class="phase-number">2</div>
                    <div class="phase-info">
                      <span class="phase-name">Dépôt Coordonné</span>
                      <span class="phase-duration">1 semaine</span>
                    </div>
                  </div>

                  <div class="phase-actions">
                    <div class="action-item">
                      <span class="action-text">Dépôt simultané primes compatibles</span>
                      <button class="btn btn-success btn-sm action-btn">
                        Préparer formulaires
                      </button>
                    </div>

                    <div class="action-item">
                      <span class="action-text">Validation dossiers complets</span>
                      <button class="btn btn-outline-success btn-sm action-btn">
                        Check-list finale
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Phase 3 -->
                <div class="timeline-phase phase-3">
                  <div class="phase-header">
                    <div class="phase-number">3</div>
                    <div class="phase-info">
                      <span class="phase-name">Suivi & Travaux</span>
                      <span class="phase-duration">3-6 mois</span>
                    </div>
                  </div>

                  <div class="phase-actions">
                    <div class="action-item">
                      <span class="action-text">Suivi administratif automatisé</span>
                      <button class="btn btn-outline-info btn-sm action-btn">
                        Activer suivi
                      </button>
                    </div>

                    <div class="action-item">
                      <span class="action-text">Coordination travaux</span>
                      <button class="btn btn-outline-info btn-sm action-btn">
                        Planning chantier
                      </button>
                    </div>
                  </div>
                </div>

              </div>

              <!-- Actions Principales -->
              <div class="main-actions mt-4">
                <button class="btn btn-primary w-100 mb-2">
                  <i class="bi bi-play-fill me-1"></i>
                  Commencer la préparation
                </button>

                <button class="btn btn-outline-secondary w-100">
                  <i class="bi bi-download me-1"></i>
                  Télécharger feuille de route PDF
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Section Transitions -->
  <div class="decision-hub-footer">
    <div class="container">
      <div class="row">
        <div class="col-12">
          <div class="transition-actions">
            <h4>Prochaines étapes</h4>
            <div class="d-flex gap-3 flex-wrap">
              <a href="#" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>
                Retour aux simulations
              </a>
              <a href="#" class="btn btn-success">
                <i class="bi bi-file-earmark-text me-1"></i>
                Accéder aux formulaires miroir
              </a>
              <a href="#" class="btn btn-info">
                <i class="bi bi-people me-1"></i>
                Trouver des entrepreneurs
              </a>
              <a href="#" class="btn btn-warning">
                <i class="bi bi-calendar-plus me-1"></i>
                Planifier les travaux
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- Modal IA Consultation -->
<div class="modal fade" id="aiConsultationModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title">
          🤖 Consultation IA Spécialisée
        </h5>
        <div class="ai-model-info">
          <small>GPT-4 Turbo + Base données primes</small>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div class="ai-conversation-area" style="height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.375rem; padding: 1rem; background-color: #f8f9fa;">

          <!-- Message d'accueil IA -->
          <div class="ai-message">
            <div class="message-header">
              <strong>🤖 Assistant IA Ren0vate</strong>
              <small class="text-muted">Il y a quelques instants</small>
            </div>
            <div class="message-content">
              <p>Bonjour ! Je suis votre expert IA spécialisé en primes énergétiques.</p>
              <p>J'ai analysé vos simulations :</p>
              <ul>
                <li><strong>12,450€</strong> de primes potentielles identifiées</li>
                <li><strong>5 primes</strong> compatibles avec votre projet</li>
                <li><strong>Wallonie</strong> - Région détectée</li>
              </ul>
              <p>Que souhaitez-vous savoir ? Je peux vous aider avec :</p>
              <div class="quick-questions">
                <button class="btn btn-outline-primary btn-sm me-2 mb-2">Optimiser les combinaisons</button>
                <button class="btn btn-outline-primary btn-sm me-2 mb-2">Timing optimal</button>
                <button class="btn btn-outline-primary btn-sm me-2 mb-2">Documents requis</button>
                <button class="btn btn-outline-primary btn-sm me-2 mb-2">Entrepreneurs agréés</button>
              </div>
            </div>
          </div>

        </div>

        <div class="ai-input-area mt-3">
          <div class="input-group">
            <textarea
              class="form-control"
              placeholder="Posez votre question sur vos primes, les démarches, le timing..."
              rows="2"
              id="aiUserInput"></textarea>
            <button class="btn btn-primary" type="button" id="sendAiMessage">
              <i class="bi bi-send"></i>
            </button>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <small class="text-muted me-auto">
          <i class="bi bi-shield-check me-1"></i>
          Données sécurisées - Conversation confidentielle
        </small>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

<style>
/* Styles CSS pour le Decision Hub */
.decision-hub-container {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  min-height: 100vh;
}

.decision-hub-header {
  background: white;
  border-bottom: 2px solid #dee2e6;
  padding: 1rem 0;
  margin-bottom: 1rem;
}

.hub-title {
  font-size: 1.8rem;
  margin-bottom: 0.25rem;
  color: #2c3e50;
}

.hub-subtitle {
  font-size: 1rem;
  color: #6c757d;
  margin: 0;
}

.compact-header .confidence-badge .badge {
  padding: 0.5rem 0.75rem;
  font-size: 0.85rem;
}

/* Panels */
.panel {
  background: white;
  border-radius: 12px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  height: fit-content;
}

.panel-header {
  background: linear-gradient(135deg, #3498db, #2980b9);
  color: white;
  padding: 1rem 1.25rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.panel-header h3 {
  margin: 0;
  font-size: 1.1rem;
}

.panel-badge {
  background: rgba(255, 255, 255, 0.2);
  padding: 0.25rem 0.75rem;
  border-radius: 15px;
  font-size: 0.8rem;
}

.btn-ai {
  background: linear-gradient(135deg, #e74c3c, #c0392b);
  color: white;
  border: none;
  border-radius: 20px;
  padding: 0.5rem 1rem;
  font-size: 0.8rem;
}

.panel-body {
  padding: 1.5rem;
}

/* Synthesis Panel */
.amount-highlight {
  text-align: center;
  background: linear-gradient(135deg, #2ecc71, #27ae60);
  color: white;
  padding: 2rem;
  border-radius: 10px;
  margin-bottom: 1.5rem;
}

.amount-value {
  display: block;
  font-size: 3rem;
  font-weight: bold;
  line-height: 1;
}

.amount-label {
  display: block;
  font-size: 1rem;
  opacity: 0.9;
  margin-top: 0.5rem;
}

.primes-count {
  margin-top: 1rem;
}

.count-number {
  font-size: 1.5rem;
  font-weight: bold;
}

.count-label {
  display: block;
  font-size: 0.9rem;
  opacity: 0.8;
}

.section-title {
  font-size: 1.1rem;
  margin-bottom: 1rem;
  color: #2c3e50;
  border-bottom: 2px solid #ecf0f1;
  padding-bottom: 0.5rem;
}

.prime-item {
  background: #f8f9fa;
  border-radius: 8px;
  padding: 1rem;
  margin-bottom: 0.75rem;
  border-left: 4px solid #dee2e6;
}

.prime-item.priority-high {
  border-left-color: #e74c3c;
  background: #fdf2f2;
}

.prime-item.priority-medium {
  border-left-color: #f39c12;
  background: #fefaf6;
}

/* Optimisation de l'espace - Classes compact */
.compact-panel {
  padding: 1rem !important;
}

.compact-panel .section-title {
  font-size: 1rem;
  margin-bottom: 0.75rem;
}

.compact-panel .amount-highlight {
  padding: 1rem;
  margin-bottom: 1rem;
}

.compact-panel .check-item {
  padding: 0.5rem;
  margin-bottom: 0.5rem;
}

.compact-panel .recommendation-item {
  padding: 0.75rem;
  margin-bottom: 0.5rem;
}

.compact-panel .timeline-phase {
  padding: 0.75rem;
  margin-bottom: 0.75rem;
}

/* Ajustements des grilles pour écrans larges */
@media (min-width: 1400px) {
  .decision-hub-body .container-fluid {
    max-width: 1600px;
