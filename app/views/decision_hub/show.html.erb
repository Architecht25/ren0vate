<% content_for :title, "Carrefour Conseil - #{@simulation&.property&.full_address || 'Votre projet'}" %>

<% content_for :stylesheets do %>
  <%= stylesheet_link_tag 'decision_hub', 'data-turbo-track': 'reload' %>
<% end %>

<div class="decision-hub-container" data-controller="decision-hub-interactions">

  <%= render 'header' %>

  <!-- Corps Principal : Panneaux -->
  <div class="decision-hub-body">
    <div class="container-fluid">
      <div class="row g-3">
        <%= render 'synthesis_panel' %>
        <%= render 'obligations_panel' %>
        <%= render 'technical_obligations_panel' %>
        <%= render 'timeline_panel' %>
      </div>
    </div>
  </div>

  <%= render 'footer' %>
</div>

<%= render 'ai_consultation_modal' %>
