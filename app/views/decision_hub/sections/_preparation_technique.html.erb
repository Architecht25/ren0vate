<%# Partial : section préparation technique %>
<div class="preparation-technique-content"
     oninput="window.updateTechCompletionStatus && window.updateTechCompletionStatus()"
     onchange="window.updateTechCompletionStatus && window.updateTechCompletionStatus()">

  <%
    selected_primes = hub_data&.dig(:resume, :primes) || []
    prime_names = selected_primes.map { |p| p[:name] || p['name'] }.compact
    primes_with_conditions = Prime.where(titre: prime_names) if prime_names.any?
    if primes_with_conditions.blank? && prime_names.any?
      conditions = prime_names.map { |name| "titre ILIKE ?" }.join(" OR ")
      values = prime_names.map { |name| "%#{name}%" }
      primes_with_conditions = Prime.where(conditions, *values)
    end
    _sim_params = @default_simulation&.parameters.present? ? JSON.parse(@default_simulation.parameters) : {}
    technical_data = (_sim_params['technical_preparation'] || {}).deep_symbolize_keys
  %>

  <% if @default_simulation&.region&.downcase == 'wallonie' %>
    <%= render 'decision_hub/sections/preparation_technique/formulaires_wallonie' %>
  <% end %>

  <%# Monuments & Sites classés — Bruxelles-Capitale %>
  <% if @default_simulation&.region&.downcase == 'bruxelles' &&
        @default_simulation&.property&.bien_classe? %>
    <%= render 'decision_hub/sections/preparation_technique/monuments_bruxelles',
               technical_data: technical_data %>
  <%# Pour Bruxelles sans bien classé, aucune préparation technique générique n'est nécessaire %>
  <% elsif @default_simulation&.region&.downcase == 'bruxelles' %>
    <div class="alert alert-info border-0 rounded-4 mb-4">
      <div class="d-flex align-items-start gap-2">
        <i class="bi bi-info-circle-fill text-info flex-shrink-0 mt-1"></i>
        <div>
          <p class="fw-semibold mb-1">Bruxelles — Monuments & Sites classés</p>
          <p class="mb-2 small">
            À Bruxelles-Capitale, les subventions patrimoniales concernent uniquement les biens
            <strong>classés, sauvegardés ou situés en zone de protection</strong> selon le COBAT.
          </p>
          <p class="mb-0 small">
            Si votre bien est classé, activez l'option "Bien classé" dans la fiche du bien
            pour accéder au guide de préparation Monuments & Sites.
          </p>
        </div>
      </div>
    </div>
  <% else %>

  <%# Vue d'ensemble de la préparation (Wallonie / Flandre) %>
  <div class="preparation-overview mb-4">
    <h5 class="fw-bold mb-3">
      <i class="bi bi-tools me-2"></i>
      Préparation des données techniques
    </h5>
    <div class="alert alert-primary">
      <div class="d-flex align-items-start">
        <i class="bi bi-info-circle me-2 mt-1"></i>
        <div>
          <p class="mb-2 fw-semibold">Collectez maintenant vos données techniques</p>
          <p class="mb-0 small">
            Sur base des contraintes techniques que vous venez de consulter, renseignez ici les données de votre projet.
            Ces informations pré-rempliront automatiquement votre formulaire de demande.
          </p>
        </div>
      </div>
    </div>
  </div>

  <%# Étapes de collecte %>
  <div class="data-collection-steps">

    <%= render 'decision_hub/sections/preparation_technique/isolation',
               technical_data: technical_data %>

    <%= render 'decision_hub/sections/preparation_technique/systemes_energie',
               technical_data: technical_data %>

    <%= render 'decision_hub/sections/preparation_technique/techniques',
               technical_data: technical_data %>

    <%= render 'decision_hub/sections/preparation_technique/menuiseries',
               technical_data: technical_data %>

    <%# Actions %>
    <div class="action-section text-center mb-4">
      <button type="button" class="btn btn-success btn-lg px-5" id="save-technical-preparation"
              data-simulation-id="<%= @default_simulation&.id %>"
              onclick="window.saveTechnicalPreparation(this)">
        <i class="bi bi-check-circle me-2"></i>
        Sauvegarder mes données techniques
      </button>
      <div class="mt-3">
        <small class="text-muted">
          <i class="bi bi-info-circle me-1"></i>
          Ces données seront utilisées pour pré-remplir votre formulaire de demande de primes
        </small>
      </div>
    </div>

  </div>

  <% end # /else bruxelles non classé ou wallonie/flandre %>

</div>

<%= render 'decision_hub/sections/preparation_technique/javascript' %>
