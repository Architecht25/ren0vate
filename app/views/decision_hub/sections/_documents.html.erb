<!-- Partial pour la section documents -->
<div class="documents-content">

  <!-- Titre et région -->
  <div class="region-header mb-4">
    <h6 class="fw-bold mb-3">
      <i class="bi bi-file-earmark-check me-1"></i>
      Documents requis pour la région
      <span class="badge bg-primary ms-1">
        <%= @default_simulation&.region&.capitalize || 'Wallonie' %>
      </span>
    </h6>
  </div>

  <!-- Documents spécifiques à la région Wallonie -->
  <% if @default_simulation&.region&.downcase == 'wallonie' || !@default_simulation&.region %>
    <div class="wallonie-documents mb-4">
      <div class="alert alert-info mb-3">
        <h6 class="alert-heading">
          <i class="bi bi-info-circle me-1"></i>
          Documents obligatoires - Région Wallonne
        </h6>
        <p class="mb-2">Pour toute demande de prime en Wallonie, vous devez fournir :</p>
      </div>

      <div class="row">
        <div class="col-md-6">
          <ul class="list-unstyled">
            <li><i class="bi bi-check-circle text-success me-2"></i><strong>Devis</strong> des travaux visés par la demande de prime</li>
            <li><i class="bi bi-check-circle text-success me-2"></i><strong>Factures</strong> des travaux visés par la demande de prime</li>
            <li><i class="bi bi-check-circle text-success me-2"></i><strong>Annexes techniques</strong> complétées de l'entrepreneur</li>
            <li><i class="bi bi-check-circle text-success me-2"></i>Le <strong>RIB</strong> (Relevé d'Identité Bancaire) délivré avec une signature de la banque</li>
            <li><i class="bi bi-check-circle text-success me-2"></i>Des <strong>photos</strong> représentatives des travaux avant chantier, pendant les travaux et une fois les travaux terminés</li>
            <li><i class="bi bi-check-circle text-success me-2"></i><strong>Références de l'audit énergétique </strong>(si travaux applicable)</li>
          </ul>
        </div>
        <div class="col-md-6">
          <ul class="list-unstyled">
            <li><i class="bi bi-check-circle text-success me-2"></i><strong>Certificat de conformité électricité</strong> postérieur à la réalisation des travaux (si travaux concernés)</li>
            <li><i class="bi bi-check-circle text-success me-2"></i><strong>Certificat de conformité de l'installation de gaz</strong> postérieur à la réalisation des travaux (si travaux concernés)</li>
          </ul>

          <!-- Bouton d'accès aux attestations -->
          <div class="mt-3">
            <%= link_to "/fr/prime_document_templates", class: "btn btn-outline-primary btn-sm w-100" do %>
              <i class="bi bi-file-earmark-text me-2"></i>Accès aux attestations et modèles
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Documents spécifiques pour la demande de prime audit énergétique -->
    <div class="audit-documents mb-4">
      <div class="alert alert-warning mb-3">
        <h6 class="alert-heading">
          <i class="bi bi-clipboard-check me-1"></i>
          Documents requis pour la prime audit énergétique
        </h6>
        <p class="mb-2">
          <small>Pour bénéficier de la prime audit énergétique, vous devez fournir les documents suivants :</small>
        </p>
      </div>

      <div class="row">
        <div class="col-md-6">
          <ul class="list-unstyled">
            <li><i class="bi bi-file-earmark-text text-warning me-2"></i><strong>Facture(s) </strong> de l'auditeur agréé</li>
            <li><i class="bi bi-person-badge text-warning me-2"></i>Photo de la <strong>carte bancaire</strong> du demandeur ou un <strong>RIB (Relevé d'identité Bancaire)</strong></li>
          </ul>
        </div>
      </div>

      <div class="mt-3">
        <div class="alert alert-light border">
          <small class="text-muted">
            <i class="bi bi-info-circle me-1"></i>
            <strong>Rappel :</strong> L'audit énergétique doit être réalisé par un auditeur agréé par la Région wallonne.
            La prime audit est cumulable avec les autres primes énergétiques.
          </small>
        </div>
      </div>
    </div>

  <% elsif @default_simulation&.region&.downcase == 'flandre' %>
    <!-- Documents spécifiques à la région Flandre -->
    <div class="flandre-documents mb-4">
      <div class="alert alert-info mb-3">
        <h6 class="alert-heading">
          <i class="bi bi-info-circle me-1"></i>
          Documents obligatoires - Région Flandre
        </h6>
        <p class="mb-2">Pour toute demande de prime en Flandre, vous devez fournir :</p>
      </div>

      <div class="row">
        <div class="col-md-6">
          <h6 class="text-danger mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>Documents obligatoires
          </h6>
          <ul class="list-unstyled">
            <li class="mb-2"><i class="bi bi-check-circle text-danger me-2"></i>Devis des travaux</li>
            <li class="mb-2"><i class="bi bi-check-circle text-danger me-2"></i>Bordereau de commande des châssis</li>
            <li class="mb-2"><i class="bi bi-check-circle text-danger me-2"></i>Factures des travaux</li>
            <li class="mb-2"><i class="bi bi-check-circle text-danger me-2"></i>Avertissement extrait de rôle</li>
          </ul>
        </div>

        <div class="col-md-6">
          <h6 class="text-success mb-3">
            <i class="bi bi-plus-circle me-2"></i>Documents complémentaires
          </h6>
          <ul class="list-unstyled">
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Certificat PEB</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Attestations entrepreneurs</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Photos des travaux</li>
            <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Autres documents</li>
          </ul>
        </div>
      </div>
    </div>
  <% else %>
    <!-- Documents génériques pour autres régions -->
    <div class="key-documents mb-4">
      <% hub_data[:documents][:key_documents]&.each do |doc| %>
        <div class="document-item d-flex align-items-center p-3 mb-2 border rounded bg-<%= doc[:status] == 'completed' ? 'success' : doc[:status] == 'pending' ? 'warning' : 'light' %> bg-opacity-10">
          <div class="status-icon me-3">
            <i class="bi bi-<%= doc[:status] == 'completed' ? 'check-circle-fill text-success' : doc[:status] == 'pending' ? 'clock text-warning' : 'x-circle text-danger' %> fs-4"></i>
          </div>
          <div class="flex-grow-1">
            <div class="fw-medium"><%= doc[:name] %></div>
            <small class="text-muted">
              <i class="bi bi-bookmark me-1"></i>
              <%= doc[:category].humanize %>
              <% if doc[:deadline].present? %>
                • <i class="bi bi-calendar me-1"></i>
                Échéance: <%= doc[:deadline] %>
              <% end %>
            </small>
            <% if doc[:description].present? %>
              <div class="small text-muted mt-1"><%= doc[:description] %></div>
            <% end %>
          </div>
          <div class="action-zone ms-2">
            <% if doc[:status] == 'completed' %>
              <span class="badge bg-success">✓ Reçu</span>
            <% elsif doc[:status] == 'pending' %>
              <span class="badge bg-warning">📋 En attente</span>
            <% else %>
              <span class="badge bg-danger">❌ Manquant</span>
            <% end %>
            <% if doc[:urgent] %>
              <div class="small text-danger mt-1">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Urgent
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Statut global condensé (pour autres régions que Wallonie et Flandre) -->
  <% if @default_simulation&.region&.downcase != 'wallonie' && @default_simulation&.region&.downcase != 'flandre' && @default_simulation&.region %>
    <div class="status-overview mb-4">
      <div class="row g-2">
        <div class="col-md-4">
          <div class="text-center p-2 bg-success bg-opacity-10 rounded">
            <div class="fw-bold text-success"><%= hub_data[:documents][:completed].count %></div>
            <small class="text-muted">Collectés</small>
          </div>
        </div>
        <div class="col-md-4">
          <div class="text-center p-2 bg-warning bg-opacity-10 rounded">
            <div class="fw-bold text-warning"><%= hub_data[:documents][:missing].count %></div>
            <small class="text-muted">Manquants</small>
          </div>
        </div>
        <div class="col-md-4">
          <div class="text-center p-2 bg-danger bg-opacity-10 rounded">
            <div class="fw-bold text-danger"><%= hub_data[:documents][:urgent].count %></div>
            <small class="text-muted">Urgents</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Progress bar -->
    <div class="mb-4">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-medium">Progression documents</span>
        <span class="badge bg-primary"><%= hub_data[:documents][:completion_rate] %>%</span>
      </div>
      <div class="progress" style="height: 8px;">
        <div class="progress-bar"
             style="width: <%= hub_data[:documents][:completion_rate] %>%"></div>
      </div>
    </div>
  <% end %>

  <!-- Liste des documents (pour autres régions que Wallonie et Flandre) -->
  <% if @default_simulation&.region&.downcase != 'wallonie' && @default_simulation&.region&.downcase != 'flandre' && @default_simulation&.region %>
    <div class="documents-list">
      <% if hub_data[:documents][:required_documents].any? %>
        <% hub_data[:documents][:required_documents].each_with_index do |doc, index| %>
          <div class="document-item d-flex align-items-center p-3 mb-2 rounded border
                      <%= doc[:status] == 'completed' ? 'bg-success bg-opacity-10 border-success' : 'bg-light border-warning' %>">

            <input class="form-check-input me-3"
                   type="checkbox"
                   id="doc<%= index %>"
                   <%= 'checked' if doc[:status] == 'completed' %>>

            <label class="form-check-label flex-grow-1" for="doc<%= index %>">
              <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                  <div class="fw-medium">
                    <%= doc[:name] %>
                    <% if doc[:urgency] == 'critical' %>
                      <span class="badge bg-danger ms-1">🚨 Critique</span>
                    <% elsif doc[:urgency] == 'high' %>
                      <span class="badge bg-warning ms-1">⚠️ Important</span>
                    <% end %>
                  </div>
                  <small class="text-muted d-block">
                    Échéance: <%= doc[:deadline] %> •
                    Catégorie: <%= doc[:category].capitalize %>
                  </small>
                  <% if doc[:details].present? %>
                    <small class="text-info d-block mt-1">
                      <i class="bi bi-info-circle me-1"></i>
                      <%= doc[:details] %>
                    </small>
                  <% end %>
                </div>
                <div class="text-end">
                  <% case doc[:status] %>
                  <% when 'completed' %>
                    <small class="text-success">✅ Collecté</small>
                  <% when 'missing' %>
                    <% if doc[:urgency] == 'critical' %>
                      <small class="text-danger">🚨 Urgent</small>
                    <% else %>
                      <small class="text-warning">📋 À obtenir</small>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </label>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-4">
          <i class="bi bi-check-circle text-success fs-1"></i>
          <p class="mt-2 text-muted">Tous les documents sont collectés !</p>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Actions et conseils -->
  <div class="actions-section mt-4">
    <!-- Actions pour Wallonie -->
    <% if @default_simulation&.region == 'wallonie' || !@default_simulation&.region %>
      <div class="alert alert-success">
        <h6 class="alert-heading">
          <i class="bi bi-info-circle me-1"></i>
          Prochaines étapes pour vos documents Wallonie
        </h6>
        <p class="mb-2">Consultez nos guides pour préparer efficacement vos documents :</p>

        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-outline-success btn-sm quick-question"
                  data-question="Comment obtenir l'attestation de l'entrepreneur ?">
            <i class="bi bi-file-person me-1"></i>
            Attestation entrepreneur
          </button>
          <button class="btn btn-outline-info btn-sm quick-question"
                  data-question="Où trouver mes certificats de conformité ?">
            <i class="bi bi-shield-check me-1"></i>
            Certificats conformité
          </button>
          <button class="btn btn-outline-warning btn-sm quick-question"
                  data-question="Quelles photos prendre de mes travaux ?">
            <i class="bi bi-camera me-1"></i>
            Guide photos
          </button>
        </div>
      </div>
    <% elsif @default_simulation&.region&.downcase == 'flandre' %>
      <!-- Actions pour Flandre -->
      <div class="alert alert-warning">
        <h6 class="alert-heading">
          <i class="bi bi-exclamation-triangle me-1"></i>
          Prochaines étapes pour vos documents Flandre
        </h6>
        <p class="mb-2">Consultez nos guides pour préparer efficacement vos documents obligatoires et complémentaires :</p>

        <div class="d-flex gap-2 flex-wrap">
          <button class="btn btn-outline-danger btn-sm quick-question"
                  data-question="Comment obtenir le bordereau de commande des châssis ?">
            <i class="bi bi-window me-1"></i>
            Bordereau châssis
          </button>
          <button class="btn btn-outline-warning btn-sm quick-question"
                  data-question="Où trouver mon avertissement extrait de rôle ?">
            <i class="bi bi-file-earmark-text me-1"></i>
            Extrait de rôle
          </button>
          <button class="btn btn-outline-success btn-sm quick-question"
                  data-question="Quelles attestations d'entrepreneurs sont nécessaires ?">
            <i class="bi bi-person-check me-1"></i>
            Attestations entrepreneurs
          </button>
        </div>
      </div>
    <% else %>
      <!-- Actions pour autres régions -->
      <% if hub_data[:documents][:urgent].any? %>
        <div class="alert alert-warning">
          <h6 class="alert-heading">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Documents urgents à obtenir
          </h6>
          <p class="mb-2">Ces documents sont critiques pour vos primes :</p>
          <ul class="mb-3">
            <% hub_data[:documents][:urgent].each do |urgent_doc| %>
              <li><strong><%= urgent_doc %></strong></li>
            <% end %>
          </ul>
          <button class="btn btn-warning btn-sm quick-question"
                  data-question="Comment obtenir rapidement mes documents urgents ?">
            <i class="bi bi-question-circle me-1"></i>
            Comment les obtenir ?
          </button>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
