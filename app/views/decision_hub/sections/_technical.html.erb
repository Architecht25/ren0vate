<!-- Partial pour la section obligations techniques simplifié -->
<div class="technical-content">

  <%
    # Récupérer les primes sélectionnées depuis hub_data
    selected_primes = hub_data.dig(:resume, :primes) || []

    # Extraire les noms des primes (pas les slugs)
    prime_names = selected_primes.map { |p| p[:name] || p['name'] }.compact

    # Récupérer les objets Prime complets depuis la base de données par titre
    primes_with_conditions = Prime.where(titre: prime_names) if prime_names.any?

    # Si ça ne marche pas, essayer avec LIKE pour une correspondance partielle
    if primes_with_conditions.blank? && prime_names.any?
      # Chercher avec LIKE pour correspondance partielle
      conditions = prime_names.map { |name| "titre ILIKE ?" }.join(" OR ")
      values = prime_names.map { |name| "%#{name}%" }
      primes_with_conditions = Prime.where(conditions, *values)
    end
  %>

  <!-- Vue d'ensemble -->
  <div class="compliance-overview mb-4">
    <h6 class="fw-bold mb-3">
      <i class="bi bi-shield-check me-1"></i>
      Obligations techniques - <%= (@simulation&.region || 'Région').capitalize %>
    </h6>

    <% if primes_with_conditions&.any? %>
      <div class="alert alert-info">
        <p class="mb-0">
          <i class="bi bi-info-circle me-2"></i>
          Voici les conditions techniques pour vos <strong><%= primes_with_conditions.count %> primes</strong> sélectionnées.
        </p>
      </div>
    <% else %>
      <div class="alert alert-secondary">
        <p class="mb-0">
          <i class="bi bi-info-circle me-2"></i>
          Aucune prime sélectionnée. Effectuez d'abord une simulation pour voir les conditions techniques.
        </p>
      </div>
    <% end %>
  </div>

  <!-- Conditions techniques par prime -->
  <% if primes_with_conditions&.any? %>
    <div class="prime-conditions mb-4">
      <h6 class="fw-bold mb-3">
        <i class="bi bi-tools me-1"></i>
        Conditions techniques par prime sélectionnée
      </h6>

      <% primes_with_conditions.each_with_index do |prime, index| %>
        <div class="prime-section mb-4">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-gradient text-white d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);">
              <div class="d-flex align-items-center">
                <span class="badge bg-white text-dark me-2 fs-6 fw-bold"><%= index + 1 %></span>
                <i class="bi bi-<%= prime.icon_name %> me-2 fs-5"></i>
                <h6 class="mb-0 fw-semibold"><%= prime.titre %></h6>
              </div>
              <%
                # Récupérer le montant de la prime depuis selected_primes
                prime_data = selected_primes.find { |p| p[:name] == prime.titre }
                prime_amount = prime_data&.dig(:amount) || 0
              %>
              <% if prime_amount > 0 %>
                <span class="badge bg-white text-dark fs-6 fw-bold"><%= number_to_currency(prime_amount, unit: "", precision: 0) %>€</span>
              <% end %>
            </div>

            <div class="card-body p-4">
              <!-- Conditions techniques -->
              <% if prime.condition.present? %>
                <div class="conditions-section mb-4">
                  <div class="d-flex align-items-center mb-3">
                    <div class="icon-wrapper me-3" style="width: 32px; height: 32px; background: linear-gradient(135deg, #dc2626, #ef4444); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                      <i class="bi bi-exclamation-triangle text-white"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-0">Conditions techniques OBLIGATOIRES</h6>
                  </div>
                  <div class="condition-text p-3 rounded-3" style="background: linear-gradient(135deg, #fef2f2, #fecaca); border-left: 4px solid #ef4444;">
                    <div class="small lh-base text-gray-800"><%= simple_format(prime.condition) %></div>
                  </div>
                </div>
              <% end %>

              <!-- Conseils techniques -->
              <% if prime.conseil.present? %>
                <div class="conseils-section mb-4">
                  <div class="d-flex align-items-center mb-3">
                    <div class="icon-wrapper me-3" style="width: 32px; height: 32px; background: linear-gradient(135deg, #0ea5e9, #3b82f6); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                      <i class="bi bi-lightbulb text-white"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-0">Conseils techniques</h6>
                  </div>
                  <div class="conseil-text p-3 rounded-3" style="background: linear-gradient(135deg, #f0f9ff, #bae6fd); border-left: 4px solid #3b82f6;">
                    <div class="small lh-base text-gray-800"><%= simple_format(prime.conseil) %></div>
                  </div>
                </div>
              <% end %>

              <!-- Documents requis -->
              <% if prime.document.present? %>
                <div class="documents-section mb-4">
                  <div class="d-flex align-items-center mb-3">
                    <div class="icon-wrapper me-3" style="width: 32px; height: 32px; background: linear-gradient(135deg, #f59e0b, #f97316); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                      <i class="bi bi-file-earmark-text text-white"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-0">Documents techniques requis</h6>
                  </div>
                  <div class="document-text p-3 rounded-3" style="background: linear-gradient(135deg, #fffbeb, #fed7aa); border-left: 4px solid #f97316;">
                    <div class="small lh-base text-gray-800"><%= simple_format(prime.document) %></div>
                  </div>
                </div>
              <% end %>

              <!-- Délai compatible -->
              <% if prime.statut_compatible.present? %>
                <div class="delai-section">
                  <div class="d-flex align-items-center mb-3">
                    <div class="icon-wrapper me-3" style="width: 32px; height: 32px; background: linear-gradient(135deg, #6b7280, #9ca3af); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                      <i class="bi bi-clock text-white"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-0">Délai de dépôt</h6>
                  </div>
                  <div class="delai-text p-3 rounded-3" style="background: linear-gradient(135deg, #f9fafb, #e5e7eb); border-left: 4px solid #9ca3af;">
                    <div class="small text-gray-700"><%= prime.statut_compatible %></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Vérifications critiques pour la région -->
  <% region = @simulation&.region&.downcase %>
  <% if region.present? %>
    <div class="critical-checks mb-4">
      <h6 class="fw-bold text-danger mb-3">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        Vérifications critiques - <%= region.capitalize %>
      </h6>

      <% if region == 'wallonie' %>
        <div class="check-item mb-3">
          <div class="alert alert-warning d-flex align-items-start">
            <i class="bi bi-tools fs-4 me-3 mt-1"></i>
            <div class="flex-grow-1">
              <div class="fw-semibold">Installateur certifié RESCERT obligatoire (2026)</div>
              <div class="small mt-1">
                À partir du 1er janvier 2026, tous les installateurs de systèmes de chauffage doivent être certifiés RESCERT.
              </div>
              <div class="mt-2">
                <a href="https://rescert.be" target="_blank" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-search me-1"></i>
                  Vérifier RESCERT
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="check-item mb-3">
          <div class="alert alert-info d-flex align-items-start">
            <i class="bi bi-list-check fs-4 me-3 mt-1"></i>
            <div class="flex-grow-1">
              <div class="fw-semibold">Liste d'éligibilité energie.wallonie.be</div>
              <div class="small mt-1">
                Vérifiez que vos équipements figurent sur la liste officielle d'éligibilité.
              </div>
              <div class="mt-2">
                <a href="https://energie.wallonie.be" target="_blank" class="btn btn-sm btn-outline-info">
                  <i class="bi bi-search me-1"></i>
                  Vérifier éligibilité
                </a>
              </div>
            </div>
          </div>
        </div>

      <% elsif region == 'flandre' %>
        <div class="check-item mb-3">
          <div class="alert alert-warning d-flex align-items-start">
            <i class="bi bi-shield-check fs-4 me-3 mt-1"></i>
            <div class="flex-grow-1">
              <div class="fw-semibold">Certificat de conformité électrique</div>
              <div class="small mt-1">
                Obligatoire pour la plupart des travaux de rénovation en Flandre.
              </div>
            </div>
          </div>
        </div>

      <% elsif region == 'bruxelles' %>
        <div class="check-item mb-3">
          <div class="alert alert-danger d-flex align-items-start">
            <i class="bi bi-pause-circle fs-4 me-3 mt-1"></i>
            <div class="flex-grow-1">
              <div class="fw-semibold">Programme RENOLUTION suspendu</div>
              <div class="small mt-1">
                Aucune prime disponible en 2025. En attente de la formation du nouveau gouvernement.
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Actions rapides -->
  <div class="actions-section mt-4">
    <div class="d-flex gap-2 flex-wrap">
      <% if region == 'wallonie' %>
        <a href="https://rescert.be" target="_blank" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-shield-check me-1"></i>
          Vérifier RESCERT
        </a>
        <a href="https://energie.wallonie.be" target="_blank" class="btn btn-outline-info btn-sm">
          <i class="bi bi-list-check me-1"></i>
          Liste éligibilité
        </a>
      <% end %>

      <button class="btn btn-outline-success btn-sm quick-question"
              data-question="Comment m'assurer de respecter toutes les conditions techniques ?">
        <i class="bi bi-question-circle me-1"></i>
        Aide technique
      </button>
    </div>
  </div>

</div>
