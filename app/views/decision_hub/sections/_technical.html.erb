              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-house me-2 text-danger"></i>
                  <div>
                    <div class="fw-bold small">Isolation thermique toiture</div>
                    <code class="small text-muted">wallonie_toiture_isolation_thermique</code>
