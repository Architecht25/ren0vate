<!-- Partial pour la section obligations techniques - Version statique Flandre -->
<div class="technical-content">

  <%
    # Récupérer la région de la simulation
    region = @simulation&.region&.downcase || 'flandre'
  %>

  <!-- Vue d'ensemble -->
  <div class="compliance-overview mb-4">
    <h6 class="fw-bold mb-3">
      <i class="bi bi-shield-check me-1"></i>
      Contraintes techniques - <%= region.capitalize %>
    </h6>

    <div class="alert alert-info">
      <p class="mb-0">
        <i class="bi bi-info-circle me-2"></i>
        Voici toutes les <strong>conditions et conseils techniques</strong> pour les primes de <%= region.capitalize %>.
        Consultez les primes qui vous concernent selon votre estimation.
      </p>
    </div>
  </div>

  <!-- Conditions techniques par prime - FLANDRE (format compact) -->
  <% if region == 'flandre' %>
    <div class="prime-conditions mb-4">
      <h6 class="fw-bold mb-3">
        <i class="bi bi-tools me-1"></i>
        Conditions techniques des primes Flandre
      </h6>

      <!-- Format compact : tableau -->
      <div class="table-responsive" style="max-width: 100%; overflow-x: auto;">
        <table class="table table-hover align-middle" style="table-layout: fixed; width: 100%;">
          <thead class="table-light sticky-top">
            <tr>
              <th style="width: 25%;">Prime</th>
              <th style="width: 40%;">
                <i class="bi bi-exclamation-triangle text-danger me-1"></i>
                Conditions obligatoires
              </th>
              <th style="width: 35%;">
                <i class="bi bi-lightbulb text-info me-1"></i>
                Conseils techniques
              </th>
            </tr>
          </thead>
          <tbody>
            <!-- 1. Isolation toiture -->
            <tr class="table-warning">
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-house me-2 text-danger"></i>
                  <div>
                    <div class="fw-bold small">Isolation toiture</div>
                    <code class="small text-muted">isolation_toiture</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark fw-semibold">R ≥ 4.5 m²K/W pour toiture inclinée, plate et grenier</div>
              </td>
              <td>
                <div class="small text-muted">Isolant certifié (laine minérale, PIR, etc.). Vérifier l'étanchéité.</div>
              </td>
            </tr>

            <!-- 2. Isolation murs -->
            <tr class="table-warning">
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-bricks me-2 text-danger"></i>
                  <div>
                    <div class="fw-bold small">Isolation murs</div>
                    <code class="small text-muted">isolation_murs</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark fw-semibold">Mur creux: R≥2.0, Mur intérieur: R≥2.0, Mur extérieur: R≥3.0)</div>
              </td>
              <td>
                <div class="small text-muted">Privilégier l'isolation par l'extérieur si possible. Si par l'intérieur, nécessité d'un architecte</div>
              </td>
            </tr>

            <!-- 4. Isolation sol -->
            <tr class="table-warning">
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-bounding-box me-2 text-danger"></i>
                  <div>
                    <div class="fw-bold small">Isolation sol/plancher</div>
                    <code class="small text-muted">isolation_sol</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark fw-semibold">R ≥ 2.0 m²K/W + plancher bas sur vide sanitaire ou terre-plein</div>
              </td>
              <td>
                <div class="small text-muted">Isolants à forte résistance thermique. Traiter ponts thermiques.</div>
              </td>
            </tr>

            <!-- 5. Châssis et portes -->
            <tr class="table-warning">
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-windows me-2 text-danger"></i>
                  <div>
                    <div class="fw-bold small">Châssis et portes</div>
                    <code class="small text-muted">ramen_deuren</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark fw-semibold">Vitrage HR++ (U ≤ 1.0 W/m²K) + ventilation conforme (invisivent ou VMC Double flux (type D))</div>
              </td>
              <td>
                <div class="small text-muted">Intégrer système de ventilation efficace lors du remplacement.</div>
              </td>
            </tr>

            <!-- 6. Travaux préparatoires isolation -->
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-tools me-2 text-primary"></i>
                  <div>
                    <div class="fw-semibold small">Travaux prép. isolation</div>
                    <code class="small text-muted">voorbereiding_isolatie</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark">Travaux précédant isolation effective. Facturés séparément.</div>
              </td>
              <td>
                <div class="small text-muted">Intégrer dans devis global mais distinguer clairement.</div>
              </td>
            </tr>

            <!-- 7. Travaux prép. sanitaire/élec -->
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-plug me-2 text-primary"></i>
                  <div>
                    <div class="fw-semibold small">Travaux prép. sanitaire/élec</div>
                    <code class="small text-muted">voorbereiding_sanitair_elec</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark">Réseaux intérieurs à remplacer avant travaux (chauffage, élec, sanitaire)</div>
              </td>
              <td>
                <div class="small text-muted">Séparer dans devis. Concerne tuyaux, pas les appareils.</div>
              </td>
            </tr>

            <!-- 8. Pompe à chaleur -->
            <tr class="table-info">
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-wind me-2 text-info"></i>
                  <div>
                    <div class="fw-bold small">Pompe à chaleur</div>
                    <code class="small text-muted">warmtepomp</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark">Bâtiments +5 ans avec permis d'environnement</div>
              </td>
              <td>
                <div class="small text-muted">Professionnel agréé. Installation conforme normes PEB.</div>
              </td>
            </tr>

            <!-- 9. Chauffe-eau thermodynamique -->
            <tr class="table-info">
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-droplet me-2 text-info"></i>
                  <div>
                    <div class="fw-bold small">Chauffe-eau thermodynamique</div>
                    <code class="small text-muted">warmtepompboiler</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark">Système PAC pour ECS. Non combiné avec boiler électrique classique</div>
              </td>
              <td>
                <div class="small text-muted">Professionnel agréé. Dimensionnement selon besoins. Bâtiment +5 ans.</div>
              </td>
            </tr>

            <!-- 10. Rénovation toiture -->
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-layers me-2 text-primary"></i>
                  <div>
                    <div class="fw-semibold small">Rénovation toiture</div>
                    <code class="small text-muted">renovation_toiture</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark">Travaux associés à isolation toiture (structure, couverture, étanchéité, corniche)</div>
              </td>
              <td>
                <div class="small text-muted">Inclut dépose ancienne couverture, renforcement charpente, etc.</div>
              </td>
            </tr>

            <!-- 11. Rénovation murs -->
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-columns me-2 text-primary"></i>
                  <div>
                    <div class="fw-semibold small">Rénovation murs</div>
                    <code class="small text-muted">renovation_murs</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark">Travaux associés à isolation murs (bardage, crépi, traitement humidité)</div>
              </td>
              <td>
                <div class="small text-muted">Travaux préparatoires ou remise en état après isolation.</div>
              </td>
            </tr>

            <!-- 12. Rénovation sol -->
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-grid-3x3 me-2 text-primary"></i>
                  <div>
                    <div class="fw-semibold small">Rénovation sol</div>
                    <code class="small text-muted">renovation_sol</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark">Travaux associés à isolation sol (chape, ragréage, revêtement, étanchéité)</div>
              </td>
              <td>
                <div class="small text-muted">Documenter postes techniques hors isolant.</div>
              </td>
            </tr>

            <!-- 13. Prime amiante -->
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <i class="bi bi-exclamation-triangle me-2 text-danger"></i>
                  <div>
                    <div class="fw-semibold small">Prime amiante</div>
                    <code class="small text-muted">amiante</code>
                  </div>
                </div>
              </td>
              <td>
                <div class="small text-dark">Désamiantage obligatoire lors d'isolation</div>
              </td>
              <td>
                <div class="small text-muted">Doit accompagner attestation toiture ou mur.</div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>



  <% elsif region == 'wallonie' %>
