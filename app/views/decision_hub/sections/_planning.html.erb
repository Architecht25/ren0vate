<!-- Partial pour la section planning simplifié -->
<div class="planning-content">

  <!-- Délais réglementaires selon la région -->
  <div class="regulatory-deadlines mb-4">
    <h6 class="fw-bold mb-3">
      <i class="bi bi-clock-history me-1"></i>
      Délais réglementaires - <%= (@simulation&.region || 'Région').capitalize %>
    </h6>

    <% region = @simulation&.region&.downcase %>
    <% if region.present? && region == 'flandre' %>
      <div class="alert alert-info border-primary">
        <h6 class="fw-bold mb-3 text-primary">
          <i class="bi bi-info-circle me-2"></i>
          Règles Flandre
        </h6>

        <div class="row g-3">
          <div class="col-md-6">
            <div class="deadline-rule p-3 border rounded bg-light">
              <div class="fw-semibold text-primary mb-2">
                <i class="bi bi-receipt me-2"></i>
                Délai facture d'acompte
              </div>
              <p class="mb-2">Demande de prime à introduire dans les <strong>2 ans</strong> de la facture d'acompte.</p>

              <% if @simulation&.project&.date_début.present? %>
                <% deadline_acompte = @simulation.project.date_début + 2.years %>
                <div class="small">
                  <strong>Votre projet :</strong> Début <%= @simulation.project.date_début.strftime("%d/%m/%Y") %><br>
                  <strong class="text-<%= deadline_acompte > Date.current ? 'success' : 'danger' %>">
                    Délai limite : <%= deadline_acompte.strftime("%d/%m/%Y") %>
                    (<%= time_ago_in_words(deadline_acompte) %>)
                  </strong>
                </div>
              <% else %>
                <div class="small text-muted">
                  ℹ️ Renseignez la date de début de chantier pour calculer votre délai
                </div>
              <% end %>
            </div>
          </div>

          <div class="col-md-6">
            <div class="deadline-rule p-3 border rounded bg-light">
              <div class="fw-semibold text-warning mb-2">
                <i class="bi bi-file-earmark-text me-2"></i>
                Délai certificat PEB
              </div>
              <p class="mb-2">Si vous avez un certificat PEB, vous avez <strong>5 ans</strong> pour introduire votre demande.</p>

              <% if @simulation&.property&.date_peb_avant_travaux.present? %>
                <% deadline_peb = @simulation.property.date_peb_avant_travaux + 5.years %>
                <div class="small">
                  <strong>Votre certificat PEB :</strong> <%= @simulation.property.date_peb_avant_travaux.strftime("%d/%m/%Y") %><br>
                  <strong class="text-<%= deadline_peb > Date.current ? 'success' : 'danger' %>">
                    Délai limite : <%= deadline_peb.strftime("%d/%m/%Y") %>
                    (<%= time_ago_in_words(deadline_peb) %>)
                  </strong>
                </div>
              <% else %>
                <div class="small text-muted">
                  ℹ️ Renseignez la date de certificat PEB dans votre profil pour calculer ce délai
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Alerte suppression primes rénovation hauts revenus Flandre -->
        <div class="col-12 mt-3">
          <div class="alert alert-danger border-danger">
            <div class="d-flex align-items-start">
              <div class="me-3">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold mb-2 text-danger">
                  <i class="bi bi-calendar-x me-1"></i>
                  Suppression des primes rénovation pour hauts revenus
                </h6>
                <p class="mb-2">
                  <strong>Attention :</strong> Les primes de rénovation pour les <strong>catégories de hauts revenus 1 et 2</strong> seront supprimées après le <strong>28 février 2026</strong>.
                  Les personnes concernées doivent présenter leur <u>dossier complet</u> avant cette date limite. Après cette date, les hauts revenus n'auront plus droit aux primes rénovation.
                </p>
                <%
                  deadline_hauts_revenus = Date.new(2026, 2, 28)
                  days_until_hauts_revenus = (deadline_hauts_revenus - Date.current).to_i
                %>
                <div class="small">
                  <% if days_until_hauts_revenus > 0 %>
                    <strong class="text-primary bg-white px-2 py-1 rounded">
                      Il reste <%= pluralize(days_until_hauts_revenus, 'jour') %> avant la suppression de ces primes
                      (<%= deadline_hauts_revenus.strftime("%d/%m/%Y") %>)
                    </strong>
                  <% else %>
                    <strong class="text-white">
                      ❌ Ces primes ne sont plus disponibles pour les hauts revenus depuis le <%= deadline_hauts_revenus.strftime("%d/%m/%Y") %>
                    </strong>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Alerte suppression prime PEB Flandre -->
        <div class="col-12 mt-3">
          <div class="alert alert-danger border-danger">
            <div class="d-flex align-items-start">
              <div class="me-3">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold mb-2 text-danger">
                  <i class="bi bi-calendar-x me-1"></i>
                  Suppression de la prime label PEB
                </h6>
                <p class="mb-2">
                  <strong>Attention :</strong> La prime pour label PEB sera supprimée après le <strong>30 juin 2026</strong>.
                  Votre demande doit être <u>introduite</u> avant cette date limite, même si vos travaux ne sont pas encore terminés.
                </p>
                <%
                  deadline_peb_suppression = Date.new(2026, 6, 30)
                  days_until_suppression = (deadline_peb_suppression - Date.current).to_i
                %>
                <div class="small">
                  <% if days_until_suppression > 0 %>
                    <strong class="text-primary bg-white px-2 py-1 rounded">
                      Il reste <%= pluralize(days_until_suppression, 'jour') %> avant la suppression de cette prime
                      (<%= deadline_peb_suppression.strftime("%d/%m/%Y") %>)
                    </strong>
                  <% else %>
                    <strong class="text-white">
                      ❌ Cette prime n'est plus disponible depuis le <%= deadline_peb_suppression.strftime("%d/%m/%Y") %>
                    </strong>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    <% elsif region.present? && region == 'wallonie' %>
      <div class="alert alert-danger border-danger">
        <h6 class="fw-bold mb-3 text-danger">
          <i class="bi bi-exclamation-triangle me-2"></i>
          Règles Wallonie
        </h6>

        <div class="row g-3">
          <div class="col-md-6">
            <div class="deadline-rule p-3 border rounded bg-light">
              <div class="fw-semibold text-danger mb-2">
                <i class="bi bi-receipt me-2"></i>
                Délai facture de solde
              </div>
              <p class="mb-2">Demande de prime à introduire dans les <strong>8 mois</strong> de la facture de solde entrepreneur.</p>
              <p class="small text-muted">⚠️ Seules les factures émises dans les 2 ans de la facture de solde sont acceptées.</p>

              <% if @simulation&.project&.date_fin.present? %>
                <% deadline_solde = @simulation.project.date_fin + 8.months %>
                <div class="small">
                  <strong>Votre projet :</strong> Fin <%= @simulation.project.date_fin.strftime("%d/%m/%Y") %><br>
                  <strong class="text-<%= deadline_solde > Date.current ? 'warning' : 'danger' %>">
                    Délai limite : <%= deadline_solde.strftime("%d/%m/%Y") %>
                    (<%= time_ago_in_words(deadline_solde) %>)
                  </strong>
                </div>
              <% else %>
                <div class="small text-muted">
                  ℹ️ Renseignez la date de fin de chantier pour calculer votre délai
                </div>
              <% end %>
            </div>
          </div>

          <div class="col-md-6">
            <div class="deadline-rule p-3 border rounded bg-light">
              <div class="fw-semibold text-info mb-2">
                <i class="bi bi-clipboard-check me-2"></i>
                Délai prime audit
              </div>
              <p class="mb-2">Prime audit à introduire dans les <strong>4 mois</strong> de l'enregistrement de l'audit.</p>
              <p class="small text-muted">ℹ️ Validité de l'audit : <strong>10 ans</strong> pour les autres primes</p>

              <% if @simulation&.project&.date_audit.present? %>
                <% deadline_audit = @simulation.project.date_audit + 4.months %>
                <% audit_expiry = @simulation.project.date_audit + 10.years %>
                <div class="small">
                  <strong>Votre audit :</strong> <%= @simulation.project.date_audit.strftime("%d/%m/%Y") %><br>
                  <strong class="text-<%= deadline_audit > Date.current ? 'success' : 'danger' %>">
                    Prime audit limite : <%= deadline_audit.strftime("%d/%m/%Y") %>
                    (<%= time_ago_in_words(deadline_audit) %>)
                  </strong><br>
                  <small class="text-muted">
                    Validité audit : <%= audit_expiry.strftime("%d/%m/%Y") %>
                  </small>
                </div>
              <% else %>
                <div class="small text-muted">
                  ℹ️ Renseignez la date d'audit énergétique dans votre profil pour calculer ce délai
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Alerte arrêt des aides Wallonie -->
        <div class="col-12 mt-3">
          <div class="alert alert-danger border-danger">
            <div class="d-flex align-items-start">
              <div class="me-3">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
              </div>
              <div class="flex-grow-1">
                <h6 class="fw-bold mb-2 text-danger">
                  <i class="bi bi-calendar-x me-1"></i>
                  Fin du régime actuel des primes rénovation
                </h6>
                <p class="mb-2">
                  <strong>Attention :</strong> Le régime actuel des primes à la rénovation prendra fin le <strong>30 septembre 2026</strong> et sera remplacé par un <strong>système de prêts</strong> comme Rénopack et Rénoprêt.
                  Votre dossier doit être <u>introduit</u> avant cette date limite pour bénéficier du régime actuel.
                </p>
                <div class="small mb-2">
                  <strong>Le nouveau système :</strong>
                  <ul class="mb-0 mt-1">
                    <li>Prêts avec <strong>réduction du montant à rembourser</strong> (assimilée à une prime)</li>
                    <li>Réduction pour les projets permettant un <strong>"saut de label"</strong> énergétique</li>
                    <li>Aide calculée selon la <strong>catégorie de revenus</strong> et appliquée sur <strong>l'investissement global</strong></li>
                    <li>Obligations : réalisation d'un <strong>audit</strong> et travaux de <strong>salubrité + amélioration énergétique</strong></li>
                    <li>Accessible aux <strong>propriétaires bailleurs</strong></li>
                  </ul>
                </div>
                <%
                  deadline_wallonie_arret = Date.new(2026, 9, 30)
                  days_until_arret = (deadline_wallonie_arret - Date.current).to_i
                %>
                <div class="small">
                  <% if days_until_arret > 0 %>
                    <strong class="text-primary bg-white px-2 py-1 rounded">
                      Il reste <%= pluralize(days_until_arret, 'jour') %> avant la fin du régime actuel
                      (<%= deadline_wallonie_arret.strftime("%d/%m/%Y") %>)
                    </strong>
                  <% else %>
                    <strong class="text-white">
                      ❌ Le régime actuel a pris fin le <%= deadline_wallonie_arret.strftime("%d/%m/%Y") %>
                    </strong>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    <% elsif region.present? && region == 'bruxelles' %>
      <div class="alert alert-warning border-warning">
        <h6 class="fw-bold mb-3 text-warning">
          <i class="bi bi-building me-2"></i>
          Règles Bruxelles
        </h6>

        <div class="deadline-rule p-3 border rounded bg-light">
          <div class="fw-semibold text-warning mb-2">
            <i class="bi bi-receipt me-2"></i>
            Délai facture de solde
          </div>
          <p class="mb-2">Demande de prime à introduire dans les <strong>12 mois</strong> de la facture de solde entrepreneur.</p>

          <% if @simulation&.project&.date_fin.present? %>
            <% deadline_brux = @simulation.project.date_fin + 12.months %>
            <div class="small">
              <strong>Votre projet :</strong> Fin <%= @simulation.project.date_fin.strftime("%d/%m/%Y") %><br>
              <strong class="text-<%= deadline_brux > Date.current ? 'success' : 'danger' %>">
                Délai limite : <%= deadline_brux.strftime("%d/%m/%Y") %>
                (<%= time_ago_in_words(deadline_brux) %>)
              </strong>
            </div>
          <% else %>
            <div class="small text-muted">
              ℹ️ Renseignez la date de fin de chantier pour calculer votre délai
            </div>
          <% end %>
        </div>
      </div>

    <% else %>
      <div class="alert alert-secondary">
        <p class="mb-0">
          <i class="bi bi-info-circle me-2"></i>
          Sélectionnez d'abord une région dans votre profil pour voir les délais réglementaires spécifiques.
        </p>
      </div>
    <% end %>
  </div>

  <!-- Actions nécessaires -->
  <% if region.present? && (@simulation&.project&.date_début.present? || @simulation&.project&.date_fin.present? || @simulation&.property&.date_peb_avant_travaux.present?) %>
    <div class="required-actions mb-4">
      <h6 class="fw-bold mb-3">
        <i class="bi bi-list-check me-1"></i>
        Actions à prévoir
      </h6>

      <div class="action-list">
        <% if region == 'flandre' %>
          <div class="action-item d-flex align-items-start p-3 mb-2 border rounded bg-light">
            <div class="action-icon me-3">
              <i class="bi bi-camera text-primary"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fw-semibold">Photos de chantier avant travaux</div>
              <small class="text-muted">Documenter l'état initial pour justifier les travaux</small>
            </div>
            <div class="action-status">
              <span class="badge bg-secondary">Avant démarrage</span>
            </div>
          </div>

          <div class="action-item d-flex align-items-start p-3 mb-2 border rounded bg-light">
            <div class="action-icon me-3">
              <i class="bi bi-file-earmark-check text-warning"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fw-semibold">Préparation des attestations techniques</div>
              <small class="text-muted">Documents que l'entrepreneur devra remplir et signer</small>
            </div>
            <div class="action-status">
              <span class="badge bg-warning">Avec entrepreneur</span>
            </div>
          </div>

          <div class="action-item d-flex align-items-start p-3 mb-2 border rounded bg-light">
            <div class="action-icon me-3">
              <i class="bi bi-calculator text-info"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fw-semibold">Collecte des devis conformes</div>
              <small class="text-muted">Devis détaillés avec spécifications techniques requises</small>
            </div>
            <div class="action-status">
              <span class="badge bg-info">En cours</span>
            </div>
          </div>

          <div class="action-item d-flex align-items-start p-3 mb-2 border rounded bg-light">
            <div class="action-icon me-3">
              <i class="bi bi-shield-check text-success"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fw-semibold">Vérification agréments entrepreneur</div>
              <small class="text-muted">Confirmer les agréments nécessaires pour vos travaux</small>
            </div>
            <div class="action-status">
              <span class="badge bg-success">Validation</span>
            </div>
          </div>

          <div class="action-item d-flex align-items-start p-3 mb-2 border rounded bg-light">
            <div class="action-icon me-3">
              <i class="bi bi-file-earmark-plus text-primary"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fw-semibold">
                <%= link_to "Créer le formulaire de demande de primes", new_request_path, class: "text-decoration-none fw-semibold" %>
              </div>
              <small class="text-muted">Préparer le dossier officiel de demande de primes</small>
            </div>
            <div class="action-status">
              <%= link_to new_request_path, class: "text-decoration-none" do %>
                <span class="badge bg-primary">Créer</span>
              <% end %>
            </div>
          </div>

        <% elsif region == 'wallonie' %>
          <div class="action-item d-flex align-items-start p-3 mb-2 border rounded bg-light">
            <div class="action-icon me-3">
              <i class="bi bi-clock text-danger"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fw-semibold">Respecter les délais stricts</div>
              <small class="text-muted">8 mois maximum après facture de solde</small>
            </div>
            <div class="action-status">
              <span class="badge bg-danger">Critique</span>
            </div>
          </div>

          <div class="action-item d-flex align-items-start p-3 mb-2 border rounded bg-light">
            <div class="action-icon me-3">
              <i class="bi bi-calendar2-date text-warning"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fw-semibold">Planifier avant septembre 2026</div>
              <small class="text-muted">Arrêt progressif des primes prévu</small>
            </div>
            <div class="action-status">
              <span class="badge bg-warning">Urgent</span>
            </div>
          </div>

        <% elsif region == 'bruxelles' %>
          <div class="action-item d-flex align-items-start p-3 mb-2 border rounded bg-light">
            <div class="action-icon me-3">
              <i class="bi bi-pause-circle text-danger"></i>
            </div>
            <div class="flex-grow-1">
              <div class="fw-semibold">Programme RENOLUTION suspendu</div>
              <small class="text-muted">Aucune prime disponible en 2025</small>
            </div>
            <div class="action-status">
              <span class="badge bg-danger">Bloqué</span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Résumé et recommandations -->
  <% if region.present? %>
    <div class="planning-summary">
      <div class="card border-primary">
        <div class="card-header bg-primary text-white">
          <h6 class="mb-0">
            <i class="bi bi-lightbulb me-2"></i>
            Recommandation planning
          </h6>
        </div>
        <div class="card-body">
          <% if region == 'flandre' && (@simulation&.project&.date_début.present? || @simulation&.property&.date_peb_avant_travaux.present?) %>
            <%
              deadlines = []
              deadline_descriptions = []

              # Date limite suppression prime PEB Flandre
              deadline_peb_suppression = Date.new(2026, 6, 30)
              deadlines << deadline_peb_suppression
              deadline_descriptions << "suppression de la prime PEB Flandre"

              if @simulation&.project&.date_début.present?
                deadline_acompte = @simulation.project.date_début + 2.years
                deadlines << deadline_acompte
                deadline_descriptions << "délai facture d'acompte (2 ans)"
              end

              if @simulation&.property&.date_peb_avant_travaux.present?
                deadline_peb = @simulation.property.date_peb_avant_travaux + 5.years
                deadlines << deadline_peb
                deadline_descriptions << "délai certificat PEB (5 ans)"
              end

              if deadlines.any?
                earliest_deadline = deadlines.min
                earliest_index = deadlines.index(earliest_deadline)
                earliest_description = deadline_descriptions[earliest_index]
                days_remaining = (earliest_deadline - Date.current).to_i
              end
            %>

            <% if deadlines.any? %>
              <% if earliest_deadline == deadline_peb_suppression && days_remaining <= 180 %>
                <p class="text-danger mb-2">🚨 <strong>Urgence absolue - Prime supprimée bientôt !</strong></p>
                <p class="mb-1">Plus que <%= pluralize(days_remaining, 'jour') %> avant la <%= earliest_description %> !</p>
                <p class="mb-0 small text-danger"><strong>Cette prime disparaîtra définitivement après le 30/06/2026.</strong></p>
              <% elsif days_remaining > 365 %>
                <p class="text-success mb-2">✅ <strong>Vous avez le temps !</strong></p>
                <p class="mb-1">Il vous reste <%= pluralize(days_remaining, 'jour') %> pour introduire votre demande (basé sur la <%= earliest_description %>).</p>
                <p class="mb-0 small text-muted">Préparez tranquillement vos documents, mais n'oubliez pas la date limite de suppression.</p>
              <% elsif days_remaining > 90 %>
                <p class="text-warning mb-2">⚠️ <strong>Commencez à préparer votre dossier</strong></p>
                <p class="mb-1">Il vous reste <%= pluralize(days_remaining, 'jour') %> (basé sur la <%= earliest_description %>).</p>
                <p class="mb-0 small text-muted">Rassemblez vos factures et certificats.</p>
              <% elsif days_remaining > 0 %>
                <p class="text-danger mb-2">🚨 <strong>Urgence !</strong></p>
                <p class="mb-1">Plus que <%= pluralize(days_remaining, 'jour') %> (basé sur la <%= earliest_description %>) !</p>
                <p class="mb-0 small text-muted">Contactez-nous immédiatement pour l'introduction.</p>
              <% else %>
                <p class="text-danger mb-2">❌ <strong>Délai dépassé</strong></p>
                <p class="mb-0">La <%= earliest_description %> est malheureusement dépassée pour ce projet.</p>
              <% end %>
            <% end %>

          <% elsif region == 'wallonie' && (@simulation&.project&.date_fin.present? || @simulation&.project&.date_audit.present?) %>
            <%
              deadlines = []
              deadline_descriptions = []

              # Date limite arrêt des aides Wallonie
              deadline_wallonie_arret = Date.new(2026, 9, 30)
              deadlines << deadline_wallonie_arret
              deadline_descriptions << "arrêt des aides Wallonie"

              if @simulation&.project&.date_fin.present?
                deadline_solde = @simulation.project.date_fin + 8.months
                deadlines << deadline_solde
                deadline_descriptions << "délai facture de solde (8 mois)"
              end

              if @simulation&.project&.date_audit.present?
                deadline_audit = @simulation.project.date_audit + 4.months
                deadlines << deadline_audit
                deadline_descriptions << "délai prime audit (4 mois)"
              end

              earliest_deadline = deadlines.min
              earliest_index = deadlines.index(earliest_deadline)
              deadline_type = deadline_descriptions[earliest_index]
              days_remaining = (earliest_deadline - Date.current).to_i
            %>

            <% if earliest_deadline == deadline_wallonie_arret && days_remaining <= 180 %>
              <p class="text-danger mb-2">🚨 <strong>Urgence absolue - Arrêt des aides imminent !</strong></p>
              <p class="mb-1">Plus que <%= pluralize(days_remaining, 'jour') %> avant l'<%= deadline_type %> !</p>
              <p class="mb-0 small text-danger"><strong>Les aides pourraient disparaître définitivement après le 30/09/2026.</strong></p>
            <% elsif days_remaining > 60 %>
              <p class="text-success mb-2">✅ <strong>Dans les temps</strong></p>
              <p class="mb-1">Il vous reste <%= pluralize(days_remaining, 'jour') %> (basé sur le <%= deadline_type %>).</p>
              <p class="mb-0 small text-muted">Préparez rapidement votre dossier, mais n'oubliez pas la date limite d'arrêt des aides.</p>
            <% elsif days_remaining > 30 %>
              <p class="text-warning mb-2">⚠️ <strong>Dépêchez-vous</strong></p>
              <p class="mb-1">Plus que <%= pluralize(days_remaining, 'jour') %> (basé sur le <%= deadline_type %>) !</p>
              <p class="mb-0 small text-muted">Rassemblez tous vos documents.</p>
            <% elsif days_remaining > 0 %>
              <p class="text-danger mb-2">🚨 <strong>Extrême urgence !</strong></p>
              <p class="mb-1">Plus que <%= pluralize(days_remaining, 'jour') %> (basé sur le <%= deadline_type %>) !</p>
              <p class="mb-0 small text-muted">Contactez-nous immédiatement.</p>
            <% else %>
              <p class="text-danger mb-2">❌ <strong>Délai dépassé</strong></p>
              <p class="mb-0">Le <%= deadline_type %> est malheureusement dépassé.</p>
            <% end %>

          <% elsif region == 'bruxelles' %>
            <p class="text-info mb-2">ℹ️ <strong>Programme suspendu</strong></p>
            <p class="mb-0">En attente de la formation d'un nouveau gouvernement régional pour relancer RENOLUTION.</p>

          <% else %>
            <p class="text-muted mb-0">Renseignez les dates de votre projet pour obtenir un planning personnalisé.</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

</div>
