<%# locals: (technical_data:) %>

<!-- Section 2: Systèmes énergétiques -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);">
    <div class="d-flex align-items-center">
      <i class="bi bi-lightning me-2"></i>
      <h6 class="mb-0 fw-semibold">2. Systèmes énergétiques</h6>
      <div class="ms-auto">
        <span class="badge bg-white text-dark" id="energie-status">
          <% if technical_data.dig(:systemes_energie).present? %>À compléter<% else %>Non renseigné<% end %>
        </span>
      </div>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">

      <!-- Pompe à chaleur -->
      <div class="col-md-6">
        <div class="form-section">
          <h6 class="fw-semibold mb-2"><i class="bi bi-thermometer me-1"></i> Pompe à chaleur</h6>
          <div class="mb-2">
            <label class="form-label small">Type</label>
            <select class="form-select" name="pac_type">
              <option value="">Sélectionner...</option>
              <option value="air_eau" <%= 'selected' if technical_data.dig(:systemes_energie, :pac, :type) == 'air_eau' %>>Air/Eau</option>
              <option value="sol_eau" <%= 'selected' if technical_data.dig(:systemes_energie, :pac, :type) == 'sol_eau' %>>Sol/Eau (géothermie)</option>
              <option value="eau_eau" <%= 'selected' if technical_data.dig(:systemes_energie, :pac, :type) == 'eau_eau' %>>Eau/Eau</option>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small">Puissance (kW)</label>
            <input type="number" step="0.1" class="form-control" name="pac_puissance"
                   value="<%= technical_data.dig(:systemes_energie, :pac, :puissance) %>" placeholder="Ex: 12.5">
          </div>
          <div>
            <label class="form-label small">COP (Coefficient de performance)</label>
            <input type="number" step="0.1" class="form-control" name="pac_cop"
                   value="<%= technical_data.dig(:systemes_energie, :pac, :cop) %>" placeholder="Ex: 4.2">
          </div>
          <% if @default_simulation&.region&.downcase == 'flandre' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #fff5f5 0%, #fed7d7 100%); border: 1px solid #feb2b2;">
            <p class="small fw-semibold text-danger mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Attestations officielles</p>
            <div class="d-flex flex-column gap-1">
              <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/v1758468020/Attest_warmtepomp_woongebouwd_hmwmws.pdf" target="_blank" class="btn btn-outline-danger btn-sm w-100 text-start">
                <i class="bi bi-file-earmark-pdf me-2"></i>Warmtepomp (woning)
              </a>
              <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/v1758468017/Attest_warmtepomp_niet_woongebouwen_ep1qy9.pdf" target="_blank" class="btn btn-outline-danger btn-sm w-100 text-start">
                <i class="bi bi-file-earmark-pdf me-2"></i>Warmtepomp (niet-woning)
              </a>
            </div>
          </div>
          <% end %>
          <% if @default_simulation&.region&.downcase == 'wallonie' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #86efac;">
            <p class="small fw-semibold text-success mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Annexe officielle Wallonie</p>
            <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/13-03-2025_pdf-annexe-6-installation-de-chauffage-et-ecs-primes-habitation_ylbxzh.pdf" target="_blank" class="btn btn-outline-success btn-sm w-100 text-start">
              <i class="bi bi-file-earmark-pdf me-2"></i>Annexe 6 — Chauffage &amp; ECS
            </a>
          </div>
          <% end %>
        </div>
      </div>

      <!-- Chauffe-eau thermodynamique -->
      <div class="col-md-6">
        <div class="form-section">
          <h6 class="fw-semibold mb-2"><i class="bi bi-droplet me-1"></i> Chauffe-eau thermodynamique</h6>

          <!-- Scan label énergétique -->
          <div class="mb-3 p-2 bg-light rounded border">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <span class="small fw-semibold text-muted">
                <i class="bi bi-tag me-1"></i>Label énergétique
              </span>
              <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2"
                      id="cet-label-scan-btn"
                      onclick="document.getElementById('cet-label-file-input').click()">
                <i class="bi bi-camera me-1"></i>Scanner
              </button>
            </div>
            <input type="file" id="cet-label-file-input" accept="image/*,application/pdf" class="d-none"
                   onchange="cetLabelScanHandler(this)"
                   data-property-id="<%= @default_simulation&.property&.id %>"
                   data-project-id="<%= @default_simulation&.project&.id %>"
                   data-simulation-id="<%= @default_simulation&.id %>"
                   data-scan-url="<%= ocr_scan_label_energetique_path %>">
            <div class="input-group input-group-sm">
              <span class="input-group-text">Classe</span>
              <select class="form-select form-select-sm" name="cet_label_classe" id="cet_label_classe">
                <option value="">—</option>
                <% %w[A+++ A++ A+ A B C D E F G].each do |cls| %>
                  <option value="<%= cls %>" <%= 'selected' if technical_data.dig(:systemes_energie, :cet, :label_classe) == cls %>><%= cls %></option>
                <% end %>
              </select>
            </div>
            <div id="cet-label-scan-status" class="mt-1" style="display:none;"></div>
          </div>

          <div class="mb-2">
            <label class="form-label small">Capacité (L)</label>
            <input type="number" class="form-control" name="cet_capacite"
                   value="<%= technical_data.dig(:systemes_energie, :cet, :capacite) %>" placeholder="Ex: 270">
          </div>
          <div class="mb-2">
            <label class="form-label small">COP (Coefficient de performance)</label>
            <input type="number" step="0.1" class="form-control" name="cet_cop"
                   value="<%= technical_data.dig(:systemes_energie, :cet, :cop) %>" placeholder="Ex: 3.8">
          </div>
          <div>
            <label class="form-label small">Source d'air</label>
            <select class="form-select" name="cet_source">
              <option value="">Sélectionner...</option>
              <option value="air_ambiant" <%= 'selected' if technical_data.dig(:systemes_energie, :cet, :source) == 'air_ambiant' %>>Air ambiant</option>
              <option value="air_exterieur" <%= 'selected' if technical_data.dig(:systemes_energie, :cet, :source) == 'air_exterieur' %>>Air extérieur</option>
              <option value="air_extrait" <%= 'selected' if technical_data.dig(:systemes_energie, :cet, :source) == 'air_extrait' %>>Air extrait</option>
            </select>
          </div>
          <% if @default_simulation&.region&.downcase == 'flandre' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #fff5f5 0%, #fed7d7 100%); border: 1px solid #feb2b2;">
            <p class="small fw-semibold text-danger mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Attestation officielle</p>
            <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/v1758468020/Attest_warmtepompboiler_dkakkb.pdf" target="_blank" class="btn btn-outline-danger btn-sm w-100 text-start">
              <i class="bi bi-file-earmark-pdf me-2"></i>Warmtepompboiler
            </a>
          </div>
          <% end %>
          <% if @default_simulation&.region&.downcase == 'wallonie' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #86efac;">
            <p class="small fw-semibold text-success mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Annexe officielle Wallonie</p>
            <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/13-03-2025_pdf-annexe-6-installation-de-chauffage-et-ecs-primes-habitation_ylbxzh.pdf" target="_blank" class="btn btn-outline-success btn-sm w-100 text-start">
              <i class="bi bi-file-earmark-pdf me-2"></i>Annexe 6 — Chauffage &amp; ECS
            </a>
          </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
