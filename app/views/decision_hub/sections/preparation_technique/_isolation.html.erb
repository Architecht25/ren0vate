<%# locals: (technical_data:) %>

<!-- Section 1: Isolation (toiture, murs, sols) -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-gradient text-white" style="background: linear-gradient(135deg, #059669 0%, #047857 100%);">
    <div class="d-flex align-items-center">
      <i class="bi bi-house me-2"></i>
      <h6 class="mb-0 fw-semibold">1. Données d'isolation</h6>
      <div class="ms-auto">
        <span class="badge bg-white text-dark" id="isolation-status">
          <% if technical_data.dig(:isolation).present? %>À compléter<% else %>Non renseigné<% end %>
        </span>
      </div>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">

      <!-- Isolation toiture -->
      <div class="col-md-4">
        <div class="form-section">
          <h6 class="fw-semibold mb-2"><i class="bi bi-house-door me-1"></i> Toiture</h6>

          <div class="mb-2">
            <label class="form-label small fw-semibold">Marque</label>
            <input type="text" class="form-control" name="isolation_toiture_marque"
                   value="<%= technical_data.dig(:isolation, :toiture, :marque) %>"
                   placeholder="Ex: Isover, Rockwool...">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Modèle</label>
            <input type="text" class="form-control" name="isolation_toiture_modele"
                   value="<%= technical_data.dig(:isolation, :toiture, :modele) %>"
                   placeholder="Ex: GR32, Rocksono...">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Type d'isolation</label>
            <select class="form-select" name="isolation_toiture_type">
              <option value="">Sélectionner...</option>
              <% %w[laine_de_verre laine_de_roche polyurethane polyisocyanurate polystyrene_expanse polystyrene_extrude cellulose fibre_de_bois chanvre laine_de_mouton autre].each do |v| %>
                <option value="<%= v %>" <%= 'selected' if technical_data.dig(:isolation, :toiture, :type) == v %>><%= v.humanize.gsub('_', ' ').capitalize %></option>
              <% end %>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Superficie (m²)</label>
            <input type="number" step="0.01" class="form-control" name="isolation_toiture_superficie"
                   value="<%= technical_data.dig(:isolation, :toiture, :superficie) %>" placeholder="Ex: 120">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Épaisseur (cm)</label>
            <input type="number" class="form-control" name="isolation_toiture_epaisseur"
                   value="<%= technical_data.dig(:isolation, :toiture, :epaisseur) %>" placeholder="Ex: 20">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Conductivité thermique λ (W/m·K)</label>
            <input type="number" step="0.001" class="form-control" name="isolation_toiture_conductivite"
                   value="<%= technical_data.dig(:isolation, :toiture, :conductivite) %>" placeholder="Ex: 0.032">
          </div>
          <div>
            <label class="form-label small fw-semibold">Résistance thermique Rd (m²K/W)</label>
            <input type="number" step="0.1" class="form-control" name="isolation_toiture_rd"
                   value="<%= technical_data.dig(:isolation, :toiture, :rd) %>" placeholder="Ex: 5.5">
          </div>
          <% if @default_simulation&.region&.downcase == 'flandre' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #f0f7ff 0%, #e8f4f8 100%); border: 1px solid #bee3f8;">
            <p class="small fw-semibold text-primary mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Attestations officielles</p>
            <div class="d-flex flex-column gap-1">
              <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/v1758468015/Attest_aannemer_dak_zolderisolatie_bbylfd.pdf" target="_blank" class="btn btn-outline-primary btn-sm w-100 text-start">
                <i class="bi bi-file-earmark-pdf me-2"></i>Dak-/zolderisolatie
              </a>
              <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/v1758468014/Attest_Asbestverwijdering_In_combinatie_met_Isolatie_dak-en_of_Buitenmuur_jybksm.pdf" target="_blank" class="btn btn-outline-warning btn-sm w-100 text-start">
                <i class="bi bi-exclamation-triangle me-2"></i>Asbestverwijdering
              </a>
            </div>
          </div>
          <% end %>
          <% if @default_simulation&.region&.downcase == 'wallonie' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #86efac;">
            <p class="small fw-semibold text-success mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Annexe officielle Wallonie</p>
            <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/13-03-2025_pdf-annexe-1-toiture-primes-habitation_rochbb.pdf" target="_blank" class="btn btn-outline-success btn-sm w-100 text-start">
              <i class="bi bi-file-earmark-pdf me-2"></i>Annexe 1 — Toiture
            </a>
          </div>
          <% end %>
        </div>
      </div>

      <!-- Isolation murs -->
      <div class="col-md-4">
        <div class="form-section">
          <h6 class="fw-semibold mb-2"><i class="bi bi-bricks me-1"></i> Murs</h6>

          <div class="mb-2">
            <label class="form-label small fw-semibold">Marque</label>
            <input type="text" class="form-control" name="isolation_murs_marque"
                   value="<%= technical_data.dig(:isolation, :murs, :marque) %>" placeholder="Ex: Isover, Rockwool...">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Modèle</label>
            <input type="text" class="form-control" name="isolation_murs_modele"
                   value="<%= technical_data.dig(:isolation, :murs, :modele) %>" placeholder="Ex: GR32, Rocksono...">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Type d'isolation</label>
            <select class="form-select" name="isolation_murs_type">
              <option value="">Sélectionner...</option>
              <% %w[laine_de_verre laine_de_roche polyurethane polyisocyanurate polystyrene_expanse polystyrene_extrude cellulose fibre_de_bois chanvre laine_de_mouton autre].each do |v| %>
                <option value="<%= v %>" <%= 'selected' if technical_data.dig(:isolation, :murs, :type) == v %>><%= v.humanize.gsub('_', ' ').capitalize %></option>
              <% end %>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Type de façade</label>
            <select class="form-select" name="isolation_murs_facade_type">
              <option value="">Sélectionner...</option>
              <option value="exterieur" <%= 'selected' if technical_data.dig(:isolation, :murs, :facade_type) == 'exterieur' %>>Isolation par l'extérieur</option>
              <option value="interieur" <%= 'selected' if technical_data.dig(:isolation, :murs, :facade_type) == 'interieur' %>>Isolation par l'intérieur</option>
              <option value="cavity" <%= 'selected' if technical_data.dig(:isolation, :murs, :facade_type) == 'cavity' %>>Isolation de la coulisse</option>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Superficie (m²)</label>
            <input type="number" step="0.01" class="form-control" name="isolation_murs_superficie"
                   value="<%= technical_data.dig(:isolation, :murs, :superficie) %>" placeholder="Ex: 150">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Épaisseur (cm)</label>
            <input type="number" class="form-control" name="isolation_murs_epaisseur"
                   value="<%= technical_data.dig(:isolation, :murs, :epaisseur) %>" placeholder="Ex: 15">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Conductivité thermique λ (W/m·K)</label>
            <input type="number" step="0.001" class="form-control" name="isolation_murs_conductivite"
                   value="<%= technical_data.dig(:isolation, :murs, :conductivite) %>" placeholder="Ex: 0.035">
          </div>
          <div>
            <label class="form-label small fw-semibold">Résistance thermique Rd (m²K/W)</label>
            <input type="number" step="0.1" class="form-control" name="isolation_murs_rd"
                   value="<%= technical_data.dig(:isolation, :murs, :rd) %>" placeholder="Ex: 4.2">
          </div>
          <% if @default_simulation&.region&.downcase == 'flandre' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #f0f7ff 0%, #e8f4f8 100%); border: 1px solid #bee3f8;">
            <p class="small fw-semibold text-primary mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Attestation officielle</p>
            <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/v1758468016/Attest_Buitenmuurisolatie_ykbfil.pdf" target="_blank" class="btn btn-outline-primary btn-sm w-100 text-start">
              <i class="bi bi-file-earmark-pdf me-2"></i>Buitenmuurisolatie
            </a>
          </div>
          <% end %>
          <% if @default_simulation&.region&.downcase == 'wallonie' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #86efac;">
            <p class="small fw-semibold text-success mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Annexe officielle Wallonie</p>
            <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/13-03-2025_pdf-annexe-2-murs-primes-habitation_klxegb.pdf" target="_blank" class="btn btn-outline-success btn-sm w-100 text-start">
              <i class="bi bi-file-earmark-pdf me-2"></i>Annexe 2 — Murs
            </a>
          </div>
          <% end %>
        </div>
      </div>

      <!-- Isolation sols -->
      <div class="col-md-4">
        <div class="form-section">
          <h6 class="fw-semibold mb-2"><i class="bi bi-layers me-1"></i> Sols</h6>

          <div class="mb-2">
            <label class="form-label small fw-semibold">Marque</label>
            <input type="text" class="form-control" name="isolation_sols_marque"
                   value="<%= technical_data.dig(:isolation, :sols, :marque) %>" placeholder="Ex: Isover, Rockwool...">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Modèle</label>
            <input type="text" class="form-control" name="isolation_sols_modele"
                   value="<%= technical_data.dig(:isolation, :sols, :modele) %>" placeholder="Ex: GR32, Rocksono...">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Type d'isolation</label>
            <select class="form-select" name="isolation_sols_type">
              <option value="">Sélectionner...</option>
              <% %w[laine_de_verre laine_de_roche polyurethane polyisocyanurate polystyrene_expanse polystyrene_extrude cellulose fibre_de_bois chanvre laine_de_mouton autre].each do |v| %>
                <option value="<%= v %>" <%= 'selected' if technical_data.dig(:isolation, :sols, :type) == v %>><%= v.humanize.gsub('_', ' ').capitalize %></option>
              <% end %>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Localisation</label>
            <select class="form-select" name="isolation_sols_localisation">
              <option value="">Sélectionner...</option>
              <option value="sol_bas" <%= 'selected' if technical_data.dig(:isolation, :sols, :localisation) == 'sol_bas' %>>Sol en contact avec le sol</option>
              <option value="cave_chauffee" <%= 'selected' if technical_data.dig(:isolation, :sols, :localisation) == 'cave_chauffee' %>>Cave chauffée</option>
              <option value="cave_non_chauffee" <%= 'selected' if technical_data.dig(:isolation, :sols, :localisation) == 'cave_non_chauffee' %>>Cave non chauffée</option>
              <option value="vide_sanitaire" <%= 'selected' if technical_data.dig(:isolation, :sols, :localisation) == 'vide_sanitaire' %>>Vide sanitaire</option>
            </select>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Superficie (m²)</label>
            <input type="number" step="0.01" class="form-control" name="isolation_sols_superficie"
                   value="<%= technical_data.dig(:isolation, :sols, :superficie) %>" placeholder="Ex: 120">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Épaisseur (cm)</label>
            <input type="number" class="form-control" name="isolation_sols_epaisseur"
                   value="<%= technical_data.dig(:isolation, :sols, :epaisseur) %>" placeholder="Ex: 12">
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Conductivité thermique λ (W/m·K)</label>
            <input type="number" step="0.001" class="form-control" name="isolation_sols_conductivite"
                   value="<%= technical_data.dig(:isolation, :sols, :conductivite) %>" placeholder="Ex: 0.038">
          </div>
          <div>
            <label class="form-label small fw-semibold">Résistance thermique Rd (m²K/W)</label>
            <input type="number" step="0.1" class="form-control" name="isolation_sols_rd"
                   value="<%= technical_data.dig(:isolation, :sols, :rd) %>" placeholder="Ex: 3.5">
          </div>
          <% if @default_simulation&.region&.downcase == 'flandre' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #f0f7ff 0%, #e8f4f8 100%); border: 1px solid #bee3f8;">
            <p class="small fw-semibold text-primary mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Attestation officielle</p>
            <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/v1758468016/Attest_Vloerisolatie_lhkin6.pdf" target="_blank" class="btn btn-outline-primary btn-sm w-100 text-start">
              <i class="bi bi-file-earmark-pdf me-2"></i>Vloerisolatie
            </a>
          </div>
          <% end %>
          <% if @default_simulation&.region&.downcase == 'wallonie' %>
          <div class="mt-3 rounded-2 p-2" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #86efac;">
            <p class="small fw-semibold text-success mb-2"><i class="bi bi-file-earmark-arrow-down me-1"></i>Annexe officielle Wallonie</p>
            <a href="https://res.cloudinary.com/<%= ENV['CLOUDINARY_CLOUD_NAME'] %>/image/upload/13-03-2025_pdf-annexe-3-sols-primes-habitation_rykpl2.pdf" target="_blank" class="btn btn-outline-success btn-sm w-100 text-start">
              <i class="bi bi-file-earmark-pdf me-2"></i>Annexe 3 — Sols
            </a>
          </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
