<%# locals: (technical_data:)
    Préparation technique — Monuments & Sites classés, Bruxelles-Capitale
    Référence : AGovt 2 mai 2024 %>

<%
  _prop     = @default_simulation&.property
  _bien_cls = _prop&.bien_classe?
  _td       = technical_data || {}
%>

<!-- ============================================================
     0. AVERTISSEMENT CLEF
     ============================================================ -->
<div class="alert border-0 mb-4 rounded-3"
     style="background:#fff7ed; border-left:4px solid #f59e0b !important; border-left-width:4px !important;">
  <div class="d-flex align-items-start gap-2">
    <i class="bi bi-exclamation-triangle-fill text-warning flex-shrink-0 mt-1"></i>
    <div>
      <p class="fw-semibold mb-1">La demande doit être introduite AVANT tout début de travaux ou d'études.</p>
      <p class="mb-0 small text-muted">
        Tout dossier introduit après le début des travaux est irrecevable (AGovt 2 mai 2024, art. 10).
        Préparez votre dossier maintenant, avant de commander le moindre devis exécutoire.
      </p>
    </div>
  </div>
</div>

<!-- ============================================================
     1. ÉLIGIBILITÉ — CHECKLIST DE DÉPART
     ============================================================ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header rounded-top-4 text-white"
       style="background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-shield-check me-1"></i>
      <h6 class="mb-0 fw-semibold">1. Vérifier mon éligibilité</h6>
      <span class="badge bg-white text-primary ms-auto" id="mon-eligibilite-status">À vérifier</span>
    </div>
  </div>
  <div class="card-body">
    <p class="small text-muted mb-3">Cochez chaque condition pour confirmer que votre dossier est recevable :</p>

    <div class="d-flex flex-column gap-2">
      <div class="form-check p-3 rounded-3 border" style="background:#f8f9fa;">
        <input class="form-check-input" type="checkbox" id="elig_bien_classe"
               name="monuments_elig[bien_classe]"
               <%= _td.dig(:eligibilite, :bien_classe) == '1' ? 'checked' : '' %>>
        <label class="form-check-label small fw-semibold" for="elig_bien_classe">
          <i class="bi bi-bank me-1 text-primary"></i>
          Le bien est classé, sauvegardé ou situé en zone de protection selon le COBAT
          <a href="https://monument.heritage.brussels/fr/recherche/" target="_blank" rel="noopener"
             class="ms-2 small text-decoration-none">
            <i class="bi bi-box-arrow-up-right"></i> Vérifier
          </a>
        </label>
      </div>

      <div class="form-check p-3 rounded-3 border" style="background:#f8f9fa;">
        <input class="form-check-input" type="checkbox" id="elig_avant_travaux"
               name="monuments_elig[avant_travaux]"
               <%= _td.dig(:eligibilite, :avant_travaux) == '1' ? 'checked' : '' %>>
        <label class="form-check-label small fw-semibold" for="elig_avant_travaux">
          <i class="bi bi-clock-history me-1 text-primary"></i>
          La demande sera introduite <strong>avant</strong> tout début d'études ou de travaux
        </label>
      </div>

      <div class="form-check p-3 rounded-3 border" style="background:#f8f9fa;">
        <input class="form-check-input" type="checkbox" id="elig_conservation"
               name="monuments_elig[conservation]"
               <%= _td.dig(:eligibilite, :conservation) == '1' ? 'checked' : '' %>>
        <label class="form-check-label small fw-semibold" for="elig_conservation">
          <i class="bi bi-tools me-1 text-primary"></i>
          Les travaux visent la <strong>conservation ou restauration</strong> du bien
          (entretien, consolidation, nettoyage, traitement — pas de transformation)
        </label>
      </div>

      <div class="form-check p-3 rounded-3 border" style="background:#f8f9fa;">
        <input class="form-check-input" type="checkbox" id="elig_droit_reel"
               name="monuments_elig[droit_reel]"
               <%= _td.dig(:eligibilite, :droit_reel) == '1' ? 'checked' : '' %>>
        <label class="form-check-label small fw-semibold" for="elig_droit_reel">
          <i class="bi bi-person-check me-1 text-primary"></i>
          Je suis propriétaire, titulaire d'un droit réel, locataire autorisé ou concessionnaire du bien
        </label>
      </div>
    </div>

    <div id="mon-elig-warning" class="alert alert-warning border-0 mt-3 d-none small">
      <i class="bi bi-exclamation-triangle me-1"></i>
      Toutes les conditions doivent être cochées pour que la demande soit recevable.
    </div>
  </div>
</div>

<!-- ============================================================
     2. IDENTIFICATION DU BIEN CLASSÉ
     ============================================================ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header rounded-top-4 text-white"
       style="background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-geo-alt-fill me-1"></i>
      <h6 class="mb-0 fw-semibold">2. Identifier le bien classé</h6>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-8">
        <label class="form-label small fw-medium">Dénomination officielle du monument</label>
        <input type="text" class="form-control" name="monuments_bien[denomination]"
               value="<%= _td.dig(:bien, :denomination) || _prop&.denomination_monument.to_s %>"
               placeholder="ex. Église Saint-Nicolas de Bruxelles">
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-medium">Statut de protection</label>
        <select class="form-select" name="monuments_bien[statut]">
          <option value="">— Sélectionner —</option>
          <% [["Classé", "classe"], ["Sauvegardé", "sauvegarde"],
              ["Zone de protection", "zone_protection"], ["Inventorié", "inscription"]].each do |lbl, val| %>
            <option value="<%= val %>"
              <%= 'selected' if (_td.dig(:bien, :statut) || _prop&.statut_patrimonial) == val %>>
              <%= lbl %>
            </option>
          <% end %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-medium">N° dossier Brussels Heritage</label>
        <input type="text" class="form-control" name="monuments_bien[numero_dossier]"
               value="<%= _td.dig(:bien, :numero_dossier) || _prop&.numero_dossier_monument.to_s %>"
               placeholder="ex. 2076-0027/0">
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-medium">Date de l'arrêté de classement</label>
        <input type="date" class="form-control" name="monuments_bien[date_classement]"
               value="<%= _td.dig(:bien, :date_classement) || _prop&.date_classement&.strftime('%Y-%m-%d') %>">
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-medium">Référence cadastrale</label>
        <input type="text" class="form-control" name="monuments_bien[numero_cadastre]"
               value="<%= _td.dig(:bien, :numero_cadastre) || _prop&.numero_cadastre.to_s %>"
               placeholder="ex. A 0123/00">
      </div>
    </div>

    <div class="mt-3 p-3 rounded-3 border" style="background:#f0f9ff;">
      <p class="small fw-semibold mb-2 text-info">
        <i class="bi bi-link-45deg me-1"></i>Ressources officielles
      </p>
      <div class="d-flex flex-wrap gap-2">
        <a href="https://monument.heritage.brussels/fr/recherche/" target="_blank" rel="noopener"
           class="btn btn-outline-info btn-sm rounded-3">
          <i class="bi bi-map me-1"></i>Carte patrimoine bruxellois
        </a>
        <a href="https://irismonument.be/" target="_blank" rel="noopener"
           class="btn btn-outline-secondary btn-sm rounded-3">
          <i class="bi bi-database me-1"></i>Inventaire irismonument.be
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     3. DESCRIPTION DES TRAVAUX
     ============================================================ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header rounded-top-4 text-white"
       style="background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-file-text me-1"></i>
      <h6 class="mb-0 fw-semibold">3. Décrire les travaux</h6>
      <span class="badge bg-white text-purple ms-auto" id="mon-travaux-status">
        <%= _td.dig(:travaux, :intitule).present? ? 'Complété' : 'À remplir' %>
      </span>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-12">
        <label class="form-label small fw-medium">
          Intitulé de la demande <span class="text-danger">*</span>
          <span class="text-muted fw-normal">(décrire les parties du bien concernées et la nature des interventions)</span>
        </label>
        <textarea class="form-control" name="monuments_travaux[intitule]" rows="3"
                  placeholder="ex. Restauration de la façade principale et des deux façades latérales de l'église…"><%= _td.dig(:travaux, :intitule) %></textarea>
      </div>

      <div class="col-md-6">
        <label class="form-label small fw-medium">
          <i class="bi bi-clipboard me-1 text-secondary"></i>Études préalables prévues
        </label>
        <textarea class="form-control" name="monuments_travaux[etudes]" rows="4"
                  placeholder="Diagnostic structurel, étude des matériaux, relevé laser 3D, analyse stratigraphique..."><%= _td.dig(:travaux, :etudes) %></textarea>
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-medium">
          <i class="bi bi-tools me-1 text-secondary"></i>Travaux de conservation / restauration
          <span class="text-danger">*</span>
        </label>
        <textarea class="form-control" name="monuments_travaux[travaux]" rows="4"
                  placeholder="Nettoyage, consolidation, rejointoyage, traitement anti-humidité, restauration sculptures..."><%= _td.dig(:travaux, :travaux) %></textarea>
      </div>

      <div class="col-md-4">
        <label class="form-label small fw-medium">Autorisation urbanistique</label>
        <select class="form-select" name="monuments_travaux[autorisation_type]">
          <option value="">— Sélectionner —</option>
          <option value="permis" <%= 'selected' if _td.dig(:travaux, :autorisation_type) == 'permis' %>>Permis délivré</option>
          <option value="plan_gestion" <%= 'selected' if _td.dig(:travaux, :autorisation_type) == 'plan_gestion' %>>Plan de gestion patrimoniale</option>
          <option value="sans_permis" <%= 'selected' if _td.dig(:travaux, :autorisation_type) == 'sans_permis' %>>Actes non soumis à permis</option>
        </select>
      </div>
      <div class="col-md-8" id="mon-ref-autorisation">
        <label class="form-label small fw-medium">Référence de l'autorisation</label>
        <input type="text" class="form-control" name="monuments_travaux[autorisation_ref]"
               value="<%= _td.dig(:travaux, :autorisation_ref) %>"
               placeholder="ex. ____/PFU/________ ou référence plan de gestion">
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     4. BUDGET PRÉVISIONNEL
     ============================================================ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header rounded-top-4 text-white"
       style="background: linear-gradient(135deg, #059669 0%, #047857 100%);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-cash-stack me-1"></i>
      <h6 class="mb-0 fw-semibold">4. Budget prévisionnel (HTVA)</h6>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label small fw-medium">Coût des études préalables (€)</label>
        <div class="input-group">
          <input type="number" class="form-control mon-budget-input" name="monuments_budget[etudes]"
                 id="mon_budget_etudes"
                 value="<%= _td.dig(:budget, :etudes) %>"
                 placeholder="0" min="0" step="100">
          <span class="input-group-text">€</span>
        </div>
        <div class="form-text small text-muted">Subvention max sur études : 12 000 €</div>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-medium">Coût des travaux (€)</label>
        <div class="input-group">
          <input type="number" class="form-control mon-budget-input" name="monuments_budget[travaux]"
                 id="mon_budget_travaux"
                 value="<%= _td.dig(:budget, :travaux) %>"
                 placeholder="0" min="0" step="1000">
          <span class="input-group-text">€</span>
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-medium">Honoraires (archi, ingé, SPS…) (€)</label>
        <div class="input-group">
          <input type="number" class="form-control mon-budget-input" name="monuments_budget[honoraires]"
                 id="mon_budget_honoraires"
                 value="<%= _td.dig(:budget, :honoraires) %>"
                 placeholder="0" min="0" step="500">
          <span class="input-group-text">€</span>
        </div>
      </div>
    </div>

    <%# Total + estimation subvention %>
    <div class="mt-3 p-3 rounded-3 border" id="mon-budget-recap"
         style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);">
      <div class="row g-2 align-items-center">
        <div class="col-md-4">
          <div class="small text-muted">Total estimé HTVA</div>
          <div class="h5 mb-0 fw-bold text-dark" id="mon-total-display">—</div>
        </div>
        <div class="col-md-4">
          <div class="small text-muted">Type de bénéficiaire</div>
          <select class="form-select form-select-sm" id="mon-benef-type-prep"
                  name="monuments_budget[beneficiaire_type]">
            <option value="">— Sélectionner —</option>
            <option value="prive_bas_revenus" <%= 'selected' if _td.dig(:budget, :beneficiaire_type) == 'prive_bas_revenus' %>>Privé bas revenus (50%)</option>
            <option value="prive" <%= 'selected' if _td.dig(:budget, :beneficiaire_type) == 'prive' %>>Privé (40%)</option>
            <option value="asbl" <%= 'selected' if _td.dig(:budget, :beneficiaire_type) == 'asbl' %>>ASBL (60%)</option>
            <option value="public" <%= 'selected' if _td.dig(:budget, :beneficiaire_type) == 'public' %>>Public (80%)</option>
          </select>
        </div>
        <div class="col-md-4">
          <div class="small text-muted">Subvention estimée</div>
          <div class="h5 mb-0 fw-bold text-success" id="mon-subvention-display">—</div>
        </div>
      </div>
    </div>

    <%# Alerte seuils marchés publics %>
    <div class="alert alert-info border-0 mt-3 small rounded-3" id="mon-seuil-alerte" style="display:none;">
      <i class="bi bi-info-circle me-1"></i>
      <strong>Seuil marché public atteint :</strong>
      Au-delà de <strong>30 000 € de travaux</strong> ou <strong>8 500 € de services</strong>, vous devez joindre
      <strong>au moins 3 devis détaillés</strong> ou les pièces du marché public (cahier des charges, métré, offre retenue).
    </div>
  </div>
</div>

<!-- ============================================================
     5. INTERVENANTS
     ============================================================ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header rounded-top-4 text-white"
       style="background: linear-gradient(135deg, #d97706 0%, #b45309 100%);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-people-fill me-1"></i>
      <h6 class="mb-0 fw-semibold">5. Intervenants du chantier</h6>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-6">
        <div class="p-3 rounded-3 border" style="background:#fffbeb;">
          <p class="small fw-semibold mb-2">
            <i class="bi bi-person-badge me-1 text-warning"></i>Architecte désigné
          </p>
          <div class="mb-2">
            <input type="text" class="form-control form-control-sm" name="monuments_intervenants[archi_nom]"
                   value="<%= _td.dig(:intervenants, :archi_nom) %>"
                   placeholder="Nom de l'architecte">
          </div>
          <div class="mb-2">
            <input type="text" class="form-control form-control-sm" name="monuments_intervenants[archi_ordre]"
                   value="<%= _td.dig(:intervenants, :archi_ordre) %>"
                   placeholder="N° d'ordre (Conseil de l'Ordre)">
          </div>
          <input type="email" class="form-control form-control-sm" name="monuments_intervenants[archi_email]"
                 value="<%= _td.dig(:intervenants, :archi_email) %>"
                 placeholder="Email">
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 rounded-3 border" style="background:#fffbeb;">
          <p class="small fw-semibold mb-2">
            <i class="bi bi-shield-fill me-1 text-warning"></i>Coordinateur sécurité-santé (SPS)
            <span class="badge bg-light text-muted ms-1 fw-normal">si applicable</span>
          </p>
          <div class="mb-2">
            <input type="text" class="form-control form-control-sm" name="monuments_intervenants[sps_nom]"
                   value="<%= _td.dig(:intervenants, :sps_nom) %>"
                   placeholder="Nom du coordinateur SPS">
          </div>
          <input type="email" class="form-control form-control-sm" name="monuments_intervenants[sps_email]"
                 value="<%= _td.dig(:intervenants, :sps_email) %>"
                 placeholder="Email">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     6. CHECKLIST DOCUMENTS
     ============================================================ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header rounded-top-4 text-white"
       style="background: linear-gradient(135deg, #475569 0%, #334155 100%);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-folder-check me-1"></i>
      <h6 class="mb-0 fw-semibold">6. Documents à réunir</h6>
      <span class="badge bg-white text-dark ms-auto" id="mon-docs-count">0 / 5</span>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-2">

      <%# Colonne gauche %>
      <div class="col-md-6">
        <p class="small fw-semibold text-muted mb-2">Droits sur le bien</p>
        <div class="d-flex flex-column gap-2">
          <% [
            ["doc_propriete",   "Attestation de propriété ou autre droit réel (usufruit, emphytéose…)"],
            ["doc_bail",        "Contrat de bail + autorisation du propriétaire (si locataire)"],
            ["doc_copropriete", "Décision de copropriété (si syndic)"]
          ].each do |id, label| %>
            <div class="form-check p-2 rounded-3 border" style="background:#f8f9fa;">
              <input class="form-check-input mon-doc-check" type="checkbox" id="<%= id %>"
                     name="monuments_docs[<%= id %>]"
                     <%= _td.dig(:docs, id.to_sym) == '1' ? 'checked' : '' %>>
              <label class="form-check-label small" for="<%= id %>">
                <i class="bi bi-paperclip text-primary me-1"></i><%= label %>
              </label>
            </div>
          <% end %>
        </div>

        <p class="small fw-semibold text-muted mt-3 mb-2">Identité bancaire</p>
        <div class="form-check p-2 rounded-3 border" style="background:#f8f9fa;">
          <input class="form-check-input mon-doc-check" type="checkbox" id="doc_rib"
                 name="monuments_docs[doc_rib]"
                 <%= _td.dig(:docs, :doc_rib) == '1' ? 'checked' : '' %>>
          <label class="form-check-label small" for="doc_rib">
            <i class="bi bi-paperclip text-primary me-1"></i>RIB ou attestation d'identité bancaire (IBAN)
          </label>
        </div>

        <p class="small fw-semibold text-muted mt-3 mb-2">Assurances</p>
        <div class="form-check p-2 rounded-3 border" style="background:#f8f9fa;">
          <input class="form-check-input mon-doc-check" type="checkbox" id="doc_assurance"
                 name="monuments_docs[doc_assurance]"
                 <%= _td.dig(:docs, :doc_assurance) == '1' ? 'checked' : '' %>>
          <label class="form-check-label small" for="doc_assurance">
            <i class="bi bi-paperclip text-primary me-1"></i>Preuve de souscription des assurances nécessaires au chantier
          </label>
        </div>
      </div>

      <%# Colonne droite %>
      <div class="col-md-6">
        <p class="small fw-semibold text-muted mb-2">Estimations de coûts</p>
        <div class="d-flex flex-column gap-2">
          <div class="form-check p-2 rounded-3 border" style="background:#f8f9fa;">
            <input class="form-check-input mon-doc-check" type="checkbox" id="doc_devis"
                   name="monuments_docs[doc_devis]"
                   <%= _td.dig(:docs, :doc_devis) == '1' ? 'checked' : '' %>>
            <label class="form-check-label small" for="doc_devis">
              <i class="bi bi-paperclip text-primary me-1"></i>
              Minimum 3 devis détaillés (si travaux > 30 000 € ou services > 8 500 €)
              — ou 1 devis si en deçà des seuils
            </label>
          </div>
        </div>

        <p class="small fw-semibold text-muted mt-3 mb-2">Documents techniques</p>
        <div class="form-check p-2 rounded-3 border" style="background:#f8f9fa;">
          <input class="form-check-input mon-doc-check" type="checkbox" id="doc_technique"
                 name="monuments_docs[doc_technique]"
                 <%= _td.dig(:docs, :doc_technique) == '1' ? 'checked' : '' %>>
          <label class="form-check-label small" for="doc_technique">
            <i class="bi bi-paperclip text-primary me-1"></i>
            Documents décrivant précisément le champ et la nature des études / travaux
          </label>
        </div>

        <p class="small fw-semibold text-muted mt-3 mb-2">Documents optionnels (majorations)</p>
        <div class="d-flex flex-column gap-2">
          <div class="form-check p-2 rounded-3 border" style="background:#fff7ed;">
            <input class="form-check-input" type="checkbox" id="doc_revenus"
                   name="monuments_docs[doc_revenus]"
                   <%= _td.dig(:docs, :doc_revenus) == '1' ? 'checked' : '' %>>
            <label class="form-check-label small" for="doc_revenus">
              <i class="bi bi-paperclip text-warning me-1"></i>
              <strong>Majoration revenus (+25%)</strong> : avertissement-extrait de rôle + composition ménage + attestation sur l'honneur
            </label>
          </div>
        </div>
      </div>

    </div>

    <%# Barre de progression documents %>
    <div class="mt-3">
      <div class="d-flex justify-content-between small text-muted mb-1">
        <span>Préparation documentaire</span>
        <span id="mon-docs-pct">0%</span>
      </div>
      <div class="progress" style="height:8px;">
        <div class="progress-bar bg-success" role="progressbar"
             id="mon-docs-progress" style="width:0%"></div>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     7. CALENDRIER PRÉVISIONNEL
     ============================================================ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
  <div class="card-header rounded-top-4 text-white"
       style="background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-calendar3 me-1"></i>
      <h6 class="mb-0 fw-semibold">7. Calendrier prévisionnel</h6>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label small fw-medium">Date d'introduction de la demande</label>
        <input type="date" class="form-control" name="monuments_planning[date_demande]"
               value="<%= _td.dig(:planning, :date_demande) %>">
        <div class="form-text small text-danger">
          <i class="bi bi-exclamation-circle me-1"></i>Doit être <strong>avant</strong> tout début de travaux
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-medium">
          Début des travaux souhaité
          <span class="badge bg-light text-muted fw-normal ms-1">Indicatif</span>
        </label>
        <input type="date" class="form-control" name="monuments_planning[date_travaux]"
               value="<%= _td.dig(:planning, :date_travaux) %>">
        <div class="form-text small text-muted">
          <i class="bi bi-hourglass-split me-1"></i>Délai moyen de traitement : 3 à 6 mois
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-medium">Fin de chantier prévisionnelle</label>
        <input type="date" class="form-control" name="monuments_planning[date_fin]"
               value="<%= _td.dig(:planning, :date_fin) %>">
      </div>
    </div>

    <%# Timeline visuelle %>
    <div class="mt-3 p-3 rounded-3 border" style="background:#f0fdfa;">
      <p class="small fw-semibold text-teal mb-2">
        <i class="bi bi-signpost-2 me-1"></i>Étapes clés du processus
      </p>
      <div class="d-flex align-items-center gap-0 flex-wrap">
        <% [
          ["bi-file-earmark-plus", "Dépôt demande", "#0d6efd"],
          ["bi-arrow-right", nil, "#adb5bd"],
          ["bi-hourglass", "Instruction (3–6 mois)", "#6c757d"],
          ["bi-arrow-right", nil, "#adb5bd"],
          ["bi-check-circle", "Accord gouvernement", "#198754"],
          ["bi-arrow-right", nil, "#adb5bd"],
          ["bi-tools", "Début travaux", "#d97706"],
          ["bi-arrow-right", nil, "#adb5bd"],
          ["bi-cash-coin", "Liquidation subvention", "#0f766e"]
        ].each do |icon, label, color| %>
          <div class="d-flex flex-column align-items-center" style="min-width:<%= label ? '80px' : '20px' %>;">
            <i class="bi <%= icon %> mb-1" style="color:<%= color %>;font-size:1.2rem;"></i>
            <% if label %>
              <span class="text-center" style="font-size:0.65rem; color:#6c757d; line-height:1.2;"><%= label %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     CTA — Créer la demande
     ============================================================ -->
<div class="text-center mb-4">
  <% if @default_simulation&.property&.projects&.any? %>
    <% _mon_proj = @default_simulation.property.projects.order(created_at: :desc).first %>
    <%= link_to new_request_path(project_id: _mon_proj.id, form_type: :monuments_bruxelles),
          class: "btn btn-primary btn-lg px-5 rounded-3 me-2" do %>
      <i class="bi bi-file-earmark-plus me-2"></i>Créer ma demande officielle
    <% end %>
  <% end %>
  <a href="https://monument.heritage.brussels/fr/subventions/" target="_blank" rel="noopener"
     class="btn btn-outline-secondary btn-lg px-4 rounded-3">
    <i class="bi bi-box-arrow-up-right me-1"></i>Conditions officielles
  </a>
</div>

<script nonce="<%= content_security_policy_nonce %>">
(function() {
  var TAUX = { prive_bas_revenus: 0.50, prive: 0.40, asbl: 0.60, public: 0.80 };

  function fmt(n) {
    return new Intl.NumberFormat('fr-BE', { style:'currency', currency:'EUR', maximumFractionDigits:0 }).format(n);
  }

  // ---- Calcul budget ----
  function recalcBudget() {
    var etudes    = parseFloat(document.getElementById('mon_budget_etudes')?.value)    || 0;
    var travaux   = parseFloat(document.getElementById('mon_budget_travaux')?.value)   || 0;
    var honos     = parseFloat(document.getElementById('mon_budget_honoraires')?.value)|| 0;
    var total     = etudes + travaux + honos;
    var typeBenef = document.getElementById('mon-benef-type-prep')?.value;

    var totalEl = document.getElementById('mon-total-display');
    var subvEl  = document.getElementById('mon-subvention-display');
    var seuilEl = document.getElementById('mon-seuil-alerte');

    if (totalEl) totalEl.textContent = total > 0 ? fmt(total) : '—';

    if (typeBenef && TAUX[typeBenef]) {
      var taux   = TAUX[typeBenef];
      var subvEt = Math.min(etudes * taux, 12000);
      var subvTr = travaux * taux;
      var subvHo = honos * taux;
      if (subvEl) subvEl.textContent = fmt(subvEt + subvTr + subvHo);
    } else {
      if (subvEl) subvEl.textContent = '—';
    }

    // Alerte seuil marchés publics
    if (seuilEl) {
      seuilEl.style.display = (travaux > 30000 || (etudes + honos) > 8500) ? 'block' : 'none';
    }
  }

  document.querySelectorAll('.mon-budget-input').forEach(function(el) {
    el.addEventListener('input', recalcBudget);
  });
  var benefSel = document.getElementById('mon-benef-type-prep');
  if (benefSel) benefSel.addEventListener('change', recalcBudget);
  recalcBudget();

  // ---- Barre de progression documents ----
  function recalcDocs() {
    var checks = document.querySelectorAll('.mon-doc-check');
    var total  = checks.length;
    var done   = Array.from(checks).filter(function(c) { return c.checked; }).length;
    var pct    = total > 0 ? Math.round(done / total * 100) : 0;

    var bar    = document.getElementById('mon-docs-progress');
    var pctEl  = document.getElementById('mon-docs-pct');
    var countEl= document.getElementById('mon-docs-count');

    if (bar)    bar.style.width = pct + '%';
    if (pctEl)  pctEl.textContent = pct + '%';
    if (countEl) countEl.textContent = done + ' / ' + total;
  }

  document.querySelectorAll('.mon-doc-check').forEach(function(el) {
    el.addEventListener('change', recalcDocs);
  });
  recalcDocs();

  // ---- Alerte éligibilité ----
  function checkEligibilite() {
    var all = ['elig_bien_classe','elig_avant_travaux','elig_conservation','elig_droit_reel'];
    var done = all.every(function(id) {
      var el = document.getElementById(id);
      return el && el.checked;
    });
    var warn = document.getElementById('mon-elig-warning');
    var badge= document.getElementById('mon-eligibilite-status');
    if (warn) warn.classList.toggle('d-none', done);
    if (badge) {
      badge.textContent = done ? 'Éligible ✓' : 'À vérifier';
      badge.className   = done ? 'badge bg-success ms-auto' : 'badge bg-white text-primary ms-auto';
    }
  }

  ['elig_bien_classe','elig_avant_travaux','elig_conservation','elig_droit_reel'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('change', checkEligibilite);
  });
  checkEligibilite();
})();
</script>
