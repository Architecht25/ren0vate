<!-- Partial pour la section résumé -->
<div class="resume-content">

  <!-- Vue d'ensemble rapide -->
  <div class="overview-header mb-3">
    <div class="row g-2">
      <div class="col-md-6">
        <div class="d-flex align-items-center p-2 bg-success bg-opacity-10 rounded">
          <i class="bi bi-award text-success me-2"></i>
          <div>
            <div class="small fw-bold">Total estimé</div>
            <div class="fw-bold text-success">
              <%= number_to_currency((hub_data.dig(:resume, :total_amount) || 0), unit: "", precision: 0) %>€
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="d-flex align-items-center p-2 bg-primary bg-opacity-10 rounded">
          <i class="bi bi-list-check text-primary me-2"></i>
          <div>
            <div class="small fw-bold">Primes éligibles</div>
                        <div class="fw-bold text-primary"><%= (hub_data.dig(:resume, :primes) || []).count %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Liste détaillée des primes -->
  <div class="primes-list mb-3">
    <% primes_list = (hub_data.dig(:resume, :primes) || []) %>
    <% if primes_list.any? %>
      <% primes_list.each do |prime| %>
        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-2 border-start border-3 border-<%= prime[:status] == 'eligible' ? 'success' : prime[:status] == 'conditional' ? 'warning' : 'secondary' %>">
          <div class="flex-grow-1">
            <div class="fw-medium"><%= prime[:name] %></div>
            <small class="text-muted">
              <i class="bi bi-geo-alt me-1"></i>
              <%= hub_data.dig(:resume, :region) || 'Non défini' %>
              <% if prime[:slug].present? %>
                • <code class="small"><%= prime[:slug] %></code>
              <% end %>
              <% if prime[:user_input].present? && prime[:user_input].to_f > 0 %>
                • <%= prime[:user_input] %> m²
              <% end %>
              <% if prime[:status] %>
                • <span class="badge badge-sm bg-<%= prime[:status] == 'eligible' ? 'success' : prime[:status] == 'conditional' ? 'warning' : 'secondary' %>">
                  <%= prime[:status].capitalize %>
                </span>
              <% end %>
              <% if prime[:urgency] && prime[:urgency] != 'normal' && prime[:urgency] != 'low' %>
                • <span class="text-<%= prime[:urgency] == 'high' || prime[:urgency] == 'critical' ? 'danger' : 'warning' %>">
                  <i class="bi bi-<%= prime[:urgency] == 'critical' || prime[:urgency] == 'high' ? 'exclamation-triangle' : 'clock' %> me-1"></i>
                  <%= prime[:urgency].capitalize %>
                </span>
              <% end %>
            </small>
          </div>
          <div class="text-end">
            <div class="fw-bold text-<%= prime[:status] == 'eligible' ? 'success' : prime[:status] == 'conditional' ? 'warning' : 'muted' %> fs-6">
              <%= number_to_currency(prime[:amount], unit: "", precision: 0) %>€
            </div>
            <small class="text-muted">
              <i class="bi bi-tag me-1"></i>
              <%= prime[:category]&.capitalize || 'Prime' %>
            </small>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Aucune prime sélectionnée dans cette simulation.
      </div>
    <% end %>
  </div>

  <!-- Actions rapides -->
  <div class="mt-4">
    <div class="d-flex gap-2 flex-wrap">
      <button class="btn btn-outline-primary btn-sm">
        <i class="bi bi-arrow-clockwise me-1"></i>
        Recalculer
      </button>
      <button class="btn btn-outline-success btn-sm">
        <i class="bi bi-plus-circle me-1"></i>
        Ajouter prime
      </button>
      <button class="btn btn-outline-info btn-sm quick-question"
              data-question="Comment optimiser mes primes ?">
        <i class="bi bi-lightbulb me-1"></i>
        Optimiser
      </button>
    </div>
  </div>
</div>
