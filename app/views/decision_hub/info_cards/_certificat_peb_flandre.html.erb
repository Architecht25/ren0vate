<div class="card border-0 shadow-sm">
  <div class="card-header" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%); color: white;">
    <h4 class="mb-0">
      <i class="bi bi-award me-2"></i>
      Certificat PEB en Flandre : Accédez aux certificateurs agréés
    </h4>
  </div>
  <div class="card-body">
    <!-- Introduction -->
    <div class="row mb-4">
      <div class="col-lg-8">
        <h5 class="text-primary mb-3">Besoin d'un certificat PEB (EPC) en Flandre ?</h5>
        <p class="lead">
          Le <strong>certificat de performance énergétique (PEB/EPC)</strong> est obligatoire en Flandre pour
          la vente ou la location d'un bien immobilier. Il indique la performance énergétique de votre logement
          et est valable pendant 10 ans.
        </p>
      </div>
      <div class="col-lg-4">
        <div class="card bg-light">
          <div class="card-body text-center">
            <i class="bi bi-house-gear display-4 text-danger mb-3"></i>
            <h6 class="text-muted">Performance énergétique certifiée</h6>
          </div>
        </div>
      </div>
    </div>

    <!-- Qu'est-ce que le certificat PEB -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card border-primary">
          <div class="card-header bg-primary text-white">
            <h6 class="mb-0">
              <i class="bi bi-info-circle me-2"></i>
              Qu'est-ce que le certificat PEB ?
            </h6>
          </div>
          <div class="card-body">
            <p>
              Le certificat de performance énergétique (PEB), aussi appelé <strong>EPC</strong> en Flandre,
              évalue la consommation énergétique théorique de votre habitation. Il attribue une note de
              performance énergétique allant de A++ (très économe) à G (énergivore).
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Pourquoi faire appel à un certificateur agréé -->
    <div class="row mb-4">
      <div class="col-12">
        <h5 class="text-primary mb-3">Pourquoi choisir un certificateur agréé ?</h5>
        <div class="row">
          <div class="col-md-4">
            <div class="card h-100 border-0 bg-light">
              <div class="card-body text-center">
                <i class="bi bi-shield-check display-4 text-success mb-3"></i>
                <h6>Certification officielle</h6>
                <p class="small text-muted">Seuls les certificateurs agréés peuvent délivrer un PEB valide légalement</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 border-0 bg-light">
              <div class="card-body text-center">
                <i class="bi bi-mortarboard display-4 text-info mb-3"></i>
                <h6>Expertise reconnue</h6>
                <p class="small text-muted">Professionnels formés et agréés par les autorités flamandes</p>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card h-100 border-0 bg-light">
              <div class="card-body text-center">
                <i class="bi bi-clock display-4 text-warning mb-3"></i>
                <h6>Validité garantie</h6>
                <p class="small text-muted">Certificat valable 10 ans pour ventes et locations</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quand avez-vous besoin d'un certificat PEB -->
    <div class="row mb-4">
      <div class="col-12">
        <h5 class="text-primary mb-3">Quand avez-vous besoin d'un certificat PEB ?</h5>
        <div class="row">
          <div class="col-md-6 mb-3">
            <div class="card border-warning h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0">
                  <i class="bi bi-house-door me-2"></i>
                  Vente d'un bien
                </h6>
              </div>
              <div class="card-body">
                <p class="card-text">
                  Obligatoire lors de la <strong>vente</strong> de votre habitation. Le certificat doit être
                  disponible dès la mise en vente et annexé à l'acte de vente.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <div class="card border-info h-100">
              <div class="card-header bg-info text-white">
                <h6 class="mb-0">
                  <i class="bi bi-key me-2"></i>
                  Location d'un bien
                </h6>
              </div>
              <div class="card-body">
                <p class="card-text">
                  Requis pour la <strong>location</strong> de votre propriété. Le certificat doit être
                  remis au locataire avant la signature du bail.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Processus de certification -->
    <div class="row mb-4">
      <div class="col-12">
        <h5 class="text-primary mb-3">Comment se déroule la certification ?</h5>
        <div class="row">
          <div class="col-md-3 text-center mb-3">
            <div class="card border-primary h-100">
              <div class="card-body">
                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">1</div>
                <h6>Contact</h6>
                <p class="small">Contactez un certificateur agréé de votre région</p>
              </div>
            </div>
          </div>
          <div class="col-md-3 text-center mb-3">
            <div class="card border-primary h-100">
              <div class="card-body">
                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">2</div>
                <h6>Visite</h6>
                <p class="small">Le certificateur visite votre habitation pour évaluer sa performance</p>
              </div>
            </div>
          </div>
          <div class="col-md-3 text-center mb-3">
            <div class="card border-primary h-100">
              <div class="card-body">
                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">3</div>
                <h6>Analyse</h6>
                <p class="small">Calcul de la performance énergétique selon les normes officielles</p>
              </div>
            </div>
          </div>
          <div class="col-md-3 text-center mb-3">
            <div class="card border-primary h-100">
              <div class="card-body">
                <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">4</div>
                <h6>Certificat</h6>
                <p class="small">Réception de votre certificat PEB officiel</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Information sur les coûts -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="alert alert-light border-primary">
          <div class="row align-items-center">
            <div class="col-md-8">
              <h6 class="alert-heading">
                <i class="bi bi-calculator me-2"></i>
                Coût d'un certificat PEB
              </h6>
              <p class="mb-2">
                Le prix d'un certificat PEB varie généralement entre <strong>150€ et 300€</strong> selon
                la taille et la complexité de votre habitation.
              </p>
              <p class="mb-0">
                <strong>Conseil :</strong> Demandez plusieurs devis pour comparer les prix et services.
              </p>
            </div>
            <div class="col-md-4 text-center">
              <i class="bi bi-currency-euro display-4 text-primary"></i>
              <p class="text-muted mt-2">150€ - 300€</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Lien vers la liste des certificateurs agréés -->
    <div class="row">
      <div class="col-12 text-center">
        <div class="card text-white" style="background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
          <div class="card-body">
            <h5 class="card-title">
              <i class="bi bi-person-check-fill me-2"></i>
              Trouvez votre certificateur agréé en Flandre
            </h5>
            <p class="card-text mb-3">
              Consultez la liste officielle des certificateurs PEB agréés par les autorités flamandes
            </p>
            <a href="https://www.vlaanderen.be/fr/certificat-de-performance-energetique-cpe-pour-la-vente-ou-la-location-dun-logement" target="_blank" rel="noopener noreferrer" class="btn btn-light btn-lg">
              <i class="bi bi-list-ul me-2"></i>
              Liste des certificateurs agréés
              <i class="bi bi-arrow-up-right-square ms-2"></i>
            </a>
            <div class="mt-3">
              <small class="opacity-75">
                <i class="bi bi-shield-check me-1"></i>
                Liste officielle de la Région flamande
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
