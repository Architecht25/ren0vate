<div class="card border-0 shadow-sm">
  <div class="card-header bg-gradient bg-info text-white">
    <div class="d-flex align-items-center">
      <i class="bi bi-hammer fs-4 me-3"></i>
      <div>
        <h5 class="mb-0">Conseils pour bien choisir ses entrepreneurs</h5>
        <small class="opacity-75">Guide complet pour sélectionner et gérer vos prestataires</small>
      </div>
    </div>
  </div>

  <div class="card-body">
    <div class="accordion" id="entrepreneursAccordion">

      <!-- Sélection d'entrepreneurs agréés -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="selectionHeader">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#selectionCollapse">
            <i class="bi bi-shield-check text-success me-3"></i>
            <strong>1. Sélection d'entrepreneurs agréés qualifiés</strong>
          </button>
        </h2>
        <div id="selectionCollapse" class="accordion-collapse collapse show" data-bs-parent="#entrepreneursAccordion">
          <div class="accordion-body">
            <div class="row g-4">
              <div class="col-md-6">
                <h6 class="text-success mb-3">
                  <i class="bi bi-check-circle me-2"></i>Critères obligatoires
                </h6>
                <ul class="list-unstyled">
                  <li class="mb-2">
                    <i class="bi bi-shield-fill text-success me-2"></i>
                    <strong>Certification RGE valide</strong><br>
                    <small class="text-muted">Vérifiez sur france-renov.gouv.fr</small>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-building text-info me-2"></i>
                    <strong>Assurance décennale</strong><br>
                    <small class="text-muted">Demandez l'attestation en cours</small>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-geo-alt text-warning me-2"></i>
                    <strong>Proximité géographique</strong><br>
                    <small class="text-muted">Maximum 50km pour le SAV</small>
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-info mb-3">
                  <i class="bi bi-star me-2"></i>Critères de qualité
                </h6>
                <ul class="list-unstyled">
                  <li class="mb-2">
                    <i class="bi bi-clock-history text-primary me-2"></i>
                    <strong>Expérience minimum 3 ans</strong><br>
                    <small class="text-muted">Dans votre type de travaux</small>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-chat-dots text-success me-2"></i>
                    <strong>Références clients</strong><br>
                    <small class="text-muted">Demandez 3 contacts récents</small>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-award text-warning me-2"></i>
                    <strong>Labels qualité</strong><br>
                    <small class="text-muted">Qualibat, ECO Artisan...</small>
                  </li>
                </ul>
              </div>
            </div>

            <div class="alert alert-info mt-3">
              <i class="bi bi-lightbulb me-2"></i>
              <strong>Astuce :</strong> Demandez toujours 3 devis pour comparer les prix et approches techniques.
            </div>
          </div>
        </div>
      </div>

      <!-- Analyse des devis -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="devisHeader">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#devisCollapse">
            <i class="bi bi-calculator text-primary me-3"></i>
            <strong>2. Analyse et négociation des devis</strong>
          </button>
        </h2>
        <div id="devisCollapse" class="accordion-collapse collapse" data-bs-parent="#entrepreneursAccordion">
          <div class="accordion-body">
            <div class="row g-4">
              <div class="col-md-6">
                <h6 class="text-primary mb-3">
                  <i class="bi bi-list-check me-2"></i>Éléments à vérifier
                </h6>
                <div class="checklist">
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="detail1">
                    <label class="form-check-label" for="detail1">
                      Détail des matériaux (marques, références)
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="detail2">
                    <label class="form-check-label" for="detail2">
                      Main d'œuvre détaillée par poste
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="detail3">
                    <label class="form-check-label" for="detail3">
                      Délais d'intervention précis
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="detail4">
                    <label class="form-check-label" for="detail4">
                      Conditions de paiement (30% max d'acompte)
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="detail5">
                    <label class="form-check-label" for="detail5">
                      Garanties (décennale, biennale, parfait achèvement)
                    </label>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <h6 class="text-warning mb-3">
                  <i class="bi bi-exclamation-triangle me-2"></i>Points d'attention
                </h6>
                <div class="alert alert-warning">
                  <ul class="mb-0 small">
                    <li>Méfiez-vous des prix trop bas (-20% du marché)</li>
                    <li>Évitez les acomptes > 30% du montant</li>
                    <li>Refusez le démarchage à domicile</li>
                    <li>Vérifiez les délais de rétractation (14 jours)</li>
                  </ul>
                </div>

                <div class="card bg-light mt-3">
                  <div class="card-body">
                    <h6 class="card-title text-success">
                      <i class="bi bi-calculator me-2"></i>Négociation
                    </h6>
                    <p class="card-text small mb-2">
                      Arguments de négociation :
                    </p>
                    <ul class="small mb-0">
                      <li>Groupement de plusieurs travaux</li>
                      <li>Paiement comptant rapide</li>
                      <li>Accès facile au chantier</li>
                      <li>Période creuse (été/hiver)</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Suivi du chantier -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="suiviHeader">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#suiviCollapse">
            <i class="bi bi-clipboard-check text-warning me-3"></i>
            <strong>3. Suivi et contrôle des travaux</strong>
          </button>
        </h2>
        <div id="suiviCollapse" class="accordion-collapse collapse" data-bs-parent="#entrepreneursAccordion">
          <div class="accordion-body">
            <div class="row g-4">
              <div class="col-md-4">
                <div class="card h-100 border-primary">
                  <div class="card-header bg-primary text-white text-center">
                    <i class="bi bi-play-circle fs-4"></i>
                    <h6 class="mt-2 mb-0">Début chantier</h6>
                  </div>
                  <div class="card-body">
                    <ul class="list-unstyled small">
                      <li class="mb-2">
                        <i class="bi bi-check text-success me-2"></i>
                        Vérification assurances
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-check text-success me-2"></i>
                        État des lieux contradictoire
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-check text-success me-2"></i>
                        Planning détaillé validé
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-check text-success me-2"></i>
                        Stockage matériaux sécurisé
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card h-100 border-warning">
                  <div class="card-header bg-warning text-dark text-center">
                    <i class="bi bi-gear fs-4"></i>
                    <h6 class="mt-2 mb-0">Pendant travaux</h6>
                  </div>
                  <div class="card-body">
                    <ul class="list-unstyled small">
                      <li class="mb-2">
                        <i class="bi bi-camera text-info me-2"></i>
                        Photos régulières d'avancement
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-chat text-primary me-2"></i>
                        Points hebdomadaires
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-exclamation-circle text-warning me-2"></i>
                        Signalement immédiat des problèmes
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-clipboard-data text-success me-2"></i>
                        Respect des normes techniques
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card h-100 border-success">
                  <div class="card-header bg-success text-white text-center">
                    <i class="bi bi-check-circle fs-4"></i>
                    <h6 class="mt-2 mb-0">Fin chantier</h6>
                  </div>
                  <div class="card-body">
                    <ul class="list-unstyled small">
                      <li class="mb-2">
                        <i class="bi bi-search text-primary me-2"></i>
                        Réception contradictoire
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-file-text text-info me-2"></i>
                        PV de réception signé
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-shield text-success me-2"></i>
                        Garanties remises
                      </li>
                      <li class="mb-2">
                        <i class="bi bi-stars text-warning me-2"></i>
                        Nettoyage complet
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <div class="alert alert-success mt-4">
              <h6 class="alert-heading">
                <i class="bi bi-shield-check me-2"></i>Protection juridique
              </h6>
              <p class="mb-1">
                <strong>Délai de rétractation :</strong> 14 jours pour annuler sans motif<br>
                <strong>Garantie parfait achèvement :</strong> 1 an pour tous défauts<br>
                <strong>Garantie décennale :</strong> 10 ans pour la solidité
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Résolution de conflits -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="conflitsHeader">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#conflitsCollapse">
            <i class="bi bi-exclamation-triangle text-danger me-3"></i>
            <strong>4. Résolution de conflits et recours</strong>
          </button>
        </h2>
        <div id="conflitsCollapse" class="accordion-collapse collapse" data-bs-parent="#entrepreneursAccordion">
          <div class="accordion-body">
            <div class="row g-3">
              <div class="col-md-6">
                <div class="card bg-light">
                  <div class="card-body">
                    <h6 class="card-title text-warning">
                      <i class="bi bi-exclamation-circle me-2"></i>Problèmes courants
                    </h6>
                    <ul class="list-unstyled small mb-0">
                      <li class="mb-2">• Retards de livraison</li>
                      <li class="mb-2">• Malfaçons techniques</li>
                      <li class="mb-2">• Dépassement de budget</li>
                      <li class="mb-2">• Non-respect des normes</li>
                      <li class="mb-2">• Abandon de chantier</li>
                    </ul>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="card bg-light">
                  <div class="card-body">
                    <h6 class="card-title text-success">
                      <i class="bi bi-telephone me-2"></i>Contacts utiles
                    </h6>
                    <ul class="list-unstyled small mb-0">
                      <li class="mb-2"><strong>Médiateur :</strong> FFIE, CAPEB</li>
                      <li class="mb-2"><strong>Assurance :</strong> Dommages-ouvrage</li>
                      <li class="mb-2"><strong>Juridique :</strong> Tribunal d'instance</li>
                      <li class="mb-2"><strong>Technique :</strong> Expert BTP</li>
                      <li class="mb-2"><strong>DGCCRF :</strong> Pratiques commerciales</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>

            <div class="alert alert-info mt-3">
              <i class="bi bi-info-circle me-2"></i>
              <strong>Conseil :</strong> Privilégiez toujours la médiation amiable avant d'engager des procédures judiciaires.
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Actions rapides -->
    <div class="mt-4 p-3 bg-light rounded">
      <h6 class="text-muted mb-3">
        <i class="bi bi-lightning me-2"></i>Actions rapides
      </h6>
      <div class="row g-2">
        <div class="col-md-4">
          <a href="https://france-renov.gouv.fr/annuaires-professionnels" target="_blank" class="btn btn-outline-success btn-sm w-100">
            <i class="bi bi-search me-1"></i>Trouver un pro RGE
          </a>
        </div>
        <div class="col-md-4">
          <a href="https://www.qualibat.com" target="_blank" class="btn btn-outline-info btn-sm w-100">
            <i class="bi bi-award me-1"></i>Vérifier Qualibat
          </a>
        </div>
        <div class="col-md-4">
          <a href="https://www.economie.gouv.fr/dgccrf" target="_blank" class="btn btn-outline-warning btn-sm w-100">
            <i class="bi bi-shield me-1"></i>Signaler un problème
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
