<div class="card border-0 shadow-sm" data-controller="aides-entreprise">
  <div class="card-header bg-gradient bg-primary text-white">
    <div class="d-flex align-items-center">
      <i class="bi bi-people fs-4 me-3"></i>
      <div>
        <h5 class="mb-0">Aides Recrutement & Formation</h5>
        <small class="opacity-75">2 dispositifs pour développer vos ressources humaines</small>
      </div>
    </div>
  </div>

  <div class="card-body">
    <!-- Sélecteur d'aide -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card bg-light">
          <div class="card-body">
            <h6 class="card-title">
              <i class="bi bi-list-check me-2"></i>Sélectionnez une aide
            </h6>
            <select class="form-select" id="aide-rh-selector" data-aides-entreprise-target="aideSelectorRh" data-action="change->aides-entreprise#showAideDetails">
              <option value="">Choisir une aide...</option>
              <option value="prime_formation">Prime Formation</option>
              <option value="prime_recrutement">Prime Recrutement</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Détails de l'aide sélectionnée -->
    <div id="aide-details-container-rh" data-aides-entreprise-target="detailsContainerRh" style="display: none;">

      <!-- Prime Formation -->
      <div class="aide-details" data-aide="prime_formation" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-mortarboard me-2"></i>Prime Formation</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour formations du personnel et dirigeants dans le développement économique, transition économique, langues, management, gestion, marketing, technique et juridique.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux de base :</strong> 40% des dépenses</li>
                    <li><strong>Maximum :</strong> 80% avec majorations</li>
                    <li><strong>Montant minimum :</strong> 300€ par demande</li>
                    <li><strong>Montant maximum :</strong> 20 000€ par an</li>
                    <li><strong>Par formation :</strong> 5 000€ max en dépenses</li>
                    <li><strong>Formations max :</strong> 10 par an</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">👥 Bénéficiaires</h6>
                  <ul class="list-unstyled small">
                    <li>• Personnel permanent</li>
                    <li>• Dirigeants d'entreprise</li>
                    <li>• ❌ Exclus : intérimaires</li>
                    <li>• ❌ Exclus : étudiants temporaires</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-book me-2"></i>Formations éligibles</h6>
              </div>
              <div class="card-body">
                <div class="mb-3">
                  <h6 class="text-success">✅ Domaines acceptés</h6>
                  <ul class="list-unstyled small">
                    <li>• 📈 Développement économique</li>
                    <li>• 🔄 Amélioration fonctionnement</li>
                    <li>• 🌱 Transition économique</li>
                    <li>• 🗣️ Langues</li>
                    <li>• 👨‍💼 Management, gestion</li>
                    <li>• 📊 Marketing</li>
                    <li>• 🔧 Formation technique</li>
                    <li>• ⚖️ Domaine juridique</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-danger">❌ Exclusions</h6>
                  <ul class="list-unstyled small">
                    <li>• Formations sur investissement</li>
                    <li>• Formations médicales pratiques</li>
                    <li>• Formations obligatoires réglementées</li>
                    <li>• Conférences et séminaires</li>
                    <li>• Permis de conduire</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12">
            <div class="accordion" id="formationAccordion">
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#majorationsFormation">
                    <i class="bi bi-plus-circle me-2"></i><strong>Majorations possibles (jusqu'à 80%)</strong>
                  </button>
                </h2>
                <div id="majorationsFormation" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-primary">🚀 Starter (< 4 ans BCE)</h6>
                            <ul class="list-unstyled small">
                              <li>• Micro/Petite : <span class="badge bg-success">+20%</span></li>
                              <li>• Moyenne : <span class="badge bg-success">+10%</span></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-success">🌱 Exemplaire</h6>
                            <ul class="list-unstyled small">
                              <li>• Environnemental M/P : <span class="badge bg-success">+20%</span></li>
                              <li>• Environnemental Moy : <span class="badge bg-success">+10%</span></li>
                              <li>• Social M/P : <span class="badge bg-success">+20%</span></li>
                              <li>• Social Moy : <span class="badge bg-success">+10%</span></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-info">📍 Zone développement</h6>
                            <ul class="list-unstyled small">
                              <li>• Micro/Petite : <span class="badge bg-success">+20%</span></li>
                              <li>• Moyenne : <span class="badge bg-success">+10%</span></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#procedureFormation">
                    <i class="bi bi-clipboard-check me-2"></i><strong>Procédure et délais</strong>
                  </button>
                </h2>
                <div id="procedureFormation" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <h6 class="text-primary">📝 Demande</h6>
                        <ul class="list-unstyled small">
                          <li>• Via MonBEE</li>
                          <li>• Veille du début formation</li>
                          <li>• Demande séparée par formation</li>
                          <li>• Avis de réception obligatoire</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-warning">📄 Justificatifs</h6>
                        <ul class="list-unstyled small">
                          <li>• Dans 12 mois après octroi</li>
                          <li>• Factures formations</li>
                          <li>• Preuves paiement entreprise</li>
                          <li>• Attestation participation</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-success">⏱️ Durée</h6>
                        <ul class="list-unstyled small">
                          <li>• Maximum 6 mois consécutifs</li>
                          <li>• Par formation</li>
                          <li>• Planning à respecter</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#fraisFormation">
                    <i class="bi bi-currency-euro me-2"></i><strong>Frais éligibles</strong>
                  </button>
                </h2>
                <div id="fraisFormation" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <div class="card bg-success text-white">
                          <div class="card-body">
                            <h6>✅ Frais admis</h6>
                            <ul class="list-unstyled small mb-0">
                              <li>• Droits d'inscription</li>
                              <li>• Frais épreuves d'entrée</li>
                              <li>• Frais épreuves certificatives</li>
                              <li>• Supports didactiques écrits</li>
                              <li>• Supports audiovisuels</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="card bg-danger text-white">
                          <div class="card-body">
                            <h6>❌ Frais exclus</h6>
                            <ul class="list-unstyled small mb-0">
                              <li>• Logiciels</li>
                              <li>• Frais de déplacement</li>
                              <li>• Frais d'hébergement</li>
                              <li>• Repas</li>
                              <li>• Matériel informatique</li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Prime Recrutement -->
      <div class="aide-details" data-aide="prime_recrutement" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-person-plus me-2"></i>Prime Recrutement</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour encourager le recrutement de demandeurs d'emploi inscrits chez Actiris, avec accent sur les publics prioritaires.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants par profil</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Demandeur emploi standard :</strong> 3 000€</li>
                    <li><strong>Demandeur emploi prioritaire :</strong> 4 500€</li>
                    <li><strong>Très longue durée (> 2 ans) :</strong> 6 000€</li>
                    <li><strong>Personne handicapée :</strong> 7 500€</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">📋 Conditions générales</h6>
                  <ul class="list-unstyled small">
                    <li>• Contrat minimum 6 mois</li>
                    <li>• Au moins 19h/semaine</li>
                    <li>• Inscription Actiris</li>
                    <li>• Maximum 2 primes/an</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-people-fill me-2"></i>Publics prioritaires</h6>
              </div>
              <div class="card-body">
                <div class="mb-3">
                  <h6 class="text-primary">🎯 Publics prioritaires (+1500€)</h6>
                  <ul class="list-unstyled small">
                    <li>• Jeunes < 25 ans</li>
                    <li>• Seniors > 50 ans</li>
                    <li>• Familles monoparentales</li>
                    <li>• Bénéficiaires CPAS</li>
                    <li>• Peu qualifiés (≤ secondaire inf.)</li>
                    <li>• Origine étrangère UE/hors UE</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-success">⭐ Publics très prioritaires</h6>
                  <ul class="list-unstyled small">
                    <li>• Très longue durée (> 2 ans) : <span class="badge bg-success">+3000€</span></li>
                    <li>• Personnes handicapées : <span class="badge bg-success">+4500€</span></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12">
            <div class="accordion" id="recrutementAccordion">
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#conditionsRecrutement">
                    <i class="bi bi-check-circle me-2"></i><strong>Conditions détaillées</strong>
                  </button>
                </h2>
                <div id="conditionsRecrutement" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <h6 class="text-primary">📝 Contrat de travail</h6>
                        <ul class="list-unstyled small">
                          <li>• CDI ou CDD minimum 6 mois</li>
                          <li>• Temps partiel minimum 19h/semaine</li>
                          <li>• Temps plein encouragé</li>
                          <li>• Période d'essai incluse</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-warning">👤 Profil candidat</h6>
                        <ul class="list-unstyled small">
                          <li>• Inscrit chez Actiris</li>
                          <li>• Demandeur d'emploi inoccupé</li>
                          <li>• Domicilié en Région Bruxelles-Capitale</li>
                          <li>• Disponible pour le marché du travail</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-success">🏢 Entreprise</h6>
                        <ul class="list-unstyled small">
                          <li>• Siège social à Bruxelles</li>
                          <li>• Unité d'établissement active</li>
                          <li>• En ordre cotisations sociales</li>
                          <li>• Pas de licenciements collectifs</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#procedureRecrutement">
                    <i class="bi bi-clock me-2"></i><strong>Procédure et délais</strong>
                  </button>
                </h2>
                <div id="procedureRecrutement" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <h6 class="text-primary">📅 Délais demande</h6>
                        <ul class="list-unstyled small">
                          <li>• Dans les 4 mois après embauche</li>
                          <li>• Via MonBEE</li>
                          <li>• Après fin période d'essai</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-warning">📄 Documents requis</h6>
                        <ul class="list-unstyled small">
                          <li>• Contrat de travail</li>
                          <li>• Attestation Actiris</li>
                          <li>• DIMONA</li>
                          <li>• Preuves statut prioritaire</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-success">💰 Versement</h6>
                        <ul class="list-unstyled small">
                          <li>• Après 6 mois d'occupation</li>
                          <li>• En une fois</li>
                          <li>• Sur compte entreprise</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#calculRecrutement">
                    <i class="bi bi-calculator me-2"></i><strong>Exemples de calcul</strong>
                  </button>
                </h2>
                <div id="calculRecrutement" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-primary">👨‍💼 Profil standard</h6>
                            <p class="small">Demandeur d'emploi classique</p>
                            <h4 class="text-success">3 000€</h4>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-warning">👩‍🦳 Senior prioritaire</h6>
                            <p class="small">Femme > 50 ans, peu qualifiée</p>
                            <h4 class="text-warning">4 500€</h4>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-danger">♿ Personne handicapée</h6>
                            <p class="small">Reconnaissance handicap</p>
                            <h4 class="text-danger">7 500€</h4>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions rapides -->
    <div class="mt-4 p-3 bg-light rounded">
      <h6 class="text-muted mb-3">
        <i class="bi bi-lightning me-2"></i>Actions rapides
      </h6>
      <div class="row g-2">
        <div class="col-md-3">
          <a href="https://monbee.brussels.be" target="_blank" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-globe me-1"></i>MonBEE
          </a>
        </div>
        <div class="col-md-3">
          <a href="https://www.actiris.brussels" target="_blank" class="btn btn-outline-info btn-sm w-100">
            <i class="bi bi-people me-1"></i>Actiris
          </a>
        </div>
        <div class="col-md-3">
          <button type="button" class="btn btn-outline-success btn-sm w-100" data-action="click->aides-entreprise#calculerAide">
            <i class="bi bi-calculator me-1"></i>Calculer prime
          </button>
        </div>
        <div class="col-md-3">
          <button type="button" class="btn btn-outline-warning btn-sm w-100" data-action="click->aides-entreprise#rechercherFormation">
            <i class="bi bi-search me-1"></i>Chercher formation
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
