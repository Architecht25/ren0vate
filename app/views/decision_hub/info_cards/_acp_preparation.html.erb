<!-- Carte info: ACP - Préparation dépôt demande -->
<div class="card border-0 shadow-sm h-100">
  <div class="card-header bg-light border-0">
    <div class="d-flex align-items-center">
      <div class="icon-circle bg-primary bg-opacity-10 me-3">
        <i class="bi bi-building text-primary"></i>
      </div>
      <div>
        <h6 class="card-title mb-0 text-primary">🏢 ACP : Préparation dépôt de demande</h6>
        <small class="text-muted">Guide spécialisé pour les Associations de Copropriétaires</small>
      </div>
    </div>
  </div>
  <div class="card-body">
    <div class="accordion accordion-flush" id="accordionACP">

      <!-- Section Documents obligatoires ACP -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDocsACP" aria-expanded="true">
            <i class="bi bi-file-earmark-check-fill text-primary me-2"></i>
            <strong>Documents obligatoires spécifiques ACP</strong>
          </button>
        </h2>
        <div id="collapseDocsACP" class="accordion-collapse collapse show" data-bs-parent="#accordionACP">
          <div class="accordion-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-primary">📋 Documents administratifs</h6>
                <ul class="list-unstyled">
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Statuts de l'ACP</strong> à jour
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Composition du conseil de gestion</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Procès-verbal AG</strong> décidant les travaux
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Règlement de copropriété</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Pouvoir du représentant</strong> signataire
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-warning">🏠 Documents techniques</h6>
                <ul class="list-unstyled">
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Plans de l'immeuble</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Rapport énergétique</strong> (si requis)
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Permis d'urbanisme</strong> (si applicable)
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>Répartition des quotes-parts</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check-circle text-success me-2"></i>
                    <strong>État descriptif de division</strong>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Assemblée générale -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAG" aria-expanded="false">
            <i class="bi bi-people-fill text-warning me-2"></i>
            <strong>Assemblée générale et décisions</strong>
          </button>
        </h2>
        <div id="collapseAG" class="accordion-collapse collapse" data-bs-parent="#accordionACP">
          <div class="accordion-body">
            <div class="alert alert-info">
              <h6><i class="bi bi-info-circle me-2"></i>Point crucial</h6>
              <p class="mb-0">L'AG doit avoir <strong>explicitement voté</strong> la réalisation des travaux ET la demande de prime avant le début des travaux.</p>
            </div>

            <div class="row">
              <div class="col-md-6">
                <h6 class="text-primary">📝 Contenu requis du PV</h6>
                <ul class="list-unstyled small">
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Description précise des travaux
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Budget voté et approuvé
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Choix de l'entrepreneur
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Autorisation demande de prime
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Résultat du vote (pour/contre/abstentions)
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-warning">⚖️ Majorités requises</h6>
                <div class="bg-light p-3 rounded">
                  <p class="small mb-2"><strong>Travaux ordinaires :</strong> Majorité simple des présents</p>
                  <p class="small mb-2"><strong>Travaux extraordinaires :</strong> Majorité absolue (> 50% de tous les copropriétaires)</p>
                  <p class="small mb-0"><strong>Modifications importantes :</strong> Majorité des 2/3 ou 3/4 selon les cas</p>
                </div>
              </div>
            </div>

            <div class="mt-3">
              <h6 class="text-danger">⚠️ Attention particulière</h6>
              <ul class="list-unstyled small">
                <li class="mb-1">• Le PV doit être <strong>signé par le président</strong> et contresigné par le secrétaire</li>
                <li class="mb-1">• La <strong>date de l'AG</strong> doit être antérieure au début des travaux</li>
                <li class="mb-1">• Conserver la <strong>liste de présence</strong> et les <strong>procurations</strong></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Gestion financière -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFinances" aria-expanded="false">
            <i class="bi bi-calculator-fill text-success me-2"></i>
            <strong>Gestion financière et comptabilité</strong>
          </button>
        </h2>
        <div id="collapseFinances" class="accordion-collapse collapse" data-bs-parent="#accordionACP">
          <div class="accordion-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-success">💰 Documents financiers</h6>
                <ul class="list-unstyled small">
                  <li class="mb-2">
                    <i class="bi bi-check text-success me-2"></i>
                    <strong>Compte bancaire ACP</strong> distinct
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-success me-2"></i>
                    <strong>Devis détaillés</strong> des entrepreneurs
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-success me-2"></i>
                    <strong>Contrats d'entreprise</strong> signés
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-success me-2"></i>
                    <strong>Factures</strong> au nom de l'ACP
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-success me-2"></i>
                    <strong>Preuves de paiement</strong> (extraits bancaires)
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-info">📊 Répartition des coûts</h6>
                <ul class="list-unstyled small">
                  <li class="mb-2">
                    <i class="bi bi-check text-info me-2"></i>
                    Parties communes: <strong>selon quotes-parts</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-info me-2"></i>
                    Équipements communs: <strong>répartition spéciale</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-info me-2"></i>
                    Travaux mixtes: <strong>ventilation détaillée</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-info me-2"></i>
                    Prime: <strong>au prorata des contributions</strong>
                  </li>
                </ul>
              </div>
            </div>

            <div class="alert alert-warning mt-3">
              <h6><i class="bi bi-exclamation-triangle me-2"></i>Important</h6>
              <p class="mb-0">Les factures doivent être établies au nom de l'ACP, pas au nom du syndic ou d'un copropriétaire individuel.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Syndic et représentation -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSyndic" aria-expanded="false">
            <i class="bi bi-person-badge-fill text-info me-2"></i>
            <strong>Syndic et représentation légale</strong>
          </button>
        </h2>
        <div id="collapseSyndic" class="accordion-collapse collapse" data-bs-parent="#accordionACP">
          <div class="accordion-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-info">👤 Rôle du syndic</h6>
                <ul class="list-unstyled small">
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-info me-2"></i>
                    <strong>Représentant légal</strong> de l'ACP
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-info me-2"></i>
                    <strong>Signature</strong> des contrats et factures
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-info me-2"></i>
                    <strong>Suivi administratif</strong> des dossiers
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-info me-2"></i>
                    <strong>Interface</strong> avec les administrations
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-warning">📜 Documents de mandat</h6>
                <ul class="list-unstyled small">
                  <li class="mb-2">
                    <i class="bi bi-check text-warning me-2"></i>
                    <strong>Contrat de syndic</strong> en cours
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-warning me-2"></i>
                    <strong>Pouvoir spécial</strong> pour les primes
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-warning me-2"></i>
                    <strong>Délégation AG</strong> si nécessaire
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-check text-warning me-2"></i>
                    <strong>Assurance professionnelle</strong> en ordre
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Checklist finale -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCheckACP" aria-expanded="false">
            <i class="bi bi-list-check text-success me-2"></i>
            <strong>Checklist avant dépôt</strong>
          </button>
        </h2>
        <div id="collapseCheckACP" class="accordion-collapse collapse" data-bs-parent="#accordionACP">
          <div class="accordion-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-success">✅ Documents légaux</h6>
                <div class="checklist">
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="checkACP1">
                    <label class="form-check-label small" for="checkACP1">
                      Statuts ACP à jour et conformes
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="checkACP2">
                    <label class="form-check-label small" for="checkACP2">
                      PV AG avec vote favorable documenté
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="checkACP3">
                    <label class="form-check-label small" for="checkACP3">
                      Composition conseil de gestion actuelle
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="checkACP4">
                    <label class="form-check-label small" for="checkACP4">
                      Pouvoir syndic valide et en cours
                    </label>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <h6 class="text-primary">📋 Documents techniques</h6>
                <div class="checklist">
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="checkACP5">
                    <label class="form-check-label small" for="checkACP5">
                      Devis détaillés et contrats signés
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="checkACP6">
                    <label class="form-check-label small" for="checkACP6">
                      Factures au nom de l'ACP uniquement
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="checkACP7">
                    <label class="form-check-label small" for="checkACP7">
                      Preuves de paiement depuis compte ACP
                    </label>
                  </div>
                  <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="checkACP8">
                    <label class="form-check-label small" for="checkACP8">
                      Plans et permis (si requis) en ordre
                    </label>
                  </div>
                </div>
              </div>
            </div>

            <div class="alert alert-success mt-3">
              <h6><i class="bi bi-check-circle me-2"></i>Conseil final</h6>
              <p class="mb-2">Avant le dépôt, vérifiez que tous les documents sont :</p>
              <ul class="mb-0">
                <li><strong>Lisibles</strong> et de bonne qualité</li>
                <li><strong>Datés et signés</strong> selon les règles</li>
                <li><strong>Cohérents</strong> entre eux (dates, montants, descriptions)</li>
                <li><strong>Complets</strong> selon la liste fournie par l'administration</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-footer bg-light border-0">
    <div class="d-flex justify-content-between align-items-center">
      <small class="text-muted">
        <i class="bi bi-building me-1"></i>
        Guide spécialement adapté aux spécificités ACP
      </small>
      <div>
        <button class="btn btn-outline-primary btn-sm me-2" data-bs-toggle="modal" data-bs-target="#modalACPExample">
          <i class="bi bi-eye me-1"></i>Exemple PV
        </button>
        <button class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#modalACPTimeline">
          <i class="bi bi-calendar me-1"></i>Timeline
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal exemple PV ACP -->
<div class="modal fade" id="modalACPExample" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-file-text me-2"></i>Exemple de PV d'AG pour travaux
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="bg-light p-3 rounded">
          <h6 class="text-center">PROCÈS-VERBAL D'ASSEMBLÉE GÉNÉRALE</h6>
          <p class="text-center small mb-3">Association des Copropriétaires "Résidence Belle Vue"</p>

          <p><strong>Date :</strong> 15 mars 2024<br>
          <strong>Lieu :</strong> Hall d'entrée de l'immeuble<br>
          <strong>Président de séance :</strong> M. Jean Dupont</p>

          <p><strong>POINT 3 : Travaux d'isolation de toiture</strong></p>

          <p class="small">Le président expose que suite à l'audit énergétique réalisé en janvier 2024, des travaux d'isolation de toiture sont nécessaires pour améliorer les performances énergétiques de l'immeuble.</p>

          <p class="small"><strong>Descriptif des travaux :</strong><br>
          - Isolation de la toiture par l'extérieur (sarking)<br>
          - Surface : 250 m²<br>
          - Épaisseur isolant : 16 cm<br>
          - Entreprise retenue : ISOLATION PRO SPRL</p>

          <p class="small"><strong>Budget :</strong><br>
          - Montant des travaux : 45.000 € TVAC<br>
          - Prime estimée Bruxelles Environnement : 12.000 €<br>
          - Coût net pour les copropriétaires : 33.000 €</p>

          <p class="small"><strong>Financement :</strong> Répartition selon quotes-parts générales</p>

          <p class="small"><strong>Vote :</strong><br>
          POUR : 18 voix (72%)<br>
          CONTRE : 3 voix (12%)<br>
          ABSTENTIONS : 4 voix (16%)</p>

          <p class="small"><strong>DÉCISION :</strong> La proposition est <strong>ADOPTÉE</strong> à la majorité requise.</p>

          <p class="small">L'assemblée autorise expressément le syndic à :<br>
          - Signer le contrat d'entreprise<br>
          - Introduire la demande de prime auprès de Bruxelles Environnement<br>
          - Effectuer tous actes nécessaires à la réalisation du projet</p>

          <div class="mt-3 text-end">
            <p class="small mb-1">Le Président,</p>
            <p class="small mb-1"><strong>Jean Dupont</strong></p>
            <p class="small">Le Secrétaire,</p>
            <p class="small"><strong>Marie Martin</strong></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal timeline ACP -->
<div class="modal fade" id="modalACPTimeline" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-calendar me-2"></i>Timeline type pour un projet ACP
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="timeline">
          <div class="timeline-item">
            <div class="timeline-marker bg-primary"></div>
            <div class="timeline-content">
              <h6>Phase 1 : Préparation (1-2 mois)</h6>
              <ul class="small">
                <li>Audit énergétique ou diagnostic technique</li>
                <li>Demande de devis à plusieurs entreprises</li>
                <li>Préparation dossier pour AG</li>
              </ul>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-marker bg-warning"></div>
            <div class="timeline-content">
              <h6>Phase 2 : Assemblée générale</h6>
              <ul class="small">
                <li>Convocation AG (3 semaines minimum avant)</li>
                <li>Présentation projet et budgets</li>
                <li>Vote et adoption des travaux</li>
                <li><strong>⚠️ OBLIGATOIRE avant début travaux</strong></li>
              </ul>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-marker bg-info"></div>
            <div class="timeline-content">
              <h6>Phase 3 : Lancement (2-4 semaines)</h6>
              <ul class="small">
                <li>Signature contrats d'entreprise</li>
                <li>Demandes permis si nécessaire</li>
                <li>Constitution dossier de prime</li>
                <li><strong>Dépôt demande de prime AVANT travaux</strong></li>
              </ul>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-marker bg-success"></div>
            <div class="timeline-content">
              <h6>Phase 4 : Réalisation (durée variable)</h6>
              <ul class="small">
                <li>Début des travaux</li>
                <li>Suivi et contrôle qualité</li>
                <li>Réception provisoire</li>
                <li>Facture de solde</li>
              </ul>
            </div>
          </div>

          <div class="timeline-item">
            <div class="timeline-marker bg-danger"></div>
            <div class="timeline-content">
              <h6>Phase 5 : Finalisation (max 12 mois)</h6>
              <ul class="small">
                <li>Contrôle final administration</li>
                <li>Dépôt factures et justificatifs</li>
                <li><strong>🚨 DÉLAI CRITIQUE : 12 mois après facture de solde</strong></li>
                <li>Liquidation de la prime</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

