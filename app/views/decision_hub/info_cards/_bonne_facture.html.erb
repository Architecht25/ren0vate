<!-- Carte info: Comment avoir une bonne facture -->
<div class="card border-0 shadow-sm h-100">
  <div class="card-header bg-light border-0">
    <div class="d-flex align-items-center">
      <div class="icon-circle bg-success bg-opacity-10 me-3">
        <i class="bi bi-receipt text-success"></i>
      </div>
      <div>
        <h6 class="card-title mb-0 text-success">📋 Comment avoir une bonne facture</h6>
        <small class="text-muted">Conseils pour optimiser vos factures de travaux</small>
      </div>
    </div>
  </div>
  <div class="card-body">
    <div class="accordion accordion-flush" id="accordionFacture">

      <!-- Section Informations obligatoires -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInfos" aria-expanded="false">
            <i class="bi bi-check-circle-fill text-success me-2"></i>
            <strong>Informations obligatoires</strong>
          </button>
        </h2>
        <div id="collapseInfos" class="accordion-collapse collapse" data-bs-parent="#accordionFacture">
          <div class="accordion-body">
            <ul class="list-unstyled">
              <li class="mb-2">
                <i class="bi bi-check text-success me-2"></i>
                <strong>Nom et prénom</strong> du ou des demandeurs
              </li>
              <li class="mb-2">
                <i class="bi bi-check text-success me-2"></i>
                <strong>Adresse du chantier</strong>
              </li>
              <li class="mb-2">
                <i class="bi bi-check text-success me-2"></i>
                <strong>Numéro de facture</strong> unique et séquentiel
              </li>
              <li class="mb-2">
                <i class="bi bi-check text-success me-2"></i>
                <strong>Date d'émission</strong> claire et lisible
              </li>
              <li class="mb-2">
                <i class="bi bi-check text-success me-2"></i>
                <strong>Montant total TTC</strong> en euros
              </li>
              <li class="mb-2">
                <i class="bi bi-check text-success me-2"></i>
                <strong>Détail TVA</strong> (taux et montant)
              </li>
              <li class="mb-2">
                <i class="bi bi-check text-success me-2"></i>
                <strong>Données entreprise</strong> : nom, adresse, n° BCE, n° TVA
              </li>
              <li class="mb-2">
                <i class="bi bi-check text-success me-2"></i>
                <strong>Description des travaux</strong> détaillée en lien avec les primes, si le devis ne détaille pas assez les prestations
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Section Bonnes pratiques -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePratiques" aria-expanded="false">
            <i class="bi bi-lightbulb-fill text-warning me-2"></i>
            <strong>Bonnes pratiques</strong>
          </button>
        </h2>
        <div id="collapsePratiques" class="accordion-collapse collapse" data-bs-parent="#accordionFacture">
          <div class="accordion-body">
            <div class="row">
              <div class="col-md-6">
                <h6 class="text-primary">💡 Conseils généraux</h6>
                <ul class="list-unstyled small">
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Demandez un <strong>devis détaillé</strong> avant travaux
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Vérifiez la <strong>correspondance devis/facture</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Conservez <strong>toutes les factures</strong> (acomptes inclus)
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-primary me-2"></i>
                    Numérotez et datez vos documents
                  </li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-info">📄 Format recommandé</h6>
                <ul class="list-unstyled small">
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-info me-2"></i>
                    Privilégiez le <strong>format PDF</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-info me-2"></i>
                    Qualité de scan <strong>minimum 300 DPI</strong>
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-info me-2"></i>
                    Évitez les photos floues ou inclinées
                  </li>
                  <li class="mb-2">
                    <i class="bi bi-arrow-right text-info me-2"></i>
                    Une facture = un fichier
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Délais critiques -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDelais" aria-expanded="false">
            <i class="bi bi-clock-fill text-danger me-2"></i>
            <strong>Délais et échéances</strong>
          </button>
        </h2>
        <div id="collapseDelais" class="accordion-collapse collapse" data-bs-parent="#accordionFacture">
          <div class="accordion-body">
            <div class="alert alert-warning">
              <h6><i class="bi bi-exclamation-triangle me-2"></i>Délais d'introduction des demandes</h6>
              <p class="mb-2">Les délais pour introduire votre demande de prime varient selon la région :</p>
              <div class="row">
                <div class="col-md-4">
                  <div class="small bg-primary bg-opacity-10 p-2 rounded mb-2">
                    <strong>🌍 Wallonie</strong><br>
                    <span class="text-primary fw-bold">8 mois</span> après la facture de solde
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="small bg-warning bg-opacity-10 p-2 rounded mb-2">
                    <strong>🏛️ Bruxelles</strong><br>
                    <span class="text-warning fw-bold">12 mois</span> après la facture de solde
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="small bg-info bg-opacity-10 p-2 rounded mb-2">
                    <strong>🦁 Flandre</strong><br>
                    <span class="text-info fw-bold">2 ans à date de la facture d'acompte
                  </div>
                </div>
              </div>
              <small class="text-danger fw-bold">⚠️ Ces délais sont stricts et aucune dérogation n'est accordée après expiration.</small>
            </div>

            <div class="row">
              <div class="col-md-6">
                <h6 class="text-success">✅ À faire rapidement</h6>
                <ul class="list-unstyled small">
                  <li>📅 Noter la date de fin des travaux</li>
                  <li>🧾 Réclamer la facture de solde immédiatement</li>
                  <li>📊 Utiliser notre outil de suivi des délais</li>
                  <li>🔔 Activer les notifications de rappel</li>
                </ul>
              </div>
              <div class="col-md-6">
                <h6 class="text-danger">❌ À éviter absolument</h6>
                <ul class="list-unstyled small">
                  <li>⏰ Attendre la dernière minute</li>
                  <li>📄 Perdre des factures importantes</li>
                  <li>🤝 Accepter des factures incomplètes</li>
                  <li>📞 Ne pas vérifier les coordonnées</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Section Vérifications -->
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseVerif" aria-expanded="false">
            <i class="bi bi-search text-info me-2"></i>
            <strong>Vérifications avant envoi</strong>
          </button>
        </h2>
        <div id="collapseVerif" class="accordion-collapse collapse" data-bs-parent="#accordionFacture">
          <div class="accordion-body">
            <div class="checklist">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="check1">
                <label class="form-check-label small" for="check1">
                  Total des factures = montant du devis (ou écart justifié)
                </label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="check2">
                <label class="form-check-label small" for="check2">
                  Toutes les factures sont lisibles et complètes
                </label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="check3">
                <label class="form-check-label small" for="check3">
                  L'entreprise est agréée pour les travaux effectués
                </label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="check4">
                <label class="form-check-label small" for="check4">
                  Les dates de facturation sont cohérentes
                </label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="check5">
                <label class="form-check-label small" for="check5">
                  La facture de solde est clairement identifiée
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card-footer bg-light border-0">
    <div class="d-flex justify-content-between align-items-center">
      <small class="text-muted">
        <i class="bi bi-info-circle me-1"></i>
        Ces conseils augmentent vos chances d'acceptation
      </small>
      <button class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalFactureExample">
        <i class="bi bi-eye me-1"></i>Voir exemple
      </button>
    </div>
  </div>
</div>

<!-- Modal exemple de facture -->
