  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-receipt me-2"></i>Exemple de bonne facture
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info">
          <h6>📋 Structure recommandée d'une facture de travaux</h6>
          <p class="mb-0">Voici les éléments essentiels à vérifier sur vos factures :</p>
        </div>

        <div class="row">
          <div class="col-md-6">
            <h6 class="text-primary">En-tête entreprise</h6>
            <div class="bg-light p-3 rounded mb-3">
              <strong>ENTREPRISE RENOVATION SPRL</strong><br>
              Rue des Artisans, 123<br>
              1000 Bruxelles<br>
              BCE: 0123.456.789<br>
              TVA: BE0123456789<br>
              Tel: 02/123.45.67
            </div>
          </div>
          <div class="col-md-6">
            <h6 class="text-primary">Informations facture</h6>
            <div class="bg-light p-3 rounded mb-3">
              <strong>FACTURE N° 2024-0156</strong><br>
              Date: 15/09/2024<br>
              Client: M. et Mme Dupont<br>
              Adresse chantier: Rue de la Paix, 45<br>
              1050 Ixelles
            </div>
          </div>
        </div>

        <h6 class="text-primary">Détail des prestations</h6>
        <div class="table-responsive mb-3">
          <table class="table table-sm table-striped">
            <thead>
              <tr>
                <th>Description</th>
                <th>Quantité</th>
                <th>Prix unit.</th>
                <th>Total HT</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Isolation toiture - 150m²</td>
                <td>150</td>
                <td>25,00 €</td>
                <td>3.750,00 €</td>
              </tr>
              <tr>
                <td>Main d'œuvre pose isolation</td>
                <td>1</td>
                <td>1.200,00 €</td>
                <td>1.200,00 €</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="row">
          <div class="col-md-6">
            <h6 class="text-primary">Totaux</h6>
            <div class="bg-light p-3 rounded">
              Total HT: 4.950,00 €<br>
              TVA 6%: 297,00 €<br>
              <strong>Total TTC: 5.247,00 €</strong>
            </div>
          </div>
          <div class="col-md-6">
            <h6 class="text-primary">Mentions importantes</h6>
            <div class="bg-light p-3 rounded">
              <small>
                ✓ Travaux d'isolation éligibles au taux TVA réduit 6%<br>
                ✓ Facture de solde pour travaux terminés<br>
                ✓ Délai de paiement: 30 jours
              </small>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <small class="text-muted me-auto">Cette facture contient tous les éléments nécessaires pour une demande de prime</small>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

<style>
.icon-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checklist .form-check-input:checked {
  background-color: #198754;
  border-color: #198754;
}

.accordion-button {
  font-size: 0.9rem;
  padding: 0.75rem 1rem;
}

.accordion-button:not(.collapsed) {
  background-color: rgba(var(--bs-success-rgb), 0.1);
  color: var(--bs-success);
}
</style>
