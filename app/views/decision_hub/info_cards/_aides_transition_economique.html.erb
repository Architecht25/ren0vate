<div class="card border-0 shadow-sm" data-controller="aides-entreprise">
  <div class="card-header bg-gradient bg-success text-white">
    <div class="d-flex align-items-center">
      <i class="bi bi-recycle fs-4 me-3"></i>
      <div>
        <h5 class="mb-0">Aides Transition Économique & Mobilité</h5>
        <small class="opacity-75">5 dispositifs pour la transition durable de votre entreprise</small>
      </div>
    </div>
  </div>

  <div class="card-body">
    <!-- Sélecteur d'aide -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card bg-light">
          <div class="card-body">
            <h6 class="card-title">
              <i class="bi bi-list-check me-2"></i>Sélectionnez une aide
            </h6>
            <select class="form-select" id="aide-transition-selector" data-aides-entreprise-target="aideSelectorTransition" data-action="change->aides-entreprise#showAideDetails">
              <option value="">Choisir une aide...</option>
              <option value="transition_consultance">Prime Transition Consultance</option>
              <option value="investissements_transition">Investissements Transition Économique</option>
              <option value="mobilite_velo_cargo">Mobilité Vélo Cargo</option>
              <option value="mobilite_utilitaire_electrique">Mobilité Utilitaire Électrique</option>
              <option value="mobilite_utilitaire_retrofit">Mobilité Utilitaire Retrofit</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Détails de l'aide sélectionnée -->
    <div id="aide-details-container-transition" data-aides-entreprise-target="detailsContainerTransition" style="display: none;">

      <!-- Prime Transition Consultance -->
      <div class="aide-details" data-aide="transition_consultance" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informations générales</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour financer des missions de consultance en transition économique dans les domaines environnemental, social et de gouvernance participative.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux de base :</strong> 50% des dépenses</li>
                    <li><strong>Maximum :</strong> 80% avec majorations</li>
                    <li><strong>Montant minimum :</strong> 500€ par mission</li>
                    <li><strong>Montant maximum :</strong> 15 000€ par an</li>
                    <li><strong>Missions maximum :</strong> 3 par an</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">🏢 Entreprises éligibles</h6>
                  <ul class="list-unstyled small">
                    <li>• PME avec siège en Région Bruxelles-Capitale</li>
                    <li>• TPE et PME uniquement</li>
                    <li>• Maximum 75% de financement public</li>
                    <li>• Maximum 300 000€ d'aides de minimis sur 3 ans</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-clipboard-check me-2"></i>Conditions & Procédures</h6>
              </div>
              <div class="card-body">
                <div class="mb-3">
                  <h6 class="text-primary">🎯 Domaines éligibles</h6>
                  <ul class="list-unstyled small">
                    <li>• Plan de diversité</li>
                    <li>• Gouvernance participative</li>
                    <li>• Bien-être au travail</li>
                    <li>• Stratégie environnementale/sociale</li>
                    <li>• Outils de mesure d'impact</li>
                    <li>• Audit label ou énergétique</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-danger">⏰ Délais importants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Demande :</strong> Veille du début de mission</li>
                    <li><strong>Décision :</strong> 4 mois maximum</li>
                    <li><strong>Début mission :</strong> Lendemain demande min.</li>
                    <li><strong>Durée mission :</strong> 6 mois maximum</li>
                    <li><strong>Justificatifs :</strong> 15 mois après octroi</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12">
            <div class="accordion" id="transitionConsultanceAccordion">
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#documentsTransitionConsultance">
                    <i class="bi bi-file-earmark-text me-2"></i><strong>Documents requis</strong>
                  </button>
                </h2>
                <div id="documentsTransitionConsultance" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <h6 class="text-primary">📄 Demande consultance</h6>
                        <ul class="list-unstyled small">
                          <li>• Demande via MonBEE</li>
                          <li>• Annexes spécifiques</li>
                          <li>• Devis détaillé consultant</li>
                          <li>• CV et références consultant</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-warning">🏷️ Demande label</h6>
                        <ul class="list-unstyled small">
                          <li>• Demande via MonBEE</li>
                          <li>• Annexes spécifiques labels</li>
                          <li>• Documentation sur le label</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-success">✅ Justificatifs</h6>
                        <ul class="list-unstyled small">
                          <li>• Factures acquittées</li>
                          <li>• Rapport final de mission</li>
                          <li>• Preuves mise en œuvre</li>
                          <li>• Déclaration de créance</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#majorationsTransitionConsultance">
                    <i class="bi bi-plus-circle me-2"></i><strong>Majorations possibles</strong>
                  </button>
                </h2>
                <div id="majorationsTransitionConsultance" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-6">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-primary">🚀 Entreprises Starter</h6>
                            <ul class="list-unstyled small">
                              <li>• Micro-entreprises : <span class="badge bg-success">+15%</span></li>
                              <li>• Petites entreprises : <span class="badge bg-success">+10%</span></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-6">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-success">🌱 Entreprises exemplaires</h6>
                            <ul class="list-unstyled small">
                              <li>• Environnemental micro : <span class="badge bg-success">+15%</span></li>
                              <li>• Environnemental petite : <span class="badge bg-success">+10%</span></li>
                              <li>• Social micro : <span class="badge bg-success">+15%</span></li>
                              <li>• Social petite : <span class="badge bg-success">+10%</span></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Investissements Transition -->
      <div class="aide-details" data-aide="investissements_transition" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informations générales</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour investissements dans la transition économique (équipements économes en énergie, technologies propres, etc.).</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux de base :</strong> 10% des investissements</li>
                    <li><strong>Maximum :</strong> 40% avec majorations</li>
                    <li><strong>Montant minimum :</strong> 5 000€ HTVA</li>
                    <li><strong>Montant maximum :</strong> 500 000€ par an</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">🏢 Entreprises éligibles</h6>
                  <ul class="list-unstyled small">
                    <li>• PME en Région Bruxelles-Capitale</li>
                    <li>• TPE, PME et moyennes entreprises</li>
                    <li>• Engagement maintien activité 5 ans</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Investissements éligibles</h6>
              </div>
              <div class="card-body">
                <ul class="list-unstyled small">
                  <li>• 🔋 Équipements économes en énergie</li>
                  <li>• ♻️ Technologies de recyclage</li>
                  <li>• 🌱 Équipements environnementaux</li>
                  <li>• 💡 Technologies propres</li>
                  <li>• 📊 Outils de mesure d'impact</li>
                  <li>• 🏗️ Aménagements durables</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobilité Vélo Cargo -->
      <div class="aide-details" data-aide="mobilite_velo_cargo" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-bicycle me-2"></i>Vélo Cargo</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour l'achat de vélos cargo destinés aux activités professionnelles.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux :</strong> 30% du prix d'achat</li>
                    <li><strong>Maximum :</strong> 2 500€ par vélo</li>
                    <li><strong>Limite :</strong> 3 vélos par entreprise</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">🚲 Types éligibles</h6>
                  <ul class="list-unstyled small">
                    <li>• Vélos cargo biporteurs</li>
                    <li>• Vélos cargo triporteurs</li>
                    <li>• Vélos cargo à assistance électrique</li>
                    <li>• Remorques pour vélos</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-check-square me-2"></i>Conditions</h6>
              </div>
              <div class="card-body">
                <ul class="list-unstyled small">
                  <li>• 📍 Usage professionnel exclusif</li>
                  <li>• 🏢 Entreprise domiciliée à Bruxelles</li>
                  <li>• 📋 Facture et preuve d'achat</li>
                  <li>• 🔒 Engagement usage 3 ans minimum</li>
                  <li>• 🛡️ Assurance obligatoire</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobilité Utilitaire Électrique -->
      <div class="aide-details" data-aide="mobilite_utilitaire_electrique" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-truck me-2"></i>Utilitaire Électrique</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour l'achat de véhicules utilitaires électriques.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux :</strong> 20% du prix d'achat</li>
                    <li><strong>Maximum :</strong> 15 000€ par véhicule</li>
                    <li><strong>Limite :</strong> 5 véhicules par entreprise</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">🚐 Véhicules éligibles</h6>
                  <ul class="list-unstyled small">
                    <li>• Camionnettes électriques</li>
                    <li>• Fourgons électriques</li>
                    <li>• Véhicules utilitaires légers</li>
                    <li>• PTAC ≤ 3,5 tonnes</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-battery-charging me-2"></i>Spécifications</h6>
              </div>
              <div class="card-body">
                <ul class="list-unstyled small">
                  <li>• ⚡ 100% électrique (pas hybride)</li>
                  <li>• 🆕 Véhicule neuf uniquement</li>
                  <li>• 📋 Homologation européenne</li>
                  <li>• 🔋 Batterie minimum 40 kWh</li>
                  <li>• 🏢 Immatriculation entreprise</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobilité Utilitaire Retrofit -->
      <div class="aide-details" data-aide="mobilite_utilitaire_retrofit" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Retrofit Électrique</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour la conversion électrique (retrofit) de véhicules utilitaires existants.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux :</strong> 30% du coût conversion</li>
                    <li><strong>Maximum :</strong> 12 000€ par véhicule</li>
                    <li><strong>Limite :</strong> 3 véhicules par entreprise</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">🔧 Conversion éligible</h6>
                  <ul class="list-unstyled small">
                    <li>• Remplacement moteur thermique</li>
                    <li>• Installation système électrique</li>
                    <li>• Batteries de traction</li>
                    <li>• Système de recharge</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-tools me-2"></i>Conditions techniques</h6>
              </div>
              <div class="card-body">
                <ul class="list-unstyled small">
                  <li>• 🏭 Installateur agréé obligatoire</li>
                  <li>• 📜 Certification conversion</li>
                  <li>• 🚐 Véhicule < 10 ans</li>
                  <li>• 📊 Contrôle technique validé</li>
                  <li>• 🛡️ Garantie minimum 2 ans</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions rapides -->
    <div class="mt-4 p-3 bg-light rounded">
      <h6 class="text-muted mb-3">
        <i class="bi bi-lightning me-2"></i>Actions rapides
      </h6>
      <div class="row g-2">
        <div class="col-md-3">
          <a href="https://monbee.brussels.be" target="_blank" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-globe me-1"></i>MonBEE
          </a>
        </div>
        <div class="col-md-3">
          <a href="https://economie-emploi.brussels/aides-entreprises" target="_blank" class="btn btn-outline-info btn-sm w-100">
            <i class="bi bi-info-circle me-1"></i>Guide complet
          </a>
        </div>
        <div class="col-md-3">
          <button type="button" class="btn btn-outline-success btn-sm w-100" data-action="click->aides-entreprise#calculerAide">
            <i class="bi bi-calculator me-1"></i>Calculer aide
          </button>
        </div>
        <div class="col-md-3">
          <button type="button" class="btn btn-outline-warning btn-sm w-100" data-action="click->aides-entreprise#telechargerGuide">
            <i class="bi bi-download me-1"></i>Télécharger guide
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
