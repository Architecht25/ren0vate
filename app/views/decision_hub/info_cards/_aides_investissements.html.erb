<div class="card border-0 shadow-sm" data-controller="aides-entreprise">
  <div class="card-header bg-gradient bg-info text-white">
    <div class="d-flex align-items-center">
      <i class="bi bi-building fs-4 me-3"></i>
      <div>
        <h5 class="mb-0">Aides aux Investissements</h5>
        <small class="opacity-75">5 dispositifs pour vos projets d'investissement</small>
      </div>
    </div>
  </div>

  <div class="card-body">
    <!-- Sélecteur d'aide -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card bg-light">
          <div class="card-body">
            <h6 class="card-title">
              <i class="bi bi-list-check me-2"></i>Sélectionnez une aide
            </h6>
            <select class="form-select" id="aide-investissement-selector" data-aides-entreprise-target="aideSelectorInvestissement" data-action="change->aides-entreprise#showAideDetails">
              <option value="">Choisir une aide...</option>
              <option value="prime_materiel_travaux">Prime Matériel ou Travaux</option>
              <option value="prime_immobilier">Prime Immobilier</option>
              <option value="prime_conformite_normes">Prime Conformité aux Normes</option>
              <option value="prime_securisation">Prime Sécurisation</option>
              <option value="prime_accessibilite">Prime Accessibilité</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- Détails de l'aide sélectionnée -->
    <div id="aide-details-container-investissement" data-aides-entreprise-target="detailsContainerInvestissement" style="display: none;">

      <!-- Prime Matériel ou Travaux -->
      <div class="aide-details" data-aide="prime_materiel_travaux" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informations générales</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour investissements matériels ou travaux visant la création, extension, diversification ou changement fondamental du processus de production.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants par taille</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Micro/Petite :</strong> 5% des investissements</li>
                    <li><strong>Moyenne :</strong> 2,5% des investissements</li>
                    <li><strong>Maximum hors zone :</strong> 350 000€ HTVA/an</li>
                    <li><strong>Maximum zone dev. :</strong> 500 000€ HTVA/an</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">📊 Montants minimum</h6>
                  <ul class="list-unstyled small">
                    <li>• Starter < 4 ans : 5 000€ HTVA</li>
                    <li>• Micro > 4 ans : 7 500€ HTVA</li>
                    <li>• Petite > 4 ans : 15 000€ HTVA</li>
                    <li>• Moyenne > 4 ans : 50 000€ HTVA</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Investissements éligibles</h6>
              </div>
              <div class="card-body">
                <div class="mb-3">
                  <h6 class="text-primary">🎯 Objectifs</h6>
                  <ul class="list-unstyled small">
                    <li>• Création d'établissement</li>
                    <li>• Extension d'établissement</li>
                    <li>• Diversification produits</li>
                    <li>• Changement processus production</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-success">✅ Conditions</h6>
                  <ul class="list-unstyled small">
                    <li>• Propriété de l'entreprise</li>
                    <li>• Exploitation à Bruxelles</li>
                    <li>• Conformité urbanisme/environnement</li>
                    <li>• Engagement maintien 5 ans</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-12">
            <div class="accordion" id="materielTravauxAccordion">
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#majorationsMaterielTravaux">
                    <i class="bi bi-plus-circle me-2"></i><strong>Majorations possibles (jusqu'à 30%)</strong>
                  </button>
                </h2>
                <div id="majorationsMaterielTravaux" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-primary">🚀 Starter</h6>
                            <ul class="list-unstyled small">
                              <li>• Micro/Petite : <span class="badge bg-success">+10%</span></li>
                              <li>• Moyenne : <span class="badge bg-success">+2,5%</span></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-success">🌱 Exemplaire</h6>
                            <ul class="list-unstyled small">
                              <li>• Environnemental M/P : <span class="badge bg-success">+10%</span></li>
                              <li>• Environnemental Moy : <span class="badge bg-success">+5%</span></li>
                              <li>• Social M/P : <span class="badge bg-success">+10%</span></li>
                              <li>• Social Moy : <span class="badge bg-success">+5%</span></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="card bg-light">
                          <div class="card-body">
                            <h6 class="text-info">📍 Zone développement</h6>
                            <ul class="list-unstyled small">
                              <li>• Micro/Petite : <span class="badge bg-success">+5%</span></li>
                              <li>• Moyenne : <span class="badge bg-success">+2,5%</span></li>
                            </ul>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#procedureMaterielTravaux">
                    <i class="bi bi-clipboard-check me-2"></i><strong>Procédure et délais</strong>
                  </button>
                </h2>
                <div id="procedureMaterielTravaux" class="accordion-collapse collapse">
                  <div class="accordion-body">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <h6 class="text-primary">📝 Autorisation préalable</h6>
                        <ul class="list-unstyled small">
                          <li>• Demande via MonBEE</li>
                          <li>• AVANT début investissement</li>
                          <li>• Justificatifs éligibilité</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-warning">✅ Demande définitive</h6>
                        <ul class="list-unstyled small">
                          <li>• Dans les 12 mois après autorisation</li>
                          <li>• Toutes factures acquittées</li>
                          <li>• Preuves réalisation programme</li>
                        </ul>
                      </div>
                      <div class="col-md-4">
                        <h6 class="text-success">💰 Versement</h6>
                        <ul class="list-unstyled small">
                          <li>• Déclaration de créance</li>
                          <li>• Après décision d'octroi</li>
                          <li>• Contrôle sur place possible</li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Prime Immobilier -->
      <div class="aide-details" data-aide="prime_immobilier" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-house me-2"></i>Prime Immobilier</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour l'acquisition ou la construction de bâtiments à usage professionnel en Région Bruxelles-Capitale.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux de base :</strong> 5% de l'investissement</li>
                    <li><strong>Maximum :</strong> 25% avec majorations</li>
                    <li><strong>Plafond :</strong> 1 000 000€</li>
                    <li><strong>Minimum :</strong> 100 000€ HTVA</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">🏢 Types de projets</h6>
                  <ul class="list-unstyled small">
                    <li>• Acquisition de bâtiments</li>
                    <li>• Construction neuve</li>
                    <li>• Rénovation lourde</li>
                    <li>• Aménagements intérieurs</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-check-square me-2"></i>Conditions spécifiques</h6>
              </div>
              <div class="card-body">
                <ul class="list-unstyled small">
                  <li>• 📍 Localisation en Région Bruxelles-Capitale</li>
                  <li>• 🏢 Usage professionnel exclusif</li>
                  <li>• 📋 Permis d'urbanisme en ordre</li>
                  <li>• 🔒 Engagement occupation 10 ans</li>
                  <li>• 📊 Étude de marché pour > 500k€</li>
                  <li>• 🌱 Respect normes environnementales</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Prime Conformité aux Normes -->
      <div class="aide-details" data-aide="prime_conformite_normes" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-shield-check me-2"></i>Conformité aux Normes</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour investissements nécessaires à la mise en conformité avec les normes légales, réglementaires ou techniques.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux :</strong> 15% des investissements</li>
                    <li><strong>Maximum :</strong> 35% avec majorations</li>
                    <li><strong>Plafond :</strong> 100 000€ par an</li>
                    <li><strong>Minimum :</strong> 2 500€ HTVA</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">📋 Types de normes</h6>
                  <ul class="list-unstyled small">
                    <li>• Normes de sécurité</li>
                    <li>• Normes environnementales</li>
                    <li>• Normes sanitaires</li>
                    <li>• Normes techniques sectorielles</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Obligations</h6>
              </div>
              <div class="card-body">
                <ul class="list-unstyled small">
                  <li>• 📜 Mise en demeure officielle</li>
                  <li>• ⏰ Délai imparti respecté</li>
                  <li>• 📋 Justificatif de conformité</li>
                  <li>• 🔍 Contrôle organisme agréé</li>
                  <li>• 📄 Rapport de conformité</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Prime Sécurisation -->
      <div class="aide-details" data-aide="prime_securisation" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-shield me-2"></i>Prime Sécurisation</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour équipements et travaux de sécurisation des locaux professionnels contre le vol, l'effraction et le vandalisme.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux :</strong> 25% des investissements</li>
                    <li><strong>Maximum :</strong> 50% avec majorations</li>
                    <li><strong>Plafond :</strong> 25 000€ par période 3 ans</li>
                    <li><strong>Minimum :</strong> 1 250€ HTVA</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">🔒 Équipements éligibles</h6>
                  <ul class="list-unstyled small">
                    <li>• Systèmes d'alarme</li>
                    <li>• Vidéosurveillance</li>
                    <li>• Blindages et grilles</li>
                    <li>• Éclairage de sécurité</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Conditions techniques</h6>
              </div>
              <div class="card-body">
                <ul class="list-unstyled small">
                  <li>• 🏢 Installation dans locaux professionnels</li>
                  <li>• 🔧 Installation par professionnel agréé</li>
                  <li>• 📜 Certificat de conformité</li>
                  <li>• 🛡️ Respect des normes en vigueur</li>
                  <li>• 📋 Maintenance et garantie</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Prime Accessibilité -->
      <div class="aide-details" data-aide="prime_accessibilite" style="display: none;">
        <div class="row g-4">
          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-universal-access me-2"></i>Prime Accessibilité</h6>
              </div>
              <div class="card-body">
                <p><strong>Description :</strong> Prime pour travaux d'amélioration de l'accessibilité des locaux professionnels aux personnes à mobilité réduite.</p>

                <div class="mb-3">
                  <h6 class="text-success">💰 Montants</h6>
                  <ul class="list-unstyled small">
                    <li><strong>Taux :</strong> 30% des investissements</li>
                    <li><strong>Maximum :</strong> 60% avec majorations</li>
                    <li><strong>Plafond :</strong> 50 000€ par période 5 ans</li>
                    <li><strong>Minimum :</strong> 2 500€ HTVA</li>
                  </ul>
                </div>

                <div class="mb-3">
                  <h6 class="text-info">♿ Aménagements éligibles</h6>
                  <ul class="list-unstyled small">
                    <li>• Rampes d'accès</li>
                    <li>• Élargissement de portes</li>
                    <li>• Ascenseurs et monte-charges</li>
                    <li>• Sanitaires adaptés</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card h-100">
              <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-rulers me-2"></i>Normes à respecter</h6>
              </div>
              <div class="card-body">
                <ul class="list-unstyled small">
                  <li>• 📏 Normes d'accessibilité RRU</li>
                  <li>• 🚪 Largeurs minimales</li>
                  <li>• 📐 Pentes réglementaires</li>
                  <li>• 🔧 Équipements certifiés</li>
                  <li>• 📋 Validation par organisme agréé</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions rapides -->
    <div class="mt-4 p-3 bg-light rounded">
      <h6 class="text-muted mb-3">
        <i class="bi bi-lightning me-2"></i>Actions rapides
      </h6>
      <div class="row g-2">
        <div class="col-md-3">
          <a href="https://monbee.brussels.be" target="_blank" class="btn btn-outline-primary btn-sm w-100">
            <i class="bi bi-globe me-1"></i>MonBEE
          </a>
        </div>
        <div class="col-md-3">
          <a href="https://economie-emploi.brussels/investissements" target="_blank" class="btn btn-outline-info btn-sm w-100">
            <i class="bi bi-info-circle me-1"></i>Guide investissements
          </a>
        </div>
        <div class="col-md-3">
          <button type="button" class="btn btn-outline-success btn-sm w-100" data-action="click->aides-entreprise#calculerAide">
            <i class="bi bi-calculator me-1"></i>Simulateur
          </button>
        </div>
        <div class="col-md-3">
          <button type="button" class="btn btn-outline-warning btn-sm w-100" data-action="click->aides-entreprise#contactExpert">
            <i class="bi bi-person-check me-1"></i>Contact expert
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
