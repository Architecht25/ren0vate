<!-- PANNEAU 1: Synthèse Simulation (Plus compact) -->
<div class="col-xl-3 col-lg-6 col-md-12">
  <div class="panel synthesis-panel">
    <div class="panel-header">
      <h3>
        <i class="bi bi-graph-up text-primary me-2"></i>
        Vos Simulations
      </h3>
      <span class="panel-badge">Résultats</span>
    </div>

    <div class="panel-body compact-panel">
      <!-- Montant Total Highlight -->
      <div class="amount-highlight mb-3">
        <div class="amount-container">
          <span class="amount-value">12,450€</span>
          <span class="amount-label">Total primes éligibles</span>
        </div>
        <div class="primes-count">
          <span class="count-number">5</span>
          <span class="count-label">primes disponibles</span>
        </div>
      </div>

      <!-- Liste Prioritaire des Primes -->
      <div class="priority-list">
        <h5 class="section-title">Primes par priorité</h5>

        <div class="prime-item priority-high">
          <div class="prime-header">
            <span class="prime-name">Prime Isolation Toiture</span>
            <span class="prime-amount">4,200€</span>
          </div>
          <div class="prime-meta">
            <span class="urgency urgent">
              <i class="bi bi-clock-fill me-1"></i>
              Urgence: 30 jours
            </span>
          </div>
        </div>

        <div class="prime-item priority-high">
          <div class="prime-header">
            <span class="prime-name">Prime Pompe à Chaleur</span>
            <span class="prime-amount">3,800€</span>
          </div>
          <div class="prime-meta">
            <span class="urgency normal">
              <i class="bi bi-calendar me-1"></i>
              Flexible: 90 jours
            </span>
          </div>
        </div>

        <div class="prime-item priority-medium">
          <div class="prime-header">
            <span class="prime-name">Prime Isolation Façade</span>
            <span class="prime-amount">2,850€</span>
          </div>
          <div class="prime-meta">
            <span class="urgency seasonal">
              <i class="bi bi-sun me-1"></i>
              Saisonnier: Printemps
            </span>
          </div>
        </div>

        <div class="prime-item priority-low">
          <div class="prime-header">
            <span class="prime-name">Prime Audit Énergétique</span>
            <span class="prime-amount">800€</span>
          </div>
          <div class="prime-meta">
            <span class="urgency flexible">
              <i class="bi bi-check-circle me-1"></i>
              Déjà éligible
            </span>
          </div>
        </div>

        <div class="prime-item priority-low">
          <div class="prime-header">
            <span class="prime-name">Prime Ventilation</span>
            <span class="prime-amount">800€</span>
          </div>
          <div class="prime-meta">
            <span class="urgency conditional">
              <i class="bi bi-exclamation-triangle me-1"></i>
              Conditions à vérifier
            </span>
          </div>
        </div>
      </div>

      <!-- Actions Simulation -->
      <div class="panel-actions mt-4">
        <div class="btn-group w-100" role="group">
          <button class="btn btn-outline-primary btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i>
            Recalculer
          </button>
          <button class="btn btn-ai btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#aiConsultationModal"
                  data-context="synthesis"
                  data-quick-question="Comment optimiser mes primes de 12,450€ ?">
            <i class="bi bi-robot me-1"></i>
            IA
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
