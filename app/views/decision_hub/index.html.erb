<div class="container-fluid py-4" data-controller="decision-hub">

  <!-- Sélecteur de simulations -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <i class="bi bi-layers text-primary fs-4 me-3"></i>
              <div>
                <h6 class="mb-1">Sélectionnez votre simulation</h6>
                <small class="text-muted">Choisissez la simulation à analyser</small>
              </div>
            </div>
            <div class="simulation-selector">
              <% if @simulations.any? %>
                <select class="form-select" id="simulationSelector" data-decision-hub-target="simulationSelector">
                  <% @simulations.each do |simulation| %>
                    <option value="<%= simulation.id %>"
                            data-region="<%= simulation.region %>"
                            data-total="<%= simulation.total_simule || 0 %>"
                            <%= 'selected' if simulation.id == @default_simulation&.id %>>
                      <%= simulation.titre || "Simulation #{simulation.id}" %> •
                      <%= simulation.region&.capitalize %> •
                      <%= number_to_currency(simulation.total_simule || 0, unit: "", precision: 0) %>€ •
                      <%= simulation.created_at.strftime("%d/%m/%Y") %>
                    </option>
                  <% end %>
                </select>
              <% else %>
                <div class="alert alert-info mb-0">
                  <small>
                    <i class="bi bi-info-circle me-1"></i>
                    Aucune simulation éligible trouvée.
                    <%= link_to "Créer une simulation", new_simulation_path, class: "alert-link" %>
                  </small>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- Header avec résumé simulation -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm bg-gradient bg-primary text-white">
        <div class="card-body p-4">
          <div class="row align-items-center">
            <div class="col-md-6">
              <h2 class="mb-2">
                <i class="bi bi-compass me-2"></i>
                Votre Feuille de Route Rénovation
              </h2>
              <p class="mb-0 opacity-75">Simulation terminée • Wallonie • Rénovation complète</p>
            </div>
            <div class="col-md-3 text-md-center">
              <div class="d-inline-block bg-white bg-opacity-20 rounded-3 px-3 py-2">
                <div class="small text-uppercase opacity-75">Total primes</div>
                <div class="h3 mb-0">12,450€</div>
              </div>
            </div>
            <div class="col-md-3 text-md-end">
              <%= link_to decision_hub_short_path(77), class: "btn btn-light btn-lg" do %>
                <i class="bi bi-gear-fill me-2"></i>
                🎯 Decision Hub Complet
              <% end %>
              <small class="d-block mt-2 opacity-75">
                4 sections détaillées + IA
              </small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenu principal avec sections dynamiques + Sidebar IA -->
  <div class="row g-4">

    <!-- Sections principales (8 colonnes) -->
    <div class="col-lg-8">
      <div class="dynamic-content" data-decision-hub-target="dynamicContent">

        <!-- Loading state -->
        <div class="loading-state d-none" data-decision-hub-target="loadingState">
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3 text-muted">Mise à jour des données...</p>
          </div>
        </div>

        <!-- Navigation par étapes -->
        <div class="row mb-4" data-decision-hub-target="stepsNavigation">
          <div class="col-12">
            <div class="card border-0 shadow-sm">
              <div class="card-body p-0">
                <div class="row g-0">
                  <!-- Étape 0: Sélection Primes -->
                  <div class="col-md">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="selection-primes"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-check2-square fs-5"></i>
                      </div>
                      <h6 class="mb-2">Sélection Primes</h6>

                      <!-- Aperçu sélection vs simulation -->
                      <div class="text-start mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Simulation</small>
                          <small class="fw-bold text-primary"><%= @hub_data[:resume][:primes].length %> primes</small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Sélectionnées</small>
                          <small class="fw-bold text-success">1 prime</small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Optimisation</small>
                          <small class="fw-bold text-warning">En cours</small>
                        </div>
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-warning" style="width: 20%;"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 1: Résumé -->
                  <div class="col-md">
                    <div class="p-3 text-center border-end position-relative step-tab active"
                         data-section="resume"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-clipboard-check fs-5"></i>
                      </div>
                      <h6 class="mb-2">Résumé</h6>

                      <!-- Aperçu des primes principales -->
                      <div class="text-start mb-2">
                        <% @hub_data[:resume][:primes].first(3).each do |prime| %>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted"><%= prime[:name].truncate(20) %></small>
                            <small class="fw-bold text-success"><%= prime[:amount] %>€</small>
                          </div>
                        <% end %>
                        <% if @hub_data[:resume][:primes].count > 3 %>
                          <small class="text-muted">+ <%= @hub_data[:resume][:primes].count - 3 %> autres...</small>
                        <% end %>
                      </div>

                      <div class="fw-bold text-primary mb-2">
                        Total: <%= @hub_data[:resume][:total_amount] %>€
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-success" style="width: 100%"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 2: Documents -->
                  <div class="col-md-3">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="documents"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-file-earmark-text fs-5"></i>
                      </div>
                      <h6 class="mb-2">Documents</h6>

                      <!-- Aperçu des documents principaux -->
                      <div class="text-start mb-2">
                        <% @hub_data[:documents][:key_documents].first(3).each do |doc| %>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted"><%= doc[:name].truncate(15) %></small>
                            <% if doc[:status] == 'completed' %>
                              <i class="bi bi-check-circle-fill text-success"></i>
                            <% elsif doc[:status] == 'pending' %>
                              <i class="bi bi-clock text-warning"></i>
                            <% else %>
                              <i class="bi bi-x-circle text-danger"></i>
                            <% end %>
                          </div>
                        <% end %>
                      </div>

                      <div class="d-flex justify-content-between text-xs mb-2">
                        <span class="text-success"><%= @hub_data[:documents][:completed].count %> OK</span>
                        <span class="text-danger"><%= @hub_data[:documents][:missing].count %> manquants</span>
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-warning" style="width: <%= @hub_data[:documents][:completion_rate] %>%" data-decision-hub-target="documentsProgress"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 3: Planning -->
                  <div class="col-md-3">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="planning"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-calendar-event fs-5"></i>
                      </div>
                      <h6 class="mb-2">Planning</h6>

                      <!-- Aperçu des étapes critiques -->
                      <div class="text-start mb-2">
                        <% @hub_data[:planning][:critical_steps].first(3).each do |step| %>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted"><%= step[:name].truncate(15) %></small>
                            <% if step[:status] == 'completed' %>
                              <i class="bi bi-check-circle-fill text-success"></i>
                            <% elsif step[:status] == 'current' %>
                              <i class="bi bi-arrow-right-circle text-primary"></i>
                            <% elsif step[:urgent] %>
                              <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                            <% else %>
                              <i class="bi bi-circle text-secondary"></i>
                            <% end %>
                          </div>
                        <% end %>
                      </div>

                      <div class="fw-bold text-info mb-2">
                        <i class="bi bi-clock me-1"></i>
                        <%= @hub_data[:planning][:total_duration] %>
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-info" style="width: 25%" data-decision-hub-target="planningProgress"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 4: Technique -->
                  <div class="col-md-3">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="technical"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-gear fs-5"></i>
                      </div>
                      <h6 class="mb-2">Technique</h6>

                      <!-- Aperçu des exigences techniques -->
                      <div class="text-start mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Isolation thermique</small>
                          <% if @hub_data[:technical][:isolation_compliant] %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                          <% end %>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Ventilation PEB</small>
                          <% if @hub_data[:technical][:ventilation_compliant] %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                          <% end %>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Performance énerg.</small>
                          <% if @hub_data[:technical][:energy_performance_ok] %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                          <% end %>
                        </div>
                      </div>

                      <div class="fw-bold text-secondary mb-2">
                        <i class="bi bi-award me-1"></i>
                        <%= @hub_data[:technical][:compliance_score] %>% conforme
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-<%= @hub_data[:technical][:compliance_score] > 80 ? 'success' : @hub_data[:technical][:compliance_score] > 50 ? 'warning' : 'danger' %>" style="width: <%= @hub_data[:technical][:compliance_score] %>%" data-decision-hub-target="technicalProgress"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 5: Factures -->
                  <div class="col-md-3">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="factures"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-receipt-cutoff fs-5"></i>
                      </div>
                      <h6 class="mb-2">Factures</h6>

                      <!-- Aperçu des factures -->
                      <div class="text-start mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Budget vs Réel</small>
                          <% if @hub_data.dig(:factures, :budget_ok) %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                          <% end %>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Délai 12 mois</small>
                          <% if @hub_data.dig(:factures, :delai_ok) %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-clock text-danger"></i>
                          <% end %>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">OCR validé</small>
                          <span class="badge bg-info text-white small"><%= @hub_data.dig(:factures, :ocr_confidence) || 85 %>%</span>
                        </div>
                      </div>

                      <div class="fw-bold text-warning mb-2">
                        <i class="bi bi-calculator me-1"></i>
                        <%= @hub_data.dig(:factures, :total_factures) || 0 %>€
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-warning" style="width: <%= @hub_data.dig(:factures, :completion_rate) || 0 %>%" data-decision-hub-target="facturesProgress"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 6: Conseils Factures -->
                  <div class="col-md-3">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="conseils-factures"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-receipt fs-5"></i>
                      </div>
                      <h6 class="mb-2">Conseils Factures</h6>

                      <!-- Aperçu des conseils factures -->
                      <div class="text-start mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Format obligatoire</small>
                          <i class="bi bi-check-circle text-success"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Mentions requises</small>
                          <i class="bi bi-list-check text-info"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Délais à respecter</small>
                          <i class="bi bi-clock text-warning"></i>
                        </div>
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-success" style="width: 100%;"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 6: Conseils ACP -->
                  <div class="col-md-3">
                    <div class="p-3 text-center position-relative step-tab"
                         data-section="conseils-acp"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-building fs-5"></i>
                      </div>
                      <h6 class="mb-2">Conseils ACP</h6>

                      <!-- Aperçu des conseils ACP -->
                      <div class="text-start mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Documents admin.</small>
                          <i class="bi bi-folder-check text-success"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Assemblée générale</small>
                          <i class="bi bi-people text-info"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Gestion financière</small>
                          <i class="bi bi-calculator text-warning"></i>
                        </div>
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-primary" style="width: 100%;"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 8: Conseils Exemplarité (TEMPORAIRE: Toujours affiché pour test) -->
                  <!-- DEBUG: @simulation&.region = <%= @simulation&.region %>, @simulation&.property&.is_entreprise? = <%= @simulation&.property&.is_entreprise? if @simulation&.property %> -->
                  <% if true # Temporaire pour test : @simulation&.region == 'bruxelles' && @simulation&.property&.is_entreprise? %>
                    <div class="col-md-3">
                      <div class="p-3 text-center border-end position-relative step-tab"
                           data-section="conseils-exemplarite"
                           data-action="click->decision-hub#switchSection"
                           style="cursor: pointer;">
                        <div class="step-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                          <i class="bi bi-award fs-5"></i>
                        </div>
                        <h6 class="mb-2">Conseils Exemplarité</h6>

                        <!-- Aperçu des gains potentiels -->
                        <div class="text-start mb-2">
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Gain environnemental</small>
                            <span class="badge bg-success text-white small">+30%</span>
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Gain social</small>
                            <span class="badge bg-primary text-white small">+30%</span>
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Taux maximum</small>
                            <span class="badge bg-warning text-dark small">80%</span>
                          </div>
                        </div>

                        <div class="progress mt-2" style="height: 3px;">
                          <div class="progress-bar bg-success" style="width: 100%;"></div>
                        </div>
                      </div>
                    </div>
                  <% end %>

                  <!-- Étape 9: Vérification Consultance (pour entreprises bruxelloises) -->
                  <% if true # Temporaire pour test : @simulation&.region == 'bruxelles' && @simulation&.property&.is_entreprise? %>
                    <div class="col-md-3">
                      <div class="p-3 text-center border-end position-relative step-tab"
                           data-section="verification-consultance"
                           data-action="click->decision-hub#switchSection"
                           style="cursor: pointer;">
                        <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                          <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <h6 class="mb-2">Vérification Consultance</h6>

                        <!-- Aperçu vérification consultant -->
                        <div class="text-start mb-2">
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Éligibilité BCE</small>
                            <i class="bi bi-building text-primary"></i>
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Code NACE validé</small>
                            <i class="bi bi-check-square text-success"></i>
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Qualifications</small>
                            <i class="bi bi-award text-warning"></i>
                          </div>
                        </div>

                        <div class="progress mt-2" style="height: 3px;">
                          <div class="progress-bar bg-primary" style="width: 100%;"></div>
                        </div>
                      </div>
                    </div>
                  <% end %>

                  <!-- Étape 10: Conseils Entrepreneurs -->
                  <div class="col-md-3">
                    <div class="p-3 text-center position-relative step-tab"
                         data-section="conseils-entrepreneurs"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-hammer fs-5"></i>
                      </div>
                      <h6 class="mb-2">Conseils Entrepreneurs</h6>

                      <!-- Aperçu des conseils entrepreneurs -->
                      <div class="text-start mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Sélection RGE</small>
                          <i class="bi bi-shield-check text-success"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Devis & négociation</small>
                          <i class="bi bi-handshake text-info"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Suivi chantier</small>
                          <i class="bi bi-clipboard-check text-warning"></i>
                        </div>
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-info" style="width: 100%;"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Contenu des sections -->
        <div class="sections-content">

          <!-- Section Sélection Primes -->
          <div class="section-content" data-section="selection-primes" data-decision-hub-target="selectionPrimesSection">
            <div class="row g-4">
              <div class="col-12">
                <%= render 'decision_hub/info_cards/selection_primes' %>
              </div>
            </div>
          </div>

          <!-- Actions rapides pour la simulation -->
          <div class="section-content" data-section="resume" data-decision-hub-target="resumeSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/resume', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Documents -->
          <div class="section-content" data-section="documents" data-decision-hub-target="documentsSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/documents', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Planning -->
          <div class="section-content" data-section="planning" data-decision-hub-target="planningSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/planning', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Technique -->
          <div class="section-content" data-section="technical" data-decision-hub-target="technicalSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/technical', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Factures -->
          <div class="section-content" data-section="factures" data-decision-hub-target="facturesSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'factures/dashboard' %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Conseils Factures -->
          <div class="section-content" data-section="conseils-factures" data-decision-hub-target="conseilsFacturesSection">
            <div class="row g-4">
              <div class="col-12">
                <%= render 'decision_hub/info_cards/bonne_facture' %>
              </div>
            </div>
          </div>

          <!-- Section Conseils ACP -->
          <div class="section-content" data-section="conseils-acp" data-decision-hub-target="conseilsAcpSection">
            <div class="row g-4">
              <div class="col-12">
                <%= render 'decision_hub/info_cards/acp_preparation' %>
              </div>
            </div>
          </div>

          <!-- Section Conseils Exemplarité (TEMPORAIRE: Toujours affichée pour test) -->
          <!-- DEBUG: @simulation&.region = <%= @simulation&.region %>, @simulation&.property&.is_entreprise? = <%= @simulation&.property&.is_entreprise? if @simulation&.property %> -->
          <% if true # Temporaire pour test : @simulation&.region == 'bruxelles' && @simulation&.property&.is_entreprise? %>
            <div class="section-content" data-section="conseils-exemplarite" data-decision-hub-target="conseilsExemplariteSection">
              <div class="row g-4">
                <div class="col-12">
                  <%= render 'decision_hub/info_cards/conseils_exemplarite' %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Section Vérification Consultance (pour entreprises bruxelloises) -->
          <% if true # Temporaire pour test : @simulation&.region == 'bruxelles' && @simulation&.property&.is_entreprise? %>
            <div class="section-content" data-section="verification-consultance" data-decision-hub-target="verificationConsultanceSection">
              <div class="row g-4">
                <div class="col-12">
                  <%= render 'decision_hub/info_cards/verification_consultance' %>
                </div>
              </div>
            </div>
          <% end %>

          <!-- Section Conseils Entrepreneurs -->
          <div class="section-content" data-section="conseils-entrepreneurs" data-decision-hub-target="conseilsEntrepreneursSection">
            <div class="row g-4">
              <div class="col-12">
                <%= render 'decision_hub/info_cards/conseils_entrepreneurs' %>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Sidebar IA (4 colonnes) -->
    <div class="col-lg-4">
      <div class="ai-sidebar sticky-top" style="top: 1rem;">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-header bg-gradient bg-success text-white">
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center">
                <i class="bi bi-robot fs-4 me-2"></i>
                <div>
                  <h6 class="mb-0">Assistant IA Expert</h6>
                  <small class="opacity-75">Conseil en temps réel</small>
                </div>
              </div>
              <div class="ai-status">
                <span class="badge bg-white text-success">
                  <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
                  En ligne
                </span>
              </div>
            </div>
          </div>

          <div class="card-body d-flex flex-column" style="height: 500px;">
            <!-- Zone de conversation -->
            <div class="conversation-area flex-grow-1 mb-3" data-decision-hub-target="conversationArea">
              <div class="ai-message mb-3">
                <div class="d-flex align-items-start">
                  <div class="ai-avatar bg-success rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; flex-shrink: 0;">
                    <i class="bi bi-robot text-white small"></i>
                  </div>
                  <div class="message-content bg-light rounded-3 p-3 flex-grow-1">
                    <div class="message-text">
                      <strong>🤖 Bonjour !</strong><br>
                      Je suis votre expert IA spécialisé en primes énergétiques.<br><br>
                      <span data-decision-hub-target="aiWelcomeContext">
                        J'ai analysé votre simulation : <strong><%= @hub_data[:resume][:total_amount] %>€</strong> de primes potentielles !
                      </span><br><br>
                      💬 Posez-moi vos questions ou cliquez sur une suggestion ci-dessous.
                    </div>
                    <small class="text-muted">Il y a quelques instants</small>
                  </div>
                </div>
              </div>
            </div>

            <!-- Questions rapides -->
            <div class="quick-questions mb-3">
              <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-success btn-sm quick-question"
                        data-question="Quelle est ma prochaine action prioritaire ?">
                  🎯 Prochaine action
                </button>
                <button class="btn btn-outline-success btn-sm quick-question"
                        data-question="Comment optimiser mes primes ?">
                  💰 Optimiser
                </button>
                <button class="btn btn-outline-success btn-sm quick-question"
                        data-question="Quels documents me manquent-ils ?">
                  📋 Documents
                </button>
                <button class="btn btn-outline-success btn-sm quick-question"
                        data-question="Y a-t-il des délais urgents ?">
                  ⏰ Délais
                </button>
              </div>
            </div>

            <!-- Zone de saisie -->
            <div class="input-area">
              <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Posez votre question..."
                       data-decision-hub-target="questionInput">
                <button class="btn btn-success"
                        type="button"
                        data-decision-hub-target="sendButton">
                  <i class="bi bi-send"></i>
                </button>
              </div>
              <small class="text-muted">
                <i class="bi bi-shield-check me-1"></i>
                Conseils basés sur vos données réelles
              </small>
            </div>
          </div>
        </div>

        <!-- Bouton accès détaillé -->
        <div class="mt-3">
          <div class="d-grid">
            <%= link_to decision_hub_short_path(@default_simulation&.id || 77),
                        class: "btn btn-primary",
                        data: { "decision-hub-target": "detailedViewLink" } do %>
              <i class="bi bi-gear-fill me-2"></i>
              🎯 Vue technique détaillée
            <% end %>
            <small class="text-muted text-center mt-2">
              4 panneaux approfondis + outils spécialisés
            </small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Styles pour les onglets */
  .step-tab {
    transition: all 0.3s ease;
  }

  .step-tab:hover {
    background-color: rgba(0,123,255,0.05);
    transform: translateY(-2px);
  }

  .step-tab.active {
    background-color: rgba(0,123,255,0.1);
    border-left: 4px solid #007bff;
  }

  .step-tab.active .step-number {
    transform: scale(1.1);
  }

  /* Gestion de l'affichage des sections */
  .section-content {
    display: none;
  }

  .section-content[data-section="resume"] {
    display: block; /* Section résumé visible par défaut */
  }

  /* Animation pour les changements de section */
  .section-content {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
