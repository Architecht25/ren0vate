<div class="container-fluid py-4"
     data-controller="decision-hub decision-hub-interactions"
     data-decision-hub-load-simulation-url-value="<%= load_simulation_decision_hub_index_path(simulation_id: 'SIMULATION_ID', locale: I18n.locale) %>">

  <!-- Message d'information -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-info border-0" style="background-color: #e8f4f8;">
        <div class="d-flex align-items-start">
          <i class="bi bi-info-circle me-3 mt-1" style="font-size: 1.2rem;"></i>
          <p class="mb-0">
            Ici vous pouvez affiner le choix de vos simulations, vérifier les délais à respecter, identifier les documents à collecter, comprendre les contraintes techniques à respecter et entamer un travail de préparation technique des demandes de primes.
            Une fois terminé, vous pouvez passer à l'étape suivante et créer vos formulaires de demandes.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Sélecteur de simulations -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center flex-grow-1">
              <i class="bi bi-layers text-primary fs-4 me-3"></i>
              <div class="me-4">
                <h6 class="mb-1">Sélectionnez votre simulation</h6>
                <small class="text-muted">Choisissez la simulation à analyser</small>
              </div>
              <div class="simulation-selector flex-grow-1" style="max-width: 600px; min-width: 0;">
              <% if @simulations.any? %>
                <select class="form-select"
                        id="simulationSelector"
                        data-decision-hub-target="simulationSelector"
                        data-action="change->decision-hub#simulationChanged"
                        style="width: 100%; border: 2px solid var(--bs-primary); border-color: #1e40af;">
                  <% @simulations.each do |simulation| %>
                    <option value="<%= simulation.id %>"
                            data-region="<%= simulation.region %>"
                            data-total="<%= simulation.total_simule || 0 %>"
                            <%= 'selected' if simulation.id == @default_simulation&.id %>>
                      <%= simulation.titre || "Simulation #{simulation.id}" %> •
                      <%= simulation.region&.capitalize %> •
                      <%= number_to_currency(simulation.total_simule || 0, unit: "", precision: 0) %>€ •
                      <%= simulation.created_at.strftime("%d/%m/%Y") %>
                    </option>
                  <% end %>
                </select>
              <% else %>
                <div class="alert alert-info mb-0">
                  <small>
                    <i class="bi bi-info-circle me-1"></i>
                    Aucune simulation éligible trouvée.
                    <%= link_to "Créer une simulation", new_simulation_path, class: "alert-link" %>
                  </small>
                </div>
              <% end %>
              </div>
            </div>
            <div class="d-flex align-items-center">
              <%= link_to properties_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-arrow-left me-1"></i>
                Mes biens
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- Header avec résumé simulation -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm bg-gradient bg-primary text-white">
        <div class="card-body p-4">
          <div class="row align-items-center">
            <div class="col-md-12">
              <div class="d-flex align-items-start">
                <i class="bi bi-compass me-3 mt-1" style="font-size: 1.5rem;"></i>
                <p class="mb-0 fs-5">
                  Ceci est votre espace technique qui vous permet de préparer votre demande de prime avant de passer à l'étape de création de votre formulaire de demande.
                  Cliquez sur les différentes étapes pour voir les actions à mener pour maximiser vos chances de recevoir la prime.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenu principal avec sections dynamiques -->
  <div class="row g-4">

    <!-- Sections principales (pleine largeur) -->
    <div class="col-lg-12">
      <div class="dynamic-content" data-decision-hub-target="dynamicContent">

        <!-- Loading state -->
        <div class="loading-state d-none" data-decision-hub-target="loadingState">
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3 text-muted">Mise à jour des données...</p>
          </div>
        </div>

        <!-- Navigation par étapes -->
        <div class="row mb-" data-decision-hub-target="stepsNavigation">
          <div class="col-12">
            <div class="card border-0 shadow-sm">
              <div class="card-body p-0">
                <div class="steps-tabs-wrapper">
                <div class="row g-0 flex-nowrap steps-tabs-row">
                  <!-- Étape 1: Résumé -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab active"
                         data-section="resume"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-clipboard-check fs-5"></i>
                      </div>
                      <h6 class="mb-2">Résumé</h6>
                      <small class="text-muted d-block mb-2">Résumé simple de votre simulation</small>

                      <!-- Aperçu des primes principales -->
                      <div class="text-start mb-2">
                        <% (@hub_data[:resume][:primes] || []).first(3).each do |prime| %>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted"><%= prime[:name].truncate(20) %></small>
                            <small class="fw-bold text-success"><%= prime[:amount] %>€</small>
                          </div>
                        <% end %>
                        <% if (@hub_data[:resume][:primes] || []).count > 3 %>
                          <small class="text-muted">+ <%= (@hub_data[:resume][:primes] || []).count - 3 %> autres...</small>
                        <% end %>
                      </div>

                      <div class="fw-bold text-primary mb-2">
                        Total: <%= @hub_data[:resume][:total_amount] || 0 %>€
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-success" style="width: 100%"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 2: Planning -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="planning"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-calendar-event fs-5"></i>
                      </div>
                      <h6 class="mb-2">Délais à respecter</h6>
                      <small class="text-muted d-block mb-2">Échéances à tenir pour bien introduire sa demande dans les temps</small>

                      <!-- Aperçu des délais critiques -->
                      <div class="text-start mb-2">
                        <% if @simulation&.region&.downcase == 'flandre' %>
                          <%
                            # Calcul des délais pour la Flandre
                            deadline_peb_suppression = Date.new(2026, 6, 30)
                            days_peb_suppression = (deadline_peb_suppression - Date.current).to_i

                            deadline_acompte = nil
                            days_acompte = nil
                            if @simulation&.project&.date_début.present?
                              deadline_acompte = @simulation.project.date_début + 2.years
                              days_acompte = (deadline_acompte - Date.current).to_i
                            end
                          %>

                          <!-- Délai Prime PEB -->
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Prime PEB</small>
                            <% if days_peb_suppression <= 0 %>
                              <i class="bi bi-x-circle-fill text-danger"></i>
                            <% elsif days_peb_suppression <= 180 %>
                              <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                            <% elsif days_peb_suppression <= 365 %>
                              <i class="bi bi-exclamation-triangle text-warning"></i>
                            <% else %>
                              <i class="bi bi-check-circle text-success"></i>
                            <% end %>
                          </div>

                          <!-- Délai Prime Régionale -->
                          <% if deadline_acompte.present? %>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                              <small class="text-muted">Prime régionale</small>
                              <% if days_acompte <= 0 %>
                                <i class="bi bi-x-circle-fill text-danger"></i>
                              <% elsif days_acompte <= 90 %>
                                <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                              <% elsif days_acompte <= 365 %>
                                <i class="bi bi-exclamation-triangle text-warning"></i>
                              <% else %>
                                <i class="bi bi-check-circle text-success"></i>
                              <% end %>
                            </div>
                          <% end %>

                        <% else %>
                          <!-- Autres régions - à adapter -->
                          <% (@hub_data[:planning][:critical_steps] || []).first(3).each do |step| %>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                              <small class="text-muted"><%= step[:name].truncate(15) %></small>
                              <% if step[:status] == 'completed' %>
                                <i class="bi bi-check-circle-fill text-success"></i>
                              <% elsif step[:status] == 'current' %>
                                <i class="bi bi-arrow-right-circle text-primary"></i>
                              <% elsif step[:urgent] %>
                                <i class="bi bi-exclamation-triangle-fill text-danger"></i>
                              <% else %>
                                <i class="bi bi-circle text-secondary"></i>
                              <% end %>
                            </div>
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 3: Documents -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="documents"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-file-earmark-text fs-5"></i>
                      </div>
                      <h6 class="mb-2">Documents à collecter</h6>
                      <small class="text-muted d-block mb-2">Liste des documents à collecter pour préparer votre demande de primes</small>

                      <!-- Aperçu des documents principaux -->
                      <div class="text-start mb-2">
                        <% (@hub_data[:documents][:key_documents] || []).first(3).each do |doc| %>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted"><%= doc[:name].truncate(15) %></small>
                            <% if doc[:status] == 'completed' %>
                              <i class="bi bi-check-circle-fill text-success"></i>
                            <% elsif doc[:status] == 'pending' %>
                              <i class="bi bi-clock text-warning"></i>
                            <% else %>
                              <i class="bi bi-x-circle text-danger"></i>
                            <% end %>
                          </div>
                        <% end %>
                      </div>

                      <div class="d-flex justify-content-between text-xs mb-2">
                        <span class="text-success"><%= (@hub_data[:documents][:completed] || []).count %> OK</span>
                        <span class="text-danger"><%= (@hub_data[:documents][:missing] || []).count %> manquants</span>
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-warning" style="width: <%= (@hub_data.dig(:documents, :completion_rate) || 0) %>%" data-decision-hub-target="documentsProgress"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 4: Technique -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="technical"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-gear fs-5"></i>
                      </div>
                      <h6 class="mb-2">Contraintes techniques</h6>
                      <small class="text-muted d-block mb-2">Contraintes techniques à respecter pour bénéficier des primes</small>

                      <!-- Aperçu des exigences techniques -->
                      <div class="text-start mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Isolation thermique</small>
                          <% if @hub_data.dig(:technical, :isolation_compliant) == true %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                          <% end %>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Ventilation PEB</small>
                          <% if @hub_data.dig(:technical, :ventilation_compliant) == true %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                          <% end %>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Performance énerg.</small>
                          <% if @hub_data.dig(:technical, :energy_performance_ok) == true %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-exclamation-triangle text-warning"></i>
                          <% end %>
                        </div>
                      </div>

                                            <div class="fw-bold text-secondary mb-2">
                        <%= (@hub_data.dig(:technical, :compliance_score) || 0) %>% conforme
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <% compliance_score = (@hub_data.dig(:technical, :compliance_score) || 0).to_i %>
                        <div class="progress-bar bg-<%= compliance_score > 80 ? 'success' : compliance_score > 50 ? 'warning' : 'danger' %>" style="width: <%= compliance_score %>%" data-decision-hub-target="technicalProgress"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 5: Préparation technique -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="preparation-technique"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-clipboard-data fs-5"></i>
                      </div>
                      <h6 class="mb-2">Préparation technique</h6>
                      <small class="text-muted d-block mb-2">Collectez et enregistrez vos données techniques réelles</small>

                      <!-- Aperçu des données collectées -->
                      <div class="text-start mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Isolation toiture</small>
                          <% if @hub_data.dig(:preparation, :isolation_toiture_data) %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-circle text-muted"></i>
                          <% end %>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Systèmes énergie</small>
                          <% if @hub_data.dig(:preparation, :systemes_energie_data) %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-circle text-muted"></i>
                          <% end %>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                          <small class="text-muted">Menuiseries</small>
                          <% if @hub_data.dig(:preparation, :menuiseries_data) %>
                            <i class="bi bi-check-circle-fill text-success"></i>
                          <% else %>
                            <i class="bi bi-circle text-muted"></i>
                          <% end %>
                        </div>
                      </div>

                      <div class="fw-bold text-info mb-2">
                        <% preparation_completion = (@hub_data.dig(:preparation, :completion_rate) || 0) %>
                        <%= preparation_completion %>% collecté
                      </div>

                      <div class="progress mt-2" style="height: 3px;">
                        <div class="progress-bar bg-info" style="width: <%= preparation_completion %>%" data-decision-hub-target="preparationProgress"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Étape 6: Audit Logement Wallonie -->
                  <% if @default_simulation&.region == 'Wallonie' %>
                    <div class="col-md-2 steps-tab-col">
                      <div class="p-3 text-center border-end position-relative step-tab"
                           data-section="audit-logement-wallonie"
                           data-action="click->decision-hub#switchSection"
                           style="cursor: pointer;">
                        <div class="step-number bg-orange text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #fd7e14;">
                          <i class="bi bi-house-check fs-5"></i>
                        </div>
                        <h6 class="mb-2">Audit Logement Wallonie - c'est quoi?</h6>
                        <small class="text-muted d-block mb-2">Pour bien comprendre la nécessité d'un audit énergétique</small>

                        <!-- Aperçu de l'audit logement -->
                        <div class="text-start mb-2">
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Auditeur agréé</small>
                            <i class="bi bi-person-check text-success"></i>
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Accès aux primes</small>
                            <i class="bi bi-award text-warning"></i>
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Rapport détaillé</small>
                            <i class="bi bi-file-earmark-check text-info"></i>
                          </div>
                        </div>

                        <div class="fw-bold text-orange mb-2" style="color: #fd7e14;">
                          <i class="bi bi-shield-check me-1"></i>
                          Obligatoire
                        </div>

                        <div class="progress mt-2" style="height: 3px;">
                          <div class="progress-bar" style="width: 100%; background-color: #fd7e14;"></div>
                        </div>
                      </div>
                    </div>
                  <% end %>

                  <!-- Étape 7: Certificat PEB Flandre -->
                  <% if @default_simulation&.region == 'flandre' %>
                    <div class="col-md-2 steps-tab-col">
                      <div class="p-3 text-center border-end position-relative step-tab"
                           data-section="certificat-peb-flandre"
                           data-action="click->decision-hub#switchSection"
                           style="cursor: pointer;">
                        <div class="step-number text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                          <i class="bi bi-award fs-5"></i>
                        </div>
                        <h6 class="mb-2">Certificat PEB Flandre</h6>
                        <small class="text-muted d-block mb-2">Accédez aux certificateurs agréés en Flandre</small>

                        <!-- Aperçu du certificat PEB -->
                        <div class="text-start mb-2">
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Certificateur agréé</small>
                            <i class="bi bi-person-check text-success"></i>
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Vente/Location</small>
                            <i class="bi bi-house-door text-warning"></i>
                          </div>
                          <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted">Valable 10 ans</small>
                            <i class="bi bi-calendar-check text-info"></i>
                          </div>
                        </div>

                        <div class="fw-bold mb-2" style="color: #e74c3c;">
                          <i class="bi bi-shield-check me-1"></i>
                          Obligatoire
                        </div>

                        <div class="progress mt-2" style="height: 3px;">
                          <div class="progress-bar" style="width: 100%; background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);"></div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div> <!-- /steps-tabs-row -->
                </div> <!-- /steps-tabs-wrapper -->
              </div>
            </div>
          </div>
        </div>

        <!-- Contenu des sections -->
        <div class="sections-content">

          <!-- Actions rapides pour la simulation -->
          <div class="section-content" data-section="resume" data-decision-hub-target="resumeSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/resume', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Documents -->
          <div class="section-content" data-section="documents" data-decision-hub-target="documentsSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/documents', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Planning -->
          <div class="section-content" data-section="planning" data-decision-hub-target="planningSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/planning', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Technique -->
          <div class="section-content" data-section="technical" data-decision-hub-target="technicalSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/technical', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Préparation technique -->
          <div class="section-content" data-section="preparation-technique" data-decision-hub-target="preparationTechniqueSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/preparation_technique', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Audit Logement Wallonie -->
          <%# if @simulation&.region == 'wallonie' %>
            <div class="section-content" data-section="audit-logement-wallonie" data-decision-hub-target="auditLogementWallonieSection">
              <div class="row g-4">
                <div class="col-12">
                  <%= render 'decision_hub/info_cards/audit_logement_wallonie' %>
                </div>
              </div>
            </div>
          <%# end %>

          <!-- Section Certificat PEB Flandre -->
          <% if @default_simulation&.region == 'flandre' %>
            <div class="section-content" data-section="certificat-peb-flandre" data-decision-hub-target="certificatPebFlandreSection">
              <div class="row g-4">
                <div class="col-12">
                  <%= render 'decision_hub/info_cards/certificat_peb_flandre' %>
                </div>
              </div>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Styles pour les onglets */
  .step-tab {
    transition: all 0.3s ease;
  }

  .step-tab:hover {
    background-color: rgba(0,123,255,0.05);
    transform: translateY(-2px);
  }

