<div class="container-fluid py-4"
     data-controller="decision-hub decision-hub-interactions"
     data-decision-hub-load-simulation-url-value="<%= load_simulation_decision_hub_index_path(simulation_id: 'SIMULATION_ID', locale: I18n.locale) %>">

  <!-- Message d'information -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="alert alert-info border-0" style="background-color: #e8f4f8;">
        <div class="d-flex align-items-start">
          <i class="bi bi-info-circle me-3 mt-1" style="font-size: 1.2rem;"></i>
          <p class="mb-0">
            Ici vous pouvez affiner le choix de vos simulations, vérifier les délais à respecter, identifier les documents à collecter, comprendre les contraintes techniques à respecter et entamer un travail de préparation technique des demandes de primes.
            Une fois terminé, vous pouvez passer à l'étape suivante et créer vos formulaires de demandes.
          </p>
        </div>
      </div>
    </div>
  </div>

  <%= render 'shared/expert_subsides_banner' %>

  <!-- Sélecteur de simulations -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
          <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center flex-grow-1">
              <i class="bi bi-layers text-primary fs-4 me-3"></i>
              <div class="me-4">
                <h6 class="mb-1">Sélectionnez votre simulation</h6>
                <small class="text-muted">Choisissez la simulation à analyser</small>
              </div>
              <div class="simulation-selector flex-grow-1" style="max-width: 600px; min-width: 0;">
              <% if @simulations.any? %>
                <select class="form-select"
                        id="simulationSelector"
                        data-decision-hub-target="simulationSelector"
                        data-action="change->decision-hub#simulationChanged"
                        style="width: 100%; border: 2px solid var(--bs-primary); border-color: #1e40af;">
                  <% @simulations.each do |simulation| %>
                    <option value="<%= simulation.id %>"
                            data-region="<%= simulation.region %>"
                            data-total="<%= simulation.total_simule || 0 %>"
                            <%= 'selected' if simulation.id == @default_simulation&.id %>>
                      <%= simulation.titre || "Simulation #{simulation.id}" %> •
                      <%= simulation.region&.capitalize %> •
                      <%= number_to_currency(simulation.total_simule || 0, unit: "", precision: 0) %>€ •
                      <%= simulation.created_at.strftime("%d/%m/%Y") %>
                    </option>
                  <% end %>
                </select>
              <% else %>
                <div class="alert alert-info mb-0">
                  <small>
                    <i class="bi bi-info-circle me-1"></i>
                    Aucune simulation éligible trouvée.
                    <%= link_to "Créer une simulation", new_simulation_path, class: "alert-link" %>
                  </small>
                </div>
              <% end %>
              </div>
            </div>
            <div class="d-flex align-items-center">
              <%= link_to properties_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-arrow-left me-1"></i>
                Mes biens
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- Header avec résumé simulation -->
  <div class="row mb-4">
    <div class="col-12">
      <div class="card border-0 shadow-sm bg-gradient bg-primary text-white">
        <div class="card-body p-4">
          <div class="row align-items-center">
            <div class="col-md-12">
              <div class="d-flex align-items-start">
                <i class="bi bi-compass me-3 mt-1" style="font-size: 1.5rem;"></i>
                <p class="mb-0 fs-5">
                  Ceci est votre espace technique qui vous permet de préparer votre demande de prime avant de passer à l'étape de création de votre formulaire de demande.
                  Cliquez sur les différentes étapes pour voir les actions à mener pour maximiser vos chances de recevoir la prime.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenu principal avec sections dynamiques -->
  <div class="row g-4">

    <!-- Sections principales (pleine largeur) -->
    <div class="col-lg-12">
      <div class="dynamic-content" data-decision-hub-target="dynamicContent">

        <!-- Loading state -->
        <div class="loading-state d-none" data-decision-hub-target="loadingState">
          <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3 text-muted">Mise à jour des données...</p>
          </div>
        </div>

        <!-- Navigation par étapes -->
        <div class="row mb-" data-decision-hub-target="stepsNavigation">
          <div class="col-12">
            <div class="card border-0 shadow-sm">
              <div class="card-body p-0">
                <div class="steps-tabs-wrapper">
                <% is_wallonie = @default_simulation&.region&.downcase == 'wallonie' %>
                <% is_flandre = @default_simulation&.region&.downcase == 'flandre' %>
                <div class="row g-0 flex-nowrap steps-tabs-row">
                  <!-- Étape 1: Résumé -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab active"
                         data-section="resume"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-clipboard-check fs-5"></i>
                      </div>
                      <small class="text-muted d-block mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Étape 2.1</small>
                      <h6 class="mb-2">Résumé</h6>
                      <small class="text-muted d-block">Résumé simple de votre simulation</small>
                    </div>
                  </div>

                  <!-- Étape 2.2 Wallonie: Audit Logement / Flandre: Certificat PEB -->
                  <% if is_wallonie %>
                    <div class="col-md-2 steps-tab-col">
                      <div class="p-3 text-center border-end position-relative step-tab"
                           data-section="audit-logement-wallonie"
                           data-action="click->decision-hub#switchSection"
                           style="cursor: pointer;">
                        <div class="step-number text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: var(--ren0vate-accent);">
                          <i class="bi bi-house-check fs-5"></i>
                        </div>
                        <small class="text-muted d-block mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Étape 2.2</small>
                        <h6 class="mb-2">Audit Logement Wallonie</h6>
                        <small class="text-muted d-block">Pour bien comprendre la nécessité d'un audit énergétique</small>
                      </div>
                    </div>
                  <% elsif is_flandre %>
                    <div class="col-md-2 steps-tab-col">
                      <div class="p-3 text-center border-end position-relative step-tab"
                           data-section="certificat-peb-flandre"
                           data-action="click->decision-hub#switchSection"
                           style="cursor: pointer;">
                        <div class="step-number text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);">
                          <i class="bi bi-award fs-5"></i>
                        </div>
                        <small class="text-muted d-block mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Étape 2.2</small>
                        <h6 class="mb-2">Certificat PEB Flandre</h6>
                        <small class="text-muted d-block">Accédez aux certificateurs agréés en Flandre</small>
                      </div>
                    </div>
                  <% end %>

                  <!-- Étape Planning -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="planning"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-calendar-event fs-5"></i>
                      </div>
                      <small class="text-muted d-block mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Étape 2.3</small>
                      <h6 class="mb-2">Délais à respecter</h6>
                      <small class="text-muted d-block">Échéances à tenir pour bien introduire sa demande dans les temps</small>
                    </div>
                  </div>

                  <!-- Étape 3: Documents -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="documents"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-file-earmark-text fs-5"></i>
                      </div>
                      <small class="text-muted d-block mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Étape 2.4</small>
                      <h6 class="mb-2">Documents à collecter</h6>
                      <small class="text-muted d-block">Liste des documents à collecter pour préparer votre demande de primes</small>
                    </div>
                  </div>

                  <!-- Étape 4: Technique -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="technical"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-gear fs-5"></i>
                      </div>
                      <small class="text-muted d-block mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Étape 2.5</small>
                      <h6 class="mb-2">Contraintes techniques</h6>
                      <small class="text-muted d-block">Contraintes techniques à respecter pour bénéficier des primes</small>
                    </div>
                  </div>

                  <!-- Étape 5: Préparation technique -->
                  <div class="col-md-2 steps-tab-col">
                    <div class="p-3 text-center border-end position-relative step-tab"
                         data-section="preparation-technique"
                         data-action="click->decision-hub#switchSection"
                         style="cursor: pointer;">
                      <div class="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px;">
                        <i class="bi bi-clipboard-data fs-5"></i>
                      </div>
                      <small class="text-muted d-block mb-1" style="font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;">Étape 2.6</small>
                      <h6 class="mb-2">Préparation technique</h6>
                      <small class="text-muted d-block">Collectez et enregistrez vos données techniques réelles</small>
                    </div>
                  </div>


                </div> <!-- /steps-tabs-row -->
                </div> <!-- /steps-tabs-wrapper -->
              </div>
            </div>
          </div>
        </div>

        <!-- Contenu des sections -->
        <div class="sections-content">

          <!-- Actions rapides pour la simulation -->
          <div class="section-content" data-section="resume" data-decision-hub-target="resumeSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/resume', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Documents -->
          <div class="section-content" data-section="documents" data-decision-hub-target="documentsSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/documents', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Planning -->
          <div class="section-content" data-section="planning" data-decision-hub-target="planningSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/planning', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Technique -->
          <div class="section-content" data-section="technical" data-decision-hub-target="technicalSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/technical', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Préparation technique -->
          <div class="section-content" data-section="preparation-technique" data-decision-hub-target="preparationTechniqueSection">
            <div class="row g-4">
              <div class="col-12">
                <div class="card border-0 shadow-sm">
                  <div class="card-body">
                    <%= render 'decision_hub/sections/preparation_technique', hub_data: @hub_data %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Audit Logement Wallonie -->
          <%# if @simulation&.region == 'wallonie' %>
            <div class="section-content" data-section="audit-logement-wallonie" data-decision-hub-target="auditLogementWallonieSection">
              <div class="row g-4">
                <div class="col-12">
                  <%= render 'decision_hub/info_cards/audit_logement_wallonie' %>
                </div>
              </div>
            </div>
          <%# end %>

          <!-- Section Certificat PEB Flandre -->
          <% if @default_simulation&.region == 'flandre' %>
            <div class="section-content" data-section="certificat-peb-flandre" data-decision-hub-target="certificatPebFlandreSection">
              <div class="row g-4">
                <div class="col-12">
                  <%= render 'decision_hub/info_cards/certificat_peb_flandre' %>
                </div>
              </div>
            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Styles pour les onglets */
  .step-tab {
    transition: all 0.3s ease;
  }

  .step-tab:hover {
    background-color: rgba(0,123,255,0.05);
    transform: translateY(-2px);
  }

  .step-tab.active {
    background-color: rgba(0,123,255,0.1);
    border-left: 4px solid #007bff;
  }

  .step-tab.active .step-number {
    transform: scale(1.1);
  }

  /* Gestion de l'affichage des sections */
  .section-content {
    display: none;
  }

  .section-content[data-section="resume"] {
    display: block; /* Section résumé visible par défaut */
  }

  /* Animation pour les changements de section */
  .section-content {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
