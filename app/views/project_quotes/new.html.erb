<% content_for :title, "Ajouter un devis" %>

<div class="container py-4" style="max-width: 800px;">
  <div class="d-flex align-items-center mb-4">
    <%= link_to project_project_quotes_path(@project), class: "btn btn-outline-secondary btn-sm me-3" do %>
      <i class="bi bi-arrow-left"></i>
    <% end %>
    <div style="min-width: 0;">
      <h3 class="mb-0 text-truncate">Ajouter un devis</h3>
      <p class="text-muted small mb-0 text-truncate"><%= @project.nom %></p>
    </div>
  </div>

  <%= simple_form_for [@project, @project_quote] do |f| %>
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-transparent border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-receipt me-2"></i>Informations générales</h6>
      </div>
      <div class="card-body p-4">
        <%= f.error_notification %>
        <div class="row g-3">
          <div class="col-md-6">
            <%= f.input :entreprise_nom, label: "Entreprise", input_html: { class: "form-control" } %>
          </div>
          <div class="col-md-6">
            <%= f.input :lot_id, label: "Lot", as: :select,
                collection: @project.lots.ordered, label_method: :name, value_method: :id,
                include_blank: "Tous les lots", input_html: { class: "form-select" } %>
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-list-ul me-2"></i>Postes</h6>
      </div>
      <div class="card-body p-4">
        <%= f.simple_fields_for :lines do |l| %>
          <div class="row g-2 mb-2 align-items-start">
            <div class="col-12 col-md-5">
              <%= l.input :description, label: "Description", input_html: { class: "form-control" } %>
            </div>
            <div class="col-4 col-md-2">
              <%= l.input :quantite, label: "Qté", input_html: { class: "form-control" } %>
            </div>
            <div class="col-4 col-md-2">
              <%= l.input :unite, label: "Unité", input_html: { class: "form-control" } %>
            </div>
            <div class="col-4 col-md-3">
              <%= l.input :prix_unitaire_ht, label: "Prix unitaire HT", input_html: { class: "form-control" } %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="card-footer bg-transparent d-flex flex-wrap gap-2 justify-content-end">
        <%= link_to "Annuler", project_project_quotes_path(@project), class: "btn btn-outline-secondary" %>
        <%= f.submit "Ajouter le devis", class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>
