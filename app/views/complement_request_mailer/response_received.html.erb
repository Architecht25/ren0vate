<div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background: linear-gradient(135deg, #0d6efd, #0a58ca); color: white; padding: 24px 20px; border-radius: 8px 8px 0 0;">
    <h1 style="margin: 0; font-size: 1.2em;">📨 Réponse reçue</h1>
  </div>

  <div style="background-color: #f8f9fa; padding: 24px; border-radius: 0 0 8px 8px;">
    <p>Bonjour,</p>

    <p><strong><%= @client.first_name.presence || @client.email %></strong> a répondu au complément d'information sur le dossier <strong><%= @request.title %></strong>.</p>

    <p style="text-align: center; margin-top: 24px;">
      <%= link_to "Voir la réponse",
                  request_progress_complement_request_url(request_progress_id: @request_progress.id, id: @complement_request.id, locale: I18n.locale),
                  style: "display: inline-block; padding: 12px 24px; background-color: #0d6efd; color: white; text-decoration: none; border-radius: 6px; font-weight: bold;" %>
    </p>
  </div>

  <div style="text-align: center; margin-top: 20px; font-size: 0.82em; color: #6c757d;">
    Ren0vate — suivi des demandes de prime
  </div>
</div>
