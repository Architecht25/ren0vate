<div class="container-fluid px-4 py-4">
  <%= render layout: "shared/page_header", locals: { title: "Avenants", subtitle: @project.nom } do %>
    <%= link_to new_project_project_amendment_path(@project), class: "btn btn-primary-custom px-4" do %>
      <i class="bi bi-plus-lg me-2"></i>Proposer un avenant
    <% end %>
  <% end %>

  <% if @project_amendments.any? %>
    <ul class="list-group">
      <% @project_amendments.each do |amendment| %>
        <li class="list-group-item">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="fw-bold"><%= amendment.motif %></div>
              <div class="text-muted small">Demandé par <%= amendment.requested_by.full_name.presence || amendment.requested_by.email %></div>
            </div>
            <div class="text-end">
              <div class="<%= amendment.delta_montant >= 0 ? 'text-danger' : 'text-success' %> fw-bold">
                <%= number_to_currency(amendment.delta_montant, unit: "€", format: "%n %u") %>
              </div>
              <span class="badge bg-<%= amendment.valide? ? 'success' : (amendment.refuse? ? 'danger' : 'secondary') %>"><%= amendment.status.humanize %></span>
            </div>
          </div>
          <% if policy(amendment).decide? && amendment.propose? %>
            <div class="mt-2">
              <%= button_to "Valider", decide_project_amendment_path(amendment, status: "valide"), method: :patch, class: "btn btn-sm btn-success" %>
              <%= button_to "Refuser", decide_project_amendment_path(amendment, status: "refuse"), method: :patch, class: "btn btn-sm btn-outline-danger" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="text-center text-muted py-5">Aucun avenant pour l'instant.</div>
  <% end %>
</div>
