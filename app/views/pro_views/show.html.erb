<%# app/views/pro_views/show.html.erb %>
<%# Dashboard professionnel — vue adaptée selon @membership.role %>

<% content_for :title, "#{@membership.role_label} — #{@project.name} — Ren0vate" %>

<div class="container-fluid py-4 px-3 px-md-4" style="max-width:1140px;">

  <%# ── En-tête projet ──────────────────────────── %>
  <div class="card border-0 shadow-sm rounded-3 mb-4"
       style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);color:white;">
    <div class="card-body px-4 py-3">
      <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
             style="width:48px;height:48px;background:rgba(255,255,255,0.15);">
          <% if @membership.role == 'entrepreneur' %>
            <i class="bi bi-hammer" style="font-size:1.3rem;"></i>
          <% else %>
            <i class="bi bi-building" style="font-size:1.3rem;"></i>
          <% end %>
        </div>
        <div>
          <div style="font-size:0.75rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.05em;">
            <%= @membership.role_label %>
          </div>
          <h1 class="mb-0 fw-semibold" style="font-size:1.25rem;"><%= @project.name %></h1>
          <% if @property %>
            <div style="font-size:0.85rem;opacity:0.75;">
              <i class="bi bi-geo-alt me-1"></i>
              <%= @property.try(:adresse) || @property.try(:address) || "" %>
              ·
              Propriétaire : <%= @project.user.full_name %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Variables partagées ──────────────────────────────── %>
  <%
    chantier_phases_all = [
      { key: 'phase_preparation',  label: 'Préparation',  icon: 'bi-tools',            color: '#6c757d', section: 'section-preparation' },
      { key: 'phase_demolition',   label: 'Démolition',   icon: 'bi-hammer',            color: '#dc3545', section: 'section-suivi'        },
      { key: 'phase_installation', label: 'Installation', icon: 'bi-wrench-adjustable', color: '#fd7e14', section: 'section-suivi'        },
      { key: 'phase_finition',     label: 'Finitions',    icon: 'bi-brush',             color: '#0dcaf0', section: 'section-suivi'        },
      { key: 'phase_reception',    label: 'Réception',    icon: 'bi-check2-circle',     color: '#198754', section: 'section-reception'    }
    ]
    current_role = if @project.user_id == current_user.id
                     'owner'
                   elsif @project.project_members.active.where(user: current_user, role: 'architect').exists?
                     'architect'
                   elsif @project.project_members.active.where(user: current_user, role: 'entrepreneur').exists?
                     'entrepreneur'
                   elsif @project.project_members.active.where(user: current_user, role: 'intermediary').exists?
                     'intermediary'
                   end
    can_validate   = current_role.present?
    required_roles = ['owner']
    required_roles << 'architect'    if @project.project_members.active.where(role: 'architect').exists?
    required_roles << 'entrepreneur' if @project.project_members.active.where(role: 'entrepreneur').exists?
    role_labels = { 'owner' => 'Propriétaire', 'architect' => 'Architecte', 'entrepreneur' => 'Entrepreneur', 'intermediary' => 'Intermédiaire' }
    role_icons  = { 'owner' => 'bi-house',      'architect' => 'bi-pencil-ruler', 'entrepreneur' => 'bi-tools', 'intermediary' => 'bi-people'  }
    role_colors = { 'owner' => 'primary',        'architect' => 'info',            'entrepreneur' => 'warning',  'intermediary' => 'purple'     }
    suivi_phase_keys = %w[phase_preparation phase_demolition phase_installation phase_finition]
    nb_phases_validees = suivi_phase_keys.count { |k| (@phases_avancement || {})[k].present? }
    pct_global = (nb_phases_validees * 100.0 / 4).round
    phase_data_for = ->(key) {
      raw = (@phases_avancement || {})[key]
      if raw.is_a?(Hash) && raw['validated_at'].present? && raw['owner'].nil?
        { 'owner' => { 'validated_at' => raw['validated_at'], 'validated_by' => raw['validated_by'] } }
      else
        raw || {}
      end
    }
  %>

  <%# ── Navigation mobile (ancres) ──────────────────────── %>
  <div class="d-lg-none mb-3">
    <div class="d-flex gap-2 overflow-auto pb-1" style="scrollbar-width:none;">
      <a href="#section-preparation" class="btn btn-sm btn-outline-primary rounded-pill flex-shrink-0" style="font-size:0.78rem;">
        <i class="bi bi-1-circle me-1"></i>Préparation
      </a>
      <a href="#section-suivi" class="btn btn-sm btn-outline-warning rounded-pill flex-shrink-0" style="font-size:0.78rem;">
        <i class="bi bi-2-circle me-1"></i>Suivi
      </a>
      <a href="#section-reception" class="btn btn-sm btn-outline-success rounded-pill flex-shrink-0" style="font-size:0.78rem;">
        <i class="bi bi-3-circle me-1"></i>Réception
      </a>
    </div>
  </div>

  <div class="row g-4">

    <%# ── CONTENU PRINCIPAL (DOM first, visuellement à droite sur desktop) ── %>
    <div class="col-lg-9 order-1 order-lg-2">

      <%# ═══════════════════════════════════════════ %>
      <%# SECTION 1 — PRÉPARATION                  %>
      <%# ═══════════════════════════════════════════ %>
      <div id="section-preparation" class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom:2px solid rgba(13,110,253,0.15);">
          <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
               style="width:28px;height:28px;background:#0d6efd;font-size:0.78rem;">1</div>
          <h2 class="mb-0 fw-semibold" style="font-size:1.05rem;">Préparation</h2>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-auto" style="font-size:0.68rem;">Avant travaux</span>
        </div>

      <%# SCOPE DES TRAVAUX ── %>
      <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-header bg-white border-bottom pt-3 pb-2 px-4">
          <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;">
            <i class="bi bi-list-check me-2 text-primary"></i>Scope des travaux (estimatif client)
          </h5>
        </div>
        <div class="card-body px-4 py-3">
          <% if @quote&.quote_items&.any? %>
            <table class="table table-sm mb-0" style="font-size:0.85rem;">
              <thead>
                <tr class="text-muted" style="font-size:0.78rem;">
                  <th class="fw-normal ps-0">Poste de travaux</th>
                  <% if @membership.full_financial_access? || @membership.role == 'architect' %>
                    <th class="fw-normal text-end">Fourchette</th>
                  <% end %>
                </tr>
              </thead>
              <tbody>
                <% @quote.quote_items.each do |item| %>
                  <tr>
                    <td class="ps-0">
                      <i class="bi bi-check-circle-fill text-success me-1" style="font-size:0.7rem;"></i>
                      <%= item.work_type&.name || item.work_type_key.humanize %>
                      <% if item.quantity && item.unit %>
                        <span class="text-muted ms-1" style="font-size:0.75rem;">
                          <%= item.quantity %> <%= item.unit %>
                        </span>
                      <% end %>
                    </td>
                    <% if @membership.full_financial_access? || @membership.role == 'architect' %>
                      <td class="text-end text-muted" style="white-space:nowrap;">
                        <% min_p = item.try(:unit_price_min) || item.try(:total_min) %>
                        <% max_p = item.try(:unit_price_max) || item.try(:total_max) %>
                        <% if min_p && max_p %>
                          <%= number_to_currency(min_p, unit: "€", format: "%n %u") %> –
                          <%= number_to_currency(max_p, unit: "€", format: "%n %u") %>
                        <% elsif item.try(:total_price) %>
                          <%= number_to_currency(item.total_price, unit: "€", format: "%n %u") %>
                        <% end %>
                      </td>
                    <% end %>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <% if @membership.full_financial_access? %>
              <% total_min = @quote.quote_items.sum { |i| i.try(:total_min).to_f } %>
              <% total_max = @quote.quote_items.sum { |i| i.try(:total_max).to_f } %>
              <% if total_min > 0 || total_max > 0 %>
                <hr class="my-2">
                <div class="d-flex justify-content-between fw-semibold" style="font-size:0.88rem;">
                  <span>Fourchette totale</span>
                  <span class="text-primary">
                    <%= number_to_currency(total_min, unit: "€", format: "%n %u") %> –
                    <%= number_to_currency(total_max, unit: "€", format: "%n %u") %>
                  </span>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <p class="text-muted mb-0" style="font-size:0.85rem;">
              <i class="bi bi-info-circle me-1"></i>Aucun devis estimatif disponible pour l'instant.
            </p>
          <% end %>
        </div>
      </div>

      <%# UPLOAD DEVIS (entrepreneur uniquement) ── %>
      <% if @membership.can_upload_quote? %>
        <div class="card border-0 shadow-sm rounded-3 mb-3">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4">
            <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;">
              <i class="bi bi-upload me-2 text-warning"></i>Votre devis
            </h5>
          </div>
          <div class="card-body px-4 py-3">
            <% entrepreneur_factures = @factures&.select { |f| f.type_facture == 'devis' } || [] %>
            <% if entrepreneur_factures.any? %>
              <% entrepreneur_factures.each do |f| %>
                <div class="d-flex align-items-center gap-2 mb-2 p-2 rounded
                     <%= f.validated_by_client_at ? 'bg-success-subtle' : 'bg-light' %>">
                  <i class="bi bi-file-earmark-pdf text-danger flex-shrink-0" style="font-size:1.1rem;"></i>
                  <div class="flex-grow-1 min-width-0">
                    <div class="fw-medium text-truncate" style="font-size:0.83rem;">
                      <%= f.nom_entreprise.presence || "Mon devis" %>
                    </div>
                    <div class="text-muted" style="font-size:0.73rem;">
                      <% if f.montant.to_f > 0 %>
                        <%= number_to_currency(f.montant, unit: "€", format: "%n %u", separator: ',', delimiter: '.', precision: 0) %> ·
                      <% end %>
                      Envoyé le <%= f.created_at.strftime("%d/%m/%Y") %>
                    </div>
                  </div>
                  <% if f.validated_by_client_at %>
                    <span class="badge bg-success" style="font-size:0.65rem;">Validé ✓</span>
                  <% else %>
                    <span class="badge bg-warning text-dark" style="font-size:0.65rem;">En attente</span>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <%= form_with url: upload_facture_pro_project_path(@project), method: :post,
                          multipart: true, class: "mt-2" do |f| %>
              <%= hidden_field_tag :type_facture, 'devis' %>
              <div class="row g-2 align-items-end">
                <div class="col-md-5">
                  <%= label_tag :facture_pdf, "Fichier PDF / image", class: "form-label mb-0", style: "font-size:0.8rem;" %>
                  <%= file_field_tag :facture_pdf, class: "form-control form-control-sm mt-1", accept: ".pdf,.jpg,.jpeg,.png" %>
                </div>
                <div class="col-md-3">
                  <%= label_tag :montant_ttc, "Montant TTC (€)", class: "form-label mb-0", style: "font-size:0.8rem;" %>
                  <%= number_field_tag :montant_ttc, nil, class: "form-control form-control-sm mt-1",
                        placeholder: "Ex: 12500", min: 0, step: 0.01 %>
                </div>
                <div class="col-md-4">
                  <%= f.submit "Envoyer mon devis", class: "btn btn-warning btn-sm w-100", style: "font-size:0.8rem;" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# VALIDATION DEVIS ENTREPRENEUR (propriétaire uniquement) ── %>
      <% if @project.user_id == current_user.id %>
        <%
          devis_a_valider = @project.factures
                                    .entrepreneur
                                    .devis
                                    .where(validated_by_client_at: nil)
                                    .includes(:document)
        %>
        <% if devis_a_valider.any? %>
          <div class="card border-0 shadow-sm rounded-3 mb-3"
               style="border:1px solid #ffc107 !important;">
            <div class="card-header pt-3 pb-2 px-4"
                 style="background:#fff8e1;border-bottom:1px solid #ffc107;">
              <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;color:#856404;">
                <i class="bi bi-exclamation-circle me-2"></i>Devis à valider (<%= devis_a_valider.count %>)
              </h5>
            </div>
            <div class="card-body px-4 py-3">
              <% devis_a_valider.each do |f| %>
                <div class="d-flex align-items-center gap-2 p-2 rounded mb-2 bg-warning-subtle">
                  <i class="bi bi-file-earmark-pdf text-danger flex-shrink-0" style="font-size:1.1rem;"></i>
                  <div class="flex-grow-1">
                    <div class="fw-medium" style="font-size:0.83rem;">
                      <%= f.nom_entreprise.presence || "Devis entrepreneur" %>
                    </div>
                    <div class="text-muted" style="font-size:0.73rem;">
                      <% if f.montant.to_f > 0 %>
                        <%= number_to_currency(f.montant, unit: "€", format: "%n %u", separator: ',', delimiter: '.', precision: 0) %> ·
                      <% end %>
                      Reçu le <%= f.created_at.strftime("%d/%m/%Y") %>
                    </div>
                  </div>
                  <%= button_to validate_by_client_facture_path(f),
                        method: :patch,
                        class: "btn btn-success btn-sm flex-shrink-0",
                        style: "font-size:0.75rem;",
                        data: { turbo_confirm: "Valider ce devis de #{f.nom_entreprise.presence || 'l\'entrepreneur'} ?" } do %>
                    <i class="bi bi-check2 me-1"></i>Valider
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <%# ── BLOC ARCHITECTE : Permis, Plans & Métré ─────────────────────── %>
      <% if @membership.can_manage_permis? %>
        <div class="card border-0 shadow-sm rounded-3 mb-3" style="border-left:3px solid #0dcaf0 !important;">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4 d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;">
              <i class="bi bi-building-gear me-2 text-info"></i>Permis d'urbanisme
            </h5>
            <button class="btn btn-sm btn-outline-secondary rounded-3" type="button"
                    data-bs-toggle="collapse" data-bs-target="#permis-edit-form-<%= @project.id %>"
                    aria-expanded="true">
              <i class="bi bi-pencil me-1"></i><span style="font-size:0.78rem;">Infos permis</span>
            </button>
          </div>
          <div class="card-body px-4 py-3">

            <%# Stepper statut %>
            <%
              statut_config = @permis_statut_config
              current_statut = statut_config[@project.permis_urbanisme_statut] ||
                               { label: 'Non renseigné', color: 'light text-muted', icon: 'bi-question-circle' }
              stepper_steps = [
                { key: 'a_deposer', label: 'À déposer',  icon: 'bi-send',              color: 'info'    },
                { key: 'en_cours',  label: 'En cours',   icon: 'bi-hourglass-split',   color: 'warning' },
                { key: 'obtenu',    label: 'Obtenu',     icon: 'bi-check-circle-fill', color: 'success' }
              ]
              current = @project.permis_urbanisme_statut.to_s
              current_idx = stepper_steps.index { |s| s[:key] == current }
              historique = (@project.permis_urbanisme_historique || []).sort_by { |h| h['changed_at'] || '' }
              statut_date = historique.group_by { |h| h['statut'] }.transform_values { |arr| arr.last['changed_at'] }
            %>

            <% if current == 'refuse' %>
              <div class="d-flex align-items-center gap-2 mb-3 px-2 py-2 rounded-3" style="background:rgba(220,53,69,0.07);">
                <i class="bi bi-x-circle-fill text-danger"></i>
                <span class="text-danger fw-semibold" style="font-size:0.85rem;">Permis refusé</span>
              </div>
            <% elsif current == 'non_requis' %>
              <div class="d-flex align-items-center gap-2 mb-3 px-2 py-2 rounded-3" style="background:rgba(108,117,125,0.08);">
                <i class="bi bi-slash-circle text-secondary"></i>
                <span class="text-muted fw-semibold" style="font-size:0.82rem;">Permis non requis</span>
              </div>
            <% elsif current.present? %>
              <div class="d-flex align-items-center mb-3" style="gap:0;">
                <% stepper_steps.each_with_index do |step, idx| %>
                  <%
                    is_done    = current_idx && idx < current_idx
                    is_current = current_idx && idx == current_idx
                    step_date  = statut_date[step[:key]]
                  %>
                  <div class="d-flex flex-column align-items-center flex-shrink-0" style="min-width:64px;">
                    <div class="rounded-circle d-flex align-items-center justify-content-center
                                <%= is_done || is_current ? "bg-#{step[:color]}" : 'bg-light border' %>"
                         style="width:32px;height:32px;">
                      <% if is_done %>
                        <i class="bi bi-check2 text-white" style="font-size:0.85rem;"></i>
                      <% elsif is_current %>
                        <i class="bi <%= step[:icon] %> text-white" style="font-size:0.75rem;"></i>
                      <% else %>
                        <i class="bi <%= step[:icon] %> text-secondary" style="font-size:0.75rem;"></i>
                      <% end %>
                    </div>
                    <div class="text-center mt-1" style="font-size:0.62rem; line-height:1.2;
                                 color:<%= is_current ? "var(--bs-#{step[:color]})" : is_done ? '#6c757d' : '#adb5bd' %>;
                                 font-weight:<%= is_current ? '600' : '400' %>;">
                      <%= step[:label] %>
                      <% if step_date.present? %>
                        <div style="font-size:0.58rem;color:#adb5bd;">
                          <%= Time.zone.parse(step_date).strftime('%d/%m') rescue '' %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                  <% if idx < stepper_steps.size - 1 %>
                    <div class="flex-grow-1" style="height:2px;margin-bottom:22px;
                                 background:<%= is_done ? "var(--bs-#{step[:color]})" : '#dee2e6' %>;"></div>
                  <% end %>
                <% end %>
              </div>
            <% end %>

            <%# Infos permis existantes %>
            <% if [@project.permis_urbanisme_number, @project.permis_urbanisme_date, @project.permis_urbanisme_autorite].any?(&:present?) %>
              <div class="mb-3 p-2 rounded-3" style="background:rgba(0,0,0,0.03);">
                <% if @project.permis_urbanisme_number.present? %>
                  <div style="font-size:0.75rem;"><span class="text-muted">N° :</span> <strong class="ms-1"><%= @project.permis_urbanisme_number %></strong></div>
                <% end %>
                <% if @project.permis_urbanisme_date.present? %>
                  <div style="font-size:0.75rem;"><span class="text-muted">Délivré le :</span> <span class="ms-1"><%= @project.permis_urbanisme_date.strftime("%d/%m/%Y") %></span></div>
                <% end %>
                <% if @project.permis_urbanisme_autorite.present? %>
                  <div class="text-muted" style="font-size:0.72rem;"><%= @project.permis_urbanisme_autorite %></div>
                <% end %>
                <% if @project.permis_urbanisme_notes.present? %>
                  <div class="text-muted fst-italic mt-1" style="font-size:0.72rem;"><%= truncate(@project.permis_urbanisme_notes, length: 80) %></div>
                <% end %>
              </div>
            <% end %>

            <%# Formulaire mise à jour permis %>
            <div class="collapse show mb-3" id="permis-edit-form-<%= @project.id %>">
              <div class="p-3 rounded-3 border bg-light">
                <p class="fw-semibold mb-2" style="font-size:0.85rem;"><i class="bi bi-pencil-square me-1 text-secondary"></i>Informations sur le permis</p>
                <%= form_with url: update_permis_pro_project_path(@project), method: :patch do |f| %>
                  <div class="mb-2">
                    <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Statut</label>
                    <select name="project[permis_urbanisme_statut]" class="form-select form-select-sm rounded-3">
                      <option value="">— Non renseigné —</option>
                      <option value="non_requis" <%= 'selected' if @project.permis_urbanisme_statut == 'non_requis' %>>Non requis</option>
                      <option value="a_deposer"  <%= 'selected' if @project.permis_urbanisme_statut == 'a_deposer'  %>>À déposer</option>
                      <option value="en_cours"   <%= 'selected' if @project.permis_urbanisme_statut == 'en_cours'   %>>En cours</option>
                      <option value="obtenu"     <%= 'selected' if @project.permis_urbanisme_statut == 'obtenu'     %>>Obtenu</option>
                      <option value="refuse"     <%= 'selected' if @project.permis_urbanisme_statut == 'refuse'     %>>Refusé</option>
                    </select>
                  </div>
                  <div class="mb-2">
                    <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Numéro de permis</label>
                    <input type="text" name="project[permis_urbanisme_number]"
                           value="<%= @project.permis_urbanisme_number %>"
                           class="form-control form-control-sm rounded-3" placeholder="URB/2025/00123">
                  </div>
                  <div class="mb-2">
                    <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Date de délivrance</label>
                    <input type="date" name="project[permis_urbanisme_date]"
                           value="<%= @project.permis_urbanisme_date&.strftime('%Y-%m-%d') %>"
                           class="form-control form-control-sm rounded-3">
                  </div>
                  <div class="mb-2">
                    <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Autorité délivrante</label>
                    <input type="text" name="project[permis_urbanisme_autorite]"
                           value="<%= @project.permis_urbanisme_autorite %>"
                           class="form-control form-control-sm rounded-3" placeholder="Administration communale de…">
                  </div>
                  <div class="mb-3">
                    <label class="form-label text-muted mb-1" style="font-size:0.75rem;">Notes / conditions</label>
                    <textarea name="project[permis_urbanisme_notes]"
                              class="form-control form-control-sm rounded-3" rows="2"
                              placeholder="Conditions particulières, recours…"><%= @project.permis_urbanisme_notes %></textarea>
                  </div>
                  <%= f.submit "Enregistrer", class: "btn btn-sm btn-primary w-100 rounded-3" %>
                <% end %>
              </div>
            </div>

            <%# Documents permis existants %>
            <% if @permis_docs.any? %>
              <div class="mb-2">
                <div class="d-flex align-items-center justify-content-between mb-1">
                  <span class="small fw-semibold text-muted">Documents permis (<%= @permis_docs.count %>)</span>
                </div>
                <% @permis_docs.first(3).each do |doc| %>
                  <div class="d-flex align-items-center gap-2 mb-1 pb-1 border-bottom">
                    <i class="bi bi-file-earmark-text text-secondary flex-shrink-0" style="font-size:0.85rem;"></i>
                    <div class="flex-grow-1 overflow-hidden">
                      <div class="text-truncate" style="font-size:0.8rem;"><%= doc.file_name.presence || "Document permis" %></div>
                      <div class="text-muted" style="font-size:0.7rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
                    </div>
                    <%= link_to rails_blob_path(doc, disposition: 'inline'), target: '_blank', class: "btn btn-sm btn-outline-secondary py-0 px-1" do %>
                      <i class="bi bi-eye" style="font-size:0.75rem;"></i>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <%# Upload document permis %>
            <%= form_with url: upload_document_pro_project_path(@project), method: :post, multipart: true, class: "mb-0" do |f| %>
              <%= hidden_field_tag :type_document, 'permis_urbanisme' %>
              <div class="row g-2 align-items-end">
                <div class="col-8">
                  <label class="form-label text-muted mb-0" style="font-size:0.75rem;">Ajouter un document permis</label>
                  <%= file_field_tag :document_file, class: "form-control form-control-sm mt-1 rounded-3",
                        accept: ".pdf,.jpg,.jpeg,.png" %>
                </div>
                <div class="col-4">
                  <button type="submit" class="btn btn-sm btn-outline-secondary w-100 rounded-3" style="font-size:0.78rem;">
                    <i class="bi bi-upload me-1"></i>Ajouter
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# ── Plans du bien ── %>
        <div class="card border-0 shadow-sm rounded-3 mb-3" style="border-left:3px solid #0dcaf0 !important;">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4">
            <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;">
              <i class="bi bi-rulers me-2 text-info"></i>Plans architecturaux
            </h5>
          </div>
          <div class="card-body px-4 py-3">
            <% if @plans_docs.any? %>
              <% @plans_docs.each do |doc| %>
                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                  <i class="bi bi-file-earmark-ruled text-info flex-shrink-0" style="font-size:1rem;"></i>
                  <div class="flex-grow-1 overflow-hidden">
                    <div class="text-truncate fw-medium" style="font-size:0.82rem;"><%= doc.file_name.presence || "Plan" %></div>
                    <div class="text-muted" style="font-size:0.7rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
                  </div>
                  <%= link_to rails_blob_path(doc, disposition: 'inline'), target: '_blank',
                        class: "btn btn-sm btn-outline-info py-0 px-2 flex-shrink-0" do %>
                    <i class="bi bi-eye" style="font-size:0.75rem;"></i>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <p class="text-muted mb-2" style="font-size:0.83rem;">
                <i class="bi bi-info-circle me-1"></i>Aucun plan ajouté.
              </p>
            <% end %>
            <%= form_with url: upload_document_pro_project_path(@project), method: :post, multipart: true do |f| %>
              <%= hidden_field_tag :type_document, 'plan' %>
              <div class="row g-2 align-items-end">
                <div class="col-8">
                  <label class="form-label text-muted mb-0" style="font-size:0.75rem;">Ajouter un plan (PDF/image)</label>
                  <%= file_field_tag :document_file, class: "form-control form-control-sm mt-1 rounded-3",
                        accept: ".pdf,.jpg,.jpeg,.png,.dwg" %>
                </div>
                <div class="col-4">
                  <button type="submit" class="btn btn-sm btn-outline-info w-100 rounded-3" style="font-size:0.78rem;">
                    <i class="bi bi-upload me-1"></i>Ajouter
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# ── Métré ── %>
        <div class="card border-0 shadow-sm rounded-3 mb-3" style="border-left:3px solid #0dcaf0 !important;">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4">
            <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;">
              <i class="bi bi-list-columns-reverse me-2 text-info"></i>Métré
              <span class="badge bg-info-subtle text-info border border-info-subtle ms-1" style="font-size:0.6rem;">
                partagé avec l'entrepreneur
              </span>
            </h5>
          </div>
          <div class="card-body px-4 py-3">
            <p class="text-muted mb-3" style="font-size:0.8rem;">
              Le métré liste tous les postes de travaux avec quantités et unités. L'entrepreneur peut le consulter pour y adjoindre ses prix.
            </p>
            <% if @metres&.any? %>
              <% @metres.each do |doc| %>
                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                  <i class="bi bi-file-earmark-spreadsheet text-info flex-shrink-0" style="font-size:1rem;"></i>
                  <div class="flex-grow-1 overflow-hidden">
                    <div class="text-truncate fw-medium" style="font-size:0.82rem;"><%= doc.file_name.presence || "Métré" %></div>
                    <div class="text-muted" style="font-size:0.7rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
                  </div>
                  <%= link_to rails_blob_path(doc, disposition: 'inline'), target: '_blank',
                        class: "btn btn-sm btn-outline-info py-0 px-2 flex-shrink-0" do %>
                    <i class="bi bi-eye" style="font-size:0.75rem;"></i>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <p class="text-muted mb-2" style="font-size:0.83rem;">
                <i class="bi bi-info-circle me-1"></i>Aucun métré déposé.
              </p>
            <% end %>
            <%= form_with url: upload_document_pro_project_path(@project), method: :post, multipart: true do |f| %>
              <%= hidden_field_tag :type_document, 'metre' %>
              <div class="row g-2 align-items-end">
                <div class="col-8">
                  <label class="form-label text-muted mb-0" style="font-size:0.75rem;">Déposer un métré (PDF / Excel)</label>
                  <%= file_field_tag :document_file, class: "form-control form-control-sm mt-1 rounded-3",
                        accept: ".pdf,.xlsx,.xls,.csv,.jpg,.jpeg,.png" %>
                </div>
                <div class="col-4">
                  <button type="submit" class="btn btn-sm btn-info w-100 rounded-3 text-white" style="font-size:0.78rem;">
                    <i class="bi bi-upload me-1"></i>Déposer
                  </button>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# ── BLOC ENTREPRENEUR : Lecture du métré ────────────────────────── %>
      <% if @membership.can_view_metre? && !@membership.can_manage_permis? && @metres&.any? %>
        <div class="card border-0 shadow-sm rounded-3 mb-3" style="border-left:3px solid #ffc107 !important;">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4">
            <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;">
              <i class="bi bi-list-columns-reverse me-2 text-warning"></i>Métré de l'architecte
            </h5>
          </div>
          <div class="card-body px-4 py-3">
            <p class="text-muted mb-3" style="font-size:0.8rem;">
              Document de référence transmis par l'architecte — liste les postes à chiffrer.
            </p>
            <% @metres.each do |doc| %>
              <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom">
                <i class="bi bi-file-earmark-spreadsheet text-warning flex-shrink-0" style="font-size:1rem;"></i>
                <div class="flex-grow-1 overflow-hidden">
                  <div class="text-truncate fw-medium" style="font-size:0.82rem;"><%= doc.file_name.presence || "Métré" %></div>
                  <div class="text-muted" style="font-size:0.7rem;"><%= doc.created_at.strftime("%d/%m/%Y") %></div>
                </div>
                <%= link_to rails_blob_path(doc, disposition: 'inline'), target: '_blank',
                      class: "btn btn-sm btn-outline-warning py-0 px-2 flex-shrink-0" do %>
                  <i class="bi bi-download" style="font-size:0.75rem;"></i>
                <% end %>
              </div>
            <% end %>
            <p class="text-muted fst-italic mb-0" style="font-size:0.75rem;">
              <i class="bi bi-lock me-1"></i>Lecture seule — contactez l'architecte pour toute modification.
            </p>
          </div>
        </div>
      <% end %>

      </div><%# /section-preparation %>

      <%# ═══════════════════════════════════════════════════ %>
      <%# SECTION 2 — SUIVI D'EXÉCUTION                     %>
      <%# ═══════════════════════════════════════════════════ %>
      <div id="section-suivi" class="mb-5">
        <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom:2px solid rgba(253,126,20,0.2);">
          <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
               style="width:28px;height:28px;background:#fd7e14;font-size:0.78rem;">2</div>
          <h2 class="mb-0 fw-semibold" style="font-size:1.05rem;">Suivi d'exécution</h2>
          <span class="badge bg-warning-subtle text-warning border border-warning-subtle ms-auto" style="font-size:0.68rem;">
            <%= nb_phases_validees %>/4 phases · <%= pct_global %>%
          </span>
        </div>

        <%# Phases 1–4 en grille 2×2 %>
        <div class="row g-3 mb-3">
          <% chantier_phases_all.first(4).each do |phase| %>
            <%
              phase_d      = phase_data_for.call(phase[:key])
              all_val      = required_roles.all? { |r| phase_d[r].present? }
              user_val     = current_role && phase_d[current_role].present?
              phase_photos = (@photos_by_phase || {})[phase[:key]] || []
            %>
            <div class="col-md-6">
              <div class="card border-0 shadow-sm rounded-3 h-100"
                   style="border:1px solid <%= all_val ? '#a3cfbb' : '#e9ecef' %> !important;background:<%= all_val ? '#f0faf4' : 'white' %>;">
                <div class="card-body p-3">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                           style="width:26px;height:26px;background:<%= all_val ? '#19875420' : phase[:color] + '20' %>;">
                        <i class="bi <%= phase[:icon] %>" style="font-size:0.68rem;color:<%= all_val ? '#198754' : phase[:color] %>;"></i>
                      </div>
                      <span class="fw-semibold <%= all_val ? 'text-success' : '' %>" style="font-size:0.88rem;">
                        <%= phase[:label] %>
                      </span>
                      <% if phase_photos.any? %>
                        <span class="badge bg-secondary-subtle text-secondary" style="font-size:0.6rem;">
                          <%= phase_photos.count %> <i class="bi bi-image"></i>
                        </span>
                      <% end %>
                    </div>
                    <% if all_val %>
                      <i class="bi bi-check-circle-fill text-success flex-shrink-0" style="font-size:1rem;"></i>
                    <% elsif user_val %>
                      <span class="text-success flex-shrink-0" style="font-size:0.65rem;">✓ validé</span>
                    <% elsif can_validate %>
                      <%= button_to validate_phase_project_path(@project),
                          method: :patch,
                          params: { phase_key: phase[:key] },
                          class: "btn btn-outline-success btn-sm py-0 px-2 flex-shrink-0",
                          style: "font-size:0.7rem;" do %>
                        <i class="bi bi-check2 me-1"></i>Valider
                      <% end %>
                    <% end %>
                  </div>
                  <%# Badges signatures %>
                  <% if phase_d.any? %>
                    <div class="d-flex gap-1 flex-wrap mb-2">
                      <% required_roles.each do |r| %>
                        <% vdata = phase_d[r] %>
                        <span class="badge"
                              style="font-size:0.58rem;background:<%= vdata ? 'rgba(25,135,84,0.12)' : 'rgba(108,117,125,0.08)' %>;color:<%= vdata ? '#198754' : '#6c757d' %>;"
                              title="<%= vdata ? "#{role_labels[r]} — #{Time.zone.parse(vdata['validated_at']).strftime('%d/%m/%Y') rescue ''}" : "#{role_labels[r]} : en attente" %>">
                          <i class="bi <%= role_icons[r] %> me-1"></i><%= role_labels[r] %>
                          <% if vdata %><i class="bi bi-check ms-1"></i><% else %><i class="bi bi-clock ms-1"></i><% end %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                  <%# Miniatures photos %>
                  <% if phase_photos.any? %>
                    <div class="d-flex gap-1 flex-wrap">
                      <% phase_photos.first(5).each do |photo| %>
                        <div class="rounded overflow-hidden flex-shrink-0" style="width:40px;height:40px;background:#dee2e6;">
                          <% begin %>
                            <%= image_tag rails_blob_path(photo, only_path: true),
                                  style: "width:40px;height:40px;object-fit:cover;", alt: phase[:label] %>
                          <% rescue %>
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                              <i class="bi bi-image text-muted" style="font-size:0.6rem;"></i>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                      <% if phase_photos.count > 5 %>
                        <div class="rounded d-flex align-items-center justify-content-center bg-secondary-subtle text-secondary flex-shrink-0"
                             style="width:40px;height:40px;font-size:0.62rem;">
                          +<%= phase_photos.count - 5 %>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <p class="text-muted mb-0" style="font-size:0.72rem;"><i class="bi bi-camera me-1"></i>Aucune photo</p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <%# Upload photo (entrepreneur) %>
        <% if @membership.role == 'entrepreneur' %>
          <div class="card border-0 shadow-sm rounded-3 mb-3" style="border-left:3px solid #fd7e14 !important;">
            <div class="card-body px-4 py-3">
              <%= form_with url: upload_facture_pro_project_path(@project), method: :post,
                            multipart: true do |f| %>
                <input type="hidden" name="type_facture" value="photo">
                <label class="form-label text-muted mb-2" style="font-size:0.8rem;">
                  <i class="bi bi-camera me-1 text-warning"></i>Ajouter une photo de chantier
                </label>
                <div class="row g-2 align-items-end">
                  <div class="col-md-4 col-6">
                    <select name="phase_photo" class="form-select form-select-sm" style="font-size:0.78rem;">
                      <option value="">Phase...</option>
                      <% chantier_phases_all.first(4).each do |ph| %>
                        <option value="<%= ph[:key] %>"><%= ph[:label] %></option>
                      <% end %>
                    </select>
                  </div>
                  <div class="col-md-6 col">
                    <input type="file" name="photo_file" class="form-control form-control-sm"
                           accept="image/*" capture="environment" style="font-size:0.78rem;">
                  </div>
                  <div class="col-md-2 col-auto">
                    <button type="submit" class="btn btn-warning btn-sm w-100">
                      <i class="bi bi-camera"></i>
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="mb-3">
            <%= link_to new_project_document_path(@project, type_document: 'photo_pendant'),
                  class: "btn btn-outline-warning btn-sm", style: "font-size:0.8rem;" do %>
              <i class="bi bi-camera me-1"></i>+ Ajouter une photo
            <% end %>
          </div>
        <% end %>

        <%# ÉTATS D'AVANCEMENT ── %>
        <div class="card border-0 shadow-sm rounded-3" style="border-left:3px solid var(--ren0vate-accent) !important;">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4 d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-semibold" style="font-size:0.9rem;">
              <i class="bi bi-receipt-cutoff me-2" style="color:var(--ren0vate-accent);"></i>États d'avancement
            </h5>
            <% if @membership.role == 'entrepreneur' || @project.user_id == current_user.id %>
              <%= link_to new_project_etats_avancement_path(@project),
                          class: "btn btn-sm rounded-3",
                          style: "background:var(--ren0vate-accent);color:#fff;border:none;font-size:0.75rem;" do %>
                <i class="bi bi-plus me-1"></i>Nouvel état
              <% end %>
            <% end %>
          </div>
          <div class="card-body px-4 py-3">
            <% etats = @project.etats_avancement.chronologique.includes(:lignes) %>
            <% if etats.any? %>
              <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" style="font-size:0.83rem;">
                  <thead style="font-size:0.75rem;" class="text-muted">
                    <tr>
                      <th class="fw-normal">N°</th>
                      <th class="fw-normal">Date</th>
                      <th class="fw-normal">Statut</th>
                      <th class="fw-normal text-center">Avancement</th>
                      <th class="fw-normal text-end">Montant</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <% etats.each do |etat| %>
                      <tr>
                        <td>
                          <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white fw-bold"
                               style="width:24px;height:24px;background:var(--ren0vate-navy);font-size:0.68rem;">
                            <%= etat.numero %>
                          </div>
                        </td>
                        <td class="text-muted">
                          <%= etat.date_emission&.strftime("%d/%m/%Y") || etat.created_at.strftime("%d/%m/%Y") %>
                        </td>
                        <td>
                          <span class="badge rounded-pill bg-<%= etat.statut_color %>" style="font-size:0.65rem;">
                            <%= etat.statut_label %>
                          </span>
                        </td>
                        <td class="text-center">
                          <div class="d-flex align-items-center gap-1 justify-content-center">
                            <div class="progress" style="height:4px;width:50px;">
                              <div class="progress-bar" style="width:<%= etat.avancement_global_pct %>%;background:var(--ren0vate-accent);"></div>
                            </div>
                            <span style="font-size:0.68rem;color:var(--ren0vate-accent);"><%= etat.avancement_global_pct %>%</span>
                          </div>
                        </td>
                        <td class="text-end fw-bold" style="color:var(--ren0vate-accent);">
                          <%= number_to_currency(etat.montant_reclame_periode, unit: '€', format: '%n %u', separator: ',', delimiter: '.') %>
                        </td>
                        <td>
                          <%= link_to project_etats_avancement_path(@project, etat),
                                class: "btn btn-sm btn-outline-secondary rounded-3 py-0 px-2",
                                style: "font-size:0.65rem;" do %>
                            <i class="bi bi-eye"></i>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="text-center py-3">
                <i class="bi bi-receipt-cutoff fs-4 text-muted d-block mb-2"></i>
                <p class="text-muted small mb-2">Aucun état d'avancement</p>
                <% if @membership.role == 'entrepreneur' %>
                  <%= link_to new_project_etats_avancement_path(@project),
                              class: "btn btn-sm rounded-3",
                              style: "background:var(--ren0vate-accent);color:#fff;border:none;font-size:0.75rem;" do %>
                    <i class="bi bi-stars me-1"></i>Créer avec l'IA
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

      </div><%# /section-suivi %>

      <%# ═══════════════════════════════════════════════════ %>
      <%# SECTION 3 — RÉCEPTION                             %>
      <%# ═══════════════════════════════════════════════════ %>
      <div id="section-reception" class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom:2px solid rgba(25,135,84,0.2);">
          <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
               style="width:28px;height:28px;background:#198754;font-size:0.78rem;">3</div>
          <h2 class="mb-0 fw-semibold" style="font-size:1.05rem;">Réception</h2>
          <span class="badge bg-success-subtle text-success border border-success-subtle ms-auto" style="font-size:0.68rem;">Clôture du chantier</span>
        </div>

        <%# Phase réception ── %>
        <%
          reception_d      = phase_data_for.call('phase_reception')
          reception_done   = required_roles.all? { |r| reception_d[r].present? }
          reception_me     = current_role && reception_d[current_role].present?
          reception_photos = (@photos_by_phase || {})['phase_reception'] || []
        %>
        <div class="card border-0 shadow-sm rounded-3 mb-3"
             style="border:1px solid <%= reception_done ? '#a3cfbb' : '#e9ecef' %> !important;background:<%= reception_done ? '#f0faf4' : 'white' %>;">
          <div class="card-header border-bottom pt-3 pb-2 px-4 d-flex align-items-center justify-content-between"
               style="background:<%= reception_done ? '#d1e7dd' : 'white' %>;">
            <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;">
              <i class="bi bi-check2-circle me-2 text-success"></i>Phase réception
              <% if reception_done %>
                <span class="badge bg-success ms-1" style="font-size:0.62rem;">Complète ✓</span>
              <% end %>
            </h5>
            <% if reception_me %>
              <span class="text-success" style="font-size:0.72rem;">✓ votre validation enregistrée</span>
            <% elsif can_validate && !reception_done %>
              <%= button_to validate_phase_project_path(@project),
                  method: :patch,
                  params: { phase_key: 'phase_reception' },
                  class: "btn btn-success btn-sm",
                  style: "font-size:0.75rem;" do %>
                <i class="bi bi-check2 me-1"></i>Valider la réception
              <% end %>
            <% end %>
          </div>
          <div class="card-body px-4 py-3">
            <div class="d-flex gap-2 flex-wrap mb-3">
              <% required_roles.each do |r| %>
                <% vdata = reception_d[r] %>
                <div class="d-flex align-items-center gap-1 px-2 py-1 rounded-2 <%= vdata ? 'bg-success-subtle' : 'bg-light' %>"
                     style="font-size:0.8rem;">
                  <i class="bi <%= role_icons[r] %> text-<%= vdata ? 'success' : 'secondary' %>"></i>
                  <span class="<%= vdata ? 'text-success fw-medium' : 'text-muted' %>"><%= role_labels[r] %></span>
                  <% if vdata %>
                    <i class="bi bi-check-circle-fill text-success" style="font-size:0.68rem;"></i>
                    <span class="text-muted" style="font-size:0.68rem;"><%= Time.zone.parse(vdata['validated_at']).strftime('%d/%m') rescue '' %></span>
                  <% else %>
                    <i class="bi bi-clock text-muted" style="font-size:0.68rem;"></i>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if reception_photos.any? %>
              <div class="d-flex gap-2 flex-wrap">
                <% reception_photos.first(6).each do |photo| %>
                  <div class="rounded overflow-hidden flex-shrink-0" style="width:56px;height:56px;background:#dee2e6;">
                    <% begin %>
                      <%= image_tag rails_blob_path(photo, only_path: true),
                            style: "width:56px;height:56px;object-fit:cover;", alt: "Réception" %>
                    <% rescue %>
                      <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                        <i class="bi bi-image text-muted"></i>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <%# PV DE RÉCEPTION ── %>
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4 d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-semibold" style="font-size:0.95rem;">
              <i class="bi bi-file-earmark-check me-2 text-success"></i>Procès-verbal de réception
            </h5>
            <% if @pv_reception %>
              <span class="badge bg-<%= @pv_reception.statut == 'finalise' ? 'success' : 'warning text-dark' %>" style="font-size:0.68rem;">
                <%= @pv_reception.statut == 'finalise' ? 'Finalisé' : 'En cours' %>
              </span>
            <% end %>
          </div>
          <div class="card-body px-4 py-3">
            <% if @pv_reception %>
              <div class="row g-3 mb-3">
                <div class="col-sm-6">
                  <div class="text-muted mb-1" style="font-size:0.72rem;">Date de réception</div>
                  <div class="fw-medium" style="font-size:0.88rem;">
                    <%= @pv_reception.date_reception&.strftime("%d/%m/%Y") || "—" %>
                  </div>
                </div>
                <div class="col-sm-6">
                  <div class="text-muted mb-1" style="font-size:0.72rem;">Signatures</div>
                  <div class="d-flex gap-1 flex-wrap">
                    <% [['Propriétaire', @pv_reception.signed_owner_at],
                        ['Architecte',   @pv_reception.signed_architect_at],
                        ['Entrepreneur', @pv_reception.signed_entrepreneur_at]].each do |label, signed_at| %>
                      <% next if label == 'Architecte' && @pv_reception.nom_architect.blank? %>
                      <span class="badge <%= signed_at ? 'bg-success' : 'bg-light text-muted border' %>" style="font-size:0.65rem;">
                        <%= label %> <%= signed_at ? '✓' : '⏳' %>
                      </span>
                    <% end %>
                  </div>
                </div>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <%= link_to project_pv_reception_path(@project), class: "btn btn-sm btn-outline-success", style: "font-size:0.8rem;" do %>
                  <i class="bi bi-eye me-1"></i>Voir le PV
                <% end %>
                <% if !@pv_reception.finalise? && @membership.role == 'entrepreneur' && @pv_reception.token_entrepreneur.present? %>
                  <%= link_to pv_signature_path(@pv_reception.token_entrepreneur),
                        class: "btn btn-sm btn-success", style: "font-size:0.8rem;" do %>
                    <i class="bi bi-pen me-1"></i>Signer le PV
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <div class="text-center py-4">
                <i class="bi bi-file-earmark-check text-muted d-block mb-2" style="font-size:2rem;"></i>
                <p class="text-muted mb-3" style="font-size:0.85rem;">
                  <% if @project.user_id == current_user.id %>
                    Le chantier est terminé ? Créez le procès-verbal de réception.
                  <% else %>
                    Le PV sera créé par le propriétaire en fin de chantier.
                  <% end %>
                </p>
                <% if @project.user_id == current_user.id %>
                  <%= button_to project_pv_reception_path(@project), method: :post,
                        class: "btn btn-success btn-sm", style: "font-size:0.8rem;" do %>
                    <i class="bi bi-plus me-1"></i>Créer le PV de réception
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

      </div><%# /section-reception %>

    </div><%# /col-lg-9 %>

    <%# ── SIDEBAR (sticky, visuellement à gauche) ──────── %>
    <div class="col-lg-3 order-2 order-lg-1">
      <div style="position:sticky;top:1rem;">

        <%# FICHE BIEN ── %>
      <% if @property %>
        <div class="card border-0 shadow-sm rounded-3 mb-3">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4">
            <h5 class="mb-0 fw-semibold" style="font-size:0.9rem;">
              <i class="bi bi-house me-2 text-primary"></i>Fiche bien
            </h5>
          </div>
          <div class="card-body px-4 py-3" style="font-size:0.82rem;">
            <dl class="row mb-0">
              <% if @property.try(:type_bien).present? %>
                <dt class="col-6 text-muted fw-normal">Type</dt>
                <dd class="col-6"><%= @property.type_bien.humanize rescue @property.type_bien %></dd>
              <% end %>
              <% if @property.try(:annee_construction).present? %>
                <dt class="col-6 text-muted fw-normal">Année</dt>
                <dd class="col-6"><%= @property.annee_construction %></dd>
              <% end %>
              <% if @property.try(:superficie).present? %>
                <dt class="col-6 text-muted fw-normal">Surface</dt>
                <dd class="col-6"><%= @property.superficie %> m²</dd>
              <% end %>
              <% if @property.try(:region).present? %>
                <dt class="col-6 text-muted fw-normal">Région</dt>
                <dd class="col-6"><%= @property.region.capitalize %></dd>
              <% end %>
              <% if @property.try(:code_postal).present? %>
                <dt class="col-6 text-muted fw-normal">Code postal</dt>
                <dd class="col-6"><%= @property.code_postal %></dd>
              <% end %>
            </dl>
          </div>
        </div>
      <% end %>

        <%# STEPPER AVANCEMENT GLOBAL ── %>
        <div class="card border-0 shadow-sm rounded-3 mb-3">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4">
            <h5 class="mb-0 fw-semibold" style="font-size:0.85rem;">
              <i class="bi bi-bar-chart-steps me-2 text-info"></i>Avancement chantier
            </h5>
          </div>
          <div class="card-body px-3 py-3">
            <%# Barre globale %>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-muted" style="font-size:0.72rem;">Global</span>
              <span class="fw-semibold" style="font-size:0.72rem;color:var(--ren0vate-accent);"><%= pct_global %>%</span>
            </div>
            <div class="progress mb-3" style="height:6px;border-radius:4px;">
              <div class="progress-bar" role="progressbar"
                   style="width:<%= pct_global %>%;background:var(--ren0vate-accent);"></div>
            </div>
            <%# Mini-stepper vertical %>
            <% chantier_phases_all.each_with_index do |phase, idx| %>
              <%
                pd       = phase_data_for.call(phase[:key])
                done     = required_roles.all? { |r| pd[r].present? }
                partial  = pd.any? && !done
                anchor   = phase[:section]
              %>
              <div class="d-flex align-items-center gap-2 mb-2">
                <div class="d-flex flex-column align-items-center flex-shrink-0" style="width:16px;">
                  <div class="rounded-circle d-flex align-items-center justify-content-center"
                       style="width:16px;height:16px;background:<%= done ? '#198754' : partial ? '#fd7e14' : '#dee2e6' %>;">
                    <% if done %>
                      <i class="bi bi-check2 text-white" style="font-size:0.55rem;"></i>
                    <% elsif partial %>
                      <i class="bi bi-clock text-white" style="font-size:0.5rem;"></i>
                    <% else %>
                      <div style="width:5px;height:5px;border-radius:50%;background:#adb5bd;"></div>
                    <% end %>
                  </div>
                  <% if idx < 4 %>
                    <div style="width:1px;height:12px;background:<%= done ? '#19875440' : '#dee2e6' %>;margin-top:1px;"></div>
                  <% end %>
                </div>
                <a href="#<%= anchor %>"
                   class="text-decoration-none <%= done ? 'text-success' : partial ? 'text-warning' : 'text-muted' %>"
                   style="font-size:0.78rem;<%= done ? 'font-weight:500;' : '' %>">
                  <%= phase[:label] %>
                </a>
              </div>
            <% end %>
          </div>
        </div>

        <%# ÉQUIPE PROJET ── %>
        <div class="card border-0 shadow-sm rounded-3 mb-3">
          <div class="card-header bg-white border-bottom pt-3 pb-2 px-4">
            <h5 class="mb-0 fw-semibold" style="font-size:0.85rem;">
              <i class="bi bi-people me-2 text-secondary"></i>Équipe
            </h5>
          </div>
          <div class="card-body px-3 py-2">
            <div class="d-flex align-items-center gap-2 mb-2">
              <div class="rounded-circle bg-primary-subtle d-flex align-items-center justify-content-center flex-shrink-0"
                   style="width:28px;height:28px;">
                <i class="bi bi-house-fill text-primary" style="font-size:0.65rem;"></i>
              </div>
              <div>
                <div class="fw-medium" style="font-size:0.8rem;"><%= @project.user.full_name %></div>
                <div class="text-muted" style="font-size:0.68rem;">Propriétaire</div>
              </div>
            </div>
            <% @members.each do |m| %>
              <div class="d-flex align-items-center gap-2 mb-2">
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center flex-shrink-0 border"
                     style="width:28px;height:28px;">
                  <i class="bi bi-person text-muted" style="font-size:0.65rem;"></i>
                </div>
                <div>
                  <div class="fw-medium" style="font-size:0.8rem;"><%= m.user.full_name.presence || m.invited_email %></div>
                  <div class="text-muted" style="font-size:0.68rem;"><%= m.role_label %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# RETOUR VUE PROPRIÉTAIRE %>
        <% if @project.user_id == current_user.id %>
          <%= link_to project_path(@project), class: "btn btn-outline-secondary btn-sm w-100 mb-2",
                      style: "font-size:0.78rem;" do %>
            <i class="bi bi-arrow-left me-1"></i>Vue propriétaire complète
          <% end %>
        <% end %>

      </div><%# /sticky %>
    </div><%# /col-lg-3 %>
  </div><%# /row %>
</div><%# /container %>
