<%# app/views/pro_views/show.html.erb %>
<%# Dashboard professionnel — vue adaptée selon @membership.role %>

<% content_for :title, "#{@membership.role_label} — #{@project.name} — Ren0vate" %>

<div class="container-fluid py-4 px-3 px-md-4" style="max-width:1140px;">

  <%# ── En-tête projet ──────────────────────────── %>
  <div class="card border-0 shadow-sm rounded-3 mb-4"
       style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);color:white;">
    <div class="card-body px-4 py-3">
      <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
             style="width:48px;height:48px;background:rgba(255,255,255,0.15);">
          <% if @membership.role == 'entrepreneur' %>
            <i class="bi bi-hammer" style="font-size:1.3rem;"></i>
          <% else %>
            <i class="bi bi-building" style="font-size:1.3rem;"></i>
          <% end %>
        </div>
        <div>
          <div style="font-size:0.75rem;opacity:0.7;text-transform:uppercase;letter-spacing:0.05em;">
            <%= @membership.role_label %>
          </div>
          <h1 class="mb-0 fw-semibold" style="font-size:1.25rem;"><%= @project.name %></h1>
          <% if @property %>
            <div style="font-size:0.85rem;opacity:0.75;">
              <i class="bi bi-geo-alt me-1"></i>
              <%= @property.try(:adresse) || @property.try(:address) || "" %>
              ·
              Propriétaire : <%= @project.user.full_name %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Variables partagées ──────────────────────────────── %>
  <%
    chantier_phases_all = [
      { key: 'phase_preparation',  label: 'Préparation',  icon: 'bi-tools',            color: '#6c757d', section: 'section-preparation' },
      { key: 'phase_demolition',   label: 'Démolition',   icon: 'bi-hammer',            color: '#dc3545', section: 'section-suivi'        },
      { key: 'phase_installation', label: 'Installation', icon: 'bi-wrench-adjustable', color: '#fd7e14', section: 'section-suivi'        },
      { key: 'phase_finition',     label: 'Finitions',    icon: 'bi-brush',             color: '#0dcaf0', section: 'section-suivi'        },
      { key: 'phase_reception',    label: 'Réception',    icon: 'bi-check2-circle',     color: '#198754', section: 'section-reception'    }
    ]
    current_role = if @project.user_id == current_user.id
                     'owner'
                   elsif @project.project_members.active.where(user: current_user, role: 'architect').exists?
                     'architect'
                   elsif @project.project_members.active.where(user: current_user, role: 'entrepreneur').exists?
                     'entrepreneur'
                   elsif @project.project_members.active.where(user: current_user, role: 'intermediary').exists?
                     'intermediary'
                   end
    can_validate   = current_role.present?
    required_roles = ['owner']
    required_roles << 'architect'    if @project.project_members.active.where(role: 'architect').exists?
    required_roles << 'entrepreneur' if @project.project_members.active.where(role: 'entrepreneur').exists?
    role_labels = { 'owner' => 'Propriétaire', 'architect' => 'Architecte', 'entrepreneur' => 'Entrepreneur', 'intermediary' => 'Intermédiaire' }
    role_icons  = { 'owner' => 'bi-house',      'architect' => 'bi-pencil-ruler', 'entrepreneur' => 'bi-tools', 'intermediary' => 'bi-people'  }
    suivi_phase_keys = %w[phase_preparation phase_demolition phase_installation phase_finition]
    nb_phases_validees = suivi_phase_keys.count do |k|
      phase_d = (@phases_avancement || {})[k]
      phase_d.is_a?(Hash) && required_roles.all? { |r| phase_d[r].present? }
    end
    pct_global = (nb_phases_validees * 100.0 / 4).round
    phase_data_for = ->(key) {
      raw = (@phases_avancement || {})[key]
      if raw.is_a?(Hash) && raw['validated_at'].present? && raw['owner'].nil?
        { 'owner' => { 'validated_at' => raw['validated_at'], 'validated_by' => raw['validated_by'] } }
      else
        raw || {}
      end
    }
  %>

  <%# ── Navigation mobile (ancres) ──────────────────────── %>
  <div class="d-lg-none mb-3">
    <div class="d-flex gap-2 overflow-auto pb-1" style="scrollbar-width:none;">
      <a href="#section-preparation" class="btn btn-sm btn-outline-primary rounded-pill flex-shrink-0" style="font-size:0.78rem;">
        <i class="bi bi-1-circle me-1"></i>Préparation
      </a>
      <a href="#section-suivi" class="btn btn-sm btn-outline-warning rounded-pill flex-shrink-0" style="font-size:0.78rem;">
        <i class="bi bi-2-circle me-1"></i>Suivi
      </a>
      <a href="#section-reception" class="btn btn-sm btn-outline-success rounded-pill flex-shrink-0" style="font-size:0.78rem;">
        <i class="bi bi-3-circle me-1"></i>Réception
      </a>
    </div>
  </div>

  <div class="row g-4">

    <%# ── CONTENU PRINCIPAL (DOM first, visuellement à droite sur desktop) ── %>
    <div class="col-lg-9 order-1 order-lg-2">
      <%= render 'section_preparation' %>

      <%= render 'section_suivi',
          chantier_phases_all: chantier_phases_all,
          required_roles: required_roles,
          role_labels: role_labels,
          role_icons: role_icons,
          current_role: current_role,
          can_validate: can_validate,
          phase_data_for: phase_data_for,
          nb_phases_validees: nb_phases_validees,
          pct_global: pct_global %>

      <%= render 'section_reception',
          required_roles: required_roles,
          role_labels: role_labels,
          role_icons: role_icons,
          current_role: current_role,
          can_validate: can_validate,
          phase_data_for: phase_data_for %>
    </div>

    <%# ── SIDEBAR (sticky, visuellement à gauche) ──────── %>
    <div class="col-lg-3 order-2 order-lg-1">
      <%= render 'sidebar',
          chantier_phases_all: chantier_phases_all,
          phase_data_for: phase_data_for,
          required_roles: required_roles,
          pct_global: pct_global %>
    </div>

  </div>
</div>

<%# ── Bouton flottant IA ────────────────────────────────────────────────── %>
<button class="btn rounded-pill shadow-lg d-flex align-items-center gap-2 fw-semibold"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#proIaDrawer"
        aria-controls="proIaDrawer"
        style="position:fixed;top:5rem;right:1rem;z-index:1040;
               background:linear-gradient(135deg,var(--ren0vate-primary,#1a1a2e) 0%,#0d6efd 100%);
               color:white;padding:0.6rem 1.1rem;font-size:0.9rem;border:none;">
  <i class="bi bi-robot" style="font-size:1.1rem;"></i>
  <span class="d-none d-sm-inline">Assistant IA</span>
</button>

<%# ── Offcanvas drawer ──────────────────────────────────────────────────── %>
<div class="offcanvas offcanvas-end" tabindex="-1" id="proIaDrawer"
     aria-labelledby="proIaDrawerLabel"
     style="width:min(420px,100vw);">
  <div class="offcanvas-header border-bottom py-3"
       style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 100%);color:white;">
    <div class="d-flex align-items-center gap-2">
      <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
           style="width:36px;height:36px;background:rgba(255,255,255,0.15);">
        <i class="bi bi-robot" style="font-size:1rem;"></i>
      </div>
      <div>
        <h5 class="offcanvas-title mb-0 fw-semibold" id="proIaDrawerLabel" style="font-size:0.95rem;">
          Expert IA — <%= @membership.role == 'entrepreneur' ? 'Entrepreneur' : 'Architecte' %>
        </h5>
        <div style="font-size:0.75rem;opacity:0.7;"><%= @project.name %></div>
      </div>
    </div>
    <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
  </div>

  <div class="offcanvas-body d-flex flex-column p-0">
    <%# ── Suggestions rapides ── %>
    <div class="px-3 pt-3 pb-2" style="background:#f8f9fa;border-bottom:1px solid #e9ecef;">
      <div class="small text-muted mb-2" style="font-size:0.75rem;">Suggestions rapides :</div>
      <div class="d-flex flex-wrap gap-2" id="proIaSuggestions">
        <% if @membership.role == 'entrepreneur' %>
          <button class="btn btn-sm btn-outline-warning rounded-pill ia-suggestion" style="font-size:0.75rem;">Factures en retard de paiement</button>
          <button class="btn btn-sm btn-outline-warning rounded-pill ia-suggestion" style="font-size:0.75rem;">Que manque-t-il pour le PV de réception ?</button>
          <button class="btn btn-sm btn-outline-warning rounded-pill ia-suggestion" style="font-size:0.75rem;">Comment relancer ce client ?</button>
          <button class="btn btn-sm btn-outline-warning rounded-pill ia-suggestion" style="font-size:0.75rem;">Délais légaux de paiement en Belgique</button>
        <% else %>
          <button class="btn btn-sm btn-outline-info rounded-pill ia-suggestion" style="font-size:0.75rem;">Documents manquants pour le permis</button>
          <button class="btn btn-sm btn-outline-info rounded-pill ia-suggestion" style="font-size:0.75rem;">Quelles primes pour ce chantier ?</button>
          <button class="btn btn-sm btn-outline-info rounded-pill ia-suggestion" style="font-size:0.75rem;">Réglementation isolation applicable</button>
          <button class="btn btn-sm btn-outline-info rounded-pill ia-suggestion" style="font-size:0.75rem;">Phases à valider pour clôturer</button>
        <% end %>
      </div>
    </div>

    <%# ── Historique messages ── %>
    <div id="proIaMessages" class="flex-grow-1 overflow-auto px-3 py-3 d-flex flex-column gap-2"
         style="min-height:0;font-size:0.88rem;">
      <div class="rounded-3 p-3 text-center text-muted" style="background:#f8f9fa;font-size:0.82rem;">
        <i class="bi bi-stars me-1"></i>
        Je suis contextualisé sur <strong><%= @project.name %></strong>.
        Posez-moi vos questions sur ce chantier.
      </div>
    </div>

    <%# ── Formulaire ── %>
    <div class="border-top p-3" style="background:white;">
      <form id="proIaForm"
            data-project-id="<%= @project.id %>"
            data-pro-role="<%= @membership.role %>"
            data-property-id="<%= @property&.id %>">
        <div class="d-flex gap-2">
          <input type="text" id="proIaInput"
                 class="form-control form-control-sm rounded-pill"
                 placeholder="Posez votre question sur ce chantier…"
                 autocomplete="off"
                 style="font-size:0.85rem;">
          <button type="submit"
                  class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                  style="width:34px;height:34px;background:linear-gradient(135deg,#1a1a2e,#0d6efd);color:white;border:none;">
            <i class="bi bi-send-fill" style="font-size:0.75rem;"></i>
          </button>
        </div>
        <div class="text-muted mt-1 text-end" style="font-size:0.68rem;">Claude Sonnet · ren0vate IA</div>
      </form>
    </div>
  </div>
</div>

<script>
(function() {
  const form      = document.getElementById('proIaForm');
  const input     = document.getElementById('proIaInput');
  const messages  = document.getElementById('proIaMessages');
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

  function appendMsg(role, text) {
    const div = document.createElement('div');
    div.className = 'd-flex ' + (role === 'user' ? 'justify-content-end' : 'justify-content-start');
    const bubble = document.createElement('div');
    bubble.className = 'rounded-3 px-3 py-2';
    bubble.style.cssText = role === 'user'
      ? 'background:#0d6efd;color:white;max-width:85%;font-size:0.85rem;'
      : 'background:#f1f3f5;color:#212529;max-width:90%;font-size:0.85rem;white-space:pre-wrap;';
    bubble.textContent = text;
    div.appendChild(bubble);
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  function appendTyping() {
    const div = document.createElement('div');
    div.id = 'proIaTyping';
    div.className = 'd-flex justify-content-start';
    div.innerHTML = '<div class="rounded-3 px-3 py-2" style="background:#f1f3f5;font-size:0.82rem;color:#6c757d;">' +
      '<span class="spinner-grow spinner-grow-sm me-1" style="width:6px;height:6px;"></span>En réflexion…</div>';
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
    return div;
  }

  async function sendQuestion(question) {
    if (!question.trim()) return;
    appendMsg('user', question);
    input.value = '';
    const typing = appendTyping();

    try {
      const res = await fetch('/api/contextual_bot/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({
          message:      question,
          current_page: 'pro_view',
          mode:         'expert',
          property_id:  form.dataset.projectId  || '',
          pro_role:     form.dataset.proRole    || ''
        })
      });
      typing.remove();
      const data = await res.json();
      appendMsg('bot', data.response || data.message || 'Erreur de réponse.');
    } catch(e) {
      typing.remove();
      appendMsg('bot', 'Une erreur est survenue. Veuillez réessayer.');
    }
  }

  form.addEventListener('submit', e => {
    e.preventDefault();
    sendQuestion(input.value);
  });

  document.getElementById('proIaSuggestions')?.addEventListener('click', e => {
    const btn = e.target.closest('.ia-suggestion');
    if (btn) sendQuestion(btn.textContent.trim());
  });
})();
</script>
